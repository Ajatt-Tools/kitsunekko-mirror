Dialogue: 1,0:24:04.26,0:24:06.88,DefaultSingle-J,,0,0,0,,		そうか  そういうことか	
Dialogue: 1,0:24:10.35,0:24:11.35,DefaultSingle-J,,0,0,0,,		もっとだ	
Dialogue: 1,0:24:12.43,0:24:13.77,DefaultSingle-J,,0,0,0,,		もっと速く	
Dialogue: 1,0:24:18.23,0:24:19.60,DefaultSingle-J,,0,0,0,,		息ができねえ	
Dialogue: 1,0:24:20.48,0:24:22.23,DefaultSingle-J,,0,0,0,,		もう少し  あと少し	
Dialogue: 1,0:24:24.86,0:24:26.03,DefaultSingle-J,,0,0,0,,		おおっ  落ちるぞ	
Dialogue: 1,0:24:26.40,0:24:29.82,DefaultSingle-J,,0,0,0,,		ここまでかよ～っ	
Dialogue: 1,0:24:31.66,0:24:33.83,DefaultSingle-J,,0,0,0,,		クソッ  加速が足りなかったか	
Dialogue: 1,0:24:35.58,0:24:36.83,DefaultSingle-J,,0,0,0,,		ダメだ  届かねえ	
Dialogue: 1,0:24:42.42,0:24:45.17,DefaultSingle-J,,0,0,0,,		待ってたで  ほ～らよっと	
Dialogue: 1,0:24:59.44,0:25:01.06,DefaultSingle-J,,0,0,0,,		おい  大丈夫か  工藤	
Dialogue: 1,0:25:02.02,0:25:04.11,DefaultSingle-J,,0,0,0,,		ああ  なんとかな	
Dialogue: 1,0:25:04.40,0:25:05.98,DefaultSingle-J,,0,0,0,,		ほら  落としもんや	
Dialogue: 1,0:25:06.32,0:25:07.03,DefaultSingle-J,,0,0,0,,		サンキュー	
Dialogue: 1,0:25:07.61,0:25:12.87,DefaultSingle-J,,0,0,0,,		にしても  お前あんなもん持ってきて  日売テレビが爆破されるん知ってたんか	
Dialogue: 1,0:25:13.66,0:25:16.16,DefaultSingle-J,,0,0,0,,		バーロー  んなわけねーだろ	
Dialogue: 1,0:25:16.75,0:25:18.75,DefaultSingle-J,,0,0,0,,		もしもの時のためだっての	
Dialogue: 1,0:25:19.58,0:25:21.75,DefaultSingle-J,,0,0,0,,		その「もしも」をお前が呼んだんちゃうか	
Dialogue: 1,0:25:22.83,0:25:23.96,DefaultSingle-J,,0,0,0,,		みてえだな	
Dialogue: 1,0:25:29.26,0:25:30.26,DefaultSingle-J,,0,0,0,,		和葉ちゃん	
Dialogue: 1,0:25:30.43,0:25:31.34,DefaultSingle-J,,0,0,0,,		蘭ちゃん	
Dialogue: 1,0:25:31.80,0:25:32.76,DefaultSingle-J,,0,0,0,,		大丈夫だった	
Dialogue: 1,0:25:32.97,0:25:38.10,DefaultSingle-J,,0,0,0,,		うん  よう覚えてないんやけど  少し煙を吸うてしもうただけやから	
Dialogue: 1,0:25:38.60,0:25:40.14,DefaultSingle-J,,0,0,0,,		大丈夫なら  いいんだけど	
Dialogue: 1,0:25:40.60,0:25:42.06,DefaultSingle-J,,0,0,0,,		とにかく無事でよかった	
Dialogue: 1,0:25:42.06,0:25:42.52,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,0:25:42.77,0:25:46.82,DefaultSingle-J,,0,0,0,,		蘭  車のカギを落としちまったみてーだから  ちょっくら捜してくる	
Dialogue: 1,0:25:46.82,0:25:47.53,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,0:25:48.03,0:25:49.57,DefaultSingle-J,,0,0,0,,		そういえば  コナン君は	
Dialogue: 1,0:25:49.82,0:25:52.86,DefaultSingle-J,,0,0,0,,		うん  この避難所に来てると思ったんだけど	
Dialogue: 1,0:25:53.11,0:25:54.32,DefaultSingle-J,,0,0,0,,		あっ  コナンだ	
Dialogue: 1,0:25:54.41,0:25:54.99,DefaultSingle-J,,0,0,0,,		ほんとだ	
Dialogue: 1,0:25:54.99,0:25:57.08,DefaultSingle-J,,0,0,0,,		コナン君  どこに行ってたんですか	
Dialogue: 1,0:25:57.08,0:25:58.54,DefaultSingle-J,,0,0,0,,		心配したんだよ	
Dialogue: 1,0:25:59.20,0:25:59.83,DefaultSingle-J,,0,0,0,,		和葉	
Dialogue: 1,0:26:00.29,0:26:03.25,DefaultSingle-J,,0,0,0,,		ちょっと  平次  今まで  どこ行っとったん	
Dialogue: 1,0:26:03.33,0:26:05.00,DefaultSingle-J,,0,0,0,,		あっ  ああ  ちょっとな	
Dialogue: 1,0:26:05.04,0:26:07.96,DefaultSingle-J,,0,0,0,,		コナン君もよ  すごく心配したんだから	
Dialogue: 1,0:26:08.05,0:26:09.26,DefaultSingle-J,,0,0,0,,		ごめんなさい	
Dialogue: 1,0:26:09.38,0:26:10.80,DefaultSingle-J,,0,0,0,,		んなことより  未来子は	
Dialogue: 1,0:26:11.01,0:26:15.05,DefaultSingle-J,,0,0,0,,		それがどうやら腕をケガして病院に運ばれたみたいやねん	
Dialogue: 1,0:26:15.35,0:26:16.22,DefaultSingle-J,,0,0,0,,		腕って	
Dialogue: 1,0:26:16.47,0:26:18.56,DefaultSingle-J,,0,0,0,,		大したケガやないとええねんけど	
Dialogue: 1,0:26:19.22,0:26:22.64,DefaultSingle-J,,0,0,0,,		運ばれた病院を聞いといたから  これからみんなで行かない	
Dialogue: 1,0:26:22.81,0:26:24.44,DefaultSingle-J,,0,0,0,,		おう  行こうぜ	
Dialogue: 1,0:26:25.86,0:26:26.94,DefaultSingle-J,,0,0,0,,		平ちゃん	
Dialogue: 1,0:26:27.32,0:26:28.23,DefaultSingle-J,,0,0,0,,		大滝はん	
Dialogue: 1,0:26:28.32,0:26:29.94,DefaultSingle-J,,0,0,0,,		無事で何よりや	
Dialogue: 1,0:26:30.15,0:26:32.45,DefaultSingle-J,,0,0,0,,		和葉  すまんけど  先に行っててくれ	
Dialogue: 1,0:26:32.49,0:26:33.24,DefaultSingle-J,,0,0,0,,		ええっ	
Dialogue: 1,0:26:33.36,0:26:34.41,DefaultSingle-J,,0,0,0,,		すぐ行くさかい	
Dialogue: 1,0:26:34.49,0:26:35.53,DefaultSingle-J,,0,0,0,,		も～っ	
Dialogue: 1,0:26:36.07,0:26:37.03,DefaultSingle-J,,0,0,0,,		行こう  蘭ちゃん	
Dialogue: 1,0:26:37.03,0:26:37.91,DefaultSingle-J,,0,0,0,,		う  うん	
Dialogue: 1,0:26:38.20,0:26:39.70,DefaultSingle-J,,0,0,0,,		さっ  コナン君も行くよ	
Dialogue: 1,0:26:39.99,0:26:41.00,DefaultSingle-J,,0,0,0,,		う  うん	
Dialogue: 1,0:26:41.37,0:26:42.96,DefaultSingle-J,,0,0,0,,		もう離れちゃダメだよ	
Dialogue: 1,0:26:43.08,0:26:43.87,DefaultSingle-J,,0,0,0,,		は～い	
Dialogue: 1,0:26:43.96,0:26:45.63,DefaultSingle-J,,0,0,0,,		じゃ～な  コナン君	
Dialogue: 1,0:26:47.21,0:26:49.75,DefaultSingle-J,,0,0,0,,		警察に爆破予告が来とったって  ほんまか	
Dialogue: 1,0:26:50.00,0:26:52.72,DefaultSingle-J,,0,0,0,,		これが警察に届いた例のメールや	
Dialogue: 1,0:26:54.51,0:26:56.39,DefaultSingle-J,,0,0,0,,		カルタ札が添付されとったんか	
Dialogue: 1,0:26:56.59,0:26:58.81,DefaultSingle-J,,0,0,0,,		今回のカルタ番組の収録と	
Dialogue: 1,0:26:58.89,0:27:03.81,DefaultSingle-J,,0,0,0,,		なんか関係があるかもしれんのやが  日売テレビはあの有り様や	
Dialogue: 1,0:27:04.35,0:27:07.69,DefaultSingle-J,,0,0,0,,		現場検証するんはしばらく時間がかかりそうやな	
Dialogue: 1,0:27:07.73,0:27:08.61,DefaultSingle-J,,0,0,0,,		そうやな	
Dialogue: 1,0:27:09.69,0:27:12.11,DefaultSingle-J,,0,0,0,,		犯人の狙いは一体何なんや	
Dialogue: 1,0:27:19.24,0:27:21.16,DefaultSingle-J,,0,0,0,,		どうも  お世話さまでした	
Dialogue: 1,0:27:21.16,0:27:22.20,DefaultSingle-J,,0,0,0,,		はい  お大事に	
Dialogue: 1,0:27:22.20,0:27:23.58,DefaultSingle-J,,0,0,0,,		会長  いかがでしたか	
Dialogue: 1,0:27:23.83,0:27:26.75,DefaultSingle-J,,0,0,0,,		ああ  なんともない  単なるかすり傷や	
Dialogue: 1,0:27:27.08,0:27:27.92,DefaultSingle-J,,0,0,0,,		よかった	
Dialogue: 1,0:27:28.33,0:27:31.55,DefaultSingle-J,,0,0,0,,		大会直前にこんな事件に巻き込まれるやなんて	
Dialogue: 1,0:27:31.80,0:27:33.97,DefaultSingle-J,,0,0,0,,		ああ  思いもよらんこっちや	
Dialogue: 1,0:27:34.67,0:27:39.05,DefaultSingle-J,,0,0,0,,		これで長年続いた皐月杯も中止せなあかんかもしれんな	
Dialogue: 1,0:27:39.43,0:27:40.60,DefaultSingle-J,,0,0,0,,		そんなんあきません	
Dialogue: 1,0:27:40.93,0:27:44.85,DefaultSingle-J,,0,0,0,,		こういう時やからこそー  皐月会健在をアピールすべきやと思います	
Dialogue: 1,0:27:45.48,0:27:50.02,DefaultSingle-J,,0,0,0,,		だが決勝戦で使用される皐月杯のカルタも  燃えてしまったからな	
Dialogue: 1,0:27:50.48,0:27:52.36,DefaultSingle-J,,0,0,0,,		そのことやったら心配いりません	
Dialogue: 1,0:27:52.61,0:27:53.74,DefaultSingle-J,,0,0,0,,		カルタは無事です	
Dialogue: 1,0:27:53.78,0:27:56.65,DefaultSingle-J,,0,0,0,,		なっ  なんやて  そ  そらどういう	
Dialogue: 1,0:27:56.65,0:27:59.95,DefaultSingle-J,,0,0,0,,		避難する際  枚本さんが持ち出してくれたんですよ	
Dialogue: 1,0:28:00.20,0:28:01.70,DefaultSingle-J,,0,0,0,,		未  未来子君が	
Dialogue: 1,0:28:02.12,0:28:05.54,DefaultSingle-J,,0,0,0,,		カルタが燃えてしもたならともかく  無事やったんですから	
Dialogue: 1,0:28:05.54,0:28:06.25,DefaultSingle-J,,0,0,0,,		ほんまか	
Dialogue: 1,0:28:06.37,0:28:08.88,DefaultSingle-J,,0,0,0,,		ほんまに皐月会のカルタは無事やったんか	
Dialogue: 1,0:28:09.13,0:28:11.54,DefaultSingle-J,,0,0,0,,		そ  損傷がないか  確かめるため	
Dialogue: 1,0:28:11.71,0:28:13.92,DefaultSingle-J,,0,0,0,,		博物館の職員が持っていかはりました	
Dialogue: 1,0:28:14.34,0:28:18.30,DefaultSingle-J,,0,0,0,,		会長  カルタはもう大丈夫です  ご安心ください	
Dialogue: 1,0:28:18.64,0:28:22.10,DefaultSingle-J,,0,0,0,,		ああ  もうあかんかと  思うたが  よかった	
Dialogue: 1,0:28:22.60,0:28:26.43,DefaultSingle-J,,0,0,0,,		で  皐月会のカルタを救ってくれた未来子君は	
Dialogue: 1,0:28:26.89,0:28:29.31,DefaultSingle-J,,0,0,0,,		命に別状はないと聞いていますが	
Dialogue: 1,0:28:30.06,0:28:31.86,DefaultSingle-J,,0,0,0,,		まだ診察中みたいで	
Dialogue: 1,0:28:32.73,0:28:33.61,DefaultSingle-J,,0,0,0,,		そうか	
Dialogue: 1,0:28:34.32,0:28:35.78,DefaultSingle-J,,0,0,0,,		未来子ちゃん  遅いね	
Dialogue: 1,0:28:36.53,0:28:39.36,DefaultSingle-J,,0,0,0,,		応急処置するだけやって  お医者さんは言うてたけど	
Dialogue: 1,0:28:39.36,0:28:40.57,DefaultSingle-J,,0,0,0,,		ありがとうございました	
Dialogue: 1,0:28:41.12,0:28:43.58,DefaultSingle-J,,0,0,0,,		未来子  その腕  もしかして	
Dialogue: 1,0:28:43.62,0:28:46.66,DefaultSingle-J,,0,0,0,,		う  うん  折れてしもてるみたいや	
Dialogue: 1,0:28:48.25,0:28:49.71,DefaultSingle-J,,0,0,0,,		バチが当たったんやわ	
Dialogue: 1,0:28:49.92,0:28:50.67,DefaultSingle-J,,0,0,0,,		そんな	
Dialogue: 1,0:28:51.00,0:28:55.05,DefaultSingle-J,,0,0,0,,		カルタ取りにもどって  和葉や服部君を危ない目にあわせて	
Dialogue: 1,0:28:55.05,0:28:56.38,DefaultSingle-J,,0,0,0,,		何言うてんの	
Dialogue: 1,0:28:56.51,0:28:58.13,DefaultSingle-J,,0,0,0,,		ありがとう  未来子君	
Dialogue: 1,0:28:58.51,0:29:02.51,DefaultSingle-J,,0,0,0,,		キミは皐月会の顔とも言うべきカルタを救ってくれた	
Dialogue: 1,0:29:02.85,0:29:07.48,DefaultSingle-J,,0,0,0,,		会を代表する者として  感謝の気持ちはとても言いつくせんな	
Dialogue: 1,0:29:07.77,0:29:11.15,DefaultSingle-J,,0,0,0,,		でも会長  これでは皐月杯に出られへん	
Dialogue: 1,0:29:11.44,0:29:15.07,DefaultSingle-J,,0,0,0,,		ああ  キミほどの実力者が参加できひんのは	
Dialogue: 1,0:29:15.23,0:29:18.15,DefaultSingle-J,,0,0,0,,		皐月会にとって  非常に残念なことやが	
Dialogue: 1,0:29:18.44,0:29:21.57,DefaultSingle-J,,0,0,0,,		今はケガを治すことに専念すべきやないかな	
Dialogue: 1,0:29:22.12,0:29:25.24,DefaultSingle-J,,0,0,0,,		そやで  大会は来年もあるんやろ	
Dialogue: 1,0:29:25.33,0:29:26.66,DefaultSingle-J,,0,0,0,,		それやったら  あかんねん	
Dialogue: 1,0:29:27.41,0:29:30.33,DefaultSingle-J,,0,0,0,,		今度の皐月杯でええ成績あげんと	
Dialogue: 1,0:29:30.62,0:29:32.54,DefaultSingle-J,,0,0,0,,		いよいよ  廃部になってまうんや	
Dialogue: 1,0:29:32.96,0:29:35.96,DefaultSingle-J,,0,0,0,,		私の代でカルタ部をつぶすわけにいかんのに	
Dialogue: 1,0:29:36.80,0:29:40.80,DefaultSingle-J,,0,0,0,,		会長  警察の方がお待ちです  そろそろ	
Dialogue: 1,0:29:41.09,0:29:41.63,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:29:41.84,0:29:43.30,DefaultSingle-J,,0,0,0,,		元気出し  未来子	
Dialogue: 1,0:29:43.47,0:29:44.60,DefaultSingle-J,,0,0,0,,		そやかて	
Dialogue: 1,0:29:45.18,0:29:49.89,DefaultSingle-J,,0,0,0,,		確かに未来子とアタシ以外  まともにカルタできる部員おらんかったしな	
Dialogue: 1,0:29:50.23,0:29:52.44,DefaultSingle-J,,0,0,0,,		そうや  和葉  あんたが出て	
Dialogue: 1,0:29:53.02,0:29:55.94,DefaultSingle-J,,0,0,0,,		私の代わりに改方学園代表として	
Dialogue: 1,0:29:56.07,0:29:58.11,DefaultSingle-J,,0,0,0,,		そんなん急に言われても	
Dialogue: 1,0:29:58.19,0:30:00.53,DefaultSingle-J,,0,0,0,,		和葉ちゃん  大会とか出たことあるの	
Dialogue: 1,0:30:00.53,0:30:01.65,DefaultSingle-J,,0,0,0,,		ないない	
Dialogue: 1,0:30:01.70,0:30:04.16,DefaultSingle-J,,0,0,0,,		けど  いつも練習付き合うてくれてたやろ	
Dialogue: 1,0:30:04.87,0:30:08.41,DefaultSingle-J,,0,0,0,,		和葉なら体力はバッチリやし  反射神経もある	
Dialogue: 1,0:30:08.62,0:30:11.58,DefaultSingle-J,,0,0,0,,		負けん気も強いし  どんな相手にも物怖じせん	
Dialogue: 1,0:30:12.33,0:30:14.75,DefaultSingle-J,,0,0,0,,		あと妙な図々しさもあるやんか	
Dialogue: 1,0:30:14.75,0:30:17.42,DefaultSingle-J,,0,0,0,,		なんか  ほめられてる気  せえへんねんけど	
Dialogue: 1,0:30:17.80,0:30:19.63,DefaultSingle-J,,0,0,0,,		その大会っていつからあるの	
Dialogue: 1,0:30:20.05,0:30:22.22,DefaultSingle-J,,0,0,0,,		それが  あさってからやねん	
Dialogue: 1,0:30:22.22,0:30:22.72,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:30:22.80,0:30:26.85,DefaultSingle-J,,0,0,0,,		大丈夫  これから特訓すれば  和葉ならなんとかなる	
Dialogue: 1,0:30:29.10,0:30:32.10,DefaultSingle-J,,0,0,0,,		素人が大会に出て  優勝狙わはるん	
Dialogue: 1,0:30:32.60,0:30:34.81,DefaultSingle-J,,0,0,0,,		いっそのこと  百人一首やのうて	
Dialogue: 1,0:30:34.81,0:30:36.86,DefaultSingle-J,,0,0,0,,		いろはガルタに  かえてもらいましょか	
Dialogue: 1,0:30:37.19,0:30:38.40,DefaultSingle-J,,0,0,0,,		バカにせんといて	
Dialogue: 1,0:30:38.69,0:30:42.65,DefaultSingle-J,,0,0,0,,		和葉の技量はいつも練習してるウチが一番よう分かってる	
Dialogue: 1,0:30:43.07,0:30:46.82,DefaultSingle-J,,0,0,0,,		試合経験はないけど  間違いなく  A級並みの腕前やで	
Dialogue: 1,0:30:48.58,0:30:50.12,DefaultSingle-J,,0,0,0,,		この子がそうなん	
Dialogue: 1,0:30:51.04,0:30:54.17,DefaultSingle-J,,0,0,0,,		いうたら  平次君と一緒にいてはりましたけど	
Dialogue: 1,0:30:54.75,0:30:56.54,DefaultSingle-J,,0,0,0,,		一体どないな関係なんやろ	
Dialogue: 1,0:30:57.54,0:30:59.50,DefaultSingle-J,,0,0,0,,		ちっちゃいころから  いっつも一緒で	
Dialogue: 1,0:30:59.67,0:31:00.80,DefaultSingle-J,,0,0,0,,		平次は  アタシの	
Dialogue: 1,0:31:01.21,0:31:02.42,DefaultSingle-J,,0,0,0,,		アタシの	
Dialogue: 1,0:31:02.67,0:31:03.93,DefaultSingle-J,,0,0,0,,		大好きなんだよね	
Dialogue: 1,0:31:04.88,0:31:06.26,DefaultSingle-J,,0,0,0,,		見てたら分かりますよ	
Dialogue: 1,0:31:06.26,0:31:07.39,DefaultSingle-J,,0,0,0,,		バレバレだぞ	
Dialogue: 1,0:31:07.51,0:31:08.93,DefaultSingle-J,,0,0,0,,		ロはさまんとうて	
Dialogue: 1,0:31:09.01,0:31:11.18,DefaultSingle-J,,0,0,0,,		「しのぶれど」  やなあ	
Dialogue: 1,0:31:12.85,0:31:14.69,DefaultSingle-J,,0,0,0,,		幼なじみで恋愛ごっこ	
Dialogue: 1,0:31:15.06,0:31:16.85,DefaultSingle-J,,0,0,0,,		ほんま  なごみますわ	
Dialogue: 1,0:31:18.36,0:31:19.61,DefaultSingle-J,,0,0,0,,		ほんなら  こうしましょか	
Dialogue: 1,0:31:20.15,0:31:24.57,DefaultSingle-J,,0,0,0,,		あさっての大会  優勝したほうが平次君のお嫁さん第一候補	
Dialogue: 1,0:31:25.03,0:31:27.45,DefaultSingle-J,,0,0,0,,		先に告白して  平次君をゲットする	
Dialogue: 1,0:31:27.57,0:31:28.57,DefaultSingle-J,,0,0,0,,		これでどないです	
Dialogue: 1,0:31:29.53,0:31:31.58,DefaultSingle-J,,0,0,0,,		ちょっと  何言うてるの	
Dialogue: 1,0:31:31.58,0:31:35.21,DefaultSingle-J,,0,0,0,,		あんたが  本気なんやったら  それくらいの覚悟はできてますやろ	
Dialogue: 1,0:31:35.83,0:31:38.92,DefaultSingle-J,,0,0,0,,		和葉  こないな勝負受けることないで	
Dialogue: 1,0:31:38.92,0:31:42.38,DefaultSingle-J,,0,0,0,,		言うときますけど  ウチは本気です	
Dialogue: 1,0:31:46.09,0:31:46.80,DefaultSingle-J,,0,0,0,,		待ちぃ	
Dialogue: 1,0:31:47.72,0:31:49.76,DefaultSingle-J,,0,0,0,,		その勝負  受けたるわ	
Dialogue: 1,0:31:50.72,0:31:52.10,DefaultSingle-J,,0,0,0,,		か  和葉ちゃん	
Dialogue: 1,0:31:52.27,0:31:53.06,DefaultSingle-J,,0,0,0,,		マジかよ	
Dialogue: 1,0:31:53.93,0:31:57.48,DefaultSingle-J,,0,0,0,,		その勢い  試合当日までもつとええですけど	
Dialogue: 1,0:31:57.81,0:32:01.07,DefaultSingle-J,,0,0,0,,		あんたこそ  アタシと当たる前に負けんときや	
Dialogue: 1,0:32:01.94,0:32:05.90,DefaultSingle-J,,0,0,0,,		ほんならウチはこの辺で  これからネイルサロンで	
Dialogue: 1,0:32:06.07,0:32:08.66,DefaultSingle-J,,0,0,0,,		平次君にコクる言葉  考えなあかんから	
Dialogue: 1,0:32:12.70,0:32:14.62,DefaultSingle-J,,0,0,0,,		あの姉ちゃん  怖そうだな	
Dialogue: 1,0:32:14.62,0:32:15.04,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 1,0:32:15.04,0:32:16.33,DefaultSingle-J,,0,0,0,,		すごいの見ちゃったね	
Dialogue: 1,0:32:17.21,0:32:21.34,DefaultSingle-J,,0,0,0,,		やっぱりあんたすごいわ  紅葉にあんなタンカ切るなんて	
Dialogue: 1,0:32:21.42,0:32:22.38,DefaultSingle-J,,0,0,0,,		どないしよ	
Dialogue: 1,0:32:22.46,0:32:23.05,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:32:23.13,0:32:24.96,DefaultSingle-J,,0,0,0,,		大変な約束してもうた	
Dialogue: 1,0:32:30.05,0:32:30.97,DefaultSingle-J,,0,0,0,,		どうもすみません	
Dialogue: 1,0:32:30.97,0:32:32.26,DefaultSingle-J,,0,0,0,,		いえ  こちらこそ	
Dialogue: 1,0:32:32.68,0:32:34.64,DefaultSingle-J,,0,0,0,,		お父さん  カギ見つかった	
Dialogue: 1,0:32:34.85,0:32:36.27,DefaultSingle-J,,0,0,0,,		いや  それがな	
Dialogue: 1,0:32:36.60,0:32:39.27,DefaultSingle-J,,0,0,0,,		いろいろ捜してみたんだが見つかんねえんだよ	
Dialogue: 1,0:32:39.31,0:32:40.06,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:32:40.35,0:32:43.07,DefaultSingle-J,,0,0,0,,		こりゃあ  合力ギ  作るしかねえな	
Dialogue: 1,0:32:43.32,0:32:45.03,DefaultSingle-J,,0,0,0,,		あっ  どうしたの  コナン君	
Dialogue: 1,0:32:45.49,0:32:48.28,DefaultSingle-J,,0,0,0,,		これ  さっきのお姉さんが落としてったみたいだよ	
Dialogue: 1,0:32:48.57,0:32:50.36,DefaultSingle-J,,0,0,0,,		えっ  ちょっと見せて	
Dialogue: 1,0:32:51.49,0:32:53.16,DefaultSingle-J,,0,0,0,,		ほんとだ  紅葉さんのだ	
Dialogue: 1,0:32:53.33,0:32:55.20,DefaultSingle-J,,0,0,0,,		お父さん  ちょっと  これ届けてくるね	
Dialogue: 1,0:32:55.20,0:32:56.12,DefaultSingle-J,,0,0,0,,		おう  知り合いか	
Dialogue: 1,0:32:56.45,0:32:59.54,DefaultSingle-J,,0,0,0,,		ほんまヘコむわ  どないしたらええと思う	
Dialogue: 1,0:32:59.58,0:33:01.08,DefaultSingle-J,,0,0,0,,		どないしたらって	
Dialogue: 1,0:33:01.29,0:33:02.96,DefaultSingle-J,,0,0,0,,		ちょっと  怖そうだったけど	
Dialogue: 1,0:33:02.96,0:33:04.71,DefaultSingle-J,,0,0,0,,		すごい  美人さんだったようね	
Dialogue: 1,0:33:04.80,0:33:06.55,DefaultSingle-J,,0,0,0,,		あんな人に告白されたら	
Dialogue: 1,0:33:06.80,0:33:08.63,DefaultSingle-J,,0,0,0,,		平次さん  メロメロになっちゃうんじゃ	
Dialogue: 1,0:33:09.63,0:33:12.35,DefaultSingle-J,,0,0,0,,		で  でも  お似合いなのは和葉さんだけですよ	
Dialogue: 1,0:33:12.55,0:33:13.18,DefaultSingle-J,,0,0,0,,		ほんま	
Dialogue: 1,0:33:13.30,0:33:14.68,DefaultSingle-J,,0,0,0,,		ほんま  ほんま	
Dialogue: 1,0:33:15.10,0:33:19.06,DefaultSingle-J,,0,0,0,,		四の五の言うとる場合やない  今晩から徹夜で特訓や	
Dialogue: 1,0:33:22.06,0:33:24.40,DefaultSingle-J,,0,0,0,,		ボク  病院来たの初めてや	
Dialogue: 1,0:33:24.65,0:33:26.98,DefaultSingle-J,,0,0,0,,		広いなあ  迷子になるわあ	
Dialogue: 1,0:33:26.98,0:33:28.90,DefaultSingle-J,,0,0,0,,		蘭ねーちゃん  いたよ  あっち	
Dialogue: 1,0:33:29.11,0:33:31.24,DefaultSingle-J,,0,0,0,,		紅葉さん  ちょっと待って	
Dialogue: 1,0:33:33.37,0:33:35.49,DefaultSingle-J,,0,0,0,,		紅葉さん  待って	
Dialogue: 1,0:33:35.83,0:33:37.54,DefaultSingle-J,,0,0,0,,		ああ  行っちゃった	
Dialogue: 1,0:33:38.37,0:33:39.71,DefaultSingle-J,,0,0,0,,		どうしよう  これ	
Dialogue: 1,0:33:39.91,0:33:41.83,DefaultSingle-J,,0,0,0,,		名前や学校は分かってるけど	
Dialogue: 1,0:33:42.00,0:33:44.42,DefaultSingle-J,,0,0,0,,		連絡先は中見たほうが早いんじゃない	
Dialogue: 1,0:33:44.79,0:33:45.92,DefaultSingle-J,,0,0,0,,		そうだね	
Dialogue: 1,0:33:46.50,0:33:48.13,DefaultSingle-J,,0,0,0,,		蘭ねーちゃん  ボクにも見せて	
Dialogue: 1,0:33:48.17,0:33:49.09,DefaultSingle-J,,0,0,0,,		う  うん	
Dialogue: 1,0:33:49.59,0:33:52.30,DefaultSingle-J,,0,0,0,,		えーと  これ  あっ  写真か	
Dialogue: 1,0:33:52.72,0:33:54.01,DefaultSingle-J,,0,0,0,,		だれだ  この人	
Dialogue: 1,0:33:55.05,0:33:56.47,DefaultSingle-J,,0,0,0,,		あっ  もう１枚ある	
Dialogue: 1,0:33:57.01,0:33:57.64,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:33:58.68,0:34:00.56,DefaultSingle-J,,0,0,0,,		子供のころの写真みたいだけど	
Dialogue: 1,0:34:00.81,0:34:02.44,DefaultSingle-J,,0,0,0,,		これって紅葉さんと	
Dialogue: 1,0:34:02.85,0:34:04.31,DefaultSingle-J,,0,0,0,,		服部君だよね	
Dialogue: 1,0:34:04.86,0:34:06.15,DefaultSingle-J,,0,0,0,,		指切りしてるね	
Dialogue: 1,0:34:08.19,0:34:09.86,DefaultSingle-J,,0,0,0,,		なんの約束したんだろ	
Dialogue: 1,0:34:10.32,0:34:11.86,DefaultSingle-J,,0,0,0,,		結婚の約束とか	
Dialogue: 1,0:34:13.57,0:34:14.91,DefaultSingle-J,,0,0,0,,		こんな子供なのに	
Dialogue: 1,0:34:14.91,0:34:16.53,DefaultSingle-J,,0,0,0,,		そんなわけないよね	
Dialogue: 1,0:34:17.12,0:34:19.75,DefaultSingle-J,,0,0,0,,		いや  あいつ割といい加減なとこあるし	
Dialogue: 1,0:34:20.08,0:34:21.12,DefaultSingle-J,,0,0,0,,		あるかも	
Dialogue: 1,0:34:23.67,0:34:25.67,DefaultSingle-J,,0,0,0,,		あっ  平次兄ちゃんのバイクだ	
Dialogue: 1,0:34:26.54,0:34:28.88,DefaultSingle-J,,0,0,0,,		さっきの写真のことは絶対に内緒だよ	
Dialogue: 1,0:34:30.13,0:34:31.76,DefaultSingle-J,,0,0,0,,		特に和葉ちゃんにはね	
Dialogue: 1,0:34:32.05,0:34:32.34,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,0:34:39.39,0:34:41.52,DefaultSingle-J,,0,0,0,,		なんや  ２人そろって  お出むかえか	
Dialogue: 1,0:34:41.52,0:34:42.44,DefaultSingle-J,,0,0,0,,		ううんっ	
Dialogue: 1,0:34:44.23,0:34:45.52,DefaultSingle-J,,0,0,0,,		どないしたんや  あのねーちゃん	
Dialogue: 1,0:34:46.11,0:34:48.48,DefaultSingle-J,,0,0,0,,		蘭  落とし物は届けたのか	
Dialogue: 1,0:34:48.57,0:34:49.61,DefaultSingle-J,,0,0,0,,		あ  うん	
Dialogue: 1,0:34:49.61,0:34:50.57,DefaultSingle-J,,0,0,0,,		お  おい	
Dialogue: 1,0:34:50.90,0:34:51.86,DefaultSingle-J,,0,0,0,,		遅かったな	
Dialogue: 1,0:34:52.82,0:34:54.61,DefaultSingle-J,,0,0,0,,		なんか収穫はあったのか	
Dialogue: 1,0:34:54.95,0:34:58.24,DefaultSingle-J,,0,0,0,,		いや  大阪府警もまだ混乱しとるようや	
Dialogue: 1,0:34:58.66,0:35:02.20,DefaultSingle-J,,0,0,0,,		情報が集まったら  大滝はんが連絡くれることになっとる	
Dialogue: 1,0:35:02.41,0:35:07.17,DefaultSingle-J,,0,0,0,,		会長  緊急の用件とのことで  電話に出ていただけないでしょうか	
Dialogue: 1,0:35:07.59,0:35:08.67,DefaultSingle-J,,0,0,0,,		ああ  構わん	
Dialogue: 1,0:35:08.96,0:35:12.47,DefaultSingle-J,,0,0,0,,		ったく  何なんだ  蘭のヤツ	
Dialogue: 1,0:35:09.96,0:35:13.80,DefaultSingle-J,,0,0,0,,		あ  何  京都府警から	
Dialogue: 1,0:35:14.68,0:35:15.13,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,0:35:16.05,0:35:17.97,DefaultSingle-J,,0,0,0,,		それで矢島君がなんやて	
Dialogue: 1,0:35:18.72,0:35:20.35,DefaultSingle-J,,0,0,0,,		何っ  殺された	
Dialogue: 1,0:35:21.60,0:35:22.06,DefaultSingle-J,,0,0,0,,		服部	
Dialogue: 1,0:35:22.06,0:35:22.35,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:35:22.35,0:35:25.10,DefaultSingle-J,,0,0,0,,		分かった  すぐにキャンセルしてそっちに向う	
Dialogue: 1,0:35:23.23,0:35:25.65,DefaultSingle-J,,0,0,0,,		おい  こら  お前ら  ちょっと待て	
Dialogue: 1,0:35:31.03,0:35:32.03,DefaultSingle-J,,0,0,0,,		ご苦労さまです	
Dialogue: 1,0:35:35.66,0:35:38.57,DefaultSingle-J,,0,0,0,,		ちょっと  君たち  ここは立ち入り禁止やで	
Dialogue: 1,0:35:39.08,0:35:41.04,DefaultSingle-J,,0,0,0,,		毛利小五郎の連れのもんです	
Dialogue: 1,0:35:41.24,0:35:42.66,DefaultSingle-J,,0,0,0,,		何をアホなことを	
Dialogue: 1,0:35:42.45,0:35:45.08,DefaultSingle-J,,0,0,0,,		この子らやったら通してかまへんよ	
Dialogue: 1,0:35:46.04,0:35:47.96,DefaultSingle-J,,0,0,0,,		お久しぶりですなあ  お二人さん	
Dialogue: 1,0:35:48.71,0:35:50.17,DefaultSingle-J,,0,0,0,,		綾小路警部	
Dialogue: 1,0:35:51.75,0:35:55.93,DefaultSingle-J,,0,0,0,,		殺されたんは矢島俊弥さん  造り酒屋の御曹司で	
Dialogue: 1,0:35:56.09,0:35:58.30,DefaultSingle-J,,0,0,0,,		この豪邸に１人で住んではったそうや	
Dialogue: 1,0:35:58.89,0:36:04.56,DefaultSingle-J,,0,0,0,,		死亡推定時刻は早朝６時ごろ  遺体発見は８時間後の午後２時	
Dialogue: 1,0:36:04.77,0:36:07.31,DefaultSingle-J,,0,0,0,,		ああ  足元  気ぃつけてください	
Dialogue: 1,0:36:07.60,0:36:09.31,DefaultSingle-J,,0,0,0,,		ハデに  荒らしていきはったんで	
Dialogue: 1,0:36:09.61,0:36:10.65,DefaultSingle-J,,0,0,0,,		あ  ああ	
Dialogue: 1,0:36:10.65,0:36:11.94,DefaultSingle-J,,0,0,0,,		強盗ですと	
Dialogue: 1,0:36:12.44,0:36:16.11,DefaultSingle-J,,0,0,0,,		現場の状況から見て  強盗殺人で間違いないでしょうな	
Dialogue: 1,0:36:16.32,0:36:18.86,DefaultSingle-J,,0,0,0,,		ええ  我々もそう考えてます	
Dialogue: 1,0:36:19.53,0:36:24.54,DefaultSingle-J,,0,0,0,,		何者かが金品を目的に侵入  矢島さんと  ハチ合わせになったと	
Dialogue: 1,0:36:24.70,0:36:28.75,DefaultSingle-J,,0,0,0,,		犯人はとっさに盗もうとしていた日本刀で撲殺	
Dialogue: 1,0:36:29.13,0:36:31.25,DefaultSingle-J,,0,0,0,,		そのあと  金を取って逃げた	
Dialogue: 1,0:36:32.17,0:36:33.92,DefaultSingle-J,,0,0,0,,		なんでや  なんで	
Dialogue: 1,0:36:34.21,0:36:37.22,DefaultSingle-J,,0,0,0,,		見たところ  被害者はカルタをやっていたようですな	
Dialogue: 1,0:36:37.47,0:36:38.47,DefaultSingle-J,,0,0,0,,		ほんまやな	
Dialogue: 1,0:36:39.18,0:36:41.30,DefaultSingle-J,,0,0,0,,		なんでオメーらが入ってきてんだよ	
Dialogue: 1,0:36:41.60,0:36:45.06,DefaultSingle-J,,0,0,0,,		ほな  警部さん  この現場ちょっと調べさせてもらうで	
Dialogue: 1,0:36:45.73,0:36:48.98,DefaultSingle-J,,0,0,0,,		鑑識の作業も終わってますんでお好きなように	
Dialogue: 1,0:36:49.23,0:36:50.86,DefaultSingle-J,,0,0,0,,		いっ  いいのかよ	
Dialogue: 1,0:36:51.02,0:36:54.90,DefaultSingle-J,,0,0,0,,		ただし  凶器の刀は回収させてもらいますよ	
Dialogue: 1,0:36:55.28,0:36:56.65,DefaultSingle-J,,0,0,0,,		ああ  かまへんで	
Dialogue: 1,0:36:57.11,0:37:00.32,DefaultSingle-J,,0,0,0,,		この子らが納得するまで  付き合うたってください	
Dialogue: 1,0:37:00.32,0:37:00.95,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,0:37:01.16,0:37:03.03,DefaultSingle-J,,0,0,0,,		ほな  外で待ってますんで	
Dialogue: 1,0:37:03.49,0:37:05.54,DefaultSingle-J,,0,0,0,,		何か分かったら  教えてくださいね	
Dialogue: 1,0:37:05.54,0:37:06.16,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:37:09.46,0:37:10.50,DefaultSingle-J,,0,0,0,,		どない思う	
Dialogue: 1,0:37:10.75,0:37:14.00,DefaultSingle-J,,0,0,0,,		まだなんとも言えねえが  この右手	
Dialogue: 1,0:37:14.17,0:37:16.51,DefaultSingle-J,,0,0,0,,		ああ  お前も気ぃついたか  工藤	
Dialogue: 1,0:37:16.67,0:37:17.47,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:37:17.63,0:37:20.76,DefaultSingle-J,,0,0,0,,		血がついた物を  だれかがムリに引きぬいた感じだ	
Dialogue: 1,0:37:21.01,0:37:23.43,DefaultSingle-J,,0,0,0,,		この部屋で血のついた物ゆうたら	
Dialogue: 1,0:37:23.85,0:37:25.10,DefaultSingle-J,,0,0,0,,		カルタ札か	
Dialogue: 1,0:37:25.35,0:37:27.64,DefaultSingle-J,,0,0,0,,		ダイイングメッセージに気づいた犯人が	
Dialogue: 1,0:37:27.85,0:37:30.10,DefaultSingle-J,,0,0,0,,		散らばったカルタ札にまぎれ込ませた	
Dialogue: 1,0:37:30.39,0:37:33.44,DefaultSingle-J,,0,0,0,,		こん中から  その札を見つけんのは骨やで	
Dialogue: 1,0:37:33.44,0:37:34.73,DefaultSingle-J,,0,0,0,,		それなら任せろ	
Dialogue: 1,0:37:35.61,0:37:37.82,DefaultSingle-J,,0,0,0,,		そういう解析が得意なヤツがいる	
Dialogue: 1,0:37:39.53,0:37:40.70,DefaultSingle-J,,0,0,0,,		ん  なんや	
Dialogue: 1,0:37:41.28,0:37:43.28,DefaultSingle-J,,0,0,0,,		あのリモコン  血のつき方から見て	
Dialogue: 1,0:37:43.28,0:37:45.62,DefaultSingle-J,,0,0,0,,		被害者のすぐそばにあったはずやのに	
Dialogue: 1,0:37:46.33,0:37:49.54,DefaultSingle-J,,0,0,0,,		すみません  あのテレビ起こしてもええですか	
Dialogue: 1,0:37:49.66,0:37:50.83,DefaultSingle-J,,0,0,0,,		ええ  どうぞ	
Dialogue: 1,0:37:51.04,0:37:51.58,DefaultSingle-J,,0,0,0,,		どうも	
Dialogue: 1,0:37:51.96,0:37:55.09,DefaultSingle-J,,0,0,0,,		殺される直前までリモコンを操作しとったんやったら	
Dialogue: 1,0:37:55.29,0:37:56.59,DefaultSingle-J,,0,0,0,,		何か映っとるかもしれへん	
Dialogue: 1,0:37:59.05,0:38:00.30,DefaultSingle-J,,0,0,0,,		大岡紅葉や	
Dialogue: 1,0:38:00.59,0:38:03.97,DefaultSingle-J,,0,0,0,,		矢島さんは襲われる直前までこれを見てたのか	
Dialogue: 1,0:38:04.80,0:38:05.68,DefaultSingle-J,,0,0,0,,		どうされました	
Dialogue: 1,0:38:06.18,0:38:07.89,DefaultSingle-J,,0,0,0,,		過去の試合のようだが	
Dialogue: 1,0:38:08.10,0:38:14.31,DefaultSingle-J,,0,0,0,,		ああ  第１５回から第２０回  高校生皐月杯争奪戦	
Dialogue: 1,0:38:14.65,0:38:16.65,DefaultSingle-J,,0,0,0,,		矢島さんはなぜこの映像を	
Dialogue: 1,0:38:17.02,0:38:20.61,DefaultSingle-J,,0,0,0,,		決勝戦ともなれば  相当ハイレベルになるからなあ	
Dialogue: 1,0:38:20.95,0:38:23.70,DefaultSingle-J,,0,0,0,,		技のかけ引きから札の並び方まで	
Dialogue: 1,0:38:23.70,0:38:26.49,DefaultSingle-J,,0,0,0,,		見るだけでも参考になるころが多いんや	
Dialogue: 1,0:38:26.74,0:38:29.62,DefaultSingle-J,,0,0,0,,		殺人事件とは関係ないんちゃうかな	
Dialogue: 1,0:38:29.87,0:38:30.83,DefaultSingle-J,,0,0,0,,		えっ  でも	
Dialogue: 1,0:38:30.83,0:38:33.17,DefaultSingle-J,,0,0,0,,		「でもでも」って  うっせ～んだよ	
Dialogue: 1,0:38:33.29,0:38:34.71,DefaultSingle-J,,0,0,0,,		ほら  お前も来い	
Dialogue: 1,0:38:35.08,0:38:36.29,DefaultSingle-J,,0,0,0,,		探偵ごっこはおしまいだ	
Dialogue: 1,0:38:36.67,0:38:38.96,DefaultSingle-J,,0,0,0,,		とうも  みなさん  おさわがせしました	
Dialogue: 1,0:38:35.67,0:38:36.79,DefaultSingle-J,,0,0,0,,		ちょっ  おっちゃん  イタタタ	
Dialogue: 1,0:38:37.00,0:38:38.88,DefaultSingle-J,,0,0,0,,		な  何すんや  イタタタ	
Dialogue: 1,0:38:39.21,0:38:40.46,DefaultSingle-J,,0,0,0,,		え  ええ	
Dialogue: 1,0:38:39.30,0:38:41.34,DefaultSingle-J,,0,0,0,,		おじさん  下ろしてよ	
Dialogue: 1,0:38:41.34,0:38:43.30,DefaultSingle-J,,0,0,0,,		分かった  分かったから放してえな	
Dialogue: 1,0:38:48.47,0:38:51.73,DefaultSingle-J,,0,0,0,,		続いてニュースです  本日午後１時ごろ	
Dialogue: 1,0:38:51.35,0:38:54.56,DefaultSingle-J,,0,0,0,,		またこのニュースか  心配じゃのう	
Dialogue: 1,0:38:51.93,0:38:54.94,DefaultSingle-J,,0,0,0,,		大阪府大阪市の日売りテレビで大きな…	
Dialogue: 1,0:38:55.06,0:38:57.73,DefaultSingle-J,,0,0,0,,		あ  哀君  なんで消してしまうんじゃ	
Dialogue: 1,0:38:58.15,0:39:02.11,DefaultSingle-J,,0,0,0,,		このニュースが流れるたびに心配してたら  身がもたないわよ	
Dialogue: 1,0:39:02.32,0:39:03.36,DefaultSingle-J,,0,0,0,,		しかし	
Dialogue: 1,0:39:03.36,0:39:05.36,DefaultSingle-J,,0,0,0,,		子供たちとは連絡取れたんでしょ	
Dialogue: 1,0:39:05.74,0:39:08.99,DefaultSingle-J,,0,0,0,,		じゃが  新一からの折り返しが来とらんのじゃ	
Dialogue: 1,0:39:11.83,0:39:12.50,DefaultSingle-J,,0,0,0,,		ほら	
Dialogue: 1,0:39:12.71,0:39:14.00,DefaultSingle-J,,0,0,0,,		ウワサをすれば…よ	
Dialogue: 1,0:39:14.12,0:39:16.13,DefaultSingle-J,,0,0,0,,		おおっ  あとで代わってくれ	
Dialogue: 1,0:39:16.29,0:39:16.88,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 1,0:39:17.75,0:39:21.42,DefaultSingle-J,,0,0,0,,		あなたねえ  連絡もよこさないで  一体何してたの	
Dialogue: 1,0:39:21.71,0:39:23.72,DefaultSingle-J,,0,0,0,,		博士ものすごく心配してるわよ	
Dialogue: 1,0:39:23.84,0:39:26.80,DefaultSingle-J,,0,0,0,,		わりぃわりぃ  こっちもいろいろ大変でな	
Dialogue: 1,0:39:27.09,0:39:28.68,DefaultSingle-J,,0,0,0,,		で  用件は何	
Dialogue: 1,0:39:28.85,0:39:31.72,DefaultSingle-J,,0,0,0,,		さっき  お前のパンコンに写真を送ったんだけど	
Dialogue: 1,0:39:32.18,0:39:34.94,DefaultSingle-J,,0,0,0,,		その写真に写ってるカルタを調べてほしいんだ	
Dialogue: 1,0:39:35.73,0:39:40.15,DefaultSingle-J,,0,0,0,,		爆弾事件に巻き込まれたと思ったら  今度は血染めのカルタ札	
Dialogue: 1,0:39:40.48,0:39:44.32,DefaultSingle-J,,0,0,0,,		その中から  被害者がにぎりしめていた札をつき止めてほしいんだ	
Dialogue: 1,0:39:44.78,0:39:47.24,DefaultSingle-J,,0,0,0,,		オメー  そういう  ネチネチ組み立てんの得意だろ	
Dialogue: 1,0:39:47.95,0:39:49.70,DefaultSingle-J,,0,0,0,,		ネチネチねえ  あっ	
Dialogue: 1,0:39:50.58,0:39:52.79,DefaultSingle-J,,0,0,0,,		１枚だけ人物写真が入ってるけど	
Dialogue: 1,0:39:53.00,0:39:56.25,DefaultSingle-J,,0,0,0,,		ああ  ついでに  その人についても調べてくれねえか	
Dialogue: 1,0:39:56.67,0:39:58.17,DefaultSingle-J,,0,0,0,,		この人もカルタがらみ	
Dialogue: 1,0:39:58.29,0:40:00.34,DefaultSingle-J,,0,0,0,,		まあな  オレはそうにらんでる	
Dialogue: 1,0:40:01.46,0:40:04.13,DefaultSingle-J,,0,0,0,,		とにかく  やってみるから少し時間ちょうだい	
Dialogue: 1,0:40:04.30,0:40:06.05,DefaultSingle-J,,0,0,0,,		サンキュー  頼りにしてるぜ	
Dialogue: 1,0:40:06.26,0:40:06.84,DefaultSingle-J,,0,0,0,,		じゃあな	
Dialogue: 1,0:40:06.97,0:40:08.47,DefaultSingle-J,,0,0,0,,		ちょっと  博士が	
Dialogue: 1,0:40:09.43,0:40:10.72,DefaultSingle-J,,0,0,0,,		えげつな	
Dialogue: 1,0:40:11.06,0:40:14.98,DefaultSingle-J,,0,0,0,,		そうなると狙われてるんは皐月会の主要メンバーやな	
Dialogue: 1,0:40:15.10,0:40:17.31,DefaultSingle-J,,0,0,0,,		ああ  マークすべきは二人	
Dialogue: 1,0:40:17.69,0:40:19.19,DefaultSingle-J,,0,0,0,,		阿知波さんはオレが見張る	
Dialogue: 1,0:40:19.52,0:40:21.86,DefaultSingle-J,,0,0,0,,		確か宿泊するホテルが一緒のはずだ	
Dialogue: 1,0:40:22.40,0:40:24.69,DefaultSingle-J,,0,0,0,,		ほんならオレは大岡紅葉や	
Dialogue: 1,0:40:26.49,0:40:29.16,DefaultSingle-J,,0,0,0,,		ちょっと  ちょっと  なんですか  あなたは	
Dialogue: 1,0:40:29.16,0:40:31.91,DefaultSingle-J,,0,0,0,,		皐月会のもんや  通してくれ	
Dialogue: 1,0:40:31.91,0:40:34.50,DefaultSingle-J,,0,0,0,,		待ってください  今  確認を取りますんで	
Dialogue: 1,0:40:34.50,0:40:35.58,DefaultSingle-J,,0,0,0,,		関根君	
Dialogue: 1,0:40:36.00,0:40:40.08,DefaultSingle-J,,0,0,0,,		今まで何をしとったんや  何度も連絡したんやぞ	
Dialogue: 1,0:40:40.08,0:40:41.38,DefaultSingle-J,,0,0,0,,		すんません  会長	
Dialogue: 1,0:40:41.67,0:40:47.01,DefaultSingle-J,,0,0,0,,		ゆうべ深酒してもうて  携帯の充電切れにも気づかんと寝てしもたから	
Dialogue: 1,0:40:47.09,0:40:48.55,DefaultSingle-J,,0,0,0,,		まったくもう	
Dialogue: 1,0:40:48.55,0:40:50.18,DefaultSingle-J,,0,0,0,,		いやあ  目ぇ覚ましたら	
Dialogue: 1,0:40:50.34,0:40:53.31,DefaultSingle-J,,0,0,0,,		ニュースで  テレビ局が爆発したとか言うてるし	
Dialogue: 1,0:40:53.56,0:40:57.64,DefaultSingle-J,,0,0,0,,		会に連絡したら  会長は矢島のところで  ボクを捜しとる言うし	
Dialogue: 1,0:40:57.81,0:41:00.27,DefaultSingle-J,,0,0,0,,		慌てて来たら  なんや  この騒ぎやし	
Dialogue: 1,0:41:00.60,0:41:03.52,DefaultSingle-J,,0,0,0,,		こない警察が集まって  矢島は  どないしましてん	
Dialogue: 1,0:41:04.15,0:41:07.65,DefaultSingle-J,,0,0,0,,		矢島君は殺されてしもうた	
Dialogue: 1,0:41:08.07,0:41:08.78,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:41:09.11,0:41:11.66,DefaultSingle-J,,0,0,0,,		強盗の仕業ちゅうことらしい	
Dialogue: 1,0:41:11.82,0:41:13.66,DefaultSingle-J,,0,0,0,,		渡り廊下にあった刀で	
Dialogue: 1,0:41:13.83,0:41:15.83,DefaultSingle-J,,0,0,0,,		刀で  そんな	
Dialogue: 1,0:41:16.04,0:41:18.21,DefaultSingle-J,,0,0,0,,		阿知波さん  こちらの方は	
Dialogue: 1,0:41:18.33,0:41:19.58,DefaultSingle-J,,0,0,0,,		あっ  これはすんません	
Dialogue: 1,0:41:19.79,0:41:24.09,DefaultSingle-J,,0,0,0,,		皐月会  会員でカメラマンやっとります  関根康史言います	
Dialogue: 1,0:41:24.46,0:41:27.05,DefaultSingle-J,,0,0,0,,		関根君は矢島君のライバルで	
Dialogue: 1,0:41:27.21,0:41:31.34,DefaultSingle-J,,0,0,0,,		ここ二年  皐月杯決勝は  この二人の対戦やったんです	
Dialogue: 1,0:41:31.84,0:41:33.55,DefaultSingle-J,,0,0,0,,		まあ  二年連続負けで	
Dialogue: 1,0:41:33.80,0:41:36.22,DefaultSingle-J,,0,0,0,,		今年こそはと  思ってましたんやけど	
Dialogue: 1,0:41:36.93,0:41:39.48,DefaultSingle-J,,0,0,0,,		もう彼とも対戦できんのですね	
Dialogue: 1,0:41:39.94,0:41:43.61,DefaultSingle-J,,0,0,0,,		それで  大会は予定通り開催するんでしょうか	
Dialogue: 1,0:41:43.73,0:41:46.98,DefaultSingle-J,,0,0,0,,		ああ  それなんですが  どないしたもんかと	
Dialogue: 1,0:41:46.98,0:41:48.61,DefaultSingle-J,,0,0,0,,		会長  あきませんでへん	
Dialogue: 1,0:41:48.82,0:41:52.24,DefaultSingle-J,,0,0,0,,		矢島の死で  伝統ある皐月杯が中止になってしもたら	
Dialogue: 1,0:41:52.53,0:41:56.08,DefaultSingle-J,,0,0,0,,		矢島はムダ死にどころやない  殴られ損や	
Dialogue: 1,0:41:56.08,0:41:59.25,DefaultSingle-J,,0,0,0,,		関根君  言葉を慎みたまえ	
Dialogue: 1,0:41:59.25,0:42:01.58,DefaultSingle-J,,0,0,0,,		いやあ  すんません  つい	
Dialogue: 1,0:42:01.79,0:42:03.54,DefaultSingle-J,,0,0,0,,		京都府警のもんですが	
Dialogue: 1,0:42:03.92,0:42:06.30,DefaultSingle-J,,0,0,0,,		2  3伺いたいことがあるんですけど	
Dialogue: 1,0:42:06.55,0:42:08.34,DefaultSingle-J,,0,0,0,,		少しお時間  頂けますか	
Dialogue: 1,0:42:08.46,0:42:10.97,DefaultSingle-J,,0,0,0,,		ああ  そらもう  なんでも答えまっせ	
Dialogue: 1,0:42:11.18,0:42:12.05,DefaultSingle-J,,0,0,0,,		ではこちらへ	
Dialogue: 1,0:42:12.26,0:42:13.05,DefaultSingle-J,,0,0,0,,		はいはい	
Dialogue: 1,0:42:13.47,0:42:17.14,DefaultSingle-J,,0,0,0,,		毛利さん  私はそろそろ大阪に戻るんですけど	
Dialogue: 1,0:42:14.97,0:42:18.02,DefaultSingle-J,,0,0,0,,		なあ  工藤  オレ  犯人分かってしもたで	
Dialogue: 1,0:42:17.14,0:42:19.68,DefaultSingle-J,,0,0,0,,		ええ  そうですな  ご一緒します	
Dialogue: 1,0:42:18.31,0:42:22.52,DefaultSingle-J,,0,0,0,,		オレもだ  矢島さん殺しは  多分  あの人だ	
Dialogue: 1,0:42:22.73,0:42:25.40,DefaultSingle-J,,0,0,0,,		だが皐月会を狙ったと思われる	
Dialogue: 1,0:42:25.40,0:42:28.86,DefaultSingle-J,,0,0,0,,		テレビ局爆破も彼の犯行と考えるには  まだ	
Dialogue: 1,0:42:29.15,0:42:30.11,DefaultSingle-J,,0,0,0,,		せやな	
Dialogue: 1,0:42:30.36,0:42:33.45,DefaultSingle-J,,0,0,0,,		阿知波さんと紅葉に関してはさっき決めた通り	
Dialogue: 1,0:42:33.57,0:42:35.28,DefaultSingle-J,,0,0,0,,		見張っといたほうが無難やな	
Dialogue: 1,0:42:35.49,0:42:36.16,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:42:41.25,0:42:42.33,DefaultSingle-J,,0,0,0,,		一番	
Dialogue: 1,0:42:42.33,0:42:43.58,DefaultSingle-J,,0,0,0,,		二番	
Dialogue: 1,0:42:43.58,0:42:45.92,DefaultSingle-J,,0,0,0,,		二人とも狡い  待って	
Dialogue: 1,0:42:46.29,0:42:48.96,DefaultSingle-J,,0,0,0,,		うわっ  むっちゃ広い部屋やな	
Dialogue: 1,0:42:49.13,0:42:51.01,DefaultSingle-J,,0,0,0,,		園子が予約してくれたの	
Dialogue: 1,0:42:51.38,0:42:54.30,DefaultSingle-J,,0,0,0,,		ほら  園子も来る気満々だったでしょ	
Dialogue: 1,0:42:54.43,0:42:57.89,DefaultSingle-J,,0,0,0,,		だから日売テレビに近いホテル選んでくれたみたい	
Dialogue: 1,0:42:58.14,0:43:00.14,DefaultSingle-J,,0,0,0,,		さすが鈴木財閥	
Dialogue: 1,0:43:01.10,0:43:02.39,DefaultSingle-J,,0,0,0,,		ええ  そう	
Dialogue: 1,0:43:03.85,0:43:07.69,DefaultSingle-J,,0,0,0,,		夜通し特訓するらしいから  夜食も用意してあげて	
Dialogue: 1,0:43:08.19,0:43:09.69,DefaultSingle-J,,0,0,0,,		んじゃ  よろしく	
Dialogue: 1,0:43:10.40,0:43:13.99,DefaultSingle-J,,0,0,0,,		ったく  なんで  私が  こんなことまで	
Dialogue: 1,0:43:14.53,0:43:17.74,DefaultSingle-J,,0,0,0,,		必死で友人を応援する  あなたの姿をね	
Dialogue: 1,0:43:20.41,0:43:21.54,DefaultSingle-J,,0,0,0,,		ま  いっか	
Dialogue: 1,0:43:22.33,0:43:23.96,DefaultSingle-J,,0,0,0,,		さあ  特訓開始や	
Dialogue: 1,0:43:24.21,0:43:25.75,DefaultSingle-J,,0,0,0,,		オレたちも手伝うぞ	
Dialogue: 1,0:43:25.75,0:43:28.42,DefaultSingle-J,,0,0,0,,		私たちにできることがあったら  なんでも言って	
Dialogue: 1,0:43:28.42,0:43:30.25,DefaultSingle-J,,0,0,0,,		全面的にバックアップします	
Dialogue: 1,0:43:30.25,0:43:31.13,DefaultSingle-J,,0,0,0,,		みんな	
Dialogue: 1,0:43:31.13,0:43:32.59,DefaultSingle-J,,0,0,0,,		ほんま  おおきに	
Dialogue: 1,0:43:32.59,0:43:34.09,DefaultSingle-J,,0,0,0,,		あっ  電話だ	
Dialogue: 1,0:43:34.38,0:43:35.55,DefaultSingle-J,,0,0,0,,		誰からだ	
Dialogue: 1,0:43:35.55,0:43:36.51,DefaultSingle-J,,0,0,0,,		博士からです	
Dialogue: 1,0:43:36.51,0:43:38.18,DefaultSingle-J,,0,0,0,,		歩美も話した～い	
Dialogue: 1,0:43:38.18,0:43:39.60,DefaultSingle-J,,0,0,0,,		みんなで話そうぜ	
Dialogue: 1,0:43:39.60,0:43:40.89,DefaultSingle-J,,0,0,0,,		ええ  そうしましょう	
Dialogue: 1,0:43:41.06,0:43:43.27,DefaultSingle-J,,0,0,0,,		お姉さんたちは特訓頑張ってください	
Dialogue: 1,0:43:43.35,0:43:46.02,DefaultSingle-J,,0,0,0,,		私たちは邪魔しないように  あっち行ってるね	
Dialogue: 1,0:43:46.85,0:43:49.27,DefaultSingle-J,,0,0,0,,		全面的にバックアップって	
Dialogue: 1,0:43:49.57,0:43:50.73,DefaultSingle-J,,0,0,0,,		こういうこと	
Dialogue: 1,0:43:51.65,0:43:53.36,DefaultSingle-J,,0,0,0,,		おお  映った  映った	
Dialogue: 1,0:43:53.61,0:43:55.78,DefaultSingle-J,,0,0,0,,		みんな  あれから何もなかったかね	
Dialogue: 1,0:43:55.90,0:43:56.57,DefaultSingle-J,,0,0,0,,		おう	
Dialogue: 1,0:43:56.57,0:43:57.61,DefaultSingle-J,,0,0,0,,		大丈夫だったよ	
Dialogue: 1,0:43:57.61,0:43:59.12,DefaultSingle-J,,0,0,0,,		ボクたちもうホテルにいます	
Dialogue: 1,0:43:59.28,0:44:01.08,DefaultSingle-J,,0,0,0,,		そうか  ちょうど良かった	
Dialogue: 1,0:44:01.08,0:44:01.58,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:44:01.58,0:44:02.20,DefaultSingle-J,,0,0,0,,		まさか	
Dialogue: 1,0:44:02.41,0:44:04.71,DefaultSingle-J,,0,0,0,,		ジャジャ～ン  お待ちかね	
Dialogue: 1,0:44:04.71,0:44:06.79,DefaultSingle-J,,0,0,0,,		博士のクイズコーナー	
Dialogue: 1,0:44:07.46,0:44:09.67,DefaultSingle-J,,0,0,0,,		そのために電話してきたんですか	
Dialogue: 1,0:44:10.09,0:44:11.25,DefaultSingle-J,,0,0,0,,		では急げじゃ	
Dialogue: 1,0:44:11.42,0:44:14.21,DefaultSingle-J,,0,0,0,,		競技カルタは  その独特のスタイルが	
Dialogue: 1,0:44:14.21,0:44:18.01,DefaultSingle-J,,0,0,0,,		日本の伝統的作業に  似ていると言われておるが	
Dialogue: 1,0:44:18.14,0:44:19.76,DefaultSingle-J,,0,0,0,,		それは次のうち  どれ	
Dialogue: 1,0:44:20.14,0:44:21.56,DefaultSingle-J,,0,0,0,,		１  茶摘み	
Dialogue: 1,0:44:21.89,0:44:23.39,DefaultSingle-J,,0,0,0,,		２  凧揚げ	
Dialogue: 1,0:44:23.81,0:44:25.39,DefaultSingle-J,,0,0,0,,		３  餅つき	
Dialogue: 1,0:44:25.60,0:44:27.10,DefaultSingle-J,,0,0,0,,		４  稲刈り	
Dialogue: 1,0:44:27.98,0:44:31.36,DefaultSingle-J,,0,0,0,,		カルタを取って  札を積んでいくから  茶摘みかなあ	
Dialogue: 1,0:44:31.36,0:44:34.32,DefaultSingle-J,,0,0,0,,		凧揚げか  たこ焼き食いて	
Dialogue: 1,0:44:34.32,0:44:36.95,DefaultSingle-J,,0,0,0,,		お手付きって  言いますから  餅つきでしょうか	
Dialogue: 1,0:44:37.20,0:44:38.95,DefaultSingle-J,,0,0,0,,		ファイナルアンサーかのう	
Dialogue: 1,0:44:39.11,0:44:40.95,DefaultSingle-J,,0,0,0,,		答えは４の稲刈りよ	
Dialogue: 1,0:44:40.45,0:44:41.62,DefaultSingle-J,,0,0,0,,		あ  哀君	
Dialogue: 1,0:44:41.87,0:44:44.83,DefaultSingle-J,,0,0,0,,		稲は田圃になる  その田圃を刈るから	
Dialogue: 1,0:44:44.95,0:44:45.66,DefaultSingle-J,,0,0,0,,		あ	
Dialogue: 1,0:44:45.66,0:44:46.58,DefaultSingle-J,,0,0,0,,		カルタだ	
Dialogue: 1,0:44:46.58,0:44:47.54,DefaultSingle-J,,0,0,0,,		え  え	
Dialogue: 1,0:44:47.66,0:44:49.92,DefaultSingle-J,,0,0,0,,		あいもそっけも  なかりけるかも	
Dialogue: 1,0:44:50.13,0:44:51.13,DefaultSingle-J,,0,0,0,,		あなたたち	
Dialogue: 1,0:44:51.29,0:44:54.13,DefaultSingle-J,,0,0,0,,		旅行中だからって  あんまり夜更かししちゃダメよ	
Dialogue: 1,0:44:54.30,0:44:55.42,DefaultSingle-J,,0,0,0,,		は～い	
Dialogue: 1,0:44:56.84,0:44:57.97,DefaultSingle-J,,0,0,0,,		じゃ  切るわね	
Dialogue: 1,0:44:58.18,0:44:59.30,DefaultSingle-J,,0,0,0,,		は～い	
Dialogue: 1,0:44:59.64,0:45:01.47,DefaultSingle-J,,0,0,0,,		もうこんな時間だったんだね	
Dialogue: 1,0:45:01.64,0:45:03.93,DefaultSingle-J,,0,0,0,,		今日はいろいろありましたからね	
Dialogue: 1,0:45:02.68,0:45:04.22,DefaultSingle-J,,0,0,0,,		お父さんたち  遅いね	
Dialogue: 1,0:45:03.93,0:45:06.43,DefaultSingle-J,,0,0,0,,		うな重食いたらいいよな	
Dialogue: 1,0:45:04.43,0:45:06.56,DefaultSingle-J,,0,0,0,,		平次も  まだ一緒なんやろか	
Dialogue: 1,0:45:06.89,0:45:09.39,DefaultSingle-J,,0,0,0,,		そんなに気になるんなら電話してみたら	
Dialogue: 1,0:45:09.02,0:45:10.98,DefaultSingle-J,,0,0,0,,		ルームサービスでも頼みますから	
Dialogue: 1,0:45:09.56,0:45:11.52,DefaultSingle-J,,0,0,0,,		あっ  そ  そやね	
Dialogue: 1,0:45:16.86,0:45:17.95,DefaultSingle-J,,0,0,0,,		なんや  和葉	
Dialogue: 1,0:45:18.11,0:45:19.45,DefaultSingle-J,,0,0,0,,		「なんや」やないわ	
Dialogue: 1,0:45:19.57,0:45:22.12,DefaultSingle-J,,0,0,0,,		こないな時間まで  どこほっつき歩いてんねん	
Dialogue: 1,0:45:22.53,0:45:23.87,DefaultSingle-J,,0,0,0,,		えっ  京都	
Dialogue: 1,0:45:23.99,0:45:25.12,DefaultSingle-J,,0,0,0,,		どういうことなん	
Dialogue: 1,0:45:25.20,0:45:28.16,DefaultSingle-J,,0,0,0,,		悪いな  ヤボ用で  今日は送れそうにないから	
Dialogue: 1,0:45:28.16,0:45:29.21,DefaultSingle-J,,0,0,0,,		先に帰っといてくれ	
Dialogue: 1,0:45:29.46,0:45:33.71,DefaultSingle-J,,0,0,0,,		なんやのん  それ  カルタの特訓に付き合うてもらお思っとったのに	
Dialogue: 1,0:45:33.92,0:45:34.80,DefaultSingle-J,,0,0,0,,		特訓？	
Dialogue: 1,0:45:34.80,0:45:38.76,DefaultSingle-J,,0,0,0,,		アタシが未来子の代わりに  カルタの試合に出ることになったんや	
Dialogue: 1,0:45:38.76,0:45:41.34,DefaultSingle-J,,0,0,0,,		お前  カルタの試合なんて出たことないやないか	
Dialogue: 1,0:45:41.34,0:45:43.60,DefaultSingle-J,,0,0,0,,		そやから  特訓するんやないの	
Dialogue: 1,0:45:43.93,0:45:47.39,DefaultSingle-J,,0,0,0,,		子供の頃  平次  カルタやって  めっちゃ強かったやろ	
Dialogue: 1,0:45:48.06,0:45:49.31,DefaultSingle-J,,0,0,0,,		ああ  そう言うたら	
Dialogue: 1,0:45:49.31,0:45:53.23,DefaultSingle-J,,0,0,0,,		小学校ん時  どっかのカルタ大会に  飛び入り参加したことあったなあ	
Dialogue: 1,0:45:53.23,0:45:55.57,DefaultSingle-J,,0,0,0,,		平次  いきなり優勝してもうたから	
Dialogue: 1,0:45:55.57,0:45:56.98,DefaultSingle-J,,0,0,0,,		もうビックリしたわ	
Dialogue: 1,0:45:57.36,0:45:59.99,DefaultSingle-J,,0,0,0,,		昔のこっちゃ  よう覚えてへんわ	
Dialogue: 1,0:46:00.20,0:46:01.86,DefaultSingle-J,,0,0,0,,		アタシは  よう覚えてるで	
Dialogue: 1,0:46:02.70,0:46:04.83,DefaultSingle-J,,0,0,0,,		未来子から  部員  頼まれた時も	
Dialogue: 1,0:46:05.03,0:46:08.41,DefaultSingle-J,,0,0,0,,		真っ先に頭に浮かんだんは  その時のことやってんもん	
Dialogue: 1,0:46:08.54,0:46:13.33,DefaultSingle-J,,0,0,0,,		ほ  で  昔話は終わったんか  そろそろ切るで	
Dialogue: 1,0:46:13.33,0:46:15.13,DefaultSingle-J,,0,0,0,,		なんやの  その言い方	
Dialogue: 1,0:46:15.50,0:46:18.42,DefaultSingle-J,,0,0,0,,		アタシとの電話  そんなにはよ終わらせたいんか	
Dialogue: 1,0:46:18.84,0:46:20.76,DefaultSingle-J,,0,0,0,,		そんなこと言うてへんやないか	
Dialogue: 1,0:46:20.76,0:46:23.47,DefaultSingle-J,,0,0,0,,		へいへい  平次なんかおらんくっても大丈夫や	
Dialogue: 1,0:46:23.47,0:46:25.01,DefaultSingle-J,,0,0,0,,		はぁ  どないしてん	
Dialogue: 1,0:46:25.05,0:46:27.26,DefaultSingle-J,,0,0,0,,		もうええ  平次のドアホ	
Dialogue: 1,0:46:29.06,0:46:31.10,DefaultSingle-J,,0,0,0,,		もう  なんやねん  平次	
Dialogue: 1,0:46:33.40,0:46:35.69,DefaultSingle-J,,0,0,0,,		ったく  なんや  あいつ	
Dialogue: 1,0:46:37.11,0:46:38.65,DefaultSingle-J,,0,0,0,,		しゃ  ないなあ	
Dialogue: 1,0:46:41.57,0:46:44.70,DefaultSingle-J,,0,0,0,,		ああ  オレや  ちょっと頼みたいことがあんねんけどな	
Dialogue: 1,0:46:45.03,0:46:46.62,DefaultSingle-J,,0,0,0,,		ああ  そうや  頼むわ	
Dialogue: 1,0:46:49.54,0:46:50.83,DefaultSingle-J,,0,0,0,,		疲れたぜ	
Dialogue: 1,0:46:51.08,0:46:52.33,DefaultSingle-J,,0,0,0,,		おかえり  おっちゃん	
Dialogue: 1,0:46:52.33,0:46:57.84,DefaultSingle-J,,0,0,0,,		ああ  まさか大阪に来てまで  事件に巻き込まれるとは思わなかったぜ	
Dialogue: 1,0:46:59.21,0:47:01.47,DefaultSingle-J,,0,0,0,,		あれ  お父さん  コナン君は	
Dialogue: 1,0:47:01.67,0:47:04.68,DefaultSingle-J,,0,0,0,,		一緒に帰りたいっつから  車に乗せてやったら	
Dialogue: 1,0:47:04.97,0:47:06.43,DefaultSingle-J,,0,0,0,,		ホテル着くなり  今度は	
Dialogue: 1,0:47:06.68,0:47:09.39,DefaultSingle-J,,0,0,0,,		阿知波さんに話があるとか言って  ついてったぞ	
Dialogue: 1,0:47:09.64,0:47:13.27,DefaultSingle-J,,0,0,0,,		ええっ  もう  コナン君ったら	
Dialogue: 1,0:47:13.73,0:47:15.52,DefaultSingle-J,,0,0,0,,		例のあの人が犯人なら	
Dialogue: 1,0:47:15.77,0:47:18.61,DefaultSingle-J,,0,0,0,,		今夜  阿知波さんが狙われることはなさそうだが	
Dialogue: 1,0:47:25.07,0:47:26.37,DefaultSingle-J,,0,0,0,,		どうしたの  蘭姉ちゃん	
Dialogue: 1,0:47:26.78,0:47:28.12,DefaultSingle-J,,0,0,0,,		用事  もう済んだ	
Dialogue: 1,0:47:28.24,0:47:29.24,DefaultSingle-J,,0,0,0,,		あ  うん	
Dialogue: 1,0:47:29.33,0:47:31.16,DefaultSingle-J,,0,0,0,,		じゃ  早く部屋に戻ってきてね	
Dialogue: 1,0:47:31.45,0:47:33.46,DefaultSingle-J,,0,0,0,,		あんなことがあったから  心配で	
Dialogue: 1,0:47:33.54,0:47:35.67,DefaultSingle-J,,0,0,0,,		うん  分かった  すぐに行く	
Dialogue: 1,0:47:42.38,0:47:45.63,DefaultSingle-J,,0,0,0,,		よし  これで外に出たとしても追えるな	
Dialogue: 1,0:47:45.84,0:47:48.22,DefaultSingle-J,,0,0,0,,		あれ  あの人って確か	
Dialogue: 1,0:47:49.43,0:47:50.89,DefaultSingle-J,,0,0,0,,		なんで  ここにいるんだ	
Dialogue: 1,0:47:55.02,0:47:56.60,DefaultSingle-J,,0,0,0,,		「…くらむ」	
Dialogue: 1,0:00:00.00,0:00:00.00,DefaultSingle-J,,0,0,0,,		「契りき…」	
Dialogue: 1,0:47:57.94,0:47:59.06,DefaultSingle-J,,0,0,0,,		うひゃっ	
Dialogue: 1,0:47:59.06,0:48:01.69,DefaultSingle-J,,0,0,0,,		うわあ  姉ちゃん  すげ～なあ	
Dialogue: 1,0:48:01.94,0:48:04.44,DefaultSingle-J,,0,0,0,,		やっぱり  私じゃ  練習相手は無理よ	
Dialogue: 1,0:48:04.44,0:48:07.45,DefaultSingle-J,,0,0,0,,		こら  危ねえだろがよ  もうちょっとで	
Dialogue: 1,0:48:07.45,0:48:08.24,DefaultSingle-J,,0,0,0,,		ただいま	
Dialogue: 1,0:48:08.24,0:48:09.12,DefaultSingle-J,,0,0,0,,		あっ  コナン君	
Dialogue: 1,0:48:09.49,0:48:11.74,DefaultSingle-J,,0,0,0,,		頼もしい助っ人が来てくれたよ	
Dialogue: 1,0:48:13.62,0:48:14.16,DefaultSingle-J,,0,0,0,,		え	
Dialogue: 1,0:48:14.16,0:48:14.70,DefaultSingle-J,,0,0,0,,		あれ	
Dialogue: 1,0:48:14.70,0:48:15.62,DefaultSingle-J,,0,0,0,,		誰だ	
Dialogue: 1,0:48:16.16,0:48:19.00,DefaultSingle-J,,0,0,0,,		へっ  平次んとこのおばちゃん	
Dialogue: 1,0:48:19.38,0:48:21.13,DefaultSingle-J,,0,0,0,,		平次から聞きましてな	
Dialogue: 1,0:48:21.50,0:48:23.05,DefaultSingle-J,,0,0,0,,		駆け付けましたんや	
Dialogue: 1,0:48:23.17,0:48:24.55,DefaultSingle-J,,0,0,0,,		ええっ  なんで	
Dialogue: 1,0:48:28.09,0:48:32.06,DefaultSingle-J,,0,0,0,,		和葉ちゃんの手伝いや  カルタの特訓するんやろ	
Dialogue: 1,0:48:32.22,0:48:33.72,DefaultSingle-J,,0,0,0,,		そら  そやけど	
Dialogue: 1,0:48:33.85,0:48:35.81,DefaultSingle-J,,0,0,0,,		私が相手になりましょ	
Dialogue: 1,0:48:36.02,0:48:39.52,DefaultSingle-J,,0,0,0,,		元クイーンの私では  力不足かもしれまへんけど	
Dialogue: 1,0:48:39.77,0:48:40.98,DefaultSingle-J,,0,0,0,,		元クイーン	
Dialogue: 1,0:48:41.23,0:48:43.23,DefaultSingle-J,,0,0,0,,		他ならぬ平次の頼みや	
Dialogue: 1,0:48:43.48,0:48:46.99,DefaultSingle-J,,0,0,0,,		私の持ってる全てを  あなたに教えてあげますわ	
Dialogue: 1,0:48:47.15,0:48:51.16,DefaultSingle-J,,0,0,0,,		ただ時間が足らんさかい  稽古はきついもんになりまっせ	
Dialogue: 1,0:48:51.53,0:48:53.16,DefaultSingle-J,,0,0,0,,		それでも  よろしいか	
Dialogue: 1,0:48:54.87,0:48:57.21,DefaultSingle-J,,0,0,0,,		はい  よろしくお願いします	
Dialogue: 1,0:49:04.55,0:49:07.55,DefaultSingle-J,,0,0,0,,		来ると思てたで  綾小路警部	
Dialogue: 1,0:49:08.26,0:49:10.93,DefaultSingle-J,,0,0,0,,		考えてることは  一緒のようですな	
Dialogue: 1,0:49:11.22,0:49:11.89,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,0:49:12.01,0:49:14.76,DefaultSingle-J,,0,0,0,,		小さい探偵さんは  いてはらへんのですか	
Dialogue: 1,0:49:15.02,0:49:17.18,DefaultSingle-J,,0,0,0,,		あいつには阿知波さんを見張ってもろてる	
Dialogue: 1,0:49:17.48,0:49:20.44,DefaultSingle-J,,0,0,0,,		なるほど  いいチームワークですな	
Dialogue: 1,0:49:20.69,0:49:23.94,DefaultSingle-J,,0,0,0,,		せやけど  こっちを選んだことを後悔してるわ	
Dialogue: 1,0:49:24.40,0:49:28.65,DefaultSingle-J,,0,0,0,,		まさかこんなデカい家に住んでるとは  思えへんかったからのう	
Dialogue: 1,0:49:36.87,0:49:38.41,DefaultSingle-J,,0,0,0,,		お勤め  ご苦労様です	
Dialogue: 1,0:49:38.50,0:49:39.62,DefaultSingle-J,,0,0,0,,		あ  はあ	
Dialogue: 1,0:49:39.83,0:49:44.25,DefaultSingle-J,,0,0,0,,		わたくし  紅葉お嬢様にお仕えしている伊織と申します	
Dialogue: 1,0:49:45.05,0:49:47.76,DefaultSingle-J,,0,0,0,,		少し休憩して  お茶でもいかがですか	
Dialogue: 1,0:49:53.68,0:49:56.06,DefaultSingle-J,,0,0,0,,		心配して来てくれはったんや	
Dialogue: 1,0:49:57.60,0:49:59.48,DefaultSingle-J,,0,0,0,,		ウチの未来の旦那さん	
Dialogue: 1,0:50:08.82,0:50:15.37,DefaultSingle-J,,0,0,0,,		「濡れにぞ濡れし  色は変はらず」	
Dialogue: 1,0:50:14.12,0:50:14.91,DefaultSingle-J,,0,0,0,,		いけね	
Dialogue: 1,0:50:15.37,0:50:17.45,DefaultSingle-J,,0,0,0,,		どうやらホテルからは出ていないようだな	
Dialogue: 1,0:50:18.04,0:50:23.58,DefaultSingle-J,,0,0,0,,		「住の江の  岸による波  よるさへや」	
Dialogue: 1,0:50:20.46,0:50:22.46,DefaultSingle-J,,0,0,0,,		なかなかの頑張りや	
Dialogue: 1,0:50:22.75,0:50:25.79,DefaultSingle-J,,0,0,0,,		正直  ここまでやれるとは思てませんでした	
Dialogue: 1,0:50:26.09,0:50:28.09,DefaultSingle-J,,0,0,0,,		この辺で  ちょっと休みましょか	
Dialogue: 1,0:50:28.30,0:50:30.01,DefaultSingle-J,,0,0,0,,		まだ  まだ行けます	
Dialogue: 1,0:50:30.38,0:50:32.51,DefaultSingle-J,,0,0,0,,		休憩も立派な練習や	
Dialogue: 1,0:50:34.05,0:50:37.51,DefaultSingle-J,,0,0,0,,		私は  お粥さんでも頂いてきますさかい	
Dialogue: 1,0:50:38.43,0:50:40.23,DefaultSingle-J,,0,0,0,,		あっ  和葉ちゃん	
Dialogue: 1,0:50:43.81,0:50:45.73,DefaultSingle-J,,0,0,0,,		あっ  大丈夫	
Dialogue: 1,0:50:46.90,0:50:51.40,DefaultSingle-J,,0,0,0,,		寝かせてあげなはれ  一睡もせんと  よう頑張ったわ	
Dialogue: 1,0:50:51.57,0:50:53.53,DefaultSingle-J,,0,0,0,,		和葉ちゃん  どうなんですか	
Dialogue: 1,0:50:53.82,0:50:57.78,DefaultSingle-J,,0,0,0,,		思った以上の実力や  ベスト4は固いやろけど	
Dialogue: 1,0:50:57.95,0:51:01.16,DefaultSingle-J,,0,0,0,,		決勝まで進むんは  正直  難しいやろな	
Dialogue: 1,0:51:01.16,0:51:01.91,DefaultSingle-J,,0,0,0,,		そんな	
Dialogue: 1,0:51:02.08,0:51:04.67,DefaultSingle-J,,0,0,0,,		人の話は最後まで聞きなはれ	
Dialogue: 1,0:51:07.75,0:51:10.84,DefaultSingle-J,,0,0,0,,		難しい言うだけで  無理とは言うてません	
Dialogue: 1,0:51:11.38,0:51:15.76,DefaultSingle-J,,0,0,0,,		競技カルタで大切なんは  精神力と集中力や	
Dialogue: 1,0:51:16.47,0:51:18.01,DefaultSingle-J,,0,0,0,,		この子には  それがある	
Dialogue: 1,0:51:18.64,0:51:23.06,DefaultSingle-J,,0,0,0,,		心乱さず  無心で挑めば  この子にも勝機はあるで	
Dialogue: 1,0:51:23.98,0:51:28.15,DefaultSingle-J,,0,0,0,,		こんなの見せたら  和葉ちゃん  心乱れちゃうよね	
Dialogue: 1,0:51:31.90,0:51:35.36,DefaultSingle-J,,0,0,0,,		話はすぐに終わります  落ち着いて座ってください	
Dialogue: 1,0:51:35.49,0:51:38.66,DefaultSingle-J,,0,0,0,,		まったく  もうすぐ移動せなあかんちゅうのに	
Dialogue: 1,0:51:38.99,0:51:41.08,DefaultSingle-J,,0,0,0,,		ほんで  何の要件や	
Dialogue: 1,0:51:41.41,0:51:44.33,DefaultSingle-J,,0,0,0,,		矢島さんの殺害事件についてです	
Dialogue: 1,0:51:44.41,0:51:46.17,DefaultSingle-J,,0,0,0,,		あれは強盗の仕業やろ	
Dialogue: 1,0:51:46.58,0:51:47.50,DefaultSingle-J,,0,0,0,,		そうでしょうか	
Dialogue: 1,0:51:48.88,0:51:52.96,DefaultSingle-J,,0,0,0,,		私の推理では  あれは冷酷な計画殺人です	
Dialogue: 1,0:51:53.30,0:51:56.84,DefaultSingle-J,,0,0,0,,		アホな  確かに矢島は性格のええヤツではなかった	
Dialogue: 1,0:51:57.22,0:51:59.97,DefaultSingle-J,,0,0,0,,		そやけど  殺すほど恨んどったヤツがおったとはな	
Dialogue: 1,0:52:00.10,0:52:01.18,DefaultSingle-J,,0,0,0,,		あんたは  どうや	
Dialogue: 1,0:52:01.18,0:52:03.35,DefaultSingle-J,,0,0,0,,		アホぬかせ  なんでボクが	
Dialogue: 1,0:52:03.35,0:52:08.02,DefaultSingle-J,,0,0,0,,		関根さん  あなたは  ここ二年連続で  皐月杯優勝を逃がしている	
Dialogue: 1,0:52:08.36,0:52:10.98,DefaultSingle-J,,0,0,0,,		二度とも決勝で  矢島さんに敗れたからだ	
Dialogue: 1,0:52:11.69,0:52:14.65,DefaultSingle-J,,0,0,0,,		もし矢島さんがいなくなれば  あなたは	
Dialogue: 1,0:52:14.78,0:52:18.32,DefaultSingle-J,,0,0,0,,		やめやめ  アホらしい  そらボクかて優勝したいわ	
Dialogue: 1,0:52:18.78,0:52:22.41,DefaultSingle-J,,0,0,0,,		そやけどライバル殺すなんて  そんなん無茶苦茶やろ	
Dialogue: 1,0:52:22.70,0:52:25.75,DefaultSingle-J,,0,0,0,,		そもそも警察が強盗や言うてんのに  なんで	
Dialogue: 1,0:52:26.04,0:52:27.54,DefaultSingle-J,,0,0,0,,		理由はいくつかあります	
Dialogue: 1,0:52:28.17,0:52:31.92,DefaultSingle-J,,0,0,0,,		まず強盗にしては  荒らし方にムラがあることです	
Dialogue: 1,0:52:32.25,0:52:34.05,DefaultSingle-J,,0,0,0,,		犯人はカルタ関係のもんには	
Dialogue: 1,0:52:34.05,0:52:36.55,DefaultSingle-J,,0,0,0,,		一切  手をふれてへんかったっちゅうこっちゃ	
Dialogue: 1,0:52:37.72,0:52:40.55,DefaultSingle-J,,0,0,0,,		人  殺してもうて  慌てたんとちゃうか	
Dialogue: 1,0:52:40.93,0:52:43.14,DefaultSingle-J,,0,0,0,,		なるほど  私はてっきり	
Dialogue: 1,0:52:43.72,0:52:47.06,DefaultSingle-J,,0,0,0,,		犯人がカルタの品々に愛着を覚えていたため	
Dialogue: 1,0:52:47.27,0:52:50.11,DefaultSingle-J,,0,0,0,,		乱雑に  扱うことができなかったのかと	
Dialogue: 1,0:52:50.27,0:52:53.57,DefaultSingle-J,,0,0,0,,		探偵ちゅうのはけったいなこと考えるんやな	
Dialogue: 1,0:52:53.90,0:52:57.24,DefaultSingle-J,,0,0,0,,		まあ  どう推測しようとあんたらの勝手やけどな	
Dialogue: 1,0:52:58.66,0:53:01.74,DefaultSingle-J,,0,0,0,,		なんにせよ  ボクには関係のないこっちゃ	
Dialogue: 1,0:53:00.12,0:53:00.95,DefaultSingle-J,,0,0,0,,		やっべぇ	
Dialogue: 1,0:53:01.74,0:53:03.03,DefaultSingle-J,,0,0,0,,		そ  そういや	
Dialogue: 1,0:53:03.03,0:53:04.04,DefaultSingle-J,,0,0,0,,		ん？  なんや	
Dialogue: 1,0:53:04.37,0:53:07.29,DefaultSingle-J,,0,0,0,,		あの離れの廊下床がきしむんや	
Dialogue: 1,0:53:07.66,0:53:10.17,DefaultSingle-J,,0,0,0,,		ギシギシゆうてな覚えてるか	
Dialogue: 1,0:53:10.29,0:53:11.38,DefaultSingle-J,,0,0,0,,		それがどないしてん	
Dialogue: 1,0:53:11.96,0:53:13.04,DefaultSingle-J,,0,0,0,,		あれだけの音だ	
Dialogue: 1,0:53:13.50,0:53:16.67,DefaultSingle-J,,0,0,0,,		だれかが離れに入ってきたらすぐに気づくはずです	
Dialogue: 1,0:53:16.97,0:53:19.97,DefaultSingle-J,,0,0,0,,		しかし遺体に争った形跡はなかった	
Dialogue: 1,0:53:19.97,0:53:20.72,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 1,0:53:20.93,0:53:24.18,DefaultSingle-J,,0,0,0,,		侵入者は矢島の顔見知りやと言いたいようやが	
Dialogue: 1,0:53:24.43,0:53:25.39,DefaultSingle-J,,0,0,0,,		そらちゃうで	
Dialogue: 1,0:53:25.89,0:53:29.35,DefaultSingle-J,,0,0,0,,		練習とはいえ  カルタは相当な集中力が必要や	
Dialogue: 1,0:53:29.56,0:53:33.02,DefaultSingle-J,,0,0,0,,		一度  集中したら少々の物音がしても気づかへん	
Dialogue: 1,0:53:33.69,0:53:37.19,DefaultSingle-J,,0,0,0,,		せやから矢島は入ってきたもんに気づかず  殺されたんや	
Dialogue: 1,0:53:37.44,0:53:38.74,DefaultSingle-J,,0,0,0,,		それは  ありえません	
Dialogue: 1,0:53:39.24,0:53:42.49,DefaultSingle-J,,0,0,0,,		矢島さんの致命傷は頭のど真ん中にあった	
Dialogue: 1,0:53:43.41,0:53:47.20,DefaultSingle-J,,0,0,0,,		もし彼が侵入者に気づかず  カルタを続けていたとしたら	
Dialogue: 1,0:53:47.87,0:53:51.54,DefaultSingle-J,,0,0,0,,		傷は後頭部  もしくは側頭部にあるはずです	
Dialogue: 1,0:53:52.00,0:53:55.30,DefaultSingle-J,,0,0,0,,		つまり矢島さんと犯人は顔見知りでないと	
Dialogue: 1,0:53:55.46,0:53:57.67,DefaultSingle-J,,0,0,0,,		あんな傷はつかないってことですよ	
Dialogue: 1,0:53:58.01,0:53:59.80,DefaultSingle-J,,0,0,0,,		犯人はカルタに詳しく	
Dialogue: 1,0:54:00.09,0:54:03.85,DefaultSingle-J,,0,0,0,,		矢島さんと顔見知りで  犯行時刻にアリバイがない	
Dialogue: 1,0:54:04.22,0:54:07.60,DefaultSingle-J,,0,0,0,,		そして  彼の死によって得をする人物	
Dialogue: 1,0:54:07.93,0:54:11.73,DefaultSingle-J,,0,0,0,,		ふーむ  こら不思議やな  全部  ボクに当てはまる	
Dialogue: 1,0:54:12.48,0:54:16.19,DefaultSingle-J,,0,0,0,,		しかしな  あんたが今しゃべったんは全部  推測や	
Dialogue: 1,0:54:16.65,0:54:19.78,DefaultSingle-J,,0,0,0,,		ボクを犯人にしたいんやったら証拠を持ってこなあかん	
Dialogue: 1,0:54:21.36,0:54:23.82,DefaultSingle-J,,0,0,0,,		関根様  お時間です  お願いします	
Dialogue: 1,0:54:24.16,0:54:25.58,DefaultSingle-J,,0,0,0,,		おう  今行くで	
Dialogue: 1,0:54:25.87,0:54:29.08,DefaultSingle-J,,0,0,0,,		残念やったな  もう時間や  ほなな	
Dialogue: 1,0:54:29.29,0:54:31.83,DefaultSingle-J,,0,0,0,,		最後にもう1つだけ聞かせてください	
Dialogue: 1,0:54:32.08,0:54:34.04,DefaultSingle-J,,0,0,0,,		しつこいな  なんや	
Dialogue: 1,0:54:34.67,0:54:36.96,DefaultSingle-J,,0,0,0,,		1つ気になった会話がありましてね	
Dialogue: 1,0:54:37.21,0:54:39.05,DefaultSingle-J,,0,0,0,,		覚えてらっしゃるか分かりませんが	
Dialogue: 1,0:54:39.51,0:54:42.30,DefaultSingle-J,,0,0,0,,		伝統ある皐月杯が中止になってしもたら	
Dialogue: 1,0:54:42.43,0:54:45.93,DefaultSingle-J,,0,0,0,,		矢島はムダ死にどころやない  殴られ損や	
Dialogue: 1,0:54:46.18,0:54:48.18,DefaultSingle-J,,0,0,0,,		確か  そうおっしゃったはずです	
Dialogue: 1,0:54:48.47,0:54:52.94,DefaultSingle-J,,0,0,0,,		ふつう凶器が刀だと聞けば  斬殺か刺殺と考えるはずだ	
Dialogue: 1,0:54:53.44,0:54:56.11,DefaultSingle-J,,0,0,0,,		にもかかわらず  あなたは「殴られた」と言った	
Dialogue: 1,0:54:56.73,0:54:59.53,DefaultSingle-J,,0,0,0,,		凶器の刀が  サビついていてぬけなかったことは	
Dialogue: 1,0:54:59.69,0:55:01.44,DefaultSingle-J,,0,0,0,,		犯人しか知らないことだ	
Dialogue: 1,0:55:01.99,0:55:04.49,DefaultSingle-J,,0,0,0,,		なぜあなたは撲殺だと知っていたんですか	
Dialogue: 1,0:55:04.74,0:55:07.66,DefaultSingle-J,,0,0,0,,		そ  それは  現場で遺体を見たからや	
Dialogue: 1,0:55:08.03,0:55:08.99,DefaultSingle-J,,0,0,0,,		もうええやろ	
Dialogue: 1,0:55:08.99,0:55:12.71,DefaultSingle-J,,0,0,0,,		あなたが来る直前  遺体には覆いがかけられた	
Dialogue: 1,0:55:13.37,0:55:16.50,DefaultSingle-J,,0,0,0,,		あなたが直接遺体を見る機会はなかったんですよ	
Dialogue: 1,0:55:18.80,0:55:21.46,DefaultSingle-J,,0,0,0,,		そっ  それは  なんとなくや	
Dialogue: 1,0:55:21.76,0:55:26.22,DefaultSingle-J,,0,0,0,,		血の飛び散り具合とかで  なんとなく殴られたんやないかて思い込んだんや	
Dialogue: 1,0:55:26.39,0:55:29.26,DefaultSingle-J,,0,0,0,,		どにかく  ボクは殺しとは無関係や	
Dialogue: 1,0:55:29.56,0:55:30.97,DefaultSingle-J,,0,0,0,,		ほんま失礼なやっちゃ	
Dialogue: 1,0:55:32.18,0:55:35.35,DefaultSingle-J,,0,0,0,,		今のゆさぶりで  ヤツがどう動くか	
Dialogue: 1,0:55:35.73,0:55:37.48,DefaultSingle-J,,0,0,0,,		あと注意すべきは	
Dialogue: 1,0:55:37.86,0:55:39.52,DefaultSingle-J,,0,0,0,,		例の試合会場か	
Dialogue: 1,0:55:39.86,0:55:43.74,DefaultSingle-J,,0,0,0,,		ああ  さっき調べたんだが  厄介なことになりそうだぜ	
Dialogue: 1,0:55:44.07,0:55:46.70,DefaultSingle-J,,0,0,0,,		それにしてもえらい広さやなあ	
Dialogue: 1,0:55:46.78,0:55:49.95,DefaultSingle-J,,0,0,0,,		ん  ガケの途中にあるこの建物はなんや	
Dialogue: 1,0:55:50.16,0:55:51.33,DefaultSingle-J,,0,0,0,,		皐月堂だ	
Dialogue: 1,0:55:51.74,0:55:52.87,DefaultSingle-J,,0,0,0,,		皐月って	
Dialogue: 1,0:55:52.95,0:55:56.46,DefaultSingle-J,,0,0,0,,		そう  阿知波さんが奥さんの皐月さんを想い	
Dialogue: 1,0:55:56.46,0:55:59.75,DefaultSingle-J,,0,0,0,,		建てたことから  そう命名されたって話だ	
Dialogue: 1,0:55:59.88,0:56:00.80,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 1,0:56:01.09,0:56:04.13,DefaultSingle-J,,0,0,0,,		ここに登ることができるんは  1年に1度	
Dialogue: 1,0:56:04.38,0:56:08.43,DefaultSingle-J,,0,0,0,,		それも  読手の阿知波さんと  勝ち残った  2名だけっちゅうことか	
Dialogue: 1,0:56:09.01,0:56:13.89,DefaultSingle-J,,0,0,0,,		んで  試合の動向は  会場に設置されたカメラとマイクによって	
Dialogue: 1,0:56:14.06,0:56:17.90,DefaultSingle-J,,0,0,0,,		川をへだてた観戦専用の会場に届けられるシステムだ	
Dialogue: 1,0:56:18.10,0:56:19.77,DefaultSingle-J,,0,0,0,,		大層なこっちゃな	
Dialogue: 1,0:56:20.61,0:56:26.40,DefaultSingle-J,,0,0,0,,		競技場内は空調ジステムによって  温度湿度ともに絶えず一定に保たれ	
Dialogue: 1,0:56:26.57,0:56:31.37,DefaultSingle-J,,0,0,0,,		建物を取り囲む防音壁は  外部の音を完全にシャットアウトする	
Dialogue: 1,0:56:31.45,0:56:33.70,DefaultSingle-J,,0,0,0,,		最新システムが取り入れられているそうだ	
Dialogue: 1,0:56:33.70,0:56:38.50,DefaultSingle-J,,0,0,0,,		まさに  カルタのためだけに  造られた最高の競技会場っちゅうわけやな	
Dialogue: 1,0:56:46.13,0:56:47.22,DefaultSingle-J,,0,0,0,,		おなか  すいたな	
Dialogue: 1,0:56:47.43,0:56:48.80,DefaultSingle-J,,0,0,0,,		バイキング行こか	
Dialogue: 1,0:56:48.97,0:56:50.51,DefaultSingle-J,,0,0,0,,		ウチ  ケーキ食べたい	
Dialogue: 1,0:56:50.76,0:56:52.81,DefaultSingle-J,,0,0,0,,		じゃあ  ちょっと出てくるね	
Dialogue: 1,0:56:53.14,0:56:54.39,DefaultSingle-J,,0,0,0,,		楽しんできてな	
Dialogue: 1,0:56:54.52,0:56:55.14,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,0:56:55.52,0:56:56.68,DefaultSingle-J,,0,0,0,,		蘭お姉さん	
Dialogue: 1,0:56:56.68,0:56:58.44,DefaultSingle-J,,0,0,0,,		早く遊び行こうぜ	
Dialogue: 1,0:56:58.44,0:56:59.52,DefaultSingle-J,,0,0,0,,		じゃ  またあとで	
Dialogue: 1,0:56:59.65,0:57:00.36,DefaultSingle-J,,0,0,0,,		ほなね	
Dialogue: 1,0:57:00.36,0:57:01.61,DefaultSingle-J,,0,0,0,,		気いつけて	
Dialogue: 1,0:57:01.77,0:57:02.82,DefaultSingle-J,,0,0,0,,		お待たせ	
Dialogue: 1,0:57:02.82,0:57:04.57,DefaultSingle-J,,0,0,0,,		お土産が売り切れになっちゃいました	
Dialogue: 1,0:57:04.57,0:57:06.95,DefaultSingle-J,,0,0,0,,		おばちゃん  さっ  稽古再開や	
Dialogue: 1,0:57:07.07,0:57:08.53,DefaultSingle-J,,0,0,0,,		ちょっと待ちなはれ	
Dialogue: 1,0:57:08.91,0:57:12.70,DefaultSingle-J,,0,0,0,,		もう少し寝とかんと  本番まで体力がもちまへんで	
Dialogue: 1,0:57:12.70,0:57:13.99,DefaultSingle-J,,0,0,0,,		アタシは大丈夫です	
Dialogue: 1,0:57:13.99,0:57:15.79,DefaultSingle-J,,0,0,0,,		ま  まさか  和葉	
Dialogue: 1,0:57:16.04,0:57:19.54,DefaultSingle-J,,0,0,0,,		元クイーンの静華さんに稽古つけてもろてたんか	
Dialogue: 1,0:57:19.71,0:57:20.50,DefaultSingle-J,,0,0,0,,		そやで	
Dialogue: 1,0:57:20.50,0:57:24.05,DefaultSingle-J,,0,0,0,,		すごい  これなら  ひょっとすると  ひょっとするかも	
Dialogue: 1,0:57:24.21,0:57:27.63,DefaultSingle-J,,0,0,0,,		さあ  はよう部屋もどって  練習再開や	
Dialogue: 1,0:57:28.01,0:57:30.05,DefaultSingle-J,,0,0,0,,		そんなに  練習したいんやったら	
Dialogue: 1,0:57:30.55,0:57:32.39,DefaultSingle-J,,0,0,0,,		ウチが相手いたしましょか	
Dialogue: 1,0:57:33.05,0:57:36.47,DefaultSingle-J,,0,0,0,,		その子が決勝まで  勝ち残れるとは思えませんし	
Dialogue: 1,0:57:38.10,0:57:39.77,DefaultSingle-J,,0,0,0,,		なんやと	
Dialogue: 1,0:57:41.27,0:57:43.11,DefaultSingle-J,,0,0,0,,		和葉ちゃんは休んどき	
Dialogue: 1,0:57:43.27,0:57:44.19,DefaultSingle-J,,0,0,0,,		おばちゃん	
Dialogue: 1,0:57:44.19,0:57:45.78,DefaultSingle-J,,0,0,0,,		私がお相手します	
Dialogue: 1,0:57:46.28,0:57:47.78,DefaultSingle-J,,0,0,0,,		私では不満ですか	
Dialogue: 1,0:57:48.53,0:57:52.20,DefaultSingle-J,,0,0,0,,		元クイーンの池波静華さんが  なんでこの子のために	
Dialogue: 1,0:57:52.49,0:57:55.28,DefaultSingle-J,,0,0,0,,		それで  お手合わせしてもらえるんやろか	
Dialogue: 1,0:57:55.66,0:57:59.00,DefaultSingle-J,,0,0,0,,		そこまで  言わはるんやったら  お願いしますわ	
Dialogue: 1,0:58:04.75,0:58:06.17,DefaultSingle-J,,0,0,0,,		阿知波さんと関根は	
Dialogue: 1,0:58:06.42,0:58:10.13,DefaultSingle-J,,0,0,0,,		どうやら  このあと競技会場の阿知波会館に行って	
Dialogue: 1,0:58:10.22,0:58:12.09,DefaultSingle-J,,0,0,0,,		明日のリハーサルを行うらしい	
Dialogue: 1,0:58:12.72,0:58:16.31,DefaultSingle-J,,0,0,0,,		移動中は警察の護衛がつくさかい  心配なさそうやけど	
Dialogue: 1,0:58:16.60,0:58:19.60,DefaultSingle-J,,0,0,0,,		問題は  やっぱり阿知波会館に入ってからやな	
Dialogue: 1,0:58:19.85,0:58:20.89,DefaultSingle-J,,0,0,0,,		紅葉さんは	
Dialogue: 1,0:58:21.23,0:58:25.44,DefaultSingle-J,,0,0,0,,		安心せえ  あいつんちも京都やから  みんな  そろっての移動や	
Dialogue: 1,0:58:26.61,0:58:28.15,DefaultSingle-J,,0,0,0,,		あっ  わりぃ  電話だ	
Dialogue: 1,0:58:29.82,0:58:32.20,DefaultSingle-J,,0,0,0,,		あなたに頼まれた  例の写真の男	
Dialogue: 1,0:58:32.45,0:58:33.70,DefaultSingle-J,,0,0,0,,		身元が分かったわよ	
Dialogue: 1,0:58:33.99,0:58:35.32,DefaultSingle-J,,0,0,0,,		何  ほんとか	
Dialogue: 1,0:58:35.49,0:58:37.70,DefaultSingle-J,,0,0,0,,		ええ  ちょっと  おどろく内容よ	
Dialogue: 1,0:58:38.04,0:58:41.16,DefaultSingle-J,,0,0,0,,		詳細はメールで送ったから  あとで確認して	
Dialogue: 1,0:58:41.29,0:58:42.71,DefaultSingle-J,,0,0,0,,		サンキュー  あっ  そうだ	
Dialogue: 1,0:58:43.17,0:58:44.71,DefaultSingle-J,,0,0,0,,		カルタ札のほうはどうなってる	
Dialogue: 1,0:58:44.92,0:58:47.21,DefaultSingle-J,,0,0,0,,		さっき解析ソフトに移行したところよ	
Dialogue: 1,0:58:47.63,0:58:52.47,DefaultSingle-J,,0,0,0,,		さすが博士ね  早ければ1時間後には  にぎられていた札を探し出せそうよ	
Dialogue: 1,0:58:52.76,0:58:56.39,DefaultSingle-J,,0,0,0,,		よし  そっちのほうも解析が終わったら  すぐに知らせてくれ	
Dialogue: 1,0:58:56.60,0:58:57.18,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 1,0:58:59.81,0:59:00.64,DefaultSingle-J,,0,0,0,,		まったく	
Dialogue: 1,0:59:03.52,0:59:05.10,DefaultSingle-J,,0,0,0,,		「なごろ  しかお」	
Dialogue: 1,0:59:06.86,0:59:09.07,DefaultSingle-J,,0,0,0,,		久しぶりに  楽しませてもらいました	
Dialogue: 1,0:59:09.32,0:59:10.57,DefaultSingle-J,,0,0,0,,		ありがとうございます	
Dialogue: 1,0:59:11.07,0:59:12.49,DefaultSingle-J,,0,0,0,,		もどりましょか  伊織	
Dialogue: 1,0:59:12.65,0:59:13.24,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,0:59:13.45,0:59:16.07,DefaultSingle-J,,0,0,0,,		そやけど  すごい度胸あるんやなあ	
Dialogue: 1,0:59:16.95,0:59:20.29,DefaultSingle-J,,0,0,0,,		この程度で  おどろいてはって試合に出るやなんて	
Dialogue: 1,0:59:21.16,0:59:24.29,DefaultSingle-J,,0,0,0,,		よう覚えとき  ウチの名前は紅葉	
Dialogue: 1,0:59:24.67,0:59:27.38,DefaultSingle-J,,0,0,0,,		あんたみたいな  ただの葉っぱとちゃいますから	
Dialogue: 1,0:59:27.38,0:59:28.84,DefaultSingle-J,,0,0,0,,		ハ  ハッパ	
Dialogue: 1,0:59:28.84,0:59:30.59,DefaultSingle-J,,0,0,0,,		もうそれくらいにしときよし	
Dialogue: 1,0:59:31.09,0:59:33.55,DefaultSingle-J,,0,0,0,,		いくら相手があんたみたいな素人でも	
Dialogue: 1,0:59:33.67,0:59:35.34,DefaultSingle-J,,0,0,0,,		ウチは手えぬいたりしません	
Dialogue: 1,0:59:35.93,0:59:37.76,DefaultSingle-J,,0,0,0,,		前に素人相手に油断して	
Dialogue: 1,0:59:38.01,0:59:40.60,DefaultSingle-J,,0,0,0,,		屈辱的な負け方をしたことがありますから	
Dialogue: 1,0:59:41.18,0:59:44.06,DefaultSingle-J,,0,0,0,,		あんな  くやしい思い金輪際したない	
Dialogue: 1,0:59:44.64,0:59:47.61,DefaultSingle-J,,0,0,0,,		せやから  やる限りは全力でいかせてもらいます	
Dialogue: 1,0:59:47.77,0:59:49.65,DefaultSingle-J,,0,0,0,,		の  望むところや	
Dialogue: 1,0:59:49.77,0:59:52.65,DefaultSingle-J,,0,0,0,,		まあ  カルタの話はそれくらいにして	
Dialogue: 1,0:59:53.07,0:59:57.74,DefaultSingle-J,,0,0,0,,		あんた  こんな所にいてええの  会長も心配したはるんちゃいます	
Dialogue: 1,0:59:58.03,1:00:01.41,DefaultSingle-J,,0,0,0,,		ご心配  おおきに  そやけどウチは大丈夫です	
Dialogue: 1,1:00:01.87,1:00:06.58,DefaultSingle-J,,0,0,0,,		何しろ西の名探偵  服部平次君がついていてくれはりますから	
Dialogue: 1,1:00:06.79,1:00:08.42,DefaultSingle-J,,0,0,0,,		それ  どういうこと	
Dialogue: 1,1:00:08.63,1:00:11.13,DefaultSingle-J,,0,0,0,,		あら  なんも聞いてないんですか	
Dialogue: 1,1:00:11.42,1:00:13.88,DefaultSingle-J,,0,0,0,,		平次君はウチのボディガードなんです	
Dialogue: 1,1:00:14.09,1:00:15.22,DefaultSingle-J,,0,0,0,,		ええっ	
Dialogue: 1,1:00:15.34,1:00:19.97,DefaultSingle-J,,0,0,0,,		昨日も一睡もせんと  家の前で見張りしてくれはって	
Dialogue: 1,1:00:21.43,1:00:23.39,DefaultSingle-J,,0,0,0,,		ほな  そろそろ行かせてもらいます	
Dialogue: 1,1:00:23.68,1:00:25.98,DefaultSingle-J,,0,0,0,,		明日の試合楽しみにしてますわ	
Dialogue: 1,1:00:28.10,1:00:31.07,DefaultSingle-J,,0,0,0,,		あら  平次もスミにおけまへんなあ	
Dialogue: 1,1:00:31.48,1:00:33.40,DefaultSingle-J,,0,0,0,,		ちょっと  和葉  大丈夫	
Dialogue: 1,1:00:33.40,1:00:34.65,DefaultSingle-J,,0,0,0,,		平次	
Dialogue: 1,1:00:34.82,1:00:37.36,DefaultSingle-J,,0,0,0,,		あんたが  あの女とどないな関係か知らんけど	
Dialogue: 1,1:00:37.57,1:00:40.45,DefaultSingle-J,,0,0,0,,		カルタの試合でフルボッコにしたるさかい	
Dialogue: 1,1:00:40.62,1:00:43.04,DefaultSingle-J,,0,0,0,,		見とけや  平次	
Dialogue: 1,1:00:44.50,1:00:46.12,DefaultSingle-J,,0,0,0,,		うん  よう言うた	
Dialogue: 1,1:00:48.58,1:00:49.58,DefaultSingle-J,,0,0,0,,		どうした  服部	
Dialogue: 1,1:00:49.75,1:00:54.17,DefaultSingle-J,,0,0,0,,		いや  なんや分からへんけど  今  背筋に冷たいもんが走ったんや	
Dialogue: 1,1:00:54.38,1:00:55.63,DefaultSingle-J,,0,0,0,,		カゼでもひいたか	
Dialogue: 1,1:00:55.80,1:00:58.51,DefaultSingle-J,,0,0,0,,		カゼ  そんなかわいいもんやないわ	
Dialogue: 1,1:00:58.80,1:01:00.72,DefaultSingle-J,,0,0,0,,		もっと  まがまがしい何かや	
Dialogue: 1,1:01:03.26,1:01:04.47,DefaultSingle-J,,0,0,0,,		おい  来たぞ	
Dialogue: 1,1:01:05.52,1:01:09.81,DefaultSingle-J,,0,0,0,,		阿知波会長  大岡紅葉  そして関根	
Dialogue: 1,1:01:10.02,1:01:11.48,DefaultSingle-J,,0,0,0,,		全員おそろいやな	
Dialogue: 1,1:01:32.67,1:01:33.21,DefaultSingle-J,,0,0,0,,		まさか	
Dialogue: 1,1:01:35.13,1:01:36.21,DefaultSingle-J,,0,0,0,,		関根の車が	
Dialogue: 1,1:01:41.26,1:01:43.55,DefaultSingle-J,,0,0,0,,		で  関根さんの容体は	
Dialogue: 1,1:01:44.06,1:01:47.98,DefaultSingle-J,,0,0,0,,		病院からの連絡やとまだ意識が  もどらんようです	
Dialogue: 1,1:01:48.23,1:01:50.73,DefaultSingle-J,,0,0,0,,		助かるかどうか五分五分やそうで	
Dialogue: 1,1:01:51.10,1:01:55.32,DefaultSingle-J,,0,0,0,,		爆発に巻き込まれた大岡君は大丈夫やったんでしょうか	
Dialogue: 1,1:01:55.40,1:01:57.24,DefaultSingle-J,,0,0,0,,		ケガは  なかったみたいですが	
Dialogue: 1,1:01:57.24,1:02:02.49,DefaultSingle-J,,0,0,0,,		念のため  運転していた  伊織さんと一緒に病院で検査を受けてもろてます	
Dialogue: 1,1:02:02.91,1:02:05.08,DefaultSingle-J,,0,0,0,,		こないなことになってしもた以上	
Dialogue: 1,1:02:05.49,1:02:09.12,DefaultSingle-J,,0,0,0,,		きっちり事情を聞かしてもらいましょか  阿知波さん	
Dialogue: 1,1:02:10.08,1:02:14.88,DefaultSingle-J,,0,0,0,,		日売テレビの爆破  あれも皐月会を狙ったもんやないかと	
Dialogue: 1,1:02:14.88,1:02:16.96,DefaultSingle-J,,0,0,0,,		我々は見とるんですけどなあ	
Dialogue: 1,1:02:18.71,1:02:19.84,DefaultSingle-J,,0,0,0,,		ねえ  おじさん	
Dialogue: 1,1:02:20.63,1:02:22.72,DefaultSingle-J,,0,0,0,,		この名頃鹿雄さんってだれなの	
Dialogue: 1,1:02:22.84,1:02:25.14,DefaultSingle-J,,0,0,0,,		ぼ  ぼうや  その写真をどこで	
Dialogue: 1,1:02:25.30,1:02:28.52,DefaultSingle-J,,0,0,0,,		その動揺っぷり  心当たりがありそうや	
Dialogue: 1,1:02:28.89,1:02:30.73,DefaultSingle-J,,0,0,0,,		知ってることがあるんやったら	
Dialogue: 1,1:02:30.85,1:02:33.65,DefaultSingle-J,,0,0,0,,		洗いざらい  話してくれへんか  阿知波さん	
Dialogue: 1,1:02:35.77,1:02:39.40,DefaultSingle-J,,0,0,0,,		京都に名頃会というカルタ会があってな	
Dialogue: 1,1:02:39.69,1:02:42.03,DefaultSingle-J,,0,0,0,,		少数精鋭主義ちゅうのか	
Dialogue: 1,1:02:42.20,1:02:46.66,DefaultSingle-J,,0,0,0,,		20人足らずの会員が毎月厳しい練習をしてたようで	
Dialogue: 1,1:02:47.16,1:02:50.54,DefaultSingle-J,,0,0,0,,		名頃鹿雄君はそこのリーダーやったんや	
Dialogue: 1,1:02:51.08,1:02:54.92,DefaultSingle-J,,0,0,0,,		技量はかなりのもんで  名人への挑戦権を取るのも	
Dialogue: 1,1:02:54.92,1:02:57.42,DefaultSingle-J,,0,0,0,,		時間の問題やと言われてたんやが	
Dialogue: 1,1:02:57.67,1:03:02.38,DefaultSingle-J,,0,0,0,,		勝負への執着が強く  正直  はたで見ていても	
Dialogue: 1,1:03:02.38,1:03:04.55,DefaultSingle-J,,0,0,0,,		美しいカルタとは言えんかった	
Dialogue: 1,1:03:05.43,1:03:06.55,DefaultSingle-J,,0,0,0,,		おい  こら	
Dialogue: 1,1:03:06.76,1:03:09.93,DefaultSingle-J,,0,0,0,,		今のは俺のほうが早がったで  その札よこさんかい	
Dialogue: 1,1:03:10.39,1:03:11.93,DefaultSingle-J,,0,0,0,,		今のが  なんでお手つきやねん	
Dialogue: 1,1:03:12.06,1:03:13.77,DefaultSingle-J,,0,0,0,,		どこに目えつけとるんや	
Dialogue: 1,1:03:14.23,1:03:16.65,DefaultSingle-J,,0,0,0,,		そんな名頃君が5年前	
Dialogue: 1,1:03:16.65,1:03:20.44,DefaultSingle-J,,0,0,0,,		当時  会長やった皐月に試合を申し込んできたんや	
Dialogue: 1,1:03:20.78,1:03:23.95,DefaultSingle-J,,0,0,0,,		負けたら会をたたむことを条件にしてな	
Dialogue: 1,1:03:24.11,1:03:26.95,DefaultSingle-J,,0,0,0,,		なんや  そら  道場破りやないか	
Dialogue: 1,1:03:27.12,1:03:30.91,DefaultSingle-J,,0,0,0,,		でも皐月さんからすれば勝負を受ける必要ないよね	
Dialogue: 1,1:03:31.12,1:03:34.83,DefaultSingle-J,,0,0,0,,		名頃君は皐月が挑戦を断れんように	
Dialogue: 1,1:03:34.96,1:03:37.46,DefaultSingle-J,,0,0,0,,		マスコミに情報をもらしてたんや	
Dialogue: 1,1:03:37.79,1:03:42.05,DefaultSingle-J,,0,0,0,,		皐月会は名頃会をおそれて対戦をさけるちゅうて	
Dialogue: 1,1:03:42.13,1:03:46.72,DefaultSingle-J,,0,0,0,,		なるほど  試合を受けざるを得ない状況に追い込んだっちゅうわけか	
Dialogue: 1,1:03:46.84,1:03:49.47,DefaultSingle-J,,0,0,0,,		ほんで  勝負はどないなったんです	
Dialogue: 1,1:03:49.68,1:03:52.14,DefaultSingle-J,,0,0,0,,		試合は行われませんでした	
Dialogue: 1,1:03:52.77,1:03:56.73,DefaultSingle-J,,0,0,0,,		名頃君は試合開始時刻になっても  現れなかった	
Dialogue: 1,1:03:57.31,1:04:01.19,DefaultSingle-J,,0,0,0,,		結局  試合放棄とみなされ  皐月が勝者となり	
Dialogue: 1,1:04:01.36,1:04:05.70,DefaultSingle-J,,0,0,0,,		名頃君はマスコミを巻き込むさわぎを起こしたにもかかわらず	
Dialogue: 1,1:04:05.82,1:04:10.79,DefaultSingle-J,,0,0,0,,		試合当日に逃走したカルタ会の面汚しと言われるようになって	
Dialogue: 1,1:04:10.87,1:04:13.33,DefaultSingle-J,,0,0,0,,		表舞台から姿を消したんや	
Dialogue: 1,1:04:13.45,1:04:17.12,DefaultSingle-J,,0,0,0,,		それで今  名頃さんと名頃会はどうなってるの	
Dialogue: 1,1:04:17.54,1:04:20.54,DefaultSingle-J,,0,0,0,,		名頃会は会長不在のため解散し	
Dialogue: 1,1:04:20.63,1:04:23.46,DefaultSingle-J,,0,0,0,,		名頃本人もいまだ消息不明や	
Dialogue: 1,1:04:23.46,1:04:28.68,DefaultSingle-J,,0,0,0,,		まさか  今回の事件は  その名頃が皐月会への逆恨みから	
Dialogue: 1,1:04:28.97,1:04:34.48,DefaultSingle-J,,0,0,0,,		分かりません  ただ当時  名頃会の解散を強硬に主張してたんは	
Dialogue: 1,1:04:34.60,1:04:36.98,DefaultSingle-J,,0,0,0,,		殺された矢島君やったんです	
Dialogue: 1,1:04:37.23,1:04:38.31,DefaultSingle-J,,0,0,0,,		なんやて	
Dialogue: 1,1:04:38.44,1:04:44.28,DefaultSingle-J,,0,0,0,,		我々  皐月会としては  事を荒立てず  穏便に済ますつもりやったんですが	
Dialogue: 1,1:04:44.36,1:04:45.53,DefaultSingle-J,,0,0,0,,		それも  かなわず	
Dialogue: 1,1:04:45.82,1:04:48.41,DefaultSingle-J,,0,0,0,,		ほんで  解散した名頃会のメンバーは	
Dialogue: 1,1:04:48.57,1:04:52.49,DefaultSingle-J,,0,0,0,,		もちろん  希望すれば皐月会に入れるようにしたよ	
Dialogue: 1,1:04:52.79,1:04:55.62,DefaultSingle-J,,0,0,0,,		もっとも入会したのは2人だけやったがね	
Dialogue: 1,1:04:55.83,1:04:58.12,DefaultSingle-J,,0,0,0,,		ひょっとして  その2人っちゅうんは	
Dialogue: 1,1:04:58.42,1:05:01.29,DefaultSingle-J,,0,0,0,,		ああ  大岡君と関根君や	
Dialogue: 1,1:05:01.50,1:05:04.30,DefaultSingle-J,,0,0,0,,		さっき爆破事件に巻き込まれた2人か	
Dialogue: 1,1:05:04.59,1:05:11.30,DefaultSingle-J,,0,0,0,,		ええ  特に大岡君は名頃君のテクニックを  徹底的に教え込まれ腕を上げていき	
Dialogue: 1,1:05:11.64,1:05:14.14,DefaultSingle-J,,0,0,0,,		数ある得意札もまったく同じ	
Dialogue: 1,1:05:14.14,1:05:17.89,DefaultSingle-J,,0,0,0,,		しかも歌に紅葉の情景をうたった6枚の札は	
Dialogue: 1,1:05:17.89,1:05:19.73,DefaultSingle-J,,0,0,0,,		2人とも  逃したことがない	
Dialogue: 1,1:05:19.94,1:05:23.15,DefaultSingle-J,,0,0,0,,		まさに一番弟子といえる存在やった	
Dialogue: 1,1:05:23.69,1:05:26.82,DefaultSingle-J,,0,0,0,,		なんで名頃の得意札は歌に紅葉が  ふくまれてるんや	
Dialogue: 1,1:05:27.07,1:05:30.24,DefaultSingle-J,,0,0,0,,		名頃君の名前が「鹿雄」だからと聞いとるよ	
Dialogue: 1,1:05:30.45,1:05:31.37,DefaultSingle-J,,0,0,0,,		鹿肉	
Dialogue: 1,1:05:31.53,1:05:34.70,DefaultSingle-J,,0,0,0,,		そうや  鹿の肉をモミジというやろ	
Dialogue: 1,1:05:34.99,1:05:37.66,DefaultSingle-J,,0,0,0,,		かわいがってた彼女が皐月会に入って	
Dialogue: 1,1:05:37.66,1:05:42.04,DefaultSingle-J,,0,0,0,,		活躍してるちゅうんは名頃にしたら  おもろないやろな	
Dialogue: 1,1:05:42.21,1:05:44.59,DefaultSingle-J,,0,0,0,,		そやけど  なんで今になって	
Dialogue: 1,1:05:44.80,1:05:48.97,DefaultSingle-J,,0,0,0,,		それにわざわざ  爆破予告のメールを送ってきた理由はなんや	
Dialogue: 1,1:05:49.47,1:05:53.30,DefaultSingle-J,,0,0,0,,		5年もの間  沈黙しとった理由はまだ分からへんけど	
Dialogue: 1,1:05:53.55,1:05:58.10,DefaultSingle-J,,0,0,0,,		あの予告メールは  自分がもどってきたっちゅうころをアピールしてるんとちゃうか	
Dialogue: 1,1:05:58.64,1:06:02.31,DefaultSingle-J,,0,0,0,,		ちゅうことは  一連の事件は名頃鹿雄による	
Dialogue: 1,1:06:02.31,1:06:05.19,DefaultSingle-J,,0,0,0,,		皐月会への復讐とみて捜査すべきか	
Dialogue: 1,1:06:07.57,1:06:08.57,DefaultSingle-J,,0,0,0,,		すんません	
Dialogue: 1,1:06:09.11,1:06:10.49,DefaultSingle-J,,0,0,0,,		なんや  うん	
Dialogue: 1,1:06:10.65,1:06:14.91,DefaultSingle-J,,0,0,0,,		京都府警との合同捜査本部を立ち上げたほうがよさそうやな	
Dialogue: 1,1:06:15.24,1:06:15.91,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:06:15.91,1:06:17.33,DefaultSingle-J,,0,0,0,,		なんやて	
Dialogue: 1,1:06:17.50,1:06:20.62,DefaultSingle-J,,0,0,0,,		本部長  関根さんのスマホを調べたところ	
Dialogue: 1,1:06:20.62,1:06:23.71,DefaultSingle-J,,0,0,0,,		爆発の直前に妙なメールが入っていたようです	
Dialogue: 1,1:06:23.71,1:06:24.84,DefaultSingle-J,,0,0,0,,		妙なメール？	
Dialogue: 1,1:06:25.04,1:06:30.34,DefaultSingle-J,,0,0,0,,		差出人は不明で  ただカルタ札の添付ファイルが送られてきとったそうです	
Dialogue: 1,1:06:30.59,1:06:32.22,DefaultSingle-J,,0,0,0,,		そのカルタ札にはなんて	
Dialogue: 1,1:06:32.43,1:06:33.18,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:06:33.51,1:06:38.31,DefaultSingle-J,,0,0,0,,		「このたびは  ぬさもとりあへず  たむけやま」	
Dialogue: 1,1:06:38.31,1:06:39.93,DefaultSingle-J,,0,0,0,,		「もみじのにしき…」	
Dialogue: 1,1:06:39.93,1:06:41.39,DefaultSingle-J,,0,0,0,,		名頃君の得意札や	
Dialogue: 1,1:06:41.52,1:06:42.14,DefaultSingle-J,,0,0,0,,		何	
Dialogue: 1,1:06:43.81,1:06:45.15,DefaultSingle-J,,0,0,0,,		どないした  平ちゃん	
Dialogue: 1,1:06:45.36,1:06:48.65,DefaultSingle-J,,0,0,0,,		今すぐ確認せあかん  紅葉が危ないんや	
Dialogue: 1,1:06:51.07,1:06:51.95,DefaultSingle-J,,0,0,0,,		伊織さんか	
Dialogue: 1,1:06:52.15,1:06:53.95,DefaultSingle-J,,0,0,0,,		その声は服部様ですね	
Dialogue: 1,1:06:54.32,1:06:56.78,DefaultSingle-J,,0,0,0,,		ああ  急いで紅葉のスマホに	
Dialogue: 1,1:06:56.78,1:06:59.66,DefaultSingle-J,,0,0,0,,		差出人不明のメールが届いてへんか調べてくれ	
Dialogue: 1,1:06:59.95,1:07:01.04,DefaultSingle-J,,0,0,0,,		メールですか	
Dialogue: 1,1:07:01.58,1:07:03.04,DefaultSingle-J,,0,0,0,,		どないしたん  伊織	
Dialogue: 1,1:07:03.46,1:07:05.04,DefaultSingle-J,,0,0,0,,		服部様よりのお電話で	
Dialogue: 1,1:07:05.38,1:07:06.46,DefaultSingle-J,,0,0,0,,		平次君から	
Dialogue: 1,1:07:06.84,1:07:08.13,DefaultSingle-J,,0,0,0,,		代わりなさい  伊織	
Dialogue: 1,1:07:08.50,1:07:11.17,DefaultSingle-J,,0,0,0,,		紅葉か  すぐにメールを確認してくれ	
Dialogue: 1,1:07:11.59,1:07:13.88,DefaultSingle-J,,0,0,0,,		メールって  どしたん  急に	
Dialogue: 1,1:07:14.34,1:07:18.47,DefaultSingle-J,,0,0,0,,		そんなことより  平次君から連絡くれるなんてうれしいわあ	
Dialogue: 1,1:07:19.35,1:07:21.14,DefaultSingle-J,,0,0,0,,		あっ  なんやの  このメール	
Dialogue: 1,1:07:22.14,1:07:23.35,DefaultSingle-J,,0,0,0,,		添付ファイルだけ	
Dialogue: 1,1:07:23.35,1:07:24.56,DefaultSingle-J,,0,0,0,,		カルタ札の写真か	
Dialogue: 1,1:07:24.81,1:07:27.06,DefaultSingle-J,,0,0,0,,		すごい  なんで分かったんです	
Dialogue: 1,1:07:27.06,1:07:28.69,DefaultSingle-J,,0,0,0,,		どんな歌や  読み上げてくれ	
Dialogue: 1,1:07:28.77,1:07:29.98,DefaultSingle-J,,0,0,0,,		えっ  うん	
Dialogue: 1,1:07:30.73,1:07:33.95,DefaultSingle-J,,0,0,0,,		「嵐吹く  三室の山の  もみぢ葉は」	
Dialogue: 1,1:07:34.41,1:07:35.99,DefaultSingle-J,,0,0,0,,		紅葉  よう聞け	
Dialogue: 1,1:07:36.12,1:07:38.24,DefaultSingle-J,,0,0,0,,		今夜は絶対に  １人になったら  あかんぞ	
Dialogue: 1,1:07:38.41,1:07:42.37,DefaultSingle-J,,0,0,0,,		自宅にも帰るな  今すぐ大阪府警に来るんや  ええな	
Dialogue: 1,1:07:42.75,1:07:45.67,DefaultSingle-J,,0,0,0,,		なんぼ平次君の頼みでもそら聞けません	
Dialogue: 1,1:07:46.50,1:07:49.21,DefaultSingle-J,,0,0,0,,		明日の皐月杯に備えなあきませんから	
Dialogue: 1,1:07:49.21,1:07:52.84,DefaultSingle-J,,0,0,0,,		そんなこと言うとる場合か  お前  狙われてるかもしれへんのやぞ	
Dialogue: 1,1:07:53.22,1:07:56.80,DefaultSingle-J,,0,0,0,,		ウチは大丈夫です  平次君がいてくれるから	
Dialogue: 1,1:07:57.39,1:08:00.22,DefaultSingle-J,,0,0,0,,		守ってくれますんやろ  ウチのこと	
Dialogue: 1,1:08:00.35,1:08:01.14,DefaultSingle-J,,0,0,0,,		はぁ	
Dialogue: 1,1:08:01.52,1:08:04.18,DefaultSingle-J,,0,0,0,,		あの約束  忘れてませんから	
Dialogue: 1,1:08:04.27,1:08:05.31,DefaultSingle-J,,0,0,0,,		約束	
Dialogue: 1,1:08:05.85,1:08:06.69,DefaultSingle-J,,0,0,0,,		ほなまた	
Dialogue: 1,1:08:06.85,1:08:07.48,DefaultSingle-J,,0,0,0,,		あっ	
Dialogue: 1,1:08:08.69,1:08:10.61,DefaultSingle-J,,0,0,0,,		あのアホ  切りよった	
Dialogue: 1,1:08:10.90,1:08:13.65,DefaultSingle-J,,0,0,0,,		どうやらカルタのメールが届いとったようやな	
Dialogue: 1,1:08:13.78,1:08:14.49,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:08:14.70,1:08:18.57,DefaultSingle-J,,0,0,0,,		大滝  すぐに大岡紅葉の警護を強化するんや	
Dialogue: 1,1:08:18.70,1:08:19.33,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,1:08:21.29,1:08:23.00,DefaultSingle-J,,0,0,0,,		こうなると  矢島さんにだけ	
Dialogue: 1,1:08:23.00,1:08:25.37,DefaultSingle-J,,0,0,0,,		カルタが送られてへんかったちゅうことに	
Dialogue: 1,1:08:25.46,1:08:27.33,DefaultSingle-J,,0,0,0,,		矢島さんの殺害現場にも	
Dialogue: 1,1:08:27.50,1:08:29.88,DefaultSingle-J,,0,0,0,,		カルタ札のメッセージはちゃんとあったんじゃない	
Dialogue: 1,1:08:30.25,1:08:34.47,DefaultSingle-J,,0,0,0,,		つまりや  真犯人の名頃は矢島さんを殺害したあと	
Dialogue: 1,1:08:34.84,1:08:38.22,DefaultSingle-J,,0,0,0,,		自分の得意札を残し  現場をあとにしたけど	
Dialogue: 1,1:08:38.39,1:08:42.72,DefaultSingle-J,,0,0,0,,		あとから来た関根がその工作を  さらに偽装してしもうたっちゅうこっちゃ	
Dialogue: 1,1:08:42.89,1:08:45.77,DefaultSingle-J,,0,0,0,,		なるほど  現場に残されたメッセージで	
Dialogue: 1,1:08:45.77,1:08:50.94,DefaultSingle-J,,0,0,0,,		名頃が殺害したと確信した関根は  かつての師匠の犯行を隠すため	
Dialogue: 1,1:08:50.94,1:08:54.99,DefaultSingle-J,,0,0,0,,		家中を荒らし  強盗に見せかける偽装をしたわけやな	
Dialogue: 1,1:08:55.24,1:08:59.91,DefaultSingle-J,,0,0,0,,		警察より先に  関根君が  あの殺害現場にいた言うんですか	
Dialogue: 1,1:09:00.03,1:09:02.49,DefaultSingle-J,,0,0,0,,		ええ  その可能性は非常に高い	
Dialogue: 1,1:09:02.66,1:09:06.46,DefaultSingle-J,,0,0,0,,		実は  ある人に現場の写真を分析してもろたんや	
Dialogue: 1,1:09:06.66,1:09:10.00,DefaultSingle-J,,0,0,0,,		カルタに付着した血しぶきの向きや形状なんかから	
Dialogue: 1,1:09:09.25,1:09:10.00,DefaultSingle-J,,0,0,0,,		よし	
Dialogue: 1,1:09:10.13,1:09:13.00,DefaultSingle-J,,0,0,0,,		殺害時  どんなふうに並べられてたんかが	
Dialogue: 1,1:09:13.00,1:09:14.25,DefaultSingle-J,,0,0,0,,		割り出せてるはずや	
Dialogue: 1,1:09:14.51,1:09:15.63,DefaultSingle-J,,0,0,0,,		テレビを見て	
Dialogue: 1,1:09:16.13,1:09:21.26,DefaultSingle-J,,0,0,0,,		右側は床に置かれていたため  矢島さんの血液が付着した札	
Dialogue: 1,1:09:21.47,1:09:24.22,DefaultSingle-J,,0,0,0,,		それから左側はキレイな札と	
Dialogue: 1,1:09:24.43,1:09:28.19,DefaultSingle-J,,0,0,0,,		あとで  まぎれ込ませたことにより  血液が付着した札だよ	
Dialogue: 1,1:09:28.52,1:09:32.94,DefaultSingle-J,,0,0,0,,		そして血のつきかたがかすかな札の  ゆがみなどから判断して	
Dialogue: 1,1:09:33.19,1:09:35.40,DefaultSingle-J,,0,0,0,,		矢島さんがにぎらされていた札は	
Dialogue: 1,1:09:36.53,1:09:39.36,DefaultSingle-J,,0,0,0,,		３２番  春道列樹	
Dialogue: 1,1:09:40.07,1:09:43.70,DefaultSingle-J,,0,0,0,,		山がはに  風のかけたる  しがらみは	
Dialogue: 1,1:09:43.91,1:09:46.58,DefaultSingle-J,,0,0,0,,		流れもあへぬ  紅葉なりけり	
Dialogue: 1,1:09:46.83,1:09:50.92,DefaultSingle-J,,0,0,0,,		やっぱり矢島さんのとこにも名頃の得意札があったんや	
Dialogue: 1,1:09:51.13,1:09:54.21,DefaultSingle-J,,0,0,0,,		これを見て  今まで犯行に使われた札だよ	
Dialogue: 1,1:09:54.71,1:09:57.21,DefaultSingle-J,,0,0,0,,		左上から  日売テレビ	
Dialogue: 1,1:09:58.17,1:09:59.17,DefaultSingle-J,,0,0,0,,		矢島さん	
Dialogue: 1,1:10:00.26,1:10:01.26,DefaultSingle-J,,0,0,0,,		関根さん	
Dialogue: 1,1:10:02.14,1:10:04.43,DefaultSingle-J,,0,0,0,,		そして  さっき判明した紅葉さん	
Dialogue: 1,1:10:05.14,1:10:08.73,DefaultSingle-J,,0,0,0,,		それらの札は共通して紅葉がよみ込まれてる	
Dialogue: 1,1:10:09.02,1:10:12.52,DefaultSingle-J,,0,0,0,,		やはり  すべてが  名頃の得意札っちゅうわけか	
Dialogue: 1,1:10:12.69,1:10:17.86,DefaultSingle-J,,0,0,0,,		うむ  真犯人は名頃鹿雄とみて間違いなさそうやな	
Dialogue: 1,1:10:19.61,1:10:23.62,DefaultSingle-J,,0,0,0,,		まさかとは思うとったが  ほんまに名頃の仕業やったとは	
Dialogue: 1,1:10:23.74,1:10:28.33,DefaultSingle-J,,0,0,0,,		心配なんは  １回も逃がしたことのない紅葉の情景をうたった札が	
Dialogue: 1,1:10:28.33,1:10:30.62,DefaultSingle-J,,0,0,0,,		全部で６枚もあるっちゅうことやな	
Dialogue: 1,1:10:30.71,1:10:31.75,DefaultSingle-J,,0,0,0,,		どういうこっちゃ	
Dialogue: 1,1:10:31.92,1:10:34.00,DefaultSingle-J,,0,0,0,,		まだ２枚残ってるってことだよ	
Dialogue: 1,1:10:34.08,1:10:34.67,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,1:10:34.67,1:10:37.55,DefaultSingle-J,,0,0,0,,		もしも名頃が  自分の仕業やとアピールするために	
Dialogue: 1,1:10:37.55,1:10:39.42,DefaultSingle-J,,0,0,0,,		カルタ札を使ってるんやとしたら	
Dialogue: 1,1:10:39.59,1:10:42.80,DefaultSingle-J,,0,0,0,,		中途半端に２枚だけ残すようなことは  せえへんやろ	
Dialogue: 1,1:10:42.97,1:10:45.05,DefaultSingle-J,,0,0,0,,		まさか大岡君の他にも	
Dialogue: 1,1:10:45.14,1:10:48.18,DefaultSingle-J,,0,0,0,,		問題は残る２枚の該当するターゲットや	
Dialogue: 1,1:10:48.56,1:10:52.44,DefaultSingle-J,,0,0,0,,		はよ特定せな  名頃の犯行を防ぐんは難しいやろな	
Dialogue: 1,1:10:52.44,1:10:57.23,DefaultSingle-J,,0,0,0,,		さすがや  君たちなら警察より早く名頃を止めることができそうや	
Dialogue: 1,1:10:57.36,1:11:00.82,DefaultSingle-J,,0,0,0,,		うん  でもそのためにはもっと情報が必要なんだ	
Dialogue: 1,1:11:01.32,1:11:04.49,DefaultSingle-J,,0,0,0,,		ねえ  ５年前  名頃さんとの間で何があったの？	
Dialogue: 1,1:11:04.57,1:11:05.95,DefaultSingle-J,,0,0,0,,		そっ  それは	
Dialogue: 1,1:11:05.99,1:11:07.45,DefaultSingle-J,,0,0,0,,		あったんやろ  なんか	
Dialogue: 1,1:11:07.62,1:11:09.54,DefaultSingle-J,,0,0,0,,		なんもなかったとは言わせへんで	
Dialogue: 1,1:11:10.25,1:11:11.29,DefaultSingle-J,,0,0,0,,		せやな	
Dialogue: 1,1:11:11.37,1:11:14.46,DefaultSingle-J,,0,0,0,,		さっきは言えんかったがキミたちなら大丈夫やろ	
Dialogue: 1,1:11:14.75,1:11:17.29,DefaultSingle-J,,0,0,0,,		このあと  ホテルの私の部屋に来てくれ	
Dialogue: 1,1:11:17.59,1:11:20.96,DefaultSingle-J,,0,0,0,,		あの日  何があったのか詳しく話そうやないか	
Dialogue: 1,1:11:22.80,1:11:24.68,DefaultSingle-J,,0,0,0,,		じゃあ  みんな  ちょっと待っててね	
Dialogue: 1,1:11:24.89,1:11:26.85,DefaultSingle-J,,0,0,0,,		これ  紅葉さんに届けてくるから	
Dialogue: 1,1:11:26.93,1:11:27.51,DefaultSingle-J,,0,0,0,,		は～い	
Dialogue: 1,1:11:27.51,1:11:28.31,DefaultSingle-J,,0,0,0,,		待ってま～す	
Dialogue: 1,1:11:28.35,1:11:29.31,DefaultSingle-J,,0,0,0,,		ま～す	
Dialogue: 1,1:11:29.72,1:11:32.89,DefaultSingle-J,,0,0,0,,		お嬢様  先ほど  警察から連絡がありまして	
Dialogue: 1,1:11:33.14,1:11:35.44,DefaultSingle-J,,0,0,0,,		自宅の警護を強化したいとのことです	
Dialogue: 1,1:11:35.60,1:11:37.23,DefaultSingle-J,,0,0,0,,		ええ  かまへんよ	
Dialogue: 1,1:11:37.27,1:11:38.40,DefaultSingle-J,,0,0,0,,		すみません	
Dialogue: 1,1:11:38.73,1:11:42.15,DefaultSingle-J,,0,0,0,,		紅葉さんですよね  さっき連絡した毛利です	
Dialogue: 1,1:11:42.36,1:11:44.45,DefaultSingle-J,,0,0,0,,		ああ  あなたでしたか	
Dialogue: 1,1:11:44.61,1:11:47.87,DefaultSingle-J,,0,0,0,,		わざわざ届けに来てくださって  ほんま  ありがとうございます	
Dialogue: 1,1:11:47.91,1:11:49.62,DefaultSingle-J,,0,0,0,,		いえ  そんな	
Dialogue: 1,1:11:50.16,1:11:52.41,DefaultSingle-J,,0,0,0,,		これ  紅葉さんのですよね	
Dialogue: 1,1:11:52.50,1:11:57.13,DefaultSingle-J,,0,0,0,,		ああ  おおきに  これ  ウチのお守りみたいなもんなんです	
Dialogue: 1,1:11:57.33,1:12:00.21,DefaultSingle-J,,0,0,0,,		これなしで  明日の試合  どないしようと思ってたけど	
Dialogue: 1,1:12:00.30,1:12:02.01,DefaultSingle-J,,0,0,0,,		これで  なんとかなります	
Dialogue: 1,1:12:02.51,1:12:03.76,DefaultSingle-J,,0,0,0,,		そちらとしては	
Dialogue: 1,1:12:03.84,1:12:07.26,DefaultSingle-J,,0,0,0,,		敵に塩を送るみたいな格好になってしまいましたやろか	
Dialogue: 1,1:12:07.64,1:12:08.60,DefaultSingle-J,,0,0,0,,		いえ	
Dialogue: 1,1:12:09.14,1:12:09.93,DefaultSingle-J,,0,0,0,,		あの子	
Dialogue: 1,1:12:10.14,1:12:12.68,DefaultSingle-J,,0,0,0,,		練習しすぎて  指痛めんとええけどなあ	
Dialogue: 1,1:12:13.18,1:12:14.52,DefaultSingle-J,,0,0,0,,		キレイなネイル	
Dialogue: 1,1:12:14.64,1:12:18.06,DefaultSingle-J,,0,0,0,,		あっ  このネイルは  指先を守るためのもんです	
Dialogue: 1,1:12:18.36,1:12:22.94,DefaultSingle-J,,0,0,0,,		カルタは指先が命やから  練習以外の時は  いっつも  つけてます	
Dialogue: 1,1:12:23.15,1:12:24.49,DefaultSingle-J,,0,0,0,,		そうだったんですね	
Dialogue: 1,1:12:24.70,1:12:29.07,DefaultSingle-J,,0,0,0,,		あ  あと  連絡先  知りたくて  パスケースの中  見ちゃって	
Dialogue: 1,1:12:29.83,1:12:31.33,DefaultSingle-J,,0,0,0,,		それで写真に	
Dialogue: 1,1:12:31.37,1:12:34.45,DefaultSingle-J,,0,0,0,,		あっ  もしかして  この写真のことですか	
Dialogue: 1,1:12:35.66,1:12:37.25,DefaultSingle-J,,0,0,0,,		ここに写ってるのって	
Dialogue: 1,1:12:37.79,1:12:38.88,DefaultSingle-J,,0,0,0,,		平次君です	
Dialogue: 1,1:12:39.08,1:12:39.96,DefaultSingle-J,,0,0,0,,		やっぱり	
Dialogue: 1,1:12:40.25,1:12:45.84,DefaultSingle-J,,0,0,0,,		これは  子供の頃に出たカルタ大会で  平次君に負けてしもた時の写真ですけど	
Dialogue: 1,1:12:46.09,1:12:49.30,DefaultSingle-J,,0,0,0,,		平次君は  負けて泣いてたウチに言うたんです	
Dialogue: 1,1:12:52.26,1:12:53.43,DefaultSingle-J,,0,0,0,,		泣くなや	
Dialogue: 1,1:12:53.68,1:12:56.98,DefaultSingle-J,,0,0,0,,		今度  会うたら  嫁に取ったるさかい  待っとれや	
Dialogue: 1,1:12:57.52,1:12:59.27,DefaultSingle-J,,0,0,0,,		ほ  ほんま	
Dialogue: 1,1:12:59.81,1:13:02.52,DefaultSingle-J,,0,0,0,,		ああ  約束やで	
Dialogue: 1,1:13:02.69,1:13:03.69,DefaultSingle-J,,0,0,0,,		ええっ	
Dialogue: 1,1:13:04.03,1:13:05.78,DefaultSingle-J,,0,0,0,,		ほんとに  プロポーズだったの	
Dialogue: 1,1:13:06.11,1:13:09.03,DefaultSingle-J,,0,0,0,,		せやから  平次君は  ウチの未来の旦那さんです	
Dialogue: 1,1:13:09.28,1:13:12.03,DefaultSingle-J,,0,0,0,,		で  でも  子供のころの約束だから	
Dialogue: 1,1:13:12.16,1:13:13.87,DefaultSingle-J,,0,0,0,,		子供も大人もあらへん	
Dialogue: 1,1:13:14.12,1:13:17.58,DefaultSingle-J,,0,0,0,,		男が一度  口にしたことは  そう簡単に曲げたら  あきません	
Dialogue: 1,1:13:17.66,1:13:18.42,DefaultSingle-J,,0,0,0,,		ちゃいますか	
Dialogue: 1,1:13:19.46,1:13:23.67,DefaultSingle-J,,0,0,0,,		好きな女の心を  正確に読み取るなんてことはな	
Dialogue: 1,1:13:24.55,1:13:25.55,DefaultSingle-J,,0,0,0,,		ですよね	
Dialogue: 1,1:13:25.92,1:13:29.64,DefaultSingle-J,,0,0,0,,		「瀬をはやみ  岩にせかるる  滝川の」	
Dialogue: 1,1:13:30.26,1:13:32.51,DefaultSingle-J,,0,0,0,,		「われても末に  あわんとぞ思ふ」	
Dialogue: 1,1:13:33.35,1:13:39.48,DefaultSingle-J,,0,0,0,,		身は離れていても  心はつながってるって  信じてましたのに	
Dialogue: 1,1:13:41.23,1:13:42.98,DefaultSingle-J,,0,0,0,,		葉っぱちゃんに伝えといてください	
Dialogue: 1,1:13:43.07,1:13:44.40,DefaultSingle-J,,0,0,0,,		は  葉っぱちゃん	
Dialogue: 1,1:13:44.73,1:13:47.82,DefaultSingle-J,,0,0,0,,		ウチは狙った札は  だれにも取らせへん	
Dialogue: 1,1:13:48.40,1:13:50.03,DefaultSingle-J,,0,0,0,,		そう先生に教わってきたと	
Dialogue: 1,1:13:51.20,1:13:52.20,DefaultSingle-J,,0,0,0,,		紅葉さん	
Dialogue: 1,1:13:52.20,1:13:54.33,DefaultSingle-J,,0,0,0,,		蘭ちゃん  蘭ちゃん	
Dialogue: 1,1:13:55.49,1:13:57.04,DefaultSingle-J,,0,0,0,,		何ボーッとしてんの	
Dialogue: 1,1:13:57.25,1:14:00.42,DefaultSingle-J,,0,0,0,,		大阪見物から帰ってきたあと  蘭ちゃん  変やで	
Dialogue: 1,1:14:00.58,1:14:03.38,DefaultSingle-J,,0,0,0,,		ごめん  それより調子はどう	
Dialogue: 1,1:14:03.42,1:14:05.46,DefaultSingle-J,,0,0,0,,		えっ  それがなあ	
Dialogue: 1,1:14:05.67,1:14:07.84,DefaultSingle-J,,0,0,0,,		平次のお母さんに  試合に勝つんは	
Dialogue: 1,1:14:07.84,1:14:11.22,DefaultSingle-J,,0,0,0,,		「得意な札を選ばなあかん」て  宿題  出されてんねんけど	
Dialogue: 1,1:14:11.64,1:14:13.76,DefaultSingle-J,,0,0,0,,		これぞって札が決まらへんねん	
Dialogue: 1,1:14:14.35,1:14:16.22,DefaultSingle-J,,0,0,0,,		そんなに悩むことかなあ	
Dialogue: 1,1:14:16.22,1:14:17.10,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,1:14:17.52,1:14:20.10,DefaultSingle-J,,0,0,0,,		百人一首って  恋の歌が多いでしょ	
Dialogue: 1,1:14:20.31,1:14:25.61,DefaultSingle-J,,0,0,0,,		勝負とか  そんなこと考えないで  ピンとくる好きな歌  選べばいいと思うけどな	
Dialogue: 1,1:14:26.40,1:14:27.73,DefaultSingle-J,,0,0,0,,		恋か	
Dialogue: 1,1:14:28.61,1:14:31.36,DefaultSingle-J,,0,0,0,,		わたしなら  これかな	
Dialogue: 1,1:14:31.66,1:14:33.37,DefaultSingle-J,,0,0,0,,		「めぐりあひて」	
Dialogue: 1,1:14:33.74,1:14:35.28,DefaultSingle-J,,0,0,0,,		紫式部やな	
Dialogue: 1,1:14:35.87,1:14:39.83,DefaultSingle-J,,0,0,0,,		せっかく会えた友達が  あっちゅう間に  帰ってもうたって歌やけど	
Dialogue: 1,1:14:41.42,1:14:43.04,DefaultSingle-J,,0,0,0,,		うん  あいつ  やっと会えたと思ったら	
Dialogue: 1,1:14:43.04,1:14:44.42,DefaultSingle-J,,0,0,0,,		すぐどっか行っちゃうから	
Dialogue: 1,1:14:44.54,1:14:47.00,DefaultSingle-J,,0,0,0,,		こっちは話したいこといっぱいあるのにさ	
Dialogue: 1,1:14:47.21,1:14:49.46,DefaultSingle-J,,0,0,0,,		そやね  そんなら	
Dialogue: 1,1:14:49.97,1:14:51.51,DefaultSingle-J,,0,0,0,,		アタシは	
Dialogue: 1,1:14:53.84,1:14:58.10,DefaultSingle-J,,0,0,0,,		「しのぶれど  色に出でにけり  我が恋は」	
Dialogue: 1,1:14:58.60,1:15:01.31,DefaultSingle-J,,0,0,0,,		「ものや思ふと  人の問ふまで」	
Dialogue: 1,1:15:01.77,1:15:05.94,DefaultSingle-J,,0,0,0,,		隠しても隠しきれない恋の歌  和葉ちゃんにピッタリかも	
Dialogue: 1,1:15:06.19,1:15:08.40,DefaultSingle-J,,0,0,0,,		紅葉さんにも  バレバレだったしね	
Dialogue: 1,1:15:08.57,1:15:11.65,DefaultSingle-J,,0,0,0,,		せやかて  なんであの人  あんな自信たっぷりなんやろ	
Dialogue: 1,1:15:12.07,1:15:14.36,DefaultSingle-J,,0,0,0,,		まるで平次の婚約者気取りや	
Dialogue: 1,1:15:14.74,1:15:16.37,DefaultSingle-J,,0,0,0,,		なあ  蘭ちゃんもそう思うやろ	
Dialogue: 1,1:15:16.66,1:15:17.70,DefaultSingle-J,,0,0,0,,		そだね	
Dialogue: 1,1:15:18.29,1:15:21.08,DefaultSingle-J,,0,0,0,,		言えない  服部君が子供のころ	
Dialogue: 1,1:15:21.20,1:15:23.37,DefaultSingle-J,,0,0,0,,		紅葉さんに  プロポーズしてたなんて	
Dialogue: 1,1:15:25.50,1:15:26.50,DefaultSingle-J,,0,0,0,,		何	
Dialogue: 1,1:15:26.63,1:15:30.05,DefaultSingle-J,,0,0,0,,		名頃が試合前日に皐月さんと勝負しに来たやと	
Dialogue: 1,1:15:30.13,1:15:31.17,DefaultSingle-J,,0,0,0,,		ほんまか  それ	
Dialogue: 1,1:15:31.21,1:15:33.80,DefaultSingle-J,,0,0,0,,		ああ  私が留守してた間にな	
Dialogue: 1,1:15:34.05,1:15:39.51,DefaultSingle-J,,0,0,0,,		その記事には  名頃は  皐月との試合が怖くなって逃げたと書かれているが	
Dialogue: 1,1:15:39.64,1:15:41.85,DefaultSingle-J,,0,0,0,,		実は前日に来てたんや	
Dialogue: 1,1:15:42.10,1:15:43.77,DefaultSingle-J,,0,0,0,,		けど  なんで前の日に	
Dialogue: 1,1:15:43.81,1:15:47.36,DefaultSingle-J,,0,0,0,,		さあ  名頃に聞かんと  その訳は分からへんけど	
Dialogue: 1,1:15:47.40,1:15:51.36,DefaultSingle-J,,0,0,0,,		もしかしたら  皐月会のカルタ札を使うて倒すことが	
Dialogue: 1,1:15:51.36,1:15:54.40,DefaultSingle-J,,0,0,0,,		目的やったかもしれんと  皐月は言うとった	
Dialogue: 1,1:15:54.45,1:15:56.03,DefaultSingle-J,,0,0,0,,		あのカルタ  使たんか	
Dialogue: 1,1:15:56.41,1:16:00.95,DefaultSingle-J,,0,0,0,,		でも皐月会のカルタ札って  ふだんは博物館に保管してあるんだよね	
Dialogue: 1,1:16:01.08,1:16:04.33,DefaultSingle-J,,0,0,0,,		その当時は窃盗にあうようなこともないし	
Dialogue: 1,1:16:04.37,1:16:05.87,DefaultSingle-J,,0,0,0,,		うちで預かってたんや	
Dialogue: 1,1:16:06.00,1:16:08.96,DefaultSingle-J,,0,0,0,,		けど読手がおらんと  試合できへんのとちゃうか	
Dialogue: 1,1:16:09.09,1:16:11.96,DefaultSingle-J,,0,0,0,,		棚に  ぎょうさん  カセットテープが並んでるやろ	
Dialogue: 1,1:16:12.30,1:16:15.93,DefaultSingle-J,,0,0,0,,		一昔前は  あれ使うて  カルタの練習をしてたんや	
Dialogue: 1,1:16:16.26,1:16:18.14,DefaultSingle-J,,0,0,0,,		ほんで  試合は  どうなったんや	
Dialogue: 1,1:16:18.30,1:16:20.39,DefaultSingle-J,,0,0,0,,		結果は皐月の圧勝やった	
Dialogue: 1,1:16:21.01,1:16:23.18,DefaultSingle-J,,0,0,0,,		名頃は手も足も出なんだそや	
Dialogue: 1,1:16:23.73,1:16:27.10,DefaultSingle-J,,0,0,0,,		私がうちに帰った時  ちょうど彼が真っ青な顔で	
Dialogue: 1,1:16:27.15,1:16:30.57,DefaultSingle-J,,0,0,0,,		玄関から逃げるように去っていたのを覚えている	
Dialogue: 1,1:16:31.23,1:16:33.99,DefaultSingle-J,,0,0,0,,		彼の姿を見たんはそれが最後	
Dialogue: 1,1:16:34.32,1:16:37.24,DefaultSingle-J,,0,0,0,,		そのこと  なんで警察に言わへんかったんや	
Dialogue: 1,1:16:37.66,1:16:41.41,DefaultSingle-J,,0,0,0,,		言えばマスコミや会員たちにももれるおそれがある	
Dialogue: 1,1:16:41.83,1:16:43.58,DefaultSingle-J,,0,0,0,,		あの由緒あるカルタを	
Dialogue: 1,1:16:43.75,1:16:46.54,DefaultSingle-J,,0,0,0,,		個人的な勝負に使うたと分かれば	
Dialogue: 1,1:16:46.71,1:16:49.21,DefaultSingle-J,,0,0,0,,		会員たちの反発も起こるやろう	
Dialogue: 1,1:16:49.46,1:16:52.21,DefaultSingle-J,,0,0,0,,		まあ  その言い分も  分からんではないけど	
Dialogue: 1,1:16:52.55,1:16:55.55,DefaultSingle-J,,0,0,0,,		警察を  信用しとらんわけやないが	
Dialogue: 1,1:16:55.67,1:16:58.43,DefaultSingle-J,,0,0,0,,		どうやら  名頃さんは一番怪しそうや	
Dialogue: 1,1:16:56.51,1:16:58.43,DefaultSingle-J,,0,0,0,,		なんだ  この写真の違和感	
Dialogue: 1,1:16:58.93,1:17:03.10,DefaultSingle-J,,0,0,0,,		今頼まれるのは君らしかおらん  これ以上被害者を出ぬように	
Dialogue: 1,1:16:59.64,1:17:03.10,DefaultSingle-J,,0,0,0,,		阿知波さんの車が  今の物と違うからか	
Dialogue: 1,1:17:03.56,1:17:06.39,DefaultSingle-J,,0,0,0,,		一刻も早く  名頃の犯行を止めてくれ	
Dialogue: 1,1:17:06.60,1:17:08.31,DefaultSingle-J,,0,0,0,,		ああ  任しとき	
Dialogue: 1,1:17:10.61,1:17:12.32,DefaultSingle-J,,0,0,0,,		蘭ちゃん  ２つじゃ足りひん	
Dialogue: 1,1:17:13.02,1:17:14.53,DefaultSingle-J,,0,0,0,,		あと２つ入れてくれへん	
Dialogue: 1,1:17:15.03,1:17:17.49,DefaultSingle-J,,0,0,0,,		アタシの脳みそが  あまいもん欲しがってんねん	
Dialogue: 1,1:17:17.95,1:17:18.82,DefaultSingle-J,,0,0,0,,		あ  うん	
Dialogue: 1,1:17:19.24,1:17:20.62,DefaultSingle-J,,0,0,0,,		今の音  聞こえたの	
Dialogue: 1,1:17:21.45,1:17:22.37,DefaultSingle-J,,0,0,0,,		この子	
Dialogue: 1,1:17:23.16,1:17:25.75,DefaultSingle-J,,0,0,0,,		あかん  あかん  囲い手とか渡り手とか	
Dialogue: 1,1:17:25.75,1:17:28.67,DefaultSingle-J,,0,0,0,,		まだうまく使えへんし  試合の流れも読めへん	
Dialogue: 1,1:17:28.96,1:17:30.17,DefaultSingle-J,,0,0,0,,		このままやったら	
Dialogue: 1,1:17:30.79,1:17:33.67,DefaultSingle-J,,0,0,0,,		平次が  平次が  あの子に取られてまう	
Dialogue: 1,1:17:33.67,1:17:34.88,DefaultSingle-J,,0,0,0,,		なんや  和葉	
Dialogue: 1,1:17:35.38,1:17:36.84,DefaultSingle-J,,0,0,0,,		えらい怖い顔して	
Dialogue: 1,1:17:37.05,1:17:39.13,DefaultSingle-J,,0,0,0,,		ええっ  平次	
Dialogue: 1,1:17:39.34,1:17:40.84,DefaultSingle-J,,0,0,0,,		だれかと  ケンカしてんのか	
Dialogue: 1,1:17:40.97,1:17:42.26,DefaultSingle-J,,0,0,0,,		うるさいわ  アホ	
Dialogue: 1,1:17:42.35,1:17:44.76,DefaultSingle-J,,0,0,0,,		あんたは  あの子の  ボディガードなんやろ	
Dialogue: 1,1:17:44.89,1:17:46.27,DefaultSingle-J,,0,0,0,,		はよ向こうに帰り	
Dialogue: 1,1:17:46.35,1:17:49.81,DefaultSingle-J,,0,0,0,,		なんや  せっかくあのつかれ果てたオバハンに代わって	
Dialogue: 1,1:17:49.85,1:17:51.61,DefaultSingle-J,,0,0,0,,		お前の相手したろ思て来たのに	
Dialogue: 1,1:17:51.90,1:17:54.15,DefaultSingle-J,,0,0,0,,		オレ  カルタでお前に負けたことあらへんしな	
Dialogue: 1,1:17:54.23,1:17:58.32,DefaultSingle-J,,0,0,0,,		そら小学校のころの話や  今やったら相手にならんわ	
Dialogue: 1,1:17:58.45,1:17:59.70,DefaultSingle-J,,0,0,0,,		ねえねえ  服部君	
Dialogue: 1,1:17:59.78,1:18:02.57,DefaultSingle-J,,0,0,0,,		その小学校のころに出たカルタ大会のこと	
Dialogue: 1,1:18:02.57,1:18:04.08,DefaultSingle-J,,0,0,0,,		なんにも覚えてないの	
Dialogue: 1,1:18:04.37,1:18:07.33,DefaultSingle-J,,0,0,0,,		その大会で負かした女の子のこととか	
Dialogue: 1,1:18:07.45,1:18:11.42,DefaultSingle-J,,0,0,0,,		そうか  そうやったんや  和葉  あん時のカルタ大会や	
Dialogue: 1,1:18:11.42,1:18:14.21,DefaultSingle-J,,0,0,0,,		平次が飛び入りで出て優勝したやつか	
Dialogue: 1,1:18:14.42,1:18:18.51,DefaultSingle-J,,0,0,0,,		ああ  あん時  勝負に負けて大泣きしとった子がおったやろ	
Dialogue: 1,1:18:18.51,1:18:20.68,DefaultSingle-J,,0,0,0,,		あれが大岡紅葉やったんや	
Dialogue: 1,1:18:21.18,1:18:22.55,DefaultSingle-J,,0,0,0,,		そっか  あの子が	
Dialogue: 1,1:18:22.64,1:18:24.72,DefaultSingle-J,,0,0,0,,		で  服部君覚えてない	
Dialogue: 1,1:18:24.80,1:18:25.60,DefaultSingle-J,,0,0,0,,		何をや	
Dialogue: 1,1:18:25.64,1:18:28.60,DefaultSingle-J,,0,0,0,,		その時  紅葉さんとなんか約束したとか	
Dialogue: 1,1:18:28.73,1:18:32.02,DefaultSingle-J,,0,0,0,,		「次はがんばりや」みたいなこと言うた気はするけど	
Dialogue: 1,1:18:32.23,1:18:34.06,DefaultSingle-J,,0,0,0,,		とにかく平次は  はよ  もどって	
Dialogue: 1,1:18:34.44,1:18:36.48,DefaultSingle-J,,0,0,0,,		あの子のこと守らんとあかんのやろ	
Dialogue: 1,1:18:36.78,1:18:37.94,DefaultSingle-J,,0,0,0,,		いや  それは警察が	
Dialogue: 1,1:18:38.03,1:18:39.24,DefaultSingle-J,,0,0,0,,		いいから行き	
Dialogue: 1,1:18:39.74,1:18:41.78,DefaultSingle-J,,0,0,0,,		試合前に  ケガでもされたら	
Dialogue: 1,1:18:42.36,1:18:43.82,DefaultSingle-J,,0,0,0,,		勝負できひんし	
Dialogue: 1,1:18:45.33,1:18:47.58,DefaultSingle-J,,0,0,0,,		そうか  ほな  そうするわ	
Dialogue: 1,1:18:48.04,1:18:50.04,DefaultSingle-J,,0,0,0,,		オカン  あとは任したで	
Dialogue: 1,1:18:50.16,1:18:50.83,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,1:18:52.71,1:18:57.09,DefaultSingle-J,,0,0,0,,		「しのぶれど  色にででにけり  我が恋は」	
Dialogue: 1,1:18:57.96,1:19:01.72,DefaultSingle-J,,0,0,0,,		「ものや思ふと  人の問ふまで」	
Dialogue: 1,1:19:07.64,1:19:08.85,DefaultSingle-J,,0,0,0,,		名頃先生	
Dialogue: 1,1:19:09.89,1:19:12.44,DefaultSingle-J,,0,0,0,,		今年もウチに力を貸してください	
Dialogue: 1,1:19:19.57,1:19:23.11,DefaultSingle-J,,0,0,0,,		見守っておくれ  皐月	
Dialogue: 1,1:19:31.75,1:19:38.92,DefaultSingle-J,,0,0,0,,		「難波津に  咲くやこの花  冬ごもり」	
Dialogue: 1,1:19:41.05,1:19:48.64,DefaultSingle-J,,0,0,0,,		「今を春べと  咲くやこの花」	
Dialogue: 1,1:19:49.35,1:19:50.81,DefaultSingle-J,,0,0,0,,		わあっ	
Dialogue: 1,1:19:51.35,1:19:58.86,DefaultSingle-J,,0,0,0,,		「今を春べと  咲くやこの花」	
Dialogue: 1,1:20:01.78,1:20:08.03,DefaultSingle-J,,0,0,0,,		「み吉野の  山の秋風  小夜ふけて」	
Dialogue: 1,1:20:04.78,1:20:06.99,DefaultSingle-J,,0,0,0,,		和葉お姉さん  取った	
Dialogue: 1,1:20:06.99,1:20:10.29,DefaultSingle-J,,0,0,0,,		他の選手と違う格好ですから  すぐに分かりますね	
Dialogue: 1,1:20:10.37,1:20:11.04,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,1:20:11.08,1:20:13.50,DefaultSingle-J,,0,0,0,,		あれって  合気道の道着だよね	
Dialogue: 1,1:20:12.04,1:20:14.12,DefaultSingle-J,,0,0,0,,		コナンも見に来ればよかったのによ	
Dialogue: 1,1:20:14.21,1:20:15.71,DefaultSingle-J,,0,0,0,,		仕方ないですよ	
Dialogue: 1,1:20:15.87,1:20:18.71,DefaultSingle-J,,0,0,0,,		平次さんと行きたい所があるらしいですし	
Dialogue: 1,1:20:17.88,1:20:24.26,DefaultSingle-J,,0,0,0,,		「ふるさと寒く  衣打つなり」	
Dialogue: 1,1:20:18.96,1:20:22.13,DefaultSingle-J,,0,0,0,,		そうだ  コナン君にさっきお土産屋さんで撮った	
Dialogue: 1,1:20:22.17,1:20:24.22,DefaultSingle-J,,0,0,0,,		元太君の写真  送ってあげようよ	
Dialogue: 1,1:20:24.26,1:20:25.72,DefaultSingle-J,,0,0,0,,		あの怒られたやつ	
Dialogue: 1,1:20:26.43,1:20:32.22,DefaultSingle-J,,0,0,0,,		「いにしえの  奈良の都の  八重桜」	
Dialogue: 1,1:20:28.97,1:20:30.43,DefaultSingle-J,,0,0,0,,		始まったようやな	
Dialogue: 1,1:20:30.51,1:20:31.14,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 1,1:20:31.26,1:20:35.23,DefaultSingle-J,,0,0,0,,		まあ  これだけ警備が万全なら  名頃も入ってこられねえだろ	
Dialogue: 1,1:20:35.35,1:20:37.48,DefaultSingle-J,,0,0,0,,		ええ  名頃どころか	
Dialogue: 1,1:20:37.73,1:20:40.32,DefaultSingle-J,,0,0,0,,		あらかじめ  スタッフ登録してない者は	
Dialogue: 1,1:20:40.19,1:20:41.11,DefaultSingle-J,,0,0,0,,		どうぞ	
Dialogue: 1,1:20:40.40,1:20:42.23,DefaultSingle-J,,0,0,0,,		だれ一人として入れません	
Dialogue: 1,1:20:43.23,1:20:45.28,DefaultSingle-J,,0,0,0,,		事前の捜査も万全やしな	
Dialogue: 1,1:20:45.65,1:20:47.57,DefaultSingle-J,,0,0,0,,		名頃の好きにはさせませんよ	
Dialogue: 1,1:20:48.99,1:20:49.99,DefaultSingle-J,,0,0,0,,		どうした  服部	
Dialogue: 1,1:20:50.41,1:20:51.70,DefaultSingle-J,,0,0,0,,		いや  なんでもない	
Dialogue: 1,1:20:53.37,1:20:54.45,DefaultSingle-J,,0,0,0,,		だれだ	
Dialogue: 1,1:20:55.00,1:20:56.58,DefaultSingle-J,,0,0,0,,		なんだ  光彦からか	
Dialogue: 1,1:20:57.58,1:21:01.88,DefaultSingle-J,,0,0,0,,		ったく  何やってんだ  元太  千枚づけを  わしづかみにして	
Dialogue: 1,1:21:03.21,1:21:04.30,DefaultSingle-J,,0,0,0,,		そうか	
Dialogue: 1,1:21:07.13,1:21:10.76,DefaultSingle-J,,0,0,0,,		「契りおきし  させもが露…」	
Dialogue: 1,1:21:30.20,1:21:32.41,DefaultSingle-J,,0,0,0,,		さすが  一抜けは紅葉や	
Dialogue: 1,1:21:32.66,1:21:33.99,DefaultSingle-J,,0,0,0,,		和葉お姉さんは	
Dialogue: 1,1:21:34.04,1:21:35.50,DefaultSingle-J,,0,0,0,,		まだみたいですね	
Dialogue: 1,1:21:35.58,1:21:37.33,DefaultSingle-J,,0,0,0,,		あっ  あれじゃねえか	
Dialogue: 1,1:21:37.37,1:21:39.37,DefaultSingle-J,,0,0,0,,		ほんとだ  和葉お姉さんだ	
Dialogue: 1,1:21:39.42,1:21:40.67,DefaultSingle-J,,0,0,0,,		おっしゃ	
Dialogue: 1,1:21:40.67,1:21:42.29,DefaultSingle-J,,0,0,0,,		やった  和葉ちゃん	
Dialogue: 1,1:21:42.59,1:21:46.38,DefaultSingle-J,,0,0,0,,		一回戦突破  なかなかええ滑り出しですなあ	
Dialogue: 1,1:21:52.64,1:21:55.10,DefaultSingle-J,,0,0,0,,		あっ  関根さん  関根さん	
Dialogue: 1,1:22:40.10,1:22:41.31,DefaultSingle-J,,0,0,0,,		ありがとうございました	
Dialogue: 1,1:22:41.77,1:22:43.90,DefaultSingle-J,,0,0,0,,		まさか  あの子が決勝進出とは	
Dialogue: 1,1:22:43.94,1:22:45.52,DefaultSingle-J,,0,0,0,,		ええ  おどろきですなあ	
Dialogue: 1,1:22:45.57,1:22:47.73,DefaultSingle-J,,0,0,0,,		あんな実力者が  まだおったとは	
Dialogue: 1,1:22:49.78,1:22:51.36,DefaultSingle-J,,0,0,0,,		すげ～	
Dialogue: 1,1:22:51.57,1:22:52.70,DefaultSingle-J,,0,0,0,,		優勝できるかな	
Dialogue: 1,1:22:52.74,1:22:53.91,DefaultSingle-J,,0,0,0,,		もちろんですよ	
Dialogue: 1,1:22:54.37,1:22:57.58,DefaultSingle-J,,0,0,0,,		さすが和葉  このまま優勝も頂きや	
Dialogue: 1,1:22:57.95,1:22:59.66,DefaultSingle-J,,0,0,0,,		和葉ちゃん  分かってんのかな	
Dialogue: 1,1:22:59.87,1:23:04.00,DefaultSingle-J,,0,0,0,,		もし紅葉さんに勝てたら  服部君にコクんなきゃいけないんだよ	
Dialogue: 1,1:23:05.04,1:23:07.34,DefaultSingle-J,,0,0,0,,		がんばっとるなあ  和葉	
Dialogue: 1,1:23:07.50,1:23:09.59,DefaultSingle-J,,0,0,0,,		いよいよ  紅葉さんと対決だな	
Dialogue: 1,1:23:09.67,1:23:10.47,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:23:10.55,1:23:11.63,DefaultSingle-J,,0,0,0,,		何	
Dialogue: 1,1:23:11.97,1:23:14.18,DefaultSingle-J,,0,0,0,,		関根さんが  意識を取りもどした	
Dialogue: 1,1:23:14.22,1:23:17.51,DefaultSingle-J,,0,0,0,,		おお  ほんで  やっぱりそのとおりやったんやな	
Dialogue: 1,1:23:17.85,1:23:21.18,DefaultSingle-J,,0,0,0,,		分かった  こっちは京都府警に任せて  すぐもどる	
Dialogue: 1,1:23:21.27,1:23:22.98,DefaultSingle-J,,0,0,0,,		関根さんが目を覚ましたんですか	
Dialogue: 1,1:23:23.06,1:23:24.23,DefaultSingle-J,,0,0,0,,		ええ  どうやら	
Dialogue: 1,1:23:24.40,1:23:26.90,DefaultSingle-J,,0,0,0,,		ほぼ平ちゃんの推理どおりだったようです	
Dialogue: 1,1:23:27.07,1:23:30.07,DefaultSingle-J,,0,0,0,,		しかし  なぜ関根さんは矢島さんの所に	
Dialogue: 1,1:23:30.11,1:23:34.41,DefaultSingle-J,,0,0,0,,		ここ最近  矢島さんは名頃のことを探り回っとったらしいです	
Dialogue: 1,1:23:34.66,1:23:36.28,DefaultSingle-J,,0,0,0,,		関根さんは  それに気づき	
Dialogue: 1,1:23:36.49,1:23:39.33,DefaultSingle-J,,0,0,0,,		元師匠の消息がつかめるんやないかと	
Dialogue: 1,1:23:39.54,1:23:41.50,DefaultSingle-J,,0,0,0,,		矢島さんを見張っとったそうなんです	
Dialogue: 1,1:23:41.75,1:23:46.25,DefaultSingle-J,,0,0,0,,		それで  様子がおかしいことに気づいて  遺体を発見したと	
Dialogue: 1,1:23:46.54,1:23:47.46,DefaultSingle-J,,0,0,0,,		おそらく	
Dialogue: 1,1:23:47.67,1:23:49.46,DefaultSingle-J,,0,0,0,,		詳しいことを大阪にもどって	
Dialogue: 1,1:23:49.46,1:23:51.92,DefaultSingle-J,,0,0,0,,		直接  関根さんから聞こうと思います	
Dialogue: 1,1:23:52.13,1:23:55.13,DefaultSingle-J,,0,0,0,,		うん  こっちは京都府警に任せてください	
Dialogue: 1,1:23:55.26,1:23:55.89,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,1:23:56.01,1:23:58.56,DefaultSingle-J,,0,0,0,,		あっ  待ってください  私も一緒に	
Dialogue: 1,1:24:02.85,1:24:04.44,DefaultSingle-J,,0,0,0,,		これで終わりや	
Dialogue: 1,1:24:04.64,1:24:08.77,DefaultSingle-J,,0,0,0,,		けど  なんでこんなとこに  ダイナマイトを仕かける必要が	
Dialogue: 1,1:24:12.78,1:24:14.11,DefaultSingle-J,,0,0,0,,		なんや  あの煙  火事か	
Dialogue: 1,1:24:14.15,1:24:16.49,DefaultSingle-J,,0,0,0,,		いや  それやったら  防災システムが働くはずです	
Dialogue: 1,1:24:16.49,1:24:17.53,DefaultSingle-J,,0,0,0,,		まさか爆弾が	
Dialogue: 1,1:24:17.53,1:24:19.37,DefaultSingle-J,,0,0,0,,		おいおい  冗談やないで	
Dialogue: 1,1:24:19.58,1:24:21.08,DefaultSingle-J,,0,0,0,,		なんや  さわがしないか	
Dialogue: 1,1:24:22.29,1:24:24.04,DefaultSingle-J,,0,0,0,,		西側の森には何があるんや	
Dialogue: 1,1:24:24.12,1:24:27.33,DefaultSingle-J,,0,0,0,,		あそこには  古い物置小屋があるだけですが	
Dialogue: 1,1:24:27.42,1:24:28.96,DefaultSingle-J,,0,0,0,,		監視カメラはどうなってんのや	
Dialogue: 1,1:24:29.09,1:24:31.55,DefaultSingle-J,,0,0,0,,		あそこは施設外なんでカメラはありません	
Dialogue: 1,1:24:31.55,1:24:32.38,DefaultSingle-J,,0,0,0,,		なんやて	
Dialogue: 1,1:24:33.63,1:24:35.26,DefaultSingle-J,,0,0,0,,		おい  あの煙って  まさか	
Dialogue: 1,1:24:35.43,1:24:36.76,DefaultSingle-J,,0,0,0,,		ああ  行くで	
Dialogue: 1,1:24:41.35,1:24:44.73,DefaultSingle-J,,0,0,0,,		あれが  これから我々が向かう皐月堂や	
Dialogue: 1,1:24:47.98,1:24:49.69,DefaultSingle-J,,0,0,0,,		なんやろ  このにおい	
Dialogue: 1,1:24:49.98,1:24:53.69,DefaultSingle-J,,0,0,0,,		ああ  最近  エレベーターを点検したからね	
Dialogue: 1,1:24:53.82,1:24:57.36,DefaultSingle-J,,0,0,0,,		その時  使った潤滑油のにおいやろう  気になるか	
Dialogue: 1,1:24:57.45,1:24:59.62,DefaultSingle-J,,0,0,0,,		いえ  そういうわけやないです	
Dialogue: 1,1:24:59.74,1:25:01.20,DefaultSingle-J,,0,0,0,,		気ぃが高ぶってんのかも	
Dialogue: 1,1:25:01.37,1:25:04.70,DefaultSingle-J,,0,0,0,,		ドキドキしますなあ  あんたは  どないです	
Dialogue: 1,1:25:05.04,1:25:07.96,DefaultSingle-J,,0,0,0,,		そら  まさか  ほんまにここまで来られるなんて	
Dialogue: 1,1:25:07.96,1:25:10.29,DefaultSingle-J,,0,0,0,,		思ってへんかったから  ドッキドキやけど	
Dialogue: 1,1:25:10.42,1:25:11.67,DefaultSingle-J,,0,0,0,,		あんたは  ちゃうんやろ	
Dialogue: 1,1:25:11.88,1:25:14.59,DefaultSingle-J,,0,0,0,,		いいえ  口から心臓が飛び出そうです	
Dialogue: 1,1:25:14.88,1:25:15.59,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,1:25:16.01,1:25:17.68,DefaultSingle-J,,0,0,0,,		ウチの告白を受けて	
Dialogue: 1,1:25:18.01,1:25:21.68,DefaultSingle-J,,0,0,0,,		平次君がどないな顔をするか気になって  気になって	
Dialogue: 1,1:25:22.51,1:25:25.85,DefaultSingle-J,,0,0,0,,		負けへん  負けられへん  絶対に	
Dialogue: 1,1:25:27.81,1:25:29.52,DefaultSingle-J,,0,0,0,,		これ以上  近づいたら  あかん	
Dialogue: 1,1:25:29.98,1:25:31.19,DefaultSingle-J,,0,0,0,,		一体  何事や	
Dialogue: 1,1:25:31.40,1:25:32.11,DefaultSingle-J,,0,0,0,,		警部	
Dialogue: 1,1:25:32.69,1:25:33.69,DefaultSingle-J,,0,0,0,,		爆破されたんか	
Dialogue: 1,1:25:33.73,1:25:35.69,DefaultSingle-J,,0,0,0,,		はい  被害者は１名	
Dialogue: 1,1:25:35.86,1:25:40.45,DefaultSingle-J,,0,0,0,,		遺体は激しく損壊しており  すぐに身元を確認できる状態ではありません	
Dialogue: 1,1:25:40.62,1:25:41.82,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 1,1:25:42.12,1:25:45.66,DefaultSingle-J,,0,0,0,,		問題は  いつどうやってここに爆弾を仕かけたか	
Dialogue: 1,1:25:45.75,1:25:49.58,DefaultSingle-J,,0,0,0,,		それが状況から見て  被害者が爆弾を持ち込んだ可能性も	
Dialogue: 1,1:25:49.71,1:25:50.50,DefaultSingle-J,,0,0,0,,		何	
Dialogue: 1,1:25:50.58,1:25:52.09,DefaultSingle-J,,0,0,0,,		名頃が誤爆したいうんか	
Dialogue: 1,1:25:52.09,1:25:53.46,DefaultSingle-J,,0,0,0,,		すぐに検死を始めるんや	
Dialogue: 1,1:25:57.09,1:25:58.93,DefaultSingle-J,,0,0,0,,		はい  綾小路です	
Dialogue: 1,1:26:01.05,1:26:01.59,DefaultSingle-J,,0,0,0,,		あっ	
Dialogue: 1,1:26:01.64,1:26:02.55,DefaultSingle-J,,0,0,0,,		どないした  工藤	
Dialogue: 1,1:26:02.93,1:26:04.85,DefaultSingle-J,,0,0,0,,		服部  あれを見てくれ	
Dialogue: 1,1:26:05.22,1:26:06.27,DefaultSingle-J,,0,0,0,,		なんや  これ	
Dialogue: 1,1:26:06.47,1:26:07.23,DefaultSingle-J,,0,0,0,,		指輪か	
Dialogue: 1,1:26:07.27,1:26:08.98,DefaultSingle-J,,0,0,0,,		ああ  おそらく被害者の	
Dialogue: 1,1:26:09.35,1:26:11.31,DefaultSingle-J,,0,0,0,,		どないされました  お二人さん	
Dialogue: 1,1:26:11.65,1:26:14.19,DefaultSingle-J,,0,0,0,,		見てくれ  この指輪  遺留品かもしれへん	
Dialogue: 1,1:26:14.44,1:26:16.15,DefaultSingle-J,,0,0,0,,		えらい  ゴツい指輪ですなあ	
Dialogue: 1,1:26:16.28,1:26:18.61,DefaultSingle-J,,0,0,0,,		ああ  この大きさは  そうはないで	
Dialogue: 1,1:26:18.86,1:26:20.91,DefaultSingle-J,,0,0,0,,		大きな指輪  待てよ	
Dialogue: 1,1:26:22.95,1:26:24.66,DefaultSingle-J,,0,0,0,,		あっ  海江田藤伍	
Dialogue: 1,1:26:24.87,1:26:28.45,DefaultSingle-J,,0,0,0,,		えっ  海江田って  阿知波さんの秘書やった男か	
Dialogue: 1,1:26:28.58,1:26:33.08,DefaultSingle-J,,0,0,0,,		ああ  間違いない  この指輪  海江田さんが親指につけてた物だ	
Dialogue: 1,1:26:33.25,1:26:35.88,DefaultSingle-J,,0,0,0,,		すると  その海江田っちゅうんが真犯人	
Dialogue: 1,1:26:35.88,1:26:38.59,DefaultSingle-J,,0,0,0,,		いや  この指輪が見つからんかったら	
Dialogue: 1,1:26:38.88,1:26:42.05,DefaultSingle-J,,0,0,0,,		あそこの遺体は名頃っちゅうことになってたかもしれんのや	
Dialogue: 1,1:26:42.34,1:26:46.89,DefaultSingle-J,,0,0,0,,		つまり  この爆発は  名頃さんが死んだように見せかけるための偽装	
Dialogue: 1,1:26:47.64,1:26:51.48,DefaultSingle-J,,0,0,0,,		待てよ  今の時点で  名頃が死んだことにするっちゅうことは	
Dialogue: 1,1:26:51.64,1:26:53.90,DefaultSingle-J,,0,0,0,,		残っとった例の２枚のカルタ札は	
Dialogue: 1,1:26:54.06,1:26:56.32,DefaultSingle-J,,0,0,0,,		もう  だれかに  送られてるんとちゃうか	
Dialogue: 1,1:26:56.52,1:26:57.61,DefaultSingle-J,,0,0,0,,		２枚やない	
Dialogue: 1,1:26:57.94,1:27:00.45,DefaultSingle-J,,0,0,0,,		今  大滝さんから電話がありましてな	
Dialogue: 1,1:27:00.70,1:27:04.99,DefaultSingle-J,,0,0,0,,		改めて  阿知波会長のメール履歴を秘書に調べてもらったところ	
Dialogue: 1,1:27:05.28,1:27:07.95,DefaultSingle-J,,0,0,0,,		今朝  カルタ札のメールが届いとったそうです	
Dialogue: 1,1:27:08.24,1:27:10.58,DefaultSingle-J,,0,0,0,,		ちゅうことは残る札は１枚か	
Dialogue: 1,1:27:11.21,1:27:15.92,DefaultSingle-J,,0,0,0,,		あとは決勝戦を残すのみですよ	
Dialogue: 1,1:27:11.21,1:27:14.92,DefaultSingle-J,,0,0,0,,		残りは１枚  決勝戦のみ	
Dialogue: 1,1:27:16.09,1:27:16.92,DefaultSingle-J,,0,0,0,,		そうか	
Dialogue: 1,1:27:17.63,1:27:22.13,DefaultSingle-J,,0,0,0,,		すでに阿知波さんにカルタ札が届いてたってことは  残るは１枚	
Dialogue: 1,1:27:22.51,1:27:26.68,DefaultSingle-J,,0,0,0,,		そして  その１枚を送る相手はまだ決まっていなかったんだ	
Dialogue: 1,1:27:27.10,1:27:30.89,DefaultSingle-J,,0,0,0,,		まさか  警部  すぐに遠山和葉のスマホを調べてくれ	
Dialogue: 1,1:27:31.10,1:27:32.27,DefaultSingle-J,,0,0,0,,		えっ  ええ	
Dialogue: 1,1:27:32.35,1:27:33.81,DefaultSingle-J,,0,0,0,,		しかし  どういうことです	
Dialogue: 1,1:27:34.19,1:27:36.81,DefaultSingle-J,,0,0,0,,		なんで最後の１枚が残されていたんか	
Dialogue: 1,1:27:37.32,1:27:40.90,DefaultSingle-J,,0,0,0,,		それは  決勝戦にだれが進むか  分からんかったからや	
Dialogue: 1,1:27:41.90,1:27:43.95,DefaultSingle-J,,0,0,0,,		ということは  ターゲットは	
Dialogue: 1,1:27:44.61,1:27:46.45,DefaultSingle-J,,0,0,0,,		皐月堂に集まってる３人	
Dialogue: 1,1:27:47.37,1:27:49.12,DefaultSingle-J,,0,0,0,,		２人とも  すまないね	
Dialogue: 1,1:27:49.37,1:27:50.08,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,1:27:50.62,1:27:55.08,DefaultSingle-J,,0,0,0,,		両者  最大限の力を発揮し  すばらしい試合を見せてくれ	
Dialogue: 1,1:27:55.96,1:27:57.79,DefaultSingle-J,,0,0,0,,		よろしくお願いします	
Dialogue: 1,1:27:59.00,1:28:06.22,DefaultSingle-J,,0,0,0,,		「難波津に  咲くやこの花  冬ごもり」	
Dialogue: 1,1:28:01.09,1:28:04.34,DefaultSingle-J,,0,0,0,,		せ～の  がんばれ	
Dialogue: 1,1:28:04.34,1:28:07.14,DefaultSingle-J,,0,0,0,,		和葉ちゃん  あんたの実力  見せたり	
Dialogue: 1,1:28:11.22,1:28:12.02,DefaultSingle-J,,0,0,0,,		どうやった	
Dialogue: 1,1:28:12.60,1:28:14.02,DefaultSingle-J,,0,0,0,,		カルタ札のメールは	
Dialogue: 1,1:28:14.10,1:28:17.65,DefaultSingle-J,,0,0,0,,		はい  １５分ほど前に名頃の得意札が	
Dialogue: 1,1:28:18.56,1:28:19.94,DefaultSingle-J,,0,0,0,,		やはり届いてたか	
Dialogue: 1,1:28:20.53,1:28:23.19,DefaultSingle-J,,0,0,0,,		すぐに決勝戦を中止させるんや  ええな	
Dialogue: 1,1:28:23.40,1:28:24.32,DefaultSingle-J,,0,0,0,,		こっちや  工藤	
Dialogue: 1,1:28:24.32,1:28:25.40,DefaultSingle-J,,0,0,0,,		おい  どこに	
Dialogue: 1,1:28:25.61,1:28:26.91,DefaultSingle-J,,0,0,0,,		バイクのほうが速い	
Dialogue: 1,1:28:27.24,1:28:29.78,DefaultSingle-J,,0,0,0,,		えっ  決勝戦を中止させる	
Dialogue: 1,1:28:30.03,1:28:31.33,DefaultSingle-J,,0,0,0,,		はい  分かりました	
Dialogue: 1,1:28:31.74,1:28:33.29,DefaultSingle-J,,0,0,0,,		すぐに会場に連絡し	
Dialogue: 1,1:28:38.92,1:28:39.50,DefaultSingle-J,,0,0,0,,		あ	
Dialogue: 1,1:28:39.50,1:28:40.50,DefaultSingle-J,,0,0,0,,		何	
Dialogue: 1,1:28:41.34,1:28:44.72,DefaultSingle-J,,0,0,0,,		地震でしょう  これくらいなら心配いりません	
Dialogue: 1,1:28:47.93,1:28:49.72,DefaultSingle-J,,0,0,0,,		あれ  どうしちゃったんでしょう	
Dialogue: 1,1:28:49.80,1:28:51.31,DefaultSingle-J,,0,0,0,,		こわれちゃったのかな	
Dialogue: 1,1:28:51.39,1:28:54.35,DefaultSingle-J,,0,0,0,,		なんだよ  せっかくいいところだったのによ	
Dialogue: 1,1:28:52.68,1:28:53.39,DefaultSingle-J,,0,0,0,,		停電	
Dialogue: 1,1:28:53.43,1:28:55.23,DefaultSingle-J,,0,0,0,,		いや  照明はついとる	
Dialogue: 1,1:28:55.77,1:28:57.52,DefaultSingle-J,,0,0,0,,		やべえ  始まったぞ	
Dialogue: 1,1:28:57.52,1:28:59.86,DefaultSingle-J,,0,0,0,,		ああ  しっかり  つかまっとれよ	
Dialogue: 1,1:29:05.24,1:29:06.57,DefaultSingle-J,,0,0,0,,		どうやって皐月堂まで	
Dialogue: 1,1:29:06.57,1:29:08.32,DefaultSingle-J,,0,0,0,,		任しとき  考えがある	
Dialogue: 1,1:29:08.53,1:29:09.57,DefaultSingle-J,,0,0,0,,		おい  まさか	
Dialogue: 1,1:29:12.87,1:29:19.50,DefaultSingle-J,,0,0,0,,		「ちはやぶる  神代も聞かず  竜田川」	
Dialogue: 1,1:29:14.87,1:29:17.87,DefaultSingle-J,,0,0,0,,		やっぱりや  葉っぱちゃん  動きもせんかった	
Dialogue: 1,1:29:18.37,1:29:20.88,DefaultSingle-J,,0,0,0,,		ウチの得意札は捨ててきてるゆうことなんか	
Dialogue: 1,1:29:22.25,1:29:23.34,DefaultSingle-J,,0,0,0,,		「わびぬれば」	
Dialogue: 1,1:29:26.05,1:29:28.68,DefaultSingle-J,,0,0,0,,		なんや  なんで  あんなに勢いよく燃えてんのや	
Dialogue: 1,1:29:28.84,1:29:31.47,DefaultSingle-J,,0,0,0,,		なんかの燃料に引火したんやと思われます	
Dialogue: 1,1:29:31.55,1:29:33.31,DefaultSingle-J,,0,0,0,,		消防はまだ来ぃひんのか	
Dialogue: 1,1:29:33.51,1:29:36.98,DefaultSingle-J,,0,0,0,,		園内は道が狭うて  消防車が入ってこられへんとのことで	
Dialogue: 1,1:29:37.48,1:29:40.23,DefaultSingle-J,,0,0,0,,		確か防災設備もダウンしてるんやったな	
Dialogue: 1,1:29:40.48,1:29:41.23,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,1:29:41.40,1:29:42.98,DefaultSingle-J,,0,0,0,,		万事休すか	
Dialogue: 1,1:30:09.09,1:30:11.93,DefaultSingle-J,,0,0,0,,		服部  まだ名頃さんが犯人だと思うか	
Dialogue: 1,1:30:12.09,1:30:16.81,DefaultSingle-J,,0,0,0,,		いや  すでに皐月会を去っていた海江田をスタッフとして再登録して	
Dialogue: 1,1:30:16.85,1:30:19.98,DefaultSingle-J,,0,0,0,,		爆弾をわたせるのは  あの男しか  おれへんやろ	
Dialogue: 1,1:30:20.81,1:30:22.56,DefaultSingle-J,,0,0,0,,		阿知波研介会長	
Dialogue: 1,1:30:23.19,1:30:26.15,DefaultSingle-J,,0,0,0,,		このまま２人を道連れに自らも死ぬ気なんじゃ	
Dialogue: 1,1:30:26.40,1:30:29.61,DefaultSingle-J,,0,0,0,,		そんなこと絶対させるか	
Dialogue: 1,1:30:30.24,1:30:34.28,DefaultSingle-J,,0,0,0,,		一番取りにくい所にある  紅葉さんも分かってるんや	
Dialogue: 1,1:30:34.58,1:30:37.12,DefaultSingle-J,,0,0,0,,		あれが  アタシの得意札やっていうことを	
Dialogue: 1,1:30:38.20,1:30:40.04,DefaultSingle-J,,0,0,0,,		この札が取りたいんやろ	
Dialogue: 1,1:30:40.54,1:30:41.96,DefaultSingle-J,,0,0,0,,		そやけど  わたさへんで	
Dialogue: 1,1:30:42.29,1:30:44.21,DefaultSingle-J,,0,0,0,,		これを守り切ったら  ウチの勝ちや	
Dialogue: 1,1:30:45.09,1:30:47.05,DefaultSingle-J,,0,0,0,,		取る  絶対取る	
Dialogue: 1,1:30:47.25,1:30:48.42,DefaultSingle-J,,0,0,0,,		取らな  あかんのに	
Dialogue: 1,1:30:52.43,1:30:54.60,DefaultSingle-J,,0,0,0,,		うるさい  うるさい  うるさい	
Dialogue: 1,1:30:54.76,1:30:57.52,DefaultSingle-J,,0,0,0,,		余計な音は  アタシの耳から出てって	
Dialogue: 1,1:30:57.68,1:31:02.19,DefaultSingle-J,,0,0,0,,		なんや  和葉  えらい怖い顔して  だれかとケンカしてんのか	
Dialogue: 1,1:31:03.85,1:31:05.06,DefaultSingle-J,,0,0,0,,		失礼します	
Dialogue: 1,1:31:05.19,1:31:05.82,DefaultSingle-J,,0,0,0,,		うむ	
Dialogue: 1,1:31:08.11,1:31:11.57,DefaultSingle-J,,0,0,0,,		そうや  ケンカしたらあかん  あかんねん	
Dialogue: 1,1:31:12.15,1:31:15.16,DefaultSingle-J,,0,0,0,,		エアコンの音  着物のすれる音	
Dialogue: 1,1:31:15.41,1:31:18.24,DefaultSingle-J,,0,0,0,,		札にさわる音  かすかな息づかい	
Dialogue: 1,1:31:18.49,1:31:20.75,DefaultSingle-J,,0,0,0,,		そして胸の鼓動	
Dialogue: 1,1:31:21.33,1:31:22.58,DefaultSingle-J,,0,0,0,,		みんな仲間や	
Dialogue: 1,1:31:23.04,1:31:25.50,DefaultSingle-J,,0,0,0,,		アタシの中に入ってきてええんよ	
Dialogue: 1,1:31:29.71,1:31:30.88,DefaultSingle-J,,0,0,0,,		失礼しました	
Dialogue: 1,1:31:31.84,1:31:33.55,DefaultSingle-J,,0,0,0,,		ほんまの音  つかまえたる	
Dialogue: 1,1:31:35.34,1:31:42.39,DefaultSingle-J,,0,0,0,,		「まつとしきかば  いまかへりこむ」	
Dialogue: 1,1:31:44.02,1:31:44.90,DefaultSingle-J,,0,0,0,,		「し…」	
Dialogue: 1,1:31:54.66,1:32:00.16,DefaultSingle-J,,0,0,0,,		一連の事件はすべて  名頃さんによる  皐月会への復讐だと思わせるのが	
Dialogue: 1,1:32:00.24,1:32:02.33,DefaultSingle-J,,0,0,0,,		阿知波さんのえがいたシナリオだ	
Dialogue: 1,1:32:02.83,1:32:06.67,DefaultSingle-J,,0,0,0,,		５年前  皐月さんと試合を行う予定やった名頃さんは	
Dialogue: 1,1:32:06.79,1:32:10.17,DefaultSingle-J,,0,0,0,,		なぜか  その前の晩現れ  前哨戦が行われた	
Dialogue: 1,1:32:10.50,1:32:12.55,DefaultSingle-J,,0,0,0,,		結果  皐月さんが勝利したと	
Dialogue: 1,1:32:12.55,1:32:15.59,DefaultSingle-J,,0,0,0,,		阿知波さんは言ってたけど  それには妙な点がある	
Dialogue: 1,1:32:16.01,1:32:18.01,DefaultSingle-J,,0,0,0,,		ホテルで見た記事の写真やろ	
Dialogue: 1,1:32:18.55,1:32:20.97,DefaultSingle-J,,0,0,0,,		ああ  阿知波さんの紹介記事に	
Dialogue: 1,1:32:21.06,1:32:24.44,DefaultSingle-J,,0,0,0,,		皐月さんの試合前日にはいつも車をピカピカに	
Dialogue: 1,1:32:24.44,1:32:27.69,DefaultSingle-J,,0,0,0,,		磨くって書いてあったのに  あの写真では  よごれてた	
Dialogue: 1,1:32:28.11,1:32:30.78,DefaultSingle-J,,0,0,0,,		大切な試合の前日に  洗車しなかったのは	
Dialogue: 1,1:32:30.94,1:32:33.07,DefaultSingle-J,,0,0,0,,		名頃さんが来ないことを分かっていたからだ	
Dialogue: 1,1:32:33.28,1:32:38.41,DefaultSingle-J,,0,0,0,,		「有り明けの  つれなく見えし  別れより」	
Dialogue: 1,1:32:36.70,1:32:39.33,DefaultSingle-J,,0,0,0,,		ウチのほうが早い気ぃがしましたけどな	
Dialogue: 1,1:32:39.58,1:32:41.95,DefaultSingle-J,,0,0,0,,		いや  早かったんは  アタシのほうや	
Dialogue: 1,1:32:42.70,1:32:45.71,DefaultSingle-J,,0,0,0,,		どっちが早かったか  一番よう分かってんのは	
Dialogue: 1,1:32:45.96,1:32:47.04,DefaultSingle-J,,0,0,0,,		自分ちゃうの	
Dialogue: 1,1:32:49.50,1:32:52.71,DefaultSingle-J,,0,0,0,,		まさか  運命戦にまで  もつれ込むとは	
Dialogue: 1,1:32:56.13,1:33:00.10,DefaultSingle-J,,0,0,0,,		５年前  行われた前哨戦  もし皐月さんが負けていたとしたら	
Dialogue: 1,1:33:00.22,1:33:02.10,DefaultSingle-J,,0,0,0,,		それは動機になるんと違うか	
Dialogue: 1,1:33:02.18,1:33:06.60,DefaultSingle-J,,0,0,0,,		ああ  皐月会の名誉を守るため  名頃さんの口をふうじたんだ	
Dialogue: 1,1:33:06.94,1:33:10.11,DefaultSingle-J,,0,0,0,,		そして  その証拠の残ったカルタの映像を見て	
Dialogue: 1,1:33:10.23,1:33:12.02,DefaultSingle-J,,0,0,0,,		矢島さんは気づいてしまったんだ	
Dialogue: 1,1:33:12.11,1:33:13.57,DefaultSingle-J,,0,0,0,,		阿知波さんの犯行を	
Dialogue: 1,1:33:13.94,1:33:16.45,DefaultSingle-J,,0,0,0,,		しかし  あのカルタにはどんな証拠が	
Dialogue: 1,1:33:16.74,1:33:21.24,DefaultSingle-J,,0,0,0,,		名頃さんの血がついたカルタの束をうっかり  わしづかみにしていたとしたら	
Dialogue: 1,1:33:21.41,1:33:22.87,DefaultSingle-J,,0,0,0,,		そうか  指紋か	
Dialogue: 1,1:33:22.95,1:33:25.58,DefaultSingle-J,,0,0,0,,		オレも  ある写真を見るまで気づかなかったが	
Dialogue: 1,1:33:26.16,1:33:29.50,DefaultSingle-J,,0,0,0,,		おそらく  あのカルタには  阿知波さんの指紋が残っている	
Dialogue: 1,1:33:29.79,1:33:34.46,DefaultSingle-J,,0,0,0,,		そやから矢島さんは  皐月会特集の企画をテレビ局に持ち込んで	
Dialogue: 1,1:33:34.63,1:33:38.55,DefaultSingle-J,,0,0,0,,		証拠となる皐月会のカルタを映像として記録させたんやな	
Dialogue: 1,1:33:38.97,1:33:43.89,DefaultSingle-J,,0,0,0,,		ああ  だからテレビ局爆破と矢島さん殺害が同時に行われたんだ	
Dialogue: 1,1:33:44.01,1:33:46.43,DefaultSingle-J,,0,0,0,,		せやな  せやけど  なんでや	
Dialogue: 1,1:33:46.98,1:33:51.56,DefaultSingle-J,,0,0,0,,		この阿知波会館で  それも決勝戦まで  犯行を引っ張る理由がどこにあんのや	
Dialogue: 1,1:33:51.77,1:33:56.19,DefaultSingle-J,,0,0,0,,		決勝戦の行われている皐月堂に  名頃さんの遺体があるとしたら	
Dialogue: 1,1:33:56.36,1:33:59.11,DefaultSingle-J,,0,0,0,,		確かに  絶好の隠し場所やな	
Dialogue: 1,1:33:59.57,1:34:02.83,DefaultSingle-J,,0,0,0,,		初めから  すべて計画されてた犯行っちゅうわけか	
Dialogue: 1,1:34:03.20,1:34:07.04,DefaultSingle-J,,0,0,0,,		完璧な計画で  名頃さんを犯人に仕立て上げたとしても	
Dialogue: 1,1:34:07.41,1:34:10.79,DefaultSingle-J,,0,0,0,,		後々  遺体が発見されたら  元も子もねえからな	
Dialogue: 1,1:34:11.33,1:34:13.25,DefaultSingle-J,,0,0,0,,		あっ  見えたぞ	
Dialogue: 1,1:34:13.25,1:34:14.00,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:34:14.00,1:34:20.43,DefaultSingle-J,,0,0,0,,		「…らぬ  恋の道かな」	
Dialogue: 1,1:34:21.09,1:34:23.05,DefaultSingle-J,,0,0,0,,		「人はいさ…」	
Dialogue: 1,1:34:22.26,1:34:23.05,DefaultSingle-J,,0,0,0,,		空札	
Dialogue: 1,1:34:23.18,1:34:25.22,DefaultSingle-J,,0,0,0,,		まずい  炎があんなとこまで	
Dialogue: 1,1:34:25.26,1:34:26.43,DefaultSingle-J,,0,0,0,,		急いで下りんと	
Dialogue: 1,1:34:26.64,1:34:27.60,DefaultSingle-J,,0,0,0,,		だけど  どうする	
Dialogue: 1,1:34:27.85,1:34:29.23,DefaultSingle-J,,0,0,0,,		それに  あれを消さねーと	
Dialogue: 1,1:34:29.77,1:34:34.02,DefaultSingle-J,,0,0,0,,		迷ってる時間はない  お前は火を消す方法だけを考えといてくれ	
Dialogue: 1,1:34:34.23,1:34:36.28,DefaultSingle-J,,0,0,0,,		お前  まさか  ウソだろ	
Dialogue: 1,1:34:36.40,1:34:38.36,DefaultSingle-J,,0,0,0,,		いくで  工藤	
Dialogue: 1,1:34:51.75,1:34:52.75,DefaultSingle-J,,0,0,0,,		いけー	
Dialogue: 1,1:34:55.50,1:34:56.25,DefaultSingle-J,,0,0,0,,		なんやの	
Dialogue: 1,1:35:02.18,1:35:04.01,DefaultSingle-J,,0,0,0,,		よし  ふくらめ	
Dialogue: 1,1:35:06.85,1:35:08.64,DefaultSingle-J,,0,0,0,,		急げ  間に合ってくれ	
Dialogue: 1,1:35:09.64,1:35:10.77,DefaultSingle-J,,0,0,0,,		なんや  火事？	
Dialogue: 1,1:35:09.98,1:35:10.77,DefaultSingle-J,,0,0,0,,		なんや	
Dialogue: 1,1:35:10.94,1:35:12.48,DefaultSingle-J,,0,0,0,,		来んな  中に入っとれ	
Dialogue: 1,1:35:12.65,1:35:14.77,DefaultSingle-J,,0,0,0,,		平次  なんでここにおんの	
Dialogue: 1,1:35:12.65,1:35:13.56,DefaultSingle-J,,0,0,0,,		平次君	
Dialogue: 1,1:35:17.86,1:35:19.74,DefaultSingle-J,,0,0,0,,		おい  滝の流れが変わったぞ	
Dialogue: 1,1:35:20.11,1:35:21.24,DefaultSingle-J,,0,0,0,,		火が消えていくぞ	
Dialogue: 1,1:35:21.24,1:35:23.32,DefaultSingle-J,,0,0,0,,		なんや  なにが起こってるんや	
Dialogue: 1,1:35:27.58,1:35:29.20,DefaultSingle-J,,0,0,0,,		なんとか間に合ったみたいだな	
Dialogue: 1,1:35:29.29,1:35:31.16,DefaultSingle-J,,0,0,0,,		さすがやな  工藤	
Dialogue: 1,1:35:32.00,1:35:34.33,DefaultSingle-J,,0,0,0,,		平次君  何が起こってるんです	
Dialogue: 1,1:35:34.38,1:35:36.59,DefaultSingle-J,,0,0,0,,		危ないから中に入っとれて言うたやろ	
Dialogue: 1,1:35:36.63,1:35:38.30,DefaultSingle-J,,0,0,0,,		えっ  コナン君まで	
Dialogue: 1,1:35:38.38,1:35:40.80,DefaultSingle-J,,0,0,0,,		一体何なん  二人して  どうしたん	
Dialogue: 1,1:35:40.84,1:35:44.22,DefaultSingle-J,,0,0,0,,		それは阿知波さんに聞いたほうが早いんとちゃうか	
Dialogue: 1,1:35:44.51,1:35:45.76,DefaultSingle-J,,0,0,0,,		どういうことです	
Dialogue: 1,1:35:46.05,1:35:48.18,DefaultSingle-J,,0,0,0,,		二人とも  オレの後ろに下がっとき	
Dialogue: 1,1:35:48.18,1:35:50.56,DefaultSingle-J,,0,0,0,,		えっ  なんで下がる必要あんの	
Dialogue: 1,1:35:50.98,1:35:52.10,DefaultSingle-J,,0,0,0,,		ねえ  阿知波さん	
Dialogue: 1,1:35:52.31,1:35:55.06,DefaultSingle-J,,0,0,0,,		このカルタ札  調べられたらまずいんじゃないの	
Dialogue: 1,1:35:55.27,1:35:58.61,DefaultSingle-J,,0,0,0,,		なあ  平次  あんたさっきから何言うてんの	
Dialogue: 1,1:35:59.11,1:36:03.11,DefaultSingle-J,,0,0,0,,		今回の事件の答え合わせを  このオッサンとしようと思うてな	
Dialogue: 1,1:36:03.20,1:36:09.49,DefaultSingle-J,,0,0,0,,		事件の発端はちょうど１年前  この場所で  紅葉が優勝した時なんや	
Dialogue: 1,1:36:09.83,1:36:12.71,DefaultSingle-J,,0,0,0,,		そん時  紅葉の取った札の重ねが	
Dialogue: 1,1:36:12.79,1:36:17.54,DefaultSingle-J,,0,0,0,,		師匠の名頃さんが取ったある試合の札の重なり方とよう似とった	
Dialogue: 1,1:36:18.00,1:36:22.63,DefaultSingle-J,,0,0,0,,		確かにウチは名頃先生に教わった攻めガルタで  得意札も一緒や	
Dialogue: 1,1:36:22.84,1:36:26.14,DefaultSingle-J,,0,0,0,,		せやけど  よっぽどの偶然がない限り  そんなこと	
Dialogue: 1,1:36:26.18,1:36:28.47,DefaultSingle-J,,0,0,0,,		ところが  その偶然が起きちゃったんだよ	
Dialogue: 1,1:36:29.01,1:36:32.06,DefaultSingle-J,,0,0,0,,		この皐月会のカルタの側面についた黒ずみ	
Dialogue: 1,1:36:32.52,1:36:37.77,DefaultSingle-J,,0,0,0,,		殺害された矢島さんは  このシミが５年前突然現れたことに気づいたんだ	
Dialogue: 1,1:36:38.11,1:36:40.32,DefaultSingle-J,,0,0,0,,		その黒ずみは一体何なんです	
Dialogue: 1,1:36:40.61,1:36:44.95,DefaultSingle-J,,0,0,0,,		名頃さんの返り血がついた手でカルタをつかんだ人物の指紋や	
Dialogue: 1,1:36:45.28,1:36:47.36,DefaultSingle-J,,0,0,0,,		名頃先生の返り血で	
Dialogue: 1,1:36:47.49,1:36:52.33,DefaultSingle-J,,0,0,0,,		５年前に失踪したと思われてた名頃さんは  その時殺されとったんや	
Dialogue: 1,1:36:52.33,1:36:54.20,DefaultSingle-J,,0,0,0,,		え  そんな	
Dialogue: 1,1:36:54.33,1:36:59.21,DefaultSingle-J,,0,0,0,,		そして  その指紋の主こそ  名頃さん殺しの真犯人	
Dialogue: 1,1:37:00.42,1:37:03.51,DefaultSingle-J,,0,0,0,,		私の負けや  すべて自供しよう	
Dialogue: 1,1:37:03.88,1:37:08.43,DefaultSingle-J,,0,0,0,,		そのかわり  皐月会のカルタを証拠とするのはやめてくれんか	
Dialogue: 1,1:37:09.05,1:37:10.60,DefaultSingle-J,,0,0,0,,		それは皐月会にとって	
Dialogue: 1,1:37:10.64,1:37:12.35,DefaultSingle-J,,0,0,0,,		なんだ  そういうことか	
Dialogue: 1,1:37:12.77,1:37:15.27,DefaultSingle-J,,0,0,0,,		どうしても理解できないことがあったんだけど	
Dialogue: 1,1:37:15.35,1:37:17.10,DefaultSingle-J,,0,0,0,,		その態度で  よく分かったよ	
Dialogue: 1,1:37:17.56,1:37:20.90,DefaultSingle-J,,0,0,0,,		このカルタについてる指紋って  阿知波さんのじゃないよね	
Dialogue: 1,1:37:21.02,1:37:23.86,DefaultSingle-J,,0,0,0,,		いや  私や  私の指紋に間違いない	
Dialogue: 1,1:37:24.07,1:37:29.24,DefaultSingle-J,,0,0,0,,		確かに  今回起きた一連の事件は  あんたと海江田の仕業や	
Dialogue: 1,1:37:29.45,1:37:33.83,DefaultSingle-J,,0,0,0,,		けどすべての発端となった５年前の名頃さん殺しは  あんたやない	
Dialogue: 1,1:37:34.91,1:37:36.33,DefaultSingle-J,,0,0,0,,		皐月さんだよね	
Dialogue: 1,1:37:46.55,1:37:50.30,DefaultSingle-J,,0,0,0,,		その光景を見て  私は全てを悟った	
Dialogue: 1,1:37:50.93,1:37:54.60,DefaultSingle-J,,0,0,0,,		名頃が勝負を挑み  皐月が敗れたことを	
Dialogue: 1,1:37:58.48,1:38:02.69,DefaultSingle-J,,0,0,0,,		読手には  私が保管していたカセットを使うたんや	
Dialogue: 1,1:38:03.15,1:38:05.07,DefaultSingle-J,,0,0,0,,		この意味が分かるかね	
Dialogue: 1,1:38:06.36,1:38:09.32,DefaultSingle-J,,0,0,0,,		それは  皐月が何遍も聞き込んだもんや	
Dialogue: 1,1:38:09.53,1:38:12.49,DefaultSingle-J,,0,0,0,,		もちろん何パターンもあるうちの１つやが	
Dialogue: 1,1:38:12.62,1:38:16.62,DefaultSingle-J,,0,0,0,,		皐月は読まれる札の順番をある程度記憶していた	
Dialogue: 1,1:38:18.00,1:38:20.87,DefaultSingle-J,,0,0,0,,		圧倒的に有利な状況やったんや	
Dialogue: 1,1:38:21.13,1:38:23.46,DefaultSingle-J,,0,0,0,,		にもかかわらず皐月は敗れた	
Dialogue: 1,1:38:23.79,1:38:27.63,DefaultSingle-J,,0,0,0,,		名頃の実力は私たちの予想をはるかに超えとった	
Dialogue: 1,1:38:28.05,1:38:30.80,DefaultSingle-J,,0,0,0,,		皐月の感じた恐怖はどれほどやったろう	
Dialogue: 1,1:38:31.22,1:38:35.76,DefaultSingle-J,,0,0,0,,		翌日の試合で  屈辱的な大敗をするのは確実やった	
Dialogue: 1,1:38:36.27,1:38:40.52,DefaultSingle-J,,0,0,0,,		その恐怖が  彼女を犯行に走らせてしもうた	
Dialogue: 1,1:38:40.98,1:38:44.52,DefaultSingle-J,,0,0,0,,		皐月は  あれ以来人としての感情を失い	
Dialogue: 1,1:38:45.07,1:38:48.44,DefaultSingle-J,,0,0,0,,		皐月会の運営からも次第に遠ざかっていった	
Dialogue: 1,1:38:48.86,1:38:52.66,DefaultSingle-J,,0,0,0,,		そして２年後に病気で死んでしまったんだよ	
Dialogue: 1,1:38:53.37,1:38:55.03,DefaultSingle-J,,0,0,0,,		これが真実だ	
Dialogue: 1,1:38:55.49,1:38:57.16,DefaultSingle-J,,0,0,0,,		なあ  分かってくれ	
Dialogue: 1,1:38:58.29,1:38:59.04,DefaultSingle-J,,0,0,0,,		よせ	
Dialogue: 1,1:38:59.12,1:39:00.08,DefaultSingle-J,,0,0,0,,		やめるんや	
Dialogue: 1,1:39:00.16,1:39:02.04,DefaultSingle-J,,0,0,0,,		みんな名頃のせいだ	
Dialogue: 1,1:39:02.46,1:39:06.13,DefaultSingle-J,,0,0,0,,		あの男が皐月を辱めなければ  こんなことには	
Dialogue: 1,1:39:06.13,1:39:08.26,DefaultSingle-J,,0,0,0,,		辱めたくなかったから	
Dialogue: 1,1:39:08.59,1:39:11.76,DefaultSingle-J,,0,0,0,,		前の日に  名頃先生は行ったんやと思いますけど	
Dialogue: 1,1:39:12.43,1:39:15.14,DefaultSingle-J,,0,0,0,,		以前  名頃先生に聞いたことがあるんです	
Dialogue: 1,1:39:15.47,1:39:19.18,DefaultSingle-J,,0,0,0,,		なんで  そんなに皐月会を目の敵にしてはるんですかって	
Dialogue: 1,1:39:19.81,1:39:21.14,DefaultSingle-J,,0,0,0,,		目の敵か	
Dialogue: 1,1:39:21.56,1:39:24.69,DefaultSingle-J,,0,0,0,,		やっぱり  はたから見とったらそない見えてまうわなあ	
Dialogue: 1,1:39:24.94,1:39:27.94,DefaultSingle-J,,0,0,0,,		そやかで  こうでもせんと彼女と勝負できへんし	
Dialogue: 1,1:39:28.40,1:39:32.61,DefaultSingle-J,,0,0,0,,		ただ勝って  「すごいなぁ」ってほめられたいだけなんやけど	
Dialogue: 1,1:39:33.86,1:39:35.99,DefaultSingle-J,,0,0,0,,		初恋の相手にな	
Dialogue: 1,1:39:37.20,1:39:38.74,DefaultSingle-J,,0,0,0,,		は  初恋	
Dialogue: 1,1:39:39.04,1:39:39.95,DefaultSingle-J,,0,0,0,,		そうです	
Dialogue: 1,1:39:40.16,1:39:44.37,DefaultSingle-J,,0,0,0,,		名頃先生は皐月さんに憧れて  カルタ始めはったそうですから	
Dialogue: 1,1:39:44.88,1:39:49.67,DefaultSingle-J,,0,0,0,,		けど目の病で  あと１年しかカルタできひんってお医者様に言われて	
Dialogue: 1,1:39:50.13,1:39:53.80,DefaultSingle-J,,0,0,0,,		そやから  あんな強引なカルタにならはったんやと思います	
Dialogue: 1,1:39:54.51,1:39:56.72,DefaultSingle-J,,0,0,0,,		先生には  時間があらへんかったから	
Dialogue: 1,1:39:57.30,1:39:59.89,DefaultSingle-J,,0,0,0,,		じゃあ  前日の勝負で実力を見せて	
Dialogue: 1,1:40:00.02,1:40:03.02,DefaultSingle-J,,0,0,0,,		みんなの前では  皐月さんに勝ちを譲るつもりだったと	
Dialogue: 1,1:40:03.56,1:40:05.77,DefaultSingle-J,,0,0,0,,		面倒を見られへんようになってしまう	
Dialogue: 1,1:40:05.98,1:40:08.07,DefaultSingle-J,,0,0,0,,		ウチもふくめた自分の弟子たちを	
Dialogue: 1,1:40:08.36,1:40:11.28,DefaultSingle-J,,0,0,0,,		皐月会に引き取ってもらう理由づけをするために	
Dialogue: 1,1:40:11.94,1:40:16.57,DefaultSingle-J,,0,0,0,,		そうとは知らず  皐月さんは名頃さんを殺してもたっちゅうわけか	
Dialogue: 1,1:40:17.57,1:40:19.45,DefaultSingle-J,,0,0,0,,		そ  そんな	
Dialogue: 1,1:40:24.54,1:40:26.79,DefaultSingle-J,,0,0,0,,		わ  私はなんてことを	
Dialogue: 1,1:40:35.80,1:40:36.72,DefaultSingle-J,,0,0,0,,		な  なんや	
Dialogue: 1,1:40:37.84,1:40:38.72,DefaultSingle-J,,0,0,0,,		和葉	
Dialogue: 1,1:40:42.56,1:40:43.48,DefaultSingle-J,,0,0,0,,		和葉	
Dialogue: 1,1:40:44.18,1:40:45.14,DefaultSingle-J,,0,0,0,,		大丈夫か	
Dialogue: 1,1:40:45.27,1:40:47.81,DefaultSingle-J,,0,0,0,,		うん  でもうまく立てへん	
Dialogue: 1,1:40:53.07,1:40:54.95,DefaultSingle-J,,0,0,0,,		みんな  早くエレベーターに乗って	
Dialogue: 1,1:40:55.45,1:40:56.74,DefaultSingle-J,,0,0,0,,		紅葉  はよいけ	
Dialogue: 1,1:40:56.74,1:40:57.45,DefaultSingle-J,,0,0,0,,		え  ええ	
Dialogue: 1,1:40:57.82,1:40:59.28,DefaultSingle-J,,0,0,0,,		はよ立ち  行くで	
Dialogue: 1,1:40:59.45,1:41:01.54,DefaultSingle-J,,0,0,0,,		私はいい  置いていけ	
Dialogue: 1,1:41:01.66,1:41:05.25,DefaultSingle-J,,0,0,0,,		アホぬかせ  まだあんたを死なせるわけにはいかんのや	
Dialogue: 1,1:41:05.71,1:41:07.79,DefaultSingle-J,,0,0,0,,		紅葉さん  早く乗って	
Dialogue: 1,1:41:10.67,1:41:13.30,DefaultSingle-J,,0,0,0,,		和葉  こっちに登ってくるんや	
Dialogue: 1,1:41:13.71,1:41:14.34,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,1:41:14.42,1:41:15.63,DefaultSingle-J,,0,0,0,,		はよせえ	
Dialogue: 1,1:41:16.30,1:41:18.18,DefaultSingle-J,,0,0,0,,		クソッ  もうちょっとや	
Dialogue: 1,1:41:19.76,1:41:20.72,DefaultSingle-J,,0,0,0,,		よっしゃ	
Dialogue: 1,1:41:22.39,1:41:23.60,DefaultSingle-J,,0,0,0,,		なんや	
Dialogue: 1,1:41:29.69,1:41:32.19,DefaultSingle-J,,0,0,0,,		頼む  まだ落ちないでくれ	
Dialogue: 1,1:41:39.16,1:41:40.74,DefaultSingle-J,,0,0,0,,		クソ	
Dialogue: 1,1:41:47.71,1:41:48.87,DefaultSingle-J,,0,0,0,,		な  何	
Dialogue: 1,1:41:51.34,1:41:53.17,DefaultSingle-J,,0,0,0,,		させるか	
Dialogue: 1,1:42:07.18,1:42:07.98,DefaultSingle-J,,0,0,0,,		無事か	
Dialogue: 1,1:42:08.02,1:42:09.48,DefaultSingle-J,,0,0,0,,		今行くぞ	
Dialogue: 1,1:42:09.52,1:42:10.77,DefaultSingle-J,,0,0,0,,		あっぶねえ	
Dialogue: 1,1:42:11.44,1:42:12.27,DefaultSingle-J,,0,0,0,,		服部	
Dialogue: 1,1:42:17.32,1:42:18.65,DefaultSingle-J,,0,0,0,,		まずい  崩れるぞ	
Dialogue: 1,1:42:18.82,1:42:19.99,DefaultSingle-J,,0,0,0,,		離れるんや	
Dialogue: 1,1:42:25.70,1:42:26.58,DefaultSingle-J,,0,0,0,,		あれ	
Dialogue: 1,1:42:26.95,1:42:28.58,DefaultSingle-J,,0,0,0,,		えっ  ちょっとなんで	
Dialogue: 1,1:42:28.66,1:42:30.33,DefaultSingle-J,,0,0,0,,		待って  行かんといて	
Dialogue: 1,1:42:31.04,1:42:31.88,DefaultSingle-J,,0,0,0,,		平次	
Dialogue: 1,1:42:32.00,1:42:33.00,DefaultSingle-J,,0,0,0,,		和葉  乗れ	
Dialogue: 1,1:42:34.96,1:42:39.59,DefaultSingle-J,,0,0,0,,		服部  和葉ちゃん  頼む  なんとかぬけ出してくれ	
Dialogue: 1,1:42:45.81,1:42:47.22,DefaultSingle-J,,0,0,0,,		平次  あれ	
Dialogue: 1,1:42:47.31,1:42:48.06,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 1,1:42:49.10,1:42:50.44,DefaultSingle-J,,0,0,0,,		どうしたん  平次	
Dialogue: 1,1:42:50.77,1:42:52.60,DefaultSingle-J,,0,0,0,,		しっかり  つかまっとれよ	
Dialogue: 1,1:42:52.69,1:42:56.48,DefaultSingle-J,,0,0,0,,		あんた  まさか向こうの壁まで跳ぶつもりやないやろな	
Dialogue: 1,1:42:56.57,1:42:58.24,DefaultSingle-J,,0,0,0,,		よう分かったな  その  「まさかや」	
Dialogue: 1,1:42:58.49,1:42:59.57,DefaultSingle-J,,0,0,0,,		ウソやろ	
Dialogue: 1,1:42:59.61,1:43:02.16,DefaultSingle-J,,0,0,0,,		何考えてんねん  めっちゃ距離あんで	
Dialogue: 1,1:43:03.03,1:43:06.41,DefaultSingle-J,,0,0,0,,		なあ  平次  池に飛び降りたほうがええんとちゃう	
Dialogue: 1,1:43:06.45,1:43:07.33,DefaultSingle-J,,0,0,0,,		ムリや	
Dialogue: 1,1:43:07.33,1:43:11.04,DefaultSingle-J,,0,0,0,,		この高さから飛び降りたら  水面もコンクリートのように硬うなる	
Dialogue: 1,1:43:12.67,1:43:14.38,DefaultSingle-J,,0,0,0,,		しっかりつかまっとけよ  和葉	
Dialogue: 1,1:43:14.42,1:43:15.79,DefaultSingle-J,,0,0,0,,		その手離したら	
Dialogue: 1,1:43:16.96,1:43:17.84,DefaultSingle-J,,0,0,0,,		殺すで	
Dialogue: 1,1:43:19.05,1:43:19.88,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,1:43:24.59,1:43:31.10,DefaultSingle-J,,0,0,0,,		こんな所で  死んでたまるか	
Dialogue: 1,1:43:34.44,1:43:35.98,DefaultSingle-J,,0,0,0,,		あれは  服部	
Dialogue: 1,1:43:36.44,1:43:40.28,DefaultSingle-J,,0,0,0,,		まだお前には  言わなあかんことがあんねん	
Dialogue: 1,1:43:42.65,1:43:43.78,DefaultSingle-J,,0,0,0,,		あのバイク	
Dialogue: 1,1:43:47.08,1:43:50.45,DefaultSingle-J,,0,0,0,,		届け	
Dialogue: 1,1:44:01.05,1:44:02.47,DefaultSingle-J,,0,0,0,,		平次	
Dialogue: 1,1:44:02.88,1:44:04.47,DefaultSingle-J,,0,0,0,,		和葉	
Dialogue: 1,1:44:16.31,1:44:18.27,DefaultSingle-J,,0,0,0,,		大丈夫か  和葉	
Dialogue: 1,1:44:19.82,1:44:20.53,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 1,1:44:21.82,1:44:24.20,DefaultSingle-J,,0,0,0,,		もう脱出劇はこりごりやな	
Dialogue: 1,1:44:27.57,1:44:28.28,DefaultSingle-J,,0,0,0,,		無事か	
Dialogue: 1,1:44:28.95,1:44:30.37,DefaultSingle-J,,0,0,0,,		ったく  あいつら	
Dialogue: 1,1:44:30.95,1:44:33.25,DefaultSingle-J,,0,0,0,,		一時はどうなることか思たで	
Dialogue: 1,1:44:33.25,1:44:34.58,DefaultSingle-J,,0,0,0,,		ところで  平次	
Dialogue: 1,1:44:34.58,1:44:35.17,DefaultSingle-J,,0,0,0,,		え	
Dialogue: 1,1:44:35.21,1:44:37.46,DefaultSingle-J,,0,0,0,,		アタシに言わなあかんことって  何なん	
Dialogue: 1,1:44:38.04,1:44:39.67,DefaultSingle-J,,0,0,0,,		な  なんや  なんのこっちゃ	
Dialogue: 1,1:44:40.05,1:44:41.46,DefaultSingle-J,,0,0,0,,		さっき言うたやろ	
Dialogue: 1,1:44:41.55,1:44:43.84,DefaultSingle-J,,0,0,0,,		アタシになんか言うまで死ねへんって	
Dialogue: 1,1:44:43.84,1:44:45.30,DefaultSingle-J,,0,0,0,,		そ  空耳とちゃうか	
Dialogue: 1,1:44:45.30,1:44:48.89,DefaultSingle-J,,0,0,0,,		ちゃうわ  カルタの特訓で耳はチョー鍛えられてんねん	
Dialogue: 1,1:44:49.30,1:44:51.18,DefaultSingle-J,,0,0,0,,		さあ  文句があんなら言うてみい	
Dialogue: 1,1:44:51.22,1:44:51.68,DefaultSingle-J,,0,0,0,,		何なん	
Dialogue: 1,1:44:51.68,1:44:52.64,DefaultSingle-J,,0,0,0,,		いや  いや  ちょっ	
Dialogue: 1,1:44:53.06,1:44:54.27,DefaultSingle-J,,0,0,0,,		なんやねん	
Dialogue: 1,1:44:54.39,1:44:56.27,DefaultSingle-J,,0,0,0,,		何よ  言わなあかんことって	
Dialogue: 1,1:44:56.31,1:44:57.56,DefaultSingle-J,,0,0,0,,		お前に言いたいこというのは	
Dialogue: 1,1:48:43.04,1:48:45.17,DefaultSingle-J,,0,0,0,,		見送りに来てくれてありがとう	
Dialogue: 1,1:48:45.37,1:48:47.71,DefaultSingle-J,,0,0,0,,		お礼を言わなあかんのはこっちのほうや	
Dialogue: 1,1:48:48.17,1:48:50.34,DefaultSingle-J,,0,0,0,,		そういえば  カルタ部はどうなったの	
Dialogue: 1,1:48:50.67,1:48:51.84,DefaultSingle-J,,0,0,0,,		それがな	
Dialogue: 1,1:48:51.92,1:48:54.97,DefaultSingle-J,,0,0,0,,		決勝まで進んだことを  学校側が認めてくれて	
Dialogue: 1,1:48:55.13,1:48:57.05,DefaultSingle-J,,0,0,0,,		廃部にならんで済んだそうや	
Dialogue: 1,1:48:57.39,1:49:00.26,DefaultSingle-J,,0,0,0,,		アタシは最後の最後で  負けてしもうたけど	
Dialogue: 1,1:49:03.18,1:49:04.14,DefaultSingle-J,,0,0,0,,		和葉ちゃん	
Dialogue: 1,1:49:04.35,1:49:05.56,DefaultSingle-J,,0,0,0,,		ちょっと  来て	
Dialogue: 1,1:49:05.60,1:49:06.31,DefaultSingle-J,,0,0,0,,		あれ	
Dialogue: 1,1:49:06.39,1:49:07.40,DefaultSingle-J,,0,0,0,,		どうしたんでしょう	
Dialogue: 1,1:49:07.60,1:49:10.48,DefaultSingle-J,,0,0,0,,		なんだよ  内緒話かよ	
Dialogue: 1,1:49:10.86,1:49:11.86,DefaultSingle-J,,0,0,0,,		ほんとに	
Dialogue: 1,1:49:11.86,1:49:15.15,DefaultSingle-J,,0,0,0,,		ええねん  だって「しのぶれど」が取れたから	
Dialogue: 1,1:49:15.32,1:49:17.95,DefaultSingle-J,,0,0,0,,		やっぱ  その歌を得意札にしたんだね	
Dialogue: 1,1:49:18.32,1:49:20.58,DefaultSingle-J,,0,0,0,,		ちゃうちゃう  歌だけやない	
Dialogue: 1,1:49:20.66,1:49:23.16,DefaultSingle-J,,0,0,0,,		その歌をよんだ人の名前や	
Dialogue: 1,1:49:23.33,1:49:24.62,DefaultSingle-J,,0,0,0,,		平兼盛	
Dialogue: 1,1:49:24.83,1:49:29.54,DefaultSingle-J,,0,0,0,,		百人一首の中で  平次の「平」の字で  名前が始まんのはその人だけや	
Dialogue: 1,1:49:29.83,1:49:32.50,DefaultSingle-J,,0,0,0,,		もう平次の札にしか見えへんかったわ	
Dialogue: 1,1:49:33.84,1:49:36.88,DefaultSingle-J,,0,0,0,,		あとで「しのぶれど」の写真  平次に送ったんねん	
Dialogue: 1,1:49:37.30,1:49:39.34,DefaultSingle-J,,0,0,0,,		これがアタシの気持ちってな	
Dialogue: 1,1:49:40.14,1:49:43.43,DefaultSingle-J,,0,0,0,,		「しのぶれど」を送って  自分の気持ちを伝えるん	
Dialogue: 1,1:49:44.06,1:49:45.85,DefaultSingle-J,,0,0,0,,		そらルール違反とちゃいます	
Dialogue: 1,1:49:46.10,1:49:47.19,DefaultSingle-J,,0,0,0,,		紅葉さん	
Dialogue: 1,1:49:47.27,1:49:49.19,DefaultSingle-J,,0,0,0,,		今の声  聞こえてたん	
Dialogue: 1,1:49:49.73,1:49:52.02,DefaultSingle-J,,0,0,0,,		耳がええんは  あんただけとちゃいますわ	
Dialogue: 1,1:49:52.27,1:49:53.73,DefaultSingle-J,,0,0,0,,		おう  紅葉やないか	
Dialogue: 1,1:49:54.11,1:49:55.74,DefaultSingle-J,,0,0,0,,		何してんねん  お前  こんなとこで	
Dialogue: 1,1:49:55.94,1:49:58.45,DefaultSingle-J,,0,0,0,,		約束どおり告白しに来たんです	
Dialogue: 1,1:49:59.11,1:50:02.78,DefaultSingle-J,,0,0,0,,		もっとも  ウチはもう平次君に告白されてますけど	
Dialogue: 1,1:50:02.91,1:50:04.70,DefaultSingle-J,,0,0,0,,		はあ？  何のこっちゃ	
Dialogue: 1,1:50:05.12,1:50:07.29,DefaultSingle-J,,0,0,0,,		これがその証拠写真です	
Dialogue: 1,1:50:07.87,1:50:09.12,DefaultSingle-J,,0,0,0,,		指切りしてる	
Dialogue: 1,1:50:09.17,1:50:11.46,DefaultSingle-J,,0,0,0,,		約束してしまったんですね	
Dialogue: 1,1:50:11.50,1:50:14.55,DefaultSingle-J,,0,0,0,,		破ったら針千本のまなきゃいけないんだぞ	
Dialogue: 1,1:50:14.59,1:50:17.55,DefaultSingle-J,,0,0,0,,		ちょー待て  なんの約束したっちゅうねん	
Dialogue: 1,1:50:17.76,1:50:20.47,DefaultSingle-J,,0,0,0,,		「今度会うたら  嫁にとるさかい  待っとけや」	
Dialogue: 1,1:50:20.47,1:50:21.68,DefaultSingle-J,,0,0,0,,		ええっ	
Dialogue: 1,1:50:22.10,1:50:25.27,DefaultSingle-J,,0,0,0,,		こいつ  なにげに  恥ずかしいところ記録されるよな	
Dialogue: 1,1:50:25.89,1:50:30.10,DefaultSingle-J,,0,0,0,,		それとも  こんな昔話  なかったことにしはりますか	
Dialogue: 1,1:50:31.15,1:50:32.81,DefaultSingle-J,,0,0,0,,		あ  思い出したわ	
Dialogue: 1,1:50:33.02,1:50:34.52,DefaultSingle-J,,0,0,0,,		あん時  こう言うたんや	
Dialogue: 1,1:50:34.94,1:50:37.90,DefaultSingle-J,,0,0,0,,		「泣くなや  また今度勝負したらええやんけ」	
Dialogue: 1,1:50:38.07,1:50:40.61,DefaultSingle-J,,0,0,0,,		「けど今度会うたら  もっと強めに取るさかい」	
Dialogue: 1,1:50:40.70,1:50:42.70,DefaultSingle-J,,0,0,0,,		「腕磨いて待っとけや」っての	
Dialogue: 1,1:50:43.20,1:50:43.91,DefaultSingle-J,,0,0,0,,		つ	
Dialogue: 1,1:50:44.16,1:50:45.37,DefaultSingle-J,,0,0,0,,		よめに	
Dialogue: 1,1:50:45.62,1:50:47.00,DefaultSingle-J,,0,0,0,,		取るさかい	
Dialogue: 1,1:50:47.08,1:50:48.96,DefaultSingle-J,,0,0,0,,		うん  相手が女の子やったし	
Dialogue: 1,1:50:48.96,1:50:50.33,DefaultSingle-J,,0,0,0,,		ケガさせたらあかん思て	
Dialogue: 1,1:50:50.37,1:50:52.71,DefaultSingle-J,,0,0,0,,		力ぬいて  優しゅう取ってたからのう	
Dialogue: 1,1:50:53.00,1:50:55.17,DefaultSingle-J,,0,0,0,,		伊織  撤収です	
Dialogue: 1,1:50:55.46,1:50:56.67,DefaultSingle-J,,0,0,0,,		はい  お嬢様	
Dialogue: 1,1:50:57.17,1:51:00.38,DefaultSingle-J,,0,0,0,,		ほな  今日はこの辺で勘弁しといてあげますけど	
Dialogue: 1,1:51:00.55,1:51:03.68,DefaultSingle-J,,0,0,0,,		ウチは狙った札は  誰にも取らせへんちゅうこと	
Dialogue: 1,1:51:04.35,1:51:06.31,DefaultSingle-J,,0,0,0,,		よう覚えといてもらいましょか	
Dialogue: 1,1:51:07.60,1:51:08.64,DefaultSingle-J,,0,0,0,,		和葉ちゃん	
Dialogue: 1,1:51:11.90,1:51:14.94,DefaultSingle-J,,0,0,0,,		なんや  また和葉とカルタやる気なんか	
Dialogue: 1,1:51:21.99,1:51:23.16,DefaultSingle-J,,0,0,0,,		ごめん  寝てた	
Dialogue: 1,1:51:23.45,1:51:26.08,DefaultSingle-J,,0,0,0,,		園子って百人一首に詳しかったよね	
Dialogue: 1,1:51:26.33,1:51:28.79,DefaultSingle-J,,0,0,0,,		うん  お正月に家族でやるから	
Dialogue: 1,1:51:29.20,1:51:32.46,DefaultSingle-J,,0,0,0,,		新一に「めぐりあひて」の札の写真送ったら	
Dialogue: 1,1:51:32.75,1:51:35.13,DefaultSingle-J,,0,0,0,,		「瀬をはやみ」って歌が返ってきたんだけど	
Dialogue: 1,1:51:35.59,1:51:36.71,DefaultSingle-J,,0,0,0,,		どんな意味だっけ	
Dialogue: 1,1:51:36.71,1:51:38.50,DefaultSingle-J,,0,0,0,,		わたし  忘れちゃって	
Dialogue: 1,1:51:38.84,1:51:41.59,DefaultSingle-J,,0,0,0,,		「いとしいあの人と今は別れていても  いつかは」	
Dialogue: 1,1:51:41.51,1:51:43.22,DefaultSingle-J,,0,0,0,,		ねえ  もしもし	
Dialogue: 1,1:51:43.51,1:51:46.68,DefaultSingle-J,,0,0,0,,		ねえ  もしもし  園子  園子	
Dialogue: 1,1:51:41.63,1:51:43.47,DefaultSingle-J,,0,0,0,,		「きっと再会しよう」	
Dialogue: 1,1:51:43.51,1:51:46.68,DefaultSingle-J,,0,0,0,,		という崇徳院がよんだラブラブな歌か	
Dialogue: 1,1:51:47.01,1:51:48.18,DefaultSingle-J,,0,0,0,,		ごちそうさま	
Dialogue: 1,1:51:48.56,1:51:50.14,DefaultSingle-J,,0,0,0,,		あっ  ちょっと園子	
Dialogue: 1,1:51:50.85,1:51:52.81,DefaultSingle-J,,0,0,0,,		忘れてんじゃねぇよ	
Dialogue: 1,1:52:10.91,1:52:11.87,DefaultSingle-J,,0,0,0,,		ゼロ	
