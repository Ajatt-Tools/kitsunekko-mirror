Dialogue: 1,0:00:27.97,0:00:32.43,DefaultSingle-J,,0,0,0,,		「…ふまで」\h\h	
Dialogue: 1,0:00:34.43,0:00:40.14,DefaultSingle-J,,0,0,0,,		「嵐吹く三室の山のもみぢ葉は」	
Dialogue: 1,0:00:45.69,0:00:51.61,DefaultSingle-J,,0,0,0,,		「龍田の川の  錦なりけり」	
Dialogue: 1,0:00:56.74,0:01:01.42,DefaultSingle-J,,0,0,0,,		「わびぬれば  今はた同じ  難波…」	
Dialogue: 1,0:00:58.79,0:01:01.33,DefaultSingle-J,,0,0,0,,		師と同じ得意札か	
Dialogue: 1,0:01:09.05,0:01:10.97,DefaultSingle-J,,0,0,0,,		すべて君のおかげやで	
Dialogue: 1,0:01:12.26,0:01:13.72,DefaultSingle-J,,0,0,0,,		大岡紅葉	
Dialogue: 1,0:01:14.72,0:01:18.56,DefaultSingle-J,,0,0,0,,		今日のテレビ収録が終わったら  礼言わんとな	
Dialogue: 1,0:01:22.69,0:01:23.86,DefaultSingle-J,,0,0,0,,		なんや  早いな	
Dialogue: 1,0:01:24.31,0:01:25.15,DefaultSingle-J,,0,0,0,,		もう来たんか	
Dialogue: 1,0:01:27.48,0:01:29.61,DefaultSingle-J,,0,0,0,,		あっ  あんさん  どないしたんや	
Dialogue: 1,0:01:30.19,0:01:31.36,DefaultSingle-J,,0,0,0,,		ま  まさか	
Dialogue: 1,0:01:57.76,0:02:07.90,DefaultSingle-J,,0,0,0,,		「冬ごもり  今を春べと  咲くやこの花」	
Dialogue: 1,0:02:10.49,0:02:17.53,DefaultSingle-J,,0,0,0,,		「今を春べと  咲くやこの花」	
Dialogue: 1,0:02:19.33,0:02:25.46,DefaultSingle-J,,0,0,0,,		「このたびは  幣もとりあへず  手向山」	
Dialogue: 1,0:02:22.71,0:02:25.63,DefaultSingle-J,,0,0,0,,		うへっ  ここまでカルタが飛んでくるのか	
Dialogue: 1,0:02:25.75,0:02:27.21,DefaultSingle-J,,0,0,0,,		あっ  お構いなく	
Dialogue: 1,0:02:27.42,0:02:28.46,DefaultSingle-J,,0,0,0,,		え？  ああ	
Dialogue: 1,0:02:28.84,0:02:29.80,DefaultSingle-J,,0,0,0,,		失礼します	
Dialogue: 1,0:02:31.76,0:02:32.88,DefaultSingle-J,,0,0,0,,		かわいい	
Dialogue: 1,0:02:32.88,0:02:34.51,DefaultSingle-J,,0,0,0,,		ちょっと  お父さん  静かにして	
Dialogue: 1,0:02:34.93,0:02:35.89,DefaultSingle-J,,0,0,0,,		べっぴんさん	
Dialogue: 1,0:02:35.89,0:02:37.01,DefaultSingle-J,,0,0,0,,		アイドルみたい	
Dialogue: 1,0:02:37.14,0:02:39.01,DefaultSingle-J,,0,0,0,,		着物もよく似合ってます	
Dialogue: 1,0:02:39.01,0:02:42.35,DefaultSingle-J,,0,0,0,,		ってか  なんで俺たちこんな所でカルタ見てんだ	
Dialogue: 1,0:02:42.39,0:02:44.39,DefaultSingle-J,,0,0,0,,		せやから  未来子が言うんてたやん	
Dialogue: 1,0:02:44.69,0:02:47.31,DefaultSingle-J,,0,0,0,,		対談前やから  控室で待っといてって	
Dialogue: 1,0:02:47.73,0:02:52.19,DefaultSingle-J,,0,0,0,,		せやのに  おっちゃんがあのキレイな子につられて  このスタジオに入ってまうから	
Dialogue: 1,0:02:52.24,0:02:53.61,DefaultSingle-J,,0,0,0,,		未来子って  だれだ	
Dialogue: 1,0:02:53.82,0:02:55.57,DefaultSingle-J,,0,0,0,,		さっき紹介したやろ	
Dialogue: 1,0:02:55.78,0:02:58.66,DefaultSingle-J,,0,0,0,,		あのキレイな子のカルタの相手してるメガネの子	
Dialogue: 1,0:02:58.99,0:03:02.58,DefaultSingle-J,,0,0,0,,		アタシも所属してる  我が改方学園のカルタ部の部長やで	
Dialogue: 1,0:03:03.12,0:03:04.46,DefaultSingle-J,,0,0,0,,		「アタシも所属」って	
Dialogue: 1,0:03:04.75,0:03:06.67,DefaultSingle-J,,0,0,0,,		和葉  お前カルタ部やったんか	
Dialogue: 1,0:03:06.67,0:03:08.33,DefaultSingle-J,,0,0,0,,		そうや  知らんかったん	
Dialogue: 1,0:03:08.67,0:03:11.30,DefaultSingle-J,,0,0,0,,		っていうか  平次らトイレ長すぎとちゃう	
Dialogue: 1,0:03:11.38,0:03:14.34,DefaultSingle-J,,0,0,0,,		すまんすまん  スタジオ入る扉  閉まっててな	
Dialogue: 1,0:03:14.34,0:03:16.01,DefaultSingle-J,,0,0,0,,		開けてええかどうか  分からへんかってや	
Dialogue: 1,0:03:16.01,0:03:20.43,DefaultSingle-J,,0,0,0,,		すみません  リハの最中なんで  少し静かにしてもらえます	
Dialogue: 1,0:03:18.76,0:03:23.39,DefaultSingle-J,,0,0,0,,		「神のまにまに」	
Dialogue: 1,0:03:20.97,0:03:21.85,DefaultSingle-J,,0,0,0,,		あ  はい	
Dialogue: 1,0:03:24.98,0:03:30.57,DefaultSingle-J,,0,0,0,,		「君がため  惜しからざりし  命さへ」	
Dialogue: 1,0:03:31.27,0:03:33.19,DefaultSingle-J,,0,0,0,,		おい  工藤  このオッサン	
Dialogue: 1,0:03:33.19,0:03:36.24,DefaultSingle-J,,0,0,0,,		対談のために大阪に来たこと  忘れてるんとちゃうか	
Dialogue: 1,0:03:36.28,0:03:38.03,DefaultSingle-J,,0,0,0,,		まあ  勘弁してやれよ	
Dialogue: 1,0:03:38.28,0:03:40.74,DefaultSingle-J,,0,0,0,,		大阪見物したいって  せがむ子供たちを	
Dialogue: 1,0:03:40.95,0:03:43.95,DefaultSingle-J,,0,0,0,,		用事で来られない博士の代わりに連れてきたんだから	
Dialogue: 1,0:03:44.20,0:03:47.08,DefaultSingle-J,,0,0,0,,		そーゆうたら  あの金持ちの姉ちゃんは  どないしたんや	
Dialogue: 1,0:03:47.54,0:03:49.00,DefaultSingle-J,,0,0,0,,		ああ  園子なら	
Dialogue: 1,0:03:49.67,0:03:51.17,DefaultSingle-J,,0,0,0,,		カゼでぶっ倒れてるよ	
Dialogue: 1,0:03:53.21,0:03:56.92,DefaultSingle-J,,0,0,0,,		でも知らなかったよ  和葉ちゃんがカルタ部だったなんて	
Dialogue: 1,0:03:57.05,0:03:58.76,DefaultSingle-J,,0,0,0,,		合気道部と兼任やねん	
Dialogue: 1,0:03:59.01,0:04:01.85,DefaultSingle-J,,0,0,0,,		カルタ部は新入部員が少のうて  つぶれそうやから	
Dialogue: 1,0:04:01.93,0:04:03.22,DefaultSingle-J,,0,0,0,,		名前だけ貸してって	
Dialogue: 1,0:04:03.43,0:04:06.35,DefaultSingle-J,,0,0,0,,		たまーに未来子の練習に  付き合うために復活する	
Dialogue: 1,0:04:06.35,0:04:08.23,DefaultSingle-J,,0,0,0,,		ゾンビ部員みたいなもんや	
Dialogue: 1,0:04:08.44,0:04:10.73,DefaultSingle-J,,0,0,0,,		ゾンビ部員って  おかしい	
Dialogue: 1,0:04:11.48,0:04:13.65,DefaultSingle-J,,0,0,0,,		にぎやかで楽しそうですなあ	
Dialogue: 1,0:04:15.15,0:04:17.28,DefaultSingle-J,,0,0,0,,		まるでカフェにいるみたいやわ	
Dialogue: 1,0:04:17.78,0:04:19.70,DefaultSingle-J,,0,0,0,,		うっ  すみません	
Dialogue: 1,0:04:40.26,0:04:42.64,DefaultSingle-J,,0,0,0,,		オレは高校生探偵工藤新一	
Dialogue: 1,0:04:43.68,0:04:47.18,DefaultSingle-J,,0,0,0,,		幼なじみで同級生の毛利蘭と遊園地に遊びに行って	
Dialogue: 1,0:04:47.56,0:04:51.27,DefaultSingle-J,,0,0,0,,		黒ずくめの男の  あやしげな取引現場を目撃した	
Dialogue: 1,0:04:52.90,0:04:55.07,DefaultSingle-J,,0,0,0,,		取引を見るのに夢中になっていたオレは	
Dialogue: 1,0:04:55.36,0:04:58.65,DefaultSingle-J,,0,0,0,,		背後から近づいてくるもう一人の仲間に気づかなかった	
Dialogue: 1,0:05:00.07,0:05:04.66,DefaultSingle-J,,0,0,0,,		オレはその男に毒薬をのまされ  目が覚めたら	
Dialogue: 1,0:05:09.29,0:05:11.21,DefaultSingle-J,,0,0,0,,		体が縮んでしまっていた	
Dialogue: 1,0:05:13.96,0:05:16.42,DefaultSingle-J,,0,0,0,,		工藤新一が生きているとヤツらにバレたら	
Dialogue: 1,0:05:16.67,0:05:19.88,DefaultSingle-J,,0,0,0,,		また命が狙われ  周りの人間にも危害がおよぶ	
Dialogue: 1,0:05:21.84,0:05:24.97,DefaultSingle-J,,0,0,0,,		阿笠博士の助言で  正体を隠すことにしたオレは	
Dialogue: 1,0:05:25.39,0:05:30.27,DefaultSingle-J,,0,0,0,,		蘭に名前を聞かれてとっさに  江戸川コナンと名乗り	
Dialogue: 1,0:05:30.81,0:05:32.48,DefaultSingle-J,,0,0,0,,		ヤツらの情報をつかむために	
Dialogue: 1,0:05:32.73,0:05:35.90,DefaultSingle-J,,0,0,0,,		父親が探偵をやっている蘭の家に転がり込んだ	
Dialogue: 1,0:05:39.11,0:05:42.41,DefaultSingle-J,,0,0,0,,		こいつは服部平次  西の高校生探偵だ	
Dialogue: 1,0:05:43.24,0:05:46.24,DefaultSingle-J,,0,0,0,,		大阪府警本部長のオヤジさん譲りの推理力で	
Dialogue: 1,0:05:46.53,0:05:48.54,DefaultSingle-J,,0,0,0,,		数々の難事件を解決している	
Dialogue: 1,0:05:49.33,0:05:52.67,DefaultSingle-J,,0,0,0,,		ヤツはオレの正体を知っている  数少ないうちの一人だ	
Dialogue: 1,0:05:54.63,0:05:58.38,DefaultSingle-J,,0,0,0,,		遠山和葉  服部とは同級生で幼なじみ	
Dialogue: 1,0:05:59.01,0:06:02.09,DefaultSingle-J,,0,0,0,,		服部の言葉には  いつもヤキモキさせられてる	
Dialogue: 1,0:06:02.47,0:06:04.43,DefaultSingle-J,,0,0,0,,		この先  一体どうなってしまうのか	
Dialogue: 1,0:06:06.14,0:06:08.97,DefaultSingle-J,,0,0,0,,		そして  なぞに包まれた未来のクイーン	
Dialogue: 1,0:06:09.60,0:06:11.52,DefaultSingle-J,,0,0,0,,		彼女は一体何者なのか	
Dialogue: 1,0:06:12.98,0:06:14.81,DefaultSingle-J,,0,0,0,,		小さくなっても  頭脳は同じ	
Dialogue: 1,0:06:15.23,0:06:17.02,DefaultSingle-J,,0,0,0,,		迷宮なしの名探偵	
Dialogue: 1,0:06:18.27,0:06:21.28,DefaultSingle-J,,0,0,0,,		真実はいつもひとつ	
Dialogue: 1,0:06:27.53,0:06:31.58,DefaultSingle-J,,0,0,0,,		ちぇっ  せっかくテレビ局に来たのに  控室かよ	
Dialogue: 1,0:06:31.58,0:06:33.46,DefaultSingle-J,,0,0,0,,		本番も見たかったな	
Dialogue: 1,0:06:33.46,0:06:36.79,DefaultSingle-J,,0,0,0,,		ムリですよ  小五郎のおじさんも怒られてましたから	
Dialogue: 1,0:06:36.79,0:06:39.71,DefaultSingle-J,,0,0,0,,		なんか  ごめんね  わたしが騒がしくしちゃったせいで	
Dialogue: 1,0:06:39.84,0:06:40.67,DefaultSingle-J,,0,0,0,,		あっ  そうだ	
Dialogue: 1,0:06:40.92,0:06:43.63,DefaultSingle-J,,0,0,0,,		みんなが  もどってきたら  お土産買いに行こっか	
Dialogue: 1,0:06:43.97,0:06:44.63,DefaultSingle-J,,0,0,0,,		ほんと	
Dialogue: 1,0:06:44.51,0:06:45.26,DefaultSingle-J,,0,0,0,,		マジかよ	
Dialogue: 1,0:06:45.30,0:06:48.22,DefaultSingle-J,,0,0,0,,		うん  収録が終わるまでいい子にしてたらね	
Dialogue: 1,0:06:48.22,0:06:49.39,DefaultSingle-J,,0,0,0,,		もちろんです	
Dialogue: 1,0:06:49.39,0:06:50.18,DefaultSingle-J,,0,0,0,,		やったぜ	
Dialogue: 1,0:06:50.35,0:06:51.72,DefaultSingle-J,,0,0,0,,		みんなで買いに行こう	
Dialogue: 1,0:06:52.10,0:06:54.56,DefaultSingle-J,,0,0,0,,		そういえば  コナン君はどうしたんですか	
Dialogue: 1,0:06:54.69,0:06:58.27,DefaultSingle-J,,0,0,0,,		ああ  コナン君なら  わたしの代わりに	
Dialogue: 1,0:06:58.40,0:06:59.82,DefaultSingle-J,,0,0,0,,		お父さんの見張りを	
Dialogue: 1,0:07:00.40,0:07:01.36,DefaultSingle-J,,0,0,0,,		おい  小僧	
Dialogue: 1,0:07:01.86,0:07:04.07,DefaultSingle-J,,0,0,0,,		お前も  控室で待ってろっつったろ	
Dialogue: 1,0:07:04.57,0:07:08.41,DefaultSingle-J,,0,0,0,,		でも蘭ねーちゃんに収録の樣子を見てくるよう言われたから	
Dialogue: 1,0:07:08.62,0:07:09.33,DefaultSingle-J,,0,0,0,,		ったく	
Dialogue: 1,0:07:09.33,0:07:10.16,DefaultSingle-J,,0,0,0,,		はい  どいて	
Dialogue: 1,0:07:10.37,0:07:13.16,DefaultSingle-J,,0,0,0,,		道を空けてください  カルタ通ります	
Dialogue: 1,0:07:13.20,0:07:15.46,DefaultSingle-J,,0,0,0,,		うわっ  皐月会のカルタや	
Dialogue: 1,0:07:15.75,0:07:18.00,DefaultSingle-J,,0,0,0,,		えらいぎょうぎょうしいな  あのカルタ	
Dialogue: 1,0:07:18.13,0:07:19.96,DefaultSingle-J,,0,0,0,,		何  言うてんの  和葉	
Dialogue: 1,0:07:20.04,0:07:24.01,DefaultSingle-J,,0,0,0,,		皐月会が開催する全国大会の決勝戦で使われる	
Dialogue: 1,0:07:24.01,0:07:25.68,DefaultSingle-J,,0,0,0,,		伝統のカルタやないの	
Dialogue: 1,0:07:25.68,0:07:29.89,DefaultSingle-J,,0,0,0,,		ああ  あの札で試合するんが  未来子の夢やったっけ	
Dialogue: 1,0:07:29.97,0:07:33.22,DefaultSingle-J,,0,0,0,,		私だけやない  皐月会２０年の歴史で	
Dialogue: 1,0:07:33.27,0:07:35.77,DefaultSingle-J,,0,0,0,,		あの札に憧れんかったもんはおらんよ	
Dialogue: 1,0:07:36.02,0:07:37.69,DefaultSingle-J,,0,0,0,,		ああ  いっぺんでええから	
Dialogue: 1,0:07:37.69,0:07:40.77,DefaultSingle-J,,0,0,0,,		決勝戦で  あの伝説のカルタに触れてみたいなあ	
Dialogue: 1,0:07:40.77,0:07:44.78,DefaultSingle-J,,0,0,0,,		ねえねえ  なんであの札は決勝戦でしか使われないの	
Dialogue: 1,0:07:44.99,0:07:48.66,DefaultSingle-J,,0,0,0,,		激しい試合を何度もしてきたから  痛みがひどいんや	
Dialogue: 1,0:07:49.07,0:07:53.16,DefaultSingle-J,,0,0,0,,		そやから  決勝で使う時以外はああやってケースに入れて	
Dialogue: 1,0:07:53.45,0:07:56.08,DefaultSingle-J,,0,0,0,,		普段は美術館に展示されてるんやで	
Dialogue: 1,0:07:56.50,0:07:59.92,DefaultSingle-J,,0,0,0,,		にしても  あの警備は大げさすぎるんとちゃうか	
Dialogue: 1,0:07:59.92,0:08:00.92,DefaultSingle-J,,0,0,0,,		そんなことない	
Dialogue: 1,0:08:01.21,0:08:04.67,DefaultSingle-J,,0,0,0,,		去年の皐月杯のあとで  カルタの紛失騒ぎがあってな	
Dialogue: 1,0:08:05.09,0:08:07.09,DefaultSingle-J,,0,0,0,,		結局  すぐに見つかったんやけど	
Dialogue: 1,0:08:07.30,0:08:10.64,DefaultSingle-J,,0,0,0,,		セキュリティ強化すべきやって  王者の矢島さんが	
Dialogue: 1,0:08:10.68,0:08:12.93,DefaultSingle-J,,0,0,0,,		阿知波会長を説得したそうなんや	
Dialogue: 1,0:08:13.10,0:08:14.06,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 1,0:08:14.39,0:08:17.56,DefaultSingle-J,,0,0,0,,		ところで  その２人ってだれだったっけか	
Dialogue: 1,0:08:18.77,0:08:22.44,DefaultSingle-J,,0,0,0,,		アホか  おっちゃん  これから対談する相手やないの	
Dialogue: 1,0:08:22.82,0:08:23.73,DefaultSingle-J,,0,0,0,,		そうだっけ	
Dialogue: 1,0:08:23.90,0:08:26.61,DefaultSingle-J,,0,0,0,,		大体  皐月っていゃ普通馬だろう  馬	
Dialogue: 1,0:08:23.94,0:08:26.28,DefaultSingle-J,,0,0,0,,		さすがブレねえな  おっちゃん	
Dialogue: 1,0:08:26.82,0:08:29.74,DefaultSingle-J,,0,0,0,,		ここに写ってるんが  会長の阿知波研介や	
Dialogue: 1,0:08:30.74,0:08:36.00,DefaultSingle-J,,0,0,0,,		一代で阿知波不動産を築き上げた大物で  浪花の不動産王とも呼ばれてる	
Dialogue: 1,0:08:36.08,0:08:38.87,DefaultSingle-J,,0,0,0,,		そんな男が  なんでカルタなんかやってんだ	
Dialogue: 1,0:08:39.04,0:08:42.96,DefaultSingle-J,,0,0,0,,		唯一の趣味やったそうや  腕前も相当なもんらしいで	
Dialogue: 1,0:08:43.75,0:08:48.13,DefaultSingle-J,,0,0,0,,		でも阿知波さん自身は選手よりも  読手になりたかったって  書いてあるね	
Dialogue: 1,0:08:48.38,0:08:50.97,DefaultSingle-J,,0,0,0,,		おっ  だれだこの美しい女性は	
Dialogue: 1,0:08:51.14,0:08:53.26,DefaultSingle-J,,0,0,0,,		阿知波さんの奥さんの皐月さんです	
Dialogue: 1,0:08:53.64,0:08:55.39,DefaultSingle-J,,0,0,0,,		なんだ  人妻かよ	
Dialogue: 1,0:08:55.68,0:08:59.52,DefaultSingle-J,,0,0,0,,		皐月会は元々  クイーンだった皐月さんが作った会で	
Dialogue: 1,0:08:59.69,0:09:02.94,DefaultSingle-J,,0,0,0,,		阿知波さんは  そのあとをついで  会長になったんです	
Dialogue: 1,0:09:03.06,0:09:05.78,DefaultSingle-J,,0,0,0,,		あと対談で  話題になりそうなことは	
Dialogue: 1,0:09:06.44,0:09:07.86,DefaultSingle-J,,0,0,0,,		これなんか  面白いんじゃない	
Dialogue: 1,0:09:08.32,0:09:12.70,DefaultSingle-J,,0,0,0,,		阿知波さんは奥さんの皐月さんの大切な試合が行われる時は	
Dialogue: 1,0:09:12.91,0:09:15.91,DefaultSingle-J,,0,0,0,,		必ず前日に洗車して  ゲンを担ぐんだって	
Dialogue: 1,0:09:16.33,0:09:20.29,DefaultSingle-J,,0,0,0,,		車をキレイにしておくことが  成功と勝利の秘訣って言ってるね	
Dialogue: 1,0:09:20.50,0:09:24.71,DefaultSingle-J,,0,0,0,,		で  俺はこのゲン担ぎ夫婦と３人で対談すればいいのか	
Dialogue: 1,0:09:24.84,0:09:30.55,DefaultSingle-J,,0,0,0,,		いいえ  奥さんの皐月さんは  ３年前に病気でお亡くなりになって	
Dialogue: 1,0:09:30.93,0:09:34.05,DefaultSingle-J,,0,0,0,,		今日  対談なさるんは阿知波会長だけです	
Dialogue: 1,0:09:34.60,0:09:35.72,DefaultSingle-J,,0,0,0,,		そ  そうか	
Dialogue: 1,0:09:36.10,0:09:41.02,DefaultSingle-J,,0,0,0,,		あのさ  この阿知波さんの横に必ず写ってる  すごい強そうな人はだれ	
Dialogue: 1,0:09:41.10,0:09:44.94,DefaultSingle-J,,0,0,0,,		ああ  その人は阿知波さんの秘書やった  海江田藤伍さんや	
Dialogue: 1,0:09:45.23,0:09:49.78,DefaultSingle-J,,0,0,0,,		阿知波不動産の裏の部分を一手に引き受けてきた  切れもんらしいが	
Dialogue: 1,0:09:50.11,0:09:52.36,DefaultSingle-J,,0,0,0,,		今は秘書を辞めて  どこにおるんやら	
Dialogue: 1,0:09:52.40,0:09:56.08,DefaultSingle-J,,0,0,0,,		ちょっと服部君  そんな根も葉もないこと言うんはやめて	
Dialogue: 1,0:09:56.37,0:09:58.37,DefaultSingle-J,,0,0,0,,		皐月会の会長に裏なんてあらへん	
Dialogue: 1,0:09:58.37,0:09:59.45,DefaultSingle-J,,0,0,0,,		そうや  平次	
Dialogue: 1,0:09:59.45,0:10:01.79,DefaultSingle-J,,0,0,0,,		まあまあ  そうゆ  ウワサや  ウワサ	
Dialogue: 1,0:10:01.96,0:10:03.25,DefaultSingle-J,,0,0,0,,		会長  入ります	
Dialogue: 1,0:10:03.75,0:10:05.84,DefaultSingle-J,,0,0,0,,		阿知波会長や  あいさつせな	
Dialogue: 1,0:10:06.46,0:10:09.34,DefaultSingle-J,,0,0,0,,		会長  本日はよろしくお願いいたします	
Dialogue: 1,0:10:09.46,0:10:11.88,DefaultSingle-J,,0,0,0,,		ああ  こちらこそ  よろしく頼むで	
Dialogue: 1,0:10:11.88,0:10:12.47,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,0:10:12.68,0:10:17.05,DefaultSingle-J,,0,0,0,,		確か今日は矢島君と紅葉君による  デモンストレーションと	
Dialogue: 1,0:10:17.05,0:10:18.76,DefaultSingle-J,,0,0,0,,		あとは対談やったかな	
Dialogue: 1,0:10:18.76,0:10:20.64,DefaultSingle-J,,0,0,0,,		ええ  オンエア時には	
Dialogue: 1,0:10:20.64,0:10:23.85,DefaultSingle-J,,0,0,0,,		先週  矢島さんのご協力で収録させていただいた	
Dialogue: 1,0:10:24.02,0:10:26.36,DefaultSingle-J,,0,0,0,,		皐月会のカルタ特集も入れ込んで	
Dialogue: 1,0:10:26.52,0:10:29.86,DefaultSingle-J,,0,0,0,,		全国にカルタの魅力をアピールさせていただきます	
Dialogue: 1,0:10:29.94,0:10:33.32,DefaultSingle-J,,0,0,0,,		おお  すでに皐月会のカルタも展示してあるか	
Dialogue: 1,0:10:33.57,0:10:35.16,DefaultSingle-J,,0,0,0,,		では  しっかり頼むで	
Dialogue: 1,0:10:35.16,0:10:35.74,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 1,0:10:35.87,0:10:37.66,DefaultSingle-J,,0,0,0,,		すごい貫禄やな	
Dialogue: 1,0:10:37.66,0:10:40.45,DefaultSingle-J,,0,0,0,,		ああ  さすが浪花の不動産王や	
Dialogue: 1,0:10:40.45,0:10:43.66,DefaultSingle-J,,0,0,0,,		すいません  どなたか矢島さんに連絡取れませんか	
Dialogue: 1,0:10:44.04,0:10:46.42,DefaultSingle-J,,0,0,0,,		そろそろ入っていただかな  あかん時間なんですけど	
Dialogue: 1,0:10:46.50,0:10:48.46,DefaultSingle-J,,0,0,0,,		全然  連絡が取れへんのです	
Dialogue: 1,0:10:48.71,0:10:49.96,DefaultSingle-J,,0,0,0,,		おかしいですね	
Dialogue: 1,0:10:50.21,0:10:53.26,DefaultSingle-J,,0,0,0,,		本番１時間前には入ると  おっしゃってたんですが	
Dialogue: 1,0:10:53.34,0:10:56.26,DefaultSingle-J,,0,0,0,,		あの几帳面な矢島君が遅刻とは	
Dialogue: 1,0:10:56.51,0:10:59.18,DefaultSingle-J,,0,0,0,,		念のため  関根君にも来るように言っといてくれ	
Dialogue: 1,0:10:59.43,0:11:02.73,DefaultSingle-J,,0,0,0,,		万が一の時は  彼に代役を頼むとするか	
Dialogue: 1,0:11:20.12,0:11:21.37,DefaultSingle-J,,0,0,0,,		ま  まさか	
Dialogue: 1,0:11:22.33,0:11:24.37,DefaultSingle-J,,0,0,0,,		撮影まで  時間  空いちゃったね	
Dialogue: 1,0:11:24.50,0:11:25.25,DefaultSingle-J,,0,0,0,,		だね	
Dialogue: 1,0:11:25.54,0:11:27.75,DefaultSingle-J,,0,0,0,,		なあ  平次  どこのお好み焼き行く	
Dialogue: 1,0:11:25.66,0:11:26.75,DefaultSingle-J,,0,0,0,,		よかったね	
Dialogue: 1,0:11:26.92,0:11:28.88,DefaultSingle-J,,0,0,0,,		待ってた甲斐が  ありましたよ	
Dialogue: 1,0:11:28.92,0:11:30.46,DefaultSingle-J,,0,0,0,,		こりゃどこの店に行くんだぞ	
Dialogue: 1,0:11:28.25,0:11:30.54,DefaultSingle-J,,0,0,0,,		そら  お好み焼き言うたら  あそこやろ	
Dialogue: 1,0:11:30.54,0:11:32.76,DefaultSingle-J,,0,0,0,,		そやな  やっぱ  お好み焼き言うたら	
Dialogue: 1,0:11:35.26,0:11:37.01,DefaultSingle-J,,0,0,0,,		すみません  大丈夫ですか	
Dialogue: 1,0:11:38.84,0:11:40.85,DefaultSingle-J,,0,0,0,,		あんた  さっき  カルタやっとった	
Dialogue: 1,0:11:41.47,0:11:42.43,DefaultSingle-J,,0,0,0,,		運命よ	
Dialogue: 1,0:11:45.73,0:11:46.19,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:11:46.89,0:11:49.02,DefaultSingle-J,,0,0,0,,		会えるんやないかと  思てました	
Dialogue: 1,0:11:49.10,0:11:49.65,DefaultSingle-J,,0,0,0,,		えっ	
Dialogue: 1,0:11:50.44,0:11:52.36,DefaultSingle-J,,0,0,0,,		ウチの未来の旦那さんに	
Dialogue: 1,0:11:52.69,0:11:53.48,DefaultSingle-J,,0,0,0,,		未来の…	
Dialogue: 1,0:11:53.57,0:11:54.40,DefaultSingle-J,,0,0,0,,		旦那さん！？	
Dialogue: 1,0:11:54.82,0:11:55.95,DefaultSingle-J,,0,0,0,,		ええっ	
Dialogue: 1,0:11:56.20,0:11:59.37,DefaultSingle-J,,0,0,0,,		ウチ  このあと収録が終わったらヒマなんです	
Dialogue: 1,0:11:59.95,0:12:02.12,DefaultSingle-J,,0,0,0,,		よかったら  その後お茶でも飲みません	
Dialogue: 1,0:11:59.62,0:12:02.66,DefaultSingle-J,,0,0,0,,		うわっ  このねーちゃん  乳デカッ	
Dialogue: 1,0:12:02.83,0:12:04.62,DefaultSingle-J,,0,0,0,,		ちょっ  ちょ  あんた  何を	
Dialogue: 1,0:12:04.62,0:12:05.45,DefaultSingle-J,,0,0,0,,		いやいや  ちょっ  ちょっ	
Dialogue: 1,0:12:05.45,0:12:06.41,DefaultSingle-J,,0,0,0,,		紅葉さん	
Dialogue: 1,0:12:06.83,0:12:09.58,DefaultSingle-J,,0,0,0,,		すみませんけど  一度  控室にもどってください	
Dialogue: 1,0:12:09.58,0:12:11.92,DefaultSingle-J,,0,0,0,,		あら  今ええとこやったのに	
Dialogue: 1,0:12:12.34,0:12:14.96,DefaultSingle-J,,0,0,0,,		実は矢島さんの到着が遅れてまして	
Dialogue: 1,0:12:15.26,0:12:16.22,DefaultSingle-J,,0,0,0,,		矢島さんが	
Dialogue: 1,0:12:17.05,0:12:19.84,DefaultSingle-J,,0,0,0,,		まあ  この番組を企画したご本人やし	
Dialogue: 1,0:12:20.26,0:12:21.93,DefaultSingle-J,,0,0,0,,		いろいろ忙しんでしょうな	
Dialogue: 1,0:12:22.68,0:12:24.72,DefaultSingle-J,,0,0,0,,		ほんなら平次君  またあとで	
Dialogue: 1,0:12:24.97,0:12:26.35,DefaultSingle-J,,0,0,0,,		ああ  ほなな	
Dialogue: 1,0:12:27.35,0:12:29.48,DefaultSingle-J,,0,0,0,,		だれやねん  あの女	
Dialogue: 1,0:12:29.48,0:12:31.15,DefaultSingle-J,,0,0,0,,		さっきのキレイな姉ちゃん	
Dialogue: 1,0:12:31.15,0:12:32.44,DefaultSingle-J,,0,0,0,,		やっぱ美人さんだね	
Dialogue: 1,0:12:32.44,0:12:34.19,DefaultSingle-J,,0,0,0,,		確か紅葉さんって言ってたな	
Dialogue: 1,0:12:34.19,0:12:36.53,DefaultSingle-J,,0,0,0,,		だから  知らん言うてるやないか	
Dialogue: 1,0:12:36.53,0:12:38.74,DefaultSingle-J,,0,0,0,,		平次って名前知っとったやん	
Dialogue: 1,0:12:38.95,0:12:40.53,DefaultSingle-J,,0,0,0,,		だから平次  白状し	
Dialogue: 1,0:12:38.86,0:12:41.62,DefaultSingle-J,,0,0,0,,		蘭お姉さん  先に外で待ってよ	
Dialogue: 1,0:12:40.61,0:12:42.57,DefaultSingle-J,,0,0,0,,		でも  お前もすでに怒ってるやないか	
Dialogue: 1,0:12:41.91,0:12:43.78,DefaultSingle-J,,0,0,0,,		なんかモメてるみたいですし	
Dialogue: 1,0:12:42.70,0:12:43.70,DefaultSingle-J,,0,0,0,,		怒っとらんわ	
Dialogue: 1,0:12:43.83,0:12:44.49,DefaultSingle-J,,0,0,0,,		行こ行こ	
Dialogue: 1,0:12:44.58,0:12:47.62,DefaultSingle-J,,0,0,0,,		知らんはずないやろ  あんな仲よさそうやったやん	
Dialogue: 1,0:12:45.12,0:12:47.04,DefaultSingle-J,,0,0,0,,		何  怒ってんだ  姉ちゃん	
Dialogue: 1,0:12:47.79,0:12:51.25,DefaultSingle-J,,0,0,0,,		そっ  それは  どっかで  会うてたからやろなあ	
Dialogue: 1,0:12:51.38,0:12:54.46,DefaultSingle-J,,0,0,0,,		ほら  見てみぃ  やっぱり知っとんのや	
Dialogue: 1,0:12:54.46,0:12:55.84,DefaultSingle-J,,0,0,0,,		知らん言うてるやないか	
Dialogue: 1,0:12:56.09,0:12:57.38,DefaultSingle-J,,0,0,0,,		大体  あんなキレイな人	
Dialogue: 1,0:12:57.38,0:12:59.68,DefaultSingle-J,,0,0,0,,		一度見たら  忘れられるわけないやろ	
Dialogue: 1,0:12:59.97,0:13:01.76,DefaultSingle-J,,0,0,0,,		あんなキレイな人	
Dialogue: 1,0:13:02.05,0:13:04.81,DefaultSingle-J,,0,0,0,,		まあ  お前は別の意味で  忘れられへんけどな	
Dialogue: 1,0:13:05.18,0:13:06.06,DefaultSingle-J,,0,0,0,,		はあ	
Dialogue: 1,0:13:06.22,0:13:07.81,DefaultSingle-J,,0,0,0,,		なんそれ  どういう意味なん	
Dialogue: 1,0:13:07.85,0:13:11.94,DefaultSingle-J,,0,0,0,,		ねえねえ  平次兄ちゃん  ほんとにこの人知らないの	
Dialogue: 1,0:13:12.27,0:13:14.02,DefaultSingle-J,,0,0,0,,		大岡  紅葉	
Dialogue: 1,0:13:14.52,0:13:20.49,DefaultSingle-J,,0,0,0,,		２年連続皐月杯高校生チャンピオン  京都泉心高校の２年生	
Dialogue: 1,0:13:20.70,0:13:23.87,DefaultSingle-J,,0,0,0,,		将来  クイーンになることが  確実視されている	
Dialogue: 1,0:13:24.33,0:13:25.66,DefaultSingle-J,,0,0,0,,		大岡紅葉？	
Dialogue: 1,0:13:26.08,0:13:27.49,DefaultSingle-J,,0,0,0,,		未来のクイーンか	
Dialogue: 1,0:13:28.70,0:13:31.29,DefaultSingle-J,,0,0,0,,		これがその予告っちゅうわけか	
Dialogue: 1,0:13:31.50,0:13:34.84,DefaultSingle-J,,0,0,0,,		はい  日売テレビを爆破するとだけ	
Dialogue: 1,0:13:35.00,0:13:37.00,DefaultSingle-J,,0,0,0,,		このカルタの写真はなんや	
Dialogue: 1,0:13:37.21,0:13:42.47,DefaultSingle-J,,0,0,0,,		メールに添付されていた写真です  何を意味してるかはまだ分かりません	
Dialogue: 1,0:13:42.76,0:13:45.85,DefaultSingle-J,,0,0,0,,		で  日売テレビはこのことを知っとるんか	
Dialogue: 1,0:13:45.93,0:13:48.14,DefaultSingle-J,,0,0,0,,		注意喚起はしましたけど	
Dialogue: 1,0:13:48.22,0:13:49.64,DefaultSingle-J,,0,0,0,,		どない思う  平蔵	
Dialogue: 1,0:13:49.98,0:13:53.19,DefaultSingle-J,,0,0,0,,		単なるイタズラか  本物の爆破予告か	
Dialogue: 1,0:13:53.65,0:13:56.23,DefaultSingle-J,,0,0,0,,		このメールだけでは  判断つかんが	
Dialogue: 1,0:13:56.69,0:13:59.23,DefaultSingle-J,,0,0,0,,		イタズラやなかったら  大ごとやぞ	
Dialogue: 1,0:14:01.32,0:14:05.03,DefaultSingle-J,,0,0,0,,		先ほど  大阪府警より緊急避難警告が発令されました	
Dialogue: 1,0:14:06.33,0:14:08.16,DefaultSingle-J,,0,0,0,,		なんやの  この放送	
Dialogue: 1,0:14:05.49,0:14:07.91,DefaultSingle-J,,0,0,0,,		各種作業や収録を一時中断し	
Dialogue: 1,0:14:08.29,0:14:10.54,DefaultSingle-J,,0,0,0,,		近くの非常階段から退避してください	
Dialogue: 1,0:14:10.75,0:14:13.54,DefaultSingle-J,,0,0,0,,		なんだ  今度は避難訓練かよ	
Dialogue: 1,0:14:11.37,0:14:16.79,DefaultSingle-J,,0,0,0,,		繰り返します  先ほど  大阪府警より緊急避難警告が発令されました	
Dialogue: 1,0:14:13.79,0:14:15.38,DefaultSingle-J,,0,0,0,,		なんか始まんのか	
Dialogue: 1,0:14:15.38,0:14:16.79,DefaultSingle-J,,0,0,0,,		「警察」って言ってるね	
Dialogue: 1,0:14:16.79,0:14:18.71,DefaultSingle-J,,0,0,0,,		テレビの収録してるんですかねえ	
Dialogue: 1,0:14:17.54,0:14:19.92,DefaultSingle-J,,0,0,0,,		各種作業や収録を一時中断し	
Dialogue: 1,0:14:20.71,0:14:22.93,DefaultSingle-J,,0,0,0,,		近くの非常階段から退避してください	
Dialogue: 1,0:14:23.93,0:14:25.43,DefaultSingle-J,,0,0,0,,		おい  ちょっと調べてこい	
Dialogue: 1,0:14:24.01,0:14:28.93,DefaultSingle-J,,0,0,0,,		繰り返します  先ほど  大阪府警より緊急避難警告が発令されました	
Dialogue: 1,0:14:25.51,0:14:26.51,DefaultSingle-J,,0,0,0,,		あ  はい	
Dialogue: 1,0:14:27.43,0:14:28.97,DefaultSingle-J,,0,0,0,,		何が起きてるんや	
Dialogue: 1,0:14:32.39,0:14:35.35,DefaultSingle-J,,0,0,0,,		和葉  すぐに非常階段に向かうんや  ええな	
Dialogue: 1,0:14:35.73,0:14:37.11,DefaultSingle-J,,0,0,0,,		ええっ  平次は	
Dialogue: 1,0:14:37.19,0:14:39.07,DefaultSingle-J,,0,0,0,,		何が起こったのか確認せな	
Dialogue: 1,0:14:39.32,0:14:40.82,DefaultSingle-J,,0,0,0,,		お前は先に  ここを出るんや	
Dialogue: 1,0:14:41.24,0:14:42.65,DefaultSingle-J,,0,0,0,,		ちょっ  平次	
Dialogue: 1,0:14:43.03,0:14:44.41,DefaultSingle-J,,0,0,0,,		もお～っ	
Dialogue: 1,0:14:46.87,0:14:47.53,DefaultSingle-J,,0,0,0,,		危ないな	
Dialogue: 1,0:14:48.16,0:14:51.25,DefaultSingle-J,,0,0,0,,		こーら  小僧  どこ行くつもりだ	
Dialogue: 1,0:14:51.37,0:14:53.12,DefaultSingle-J,,0,0,0,,		スタジオに忘れ物しちゃって	
Dialogue: 1,0:14:53.37,0:14:56.50,DefaultSingle-J,,0,0,0,,		バーロー  今のアナウンスが聞こえなかったのか	
Dialogue: 1,0:14:56.50,0:14:56.96,DefaultSingle-J,,0,0,0,,		もお～	
Dialogue: 1,0:14:57.21,0:14:57.96,DefaultSingle-J,,0,0,0,,		すみません	
Dialogue: 1,0:14:58.84,0:15:00.38,DefaultSingle-J,,0,0,0,,		こんなことボクも初めてで	
Dialogue: 1,0:15:00.59,0:15:03.05,DefaultSingle-J,,0,0,0,,		ウチかて  着物で避難訓練なんか初めてやわ	
Dialogue: 1,0:15:05.93,0:15:07.85,DefaultSingle-J,,0,0,0,,		大変です  すぐに避難しましょう	
Dialogue: 1,0:15:07.93,0:15:09.60,DefaultSingle-J,,0,0,0,,		落ち着け  何があった	
Dialogue: 1,0:15:09.60,0:15:11.85,DefaultSingle-J,,0,0,0,,		ここを爆破すると脅迫があったそうです	
Dialogue: 1,0:15:11.85,0:15:13.31,DefaultSingle-J,,0,0,0,,		何  阿知波会長	
Dialogue: 1,0:15:13.56,0:15:17.40,DefaultSingle-J,,0,0,0,,		ガセかもしれませんが  安全が確認できるまで  一時  退避しましょう	
Dialogue: 1,0:15:17.60,0:15:18.65,DefaultSingle-J,,0,0,0,,		ああ  せやな	
Dialogue: 1,0:15:19.40,0:15:21.86,DefaultSingle-J,,0,0,0,,		みんな  アナウンスに従って外に出るんや	
Dialogue: 1,0:15:22.11,0:15:22.94,DefaultSingle-J,,0,0,0,,		さあ  はよう	
Dialogue: 1,0:15:22.94,0:15:23.78,DefaultSingle-J,,0,0,0,,		は  はい	
Dialogue: 1,0:15:27.20,0:15:28.82,DefaultSingle-J,,0,0,0,,		何をしてるんや  未来子君	
Dialogue: 1,0:15:29.49,0:15:31.37,DefaultSingle-J,,0,0,0,,		ここは危険や  はよ行くで	
Dialogue: 1,0:15:31.66,0:15:32.83,DefaultSingle-J,,0,0,0,,		さあ  阿知波さんも	
Dialogue: 1,0:15:33.25,0:15:34.58,DefaultSingle-J,,0,0,0,,		何してんねん  はよ出な	
Dialogue: 1,0:15:35.83,0:15:38.67,DefaultSingle-J,,0,0,0,,		みなさん  落ち着いて行動してください	
Dialogue: 1,0:15:39.25,0:15:41.42,DefaultSingle-J,,0,0,0,,		なんでもありません  大丈夫ですよ	
Dialogue: 1,0:15:42.13,0:15:44.76,DefaultSingle-J,,0,0,0,,		守らない物の安全も  確認続けまいります	
Dialogue: 1,0:15:41.17,0:15:43.67,DefaultSingle-J,,0,0,0,,		みんな  動き回らないで  ここで待ってようね	
Dialogue: 1,0:15:44.30,0:15:46.47,DefaultSingle-J,,0,0,0,,		なんだよ  また待つのかよ	
Dialogue: 1,0:15:47.26,0:15:49.05,DefaultSingle-J,,0,0,0,,		結局外に出てきたのに	
Dialogue: 1,0:15:46.55,0:15:47.93,DefaultSingle-J,,0,0,0,,		やっぱり  つながらない	
Dialogue: 1,0:15:48.34,0:15:51.22,DefaultSingle-J,,0,0,0,,		お父さん  置いてきちゃったけど  大丈夫かな	
Dialogue: 1,0:15:49.60,0:15:51.43,DefaultSingle-J,,0,0,0,,		な  何をやってんですかな	
Dialogue: 1,0:15:51.85,0:15:52.68,DefaultSingle-J,,0,0,0,,		蘭	
Dialogue: 1,0:15:53.14,0:15:54.68,DefaultSingle-J,,0,0,0,,		お父さん  コナン君	
Dialogue: 1,0:15:55.10,0:15:58.02,DefaultSingle-J,,0,0,0,,		おいおい  こりゃ一体  何事だ	
Dialogue: 1,0:15:58.56,0:16:01.77,DefaultSingle-J,,0,0,0,,		まさか予告なしの避難訓練か何かか	
Dialogue: 1,0:15:59.19,0:16:00.15,DefaultSingle-J,,0,0,0,,		おい  コナン	
Dialogue: 1,0:16:02.69,0:16:04.44,DefaultSingle-J,,0,0,0,,		逸れちゃったかと思いましたよ	
Dialogue: 1,0:16:04.44,0:16:05.19,DefaultSingle-J,,0,0,0,,		ああ  おお	
Dialogue: 1,0:16:06.11,0:16:07.57,DefaultSingle-J,,0,0,0,,		どうしたんだ  コナン君	
Dialogue: 1,0:16:02.07,0:16:05.15,DefaultSingle-J,,0,0,0,,		ううん  さっきテレビ局の人に聞いたら	
Dialogue: 1,0:16:05.65,0:16:07.65,DefaultSingle-J,,0,0,0,,		このビルに爆破予告があったんだって	
Dialogue: 1,0:16:08.36,0:16:09.82,DefaultSingle-J,,0,0,0,,		ほんとかよ  おい	
Dialogue: 1,0:16:09.91,0:16:12.08,DefaultSingle-J,,0,0,0,,		ところで  和葉ちゃんと服部君は	
Dialogue: 1,0:16:12.41,0:16:15.00,DefaultSingle-J,,0,0,0,,		なんだ  お前たちと一緒じゃなかったのか	
