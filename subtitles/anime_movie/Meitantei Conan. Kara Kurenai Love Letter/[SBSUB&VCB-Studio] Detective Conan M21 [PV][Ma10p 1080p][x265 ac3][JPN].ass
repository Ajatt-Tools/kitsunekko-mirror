Dialogue: 0,0:00:02.49,0:00:07.50,Default,,0,0,0,,	{\a6}	{\rDefault-JP} 	瀬をはやみ　岩にせかるる　滝川の
Dialogue: 0,0:00:08.81,0:00:12.12,Default,,0,0,0,,	{\a6}	{\rDefault-JP} 	われても末に　あはむとぞ思ふ
Dialogue: 0,0:00:20.40,0:00:22.24,Default,,0,0,0,,		{\rDefault-JP} 	二つの事件には繋がりが
Dialogue: 0,0:00:22.80,0:00:24.78,Default,,0,0,0,,		{\rDefault-JP} 	百人一首に仕掛けられた
Dialogue: 0,0:00:25.37,0:00:27.32,Default,,0,0,0,,		{\rDefault-JP} 	複雑に絡み合っていく謎
Dialogue: 0,0:00:28.68,0:00:31.00,Default,,0,0,0,,		{\rDefault-JP} 	これはまだ　始まりに過ぎないわ
Dialogue: 0,0:00:31.63,0:00:32.80,Default,,0,0,0,,		{\rDefault-JP} 	やっと会えた
Dialogue: 0,0:00:33.67,0:00:34.37,Default,,0,0,0,,		{\rDefault-JP} 	未来の
Dialogue: 0,0:00:35.10,0:00:36.16,Default,,0,0,0,,		{\rDefault-JP} 	旦那さんに
Dialogue: 0,0:00:36.46,0:00:37.32,Default,,0,0,0,,		{\rDefault-JP} 	旦那さん？
Dialogue: 0,0:00:38.12,0:00:41.42,Default,,0,0,0,,		{\rDefault-JP} 	服部の前に現れた謎の女の目的とは
Dialogue: 0,0:00:41.64,0:00:44.38,Default,,0,0,0,,	{\pos(959,1082)}	{\rDefault-JP} 	幼馴染の恋愛ごっこもこれで終わり
Dialogue: 0,0:00:44.72,0:00:47.20,Default,,0,0,0,,	{\pos(959,1082)}	{\rDefault-JP} 	平次君はうちの婚約者です
Dialogue: 0,0:00:48.36,0:00:51.62,Default,,0,0,0,,		{\rDefault-JP} 	悪いな工藤　どうしても行かねぇとあかねぇや
Dialogue: 0,0:00:52.52,0:00:53.60,Default,,0,0,0,,		{\rDefault-JP} 	まさか　服部
Dialogue: 0,0:00:55.89,0:00:58.92,Default,,0,0,0,,		{\rDefault-JP} 	今動き出す　2人の運命
Dialogue: 0,0:01:00.02,0:01:03.04,Default,,0,0,0,,		{\rDefault-JP} 	あの子のこと　守らんとあかないやろう
Dialogue: 0,0:01:03.38,0:01:04.56,Default,,0,0,0,,		{\rDefault-JP} 	和葉が危ない
Dialogue: 0,0:01:06.66,0:01:10.59,Default,,0,0,0,,		{\rDefault-JP} 	古の歌に隠された真実が　千年の時を越え
Dialogue: 0,0:01:11.24,0:01:12.60,Default,,0,0,0,,		{\rDefault-JP} 	今　あばかれる
Dialogue: 0,0:01:12.78,0:01:13.96,Default,,0,0,0,,		{\rDefault-JP} 	チャンスは一度だけや
Dialogue: 0,0:01:14.98,0:01:15.50,Default,,0,0,0,,		{\rDefault-JP} 	ああ
Dialogue: 0,0:01:16.42,0:01:17.28,Default,,0,0,0,,		{\rDefault-JP} 	待っとれ和葉
Dialogue: 0,0:01:17.43,0:01:18.22,Default,,0,0,0,,		{\rDefault-JP} 	お前だけは
Dialogue: 0,0:01:18.52,0:01:20.13,Default,,0,0,0,,		{\rDefault-JP} 	死んでも守ったる
Dialogue: 0,0:01:20.97,0:01:22.72,Default,,0,0,0,,		{\rDefault-JP} 	劇場版名探偵コナン
Dialogue: 0,0:01:22.94,0:01:24.37,Default,,0,0,0,,		{\rDefault-JP} 	から紅の恋歌
Dialogue: 0,0:01:25.22,0:01:26.25,Default,,0,0,0,,		{\rDefault-JP} 	こんなとこで
Dialogue: 0,0:01:27.24,0:01:30.22,Default,,0,0,0,,		{\rDefault-JP} 	死なせるわけには行かねぇんだよ
