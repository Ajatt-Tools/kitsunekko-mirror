1
00:00:20,521 --> 00:00:24,233
(みみせんせい)
みなさーん アロハ～！

2
00:00:24,316 --> 00:00:26,610
(みんな) アロハ～！

3
00:00:27,027 --> 00:00:30,364
(みみ) ゆうやけの
サマーコンサートへ ようこそ

4
00:00:30,448 --> 00:00:34,243
さっそく うたと おどりのゲストを
おまねきしましょう

5
00:00:34,326 --> 00:00:35,369
どうぞ！

6
00:00:35,870 --> 00:00:37,621
(シドロ) シドロでーす

7
00:00:38,122 --> 00:00:39,874
(モドロ) モドロでーす

8
00:00:39,957 --> 00:00:44,128
(シドロ･モドロ) ふたりあわせて
シドロ アンド モドロで～す♪

9
00:00:44,587 --> 00:00:47,923
さいしょの きょくは
｢アンパンマンたいそう｣

10
00:00:48,007 --> 00:00:50,885
みなさん げんきに
てびょうし あしびょうし

11
00:00:51,427 --> 00:00:53,888
(シドロ･モドロ)
よろしくおねがいしまーす！

12
00:00:54,930 --> 00:01:01,937
♪～

13
00:01:09,195 --> 00:01:13,282
(みんな) アンパンマーン！

14
00:02:35,406 --> 00:02:42,413
～♪

15
00:02:43,956 --> 00:02:46,625
みなさん とってもステキでした

16
00:02:46,709 --> 00:02:48,627
それでは つぎのきょく

17
00:02:48,711 --> 00:02:51,797
(コキンちゃん) アロハ～！
(３にん) うん？

18
00:02:52,673 --> 00:02:55,301
(コキン) イエーイ！

19
00:02:55,384 --> 00:02:57,678
(コキン) のってるか～い？

20
00:02:59,805 --> 00:03:02,975
コキンちゃんだよー！ アハッ

21
00:03:03,058 --> 00:03:06,103
(みんな) ううっ　わあああ！

22
00:03:06,979 --> 00:03:10,608
つぎのきょくは
｢あおいなみだ｣でーす！

23
00:03:10,691 --> 00:03:14,403
(あしびょうし)

24
00:03:14,486 --> 00:03:21,493
♪～

25
00:04:30,813 --> 00:04:33,440
(コキン) あ～
ドキンおねえちゃんの いじわる！

26
00:04:33,524 --> 00:04:35,526
(みんなの なきごえ)

27
00:04:35,609 --> 00:04:42,074
～♪

28
00:04:42,157 --> 00:04:43,200
てへっ！

29
00:04:44,743 --> 00:04:48,122
(みみ) アハッ
コキンちゃん ありがとう

30
00:04:48,205 --> 00:04:49,957
それでは つぎのきょく

31
00:04:50,249 --> 00:04:52,459
(クリームパンダ)
クリームパンダでーす

32
00:04:52,793 --> 00:04:54,712
(メロンパンナ)
メロンパンナでーす

33
00:04:54,920 --> 00:04:58,382
(ふたり) つぎのきょくは
チーズが うたいまーす！

34
00:04:58,465 --> 00:05:00,634
(かんきゃくの かんせい)
(チーズ) アン！

35
00:05:01,051 --> 00:05:03,220
(ばいきんまん) ハヒフヘホ～！

36
00:05:03,303 --> 00:05:04,221
(みんな) うん？

37
00:05:06,306 --> 00:05:09,768
(みんなの ひめい)

38
00:05:09,852 --> 00:05:12,229
(ばいきんまん) アロハ～！

39
00:05:13,439 --> 00:05:14,898
(みんな) ばいきんまん！

40
00:05:14,982 --> 00:05:19,653
ここからは おれさまが
たっぷり もりあげてやるぞ！

41
00:05:19,737 --> 00:05:21,238
(バイキンロボの おたけび)

42
00:05:21,739 --> 00:05:25,951
(みんなの ひめい)

43
00:05:27,661 --> 00:05:30,164
(ドキンちゃん)
もう ばいきんまんったら！

44
00:05:30,247 --> 00:05:32,875
(コキン) イーッだ！
(ホラーマン) ホラ～

45
00:05:33,667 --> 00:05:35,127
みなさーん！

46
00:05:35,461 --> 00:05:38,380
こんなときは せーの！

47
00:05:38,756 --> 00:05:41,341
(みんな) アンパンマーン！

48
00:05:41,425 --> 00:05:45,387
(こだま) アンパンマーン！

49
00:05:45,471 --> 00:05:52,478
♪～

50
00:06:49,159 --> 00:06:56,166
～♪

51
00:07:00,504 --> 00:07:03,507
(しかい) おまたせしました
ついに とうじょう！

52
00:07:03,590 --> 00:07:08,053
せかいいちの へんしんめいじん
オバケのなかの オバケ！

53
00:07:08,137 --> 00:07:10,180
ドロリン！

54
00:07:10,264 --> 00:07:11,598
(かんせいと せいえん)

55
00:07:11,682 --> 00:07:14,852
(かんきゃくＡ) ドロリン！
(かんきゃくＢ) まってました！

56
00:07:16,436 --> 00:07:18,730
(ドロリン) バケバケール！

57
00:07:22,484 --> 00:07:23,902
(かんきゃくたち) おおー！

58
00:07:25,904 --> 00:07:27,906
(かんきゃくたち) おおー！
(かんきゃくＣ) カッコいい！

59
00:07:32,035 --> 00:07:33,662
(ひを はくおと)

60
00:07:33,745 --> 00:07:35,622
(かんせいと はくしゅ)
(かんきゃくＤ) いいぞー！

61
00:07:36,331 --> 00:07:37,749
(かんきゃくＥ) さいこう！

62
00:07:37,833 --> 00:07:39,459
(ドロリン) ウフフ

63
00:07:41,253 --> 00:07:42,796
うん？ あっ

64
00:07:43,046 --> 00:07:46,425
(おちる おと)
(ドロリン) うわああ～！

65
00:07:47,509 --> 00:07:48,844
うわっ！ うわ…

66
00:07:50,470 --> 00:07:52,723
んっ ゆめか…

67
00:07:53,348 --> 00:07:54,933
(はばたく おと)
(ドロリン) うん？

68
00:08:22,085 --> 00:08:25,130
(ことりの さえずり)

69
00:08:27,966 --> 00:08:29,968
(バタコさん)
“バケールカーニバル”？

70
00:08:30,302 --> 00:08:33,472
(ジャムおじさん) オバケタウンで
ひらかれる おまつりだよ

71
00:08:35,515 --> 00:08:36,850
(ジャム) バタコ

72
00:08:37,517 --> 00:08:39,478
(バタコ)
しょうたいじょうが とどいたの

73
00:08:40,103 --> 00:08:42,731
(アンパンマン) へえ～
とっても たのしみですね！

74
00:08:43,523 --> 00:08:45,442
(クリームパンダ)
ねえ ジャムおじさん

75
00:08:45,525 --> 00:08:47,694
オバケタウンってことはさ…

76
00:08:47,778 --> 00:08:50,239
(メロンパンナ)
オバケだらけの まちってこと？

77
00:08:50,447 --> 00:08:54,326
(オバケたちの わらいごえ)

78
00:08:54,993 --> 00:08:56,495
キャキャキャッ

79
00:08:56,578 --> 00:08:58,247
(メロンパンナたちの こわがるこえ)

80
00:08:58,330 --> 00:08:59,790
(バタコたちの わらいごえ)

81
00:08:59,873 --> 00:09:02,751
だいじょうぶ
いけば わかるよ

82
00:09:03,043 --> 00:09:04,294
(３にん) えっ？

83
00:09:05,462 --> 00:09:07,756
(かみなりの おと)

84
00:09:13,428 --> 00:09:16,890
(ドキン) ばいきんまん
たいくつ～

85
00:09:17,432 --> 00:09:19,810
おれさまも～

86
00:09:20,018 --> 00:09:22,646
(ホラーマン) とどきました ホラ～

87
00:09:23,355 --> 00:09:24,898
(ドキン) なによ ホラーマン

88
00:09:24,982 --> 00:09:27,317
ずいぶん ごきげんじゃない？

89
00:09:27,401 --> 00:09:31,905
(ホラーマン) そりゃ そうですよ
いよいよ はじまりますからね

90
00:09:31,989 --> 00:09:34,908
まちにまった
“バケールカーニバル”が！

91
00:09:34,992 --> 00:09:36,910
ん～まっ！

92
00:09:37,536 --> 00:09:39,913
(ふたり) バケールカーニバル？

93
00:09:43,959 --> 00:09:45,919
(クリームパンダ)
オバケの まちか…

94
00:09:46,545 --> 00:09:48,505
(メロンパンナ)
ほんとに だいじょうぶかな…

95
00:09:48,588 --> 00:09:49,923
(チーズ) アン～

96
00:09:50,007 --> 00:09:52,134
それじゃあ いくよ

97
00:09:52,342 --> 00:09:53,427
せーの！

98
00:09:53,510 --> 00:09:55,679
(３にん) びっくり どっきり！

99
00:09:55,762 --> 00:09:57,681
(クリームパンダたち)
バケバケール！

100
00:10:07,524 --> 00:10:09,818
(３にん) わあ～

101
00:10:22,080 --> 00:10:22,914
(クリームパンダたち) ウフフ

102
00:10:22,998 --> 00:10:24,499
(しょくぱんまん) こんにちは！
(クリームパンダたち) うん？

103
00:10:25,000 --> 00:10:27,502
(クリームパンダたち)
しょくぱんまん！ カレーパンマン！

104
00:10:27,794 --> 00:10:30,505
(しょくぱんまん) たのしみですね
バケールカーニバル

105
00:10:30,589 --> 00:10:33,175
(カレーパンマン) にぎやかな
おまつりに なりそうだな

106
00:10:33,258 --> 00:10:34,092
(はなびの おと)

107
00:10:34,176 --> 00:10:35,677
(きゃくたち) おおー！
(きゃくＡ) あっ みて！

108
00:10:35,761 --> 00:10:36,762
(ふたり) おっ？

109
00:10:36,845 --> 00:10:41,767
(かんせいと はなびのおと)

110
00:10:53,862 --> 00:10:54,905
(バタコたち) わあ～

111
00:10:54,988 --> 00:10:55,864
(クリームパンダ) ここが

112
00:10:55,947 --> 00:10:57,199
(メロンパンナ) オバケタウン

113
00:10:57,282 --> 00:10:59,284
(ちびぞうくんたち) おーい！
(メロンパンナ) あっ

114
00:10:59,910 --> 00:11:01,286
(クリームパンダ) みんな！

115
00:11:01,953 --> 00:11:03,246
(カレーパンマン) こりゃ～

116
00:11:03,330 --> 00:11:04,664
(しょくぱんまん)
とってもステキです

117
00:11:04,748 --> 00:11:07,584
(ホラーマン)
ワクワクしますね ホラ～

118
00:11:07,667 --> 00:11:09,419
(しょくぱんまん)
うん？ ホラーマン

119
00:11:11,671 --> 00:11:14,257
(ホラーマン) ばいきちくんと
ドキこちゃんも いまーす

120
00:11:14,341 --> 00:11:15,175
(ばいきんまん) ふんっ

121
00:11:15,926 --> 00:11:18,929
(ドキン) はーい
しょくぱんまんさま～

122
00:11:19,012 --> 00:11:20,931
(しょくぱんまん)
ああ… こんにちは

123
00:11:21,390 --> 00:11:24,059
(アナウンス)
ようこそ オバケタウンへ！

124
00:11:24,142 --> 00:11:27,854
へんしんじまんの オバケたちが
みなさんを おまちです！

125
00:11:27,938 --> 00:11:30,941
バケールカーニバルは
もうすぐ スタート！

126
00:11:31,316 --> 00:11:32,859
(きゃくＢ)
いよいよ はじまるわね！

127
00:11:32,943 --> 00:11:35,654
(きゃくＣ)
ずっと たのしみにしてたんだ

128
00:11:36,321 --> 00:11:37,948
がんばるぞー！

129
00:11:38,031 --> 00:11:39,950
(オバケたち) おー！

130
00:11:40,575 --> 00:11:43,995
(こどもオバケＡ)
いくよー バケバケール！

131
00:11:45,205 --> 00:11:47,207
(チューバの おと)

132
00:11:47,290 --> 00:11:49,209
(はくしゅ)
(こどもオバケたち) わあ～！

133
00:11:51,002 --> 00:11:53,213
(こどもオバケＡ)
ヘヘッ ざっとこんなもんさ

134
00:11:56,299 --> 00:11:58,718
ん？ うわああ～！

135
00:11:59,177 --> 00:12:00,429
だあっ

136
00:12:00,512 --> 00:12:05,100
(ドロリン) アーハッハッ
おどろいてやんの はずかしい！

137
00:12:05,183 --> 00:12:06,226
(こどもオバケたち) ドロリン！

138
00:12:06,518 --> 00:12:08,895
(こどもオバケＡ) うう…
へんしんの れんしゅうちゅうだぞ！

139
00:12:08,979 --> 00:12:10,355
じゃま するなよ！

140
00:12:10,439 --> 00:12:11,565
(ドロリン) ヘヘ～ン

141
00:12:11,648 --> 00:12:13,608
たいしたことないのに
いばってたから――

142
00:12:13,692 --> 00:12:14,860
からかっただけさ

143
00:12:14,943 --> 00:12:16,194
(こどもオバケＡ) なんだと？

144
00:12:16,278 --> 00:12:17,487
そういうドロリンは――

145
00:12:17,571 --> 00:12:20,240
ちゃんと へんしん
できるように なったのかよ！

146
00:12:21,450 --> 00:12:23,618
そ… そんなの
あたりまえじゃん！

147
00:12:23,702 --> 00:12:24,995
(こどもオバケたち) えー？

148
00:12:25,787 --> 00:12:28,248
(こどもオバケＢ) すごーい！
(こどもオバケＣ) みせて みせて！

149
00:12:28,331 --> 00:12:30,041
(ドロリン) ダ… ダメ ダメ

150
00:12:30,125 --> 00:12:33,003
カーニバルの ほんばんまでの
おたのしみだ！

151
00:12:33,086 --> 00:12:36,590
(こどもオバケＡ) ふ～ん
また そうやって ごまかすんだ

152
00:12:36,673 --> 00:12:38,008
(ドロリン) なに！

153
00:12:38,091 --> 00:12:40,343
よーし みてろ！

154
00:12:40,427 --> 00:12:44,014
はっ ほっ たああっ！

155
00:12:44,097 --> 00:12:46,016
バケバケール！

156
00:12:49,352 --> 00:12:51,104
(ドロリン) あ…
(こどもオバケＢ) あれ～？

157
00:12:51,188 --> 00:12:53,356
(こどもオバケＡ) やっぱりな

158
00:12:54,816 --> 00:12:57,235
もうっ なんだよ なんだよ！

159
00:12:58,069 --> 00:13:00,030
バケールカーニバルなんて――

160
00:13:00,530 --> 00:13:03,241
なくなっちゃえば いいんだー！

161
00:13:03,867 --> 00:13:05,243
(ちょうちょう)
このまちのオバケは――

162
00:13:05,327 --> 00:13:07,913
たのしいことが だーいすき！

163
00:13:07,996 --> 00:13:09,706
あっとおどろく へんしんから――

164
00:13:09,789 --> 00:13:13,043
アハハと わらう
ゆかいな へんしんまで――

165
00:13:13,126 --> 00:13:17,047
いろーんな へんしんで
みなさんを えがおにしますぞい！

166
00:13:17,339 --> 00:13:19,716
(そっきんＡ) どこもかしこも
みどころいっぱい！

167
00:13:19,799 --> 00:13:22,260
それが バケールカーニバル！

168
00:13:22,344 --> 00:13:25,514
(そっきんＢ) こころゆくまで
おたのしみくださーい

169
00:13:25,597 --> 00:13:29,059
(かんきゃくの かんせい)

170
00:13:29,684 --> 00:13:32,062
(クリームパンダ) あの～
(ちょうちょう) うん？

171
00:13:32,145 --> 00:13:34,648
(クリームパンダ)
ほんとうに こわくないの？

172
00:13:34,731 --> 00:13:36,566
(カバお) オバケなのに？

173
00:13:37,108 --> 00:13:39,319
(ちょうちょう)
こわいなんて とんでもない！

174
00:13:39,653 --> 00:13:41,821
ほら このとおーり！

175
00:13:42,113 --> 00:13:44,449
(３にん) バケバケール！

176
00:13:45,909 --> 00:13:47,327
(ちょうちょうの こえ) パオーン！

177
00:13:47,410 --> 00:13:51,331
(はくしゅと かんせい)

178
00:13:51,623 --> 00:13:53,333
(アンパンマン) すごいですね

179
00:13:53,708 --> 00:13:55,710
(ちょうちょうの こえ)
それではバケールカーニバル――

180
00:13:55,794 --> 00:13:57,587
スタートですぞ！

181
00:13:57,837 --> 00:14:00,048
パオーン！

182
00:14:01,174 --> 00:14:08,181
♪～

183
00:14:13,520 --> 00:14:17,566
♪ おばけなんて ないさ
おばけなんて うそさ

184
00:14:17,649 --> 00:14:21,653
♪ ねぼけた ひとが
みまちがえたのさ

185
00:14:21,736 --> 00:14:23,697
♪ だけどちょっと
だけどちょっと

186
00:14:23,780 --> 00:14:25,824
♪ ぼくだって こわいな

187
00:14:25,907 --> 00:14:29,035
(ウサこ) わあ～
(カバお) うん？ うひぃ！

188
00:14:29,911 --> 00:14:31,371
(ウサこ) うわあ～

189
00:14:32,038 --> 00:14:32,872
(カバお) アハハッ！

190
00:14:34,207 --> 00:14:38,169
♪ ほんとに おばけが
でてきたら どうしよう

191
00:14:38,253 --> 00:14:42,299
♪ れいぞうこに いれて
カチカチに しちゃおう

192
00:14:42,382 --> 00:14:44,467
♪ だけどちょっと
だけどちょっと

193
00:14:44,551 --> 00:14:46,469
♪ ぼくだって こわいな

194
00:14:46,553 --> 00:14:50,974
♪ おばけなんて ないさ
おばけなんて うそさ

195
00:14:57,689 --> 00:15:00,108
(３にんの はしゃぐこえ)

196
00:15:00,358 --> 00:15:02,611
(ホラーマン) イヒヒッ
(ばいきんまん) ふんっ

197
00:15:06,197 --> 00:15:07,824
(しょうげきおん)
(ふたり) おっ？

198
00:15:07,907 --> 00:15:10,368
(ふたりの ひめい)

199
00:15:11,328 --> 00:15:15,415
♪ だけど こどもなら
ともだちに なろう

200
00:15:15,498 --> 00:15:19,544
♪ あくしゅを してから
おやつを たべよう

201
00:15:19,628 --> 00:15:21,630
♪ だけどちょっと
だけどちょっと

202
00:15:21,713 --> 00:15:23,673
♪ ぼくだって こわいな

203
00:15:23,757 --> 00:15:28,136
♪ おばけなんて ないさ
おばけなんて うそさ

204
00:15:30,722 --> 00:15:31,931
(チーズ) アンアン

205
00:15:32,015 --> 00:15:36,019
♪ おばけのともだち
つれてあるいたら

206
00:15:36,102 --> 00:15:40,190
♪ そこらじゅうの ひとが
びっくり するだろう

207
00:15:40,273 --> 00:15:42,275
♪ だけどちょっと
だけどちょっと

208
00:15:42,359 --> 00:15:44,402
♪ ぼくだって こわいな

209
00:15:44,486 --> 00:15:48,865
♪ おばけなんて ないさ
おばけなんて うそさ

210
00:15:48,948 --> 00:15:55,955
～♪

211
00:15:56,039 --> 00:15:59,668
(ドロリン) ふん
なにが バケールカーニバルだ

212
00:16:00,835 --> 00:16:03,046
こんな おまつり おいらが…

213
00:16:03,129 --> 00:16:05,674
ああ あった！

214
00:16:11,763 --> 00:16:12,681
みてろ

215
00:16:23,358 --> 00:16:24,192
あっ

216
00:16:24,776 --> 00:16:27,195
わああ…

217
00:16:27,946 --> 00:16:29,698
うわあああ～！

218
00:16:29,906 --> 00:16:32,450
うわーい たのしいぞ～！

219
00:16:33,660 --> 00:16:36,830
(カバお) ポップコーンも
おいしいでーす！ あむっ

220
00:16:36,913 --> 00:16:39,457
(どよめき)
(カバおたち) うん？

221
00:16:42,669 --> 00:16:45,213
(みんなの ひめい)

222
00:16:46,381 --> 00:16:47,215
(クリームパンダ) わあっ！

223
00:16:48,591 --> 00:16:50,218
(カバおたち)
クリームパンダちゃん！

224
00:16:50,301 --> 00:16:52,220
(みんなの ひめい)

225
00:17:02,522 --> 00:17:03,815
(ジャム) これは？

226
00:17:03,898 --> 00:17:04,733
(アンパンマン) ふっ！

227
00:17:04,816 --> 00:17:06,484
(カレーパンマン) えいっ　はっ！

228
00:17:12,866 --> 00:17:15,493
(ちょうちょう)
ど… どうなっとるんじゃ？

229
00:17:15,577 --> 00:17:16,995
(ホラーマン) ホラ～？

230
00:17:17,078 --> 00:17:18,997
(ばいきんまん)
なんだ なんだ これは？

231
00:17:19,080 --> 00:17:22,500
(ドロリン) ハアハアッ ハアハアッ

232
00:17:22,584 --> 00:17:24,252
(ぶつかる おと)
(ばいきんまん) うわああ！

233
00:17:24,794 --> 00:17:26,171
(ドロリン) うっ！

234
00:17:26,254 --> 00:17:28,673
(ばいきんまん) どわわわっ！

235
00:17:30,300 --> 00:17:31,509
(しょうとつする おと)

236
00:17:32,844 --> 00:17:34,012
(ばいきんまん) うう…

237
00:17:34,804 --> 00:17:36,723
うん… んが？

238
00:17:37,849 --> 00:17:41,895
うわー だれか とめてくれーぃ！

239
00:17:41,978 --> 00:17:43,772
うわ～！

240
00:17:44,397 --> 00:17:45,940
どわあ！

241
00:17:46,316 --> 00:17:48,777
ギャ～ア～！

242
00:17:49,944 --> 00:17:50,779
(ホラーマン) ホラ？

243
00:17:52,864 --> 00:17:54,783
(ふたり) うう… うわあ！

244
00:17:56,993 --> 00:17:58,411
(アンパンマン) ふっ！

245
00:17:59,537 --> 00:18:01,289
(ホラーマン) アンパンマン

246
00:18:02,207 --> 00:18:04,209
アン… パンマン？

247
00:18:04,751 --> 00:18:07,170
(かんばんを うごかすおと)

248
00:18:07,253 --> 00:18:09,130
(アンパンマン)
まにあって よかった

249
00:18:09,380 --> 00:18:11,216
(ホラーマン)
ありがとうございます

250
00:18:11,299 --> 00:18:13,551
さすが ヒーローですね ホラ～

251
00:18:14,135 --> 00:18:15,762
ケガは ない？

252
00:18:16,554 --> 00:18:18,348
う… うん

253
00:18:18,723 --> 00:18:20,517
バケバケール！

254
00:18:26,189 --> 00:18:27,607
(そうじきの おと)

255
00:18:29,943 --> 00:18:31,110
(かんきゃくたち) おおー！

256
00:18:31,194 --> 00:18:33,112
(すいこむ おと)

257
00:18:38,409 --> 00:18:41,120
(ちょうちょう) また おまえか
いたずらドロリン

258
00:18:41,538 --> 00:18:42,705
モコモコジュースを――

259
00:18:42,789 --> 00:18:45,583
ふんすいに ながすなんて
むちゃなことを

260
00:18:45,667 --> 00:18:48,878
(そっきんＡ) きょうの いたずらは
いくらなんでも やりすぎですよ

261
00:18:48,962 --> 00:18:52,131
(そっきんＢ)
せっかくの カーニバルを
だいなしにするつもりですか？

262
00:18:52,423 --> 00:18:53,508
(ドロリン) ちょっと みんなを――

263
00:18:53,591 --> 00:18:55,593
おどかしたかった だけだよ

264
00:18:55,677 --> 00:18:57,095
おおげさ だな

265
00:18:57,303 --> 00:18:59,764
(ちょうちょう) ハア～ やれやれ

266
00:19:00,223 --> 00:19:03,643
おどかすなら
もっとたのしい やりかたでじゃな

267
00:19:04,143 --> 00:19:05,687
たとえば…

268
00:19:06,312 --> 00:19:08,189
こ～んなのとか

269
00:19:09,774 --> 00:19:11,943
こ～んなのとか

270
00:19:12,652 --> 00:19:14,904
(かんせいと はくしゅ)

271
00:19:15,989 --> 00:19:18,908
(ちょうちょう)
ありがとう ありがとう

272
00:19:20,493 --> 00:19:21,411
あ…

273
00:19:21,786 --> 00:19:22,996
(ドロリン) うう…

274
00:19:25,164 --> 00:19:26,124
くっ！

275
00:19:26,916 --> 00:19:29,919
(ちょうちょう) いかん
つい ドロリンのまえで…

276
00:19:30,211 --> 00:19:31,546
(アンパンマン) うーん…

277
00:19:33,214 --> 00:19:36,843
ごくごく ごくごく ぷは～

278
00:19:36,926 --> 00:19:38,928
まったく ひどいめにあった

279
00:19:39,220 --> 00:19:43,474
(ホラーマン) でも よかったですね
まちが もとどおりになって

280
00:19:43,558 --> 00:19:45,310
(ばいきんまん)
ちっとも よくない！

281
00:19:45,393 --> 00:19:47,145
えがおが
たくさんの ばしょなんて――

282
00:19:47,228 --> 00:19:49,355
おれさま だいっきらい！

283
00:19:49,439 --> 00:19:51,524
(ホラーマン)
まあまあ そういわずに

284
00:19:51,608 --> 00:19:54,319
(カバおたち) ジャムおじさーん！
(ホラーマン) ホラ？

285
00:19:55,528 --> 00:19:58,448
ん？ どうしたの
そんなにあわてて

286
00:19:58,531 --> 00:20:00,283
(カバおたち) ハアハアッ

287
00:20:00,366 --> 00:20:02,535
(ちびぞう) クリームパンダちゃん
みなかった？

288
00:20:02,619 --> 00:20:03,453
(ジャムたち) ええっ？

289
00:20:04,162 --> 00:20:07,707
(クリームパンダ)
ちびぞうくーん！ カバおくーん！

290
00:20:08,499 --> 00:20:10,710
みんな どこにいるんだよ？

291
00:20:11,502 --> 00:20:12,462
うん？

292
00:20:13,338 --> 00:20:16,257
(わるいオバケ) フハハハッ！
いまこそ まっくろまおう――

293
00:20:16,341 --> 00:20:18,968
ふっかつのときー！

294
00:20:19,385 --> 00:20:21,220
(わるいオバケ) バケバケール！

295
00:20:22,764 --> 00:20:26,476
(かんせいと はくしゅ)

296
00:20:26,976 --> 00:20:28,853
(クリームパンダ) おーい
(ドロリン) あ？

297
00:20:30,605 --> 00:20:33,983
(クリームパンダ) こんにちは
きみ オバケだよね？

298
00:20:34,067 --> 00:20:35,735
(ドロリン) だれだよ？ おまえ

299
00:20:35,818 --> 00:20:37,987
(クリームパンダ)
ぼく クリームパンダ

300
00:20:38,071 --> 00:20:39,530
パンダ？

301
00:20:40,073 --> 00:20:41,574
(クリームパンダ)
パンダじゃないやい！

302
00:20:41,658 --> 00:20:45,203
う～ん クリームパンダ！

303
00:20:45,828 --> 00:20:46,996
きみは？

304
00:20:48,164 --> 00:20:49,248
ドロリン

305
00:20:50,124 --> 00:20:52,043
よろしく ドロリン

306
00:20:52,460 --> 00:20:53,586
なにか よう？

307
00:20:53,670 --> 00:20:55,004
アハハッ ヘヘッ

308
00:20:55,380 --> 00:20:58,675
じつは ぼく
まいごになっちゃってさ

309
00:20:58,758 --> 00:21:02,136
ともだちを さがすのを
てつだってほしいんだ

310
00:21:02,220 --> 00:21:03,304
(ドロリン) おいらが？

311
00:21:03,388 --> 00:21:05,848
うん　たとえば ほら

312
00:21:05,932 --> 00:21:08,601
おっきなスピーカに
へんしんするとか

313
00:21:08,685 --> 00:21:09,519
はあ？

314
00:21:09,602 --> 00:21:10,561
(クリームパンダ) そうしたら――

315
00:21:10,645 --> 00:21:13,147
みつけてもらえる
かもしれないでしょう？

316
00:21:13,231 --> 00:21:15,733
ああっ ふうせんもいいな！

317
00:21:15,817 --> 00:21:18,903
ぼくの かたちで
すっごく おおきなやつ

318
00:21:18,987 --> 00:21:21,197
せっかくなら カッコよく
へんしんしてほしいな～

319
00:21:21,280 --> 00:21:22,532
(ドロリン) ムッ

320
00:21:22,615 --> 00:21:23,783
(クリームパンダ)
それとも それとも…

321
00:21:23,866 --> 00:21:25,785
(へいし) まっくろマントだ！

322
00:21:25,868 --> 00:21:26,869
ハッ！

323
00:21:27,370 --> 00:21:30,498
(まほうつかい) まっくろまおうの
へんしんのちからの みなもとは――

324
00:21:30,581 --> 00:21:32,291
あの マントなんだわ！

325
00:21:32,375 --> 00:21:35,670
(まっくろまおう)
フハハハハッ そのとおり

326
00:21:35,753 --> 00:21:37,296
(へいし) なんだって？

327
00:21:37,588 --> 00:21:40,299
(まっくろまおう)
さあ かかってこい

328
00:21:40,508 --> 00:21:41,592
(クリームパンダ) ふい～

329
00:21:41,676 --> 00:21:44,721
なにに
へんしんしてもらおうかな～

330
00:21:45,096 --> 00:21:47,015
(ドロリン) あれっきゃない
(クリームパンダ) えっ？

331
00:21:47,098 --> 00:21:51,436
(ドロリン) ねえ そんなに
おいらに へんしんしてほしい？

332
00:21:51,519 --> 00:21:53,813
えっ？ あっ もちろん！

333
00:21:55,148 --> 00:21:56,274
えっ？

334
00:21:56,733 --> 00:21:57,984
だったら…

335
00:21:58,901 --> 00:22:00,069
いっしょにきて！

336
00:22:00,153 --> 00:22:02,071
えっ？ わあ！

337
00:22:06,534 --> 00:22:08,578
ねえ どこいくのさ？

338
00:22:08,661 --> 00:22:09,495
あっち

339
00:22:09,579 --> 00:22:11,581
えっ… ええっ？

340
00:22:11,664 --> 00:22:15,418
いやだよ かえろうよ
わけ わかんないよ！

341
00:22:15,501 --> 00:22:18,087
(ドロリン) うるさいな！
だまって ついてくればいいの！

342
00:22:18,171 --> 00:22:19,505
(オバケコウモリの なきごえ)

343
00:22:19,589 --> 00:22:20,465
(ふたり) ん？

344
00:22:21,758 --> 00:22:22,967
(クリームパンダ) なに？ あれ

345
00:22:23,968 --> 00:22:25,595
(ドロリン) オバケコウモリだ！

346
00:22:26,679 --> 00:22:28,097
うわああっ

347
00:22:28,181 --> 00:22:29,849
(オバケコウモリ) ギャーッ！
ギャギャギャギャギャー

348
00:22:30,391 --> 00:22:31,350
(ドロリン) わあっ！

349
00:22:31,434 --> 00:22:32,852
(クリームパンダ) わああ！

350
00:22:33,644 --> 00:22:34,771
(ドロリン) やめろー！

351
00:22:34,854 --> 00:22:36,355
(クリームパンダ)
あっちいってよ！

352
00:22:36,439 --> 00:22:37,565
(ドロリン) うわっ！

353
00:22:39,025 --> 00:22:40,359
こうなったら…

354
00:22:41,402 --> 00:22:42,862
バケバケール！

355
00:22:44,447 --> 00:22:45,698
(オバケコウモリたち) キキッ？

356
00:22:47,533 --> 00:22:48,367
ドロリン！

357
00:22:53,831 --> 00:22:54,874
(ひをはく おと)

358
00:22:58,878 --> 00:22:59,796
(クリームパンダ) ドロリン？

359
00:22:59,879 --> 00:23:01,506
(ドロリン) ハッ　わっ！

360
00:23:02,173 --> 00:23:04,884
ああ やっぱりダメだ～

361
00:23:06,719 --> 00:23:08,429
(オバケコウモリたち) キキキッ

362
00:23:09,222 --> 00:23:12,809
(ドロリン) うわあああ！
(クリームパンダ) あ～あ～

363
00:23:14,477 --> 00:23:16,145
(ドロリン) あっ うわ！

364
00:23:16,229 --> 00:23:17,897
わあー！

365
00:23:18,731 --> 00:23:19,649
ドロリン！

366
00:23:19,732 --> 00:23:20,650
(マントがちぎれる おと)

367
00:23:20,733 --> 00:23:23,402
ああっ マントが！

368
00:23:23,486 --> 00:23:25,154
わああー！

369
00:23:25,238 --> 00:23:26,739
(ドロリン) あー！

370
00:23:27,824 --> 00:23:31,160
うわっ うぐ… うわわ

371
00:23:31,494 --> 00:23:33,329
バケバケール！

372
00:23:34,705 --> 00:23:36,290
(クリームパンダ) ひえっ！
(ドロリン) ぐわっ

373
00:23:36,374 --> 00:23:38,167
(ドロリン) わっ なにすんだよ

374
00:23:38,251 --> 00:23:39,669
はやくおりろ！

375
00:23:39,752 --> 00:23:41,671
そ… そんな！

376
00:23:41,754 --> 00:23:43,756
(ドロリン) このままじゃ… うぷっ

377
00:23:44,423 --> 00:23:46,175
しずんじゃうだろ！

378
00:23:46,259 --> 00:23:50,179
じゃあ もっと おっきな
ボートに へんしんすれば？

379
00:23:50,263 --> 00:23:53,683
うーん
うるさい うるさい うるさ～い！

380
00:23:55,268 --> 00:23:56,686
(クリームパンダ) あっ
(ドロリン) あああ

381
00:24:00,773 --> 00:24:02,692
(ふたり) うわーっ！

382
00:24:02,775 --> 00:24:05,361
(ドロリン) わわわ たいへんだ！

383
00:24:05,945 --> 00:24:09,198
(クリームパンダ)
あああ ドロリン おちついて！

384
00:24:09,574 --> 00:24:10,616
(ドロリン) うわあ！
(クリームパンダ) わっ

385
00:24:10,700 --> 00:24:14,579
(ふたり) うわあああー！

386
00:24:16,038 --> 00:24:16,873
うえっ！

387
00:24:17,498 --> 00:24:20,084
(オバケナマズ) ヌア～

388
00:24:20,960 --> 00:24:23,629
(クリームパンダ) ええっ！
(ドロリン) オバケナマズだ！

389
00:24:23,713 --> 00:24:25,548
ヌア～

390
00:24:25,631 --> 00:24:28,801
(ふたり) うわあああー！

391
00:24:28,885 --> 00:24:30,261
(オバケナマズ) あぐっ

392
00:24:44,442 --> 00:24:46,319
クリームパンダちゃーん！

393
00:24:46,611 --> 00:24:48,821
(メロンパンナ)
いたら へんじして！

394
00:24:48,905 --> 00:24:51,282
クリームパンダちゃーん！

395
00:24:51,365 --> 00:24:52,825
アンアンアーン！

396
00:24:53,075 --> 00:24:56,037
(ピョンきち) ハアハアッ
まちじゅう さがしたんだけど

397
00:24:56,120 --> 00:24:57,830
みつからないぞう

398
00:24:58,164 --> 00:25:01,083
(ちょうちょう)
うーん おかしいですなあ

399
00:25:01,167 --> 00:25:02,585
(ジャム) いったい どこへ？

400
00:25:02,668 --> 00:25:05,338
(そっきんＢ) ちょうちょーう！
(ちょうちょう) うん？

401
00:25:05,421 --> 00:25:08,341
ドロリンが
こどものパンダをつれて

402
00:25:08,966 --> 00:25:12,762
(そっきんＢ)
おぞましのもりのほうへ
とんでいくのを みたというひとが

403
00:25:12,845 --> 00:25:14,347
(ちょうちょう) な… なんじゃと！

404
00:25:14,639 --> 00:25:16,807
こどものパンダ？

405
00:25:17,183 --> 00:25:19,352
(ドロリンたちの わらいごえ)

406
00:25:19,435 --> 00:25:22,230
ねえ それって もしかして…

407
00:25:22,313 --> 00:25:24,482
クリームパンダちゃんじゃない？

408
00:25:24,565 --> 00:25:25,608
アン アアン

409
00:25:26,234 --> 00:25:29,445
おぞましのもりということは
まさか…

410
00:25:29,528 --> 00:25:31,948
ドロリンは まっくろマントを…

411
00:25:32,031 --> 00:25:35,618
(ちょうちょう) うーん
それしか かんがえられんのう

412
00:25:35,701 --> 00:25:37,161
(みんなの ふしぎがる こえ)

413
00:25:37,245 --> 00:25:38,996
(アンパンマン) まっくろマント？

414
00:25:39,622 --> 00:25:40,623
(ちょうちょう) オホンッ

415
00:25:41,999 --> 00:25:46,629
むか～し むかし
そのまたむかしの はなしですじゃ

416
00:25:47,463 --> 00:25:50,424
まっくろまおうという
わるーいオバケが――

417
00:25:50,508 --> 00:25:52,635
オバケタウンを おそいましてな…

418
00:25:52,969 --> 00:25:57,807
(まっくろまおう) ウエエ～！

419
00:25:58,140 --> 00:26:00,643
まっくろー！

420
00:26:05,106 --> 00:26:08,150
(ちょうちょう) オバケたちは
ちからをあわせて たちむかい――

421
00:26:08,484 --> 00:26:11,654
なんとか かんとか まおうを
おいはらったのですじゃ

422
00:26:11,737 --> 00:26:16,158
まっくろー！

423
00:26:20,496 --> 00:26:21,580
(ちょうちょう) あとには――

424
00:26:21,664 --> 00:26:25,501
まおうが みにつけていた
まっくろマントだけが のこった

425
00:26:25,584 --> 00:26:28,087
それは せかいいちの
へんしんパワーをひめた――

426
00:26:28,170 --> 00:26:30,673
とんでもないものでしてな

427
00:26:30,756 --> 00:26:33,592
オバケたちは
だれのてにも ふれぬよう――

428
00:26:33,676 --> 00:26:36,012
おぞましのもりの おくふかくに――

429
00:26:36,095 --> 00:26:39,598
まっくろマントを
ふうじこめたのですじゃ

430
00:26:41,851 --> 00:26:43,352
あのような ひげきを――

431
00:26:43,436 --> 00:26:45,688
２どと くりかえさないために

432
00:26:46,272 --> 00:26:47,690
(そっきんたち) うんうん

433
00:26:48,107 --> 00:26:48,983
(ジャム) せかいいちの――

434
00:26:49,066 --> 00:26:52,194
へんしんパワーをひめた
まっくろマント…

435
00:26:52,486 --> 00:26:54,280
(そっきんＡ)
ドロリンは さっき――

436
00:26:54,363 --> 00:26:57,908
みんなを おどかしたかった
といっておりまして…

437
00:26:57,992 --> 00:27:01,245
(バタコ) そのために
まっくろマントを とりにいったのね

438
00:27:01,329 --> 00:27:04,790
(カレーパンマン) でもよ
なんで クリームパンダちゃんまで

439
00:27:04,874 --> 00:27:05,875
(そっきんＢ) わたしたちは――

440
00:27:05,958 --> 00:27:08,669
ずっと こどもたちに
いいきかせてきました

441
00:27:08,753 --> 00:27:11,756
(そっきんＡ) おぞましのもりは
きけんで いっぱいだから――

442
00:27:11,839 --> 00:27:14,216
あしを ふみいれては いけないと

443
00:27:14,842 --> 00:27:16,135
なるほど

444
00:27:16,218 --> 00:27:20,348
きっとドロリンは ひとりでは
こころぼそかったのですね

445
00:27:20,431 --> 00:27:22,433
さすが しょくぱんまんさま

446
00:27:22,516 --> 00:27:24,143
するどいですわ～

447
00:27:24,852 --> 00:27:26,854
(ちょうちょう)
よわったもんじゃのう

448
00:27:26,937 --> 00:27:29,648
カーニバルの
さいちゅうだというのに

449
00:27:31,192 --> 00:27:33,361
(アンパンマン) ちょうちょうさん
(ちょうちょう) うん？

450
00:27:34,153 --> 00:27:36,280
ぼくたちに まかせてください

451
00:27:36,364 --> 00:27:39,533
(カレーパンマン)
ぴゅーっと ひとっとび
すぐ おいついてやるぜ！

452
00:27:39,617 --> 00:27:42,036
(しょくぱんまん) かならず
ふたりを つれもどします

453
00:27:42,119 --> 00:27:44,163
(メロンパンナ)
だから しんぱいしないで

454
00:27:44,246 --> 00:27:46,165
(３にん) おおー！

455
00:27:46,248 --> 00:27:48,918
(みんな) いってらっしゃーい！

456
00:27:49,460 --> 00:27:51,754
(バタコ) きをつけてねー！
(チーズ) アンアーン！

457
00:27:51,837 --> 00:27:56,926
(ドキン) ううっ どうか ごぶじで
しょくぱんまんさま～

458
00:27:57,676 --> 00:28:00,471
(ホラーマン) では
つづきは わたしと ごいっしょに

459
00:28:00,554 --> 00:28:02,473
ホラホラ～ ホラ～

460
00:28:03,391 --> 00:28:04,433
(ドキン) うう…

461
00:28:04,517 --> 00:28:06,644
(なぐる おと)
(ドキン) おばかー！

462
00:28:06,727 --> 00:28:08,896
(ホラーマン) ああー！

463
00:28:10,189 --> 00:28:12,441
(みんなの おどろくこえ)
(ドキン) あっ

464
00:28:12,525 --> 00:28:15,361
(ドキン) あらイヤだ
てが すべっちゃっいましたわ

465
00:28:15,444 --> 00:28:17,446
オホホホッ オホホッ ホホホッ

466
00:28:17,822 --> 00:28:20,950
(ばいきんまん)
ほ～ まっくろマント…

467
00:28:21,033 --> 00:28:23,452
せかいいちの へんしんパワー

468
00:28:26,205 --> 00:28:29,208
おもしろくなってきたぞ！ ウフッ

469
00:28:35,506 --> 00:28:36,799
(すいてきの おちるおと)

470
00:28:37,425 --> 00:28:39,301
(クリームパンダ) うう…

471
00:28:39,802 --> 00:28:41,011
うっ？

472
00:28:42,471 --> 00:28:44,223
こ… ここは？

473
00:28:45,015 --> 00:28:48,227
う～ん バケバケール…

474
00:28:48,310 --> 00:28:51,730
ドロリン！ おきて ドロリン！

475
00:28:51,814 --> 00:28:53,899
ん… なあに？

476
00:28:53,983 --> 00:28:56,527
ぼくたち
のみこまれちゃったんだよ

477
00:28:56,610 --> 00:28:57,820
オバケナマズに

478
00:28:57,903 --> 00:28:58,737
ええっ？

479
00:29:03,951 --> 00:29:06,996
(クリームパンダ) これ ぜんぶ
(ドロリン) オバケナマズが…

480
00:29:07,079 --> 00:29:09,498
(オバケネコの なきごえ)
(ふたり) うわあ！

481
00:29:09,582 --> 00:29:12,001
(オバケネコたち) ニャアア～

482
00:29:12,376 --> 00:29:16,547
(ドロリン) なんだ オバケネコか
おどかすなよ もう

483
00:29:16,630 --> 00:29:18,757
(クリームパンダ) きみたちも
のみこまれちゃったんだね

484
00:29:18,841 --> 00:29:21,385
(ものおと)
(みんな) うん？

485
00:29:26,432 --> 00:29:28,434
(みんな) うわあああー！

486
00:29:28,517 --> 00:29:31,270
(クリームパンダ) また
なにかを まるのみしたんだ！

487
00:29:31,353 --> 00:29:32,938
(オバケネコたち) ニャー

488
00:29:33,022 --> 00:29:35,149
バ… バケバケール

489
00:29:36,901 --> 00:29:39,778
(クリームパンダ) ああっ
ずるいよ じぶんばっかり！

490
00:29:40,404 --> 00:29:43,782
あああ～ あああ～

491
00:29:44,283 --> 00:29:48,370
グー･チョキ･パンチの パー！

492
00:29:48,454 --> 00:29:49,538
えいっ！

493
00:29:52,124 --> 00:29:53,292
わああ～！

494
00:29:53,876 --> 00:29:54,793
あっ！

495
00:29:55,044 --> 00:29:57,296
(ドロリン)
おいらは むしじゃないよ！

496
00:29:57,796 --> 00:29:58,881
ニャ～ン

497
00:29:58,964 --> 00:29:59,798
(オバケネコ) ニャッ
(ドロリン) わっ！

498
00:29:59,882 --> 00:30:01,091
(ドロリン) あああっ

499
00:30:02,218 --> 00:30:04,303
うわあー！

500
00:30:06,597 --> 00:30:07,640
うっ

501
00:30:08,349 --> 00:30:10,059
(クリームパンダ) くっ… ぐぬぬ

502
00:30:10,935 --> 00:30:12,061
クリームパンダ！

503
00:30:12,144 --> 00:30:14,063
ふにゅ～！

504
00:30:17,566 --> 00:30:18,567
(オバケネコたち) ニャア？

505
00:30:18,651 --> 00:30:22,071
フウ… やっと おさまった

506
00:30:25,032 --> 00:30:26,575
(オバケネコたちの なきごえ)
(ドロリン) あっ？

507
00:30:26,659 --> 00:30:29,161
(オバケネコたち) ニャア ニャア

508
00:30:29,662 --> 00:30:32,248
ニャア ニャア ニャーン

509
00:30:32,331 --> 00:30:36,168
びっくりしましたね～
ホラーですね

510
00:30:36,877 --> 00:30:38,379
ホラーマン！

511
00:30:43,133 --> 00:30:45,761
(しょくぱんまん) まだ
とおくへは いっていないはずです

512
00:30:45,844 --> 00:30:47,513
(アンパンマン)
みんなで てわけして さがそう

513
00:30:47,596 --> 00:30:48,430
(カレーパンマン) ああ
(メロンパンナ) うん

514
00:30:48,514 --> 00:30:50,182
(オバケコウモリ) キエエー！
(アンパンマンたち) うん？

515
00:30:50,266 --> 00:30:52,685
(オバケコウモリたち) キエエー！

516
00:30:52,977 --> 00:30:54,353
(アンパンマンたち) うわあ！

517
00:30:55,062 --> 00:30:56,855
(カレーパンマン)
なんだよ？ こいつら

518
00:30:57,231 --> 00:30:58,857
(メロンパンナ) じゃま しないで

519
00:30:58,941 --> 00:31:00,609
(オバケコウモリ) キエー ギャッ！

520
00:31:00,693 --> 00:31:02,611
(アンパンマン) ていっ
(しょくぱんまん) てやっ

521
00:31:03,445 --> 00:31:05,197
ギャギャー！

522
00:31:11,412 --> 00:31:12,538
ギェギェイッ！

523
00:31:13,080 --> 00:31:14,039
キエーッ！

524
00:31:14,123 --> 00:31:15,332
(アンパンマンたち) ああっ

525
00:31:15,541 --> 00:31:17,668
(メロンパンナ) キャー！

526
00:31:18,794 --> 00:31:19,712
ギャア！

527
00:31:19,920 --> 00:31:21,088
あぶない！

528
00:31:21,922 --> 00:31:23,048
ギャア！

529
00:31:23,799 --> 00:31:24,800
(メロンパンナ) アンパンマン！

530
00:31:25,509 --> 00:31:26,802
ギェギェーッ！

531
00:31:26,885 --> 00:31:28,012
(４にん) うっ！

532
00:31:30,472 --> 00:31:31,557
(ばいきんまん) ラッキー！

533
00:31:31,807 --> 00:31:33,809
いまのうちに
ドロリンをつかまえて――

534
00:31:33,892 --> 00:31:36,729
マントの ところまで
あんないさせてやる

535
00:31:36,812 --> 00:31:38,814
ハヒフヘホ～

536
00:31:38,897 --> 00:31:40,065
(ホラーマン) ホラ～

537
00:31:40,149 --> 00:31:43,527
でられそうな ばしょは
みつかりませんねえ

538
00:31:43,611 --> 00:31:44,820
(クリームパンダ) ハア…

539
00:31:44,903 --> 00:31:47,823
オバケナマズの
くちから でられないかな？

540
00:31:48,073 --> 00:31:51,827
(ホラーマン) さっきみたいに
みずで おしもどされちゃいますよ

541
00:31:52,369 --> 00:31:53,996
(クリームパンダ) そっか…

542
00:31:54,288 --> 00:31:56,832
よし！
こんどは あっちにいってみよう

543
00:31:56,915 --> 00:31:58,834
(ドロリン) もう いいよ
(ホラーマンたち) うん？

544
00:31:59,335 --> 00:32:01,420
どうせ でられっこないって

545
00:32:01,503 --> 00:32:03,339
がんばるだけ むだだよ

546
00:32:05,049 --> 00:32:06,091
ちょっと！

547
00:32:06,717 --> 00:32:07,968
わかってるの？

548
00:32:08,052 --> 00:32:10,971
こんなことになったのは
ドロリンのせいなんだよ！

549
00:32:11,055 --> 00:32:12,806
はっ？ なんだと！

550
00:32:13,807 --> 00:32:15,643
わるいのは そっちじゃないか！

551
00:32:15,726 --> 00:32:17,895
おいらの へんしんが
みたいなんて いうから！

552
00:32:17,978 --> 00:32:20,105
ええっ それ どういうこと？

553
00:32:21,565 --> 00:32:22,941
それは…

554
00:32:23,192 --> 00:32:24,360
それは…

555
00:32:24,443 --> 00:32:25,944
(ホラーマン)
まっくろマントですよね？

556
00:32:26,028 --> 00:32:26,862
(ドロリン) あっ
(クリームパンダ) えっ

557
00:32:27,279 --> 00:32:29,698
(ホラーマン)
もりのおくに あるらしいですよ

558
00:32:29,782 --> 00:32:31,992
せかいいちの
へんしんパワーをひめた――

559
00:32:32,076 --> 00:32:33,577
スーパーアイテムが

560
00:32:33,661 --> 00:32:35,329
(クリームパンダ) ええーっ！

561
00:32:35,704 --> 00:32:38,999
それを とりにいくために
ぼくまで こんなところへ？

562
00:32:39,083 --> 00:32:41,543
(ドロリン) もう わかってるだろ
(クリームパンダ) えっ

563
00:32:41,877 --> 00:32:44,296
おいらの へんしんが
へたっぴだって

564
00:32:44,838 --> 00:32:47,549
おいらじゃ
なんにも できないんだって

565
00:32:47,966 --> 00:32:50,552
はっ ほっ たああっ！

566
00:32:52,137 --> 00:32:54,556
(ちいさい チューバの おと)

567
00:32:56,517 --> 00:32:59,937
(ドロリン) だから もう
まっくろマントしか ないんだ

568
00:33:00,020 --> 00:33:01,939
(クリームパンダ)
そんなこと ないよ

569
00:33:02,439 --> 00:33:05,818
あきらめずに がんばれば
きっと うまくなれるよ

570
00:33:05,901 --> 00:33:08,195
オバケタウンの みんなみたいに

571
00:33:08,278 --> 00:33:09,279
あ…

572
00:33:09,363 --> 00:33:10,864
(ドロリン) がんばってるよ

573
00:33:13,242 --> 00:33:16,829
がんばってるんだよ
おいらだって…

574
00:33:17,162 --> 00:33:18,163
ドロリン…

575
00:33:18,247 --> 00:33:21,625
(ホラーマン) まあまあ
げんきをだしてください ホラ～

576
00:33:21,709 --> 00:33:24,336
こんなときこそ ごようきに！

577
00:33:24,628 --> 00:33:28,215
ホラホラ おれは ホラーマン♪

578
00:33:28,298 --> 00:33:30,384
なぞなぞだらけの ホラー…

579
00:33:30,467 --> 00:33:31,343
やめてよ！

580
00:33:32,386 --> 00:33:33,303
(ホラーマン) え～？

581
00:33:33,387 --> 00:33:35,222
なんなんだよ いきなり

582
00:33:35,305 --> 00:33:37,808
なにって わらわせようと…

583
00:33:37,891 --> 00:33:40,018
そんな ばあいじゃ ないだろ！

584
00:33:40,436 --> 00:33:42,730
(ホラーマン) そうですかね？
(ドロリン) おわっ

585
00:33:42,813 --> 00:33:44,565
わらうって いいですよ

586
00:33:44,648 --> 00:33:47,359
すぐに ハッピーに
なれますからね～

587
00:33:52,656 --> 00:33:59,663
♪～

588
00:34:03,292 --> 00:34:05,794
(コーラスと てびょうし)

589
00:34:05,878 --> 00:34:07,546
わあ～！ アハハッ

590
00:34:19,349 --> 00:34:22,978
♪ ほらほら おれは ホラーマン

591
00:34:23,061 --> 00:34:26,857
♪ なぞなぞ だらけの
メチャクチャチャチャチャ

592
00:34:26,940 --> 00:34:30,694
♪ なんなん おれは なんなんだ

593
00:34:30,778 --> 00:34:35,115
♪ 誰も知らない わからない

594
00:34:42,247 --> 00:34:45,918
♪ 骨が なるなる
チャッチャッチャ

595
00:34:46,001 --> 00:34:49,797
♪ こわくてかわいい
メッチャクチャ

596
00:34:49,880 --> 00:34:53,634
♪ クチャクチャクチャチャ
クチャクチャクチャチャ

597
00:34:54,051 --> 00:34:58,472
♪ ホラーマン！

598
00:35:00,849 --> 00:35:02,184
ああ…

599
00:35:02,559 --> 00:35:03,393
うん？

600
00:35:03,477 --> 00:35:07,397
(ゆれる おと)

601
00:35:07,815 --> 00:35:09,817
(クリームパンダ) これって？

602
00:35:10,526 --> 00:35:13,654
(ホラーマン) なるほど！
みなさんで おどったから――

603
00:35:13,737 --> 00:35:16,698
オバケナマズが
くすぐったがってるんですね

604
00:35:16,782 --> 00:35:17,658
(クリームパンダたち) ええー！

605
00:35:18,075 --> 00:35:21,161
(ホラーマン) チャンスですよ
もっと ハッスルしましょう！

606
00:35:21,245 --> 00:35:22,663
ホラー！

607
00:35:23,872 --> 00:35:26,291
(ドロリン) ふんふん！
(クリームパンダ) えいっ えいっ！

608
00:35:26,375 --> 00:35:30,295
(たたくおと)

609
00:35:31,630 --> 00:35:33,215
(オバケナマズ) ブブブブッ

610
00:35:33,298 --> 00:35:36,218
ブクブクブク

611
00:35:37,678 --> 00:35:41,181
ワハーッ グワハーッ！

612
00:35:41,265 --> 00:35:44,518
(オバケナマズの くしゃみ)

613
00:35:44,977 --> 00:35:46,186
(オバケネコたち) ニャーッ！

614
00:35:46,270 --> 00:35:48,021
(ドロリンたち) わーっ！

615
00:35:48,105 --> 00:35:50,065
バケバケール！

616
00:35:50,732 --> 00:35:53,777
(クリームパンダ) わあー！
(ドロリン) うわっ おもーい！

617
00:35:59,366 --> 00:36:01,034
ギェーギャー！

618
00:36:02,786 --> 00:36:04,037
(しょくぱんまん) うっ

619
00:36:04,830 --> 00:36:07,291
(カレーパンマン) アハッ
どこ ねらってんだよ！

620
00:36:07,833 --> 00:36:09,918
ギエッ ギエッ…

621
00:36:10,669 --> 00:36:13,005
(アンパンマン) いまだ！
メロンパンナちゃん！

622
00:36:13,088 --> 00:36:13,922
(オバケコウモリ) ギャ？

623
00:36:14,006 --> 00:36:17,593
メロンパンナの メロメロパンチ！

624
00:36:17,676 --> 00:36:19,928
グギャ！ ニャハッ

625
00:36:20,012 --> 00:36:23,432
ニギャニギャニギャ～ ニャハハ～

626
00:36:23,765 --> 00:36:25,851
(アンパンマン)
しょくぱんまん！ カレーパンマン！

627
00:36:25,934 --> 00:36:27,060
(ふたり) はい！

628
00:36:27,853 --> 00:36:29,938
(３にん) トリプルパーンチ！

629
00:36:31,273 --> 00:36:32,232
(オバケコウモリ) ギャアー！

630
00:36:34,693 --> 00:36:37,237
(ばいきんまん)
ドロリンめ どこにいる？

631
00:36:37,321 --> 00:36:38,822
(オバケコウモリ) ギャアッ！
(ばいきんまん) うん？

632
00:36:38,906 --> 00:36:40,908
(オバケコウモリ) ギャギャギャー
(ばいきんまん) うわあ！

633
00:36:41,909 --> 00:36:44,411
(ばいきんまん) だっは～！

634
00:36:48,582 --> 00:36:49,625
うう～ん…

635
00:36:49,708 --> 00:36:52,002
(オバケナマズの うなりごえ)
(ばいきんまん) うん？

636
00:36:53,962 --> 00:36:56,381
(オバケナマズ) グアア～！
(ばいきんまん) わああ～！

637
00:36:56,465 --> 00:36:58,175
(ばいきんまん) だっは～！

638
00:36:58,258 --> 00:37:00,010
うわっ うわっ うわっ うわっ

639
00:37:01,303 --> 00:37:04,181
どうして こうなるのー！

640
00:37:04,264 --> 00:37:05,223
(オバケナマズ) グアアッ

641
00:37:12,064 --> 00:37:13,732
(クリームパンダ) イタタタタタッ

642
00:37:14,608 --> 00:37:16,818
(ホラーマン)
だっしゅつ せいこうですね

643
00:37:16,902 --> 00:37:19,613
なんとかね… えっ？

644
00:37:19,696 --> 00:37:21,490
ホラーマン からだは？

645
00:37:21,573 --> 00:37:24,660
バラバラになって
おちちゃったんですね～

646
00:37:24,743 --> 00:37:26,745
ハプニングですね～

647
00:37:26,828 --> 00:37:29,873
たいへんだ すぐに さがさなきゃ

648
00:37:30,666 --> 00:37:31,500
あっ

649
00:37:36,254 --> 00:37:37,714
あそこだ

650
00:37:38,632 --> 00:37:40,258
どこいくの？ ドロリン

651
00:37:43,345 --> 00:37:45,097
(ドロリン) まっくろマントだよ

652
00:37:45,639 --> 00:37:47,391
(クリームパンダ)
それどころじゃないよ

653
00:37:47,474 --> 00:37:50,102
ホラーマンのからだを
さがさなきゃ

654
00:37:50,185 --> 00:37:52,020
(ドロリン)
そんなの ひとりで いったら？

655
00:37:52,104 --> 00:37:54,690
(クリームパンダ)
え？ あ… あのねえ！

656
00:37:55,065 --> 00:37:57,609
なんなのさ もう
かってすぎるよ！

657
00:37:57,693 --> 00:37:58,777
(ドロリン) うるさいな！

658
00:37:58,860 --> 00:38:01,154
おいらには マントのほうが
だいじなんだ

659
00:38:01,238 --> 00:38:03,865
(クリームパンダ)
えっ？ ドロリンは――

660
00:38:03,949 --> 00:38:06,952
こまっているひとを
たすけようって おもわないの？

661
00:38:07,035 --> 00:38:08,453
(ドロリン) しるもんか

662
00:38:09,079 --> 00:38:11,415
べつに おいらは こまってないもん

663
00:38:11,498 --> 00:38:12,457
あっ…

664
00:38:13,000 --> 00:38:14,292
そんな…

665
00:38:14,376 --> 00:38:16,211
ショックですね～

666
00:38:18,171 --> 00:38:19,214
(ドロリン) うっ
(クリームパンダ) あ…

667
00:38:22,592 --> 00:38:24,720
(ホラーマン)
いっちゃいましたね～

668
00:38:24,803 --> 00:38:27,806
(クリームパンダ)
もう… もういいや！

669
00:38:28,181 --> 00:38:30,392
ドロリンなんかー！

670
00:38:31,309 --> 00:38:33,895
(ドロリン) ハアハアハアッ

671
00:38:33,979 --> 00:38:37,899
ハアハアハアッ
ハアハアハアッ

672
00:38:42,195 --> 00:38:44,948
あ… あった

673
00:38:45,824 --> 00:38:46,908
(とびらをおす おと)

674
00:38:48,827 --> 00:38:51,788
(ドロリン) えいっ うっ ぬうっ

675
00:38:51,872 --> 00:38:55,375
うっ う～ん ぐぬぬ

676
00:38:55,459 --> 00:38:57,711
(オバケたいぼく) ウド～
(ドロリン) あ？

677
00:39:03,717 --> 00:39:05,552
ウド～！

678
00:39:05,635 --> 00:39:07,637
わああ～！

679
00:39:08,263 --> 00:39:09,890
むぐぐっ

680
00:39:10,474 --> 00:39:13,685
(オバケたいぼく) ウド～
ウドドドドドドッ

681
00:39:13,769 --> 00:39:16,188
(オバケたいぼく) ウドドドド
(ドロリン) うっ

682
00:39:19,316 --> 00:39:20,192
(ドロリン) うわあ！

683
00:39:24,988 --> 00:39:27,699
(オバケたいぼく) ウド～ ウドッ！

684
00:39:27,783 --> 00:39:30,744
(ドロリン) わああー！

685
00:39:31,620 --> 00:39:32,704
ウドッ

686
00:39:35,457 --> 00:39:36,708
えっ アンパンマン？

687
00:39:36,792 --> 00:39:37,667
(オバケたいぼく) ウド～！
(ドロリン) あっ！

688
00:39:37,751 --> 00:39:39,669
(オバケたいぼく)
ウドドドドドドッ

689
00:39:39,753 --> 00:39:40,837
(アンパンマン) えいっ

690
00:39:42,089 --> 00:39:44,466
ふっ！ うぬーっ

691
00:39:44,800 --> 00:39:45,926
(オバケたいぼく) ウドッ

692
00:39:46,009 --> 00:39:48,762
ドドドドドッ ドドドドドドッ

693
00:39:49,679 --> 00:39:50,972
(アンパンマン)
もう だいじょうぶだよ

694
00:39:51,056 --> 00:39:52,015
(ドロリン) えっ

695
00:39:54,518 --> 00:39:56,520
(ばいきんまん) くそ～！

696
00:39:56,603 --> 00:39:59,564
ドロリンは？
まっくろマントは どこだ？

697
00:39:59,648 --> 00:40:01,775
(オバケたいぼく) ウドドドドッ
(ばいきんまん) うん？

698
00:40:01,858 --> 00:40:03,777
(オバケたいぼく) ドドドドドドッ
(ばいきんまん) だあああ～っ！

699
00:40:05,153 --> 00:40:06,404
(ばいきんまん) だはあ～！

700
00:40:06,488 --> 00:40:08,990
だあ～ わあああ～！

701
00:40:09,074 --> 00:40:12,160
だは～ ぎゃああ～！

702
00:40:15,080 --> 00:40:15,914
(メロンパンナ) あっ

703
00:40:17,833 --> 00:40:18,667
フフッ

704
00:40:20,168 --> 00:40:22,170
ヘヘヘヘッ

705
00:40:23,380 --> 00:40:26,091
(アンパンマン)
みんな しんぱいしてるよ ドロリン

706
00:40:30,846 --> 00:40:33,473
(おなかのなる おと)
(ドロリン) あっ

707
00:40:35,183 --> 00:40:36,268
(アンパンマン) フフッ

708
00:40:39,980 --> 00:40:41,189
はい どうぞ

709
00:40:41,606 --> 00:40:44,442
え… ええーっ！

710
00:40:44,734 --> 00:40:47,362
ぼくの かおは
アンパンで できてるんだ

711
00:40:47,445 --> 00:40:49,197
たべると げんきがでるよ

712
00:40:52,075 --> 00:40:54,995
あむっ もぐもぐもぐ

713
00:40:56,037 --> 00:40:56,955
わあ

714
00:40:59,291 --> 00:41:00,792
フフフフッ

715
00:41:01,209 --> 00:41:03,336
よーし いまなら！

716
00:41:05,088 --> 00:41:09,009
アンパンパワーで バケバケール！

717
00:41:09,092 --> 00:41:10,552
せーのっ

718
00:41:12,095 --> 00:41:14,389
イテ～！

719
00:41:16,725 --> 00:41:18,101
ドロリン

720
00:41:20,145 --> 00:41:21,771
(ドロリン) どうして…
(アンパンマン) うん？

721
00:41:22,564 --> 00:41:25,650
どうして おいらだけ
うまくいかないの？

722
00:41:26,109 --> 00:41:29,779
まいにち まいにち
がんばってるのに

723
00:41:31,072 --> 00:41:34,117
どうすりゃいいのか わかんないよ

724
00:41:34,201 --> 00:41:38,663
みんなみたいに へんしんして
すごいって いってほしい

725
00:41:38,747 --> 00:41:41,166
カッコいいって いってほしい

726
00:41:42,959 --> 00:41:44,419
バケバケール！

727
00:41:47,088 --> 00:41:49,299
ニャオ～

728
00:41:50,008 --> 00:41:51,801
それだけなのに…

729
00:41:52,719 --> 00:41:54,429
それだけなのに

730
00:41:58,683 --> 00:42:00,810
ぼくも ちいさいころにね…

731
00:42:04,064 --> 00:42:06,274
おお おお おおっ あわわわ

732
00:42:06,358 --> 00:42:08,568
わあ あわわわわわ！

733
00:42:08,652 --> 00:42:10,320
ううう…

734
00:42:10,403 --> 00:42:13,823
あわわわっ ああー！

735
00:42:14,950 --> 00:42:16,326
はあ…

736
00:42:17,035 --> 00:42:19,829
(なきごえ)
(アンパンマン) うん？

737
00:42:19,913 --> 00:42:24,834
(ネコみ)
えーん えーん うわあ～ん

738
00:42:24,918 --> 00:42:28,463
ああ あああ… うわあ～

739
00:42:29,422 --> 00:42:31,091
うっ… っと

740
00:42:32,175 --> 00:42:37,097
わあ！
ありがとう ウフフフッ

741
00:42:38,306 --> 00:42:40,558
(アンパンマン)
そのときに きがついたんだ

742
00:42:41,017 --> 00:42:43,186
だれかの えがおが
みたいって おもえば――

743
00:42:43,270 --> 00:42:45,605
ちからが わいてくるって

744
00:42:46,106 --> 00:42:48,733
えがおが みたい？

745
00:42:49,150 --> 00:42:51,611
(カレーパンマン)
オバケタウンの みんなもさ

746
00:42:52,487 --> 00:42:54,656
(しょくぱんまん)
きっと そうおもっていますよ

747
00:42:54,739 --> 00:42:57,367
(メロンパンナ)
そう いっしょに かえりましょう

748
00:42:57,659 --> 00:43:00,870
(ホラーマン) すっかり
もとどおりです ホラ～

749
00:43:01,579 --> 00:43:03,873
(クリームパンダ) いこうよドロリン
(ドロリン) あ…

750
00:43:04,291 --> 00:43:07,711
へんしんの れんしゅうなら
ぼくたちも てつだうからさ

751
00:43:07,794 --> 00:43:10,380
ナイスアイデアですね ホラ～

752
00:43:10,463 --> 00:43:13,508
(みんなの わらいごえ)

753
00:43:13,591 --> 00:43:14,801
わあ

754
00:43:15,969 --> 00:43:17,178
フフフフッ

755
00:43:17,262 --> 00:43:19,764
(ばいきんまんの さけびごえ)
(ふたり) うん？

756
00:43:19,848 --> 00:43:21,391
(ばいきんまん)
だっ どあっ ぎゃあ！

757
00:43:21,933 --> 00:43:24,894
だっは～ あ～あ～ あ～！

758
00:43:24,978 --> 00:43:25,895
(アンパンマン) あぶない！

759
00:43:25,979 --> 00:43:27,647
(ばいきんまん) どわああ～

760
00:43:27,731 --> 00:43:33,528
だは～っ ああっ ああっ！
だああ～っ

761
00:43:34,904 --> 00:43:35,989
うわあー！

762
00:43:37,991 --> 00:43:41,786
むう ぐう～う…

763
00:43:44,831 --> 00:43:45,790
うん？

764
00:43:46,416 --> 00:43:47,792
う…･ わっ！

765
00:43:49,461 --> 00:43:51,796
こ… こいつは

766
00:43:52,130 --> 00:43:54,132
(クリームパンダ) ねえ いまのって

767
00:43:54,591 --> 00:43:55,800
(しょくぱんまん) まさか…

768
00:43:56,134 --> 00:43:59,179
ハヒフヘホ～！

769
00:43:59,262 --> 00:44:00,805
(アンパンマンたち) あっ
(メロンパンナ) やっぱり！

770
00:44:00,889 --> 00:44:02,724
(アンパンマンたち)
ばいきんまん！

771
00:44:02,807 --> 00:44:05,602
ついに てにいれたぞ

772
00:44:05,685 --> 00:44:09,189
(ドロリン)
あっ あれは まっくろマント！

773
00:44:09,272 --> 00:44:10,106
(アンパンマンたち) ええっ！

774
00:44:10,190 --> 00:44:13,318
(ばいきんまん)
ギャーハッハッハッハーッ

775
00:44:13,401 --> 00:44:17,822
せかいいちの へんしんパワー
たっぷりと みせてやる！

776
00:44:19,115 --> 00:44:20,325
はっ！

777
00:44:27,791 --> 00:44:30,835
(クリームパンダ)
もしかして オバケタウンへ？

778
00:44:30,919 --> 00:44:32,962
(ホラーマン) まずいですよ ホラー

779
00:44:37,050 --> 00:44:39,469
(みんなの どよめき)

780
00:44:53,566 --> 00:44:57,987
(みんなの ふあんがるこえ)

781
00:44:58,530 --> 00:45:01,241
(ウサこ) なに？
(ちびぞう) こわいぞう

782
00:45:01,658 --> 00:45:03,451
(ジャム) これは いったい

783
00:45:03,535 --> 00:45:06,246
(ばいきんまん) ハヒフヘホ～！

784
00:45:10,041 --> 00:45:12,252
(ジャムたち) ばいきんまん！
(そっきんたち) うん？

785
00:45:12,544 --> 00:45:15,505
(そっきんＡ) ちょうちょう
(そっきんＢ) あれは まさか！

786
00:45:16,714 --> 00:45:18,258
まっくろマントじゃ…

787
00:45:18,550 --> 00:45:21,094
たのしいカーニバルは おしまいだ

788
00:45:21,177 --> 00:45:24,264
みろ！
せかいいちの へんしんパワー！

789
00:45:26,057 --> 00:45:29,227
バケバケバイキーン！

790
00:45:36,234 --> 00:45:38,778
(バイキンこおりのじょうおう)
オーホッホッホッホッ

791
00:45:38,862 --> 00:45:41,656
バイキンこおりのじょうおう だよ

792
00:45:41,739 --> 00:45:43,658
(みんなの ひめい)

793
00:45:47,036 --> 00:45:48,538
やめるんじゃー！

794
00:45:49,664 --> 00:45:51,416
オバケタウンを まもるぞい

795
00:45:51,499 --> 00:45:52,542
(オバケたち) おー！

796
00:45:52,917 --> 00:45:55,545
(オバケたち) バケバケール！

797
00:45:55,628 --> 00:45:58,047
(オバケたち) うお～っ！

798
00:45:58,339 --> 00:46:00,550
(バイキンこおりのじょうおう)
オ～ホッホッホッ！

799
00:46:00,633 --> 00:46:03,553
むだ むだ　はあっ！

800
00:46:03,845 --> 00:46:05,722
(オバケたちの ひめい)

801
00:46:06,723 --> 00:46:07,557
はーっ！

802
00:46:07,974 --> 00:46:09,184
(オバケたち) うわあ！

803
00:46:18,818 --> 00:46:20,153
(バイキンこおりのじょうおう)
オ～ホッホッホッホッ

804
00:46:20,236 --> 00:46:21,070
(みんな) あっ！

805
00:46:22,071 --> 00:46:23,323
(アンパンマン) あれは…

806
00:46:24,073 --> 00:46:25,783
オバケタウンが！

807
00:46:26,743 --> 00:46:28,036
はあー！

808
00:46:29,412 --> 00:46:31,831
(みんなの ひめい)

809
00:46:31,915 --> 00:46:34,667
(ドキン)
なにすんのよ ばいきんまん！

810
00:46:36,419 --> 00:46:38,213
みんな こっちへ！

811
00:46:38,296 --> 00:46:40,089
(バタコ) いそいでー！

812
00:46:40,173 --> 00:46:41,716
(チーズ) アンアンアーン

813
00:46:41,799 --> 00:46:42,967
うん？

814
00:46:43,343 --> 00:46:44,719
(メロンパンナ) やめなさーい！

815
00:46:45,261 --> 00:46:46,846
(しょくぱんまん)
わたしたちが あいてです！

816
00:46:46,930 --> 00:46:48,473
(カレーパンマン)
かかってきやがれ！

817
00:46:51,142 --> 00:46:52,101
はーっ！

818
00:46:58,775 --> 00:46:59,609
はーっ！

819
00:47:00,276 --> 00:47:01,110
(アンパンマン) ううっ

820
00:47:01,778 --> 00:47:02,612
はーっ！

821
00:47:02,695 --> 00:47:03,863
(アンパンマン) うう…

822
00:47:04,489 --> 00:47:05,865
(カレーパンマン) あっ
(しょくぱんまん) アンパンマン！

823
00:47:06,741 --> 00:47:07,867
(アンパンマン) うっ

824
00:47:08,451 --> 00:47:09,285
(ドロリン) あっ！

825
00:47:09,994 --> 00:47:12,163
(ホラーマン) アンパンマンは
かおが かけていると――

826
00:47:12,247 --> 00:47:14,082
ちからが でないんですね～

827
00:47:14,165 --> 00:47:15,291
(ドロリン) そんな…

828
00:47:15,667 --> 00:47:17,961
(ジャム) すぐに
あたらしいかおを やくよ

829
00:47:18,044 --> 00:47:19,045
(バタコ) はい！
(チーズ) アン！

830
00:47:20,964 --> 00:47:21,798
はーっ！

831
00:47:24,467 --> 00:47:25,301
くわーっ！

832
00:47:25,510 --> 00:47:27,470
(カレーパンマン) わっ おっと

833
00:47:29,973 --> 00:47:31,474
はあーっ！

834
00:47:32,100 --> 00:47:33,977
(カレーパンマン)
ヘヘーン こっちこっち

835
00:47:34,227 --> 00:47:35,770
(バイキンこおりのじょうおう)
ぬっ！ はーっ！

836
00:47:35,853 --> 00:47:37,272
メロンパンナちゃん！

837
00:47:38,147 --> 00:47:41,276
(メロンパンナ)
メロンパンナのメロメロパーンチ！

838
00:47:41,359 --> 00:47:44,404
バケバケバイキーン！

839
00:47:45,863 --> 00:47:47,782
(バイキンすなおとこ) うう～ん

840
00:47:48,658 --> 00:47:50,535
(しょくぱんまん)
すなおとこに へんしんした！

841
00:47:50,868 --> 00:47:52,412
(カバお) そんなの ずるい！

842
00:47:52,704 --> 00:47:54,414
アンパーンチ！

843
00:47:54,497 --> 00:47:56,416
うう～ん

844
00:47:56,499 --> 00:47:59,419
(しょくぱんまん) しょくパーンチ！
(カレーパンマン) カレーパーンチ！

845
00:47:59,502 --> 00:48:01,421
(バイキンすなおとこ) うう～ん

846
00:48:01,504 --> 00:48:03,423
(３にん) トリプルパーンチ！

847
00:48:03,673 --> 00:48:05,425
(バイキンすなおとこ) うう～ん

848
00:48:06,718 --> 00:48:08,428
は～い おつかれさん

849
00:48:08,511 --> 00:48:09,929
(カレーパンマン)
き… きたねえぞ！

850
00:48:10,680 --> 00:48:12,557
(しょくぱんまん) せいせい
どうどうと たたかいなさい！

851
00:48:12,640 --> 00:48:13,933
(バイキンすなおとこ) あっ そう？

852
00:48:14,017 --> 00:48:16,185
じゃあ えんりょなく

853
00:48:18,646 --> 00:48:22,942
(ラッパの おと)

854
00:48:23,026 --> 00:48:24,777
(アンパンマンたち) うわあっ

855
00:48:24,861 --> 00:48:28,781
(ラッパの おと)

856
00:48:28,865 --> 00:48:30,617
(ホラーマン) ホラ～

857
00:48:31,034 --> 00:48:33,786
(アンパンマン) くっ
(カレーパンマン) うっ うわあ

858
00:48:33,870 --> 00:48:35,955
(メロンパンナ) うわあ
(しょくぱんまん) くっ

859
00:48:37,540 --> 00:48:39,083
(アンパンマン) あ～あああああ！

860
00:48:40,001 --> 00:48:41,085
うわあ～っ

861
00:48:43,171 --> 00:48:44,714
(３にん) アンパンマン！

862
00:48:46,466 --> 00:48:49,844
(バイキンすなおとこ)
バケバケバイキーン！

863
00:48:52,138 --> 00:48:55,933
バイキンかせきのまおう だ！

864
00:48:56,184 --> 00:48:57,560
はっ！

865
00:49:01,606 --> 00:49:02,565
みんな！

866
00:49:03,399 --> 00:49:04,984
はあーっ！

867
00:49:07,945 --> 00:49:09,072
(クリームパンダたち) ああっ！

868
00:49:09,155 --> 00:49:11,074
(クリームパンダ)
メロンパンナおねえちゃん！

869
00:49:11,366 --> 00:49:15,495
あああっ しょくぱんまんと
カレーパンマンも ホラ～

870
00:49:16,162 --> 00:49:20,333
あとは おまえだけだ
アンパンマン！

871
00:49:20,416 --> 00:49:21,834
はあっ！

872
00:49:23,169 --> 00:49:25,380
(アンパンマン) うっ あっ ああ

873
00:49:25,463 --> 00:49:26,589
うわあ

874
00:49:26,673 --> 00:49:28,424
(カバおたち) アンパンマン

875
00:49:28,508 --> 00:49:30,343
がんばるんだぞう！

876
00:49:30,426 --> 00:49:32,011
(こどもオバケたち) あああっ

877
00:49:34,597 --> 00:49:36,516
(ジャム) ふん ふん ふん

878
00:49:38,851 --> 00:49:39,852
(アンパンマン) うう…

879
00:49:40,436 --> 00:49:41,270
はあっ！

880
00:49:42,522 --> 00:49:44,399
(アンパンマン) うわっ マントが！

881
00:49:44,607 --> 00:49:46,609
ああ あ～ああ！

882
00:49:48,069 --> 00:49:50,738
(ひびく あしおと)
(アンパンマン) うう… くっ

883
00:49:51,823 --> 00:49:53,825
(バイキンかせきのまおう) はっ！
(アンパンマン) うわあっ

884
00:49:54,492 --> 00:49:56,494
(バイキンかせきのまおう)
ナーッハッハッハッ！

885
00:49:56,744 --> 00:50:01,332
かくれても むだだ
バケバケバイキーン！

886
00:50:04,168 --> 00:50:05,002
(アンパンマン) ええっ！

887
00:50:08,589 --> 00:50:09,590
うっ

888
00:50:11,592 --> 00:50:14,137
(ホラーマン) こんどは
どろんこまおう なんですね

889
00:50:15,179 --> 00:50:17,765
(ドロリン) えっ クリームパンダ！

890
00:50:17,849 --> 00:50:19,767
アンパンマンを たすけなきゃ！

891
00:50:20,601 --> 00:50:22,270
わたしも いきます ホラ～！

892
00:50:23,271 --> 00:50:25,690
ホラ～ア！ あああ

893
00:50:25,773 --> 00:50:27,233
(ぶつかる おと)

894
00:50:27,734 --> 00:50:30,486
(ホラーマン) またですか～

895
00:50:31,070 --> 00:50:33,406
た… たすけるって？

896
00:50:33,740 --> 00:50:36,701
(アンパンマン)
ハアハアハアッ あああっ

897
00:50:36,993 --> 00:50:39,912
(バイキンどろんこまおう)
まてまてまて～！

898
00:50:42,874 --> 00:50:44,000
わああ～！

899
00:50:45,793 --> 00:50:47,253
(クリームパンダ)
やめるんだ ばいきんまん！

900
00:50:47,336 --> 00:50:48,296
(バイキンどろんこまおう) うん？

901
00:50:48,671 --> 00:50:50,131
(クリームパンダ) ハアハアッ

902
00:50:50,214 --> 00:50:54,469
グー･チョキ･パンチの グー！

903
00:50:54,552 --> 00:50:56,888
あーっ！

904
00:50:58,431 --> 00:51:01,476
くっ… うう

905
00:51:01,559 --> 00:51:03,728
ま… まけるもんか

906
00:51:03,811 --> 00:51:06,564
(バイキンどろんこまおう)
クリームパンダ！

907
00:51:06,898 --> 00:51:09,525
じゃまするな！

908
00:51:10,151 --> 00:51:12,069
わああー！

909
00:51:13,571 --> 00:51:15,156
(アンパンマン) はっ！ ぐっ

910
00:51:15,656 --> 00:51:17,700
あっ アンパンマン！

911
00:51:17,784 --> 00:51:20,203
(アンパンマン) ぐぬう～ くっ

912
00:51:22,747 --> 00:51:23,581
(ふたり) うう～！

913
00:51:23,956 --> 00:51:26,834
クリームパンダ！
アンパンマン！

914
00:51:29,921 --> 00:51:31,339
うわあっ

915
00:51:31,422 --> 00:51:33,341
うわああー！

916
00:51:34,258 --> 00:51:36,761
(ぶつかる おと)
(ドロリン) アイタッ うわっ だあ

917
00:51:38,221 --> 00:51:39,347
(ドロリン) イターイ！

918
00:51:39,722 --> 00:51:41,724
ぐっ ハア…

919
00:51:42,683 --> 00:51:44,185
うう…

920
00:51:46,437 --> 00:51:52,193
やっぱり ダメだ
おいらなんかじゃ ダメなんだ

921
00:51:53,277 --> 00:51:56,781
なんにも なんにも できないんだ

922
00:51:56,864 --> 00:51:59,617
(こどもオバケたち) ドロリーン！

923
00:52:02,203 --> 00:52:03,204
(ドロリン) みんな…

924
00:52:05,373 --> 00:52:08,167
(こどもオバケＡ)
だいじょうぶか？ ケガはないか？

925
00:52:08,251 --> 00:52:09,544
(ドロリン) う… うん

926
00:52:09,627 --> 00:52:12,797
(こどもオバケＡ) そっか うう…

927
00:52:14,257 --> 00:52:15,842
よかった

928
00:52:15,925 --> 00:52:16,759
あ…

929
00:52:16,843 --> 00:52:19,846
(みんなの あんしんするこえ)

930
00:52:24,934 --> 00:52:27,353
(アンパンマン)
そのときに きがついたんだ――

931
00:52:27,728 --> 00:52:29,897
だれかの えがおが
みたいって おもえば――

932
00:52:29,981 --> 00:52:32,567
ちからが わいてくるって

933
00:52:34,652 --> 00:52:37,572
(ドロリン) <えがおが みたい？>

934
00:52:46,080 --> 00:52:49,208
(ドロリン) おいら いかなきゃ
(こどもオバケたち) えっ？

935
00:52:51,085 --> 00:52:52,253
ドロリン？

936
00:52:54,714 --> 00:52:58,134
(ドロリン) <できるさ
まっくろマントが なくったって>

937
00:53:04,348 --> 00:53:06,517
<じぶんのためじゃ ない>

938
00:53:11,731 --> 00:53:16,027
<みんなのためなら
カッコわるくたって いい>

939
00:53:16,861 --> 00:53:20,031
<ほめてもらえなくたって
かまうもんか>

940
00:53:24,660 --> 00:53:29,290
<おいらも みたくなったよ
アンパンマン>

941
00:53:36,005 --> 00:53:37,298
<みんなの>

942
00:53:38,883 --> 00:53:40,092
<みんなの>

943
00:53:43,179 --> 00:53:44,305
<えがおが>

944
00:53:47,642 --> 00:53:50,061
バケバケール！

945
00:54:00,780 --> 00:54:03,199
(アンパンマンたち) ううっ

946
00:54:03,491 --> 00:54:06,702
これで おしまいだー！

947
00:54:13,459 --> 00:54:15,753
(ドロリン)
アンパンマン クリームパンダ

948
00:54:15,836 --> 00:54:17,213
もう だいじょうぶだよ

949
00:54:17,838 --> 00:54:19,215
(アンパンマン･クリームパンダ)
ドロリン！

950
00:54:19,465 --> 00:54:22,468
えーい よくもやってくれたな！

951
00:54:24,053 --> 00:54:25,221
(アンパンマン･クリームパンダ)
うわあ～

952
00:54:25,638 --> 00:54:26,597
(ドロリン) はっ

953
00:54:29,892 --> 00:54:31,102
ふんっ！

954
00:54:34,063 --> 00:54:34,981
うわっ

955
00:54:35,314 --> 00:54:37,316
(クリームパンダ)
まけるな ドロリン！

956
00:54:37,858 --> 00:54:40,319
(カバお) がんばれー！
(ちびぞうたち) ファイト！

957
00:54:40,736 --> 00:54:42,238
(こどもオバケＣ)
あれが ドロリン？

958
00:54:42,321 --> 00:54:43,698
(こどもオバケＢ) ほんとに？

959
00:54:43,990 --> 00:54:45,324
(こどもオバケＡ) すごい！

960
00:54:53,457 --> 00:54:54,333
(ジャム･バタコ) うん！

961
00:54:55,167 --> 00:54:56,502
(ドロリン) くっ

962
00:54:57,920 --> 00:54:59,839
(バタコ) アンパンマーン！
(アンパンマン) あっ

963
00:55:03,676 --> 00:55:05,511
あたらしい かおよ！

964
00:55:05,845 --> 00:55:08,264
(アンパンマン) ドロリン！
(ドロリン) それっ

965
00:55:09,223 --> 00:55:11,267
(バイキンどろんこまおう)
ふんっ そうはいくか！

966
00:55:15,855 --> 00:55:17,773
(ジャム) むむっ チーズ！
(チーズ) アンアン

967
00:55:17,857 --> 00:55:20,026
(きゅうブレーキの おと)
(バタコ) うっ きゃあ

968
00:55:21,736 --> 00:55:23,112
(バタコ) わあ きゃあっ！

969
00:55:23,195 --> 00:55:25,656
(ドロリンたち) ああっ！
(バタコ) きゃあー！

970
00:55:27,950 --> 00:55:29,785
(バイキンどろんこまおう)
いただき～！

971
00:55:31,412 --> 00:55:33,497
ホネブーメラン！

972
00:55:38,127 --> 00:55:41,338
わすれてもらっちゃ こまりますね
このホラーマン

973
00:55:41,422 --> 00:55:42,298
あっ あー！

974
00:55:44,175 --> 00:55:46,802
あ～ もう～

975
00:55:55,519 --> 00:55:57,229
げんき100ばい！

976
00:55:58,105 --> 00:55:59,774
アンパンマン！

977
00:55:59,857 --> 00:56:01,525
(ドロリン) わあ
(クリームパンダ) やったあ！

978
00:56:01,609 --> 00:56:03,277
(バタコたちのよろこぶ こえ)

979
00:56:05,863 --> 00:56:08,699
ふっ はっ えーいっ！

980
00:56:10,868 --> 00:56:13,037
もう やめるんだ ばいきんまん！

981
00:56:13,120 --> 00:56:15,539
うるさい うるさい うるさ～い！

982
00:56:15,998 --> 00:56:19,085
おれさまの ほんとのちからを
みせてやる！

983
00:56:19,168 --> 00:56:22,296
バケバケバイキーン！

984
00:56:26,634 --> 00:56:27,676
(アンパンマン) ううっ

985
00:56:28,135 --> 00:56:29,428
(クリームパンダたち) ああっ

986
00:56:37,728 --> 00:56:39,814
(バイキンまっくろまおう)
フハハハハッ

987
00:56:40,856 --> 00:56:44,568
バイキンまっくろまおうさまだ！

988
00:56:45,236 --> 00:56:46,320
(カバおたち) バイキン？

989
00:56:46,737 --> 00:56:48,572
(オバケたち) まっくろまおう？

990
00:56:49,990 --> 00:56:51,283
はっ！

991
00:56:51,992 --> 00:56:52,993
(アンパンマン) くっ

992
00:56:57,581 --> 00:56:58,499
はっ！

993
00:57:01,794 --> 00:57:02,711
はあっ！

994
00:57:02,795 --> 00:57:04,713
(アンパンマン) うっ ぐっ

995
00:57:06,298 --> 00:57:09,718
(クリームパンダ) どうしよう
このままじゃ アンパンマンが…

996
00:57:10,761 --> 00:57:12,471
(ドロリン) よーし
(クリームパンダ) えっ？

997
00:57:13,889 --> 00:57:14,974
(アンパンマン) ドロリン！

998
00:57:19,895 --> 00:57:20,813
いくぞー！

999
00:57:20,896 --> 00:57:27,903
♪～

1000
00:57:33,033 --> 00:57:35,619
うう… うん？

1001
00:57:37,204 --> 00:57:38,414
(そっきんＢ) はて？

1002
00:57:38,497 --> 00:57:41,542
(そっきんＡ) わたしは いったい？

1003
00:57:42,626 --> 00:57:43,919
(ドロリン) みんな！

1004
00:57:44,420 --> 00:57:45,629
(ちょうちょう) そのこえは！

1005
00:57:45,713 --> 00:57:47,631
(みんな) ドロリン！

1006
00:57:47,715 --> 00:57:51,468
みんな！
おいらに ちからを かして

1007
00:57:53,554 --> 00:57:55,556
(アンパンマン) くっ ふっ

1008
00:57:56,765 --> 00:57:58,100
ううっ

1009
00:57:58,851 --> 00:58:01,478
ふんっ おのれ～

1010
00:58:09,278 --> 00:58:10,696
(３にんの ひめい)

1011
00:58:14,617 --> 00:58:16,202
(ジャムたち) アンパンマン！

1012
00:58:16,493 --> 00:58:18,913
あそびは おしまいだ！

1013
00:58:21,790 --> 00:58:24,710
(アンパンマン) うう… う～ん

1014
00:58:24,793 --> 00:58:27,338
(オバケたち) バケバケール！

1015
00:58:29,381 --> 00:58:30,216
うん？

1016
00:58:36,805 --> 00:58:41,143
(すいこむ おと)

1017
00:58:43,854 --> 00:58:46,398
(バイキンどろんこまおう)
なっ なに？

1018
00:58:46,982 --> 00:58:49,151
(ドロリン) いけー！

1019
00:58:50,277 --> 00:58:53,155
やっ やめろー うわっ！

1020
00:59:00,579 --> 00:59:01,664
(バイキンどろんこまおう) わあ～

1021
00:59:01,747 --> 00:59:03,916
アンパーンチ！

1022
00:59:04,541 --> 00:59:05,876
(バイキンどろんこまおう) うおっ

1023
00:59:09,588 --> 00:59:10,881
ふんっ

1024
00:59:11,548 --> 00:59:12,383
(われる おと)

1025
00:59:12,466 --> 00:59:15,928
～♪

1026
00:59:20,474 --> 00:59:22,518
(ばいきんまん)
うわうわっ うわ～

1027
00:59:22,601 --> 00:59:25,729
わわわわ わあ わあ わー！

1028
00:59:28,023 --> 00:59:31,902
あら～！ ばいばいきーん

1029
00:59:42,830 --> 00:59:45,082
(みんな) ああ…

1030
00:59:46,917 --> 00:59:47,835
あっ？

1031
00:59:49,169 --> 00:59:51,505
(しょくぱんまん) おお？
(メロンパンナ) うわあ

1032
01:00:03,434 --> 01:00:06,353
(みんな) アンパンマーン！

1033
01:00:06,437 --> 01:00:10,357
(みんなの よろこぶこえ)

1034
01:00:10,441 --> 01:00:12,192
(ドロリン) わあ～

1035
01:00:16,739 --> 01:00:23,746
♪～

1036
01:01:28,352 --> 01:01:35,359
～♪

