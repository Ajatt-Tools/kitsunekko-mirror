1
00:00:18,018 --> 00:00:21,814
(ばいきんまん) ふわあ～

2
00:00:22,565 --> 00:00:25,067
おれさま たいくつ～

3
00:00:25,151 --> 00:00:27,445
なんか おもしろいこと ないかな？

4
00:00:32,283 --> 00:00:33,325
んん？

5
00:00:33,993 --> 00:00:34,869
んん？

6
00:00:35,536 --> 00:00:37,538
な… なんだ なんだ
あれは！

7
00:00:43,043 --> 00:00:45,212
(こどもたち) ベレちゃ～ん

8
00:00:46,213 --> 00:00:50,342
(ベレちゃん)
ベレベレベレ～ ベレ！

9
00:00:50,426 --> 00:00:53,220
ボンジュール
こんにちは みんな！

10
00:00:53,554 --> 00:00:55,264
(こどもたち)
こんにちは
ベレちゃん

11
00:00:55,347 --> 00:00:57,057
(ウサこ)
また すてきな
えをかいて

12
00:00:57,141 --> 00:00:58,058
(カバお)
はいは～い

13
00:00:58,142 --> 00:01:00,478
ぼくね アンパンマンの えがいいな～

14
00:01:00,561 --> 00:01:01,437
(ピョンきち) ぼくも！

15
00:01:01,520 --> 00:01:02,354
(ウサこ) わたしも！

16
00:01:02,855 --> 00:01:04,315
(ちびぞう)
アンパンマンが ばいきんまんを――

17
00:01:04,398 --> 00:01:06,984
やっつけてるとこが いいぞう

18
00:01:07,067 --> 00:01:08,986
(ふたり) アーンパンチ！

19
00:01:09,236 --> 00:01:11,614
ウィ ウィ　オーケー！

20
00:01:20,164 --> 00:01:26,253
♪ あかい ベレーが とんできた

21
00:01:26,337 --> 00:01:27,546
♪ (とんできた)

22
00:01:27,630 --> 00:01:33,761
♪ それに てがはえ あしがはえ

23
00:01:33,844 --> 00:01:35,262
♪ (あしがはえ)

24
00:01:35,346 --> 00:01:41,352
♪ ふしぎな ことも とびだした

25
00:01:41,435 --> 00:01:42,645
♪ (とびだした)

26
00:01:42,728 --> 00:01:48,818
♪ あたし おえかきベレちゃんよ

27
00:01:48,901 --> 00:01:50,194
♪ (ベレちゃんよ)

28
00:01:50,277 --> 00:01:53,280
♪ どんなものでも すぐかける

29
00:01:54,365 --> 00:01:55,783
♪ (すぐかける)

30
00:01:55,866 --> 00:02:00,037
♪ なにができるか おたのしみ

31
00:02:00,204 --> 00:02:02,498
♪ (おたのしみ)

32
00:02:03,415 --> 00:02:06,836
♪ どんなものでも すぐかける

33
00:02:07,336 --> 00:02:08,879
♪ (すぐかける)

34
00:02:08,963 --> 00:02:13,175
♪ なにができるか おたのしみ

35
00:02:13,259 --> 00:02:15,052
♪ (おたのしみ)

36
00:02:15,511 --> 00:02:16,804
(こどもたち) うわあ～

37
00:02:16,887 --> 00:02:18,264
(ちびぞう) すごいぞう

38
00:02:18,347 --> 00:02:19,223
(カバお) うん！

39
00:02:19,306 --> 00:02:21,058
(ピョンきち･ウサこ)
ありがとう ベレちゃん

40
00:02:21,308 --> 00:02:23,561
(ベレ) ウィ　どういたしまして

41
00:02:23,644 --> 00:02:25,938
(カバお)
だけど ほんと かっこいいよね――

42
00:02:26,021 --> 00:02:27,064
アンパンマンは

43
00:02:27,439 --> 00:02:30,568
(ちびぞう) ばいきんまんは
ほ～んと かっこわるいぞう

44
00:02:30,651 --> 00:02:33,070
(こどもたち) アハハハッ

45
00:02:33,153 --> 00:02:35,823
うう～

46
00:02:36,115 --> 00:02:39,243
ランララン ランララン♪

47
00:02:39,326 --> 00:02:41,829
ウフフフ　よかったベレー

48
00:02:42,079 --> 00:02:44,707
みーんなハッピー
ベレちゃんもハッピー

49
00:02:44,790 --> 00:02:45,958
しあわせ～

50
00:02:46,041 --> 00:02:46,876
ああっ

51
00:02:46,959 --> 00:02:48,460
あ～

52
00:02:48,544 --> 00:02:50,588
(ばいきんまん) つかまえた～っと
(ベレ) ああ～

53
00:02:57,595 --> 00:02:58,512
わあっ

54
00:02:58,596 --> 00:02:59,430
んん？

55
00:02:59,513 --> 00:03:02,057
さあ かけ！ それ かけ！
すぐに かけ！

56
00:03:02,141 --> 00:03:04,143
アンパンマンを
ギッタンギッタンにやっつけてる――

57
00:03:04,226 --> 00:03:06,353
おもいっきり つよい おれさまを
かけ！

58
00:03:06,812 --> 00:03:08,355
ノンノン ダ～メ！

59
00:03:08,439 --> 00:03:10,149
そんな え ヤダ ベレー

60
00:03:10,232 --> 00:03:11,817
なに～

61
00:03:11,901 --> 00:03:15,487
はは～ん　ほんとは
うまく かけないんだろう

62
00:03:15,571 --> 00:03:16,405
ベレー？

63
00:03:16,614 --> 00:03:18,449
じしんがないんだ

64
00:03:18,532 --> 00:03:20,034
ノンノン ノーン

65
00:03:20,117 --> 00:03:22,411
ベレちゃんに かけない えは
ないベレー

66
00:03:23,037 --> 00:03:25,164
ベレベレべ～

67
00:03:26,206 --> 00:03:28,250
ベレベレベレ～

68
00:03:29,084 --> 00:03:30,920
ベレベレ～

69
00:03:32,212 --> 00:03:33,714
(ベレ) ベレベレベレ～
(ばいきんまん) おおおお…

70
00:03:33,797 --> 00:03:36,675
(ベレ) ベレベレベレベレ～
(ばいきんまん) ん～？

71
00:03:37,134 --> 00:03:38,677
でーきた！

72
00:03:42,932 --> 00:03:43,849
どうベレ？

73
00:03:43,933 --> 00:03:45,559
ベレちゃんの だいけっさく

74
00:03:45,643 --> 00:03:48,687
だいして
“おれさま ばいきんまんシリーズ”

75
00:03:49,188 --> 00:03:51,482
(ばいきんまん) フッフッフッフッ

76
00:03:51,565 --> 00:03:53,651
ナーハッハッハッ

77
00:03:53,734 --> 00:03:55,486
おれさま つよい！
おれさま かっこいい！

78
00:03:55,569 --> 00:03:57,738
おれさま さ～いこう～！

79
00:03:57,821 --> 00:03:59,031
(ドキンちゃん) バッカみたい

80
00:03:59,114 --> 00:03:59,949
(ふたり) えっ？

81
00:04:00,908 --> 00:04:02,034
(ばいきんまん) ドキンちゃん！

82
00:04:02,117 --> 00:04:04,954
(ドキン) そんな ただの えなんかで
うかれちゃって

83
00:04:05,454 --> 00:04:06,538
(ベレ) ただの え？

84
00:04:06,622 --> 00:04:08,540
(ドキン) ばいきんまんって
えのなかでしか――

85
00:04:08,624 --> 00:04:10,417
アンパンマンに かてないのね

86
00:04:10,501 --> 00:04:12,753
(ばいきんまん) グサッ
(ドキン) じゃあね～

87
00:04:14,797 --> 00:04:15,965
んん…

88
00:04:16,382 --> 00:04:18,217
ドキンちゃんの いうとおりだ

89
00:04:18,842 --> 00:04:20,511
いくら かっこよくても――

90
00:04:20,594 --> 00:04:23,472
これは みんな ただの えだもんな～

91
00:04:23,722 --> 00:04:25,516
(ベレ) しつれいベレ
(ばいきんまん) ん？

92
00:04:25,599 --> 00:04:28,894
ベレちゃんの えは
ただの えじゃないもん！

93
00:04:29,395 --> 00:04:31,438
ベレベレベレ～

94
00:04:32,272 --> 00:04:33,315
ベレ～！

95
00:04:37,695 --> 00:04:40,280
うおっ あ… おお？

96
00:04:53,544 --> 00:04:55,337
うお～！

97
00:04:55,963 --> 00:04:57,840
(バイキンマン) フンッ
(ばいきんまん) か… かっこいい！

98
00:04:57,923 --> 00:05:00,926
おれさまと おなじぐらい
かっこいいぞ！

99
00:05:01,010 --> 00:05:02,052
(ベレ) えっへんベレ！

100
00:05:02,136 --> 00:05:04,847
これできるの
ベレちゃんだけだもんね～

101
00:05:04,930 --> 00:05:06,390
(ばいきんまん) ふふ～ん

102
00:05:06,890 --> 00:05:07,725
そうだ！

103
00:05:08,475 --> 00:05:10,769
こいつをてしたにすれば
アンパンマンなんか――

104
00:05:10,853 --> 00:05:13,188
ちょちょいのちょいで
やっつけられる

105
00:05:13,272 --> 00:05:14,148
グフフフ

106
00:05:14,231 --> 00:05:15,607
(ベレ) さ～てと
(ばいきんまん) ん？

107
00:05:15,691 --> 00:05:17,443
もとのえに もどさなきゃ

108
00:05:17,526 --> 00:05:18,360
ベレベレベレ～

109
00:05:18,444 --> 00:05:19,987
おっと　そうは いくか！

110
00:05:20,070 --> 00:05:21,613
(ばいきんまん) それ！
(ベレ) あっ

111
00:05:21,697 --> 00:05:23,949
なんてことするの！

112
00:05:24,033 --> 00:05:25,034
(ばいきんまん) うるさーい

113
00:05:25,117 --> 00:05:26,744
(かびるんるんたち) かびかびかび～

114
00:05:26,827 --> 00:05:27,661
(ベレ) うわあっ

115
00:05:29,246 --> 00:05:31,165
(ばいきんまん)
おまえは もう ようずみだ！

116
00:05:31,248 --> 00:05:33,500
(かびるんるんたち) かび～
(ベレ) わあ～っ

117
00:05:33,584 --> 00:05:35,294
ベレベレベ～！

118
00:05:35,377 --> 00:05:36,879
(ばいきんまん) ハヒフヘホ～

119
00:05:37,504 --> 00:05:39,715
これで
じゃまものは いなくなったぞ

120
00:05:40,466 --> 00:05:42,676
おい おまえ
いっしょに こい！

121
00:05:42,760 --> 00:05:45,012
これから アンパンマンを
やっつけにいくぞ！

122
00:05:45,095 --> 00:05:47,681
フン！ おれさま バイキンマン！

123
00:05:47,765 --> 00:05:50,851
な… なに？
めいれいするな？

124
00:05:50,934 --> 00:05:52,352
バビブベボ

125
00:05:52,436 --> 00:05:54,772
ん？ なまいきな

126
00:05:54,855 --> 00:05:56,940
だまって おれさまの
いうこと きけー！

127
00:05:57,024 --> 00:05:58,859
もとは ただの えのくせに！

128
00:05:58,942 --> 00:05:59,985
(バイキンマン) んんっ

129
00:06:00,319 --> 00:06:03,864
おれさま バイキンマン！
おれさま バイキンマン！

130
00:06:03,947 --> 00:06:04,990
なに～？

131
00:06:05,074 --> 00:06:08,118
“おまえこそ
おれさまの いうこときけ”だと！

132
00:06:08,327 --> 00:06:10,829
んん あったま きた！

133
00:06:10,913 --> 00:06:12,790
おまえなんか けしてやる！

134
00:06:12,873 --> 00:06:15,417
んっ んっ んっ んっ
くっ くっ くっ

135
00:06:15,501 --> 00:06:16,960
て… き… きえない

136
00:06:17,044 --> 00:06:17,878
この… わっ

137
00:06:17,961 --> 00:06:19,129
た た た た た

138
00:06:19,797 --> 00:06:21,632
な～ やったな！

139
00:06:23,133 --> 00:06:25,052
んっ バビー！

140
00:06:25,469 --> 00:06:29,014
(ばいきんまん) この この この この！
(バイキンマン) バビ！ うっ くっ うっ

141
00:06:29,098 --> 00:06:31,433
(バイキンマン) おれさま～

142
00:06:31,934 --> 00:06:33,519
(ばいきんまん) アーハハハッ

143
00:06:33,602 --> 00:06:35,479
しょうぶ あった！

144
00:06:35,562 --> 00:06:36,814
(エンジンの おと)
おお？

145
00:06:36,897 --> 00:06:40,943
(エンジンの おと)

146
00:06:42,903 --> 00:06:44,738
うわ～！

147
00:06:44,822 --> 00:06:48,575
うわああああっ

148
00:06:48,909 --> 00:06:50,953
バビブベボ～

149
00:06:51,036 --> 00:06:52,329
(かびるんるんたち) かびかびかび
(バイキンマン) ん？

150
00:06:52,412 --> 00:06:53,831
(かびるんるんたち) かびかびかび

151
00:06:53,914 --> 00:06:55,833
(バイキンマン) おれさま！
(かびるんるんたち) かびっ

152
00:06:59,336 --> 00:07:00,504
(アンパンマン) わあ～

153
00:07:00,504 --> 00:07:01,588
(バタコさん) じょうずね

154
00:07:01,672 --> 00:07:04,591
(アンパンマン) ベレちゃん
ぼくの えをかいてくれたんだ

155
00:07:04,967 --> 00:07:07,094
(バタコ)
どのアンパンマンも すてきだわ

156
00:07:07,177 --> 00:07:08,554
(チーズ) アンア～ン

157
00:07:08,637 --> 00:07:10,472
(ジャムおじさん)
さあ パンがやけたよ

158
00:07:10,556 --> 00:07:12,641
(こどもたち) わ～い

159
00:07:13,142 --> 00:07:15,519
(カバお) わあ おいしそう！

160
00:07:15,602 --> 00:07:18,772
(ばいきんまん) うわ～！
(ジャムたち) んん？

161
00:07:22,776 --> 00:07:23,861
(アンパンマンたち) ああっ

162
00:07:23,944 --> 00:07:25,279
ばいきんまん！

163
00:07:25,362 --> 00:07:26,446
んん？

164
00:07:27,114 --> 00:07:28,157
(アンパンマンたち) うわあっ

165
00:07:28,240 --> 00:07:29,658
(アンパンマン) みんな さがって

166
00:07:29,741 --> 00:07:32,452
(ばいきんまん) くそ～
(ジャムたち) ああ…

167
00:07:34,997 --> 00:07:35,873
(みんな) んん…

168
00:07:35,956 --> 00:07:38,542
(アンパンマン) んん？ ばいきんまん…

169
00:07:38,625 --> 00:07:40,085
(バタコ) いっちゃった

170
00:07:42,921 --> 00:07:44,923
よくもやったなー！

171
00:07:45,007 --> 00:07:45,841
おっ？

172
00:07:50,721 --> 00:07:52,848
うっ な… なんだ こりゃ！

173
00:07:53,640 --> 00:07:57,853
お… おれさまのだいじな
バイキンじょうが…

174
00:07:57,936 --> 00:07:58,979
うう～ん

175
00:07:59,062 --> 00:08:00,856
く… くそ～！

176
00:08:05,235 --> 00:08:06,737
フッ フッ フン！

177
00:08:10,657 --> 00:08:12,034
(ばいきんまん) あわわわわわ…

178
00:08:12,117 --> 00:08:15,329
わわわわっ あら～！

179
00:08:15,579 --> 00:08:17,414
(バイキンマン) バビブベボ～

180
00:08:17,497 --> 00:08:18,498
(かびるんるんたち) かび～

181
00:08:18,582 --> 00:08:20,417
(バイキンマン) んっ！
(かびるんるんたち) かびかびっ

182
00:08:22,669 --> 00:08:25,797
(ばいきんまん) あら～！

183
00:08:27,883 --> 00:08:29,593
おのれ～

184
00:08:29,676 --> 00:08:31,386
(アンパンマンたち) ああ…

185
00:08:34,723 --> 00:08:36,725
ＵＦＯがダメなら

186
00:08:41,980 --> 00:08:46,068
これで なかに とつにゅうだ！

187
00:08:48,737 --> 00:08:49,571
んっ

188
00:08:52,282 --> 00:08:53,909
(ばいきんまん) うよよよよよっ

189
00:08:54,117 --> 00:08:55,869
これなら どうだ！

190
00:08:59,998 --> 00:09:02,918
うえがダメなら
したから はいってやる～

191
00:09:03,252 --> 00:09:04,544
ふん　んんっ

192
00:09:04,628 --> 00:09:06,046
(ぶつかった おと)
うわあっ

193
00:09:08,924 --> 00:09:10,300
な… なんだ？

194
00:09:12,761 --> 00:09:15,097
うわあ～！

195
00:09:17,015 --> 00:09:19,184
わあ～っ

196
00:09:19,393 --> 00:09:21,770
ああ～

197
00:09:23,563 --> 00:09:24,606
おのれ～

198
00:09:24,690 --> 00:09:25,816
あ～！

199
00:09:27,067 --> 00:09:28,360
この！

200
00:09:28,443 --> 00:09:29,569
あ～！

201
00:09:30,696 --> 00:09:31,697
なにを！

202
00:09:32,114 --> 00:09:33,615
(おちるおと)
(みんな) ああ…

203
00:09:33,699 --> 00:09:35,325
(アンパンマン) ばいきんまん…
(ばいきんまん) くそ！

204
00:09:35,409 --> 00:09:36,785
(バタコ) なにやってるのかしら
(ばいきんまん) あ～！

205
00:09:36,868 --> 00:09:38,578
(ぶつかった おと)
(ジャム) う～ん

206
00:09:39,955 --> 00:09:42,833
(ばいきんまん) うう… まだまだ！

207
00:09:44,835 --> 00:09:46,586
(ばくはつする おと)

208
00:09:46,878 --> 00:09:48,755
(ばいきんまん) どわっ たっ くくく…

209
00:09:49,256 --> 00:09:51,258
あ… あきらめないぞ

210
00:09:51,800 --> 00:09:53,135
んっ おっ？

211
00:09:53,218 --> 00:09:55,470
おおお… ナハハハハッ

212
00:09:55,554 --> 00:09:58,348
やめて やめて やめて やめて
やめて やめて

213
00:09:58,432 --> 00:09:59,266
うわっ

214
00:09:59,349 --> 00:10:01,184
あらー！

215
00:10:01,268 --> 00:10:02,436
おっ いっ…

216
00:10:02,811 --> 00:10:04,855
だ～！

217
00:10:04,938 --> 00:10:05,856
(おちたおと)

218
00:10:06,273 --> 00:10:08,358
バビブベボ～

219
00:10:09,192 --> 00:10:11,320
(ばいきんまん) ハア ハア…

220
00:10:11,403 --> 00:10:13,363
ダ… ダメだ…

221
00:10:13,947 --> 00:10:17,659
ぐっ… おれさまのしろなのに
なかに はいれない

222
00:10:17,743 --> 00:10:19,369
うっ うっ うっ うっ…

223
00:10:19,453 --> 00:10:25,709
うえ～ん えんえん
お～い おいおいおい…

224
00:10:25,792 --> 00:10:27,044
お～い おい…

225
00:10:27,127 --> 00:10:28,545
(ベレ) だから！
(ばいきんまん) ん？

226
00:10:28,628 --> 00:10:33,884
(ベレ) えのバイキンマンは
えのなかに もどさなきゃダメなの

227
00:10:36,178 --> 00:10:37,304
いいところに きた！

228
00:10:37,387 --> 00:10:40,265
さっさと あいつを
えのなかに もどすんだ！

229
00:10:40,349 --> 00:10:41,308
ベレ？

230
00:10:41,391 --> 00:10:43,769
ひとに なにか たのむときは
どうするのかな？

231
00:10:43,852 --> 00:10:44,728
ん？

232
00:10:44,811 --> 00:10:46,897
おいおい なくほど
くやしいんだったら――

233
00:10:46,980 --> 00:10:48,357
どうするのかな～？

234
00:10:48,440 --> 00:10:50,942
うぐぐぐぐぐ…

235
00:10:51,026 --> 00:10:54,654
お… お… おねがいします！

236
00:10:54,738 --> 00:10:56,823
ウィ ウィ　それでオーケー

237
00:10:57,532 --> 00:11:01,078
もどすのはね
ベレちゃんが ふでで たたけばいいの

238
00:11:01,787 --> 00:11:02,621
ふで？

239
00:11:02,704 --> 00:11:05,165
おまえのふでなら ゴミすてばに…

240
00:11:05,248 --> 00:11:08,335
ああ…
でも しろには はいれない…

241
00:11:08,418 --> 00:11:11,171
もう いちど
よ～く かんがえるベレ

242
00:11:11,254 --> 00:11:13,924
あんたも あいつも
おなじ ばいきんまんでしょ

243
00:11:14,007 --> 00:11:15,342
な… なるほど

244
00:11:15,759 --> 00:11:18,136
うう～ん
おなじ ばいきんまん…

245
00:11:18,220 --> 00:11:20,347
おなじ ばいきんまん？

246
00:11:22,432 --> 00:11:25,310
(かびるんるんたち) かびかび～ かび～

247
00:11:25,394 --> 00:11:26,853
(チャイム)

248
00:11:28,063 --> 00:11:29,564
(かびるんるんたち) かび～？

249
00:11:31,858 --> 00:11:32,943
(バイキンマン) ん？

250
00:11:36,822 --> 00:11:40,409
(ばいきんまん) キラ～
えから でてきた バイキンマンさま――

251
00:11:40,492 --> 00:11:43,245
すてき～
かっこいい！ さいこう！

252
00:11:43,328 --> 00:11:44,204
(バイキンマン) うわ～っ

253
00:11:44,287 --> 00:11:47,374
(ばいきんまん)
だいだいだいファンのわたしから
プレゼントのケーキよ！

254
00:11:47,457 --> 00:11:48,708
たべてね

255
00:11:51,753 --> 00:11:54,756
(かびるんるんたち) かびかびかび～

256
00:11:55,215 --> 00:11:57,342
おれさま バイキンマ～ン

257
00:11:57,551 --> 00:11:59,511
(かびるんるんたち) かびかび～

258
00:12:07,727 --> 00:12:08,812
(ベレ) ベレー

259
00:12:08,895 --> 00:12:11,982
ばいきんまんって おだてと
おいしいものに よわいのね

260
00:12:12,065 --> 00:12:13,608
うるさ～い

261
00:12:13,692 --> 00:12:14,860
よっと… それっ

262
00:12:14,943 --> 00:12:16,111
(ベレ) ベレッ

263
00:12:20,157 --> 00:12:26,079
(ばいきんまん) うお～
(ベレ) うわ～っ

264
00:12:26,705 --> 00:12:27,956
(ばいきんまん･ベレ) わ～！

265
00:12:28,039 --> 00:12:29,583
(おちたおと)

266
00:12:29,791 --> 00:12:31,751
(ばいきんまん) ぐぐ… くっ
(ベレ) ふうっ

267
00:12:33,170 --> 00:12:34,129
ベレ～！

268
00:12:34,212 --> 00:12:37,466
すっごい すっごい
すっごいゴミのやま！

269
00:12:37,549 --> 00:12:39,593
(ばいきんまん) いいから
はやく ふでをさがすんだ！

270
00:12:40,385 --> 00:12:42,095
ふで ふで ふで ふで ふで ふで…

271
00:12:42,679 --> 00:12:44,514
ふで ふで ふで ふで ふで ふで～

272
00:12:44,598 --> 00:12:48,435
(ふたり) ふで ふで ふで ふで…

273
00:12:48,518 --> 00:12:49,436
(ベレ) ん？

274
00:12:49,519 --> 00:12:51,146
うわっ あった！

275
00:12:51,229 --> 00:12:53,148
(ホラーマン) ホラ！ くっ…
(ベレ) ん？

276
00:12:53,356 --> 00:12:56,526
(ホラーマン)
イヤですね　こまりますね～

277
00:12:57,068 --> 00:12:59,654
(ホラーマン)
おひるね じゃまされたんですね～

278
00:12:59,988 --> 00:13:02,199
イヤ～！

279
00:13:02,282 --> 00:13:04,868
(ばいきんまん) だー！ んんっ

280
00:13:04,951 --> 00:13:07,162
こんなところで ねるな ホラーマン！

281
00:13:07,537 --> 00:13:10,916
まあ ひどいですね もう
らんぼうですね～

282
00:13:11,249 --> 00:13:14,794
だいたい ばいきんまんだって
なにをしに こんなところへ？

283
00:13:14,878 --> 00:13:16,838
あっ？ ホラ ホラ ホラ ホラッ

284
00:13:16,922 --> 00:13:19,341
ほねが２ほん あまってますね

285
00:13:19,424 --> 00:13:20,425
(ばいきんまん･ベレ) おっ？

286
00:13:21,009 --> 00:13:22,427
(ベレ) あった！

287
00:13:22,677 --> 00:13:25,096
(ベレ) ベレちゃんの ふで！
(ホラーマン) あっ ああ～ ホラ…

288
00:13:25,180 --> 00:13:26,932
(ばいきんまん) よ～し！
これで あいつを…

289
00:13:28,600 --> 00:13:29,601
(ふたり) ああ！

290
00:13:31,895 --> 00:13:32,729
フンッ

291
00:13:33,230 --> 00:13:34,064
(ふたり) ああ～！

292
00:13:34,147 --> 00:13:38,485
(バイキンマン)
おれさま バイキンマン！
おれさま バイキンマン！

293
00:13:38,568 --> 00:13:41,363
うう… ああ～

294
00:13:43,114 --> 00:13:44,324
(ふたり) ああ～！

295
00:13:44,741 --> 00:13:47,160
(ベレ) ベレちゃんの ふで～！

296
00:13:47,244 --> 00:13:48,912
フンッ　くっ…

297
00:13:48,995 --> 00:13:51,081
そうは いくか！ そ～れ！

298
00:13:51,164 --> 00:13:52,040
(ベレ) ああ～

299
00:13:52,123 --> 00:13:53,250
あっ…

300
00:13:54,251 --> 00:13:55,210
ふんにゃ！

301
00:13:55,293 --> 00:13:56,294
(ホラーマン) ホラッ

302
00:13:56,628 --> 00:13:58,588
やーい へたっぴ！

303
00:13:59,005 --> 00:14:01,675
おれさま！

304
00:14:04,844 --> 00:14:05,679
んっ

305
00:14:06,429 --> 00:14:08,557
(さんかくロボ) サンカク！

306
00:14:08,890 --> 00:14:10,600
わわわわわっ

307
00:14:10,684 --> 00:14:11,518
いっ…

308
00:14:12,185 --> 00:14:14,229
くっ… やったな！

309
00:14:14,312 --> 00:14:16,773
このこのこのこのこのっ

310
00:14:17,482 --> 00:14:18,358
えいっ

311
00:14:18,775 --> 00:14:20,360
(しかくロボ) シカク～

312
00:14:20,443 --> 00:14:21,319
カク カク

313
00:14:22,487 --> 00:14:23,363
カク～！

314
00:14:24,656 --> 00:14:25,574
フンッ

315
00:14:28,451 --> 00:14:30,370
(さんかくロボ) サンカク～

316
00:14:31,913 --> 00:14:32,872
カク！

317
00:14:34,291 --> 00:14:36,543
うう～ このこのこのこのっ

318
00:14:36,626 --> 00:14:37,460
く～っ

319
00:14:37,711 --> 00:14:40,297
(しかくロボ) シカク～

320
00:14:40,964 --> 00:14:41,798
カク！

321
00:14:41,881 --> 00:14:44,009
(ぶつかった おと)
(バイキンマン) ふぐぐぐ

322
00:14:44,884 --> 00:14:45,927
(さんかくロボ) カク！

323
00:14:46,011 --> 00:14:48,179
(ぶつかった おと)
(ばいきんまん) このっ

324
00:14:49,139 --> 00:14:50,265
(しかくロボ) カク～！

325
00:14:50,348 --> 00:14:51,516
(ぶつかった おと)

326
00:14:51,600 --> 00:14:52,642
あれ？ あれ？

327
00:14:52,726 --> 00:14:57,230
(ホラーマン) ホラ～ すごいですね
やることが おんなじですねえ

328
00:14:57,314 --> 00:14:59,441
りょうほうとも
ばいきんまんですからねえ

329
00:15:00,525 --> 00:15:01,526
おれさま

330
00:15:01,735 --> 00:15:03,320
(さんかくロボ) サンカク

331
00:15:03,403 --> 00:15:04,362
(ボタンをおす おと)
(バイキンマン) フンッ

332
00:15:06,072 --> 00:15:07,907
まけて たまるか！

333
00:15:07,991 --> 00:15:09,367
(しかくロボ) シカク～

334
00:15:09,451 --> 00:15:10,493
(ボタンをおす おと)
(ばいきんまん) えいっ

335
00:15:10,577 --> 00:15:12,287
(しかくロボ) カク カク

336
00:15:13,079 --> 00:15:16,291
(さんかくロボ･しかくロボ) うう～っ

337
00:15:16,541 --> 00:15:18,209
いけー！

338
00:15:18,501 --> 00:15:20,295
おれさま～！

339
00:15:20,378 --> 00:15:21,963
(しかくロボ) シカク～

340
00:15:22,047 --> 00:15:23,214
(さんかくロボ) サンカク

341
00:15:23,465 --> 00:15:24,299
ギクッ

342
00:15:24,382 --> 00:15:26,301
な… なんだか イヤな よかん

343
00:15:26,718 --> 00:15:29,304
おれさま バイキンマ～ン！

344
00:15:29,554 --> 00:15:32,307
ばいきんまんは おれさまだ～！

345
00:15:32,807 --> 00:15:34,476
(さんかくロボ) カ… カ… カ… カ…

346
00:15:34,559 --> 00:15:36,561
(しかくロボ) ク… ク… ク… ク…

347
00:15:36,645 --> 00:15:38,813
ふで！ ふで！ ふで！

348
00:15:38,897 --> 00:15:40,065
ああ～！

349
00:15:41,024 --> 00:15:45,070
あった～！ ベレベレベレ～

350
00:15:47,656 --> 00:15:49,115
(ばくはつの おと)

351
00:15:49,199 --> 00:15:51,660
(はなびの おと)

352
00:15:51,868 --> 00:15:55,080
(ドキン)
ルンル リンリンリン ルンルルルン♪

353
00:15:55,413 --> 00:15:56,790
たっだいま～

354
00:15:56,873 --> 00:15:58,166
うっ　へっ？

355
00:15:59,834 --> 00:16:01,169
うううっ…

356
00:16:01,252 --> 00:16:03,088
なに これ～

357
00:16:03,880 --> 00:16:05,674
ベレ～

358
00:16:05,965 --> 00:16:07,634
んん…

359
00:16:07,717 --> 00:16:10,345
(ばいきんまん)
お… おれさまのバイキンじょうが…

360
00:16:10,428 --> 00:16:11,596
うっ

361
00:16:11,680 --> 00:16:12,889
あ～っ

362
00:16:13,807 --> 00:16:16,101
ええー！
ベレちゃんの えから？

363
00:16:16,559 --> 00:16:18,853
(ホラーマン) ホラ～ そうなんですね

364
00:16:18,937 --> 00:16:19,979
(ばいきんまん) くーっ

365
00:16:20,063 --> 00:16:23,441
てしたにして アンパンマンを
やっつけようと おもったのに

366
00:16:23,525 --> 00:16:24,401
(バイキンマン) フン！

367
00:16:24,484 --> 00:16:26,236
おれさま バイキンマン！

368
00:16:26,319 --> 00:16:27,237
(ばいきんまん) なに？

369
00:16:27,320 --> 00:16:29,364
じぶんもアンパンマンは
やっつけたいけど――

370
00:16:29,447 --> 00:16:31,241
てしたは そっちだって？

371
00:16:31,324 --> 00:16:33,618
じょうだんじゃない！
てしたは おまえだ！

372
00:16:34,369 --> 00:16:36,246
バビブベボ～

373
00:16:36,329 --> 00:16:37,497
おまえだったら！

374
00:16:37,872 --> 00:16:39,541
(ばいきんまんたちの いいあらそい)

375
00:16:39,624 --> 00:16:41,376
くっだらな～い

376
00:16:41,459 --> 00:16:43,128
どっちも おなじようなもんだし――

377
00:16:43,211 --> 00:16:46,005
さっさと いっしょに
やっつけに いけば いいじゃないの

378
00:16:46,339 --> 00:16:47,507
(ふたり) おっ！

379
00:16:48,800 --> 00:16:49,676
そうだ

380
00:16:49,759 --> 00:16:52,262
こいつは えだけど
さすが おれさまだけに――

381
00:16:52,345 --> 00:16:54,514
おれさまと おなじぐらい つよい

382
00:16:54,597 --> 00:16:55,432
うんうん

383
00:16:55,515 --> 00:16:56,933
おれさま バイキンマン

384
00:16:57,016 --> 00:16:58,268
う～　それに おまえ――

385
00:16:58,351 --> 00:17:00,270
おれさまだけあって かっこいいぞ！

386
00:17:00,353 --> 00:17:02,021
バビブベ バボバボバ！

387
00:17:02,105 --> 00:17:05,233
いいや いいやつだな おまえ

388
00:17:05,316 --> 00:17:07,318
ビバブベボ～バ～

389
00:17:07,402 --> 00:17:08,987
(ばいきんまん) いやいやいや
なかなか なかなか

390
00:17:09,070 --> 00:17:10,697
なんなのよ

391
00:17:10,780 --> 00:17:14,659
へんですね　みょうですね
こまったもんですね

392
00:17:14,743 --> 00:17:16,619
(ベレ) ベレベレベレ～
(ホラーマン) は？

393
00:17:16,703 --> 00:17:18,371
(ベレ) もどさなきゃ もどさなきゃ

394
00:17:18,455 --> 00:17:19,789
はやく えのなかに～

395
00:17:20,206 --> 00:17:21,916
(ドキン) ベレちゃん
(ベレ) んん？

396
00:17:22,000 --> 00:17:25,170
ねえ しょくぱんまんさまを
えから だして～

397
00:17:25,253 --> 00:17:27,630
ベレ？ ノンノン　ダメダメ

398
00:17:28,173 --> 00:17:30,133
そんなこと いわないで

399
00:17:30,550 --> 00:17:33,261
わたしは
もうひとり ドキンちゃんを

400
00:17:33,636 --> 00:17:34,971
(ベレ) ダメー！

401
00:17:35,054 --> 00:17:36,306
(ドキン) ウフフフ
(ホラーマン) ホラ～

402
00:17:36,389 --> 00:17:38,391
ふたりが ちからをあわせれば

403
00:17:38,475 --> 00:17:39,809
ババベベバ

404
00:17:39,893 --> 00:17:42,312
アンパンマンなんか へのかっぱ！

405
00:17:42,395 --> 00:17:43,813
ベボバッバ～

406
00:17:44,230 --> 00:17:45,607
(ばいきんまん) いくぞ！

407
00:17:45,690 --> 00:17:47,650
すすめ きぼうのみらいへ！

408
00:17:47,734 --> 00:17:49,986
おれさま バイキンマン！

409
00:17:50,278 --> 00:17:52,238
(ドキン) まって ベレちゃ～ん

410
00:17:52,322 --> 00:17:53,573
(ベレ) ノンノ～ン

411
00:17:53,656 --> 00:17:54,824
(ホラーマン) ホラホラ～

412
00:17:56,910 --> 00:17:59,829
(アンパンマンたち)
よいっしょ よいっしょ

413
00:18:00,246 --> 00:18:02,916
だれかが おちると あぶないからね

414
00:18:02,999 --> 00:18:03,833
はい

415
00:18:03,917 --> 00:18:06,669
(ちびぞう)
ばいきんまんのせいで たいへんだぞう

416
00:18:06,753 --> 00:18:07,587
(カバおたち) うん

417
00:18:10,465 --> 00:18:11,341
あっ

418
00:18:11,424 --> 00:18:12,342
ああ？

419
00:18:13,051 --> 00:18:15,595
(ばいきんまん) ハヒフヘホ～
(バイキンマン) バビブベボ～

420
00:18:15,887 --> 00:18:17,347
(バタコたち) うわっ ばいきんまん！

421
00:18:17,639 --> 00:18:20,058
アンパンマン！
きょうこそ おまえに かつ！

422
00:18:20,141 --> 00:18:21,059
バビ！

423
00:18:21,142 --> 00:18:22,644
(アンパンマン)
やめるんだ ばいきんまん！

424
00:18:23,061 --> 00:18:24,979
いまこそ しょうりのとき！

425
00:18:25,063 --> 00:18:26,981
おれさま バイキンマン！

426
00:18:30,485 --> 00:18:32,529
アーンパーンチ！

427
00:18:33,363 --> 00:18:35,490
(ふたり) うわ～！

428
00:18:35,573 --> 00:18:38,284
(ばいきんまん) ばいばいき～ん
(バイキンマン) バビバビブ～

429
00:18:38,660 --> 00:18:40,537
(みんな) お～？

430
00:18:40,620 --> 00:18:42,956
(アンパンマン)
あの… いま ばいきんまん…

431
00:18:43,039 --> 00:18:44,499
(バタコ) ふたり いなかった？

432
00:18:44,582 --> 00:18:46,209
(みんな) う～ん…

433
00:18:46,292 --> 00:18:48,503
(ドキン･ホラーマン)
まって　ベレちゃ～ん

434
00:18:48,586 --> 00:18:50,755
(ドキン)
しょくぱんまんさま だして～

435
00:18:50,839 --> 00:18:52,507
(ホラーマン)
ドキンちゃん おねがいします

436
00:18:52,590 --> 00:18:54,843
(ベレ) ノンノ～ン ダメダメ

437
00:18:54,926 --> 00:18:56,427
(ばいきんまん･バイキンマン) あ～！
(ベレ) ん？

438
00:18:56,511 --> 00:18:59,556
(ばいきんまん･バイキンマン) あ～！

439
00:18:59,639 --> 00:19:00,890
(３にん) ああっ

440
00:19:02,225 --> 00:19:04,143
(ドキン) うわああっ
(ホラーマン) うわあっ

441
00:19:04,227 --> 00:19:05,311
ああーっ

442
00:19:07,647 --> 00:19:08,523
(ふたり) うう…

443
00:19:08,606 --> 00:19:09,691
おおっ

444
00:19:09,774 --> 00:19:11,359
うわっ

445
00:19:15,029 --> 00:19:16,698
(３にん) うわあっ

446
00:19:16,990 --> 00:19:18,908
(ばいきんまん) うわわわわわっ

447
00:19:19,325 --> 00:19:21,661
な… なんで
おれさままで えのなかに？

448
00:19:21,744 --> 00:19:25,164
おれさま… おれさま バイキンマン

449
00:19:28,418 --> 00:19:34,465
♪ まるいおさらが
ありました

450
00:19:34,549 --> 00:19:35,842
♪ (ありました)

451
00:19:35,925 --> 00:19:41,890
♪ まるいおだんご
のせました

452
00:19:41,973 --> 00:19:43,349
♪ (のせました)

453
00:19:43,433 --> 00:19:49,480
♪ それから
くろいまめふたつ

454
00:19:49,564 --> 00:19:50,899
♪ (まめふたつ)

455
00:19:50,982 --> 00:19:57,030
♪ まゆげぴくぴく
おいしそう

456
00:19:57,113 --> 00:19:58,448
♪ (おいしそう)

457
00:19:58,531 --> 00:20:02,160
♪ ほっぺたぷくんと
ふくらんで

458
00:20:02,619 --> 00:20:04,078
♪ (ふくらんで)

459
00:20:04,162 --> 00:20:08,291
♪ にっこりわらった
アンパンマン

460
00:20:08,374 --> 00:20:11,002
♪ (アンパンマン)

461
00:20:11,878 --> 00:20:14,047
(ばいきんまん)こんどは
おれさまのばんだ！

462
00:20:15,214 --> 00:20:21,387
♪ まるいおいけの
だんごじま

463
00:20:21,471 --> 00:20:22,847
♪ (だんごじま)

464
00:20:22,931 --> 00:20:28,895
♪ だんごじまには
はしをかけ

465
00:20:28,978 --> 00:20:30,313
♪ (はしをかけ)

466
00:20:30,396 --> 00:20:36,444
♪ おやつにおだんご
ふたつたべ

467
00:20:36,527 --> 00:20:37,779
♪ (ふたつたべ)

468
00:20:37,862 --> 00:20:43,952
♪ くしざしだんごの
くしさんぼん

469
00:20:44,035 --> 00:20:45,328
♪ (くしさんぼん)

470
00:20:45,411 --> 00:20:49,374
♪ みずがゆれるよ
ぐにゃぐにゃぐにゃ

471
00:20:49,457 --> 00:20:51,000
♪ (ぐにゃぐにゃぐにゃ)

472
00:20:51,084 --> 00:20:55,171
♪ つのがはえたら
ばいきんまん

473
00:20:55,254 --> 00:20:58,299
♪ (ばいきんまん)

