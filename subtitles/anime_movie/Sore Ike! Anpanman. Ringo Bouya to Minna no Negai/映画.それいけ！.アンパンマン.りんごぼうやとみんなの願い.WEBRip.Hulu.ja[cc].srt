1
00:00:35,578 --> 00:00:38,164
(アンパンマン)
きょうも いいてんきだな

2
00:00:38,247 --> 00:00:40,833
さあ パトロールに でかけよう！

3
00:01:02,396 --> 00:01:04,398
(ドキンちゃん) もぐもぐもぐ

4
00:01:04,482 --> 00:01:07,151
(ホラーマン) ドキンちゃ～ん！

5
00:01:07,902 --> 00:01:10,488
(ホラーマン) おもしろそうな
ほんを みつけましたよ

6
00:01:10,571 --> 00:01:11,405
ホラ！

7
00:01:11,864 --> 00:01:14,617
(ドキン) なに これ？
かぎ かかってるじゃない

8
00:01:15,075 --> 00:01:17,411
ホラーマンに おまかせを

9
00:01:20,372 --> 00:01:21,499
(かぎが あいたおと)

10
00:01:24,251 --> 00:01:27,004
(ドキン) なんだ
｢しらゆきひめ｣の はなしね～

11
00:01:27,463 --> 00:01:29,006
もぐもぐ…

12
00:01:29,089 --> 00:01:30,508
(ホラーマン) ホララ～？

13
00:01:30,591 --> 00:01:33,260
でも ちょっと ちがうみたいですよ？

14
00:01:33,344 --> 00:01:35,846
えっと…“しらゆきひめは――”

15
00:01:35,930 --> 00:01:39,183
“くろまじょ マジョーラの
どくリンゴをたべて――”

16
00:01:39,266 --> 00:01:41,769
“えいえんの ねむりに つきました”

17
00:01:41,852 --> 00:01:45,523
“でも おうじさまのキスで
めざめた しらゆきひめは――”

18
00:01:45,606 --> 00:01:47,775
“ふるさとの おしろにかえり――”

19
00:01:47,858 --> 00:01:51,779
“いっぱいのリンゴに かこまれて
しあわせに くらしました”

20
00:01:52,196 --> 00:01:53,739
すてきー！

21
00:01:53,823 --> 00:01:55,699
あたしも しらゆきひめになって――

22
00:01:55,783 --> 00:01:58,911
おいしいリンゴが たべた～い

23
00:02:02,248 --> 00:02:03,165
(ドキン) もう！
(ホラーマン) うわっ

24
00:02:03,249 --> 00:02:06,877
ばいきんまんったら
かんじんなときに いないんだから～

25
00:02:06,961 --> 00:02:07,962
ホラ？

26
00:02:08,045 --> 00:02:09,046
このえほん まだ――

27
00:02:09,129 --> 00:02:11,131
つづきが
あったんですね

28
00:02:11,799 --> 00:02:15,302
“そのあと マジョーラは
こうさけんで とびさりました”

29
00:02:15,970 --> 00:02:19,640
“せかいじゅうのリンゴを
どくリンゴにしてやる～！”

30
00:02:19,723 --> 00:02:20,558
(ドキン) うわあ！
(ホラーマン) ギャアッ

31
00:02:20,641 --> 00:02:23,561
(ふたりの こわがるこえ)

32
00:02:23,978 --> 00:02:25,187
(ホラーマン) ホラ～

33
00:02:25,271 --> 00:02:26,564
(ドキン) なんなのよ？

34
00:02:30,359 --> 00:02:33,946
こわいですね　ホラーですね

35
00:02:37,032 --> 00:02:41,036
♪～

36
00:02:42,997 --> 00:02:46,333
♪ りん りん りんご りん りん りん

37
00:02:46,417 --> 00:02:50,087
♪ りん りん りんご りん りん りん

38
00:02:50,170 --> 00:02:53,757
♪ りん りん りんご りん りん りん

39
00:02:57,428 --> 00:03:00,890
♪ りん りん りんごの 木の下で

40
00:03:00,973 --> 00:03:04,643
♪ りん りん りんごの 夢を見る

41
00:03:04,727 --> 00:03:08,147
♪ りん りん りんごの 太陽が

42
00:03:08,230 --> 00:03:11,609
♪ りん りん 空にかがやけば

43
00:03:11,942 --> 00:03:15,529
♪ りん りん 勇気が

44
00:03:15,613 --> 00:03:18,574
♪ りん りん りん

45
00:03:19,325 --> 00:03:22,119
♪ りんご りんご りんご

46
00:03:22,828 --> 00:03:25,706
♪ りんご りんご りんご

47
00:03:26,165 --> 00:03:29,543
♪ りんごー

48
00:03:30,002 --> 00:03:34,256
♪ りん りん りん りん りん ヤァー

49
00:03:34,340 --> 00:03:36,592
(りんごぼうや)
りんご～ りんご～ りんご～♪

50
00:03:36,675 --> 00:03:38,260
りんごぼうや さんじょう！

51
00:03:38,344 --> 00:03:41,055
このマスクこそが ヒーローの あかし！

52
00:03:41,305 --> 00:03:42,264
とうっ！

53
00:03:43,557 --> 00:03:44,767
(かぜの おと)
(りんごぼうや) うわっ わあ～

54
00:03:44,850 --> 00:03:45,976
(りんごＢ) りんごぼうや！

55
00:03:46,060 --> 00:03:48,270
(りんごＡ) おおおっ おっ おっ…
(りんごぼうや) ああっ！

56
00:03:48,354 --> 00:03:49,772
(りんごＡ) んもお～

57
00:03:49,855 --> 00:03:52,858
(りんごたちの わらいごえ)

58
00:03:54,860 --> 00:03:57,529
(ストローこうもりの なきごえ)

59
00:03:59,365 --> 00:04:02,785
(セミとカモメの なきごえ)

60
00:04:06,372 --> 00:04:07,790
(みみせんせい) みなさ～ん

61
00:04:08,123 --> 00:04:10,584
きょうの
かがいじゅぎょうは おえかき

62
00:04:10,668 --> 00:04:12,544
テーマは ふるさとです

63
00:04:12,628 --> 00:04:14,171
(ちびぞうたち) ええー？
(ピョンきち) ふるさと？

64
00:04:14,254 --> 00:04:15,923
(カバお) ふるさとって なに？

65
00:04:16,006 --> 00:04:18,717
ふるさとは
じぶんの うまれた ばしょや――

66
00:04:18,801 --> 00:04:20,844
そだった ばしょのことです

67
00:04:20,928 --> 00:04:22,721
(クリームパンダ)
メロンパンナおねえちゃん

68
00:04:22,805 --> 00:04:25,307
ぼくたちの ふるさとって
どこだろう？

69
00:04:25,391 --> 00:04:26,850
(メロンパンナ) そうねえ～

70
00:04:26,934 --> 00:04:30,646
(みみ) ただいま～ といって
げんきに かえるばしょも――

71
00:04:30,729 --> 00:04:32,690
ふるさとだと おもいますよ

72
00:04:32,940 --> 00:04:35,859
(ふたり) じゃあ パンこうじょうだ！

73
00:04:35,943 --> 00:04:38,112
(ばいきんまん)
なにが ふるさとだ～！

74
00:04:38,195 --> 00:04:39,196
(ちびぞう) あのこえは！

75
00:04:42,366 --> 00:04:43,200
(みんな) わあっ！

76
00:04:43,283 --> 00:04:45,536
(ばいきんまん) ハヒフヘホ～

77
00:04:45,786 --> 00:04:47,037
(みんな) ばいきんまん！

78
00:04:47,329 --> 00:04:49,665
おれさまの ふるさとは
バイキンせいだ！

79
00:04:49,748 --> 00:04:52,793
それ いがいの ほしは
ぜんぶ めちゃくちゃにしてやる！

80
00:04:52,876 --> 00:04:54,294
(みんな) うわ～っ

81
00:04:54,586 --> 00:04:56,296
(ばいきんまん) まてまて～！

82
00:04:56,380 --> 00:04:58,882
(みみ) みなさん こういうときは…

83
00:04:58,966 --> 00:05:00,467
せーのっ！

84
00:05:00,551 --> 00:05:04,096
(みんな) アンパンマーン！

85
00:05:04,555 --> 00:05:11,562
♪～

86
00:06:06,325 --> 00:06:13,332
～♪

87
00:06:20,005 --> 00:06:24,134
(かみなりと あめの おと)

88
00:06:24,218 --> 00:06:26,178
(りんごぼうや) ハア ハア うっ

89
00:06:26,804 --> 00:06:29,389
ううっ くっ…

90
00:06:29,473 --> 00:06:31,725
りんご～ りんご～♪

91
00:06:31,809 --> 00:06:34,853
かっこいいヒーローは
あらしにも まけないんだ

92
00:06:34,937 --> 00:06:37,022
かみなりだって こわくないぞ

93
00:06:37,981 --> 00:06:39,149
(かみなりが おちたおと)

94
00:06:39,233 --> 00:06:43,153
(りんごぼうや)
うわあ ああっ　あああ～！

95
00:06:46,615 --> 00:06:49,868
ぷはあっ
あっ りんごバルーンは？

96
00:06:49,952 --> 00:06:51,995
あっ ああ！ あっ…

97
00:06:52,079 --> 00:06:55,541
ああ～　まって～！

98
00:06:55,624 --> 00:06:56,542
うっ

99
00:06:57,000 --> 00:06:59,461
うわあ～！

100
00:07:05,759 --> 00:07:06,885
(きてきの おと)

101
00:07:09,680 --> 00:07:12,391
(アンパンマン)
こんにちは　どこへ いくの？

102
00:07:12,474 --> 00:07:13,976
(ＳＬマン)
りんごちゃんのところへ――

103
00:07:14,059 --> 00:07:16,478
おいしいリンゴを もらいにいくんだ

104
00:07:16,562 --> 00:07:19,439
あとで
パンこうじょうにも とどけるよ

105
00:07:19,523 --> 00:07:22,317
ありがとう　きをつけてね～

106
00:07:24,111 --> 00:07:25,529
(カモメの なきごえ)

107
00:07:25,612 --> 00:07:26,905
こんにちは

108
00:07:26,989 --> 00:07:30,534
きのうは すごいあめ だったね
だいじょうぶだった？

109
00:07:30,617 --> 00:07:31,451
おや？

110
00:07:38,375 --> 00:07:39,543
クータン！

111
00:07:39,918 --> 00:07:41,879
(クータン) このこを たすけてあげて

112
00:07:41,962 --> 00:07:43,046
んがあ！

113
00:07:43,881 --> 00:07:46,800
あ～あ… ほんとは
かっこいいヒーローなのに――

114
00:07:46,884 --> 00:07:50,554
シナシナで
カッコわるいったら ありゃしない

115
00:07:50,762 --> 00:07:51,805
こんにちは！

116
00:07:51,889 --> 00:07:53,807
ぼく アンパンマンです

117
00:07:53,891 --> 00:07:56,518
ぼくのかおを たべて
げんきをだして

118
00:07:56,602 --> 00:07:57,436
(りんごぼうや) うわっ

119
00:07:57,769 --> 00:07:59,938
そんなことして だいじょうぶなの？

120
00:08:00,022 --> 00:08:03,859
うん　ぼくのかおは
アンパンで できているんだ

121
00:08:03,942 --> 00:08:05,694
おいしいよ

122
00:08:05,777 --> 00:08:08,947
いらない　のどがカラカラなんだ

123
00:08:09,865 --> 00:08:11,200
そっか

124
00:08:11,283 --> 00:08:13,452
じゃあ パンこうじょうへ いこう

125
00:08:14,494 --> 00:08:15,996
パンこうじょう？

126
00:08:17,414 --> 00:08:18,707
(ジャムおじさん) うーん…

127
00:08:19,041 --> 00:08:22,461
(ジャム) うん このこには
リンゴジュースが ひつようだ

128
00:08:22,753 --> 00:08:24,213
リンゴジュース？

129
00:08:24,296 --> 00:08:25,589
(チーズ) アンアン

130
00:08:25,672 --> 00:08:28,258
(アンパンマン)
あっ そういえば ＳＬマンが――

131
00:08:28,342 --> 00:08:31,678
もぎたてのリンゴを
とどけてくれるって いってましたよ

132
00:08:31,762 --> 00:08:32,679
アハッ

133
00:08:35,599 --> 00:08:38,769
(ドキン) うわ～い　ウフフ
もぎたてのリンゴだって

134
00:08:38,852 --> 00:08:40,604
おいしそうですねえ

135
00:08:40,687 --> 00:08:42,439
ちかい　よるな！

136
00:08:42,522 --> 00:08:43,690
(ばいきんまん) ドキンちゃん

137
00:08:43,774 --> 00:08:46,068
バイキンせんにんさま から
あずかった えほんをしらない？

138
00:08:46,151 --> 00:08:46,985
(ドキン) もうっ！

139
00:08:47,069 --> 00:08:48,904
(ホラーマン) ホラッ
(ばいきんまん) イタッ！

140
00:08:48,987 --> 00:08:50,781
(ホラーマン) そこに ありますねえ

141
00:08:50,864 --> 00:08:52,824
でも なかから
なにか でてきて――

142
00:08:52,908 --> 00:08:54,618
とんでっちゃいましたよ

143
00:08:54,701 --> 00:08:57,621
ハヒッ！
まさか あけちゃったの？

144
00:08:57,704 --> 00:09:00,791
この のろわれたえほんは
ぜったいに あけちゃダメだって――

145
00:09:00,874 --> 00:09:04,378
バイキンせんにんさまから
いわれてたのに…

146
00:09:04,628 --> 00:09:07,756
そーんなことより
あたし リンゴがたべたいの～

147
00:09:07,839 --> 00:09:09,633
(ばいきんまん) ハヒ～

148
00:09:10,217 --> 00:09:12,261
(ジャム) あたらしい かおだよ

149
00:09:12,344 --> 00:09:14,513
(アンパンマン)
ありがとう ジャムおじさん

150
00:09:14,596 --> 00:09:17,266
じゃあ ＳＬマンを
むかえにいってきます

151
00:09:17,349 --> 00:09:18,558
(メロンパンナ) あたしもいく！

152
00:09:18,642 --> 00:09:19,768
(クリームパンダ) ぼくも！

153
00:09:19,851 --> 00:09:22,729
(ジャム) わたしたちは
このこをベッドに はこぼう

154
00:09:22,813 --> 00:09:23,689
(バタコさん) はい
(チーズ) アン！

155
00:09:23,772 --> 00:09:25,065
(りんごぼうや)
このこ じゃないやい

156
00:09:25,148 --> 00:09:26,275
(みんな) うん？

157
00:09:26,358 --> 00:09:28,151
ぼくは りんごぼうや

158
00:09:28,235 --> 00:09:30,320
まっててね りんごぼうや

159
00:09:30,404 --> 00:09:33,031
すぐに しんせんなリンゴを
もってくるから

160
00:09:33,699 --> 00:09:34,783
それいけ！

161
00:09:34,866 --> 00:09:37,369
(ジャム･バタコ) アンパンマーン！

162
00:09:50,549 --> 00:09:52,718
もうすぐ パンこうじょうだぞ

163
00:09:54,886 --> 00:09:55,721
それっ！

164
00:09:55,804 --> 00:09:57,264
(きてきの おと)

165
00:09:57,347 --> 00:09:59,391
(けいてきの おと)
(ＳＬマン) えっ？

166
00:10:01,059 --> 00:10:02,978
(ばいきんまん) ハヒフヘホ～

167
00:10:03,061 --> 00:10:05,897
おいしいリンゴは
おれさまが ぜんぶ いただきだ～！

168
00:10:05,981 --> 00:10:08,150
ええっ うわあ！

169
00:10:08,233 --> 00:10:10,152
(ばいきんまん) まてまて～！
(ＳＬマン) わあああ

170
00:10:12,321 --> 00:10:13,613
(ハンバーガーキッド)
いくぞ ピクルス！

171
00:10:13,697 --> 00:10:14,531
(ピクルス) ヒヒーン！

172
00:10:14,614 --> 00:10:16,283
(ハンバーガーキッド) はいやー！

173
00:10:17,451 --> 00:10:18,285
はあっ！

174
00:10:18,368 --> 00:10:19,286
(ＳＬマン) うわあ

175
00:10:19,369 --> 00:10:20,370
(ハンバーガーキッド) ＳＬマン！

176
00:10:20,454 --> 00:10:21,788
(ＳＬマン) ハンバーガーキッド！

177
00:10:22,080 --> 00:10:23,707
(ハンバーガーキッド)
もっと そくどを あげないと――

178
00:10:23,790 --> 00:10:25,167
おいつかれてしまうぞ！

179
00:10:25,250 --> 00:10:26,126
フンッ！

180
00:10:26,209 --> 00:10:30,047
おれさまの ペロリだだんだんに
かてると おもってるのか！

181
00:10:34,718 --> 00:10:35,552
(クリームパンダ) あれは！

182
00:10:37,804 --> 00:10:40,098
(アンパンマン)
なにか あったんだ　いそごう！

183
00:10:40,515 --> 00:10:43,602
うわああ～　あっ ああ…

184
00:10:47,314 --> 00:10:48,482
ああ…

185
00:10:53,236 --> 00:10:54,363
チッ！

186
00:10:55,947 --> 00:10:58,116
ありがとう ハンバーガーキッド

187
00:10:58,200 --> 00:10:59,451
(ハンバーガーキッド) うまくいったな

188
00:11:02,496 --> 00:11:03,455
(ＳＬマンたち) うわあっ！

189
00:11:03,538 --> 00:11:04,706
(きゅうブレーキの おと)

190
00:11:04,790 --> 00:11:05,832
(アンパンマン) やっ！

191
00:11:05,916 --> 00:11:08,251
(ばいきんまん) どわああ～！

192
00:11:08,335 --> 00:11:10,879
なっ… チッ　おじゃまむしが！

193
00:11:10,962 --> 00:11:12,464
いけ　かびるんるん！

194
00:11:12,547 --> 00:11:13,840
(かびるんるんたち)
かび かび かび かび～

195
00:11:15,467 --> 00:11:16,510
うわあ！

196
00:11:16,927 --> 00:11:18,470
(ＳＬマン) あぶない なかへ！

197
00:11:18,553 --> 00:11:19,930
(ピクルス) ヒヒーン

198
00:11:21,807 --> 00:11:22,682
(かびるんるんたち) かび～ かび～

199
00:11:23,892 --> 00:11:25,477
(ばいきんまん) こしゃくな～！

200
00:11:25,560 --> 00:11:26,686
(ハンバーガーキッド) うわっ

201
00:11:28,188 --> 00:11:29,773
あっ しまった！

202
00:11:30,148 --> 00:11:31,775
(ばいきんまん) まてまて～！

203
00:11:31,858 --> 00:11:33,276
(クリームパンダ) えい えいっ

204
00:11:33,360 --> 00:11:35,278
えい えいっ！

205
00:11:36,071 --> 00:11:37,364
がんばって ＳＬマン！

206
00:11:37,447 --> 00:11:38,281
うん！

207
00:11:39,366 --> 00:11:40,283
(きてきの おと)

208
00:11:45,288 --> 00:11:46,456
(アンパンマン) くっ…

209
00:11:47,833 --> 00:11:48,792
アンパンマン！

210
00:11:49,084 --> 00:11:50,669
(アンパンマン)
メロンパンナちゃんたちは――

211
00:11:50,752 --> 00:11:53,547
ＳＬマンと いっしょに
パンこうじょうへ むかって！

212
00:11:53,839 --> 00:11:54,673
(ふたり) うん！

213
00:11:54,756 --> 00:11:56,049
(きてきの おと)

214
00:11:58,552 --> 00:12:00,387
(きてきの おと)

215
00:12:00,470 --> 00:12:01,638
(メロンパンナ) ジャムおじさーん！
(ジャム) あっ

216
00:12:01,721 --> 00:12:03,390
(バタコ) あっ！
(チーズ) アンアーン

217
00:12:07,477 --> 00:12:08,603
(ジャム･バタコ) ＳＬマン！

218
00:12:08,687 --> 00:12:09,771
(チーズ) アンア～ン

219
00:12:10,021 --> 00:12:11,314
(ジャム) そ～れっ！

220
00:12:14,860 --> 00:12:17,362
(ジャム) さあ
しんせんな リンゴジュースだよ

221
00:12:17,904 --> 00:12:19,322
(バタコ) はい どうぞ

222
00:12:19,406 --> 00:12:21,324
ああっ リンゴ！

223
00:12:21,408 --> 00:12:22,451
はあっ

224
00:12:22,534 --> 00:12:23,368
ゴクゴク…

225
00:12:23,452 --> 00:12:25,245
(バタコ)
あっ そんなに あわてないで

226
00:12:25,328 --> 00:12:27,372
まだ たくさんあるから

227
00:12:27,456 --> 00:12:29,332
(りんごぼうや) ぷはっ！
(バタコ) ああ まあ

228
00:12:29,416 --> 00:12:30,375
(バタコ) ウフフフッ

229
00:12:32,002 --> 00:12:35,005
ぷはあっ　りんごー！

230
00:12:35,088 --> 00:12:35,922
りんご～ りんご～♪

231
00:12:36,006 --> 00:12:37,591
(ジャム) ああ こんなに げんきに

232
00:12:37,674 --> 00:12:39,009
(チーズ) アンアン

233
00:12:39,509 --> 00:12:40,343
(メロンパンナ)
あたしたちは――

234
00:12:40,427 --> 00:12:42,846
アンパンマンたちを
たすけに もどらないと

235
00:12:43,513 --> 00:12:45,348
うん？　どうしたの？

236
00:12:45,432 --> 00:12:47,976
(アンパンマン) アーンキーック！

237
00:12:55,150 --> 00:12:57,194
(アンパンマン) くっ…　はっ！

238
00:12:58,778 --> 00:13:00,071
よーし…

239
00:13:00,363 --> 00:13:03,074
アーンパーンチ！

240
00:13:03,158 --> 00:13:05,535
ううっ うわあ　くっ…

241
00:13:05,619 --> 00:13:07,996
うっ えい えいっ

242
00:13:08,079 --> 00:13:09,664
あっ ええい

243
00:13:10,165 --> 00:13:12,459
(ハンバーガーキッド)
ふんっ ううっ…

244
00:13:12,542 --> 00:13:14,085
くっ…　とりゃあー！

245
00:13:14,711 --> 00:13:15,545
(ばいきんまん) おお？

246
00:13:15,837 --> 00:13:17,506
(ハンバーガーキッド) くっ やあ！

247
00:13:17,589 --> 00:13:20,592
(ばいきんまん)
ぎゃああ～ うっ… うごけない～！

248
00:13:21,384 --> 00:13:22,719
アンパンマン いまだ！

249
00:13:22,802 --> 00:13:23,720
(アンパンマン) うん！

250
00:13:25,096 --> 00:13:26,932
アーンパーンチ！

251
00:13:27,015 --> 00:13:29,100
(ばいきんまん) ペロ～リ

252
00:13:29,184 --> 00:13:30,519
(アンパンマン) うっ うわぁ～！

253
00:13:30,602 --> 00:13:31,436
くっ！

254
00:13:31,686 --> 00:13:33,063
(メロンパンナ･クリームパンダ)
アンパンマン！

255
00:13:33,146 --> 00:13:34,564
(りんごぼうや) ちょっと まってよ

256
00:13:34,648 --> 00:13:37,108
(ばいきんまん) ええい こんなもの！

257
00:13:37,776 --> 00:13:38,693
(ハンバーガーキッド) うっ うう…

258
00:13:38,777 --> 00:13:39,611
(ピクルス) ヒヒン

259
00:13:40,362 --> 00:13:42,614
(メロンパンナ) アンパンマン！
(アンパンマン) あっ みんな

260
00:13:42,948 --> 00:13:45,283
あーあ　カッコわるいなあ～

261
00:13:45,367 --> 00:13:46,868
(ばいきんまん) なんだ おまえは？

262
00:13:46,952 --> 00:13:48,620
(りんごぼうや)
おまえが ばいきんまんだな！

263
00:13:49,204 --> 00:13:50,705
りんご りんご！

264
00:13:50,789 --> 00:13:52,165
カッコいいヒーロー

265
00:13:52,249 --> 00:13:55,961
りんごぼうやが あいてだ～！

266
00:13:56,586 --> 00:13:58,630
ハヒ？　そんなに おそいんじゃ――

267
00:13:58,713 --> 00:14:00,423
おれさま ねちまうぞ！

268
00:14:00,507 --> 00:14:01,633
ペロリこうげきだ！

269
00:14:01,883 --> 00:14:03,426
(りんごぼうや) うわっ！
(メロンパンナたち) わあっ

270
00:14:03,510 --> 00:14:06,221
(りんごぼうや)
コラッ よけいなこと するな！

271
00:14:06,513 --> 00:14:07,931
(クリームパンダ)
でも このままじゃ…

272
00:14:08,014 --> 00:14:09,224
(りんごぼうや) ほっといてよ！

273
00:14:09,307 --> 00:14:10,976
ぼくは ヒーローなんだぞ！

274
00:14:11,059 --> 00:14:12,561
ひとりで たたかえるんだ

275
00:14:12,644 --> 00:14:14,813
(ばいきんまん)
フンッ　ペロリひとのみだ！

276
00:14:14,896 --> 00:14:16,439
(アンパンマン) うう～ん
(ばいきんまん) ペローン

277
00:14:16,690 --> 00:14:18,733
わあっ わああ～

278
00:14:18,817 --> 00:14:20,318
(クリームパンダ)
おねえちゃん　わあっ！

279
00:14:20,610 --> 00:14:22,821
ぼくが たおしてやる　うわあ！

280
00:14:23,196 --> 00:14:26,199
うっ あっ　ああ ハア…

281
00:14:27,409 --> 00:14:29,452
あっ ぼくのたね

282
00:14:30,036 --> 00:14:31,621
さいごの １こだ

283
00:14:32,247 --> 00:14:33,331
ええい…

284
00:14:34,583 --> 00:14:35,834
(ばいきんまん) ペロ～リ

285
00:14:35,917 --> 00:14:37,335
えーい！

286
00:14:41,464 --> 00:14:42,340
(ばいきんまん) ハヒッ？

287
00:14:42,424 --> 00:14:44,342
な… なんだあ～？

288
00:14:44,426 --> 00:14:45,844
(アンパンマン) うっ くっ…

289
00:14:47,095 --> 00:14:48,263
あれは…

290
00:14:48,346 --> 00:14:49,848
(りんごぼうや) リンゴのきだよ

291
00:14:49,931 --> 00:14:51,891
(ばいきんまん)
うわは～ ここ… このっ！

292
00:14:51,975 --> 00:14:54,394
したが うまく うごかないぞ？

293
00:14:54,477 --> 00:14:55,770
(ハンバーガーキッド)
いまだ　アンパンマン

294
00:14:55,854 --> 00:14:57,397
もういちど アンパンチを！

295
00:14:57,480 --> 00:14:59,566
(アンパンマン)
うん　でも リンゴのきが…

296
00:14:59,649 --> 00:15:00,650
(りんごぼうや) え？

297
00:15:01,276 --> 00:15:02,527
(アンパンマン) そうだ！

298
00:15:02,944 --> 00:15:05,989
(ばいきんまん)
こんなき ひっこぬいてやる！

299
00:15:06,448 --> 00:15:10,327
ソフト アーンパーンチ

300
00:15:10,660 --> 00:15:12,245
(ばいきんまん) どおお～

301
00:15:12,329 --> 00:15:17,000
ソフト～ バイバイキーン

302
00:15:18,084 --> 00:15:20,003
(メロンパンナ･クリームパンダ)
やったー！

303
00:15:20,337 --> 00:15:23,340
なんだ？　あの ほんわかパンチ…

304
00:15:24,507 --> 00:15:27,218
リンゴのきが
おれないようにしたのね

305
00:15:27,302 --> 00:15:30,013
(クリームパンダ) アンパンマンって
つよいだけじゃなくて――

306
00:15:30,096 --> 00:15:32,015
とっても やさしいでしょう？

307
00:15:32,098 --> 00:15:34,768
(りんごぼうや) ん？　うーん…

308
00:15:36,394 --> 00:15:39,773
つよいだけじゃなくて… やさしい？

309
00:15:42,734 --> 00:15:45,111
あたしは しらドキひめ

310
00:15:45,195 --> 00:15:48,865
そして おうじさまは とうぜん
あの おかた…

311
00:15:56,873 --> 00:15:58,917
(しょくぱんまん) ああ あなたの――

312
00:15:59,000 --> 00:16:02,754
リンゴのように まんまるな
おかおが だいすきです

313
00:16:02,837 --> 00:16:06,758
(ドキン) しょくぱんまんさまの
しかくい おかおも すてきですわ

314
00:16:10,053 --> 00:16:11,805
(しょくぱんまん) しらドキひめ

315
00:16:11,888 --> 00:16:14,057
しょくぱんまんさま～

316
00:16:14,140 --> 00:16:16,685
もう いっしょう はなしませんよ～

317
00:16:16,768 --> 00:16:18,937
(ドキン) わたくしだって…

318
00:16:19,145 --> 00:16:20,021
いいっ？

319
00:16:20,105 --> 00:16:21,022
(ホラーマン) ホラホラ～

320
00:16:21,106 --> 00:16:24,776
ホラーマンだけに
こわいほどラブラブなんですねえ

321
00:16:24,859 --> 00:16:28,238
そして ほねのずいまで
しあわせなんですねえ～

322
00:16:28,321 --> 00:16:30,657
あのねえ～

323
00:16:31,199 --> 00:16:33,368
(ドキン) どりゃー！
(ホラーマン) うわあー

324
00:16:33,451 --> 00:16:36,079
(ばいきんまん) うわあああー！

325
00:16:36,162 --> 00:16:36,996
(ドキン) え！

326
00:16:37,080 --> 00:16:40,333
(ぶつかる おと)

327
00:16:42,627 --> 00:16:45,088
(ドキン) なんで こうなるの～

328
00:16:45,171 --> 00:16:48,299
(ばいきんまん) ドキンちゃん
リンゴのきを もってきたよ

329
00:16:48,383 --> 00:16:50,093
(ドキン) えっ ほんと？

330
00:16:50,176 --> 00:16:52,387
わーい！ フフッ

331
00:16:54,806 --> 00:16:55,807
うん？

332
00:16:56,141 --> 00:17:00,019
ふっ うっ んん…

333
00:17:02,939 --> 00:17:05,942
なによ これ
リンゴなってないじゃない！

334
00:17:06,025 --> 00:17:08,862
あたしは いますぐ たべたいの！

335
00:17:09,154 --> 00:17:10,780
トホホ…

336
00:17:14,367 --> 00:17:15,493
(ＳＬマン) みんなー！

337
00:17:15,577 --> 00:17:18,830
おいしいリンゴを
いっぱい もってきたよ

338
00:17:18,913 --> 00:17:21,207
(ジャム)
できたてのアップルパイもあるよ

339
00:17:21,624 --> 00:17:22,876
(クリームパンダ) やきリンゴに

340
00:17:22,959 --> 00:17:23,835
(メロンパンナ) リンゴパン

341
00:17:24,210 --> 00:17:26,838
(バタコ) しぼりたての
リンゴジュースも あるわよ

342
00:17:26,921 --> 00:17:28,089
アンアーン

343
00:17:29,758 --> 00:17:31,092
(にぎわう こえ)

344
00:17:31,426 --> 00:17:33,094
(ちびぞう) おいしいぞう
(カバお) はむはむ

345
00:17:33,178 --> 00:17:34,721
(ウサこ) リンゴ さいこう！

346
00:17:35,013 --> 00:17:37,849
(りんごぼうや)
やっぱり リンゴは だいにんきだね

347
00:17:37,932 --> 00:17:40,727
(アンパンマン)
うん　みんな おおよろこびだよ

348
00:17:40,810 --> 00:17:43,062
(カレーパンマン) カレーに
すりおろしたリンゴをいれると――

349
00:17:43,146 --> 00:17:44,939
ぐっと おいしくなるしな

350
00:17:45,023 --> 00:17:45,940
(しょくぱんまん) いえいえ

351
00:17:46,024 --> 00:17:49,611
リンゴジャムをたっぷりぬった
しょくぱんが さいこうですよ

352
00:17:49,694 --> 00:17:50,945
(カレーパンマン) カレーだよ！

353
00:17:51,029 --> 00:17:52,781
(しょくぱんまん) しょくぱんです！

354
00:17:52,864 --> 00:17:54,866
(ハンバーガーキッド)
あいかわらずだな

355
00:17:55,074 --> 00:17:55,992
(ピクルス) ヒヒ～ン

356
00:17:56,284 --> 00:17:57,994
(カラスの なきごえ)

357
00:17:58,369 --> 00:17:59,954
それでは みなさん

358
00:18:00,038 --> 00:18:01,164
また あおうぜ

359
00:18:01,247 --> 00:18:02,248
(ピクルス) ヒヒ～ン
(ハンバーガーキッド) はっ

360
00:18:02,332 --> 00:18:04,751
(みんな) さようなら～

361
00:18:07,086 --> 00:18:08,171
(りんごぼうや) さてと…

362
00:18:08,254 --> 00:18:11,674
そろそろ ぼくも りんごバルーンを
さがしに いかないと…

363
00:18:11,758 --> 00:18:13,092
(しょくぱんまん･カレーパンマン)
りんごバルーン？

364
00:18:13,176 --> 00:18:14,010
(りんごぼうや) うん

365
00:18:14,093 --> 00:18:18,014
りんごバルーンがないと
ぼくは ふるさとに かえれないんだ

366
00:18:18,389 --> 00:18:22,268
(メロンパンナ)
ねえ りんごぼうやの ふるさとって
どんなところなの？

367
00:18:22,477 --> 00:18:25,104
そりゃ とっても いいところさ！

368
00:18:25,188 --> 00:18:30,026
みずも くうきも きれいで
リンゴのみが いーっぱい なって…

369
00:18:30,109 --> 00:18:32,153
あっ　でも…

370
00:18:32,237 --> 00:18:33,446
(バタコ) どうしたの？

371
00:18:33,530 --> 00:18:35,156
(ジャム) なにか あったのかい？

372
00:18:35,657 --> 00:18:36,699
うん…

373
00:18:38,576 --> 00:18:39,661
(バタコ･ジャム) ええっ！

374
00:18:39,953 --> 00:18:43,164
(ジャム) あさ おきたら
リンゴが ぜんぶ どくリンゴに？

375
00:18:43,581 --> 00:18:45,834
(りんごぼうや) だから
ぼくは ふるさとをでて――

376
00:18:45,917 --> 00:18:48,169
まほうのたねを さがすことにしたんだ

377
00:18:48,503 --> 00:18:49,879
(メロンパンナ) まほうのたね？

378
00:18:49,963 --> 00:18:50,839
(りんごぼうや) うん

379
00:18:50,922 --> 00:18:53,633
そのたねは
どんなところでも そだって――

380
00:18:53,716 --> 00:18:57,011
せかいいち おおきな
リンゴのみをつけるっていう――

381
00:18:57,095 --> 00:18:58,596
いいつたえが あるんだ

382
00:18:58,680 --> 00:18:59,681
(クリームパンダ) へえー！

383
00:18:59,931 --> 00:19:01,599
(りんごぼうや)
まほうのたねが あれば――

384
00:19:01,683 --> 00:19:05,270
ぼくのふるさとも
きっと もとどおりになるよ

385
00:19:06,938 --> 00:19:08,982
はい ホラーマンです

386
00:19:09,065 --> 00:19:10,692
まほうのたね ですか

387
00:19:10,984 --> 00:19:13,695
ふしぎですね～ ホラーですね～

388
00:19:14,320 --> 00:19:17,448
(ホラーマン) いじょう げんばから
ホラーマンが おつたえしました

389
00:19:17,991 --> 00:19:19,158
どうせ たべるなら――

390
00:19:19,242 --> 00:19:21,953
せかいいち おおきなリンゴが
たべた～い

391
00:19:22,036 --> 00:19:23,454
おれさまも～

392
00:19:23,830 --> 00:19:25,707
(ジャム)
じゃあ その まほうのたねは――

393
00:19:25,790 --> 00:19:28,710
せかいいち おおきなリンゴから
とれるんだね

394
00:19:28,793 --> 00:19:30,879
(りんごぼうや)
うん　だから まずは――

395
00:19:30,962 --> 00:19:34,215
せかいいち
おおきなリンゴのきを さがすんだ

396
00:19:34,299 --> 00:19:36,342
(アンパンマン)
それなら ぼくも いっしょに

397
00:19:36,426 --> 00:19:37,385
(メロンパンナ) あたしも！

398
00:19:37,468 --> 00:19:38,303
(クリームパンダ) ぼくも！

399
00:19:38,386 --> 00:19:39,596
(りんごぼうや) えっ ほんとに？

400
00:19:39,804 --> 00:19:40,847
(３にん) うん！

401
00:19:41,472 --> 00:19:44,767
りんごバルーンは
おれたちが みつけてやるよ

402
00:19:44,976 --> 00:19:46,269
(しょくぱんまん) おまかせください

403
00:19:46,352 --> 00:19:47,854
(りんごぼうや) やったー！

404
00:19:47,937 --> 00:19:51,733
(クリームパンダ)
ねえ りんごぼうやは
なんで マスクをつけてるの？

405
00:19:51,816 --> 00:19:54,986
(りんごぼうや) だって
ヒーローは カッコよくなくっちゃ！

406
00:19:55,069 --> 00:19:55,987
マスクがあれば――

407
00:19:56,070 --> 00:19:59,073
わるいやつも
ぼくを こわがって にげていくよ

408
00:19:59,157 --> 00:20:02,035
たあー！　とうっ！ ってね

409
00:20:02,118 --> 00:20:03,995
(ジャム) うん たしかに

410
00:20:04,078 --> 00:20:05,872
(バタコ) とっても カッコいいわ

411
00:20:05,955 --> 00:20:07,040
(りんごぼうや) ウフフフ

412
00:20:07,123 --> 00:20:08,374
(おなかがなる おと)

413
00:20:08,458 --> 00:20:10,627
(りんごぼうや) あっ
(バタコ) ごはんにしましょ

414
00:20:10,919 --> 00:20:12,879
(りんごぼうや) わーい！

415
00:20:12,962 --> 00:20:18,968
♪～

416
00:20:19,052 --> 00:20:21,763
(りんごぼうや) ふっ ああ… あっ

417
00:20:21,846 --> 00:20:22,889
ハア～

418
00:20:23,598 --> 00:20:26,976
(かぜのおと)
(りんごぼうや) うわああ～！

419
00:20:29,020 --> 00:20:30,813
(アンパンマーン)

420
00:20:30,897 --> 00:20:33,566
♪ なんのために飛ぶ

421
00:20:34,400 --> 00:20:36,986
♪ なにがぼくを呼ぶ

422
00:20:38,029 --> 00:20:44,160
♪ 流れる 風には パンの かおり

423
00:20:45,036 --> 00:20:47,914
♪ 涙なんか バイバイ

424
00:20:48,498 --> 00:20:51,542
♪ 元気だせよ バイバイ

425
00:20:52,335 --> 00:20:55,588
♪ ゆかいな 仲間の

426
00:20:55,672 --> 00:20:59,092
♪ 歌声が きこえるよ

427
00:21:01,177 --> 00:21:04,263
♪ おそれはしない

428
00:21:04,764 --> 00:21:07,809
♪ くじけはしない

429
00:21:08,351 --> 00:21:11,479
♪ どんなに強い

430
00:21:12,230 --> 00:21:15,066
♪ あいてでも

431
00:21:15,650 --> 00:21:19,320
♪ 正義をまもるためなら

432
00:21:19,404 --> 00:21:22,949
♪ アンパンチ！

433
00:21:23,032 --> 00:21:25,034
(アンパンマーン！)

434
00:21:37,255 --> 00:21:43,261
～♪

435
00:21:43,553 --> 00:21:45,763
リンゴのきだ！　アハハ

436
00:21:46,097 --> 00:21:47,807
うわーい！

437
00:21:48,808 --> 00:21:50,268
あっ　ああ…

438
00:21:53,688 --> 00:21:55,898
(クリームパンダ)
ふつうのリンゴのきだ

439
00:21:55,982 --> 00:21:57,859
(りんごぼうや) また ちがってた

440
00:21:57,942 --> 00:22:01,779
もう～
なんで みつからないんだよ

441
00:22:02,113 --> 00:22:04,115
(あめのおと)

442
00:22:04,198 --> 00:22:05,324
(クリームパンダ) あめだ！

443
00:22:05,408 --> 00:22:06,534
(アンパンマン) こっちへ！

444
00:22:09,704 --> 00:22:12,248
(りんごぼうや)
なんか もう イヤんなってきた

445
00:22:12,331 --> 00:22:13,291
(アンパンマンたち) えっ？

446
00:22:13,708 --> 00:22:16,502
まほうのたねは みつからないし

447
00:22:16,586 --> 00:22:21,174
アンパンマンは かおをあげると
ちからが なくなっちゃうし

448
00:22:21,257 --> 00:22:22,341
うん

449
00:22:22,425 --> 00:22:23,801
(りんごぼうや)
まほうのたね なんて――

450
00:22:23,885 --> 00:22:25,845
さいしょから なかったんだよ

451
00:22:25,928 --> 00:22:27,430
あきらめないで

452
00:22:27,513 --> 00:22:29,265
もうちょっと がんばってみよう

453
00:22:29,348 --> 00:22:32,060
ヤダ ヤダッ ヤダー！

454
00:22:32,143 --> 00:22:34,062
もう じゅうぶん さがしたもん

455
00:22:34,145 --> 00:22:36,147
ぼくは カッコいい
ヒーローになりたいのに――

456
00:22:36,230 --> 00:22:38,691
なんで こんな カッコわるいこと
しなきゃいけないの？

457
00:22:39,025 --> 00:22:40,193
なんで なんで？

458
00:22:40,485 --> 00:22:41,527
ヤダよー！

459
00:22:41,611 --> 00:22:42,612
うわあ～！

460
00:22:42,695 --> 00:22:43,988
(アンパンマン) りんごぼうや！

461
00:22:44,906 --> 00:22:46,032
ふっ！　くっ…

462
00:22:46,115 --> 00:22:48,743
うう… くっ うっ

463
00:22:48,826 --> 00:22:50,912
うっ うっ んー うっ

464
00:22:52,121 --> 00:22:53,581
うう…

465
00:22:54,373 --> 00:22:55,416
だいじょうぶ？

466
00:22:56,375 --> 00:22:57,668
(りんごぼうや) うん…

467
00:22:58,503 --> 00:23:00,088
よかった

468
00:23:00,588 --> 00:23:01,672
(りんごぼうや) あ…

469
00:23:02,131 --> 00:23:04,050
(きかいの おと)

470
00:23:11,015 --> 00:23:14,352
ばいきんまん
あたしの リンゴは まだ？

471
00:23:14,435 --> 00:23:16,145
あわてない あわてない

472
00:23:16,229 --> 00:23:19,107
まずは あたらしいメカを
つくってからなの

473
00:23:25,863 --> 00:23:27,281
(アンパンマン) りんごぼうや

474
00:23:27,365 --> 00:23:28,366
うん？

475
00:23:32,245 --> 00:23:34,038
ほしをみていたの？

476
00:23:34,122 --> 00:23:35,164
(りんごぼうや) うん…

477
00:23:35,706 --> 00:23:37,542
きれいな ほしだね

478
00:23:37,750 --> 00:23:41,838
ほら あのほしと
あのほしをつないでいくと…

479
00:23:43,214 --> 00:23:45,800
ああっ リンゴのかたちになった

480
00:23:46,300 --> 00:23:51,222
りんごぼうやの ふるさとでも
ほしが きれいに みえるんだろうね

481
00:23:51,639 --> 00:23:53,141
(りんごぼうや) うん
(アンパンマン) ん？

482
00:23:54,433 --> 00:23:55,852
りんごぼうや

483
00:23:55,935 --> 00:23:56,978
うん？

484
00:23:57,520 --> 00:24:01,149
ふるさとに かえりたいなら
ぼくが つれていってあげるよ

485
00:24:01,649 --> 00:24:03,109
わあ～

486
00:24:03,442 --> 00:24:04,360
あ…

487
00:24:05,278 --> 00:24:08,239
りんごバルーンがないと かえれないし

488
00:24:08,322 --> 00:24:09,157
それに…

489
00:24:09,490 --> 00:24:10,449
(アンパンマン) ん？

490
00:24:10,658 --> 00:24:12,827
まほうのたねが ないんじゃ…

491
00:24:13,119 --> 00:24:15,496
でも みんな しんぱいしてるよ

492
00:24:15,580 --> 00:24:16,664
(りんごぼうや) そんなこと ないよ！

493
00:24:16,747 --> 00:24:17,665
(アンパンマン) あ…

494
00:24:18,082 --> 00:24:20,168
ぼく ふるさとをでるとき…

495
00:24:24,672 --> 00:24:27,341
(りんごたち)
よいっしょ よしっ それっ

496
00:24:27,425 --> 00:24:29,719
(りんごぼうや)
りんご～ りんご～ りんご～♪

497
00:24:29,927 --> 00:24:32,722
りんごぼうや さんじょう　とうっ！

498
00:24:33,472 --> 00:24:34,765
なにしてるの？

499
00:24:34,849 --> 00:24:36,475
(りんごＡ) はたけづくりさ

500
00:24:36,559 --> 00:24:38,186
(りんごぼうや)
はたけづくり？

501
00:24:38,269 --> 00:24:39,228
(りんごＢ) ええ

502
00:24:39,312 --> 00:24:41,480
りんごぼうやも
おてつだいしてね

503
00:24:41,564 --> 00:24:44,275
(りんごぼうや)
ええ～ めんどくさ～い

504
00:24:44,358 --> 00:24:45,610
(りんごＡ)
めんどくさくても――

505
00:24:45,693 --> 00:24:47,028
リンゴは
こころをこめて――

506
00:24:47,111 --> 00:24:49,113
じっくりと
そだてないとね

507
00:24:49,614 --> 00:24:51,616
こころをこめて じっくりと？

508
00:24:52,158 --> 00:24:54,243
そうよ　これまでは――

509
00:24:54,327 --> 00:24:56,913
たねをうえると
かんたんに そだっていたから――

510
00:24:56,996 --> 00:24:59,874
そんな たいせつなことを
わすれていたの

511
00:25:00,082 --> 00:25:01,250
ヤダヤダ

512
00:25:01,334 --> 00:25:03,878
どろだらけに なるなんて
カッコわるいもん

513
00:25:03,961 --> 00:25:06,714
ぼくは カッコいい
ヒーローになりたいんだ

514
00:25:06,797 --> 00:25:08,341
ウフフ　あっ そうだ

515
00:25:08,424 --> 00:25:11,093
ぼくは まほうのたねを
さがしにいくよ

516
00:25:11,177 --> 00:25:12,720
まほうのたね？

517
00:25:12,803 --> 00:25:13,971
しらないの？

518
00:25:14,055 --> 00:25:17,433
まほうのたねをうえると
どんなところでも そだって――

519
00:25:17,516 --> 00:25:19,268
せかいいち おおきなりんごが…

520
00:25:19,352 --> 00:25:20,353
(りんごＡ) なに いってる！

521
00:25:20,436 --> 00:25:22,063
そんなものが あるわけがない！

522
00:25:22,146 --> 00:25:23,272
(りんごぼうや) きっと あるよ！

523
00:25:23,356 --> 00:25:24,273
(りんごＡ) ないっ！

524
00:25:24,857 --> 00:25:26,025
あるってば！

525
00:25:26,108 --> 00:25:28,486
ぼくなら
ぜーったいに みつけられる！

526
00:25:30,863 --> 00:25:31,989
みてろ～

527
00:25:32,073 --> 00:25:33,866
ぜったいに
みつけてきてやる

528
00:25:33,950 --> 00:25:36,202
(りんごたち)
りんごぼうやー！

529
00:25:37,411 --> 00:25:38,246
(りんごぼうや) でも――

530
00:25:38,704 --> 00:25:41,249
まほうのたねは みつからなかった

531
00:25:41,332 --> 00:25:44,669
だから
だれも ぼくの しんぱいなんか…

532
00:25:44,877 --> 00:25:46,337
りんごぼうや

533
00:25:46,879 --> 00:25:48,297
げんきをだして

534
00:25:48,381 --> 00:25:49,382
(りんごぼうや) あ…

535
00:25:52,134 --> 00:25:53,094
あむっ

536
00:25:54,178 --> 00:25:55,638
おいしい！

537
00:25:55,721 --> 00:25:59,350
(アンパンマン) ぼくは いつ
どんなときだって きみのそばにいるよ

538
00:25:59,433 --> 00:26:00,393
(りんごぼうや) えっ？

539
00:26:00,893 --> 00:26:01,811
ねえ

540
00:26:01,894 --> 00:26:04,605
なんで そんなに
やさしくしてくれるの？

541
00:26:05,022 --> 00:26:08,276
こまっているひとをみると
たすけたくなるんだよ

542
00:26:11,320 --> 00:26:13,447
でも どろだらけになったり――

543
00:26:13,531 --> 00:26:14,657
ちからが よわくなって――

544
00:26:14,740 --> 00:26:16,242
カッコわるくなったり…

545
00:26:16,325 --> 00:26:17,910
(アンパンマン) ポカポカするんだ
(りんごぼうや) え？

546
00:26:18,286 --> 00:26:19,829
だれかをたすけると――

547
00:26:19,912 --> 00:26:22,999
むねが ポカポカして
あたたかくなるんだ

548
00:26:23,708 --> 00:26:25,001
むねが？

549
00:26:29,380 --> 00:26:30,548
(バタコ) そうだ！
(メロンパンナたち) うん？

550
00:26:30,631 --> 00:26:33,467
(バタコ) リンゴのことは
りんごちゃんに きいてみたら？

551
00:26:33,551 --> 00:26:35,678
(ジャム) うん それがいい

552
00:26:36,262 --> 00:26:38,681
(チーズ) アンアーン

553
00:26:38,973 --> 00:26:40,683
(ドキン) ばいきんまーん

554
00:26:41,684 --> 00:26:45,229
いつになったら リンゴ
たべさせてくれるのよ？

555
00:26:45,313 --> 00:26:47,356
まあまあ　もうちょっと まって

556
00:26:47,440 --> 00:26:48,399
(つうちおん)

557
00:26:48,482 --> 00:26:50,943
おっ ホラーマンからの ちゅうけいだ

558
00:26:51,610 --> 00:26:54,196
(ホラーマン)
はい げんばのホラーマンです

559
00:26:54,864 --> 00:26:58,534
アンパンマンたちは まほうのたねの
てがかりをもとめて――

560
00:26:58,617 --> 00:27:00,828
りんごちゃんに あいに いくようです

561
00:27:00,911 --> 00:27:04,206
いじょう
ホラーマンが おつたえいたしました

562
00:27:05,207 --> 00:27:06,042
よーし！

563
00:27:06,125 --> 00:27:09,545
おれさまたちのために
がんばって みつけんだぞ！

564
00:27:09,628 --> 00:27:10,463
イテッ

565
00:27:10,546 --> 00:27:12,798
(エンジンの おと)

566
00:27:20,639 --> 00:27:21,474
わあ

567
00:27:23,768 --> 00:27:25,061
(アンパンマン) りんごちゃん！

568
00:27:33,277 --> 00:27:34,445
(りんご) はじめまして

569
00:27:34,528 --> 00:27:35,946
あたしは りんごちゃんです

570
00:27:36,572 --> 00:27:38,449
(りんごぼうや) ぼくは りんごぼうや

571
00:27:38,741 --> 00:27:40,659
へえ～ マスクか

572
00:27:40,743 --> 00:27:43,162
ああっ はっぱのはねも！ とべるの？

573
00:27:43,245 --> 00:27:44,955
りんごぼうや ヒーローみたい！

574
00:27:45,039 --> 00:27:47,291
ヒ… ヒーローなんかじゃないよ

575
00:27:47,375 --> 00:27:48,834
ふ～ん いいなあ

576
00:27:48,918 --> 00:27:50,628
(りんごぼうや) あの…
(りんご) え？

577
00:27:52,088 --> 00:27:53,422
(りんご) まほうのたね？

578
00:27:53,714 --> 00:27:55,466
しらないなあ

579
00:27:55,549 --> 00:27:56,926
(りんごぼうや) やっぱり…

580
00:27:57,009 --> 00:27:59,845
(クリームパンダ) じゃあ
せかいいち おおきな リンゴのきは？

581
00:27:59,929 --> 00:28:02,765
(りんご)
うーん…　きいたこと ないなあ

582
00:28:02,848 --> 00:28:03,849
(りんごぼうや) そっか…

583
00:28:03,933 --> 00:28:04,767
(ジャム) どうだろう――

584
00:28:04,850 --> 00:28:07,937
りんごちゃんの
リンゴづくりを みせてもらったら

585
00:28:08,229 --> 00:28:09,188
え？

586
00:28:09,605 --> 00:28:10,439
(りんご) ウフッ

587
00:28:10,856 --> 00:28:11,857
あ…

588
00:28:14,026 --> 00:28:14,944
(カレーパンマン) どうだ？

589
00:28:15,528 --> 00:28:16,821
こっちは ダメです

590
00:28:16,904 --> 00:28:18,197
おーい！

591
00:28:18,280 --> 00:28:20,991
りんごバルーンは みつかりましたか？

592
00:28:25,037 --> 00:28:26,455
(クータン) ううん

593
00:28:26,664 --> 00:28:27,998
そうですか…

594
00:28:28,082 --> 00:28:29,959
うみは ひろいからなあ

595
00:28:30,042 --> 00:28:33,963
(クータン) ぼく もっとたくさんの
うみのなかまに こえをかけてみるよ

596
00:28:34,046 --> 00:28:35,256
(しょくぱんまん) おねがいします

597
00:28:35,339 --> 00:28:38,300
(カレーパンマン) よーし
じゃあ もうひとがんばりするか！

598
00:28:44,181 --> 00:28:45,015
ウフッ

599
00:28:46,851 --> 00:28:49,770
(たきの おと)

600
00:28:56,986 --> 00:28:59,905
(しんこきゅうをする こえ)

601
00:28:59,989 --> 00:29:00,948
うん？

602
00:29:05,411 --> 00:29:07,663
あれ？ げんきないな

603
00:29:07,746 --> 00:29:10,291
(りんご)
うん　あたしも しんぱいなの

604
00:29:10,374 --> 00:29:11,876
あっ りんごちゃん

605
00:29:12,334 --> 00:29:15,087
だから たいせつに おせわしてるの

606
00:29:16,338 --> 00:29:18,507
ねえ だいじょうぶ？

607
00:29:19,800 --> 00:29:22,303
わるいところがあったら
おしえてね

608
00:29:22,595 --> 00:29:24,930
おひさまは
ちゃんと あたってる？

609
00:29:25,014 --> 00:29:26,807
おみずは たりてる？

610
00:29:27,057 --> 00:29:30,478
あせらなくていいからね
だいじょうぶだよ

611
00:29:30,561 --> 00:29:32,688
あたしが ついてるからね

612
00:29:34,773 --> 00:29:35,733
あ…

613
00:29:36,859 --> 00:29:38,110
(アンパンマン) ぼくは いつ――

614
00:29:38,194 --> 00:29:41,238
どんなときだって きみのそばにいるよ

615
00:29:41,989 --> 00:29:43,365
だれかをたすけると――

616
00:29:43,449 --> 00:29:46,702
むねが ポカポカして
あたたかくなるんだ

617
00:29:50,247 --> 00:29:51,081
うん！

618
00:29:53,792 --> 00:29:56,170
りんごちゃん　ぼくにも てつだわせて

619
00:29:56,253 --> 00:29:57,838
(りんご) え？　アハハッ

620
00:29:57,922 --> 00:29:58,881
(アンパンマン) ぼくたちも！

621
00:29:58,964 --> 00:30:00,216
(ふたり) あっ

622
00:30:02,134 --> 00:30:03,219
(りんごぼうや) アンパンマン！

623
00:30:03,719 --> 00:30:04,970
フフフッ

624
00:30:05,054 --> 00:30:12,061
♪～

625
00:30:18,817 --> 00:30:19,777
フウ～

626
00:30:21,570 --> 00:30:22,530
フフフフッ

627
00:30:22,613 --> 00:30:24,156
アハハハッ

628
00:30:33,582 --> 00:30:40,589
～♪

629
00:30:40,673 --> 00:30:44,009
(かみなりと あらしの おと)

630
00:30:44,093 --> 00:30:46,262
(りんご) ハアハア… あっ！

631
00:30:49,181 --> 00:30:50,474
りんごぼうや！

632
00:30:51,016 --> 00:30:52,434
(りんごぼうや) ううっ

633
00:30:52,518 --> 00:30:54,853
りんごちゃん
ここは ぼくに まかせて

634
00:30:54,937 --> 00:30:55,771
(りんご) ううん

635
00:30:56,313 --> 00:30:57,523
あたしも いっしょに

636
00:30:58,107 --> 00:30:59,441
(りんごぼうや) ぬれちゃうよ！

637
00:30:59,525 --> 00:31:01,026
(りんご) りんごぼうやだって！

638
00:31:01,110 --> 00:31:02,528
(りんごぼうや) ぼくは へっちゃらさ

639
00:31:03,153 --> 00:31:05,656
(りんご)
りんごぼうやって やさしいのね

640
00:31:05,739 --> 00:31:06,615
(りんごぼうや) えっ？

641
00:31:06,699 --> 00:31:07,533
ありがとう

642
00:31:08,951 --> 00:31:09,785
あっ

643
00:31:11,704 --> 00:31:15,291
なんか
むねが ポカポカする

644
00:31:15,499 --> 00:31:16,750
フフフッ

645
00:31:22,423 --> 00:31:25,009
(カレーパンマン)
いったい どこに きえちまったんだ？

646
00:31:25,092 --> 00:31:26,552
(しょくぱんまん) ん？　あれは…

647
00:31:26,635 --> 00:31:28,304
(カモメの なきごえ)

648
00:31:37,104 --> 00:31:38,564
ヌラじゃねえか！

649
00:31:42,943 --> 00:31:44,236
(クータン) あー！

650
00:31:44,320 --> 00:31:45,779
これだよ！

651
00:31:45,863 --> 00:31:46,905
やりましたね

652
00:31:46,989 --> 00:31:47,823
ああ！

653
00:31:58,626 --> 00:32:01,587
うわあ～　はなが さいた

654
00:32:02,087 --> 00:32:05,299
(りんご) みんなのおかげで
すっかり げんきになったわ

655
00:32:05,382 --> 00:32:08,469
(りんごぼうや) ぼく
リンゴづくりで たいせつなことが――

656
00:32:08,552 --> 00:32:10,179
やっとわかったよ

657
00:32:11,388 --> 00:32:15,100
みんなで ちからをあわせれば
きっと なんとかなるんだね

658
00:32:15,184 --> 00:32:17,645
(りんごたち) フフフッ

659
00:32:17,770 --> 00:32:20,105
(カレーパンマン) おーい みんな～！
(アンパンマンたち) あっ？

660
00:32:20,397 --> 00:32:23,025
(しょくぱんまん)
りんごバルーンが みつかりましたよ

661
00:32:23,317 --> 00:32:25,152
(りんごぼうや) わ～い！

662
00:32:25,235 --> 00:32:27,655
(アンパンマン)
これで ふるさとに かえれるね

663
00:32:27,738 --> 00:32:28,739
(りんごぼうや) うん！

664
00:32:29,281 --> 00:32:30,115
(みんな) えっ？

665
00:32:30,824 --> 00:32:33,035
(ストローこうもりの なきごえ)

666
00:32:33,494 --> 00:32:34,328
あれは…

667
00:32:34,411 --> 00:32:35,871
(しょくぱんまん･カレーパンマン)
ストローこうもり！

668
00:32:37,956 --> 00:32:39,249
(ストローこうもりの なきごえ)

669
00:32:51,136 --> 00:32:51,970
(アンパンマンたち) ああっ！

670
00:32:52,054 --> 00:32:54,264
(カレーパンマン)
あっ　あっちからも なにかくるぞ！

671
00:32:55,349 --> 00:32:56,767
(ばいきんまん) まてまて～！

672
00:32:57,267 --> 00:32:58,310
(ジャムたち) ばいきんまん！

673
00:32:58,394 --> 00:33:01,063
しらドキひめも いま～す

674
00:33:01,146 --> 00:33:04,817
ホネのあるリポーター
ホラーマンもいます ホラ～

675
00:33:05,109 --> 00:33:06,735
(かびるんるん) かびかびかび～

676
00:33:06,819 --> 00:33:09,822
いけ！
しんがた ペロリだだんだん！

677
00:33:13,867 --> 00:33:16,787
(ストローこうもりの なきごえ)

678
00:33:17,204 --> 00:33:19,665
(カレーパンマン) ばいきんまんのやつ
どうしちまったんだ？

679
00:33:19,915 --> 00:33:22,668
(ばいきんまん) リンゴは ぜんぶ
おれさまのものだー！

680
00:33:22,751 --> 00:33:24,461
(しょくぱんまん) そういうことですか

681
00:33:24,545 --> 00:33:26,630
(ジャム) ふたりとも こっちへ

682
00:33:26,714 --> 00:33:27,631
(アンパンマン) さあ はやく！

683
00:33:27,715 --> 00:33:28,549
(りんごぼうや) ううん

684
00:33:28,757 --> 00:33:30,843
ぼくは　リンゴをまもる

685
00:33:30,926 --> 00:33:31,802
(アンパンマン) りんごぼうや…

686
00:33:31,885 --> 00:33:34,847
(ストローこうもりの なきごえ)

687
00:33:37,224 --> 00:33:40,853
(マジョーラ)
マジョマジョ マジョ～！

688
00:33:41,061 --> 00:33:41,937
(ばいきんまん) なんだあ～？

689
00:33:42,020 --> 00:33:45,649
(マジョーラ)
わたしは まじょのなかでも
いちばん わるいまじょ――

690
00:33:45,733 --> 00:33:47,651
くろまじょ マジョーラさ

691
00:33:47,735 --> 00:33:50,487
(ホラーマン)
ホラ？　あれは たしか…

692
00:33:50,571 --> 00:33:53,407
この えほんのなかにいた
くろまじょです

693
00:33:53,490 --> 00:33:55,868
たいへんなことに なりました　ホラ～

694
00:33:55,951 --> 00:33:56,785
フンッ

695
00:33:56,869 --> 00:34:00,205
おれさまに たおされたくなかったら
おとなしくしてろ！

696
00:34:00,289 --> 00:34:03,876
マジョマジョ
えらそうに さしず するんじゃないよ

697
00:34:03,959 --> 00:34:08,046
あたしは せかいじゅうのリンゴを
どくリンゴにしてやるのさ

698
00:34:12,217 --> 00:34:14,261
(ばいきんまん) ハヒフヘホー！

699
00:34:14,344 --> 00:34:15,721
どうだー！

700
00:34:15,804 --> 00:34:17,848
えーい けがらわしい！

701
00:34:20,684 --> 00:34:23,061
(マジョーラ) マジョマジョ マジョ～

702
00:34:23,270 --> 00:34:25,564
(ばいきんまん) ハヒフヘホー！

703
00:34:27,149 --> 00:34:30,569
これが ほんとの
ペロリだだんだん２ごうだ！

704
00:34:39,244 --> 00:34:42,498
いけー　ペロリだだんだん２ごう！

705
00:34:44,124 --> 00:34:45,542
(ばいきんまん) とりゃ～！
(ドキン) わあ～

706
00:34:45,626 --> 00:34:46,543
マジョ～

707
00:34:52,049 --> 00:34:53,425
(ばいきんまん) ええっ！

708
00:34:54,468 --> 00:34:57,513
(ドキン) なによ！
ぜんぜん つよくなってないじゃない

709
00:34:57,596 --> 00:34:58,639
(ばいきんまん) ちがうんだって――

710
00:34:58,722 --> 00:35:00,974
ペロリだだんだん２ごうは
こんなもんじゃ…

711
00:35:01,058 --> 00:35:02,226
(ふたり) ええっ！

712
00:35:02,309 --> 00:35:04,353
あっ コラッ　なにすんだ！

713
00:35:04,436 --> 00:35:06,438
イヤ こんなの～

714
00:35:06,522 --> 00:35:09,191
こわいですね　ホラーですね～

715
00:35:09,483 --> 00:35:11,735
マジョーラ　ぼくたちが あいてだ！

716
00:35:11,819 --> 00:35:12,778
いくぜ！

717
00:35:12,861 --> 00:35:13,695
ええ！

718
00:35:13,779 --> 00:35:15,197
アーンパーンチ！

719
00:35:15,531 --> 00:35:16,698
しょくパーンチ！

720
00:35:16,782 --> 00:35:18,617
カレーパーンチ！

721
00:35:18,867 --> 00:35:20,619
(マジョーラ) フン フン

722
00:35:20,911 --> 00:35:21,870
(アンパンマン) えいっ

723
00:35:23,539 --> 00:35:24,498
(しょくぱんまん) えいっ

724
00:35:26,124 --> 00:35:27,251
(カレーパンマン) はあっ！

725
00:35:27,751 --> 00:35:28,585
(マジョーラ) フンッ

726
00:35:29,294 --> 00:35:30,879
アンパンチが きかない

727
00:35:30,963 --> 00:35:33,090
(しょくぱんまん) これでは…
(カレーパンマン) キリがないぜ

728
00:35:33,173 --> 00:35:35,425
マジョマジョ マジョ～！

729
00:35:35,509 --> 00:35:36,552
(３にん) くっ

730
00:35:39,179 --> 00:35:41,098
(アンパンマン) ああっ えい やあ！

731
00:35:41,348 --> 00:35:43,600
げきからカレーだ　とりゃ～！

732
00:35:45,602 --> 00:35:46,895
カレーパンマン！

733
00:35:46,979 --> 00:35:47,938
(しょくぱんまん) わあっ

734
00:35:48,021 --> 00:35:48,981
(アンパンマン) しょくぱんまん！

735
00:35:49,064 --> 00:35:50,607
(カレーパンマン) いま いくぞ！

736
00:35:51,191 --> 00:35:52,484
(しょくぱんまん) カレーパンマン！

737
00:35:52,776 --> 00:35:53,694
マジョ～！

738
00:35:53,777 --> 00:35:54,695
(ふたり) うわあっ

739
00:35:54,778 --> 00:35:56,029
(カレーパンマン) しまった！

740
00:35:56,321 --> 00:35:58,115
うわあっ あっ

741
00:35:58,365 --> 00:35:59,199
ああっ

742
00:35:59,491 --> 00:36:00,742
(ドキン) うわあ～
(カレーパンマン) わあっ！

743
00:36:00,826 --> 00:36:02,244
おそろいよ～

744
00:36:07,291 --> 00:36:08,750
(りんごぼうや) やめろ！

745
00:36:09,167 --> 00:36:10,002
あっ

746
00:36:10,294 --> 00:36:13,672
(メロンパンナ)
メロンパンナの メロメロパーンチ！

747
00:36:15,716 --> 00:36:20,220
(クリームパンダ)
グー･チョキ･パンチの パー！

748
00:36:20,804 --> 00:36:22,973
ええい じゃまをするな！

749
00:36:23,307 --> 00:36:25,475
(メロンパンナたち)
うわああっ　うう…

750
00:36:26,018 --> 00:36:28,604
(りんごぼうや) クリームパンダちゃん
メロンパンナちゃん

751
00:36:28,687 --> 00:36:29,521
あっ！

752
00:36:29,605 --> 00:36:31,315
おまえもだよ！

753
00:36:31,398 --> 00:36:32,232
あぶないっ

754
00:36:32,774 --> 00:36:34,359
はあああっ！

755
00:36:34,985 --> 00:36:37,279
うっ… アンパンマン！

756
00:36:37,362 --> 00:36:39,197
にげて りんごぼうや

757
00:36:39,656 --> 00:36:42,659
(ジャム) いかん
あたらしい かおを やくよ

758
00:36:42,743 --> 00:36:44,202
(バタコ) はい
(チーズ) アン アアーン

759
00:36:44,745 --> 00:36:45,954
(ジャムたち) ハアハア…

760
00:36:46,163 --> 00:36:49,291
ハッハー　おまえらもだ！

761
00:36:49,374 --> 00:36:51,084
(バタコ) きゃあ
(ジャム) うわあ

762
00:36:53,253 --> 00:36:54,254
(りんごぼうや) ああっ

763
00:36:54,338 --> 00:36:57,633
(マジョーラ) マジョマジョマジョ～
(りんごぼうや) ハッ！

764
00:36:58,300 --> 00:37:00,969
(だいちが われるおと)

765
00:37:01,345 --> 00:37:02,346
(りんごぼうや) うわっ！

766
00:37:08,185 --> 00:37:10,520
マジョマジョ マジョマジョ～

767
00:37:10,604 --> 00:37:14,358
まじょは じめじめとした
くらやみが だいすきなのさ

768
00:37:14,441 --> 00:37:17,027
せかいじゅうのリンゴを
どくリンゴにして――

769
00:37:17,110 --> 00:37:20,739
みらいを
まっくらやみにしてあげるよ～

770
00:37:21,198 --> 00:37:22,783
もう ダメだ…

771
00:37:22,866 --> 00:37:24,910
(りんご) りんごぼうや～
(りんごぼうや) あっ！

772
00:37:26,620 --> 00:37:27,746
ハアハア…

773
00:37:28,121 --> 00:37:29,122
りんごちゃん！

774
00:37:32,668 --> 00:37:33,669
ああっ

775
00:37:37,422 --> 00:37:39,091
(りんごぼうや) リンゴが…
(りんご) うん

776
00:37:44,513 --> 00:37:45,722
(アンパンマン) あきらめないで

777
00:37:46,390 --> 00:37:48,225
もうちょっと がんばってみよう

778
00:37:49,184 --> 00:37:50,018
うん！

779
00:37:50,852 --> 00:37:52,312
あきらめないぞ！

780
00:37:52,396 --> 00:37:54,773
(マジョーラ) チッ イヤな ひかりだね

781
00:37:54,856 --> 00:37:56,024
こうしてやる！

782
00:37:56,566 --> 00:37:57,526
マジョー！

783
00:37:57,609 --> 00:37:58,986
(りんごぼうや) あぶないっ

784
00:38:00,112 --> 00:38:01,238
うっ ううっ

785
00:38:01,321 --> 00:38:02,447
(りんご) りんごぼうや！

786
00:38:02,531 --> 00:38:05,534
まけないぞ
このリンゴは ぼくがまもる！

787
00:38:05,617 --> 00:38:07,035
(マジョーラ) おだまりっ

788
00:38:07,119 --> 00:38:09,287
(りんごぼうや) くっ うわあー！

789
00:38:09,371 --> 00:38:11,289
(りんご) りんごぼうや～！

790
00:38:11,373 --> 00:38:14,251
マジョマジョ マジョ～

791
00:38:14,334 --> 00:38:15,168
(りんごぼうや) くっ…

792
00:38:15,252 --> 00:38:16,420
ああっ

793
00:38:17,879 --> 00:38:19,965
カッコわるくたって――

794
00:38:23,010 --> 00:38:24,511
どろだらけだって――

795
00:38:25,637 --> 00:38:27,139
だれかを たすけるために――

796
00:38:27,222 --> 00:38:28,557
がんばるのが――

797
00:38:28,640 --> 00:38:33,270
ほんとうのヒーローなんだー！

798
00:38:35,188 --> 00:38:38,525
うっ ううう…

799
00:38:38,608 --> 00:38:42,279
たあああー！

800
00:38:42,362 --> 00:38:44,781
うわああ～！

801
00:38:45,240 --> 00:38:47,659
(ジャム)
いまのうちに あたらしい かおを！

802
00:38:47,743 --> 00:38:48,660
(チーズ) アン
(バタコ) はい

803
00:38:49,703 --> 00:38:50,912
(アンパンマン) りんごぼうや！

804
00:38:50,996 --> 00:38:53,081
(しょくぱんまん)
わたしたちも たたかいましょう！

805
00:38:53,165 --> 00:38:54,291
(カレーパンマン) おう！

806
00:38:54,499 --> 00:38:55,459
(３にん) えいっ

807
00:38:55,542 --> 00:38:57,044
(はねる おと)

808
00:38:57,127 --> 00:38:58,170
(３にん) えい！

809
00:38:58,253 --> 00:39:00,380
(マジョーラ)
アタッ アタッ アタタタッ

810
00:39:00,922 --> 00:39:01,882
えいっ！

811
00:39:02,257 --> 00:39:04,009
(カレーパンマン) えいっ！
(しょくぱんまん) くっ！

812
00:39:04,092 --> 00:39:05,802
アイタタタ アター

813
00:39:06,428 --> 00:39:07,554
アイタタ

814
00:39:07,637 --> 00:39:09,556
(ジャムたち) うんっ うんっ

815
00:39:09,639 --> 00:39:11,183
アタタタッ

816
00:39:11,600 --> 00:39:14,102
う～ ちょこまかと うっとおしい！

817
00:39:14,186 --> 00:39:15,062
うああっ！

818
00:39:15,937 --> 00:39:17,189
(ドキン) ああ！

819
00:39:17,481 --> 00:39:18,565
このままじゃ――

820
00:39:18,648 --> 00:39:21,526
おいしいリンゴ
たべられませんよ ホラー

821
00:39:21,610 --> 00:39:24,196
なんとかしなさいよ ばいきんまん！

822
00:39:25,238 --> 00:39:27,949
(ばいきんまん) このまま やられる
おれさまじゃないぞー！

823
00:39:28,033 --> 00:39:29,534
いくぞ マジョーラ！

824
00:39:32,579 --> 00:39:34,247
(ドキン) がんばれ ばいきんまん！

825
00:39:34,331 --> 00:39:36,708
(ホラーマン)
マジョーラをやっつけるホラー！

826
00:39:40,045 --> 00:39:42,714
おれさまは ぜったいに まけないぞ！

827
00:39:42,923 --> 00:39:46,718
おまえも とんで おいき！

828
00:39:46,968 --> 00:39:47,886
んまっ！

829
00:39:47,969 --> 00:39:51,223
うわああっ うわっ　うわー

830
00:39:51,473 --> 00:39:53,850
ばいきんまん やるじゃな～い

831
00:39:53,934 --> 00:39:57,979
ホ… ホラー
びみょうな こうげきですね ホラー

832
00:39:58,188 --> 00:40:02,109
よくも あたしの うつくしい かおを！

833
00:40:03,401 --> 00:40:05,821
ぎょええー！

834
00:40:05,904 --> 00:40:07,989
(ホラーマン) ホラー！
(ドキン) うわああ～

835
00:40:10,909 --> 00:40:11,743
(ばいきんまん･ドキン) うわあ～

836
00:40:11,827 --> 00:40:14,621
(ホラーマン) げんばから
ホラーマンが おつたえしました

837
00:40:14,913 --> 00:40:18,041
(３にん) ばいばいきーん

838
00:40:19,000 --> 00:40:21,503
(ジャム)
よし　あとは かまどでやけば…

839
00:40:21,586 --> 00:40:22,963
(マジョーラ) マジョマジョ マジョ～

840
00:40:23,046 --> 00:40:26,842
おまえたちも どくリンゴに おなり～！

841
00:40:29,594 --> 00:40:30,720
(ジャムたち) ああっ

842
00:40:30,804 --> 00:40:33,056
(ジャム)
これでは かまどが つかえない

843
00:40:33,348 --> 00:40:34,224
(りんごぼうや) えっ

844
00:40:37,227 --> 00:40:38,061
ああ…

845
00:40:38,395 --> 00:40:39,521
(りんご) りんごぼうや

846
00:40:39,604 --> 00:40:40,522
(りんごぼうや) うん！

847
00:40:43,942 --> 00:40:45,110
それっ！

848
00:40:48,029 --> 00:40:49,739
(ジャム) ああ これは！
(バタコ) ああっ

849
00:40:49,823 --> 00:40:51,867
(バタコ)
あたたかくて やさしいひかり

850
00:40:53,243 --> 00:40:54,619
(パンがやける おと)

851
00:40:54,995 --> 00:40:57,164
(カレーパンマン)
なんか ポカポカしてきたぜ

852
00:40:57,247 --> 00:40:58,081
(しょくぱんまん) はい

853
00:40:58,165 --> 00:41:00,250
わたしも むねが
あたたかくなってきました

854
00:41:03,461 --> 00:41:05,130
ううう…

855
00:41:05,213 --> 00:41:09,009
このー！　ペチャンコに おなり～

856
00:41:09,092 --> 00:41:10,552
(バタコたち) ああっ

857
00:41:11,595 --> 00:41:12,637
あっ！

858
00:41:13,930 --> 00:41:14,890
(バタコ) ジャムおじさん！

859
00:41:14,973 --> 00:41:16,850
(ジャム) うん　バタコ チーズ！

860
00:41:16,933 --> 00:41:17,934
(バタコ) はい
(チーズ) アン！

861
00:41:18,018 --> 00:41:19,477
(チーズ) アンアン ア～ン

862
00:41:19,561 --> 00:41:21,605
(バタコ)
アンパンマン あたらしい かおよ！

863
00:41:21,688 --> 00:41:23,106
(ふたり) それっ！

864
00:41:28,987 --> 00:41:32,157
げんき100ばい アンパンマン！

865
00:41:32,949 --> 00:41:34,701
(マジョーラ) うわああ～

866
00:41:34,784 --> 00:41:35,619
(アンパンマン) くっ

867
00:41:35,827 --> 00:41:37,704
おのれ～

868
00:41:37,787 --> 00:41:39,497
くあ～！

869
00:41:39,581 --> 00:41:44,044
これが りんごぼうやから
うけとった ちからだ

870
00:41:50,383 --> 00:41:53,094
アーンパーンチ！

871
00:41:53,178 --> 00:41:54,471
うわあっ

872
00:41:54,721 --> 00:41:59,100
マジョ マジョ マジョ～

873
00:41:59,184 --> 00:42:01,269
(ストローこうもりの なきごえ)

874
00:42:10,195 --> 00:42:11,279
(かぎがかかる おと)

875
00:42:12,322 --> 00:42:13,281
(りんごぼうや) ああ…

876
00:42:50,360 --> 00:42:52,195
(りんごぼうやたち) ウフフフ

877
00:42:52,279 --> 00:42:53,154
(チーズ) アンアン

878
00:42:53,238 --> 00:42:54,406
(バタコ) きゃあ
(ジャム) ほっ

879
00:42:54,489 --> 00:42:55,907
(カレーパンマン) アハハッ
(しょくぱんまん) わっ

880
00:42:57,701 --> 00:42:59,703
(メロンパンナ･クリームパンダ) アハハ

881
00:43:00,620 --> 00:43:01,579
エヘヘヘッ

882
00:43:02,831 --> 00:43:04,165
アハハハッ

883
00:43:05,417 --> 00:43:09,296
(りんごぼうや) アンパンマン
ぼく あきらめないで よかった

884
00:43:09,379 --> 00:43:13,550
みんなで ちからをあわせて
ふるさとを ふっかつさせるからね

885
00:43:13,633 --> 00:43:15,343
そのときは あそびにきてね

886
00:43:15,677 --> 00:43:17,846
(アンパンマン) うん　かならずいくよ

887
00:43:18,138 --> 00:43:20,181
みんな ありがとう！

888
00:43:20,432 --> 00:43:22,684
(みんな) げんきでね～！

889
00:43:27,814 --> 00:43:34,821
♪～

890
00:43:57,010 --> 00:44:04,017
～♪

891
00:44:04,100 --> 00:44:05,352
(りんごぼうや) うわ～い

892
00:44:07,187 --> 00:44:09,147
(りんごぼうや･りんご) アハハハッ

893
00:44:09,230 --> 00:44:13,234
♪～

894
00:44:15,028 --> 00:44:18,448
(みんな)
♪ りん りん りんご りん りん りん

895
00:44:18,656 --> 00:44:21,659
♪ りん りん りんご りん りん りん

896
00:44:22,327 --> 00:44:25,914
♪ りん りん りんご りん りん りん

897
00:44:29,626 --> 00:44:33,046
♪ りん りん りんごの 木の下で

898
00:44:33,129 --> 00:44:36,591
♪ りん りん りんごの 夢を見る

899
00:44:36,883 --> 00:44:40,261
♪ りん りん りんごの 太陽が

900
00:44:40,512 --> 00:44:44,057
♪ りん りん 空にかがやけば

901
00:44:44,140 --> 00:44:47,727
♪ りん りん 勇気が

902
00:44:47,811 --> 00:44:51,022
♪ りん りん りん

903
00:44:51,314 --> 00:44:54,442
♪ りんご りんご りんご

904
00:44:55,026 --> 00:44:57,862
♪ りんご りんご りんご

905
00:44:57,946 --> 00:45:01,658
♪ りんごー

906
00:45:02,325 --> 00:45:06,162
♪ りん りん りん りん　ヤァー

907
00:45:07,038 --> 00:45:14,045
♪～

908
00:46:18,443 --> 00:46:25,450
～♪

