1
00:00:11,637 --> 00:00:14,181
(ドキンちゃん)
わあっ ロマンチック～

2
00:00:14,265 --> 00:00:15,307
ここに――

3
00:00:15,391 --> 00:00:18,227
しょくぱんまんさまを
おまねきして…

4
00:00:19,019 --> 00:00:22,732
まなつの ドキドキ
ラブラブ バカンス～

5
00:00:24,608 --> 00:00:25,443
う～ん…

6
00:00:26,527 --> 00:00:28,946
もうちょっと
フルーツが ほしいわねえ

7
00:00:29,905 --> 00:00:32,450
ばいきんまん
フルーツもってきて

8
00:00:32,533 --> 00:00:33,451
(ばいきんまん) チェッ

9
00:00:33,534 --> 00:00:36,328
だれが しょくぱんまん
なんかのために

10
00:00:36,412 --> 00:00:37,955
(ドキン) くううっ…

11
00:00:38,038 --> 00:00:39,290
うぐぐぐぐ…

12
00:00:39,373 --> 00:00:40,708
(ドキン) もってきて！

13
00:00:40,791 --> 00:00:43,461
(ばいきんまん) いってきまーす！

14
00:00:46,213 --> 00:00:47,465
くそ～っ！

15
00:00:48,466 --> 00:00:49,717
ドキンちゃん
このごろ――

16
00:00:49,800 --> 00:00:51,886
ひとづかいが
あらすぎ

17
00:00:51,969 --> 00:00:53,220
ん… んっ？

18
00:00:54,346 --> 00:00:56,307
なっ なんだ あれ？

19
00:00:59,518 --> 00:01:01,103
んん？

20
00:01:01,437 --> 00:01:02,313
(くろゆきひめ) フッ

21
00:01:04,648 --> 00:01:06,317
(ばいきんまん)
んんっ？ うわー！

22
00:01:06,400 --> 00:01:08,903
た… たいへん
ひっぱられるー！

23
00:01:08,986 --> 00:01:09,820
ん？

24
00:01:09,904 --> 00:01:11,822
どわあー！

25
00:01:11,906 --> 00:01:15,826
(ほしが はじけるおと)

26
00:01:15,910 --> 00:01:18,078
どわああ！
ぐえっ おわっ！

27
00:01:18,162 --> 00:01:20,498
ん？
なーななっ

28
00:01:20,581 --> 00:01:22,041
んん…

29
00:01:22,833 --> 00:01:25,002
ん～ ううっ…

30
00:01:25,085 --> 00:01:27,254
うううう…

31
00:01:27,338 --> 00:01:30,508
(くろゆき) そなた
まっくろで ステキだな

32
00:01:30,591 --> 00:01:31,509
へっ？

33
00:01:31,592 --> 00:01:33,511
わあああっ

34
00:01:37,431 --> 00:01:39,517
(くろゆき)
わたしは くろゆきひめ

35
00:01:39,600 --> 00:01:41,227
くろゆきひめ…

36
00:01:41,310 --> 00:01:42,937
そなた なまえは？

37
00:01:43,020 --> 00:01:43,896
(ばいきんまん) ん？

38
00:01:43,979 --> 00:01:46,023
おれさま
ばいきんまんなのだ

39
00:01:46,524 --> 00:01:48,734
そうか　ばいきんまんか

40
00:01:48,818 --> 00:01:51,028
みればみるほど ハンサムだ！

41
00:01:51,403 --> 00:01:53,322
ハッ ハンサム？

42
00:01:54,031 --> 00:01:56,826
わが くろゆきじょうへ ようこそ！

43
00:01:56,909 --> 00:02:00,621
(こだま) ようこそ

44
00:02:05,084 --> 00:02:08,295
(ばいきんまん) ホヘ～…

45
00:02:08,379 --> 00:02:09,463
ハア～

46
00:02:09,547 --> 00:02:12,299
ん？ はっ はくしょんっ！

47
00:02:12,383 --> 00:02:15,344
おいで マックロマンたち

48
00:02:17,721 --> 00:02:19,557
(マックロマンたち) マックロ～

49
00:02:19,640 --> 00:02:21,141
(マックロマン) クロッ
(ばいきんまん) ん？

50
00:02:21,225 --> 00:02:23,060
(マックロマン１)
ばいきんまんステキ クロ～

51
00:02:23,143 --> 00:02:24,687
(マックロマン２) いいおとこクロ～

52
00:02:24,979 --> 00:02:27,648
(くろゆき) そうか
おまえたちも きにいったか

53
00:02:27,731 --> 00:02:28,732
(ばいきんまん) ええっ！

54
00:02:29,066 --> 00:02:31,735
わたしも
ばいきんまんが だいすきだ

55
00:02:32,111 --> 00:02:32,945
んんっ

56
00:02:33,988 --> 00:02:35,239
だいすき？

57
00:02:35,698 --> 00:02:37,449
ウフフッ

58
00:02:37,533 --> 00:02:40,244
くろは ステキ
わたしは くろい

59
00:02:40,911 --> 00:02:43,497
わたしは ステキ

60
00:02:43,998 --> 00:02:46,000
フフッ　くろは ステキ

61
00:02:46,083 --> 00:02:49,587
ばいきんまんは くろい
ばいきんまんは ステキ

62
00:02:49,670 --> 00:02:50,504
(マックロマンたち) クロー！

63
00:02:50,588 --> 00:02:52,715
ナハハハハッ！

64
00:02:52,798 --> 00:02:53,924
そうだ！

65
00:02:55,801 --> 00:02:58,095
ちかくに
おれさまの べっそうがあるから――

66
00:02:58,178 --> 00:02:59,638
ごしょうたい いたす

67
00:02:59,722 --> 00:03:02,516
おおっ　ありがとう！

68
00:03:03,100 --> 00:03:04,643
んん～ んっ？

69
00:03:04,727 --> 00:03:08,814
ニへ ニへ　ニヘヘヘッ

70
00:03:08,898 --> 00:03:10,482
(くろゆき) フフフフ…

71
00:03:13,193 --> 00:03:14,028
ふえっ

72
00:03:14,778 --> 00:03:17,114
なっ なによ あれ！

73
00:03:20,451 --> 00:03:21,827
んん～？

74
00:03:21,911 --> 00:03:22,745
(ホラーマン) ホラ？

75
00:03:30,961 --> 00:03:32,338
(ドキン) ああ
(ホラーマン) ホラッ

76
00:03:37,885 --> 00:03:40,012
(ばいきんまん)
よっと　おてを どうぞ

77
00:03:40,638 --> 00:03:41,764
(ドキン) んんっ

78
00:03:41,847 --> 00:03:44,224
ばいきんまん だれなのよ！

79
00:03:44,308 --> 00:03:46,727
(ばいきんまん) フンッ
ドキンちゃんには かんけいないのだ

80
00:03:46,810 --> 00:03:48,020
さあ こちらへ

81
00:03:48,103 --> 00:03:49,355
(くろゆき) うん
(ばいきんまん) フフフ

82
00:03:49,438 --> 00:03:50,481
(ドキン) う～ あっ…

83
00:03:50,564 --> 00:03:51,565
(くろゆき) フフフッ

84
00:03:51,649 --> 00:03:53,984
(ドキン)
ちょっ ちょっと まちなさいよー！

85
00:03:57,780 --> 00:03:58,906
んん～？

86
00:03:59,823 --> 00:04:01,784
この べっそうは
しゅみが わるいな

87
00:04:01,867 --> 00:04:02,868
(ドキン･ばいきんまん) んっ
(ホラーマン) ヤバッ

88
00:04:03,744 --> 00:04:06,830
(くろゆき) ピンクや
しろいもの ばかりではないか

89
00:04:07,331 --> 00:04:08,916
きもちわるい

90
00:04:08,999 --> 00:04:10,793
(ドキン) なんですって～！

91
00:04:10,876 --> 00:04:14,588
(ばいきんまん) いやーっ
おれさまも そうおもってたのよ～

92
00:04:14,672 --> 00:04:15,547
(くろゆき) よしっ

93
00:04:15,631 --> 00:04:19,510
わたしが うつくしくしてあげよう

94
00:04:19,593 --> 00:04:21,053
(マックロマンたち) クローッ

95
00:04:21,136 --> 00:04:22,638
(ドキン) な… なによっ

96
00:04:23,222 --> 00:04:24,974
♪～

97
00:04:25,057 --> 00:04:30,562
♪ 黒い色は ステキ

98
00:04:30,646 --> 00:04:31,563
(ドキン) ああ…

99
00:04:31,855 --> 00:04:36,944
♪ 黒いひとみ ステキ

100
00:04:37,027 --> 00:04:38,278
あああっ！

101
00:04:38,612 --> 00:04:44,535
♪ 黒いマツゲ ステキ

102
00:04:45,411 --> 00:04:51,083
♪ 黒いカミが ステキ

103
00:04:52,167 --> 00:04:55,337
♪ クロ クロ クロ マックロ

104
00:04:55,421 --> 00:04:58,716
♪ クロ クロ クロ マックロ

105
00:04:59,383 --> 00:05:04,346
♪ クロは美しい

106
00:05:05,347 --> 00:05:07,975
なっ なんてことするのよ～！

107
00:05:08,559 --> 00:05:11,186
うわ～ん
しょくぱんまんさまが

108
00:05:11,270 --> 00:05:15,232
すごいですね
くろいですね まっくろですね

109
00:05:15,315 --> 00:05:16,608
どわっ！

110
00:05:16,692 --> 00:05:18,986
はい
わたしも まっくろですね

111
00:05:19,069 --> 00:05:25,117
♪ 黒い影が ステキ

112
00:05:26,035 --> 00:05:31,582
♪ 黒はみんな ステキ

113
00:05:32,624 --> 00:05:35,919
♪ クロ クロ クロ マックロ

114
00:05:36,003 --> 00:05:39,840
♪ クロ クロ クロ マックロ

115
00:05:39,923 --> 00:05:44,803
♪ クロは美しい

116
00:05:45,596 --> 00:05:49,058
(ばくはつした おと)

117
00:05:49,141 --> 00:05:50,684
(ばいきんまんたちの わらいごえ)

118
00:05:50,768 --> 00:05:54,188
おもしろいのだ！
みんな まっくろけ～！

119
00:05:54,271 --> 00:05:55,564
アハハハッ

120
00:05:55,647 --> 00:05:57,316
すばらしい！

121
00:05:57,399 --> 00:05:59,318
なんと くろくて うつくしい

122
00:05:59,401 --> 00:06:00,611
ね？ ばいきんまん

123
00:06:00,694 --> 00:06:02,321
(ばいきんまん)
はいはい はいは～い

124
00:06:02,404 --> 00:06:03,947
やめなさいよ！

125
00:06:04,239 --> 00:06:05,074
(くろゆきひめ) ああ――

126
00:06:05,157 --> 00:06:08,744
そなたも くろく うつくしく
けしょうしてあげる

127
00:06:08,827 --> 00:06:09,745
(ドキン) うっ

128
00:06:11,121 --> 00:06:13,207
ううう…

129
00:06:13,290 --> 00:06:14,875
(ばいきんまん) ナハハハハッ！

130
00:06:14,958 --> 00:06:17,628
ドキンちゃん
まっくろメイク にあうのだ！

131
00:06:17,711 --> 00:06:18,545
(ドキン) なによ！

132
00:06:18,629 --> 00:06:21,882
(マックロマンたち) クロ クロ クロ
(ドキン) えっ　うわあっ

133
00:06:21,965 --> 00:06:25,052
(マックロマンたち) クロ クロ クロ
(ドキン) ちょっ ちょっと！

134
00:06:25,135 --> 00:06:26,845
(ホラーマン)
ド… ドキンちゃーん！

135
00:06:27,304 --> 00:06:28,347
(ドキン) うっ！

136
00:06:28,430 --> 00:06:29,848
くっ… うう…

137
00:06:30,307 --> 00:06:31,850
(マックロマン) ばいばいクロー！

138
00:06:31,934 --> 00:06:33,060
(ドキン) えっ

139
00:06:33,143 --> 00:06:34,228
ドキンちゃん！

140
00:06:35,312 --> 00:06:39,149
(ドキン)
ぜーったい リベンジするからねえ！

141
00:06:44,238 --> 00:06:45,697
(ばいきんまん) ひめさま

142
00:06:46,073 --> 00:06:47,741
くろいちごのジュースをどうぞ

143
00:06:47,825 --> 00:06:49,159
ありがとう

144
00:06:51,495 --> 00:06:52,412
いっしょに のも？

145
00:06:52,496 --> 00:06:53,330
ん？

146
00:06:53,413 --> 00:06:55,124
ナハハハハッ

147
00:06:57,417 --> 00:06:58,919
あ～んっ

148
00:06:59,169 --> 00:07:02,089
んぐ んぐ んぐ…

149
00:07:02,172 --> 00:07:03,590
んぐ んぐ

150
00:07:05,092 --> 00:07:07,845
そうだ
たのしいこと おもいついた

151
00:07:07,928 --> 00:07:08,929
(ばいきんまん) ん？

152
00:07:17,312 --> 00:07:18,438
(くろゆきひめ) フンッ

153
00:07:27,865 --> 00:07:30,367
(ばいきんまんたちの わらいごえ)

154
00:07:31,368 --> 00:07:32,369
フフ…

155
00:07:40,085 --> 00:07:43,005
(ホラーマン) んん… ハッ ホッ

156
00:07:43,088 --> 00:07:46,508
(ドキン) なんなのよ あのこ～

157
00:07:46,592 --> 00:07:48,260
ゆるせない

158
00:07:48,343 --> 00:07:50,387
ホラ… ハ…

159
00:07:55,225 --> 00:07:58,478
(ジャムおじさん)
みんな！ ならんで ならんで

160
00:07:58,562 --> 00:08:01,481
やきたての おいしいパンだよ

161
00:08:01,899 --> 00:08:04,443
(クマた) わあ おいしそうだな～

162
00:08:04,526 --> 00:08:07,237
(カバお) いっただきま～す

163
00:08:07,321 --> 00:08:08,739
(こどもたち) あ？ ん？

164
00:08:12,326 --> 00:08:13,827
(バタコさん) へんな くもね

165
00:08:13,911 --> 00:08:15,245
(チーズ) アン アアン

166
00:08:15,704 --> 00:08:18,207
(みんな) うわあ…

167
00:08:23,253 --> 00:08:25,172
わあっ

168
00:08:25,255 --> 00:08:26,673
(バタコ) なに これ！

169
00:08:26,757 --> 00:08:27,758
(カバお) ひどいや

170
00:08:27,841 --> 00:08:28,884
(くろゆき) アハハハッ！

171
00:08:28,967 --> 00:08:29,843
(みんな) ん？

172
00:08:29,927 --> 00:08:33,055
(くろゆき) そなたたち
みんな ステキになったぞ

173
00:08:33,138 --> 00:08:33,972
(カバお) だれだ！

174
00:08:34,056 --> 00:08:36,099
(クマた) ぜんぜん ステキじゃないよ

175
00:08:36,183 --> 00:08:38,852
(ばいきんまん)
いいや　ステキなの！

176
00:08:39,394 --> 00:08:40,896
(みんな) ばいきんまん！

177
00:08:41,855 --> 00:08:43,607
(ばいきんまん) ハヒフヘホ～！

178
00:08:43,690 --> 00:08:46,860
おまえたちは とくべつに
もっと くろくしてやるのだ！

179
00:08:46,944 --> 00:08:48,487
(みんな) うわああ！

180
00:08:48,570 --> 00:08:52,491
たすけて アンパンマーン！

181
00:08:52,574 --> 00:08:59,581
(こだま) アンパンマーン

182
00:09:00,791 --> 00:09:03,126
(アンパンマン)
ばいきんまん やめるんだ！

183
00:09:05,087 --> 00:09:06,004
んんっ

184
00:09:06,880 --> 00:09:09,049
でたな おじゃまむし～！

185
00:09:09,132 --> 00:09:11,051
(みんな) アンパンマン！

186
00:09:11,134 --> 00:09:13,428
(ばいきんまん)
おまえも くろくしてやる　このっ！

187
00:09:13,512 --> 00:09:14,638
(アンパンマン) んっ

188
00:09:15,597 --> 00:09:16,431
(ばいきんまん) それ！

189
00:09:16,515 --> 00:09:18,809
くそ～っ！ ん？

190
00:09:21,061 --> 00:09:21,937
(ホラーマン) だああ…

191
00:09:22,020 --> 00:09:23,730
(ドキン) ばいきんま～ん！

192
00:09:23,814 --> 00:09:25,565
(ばいきんまん) どわああ！

193
00:09:25,649 --> 00:09:28,318
ああああ！

194
00:09:28,694 --> 00:09:30,153
(おおきな ものおと)

195
00:09:30,237 --> 00:09:32,030
あああ…

196
00:09:32,114 --> 00:09:34,032
(みんな) ああ…

197
00:09:39,079 --> 00:09:41,540
さっきは
よくも やってくれたわね！

198
00:09:41,623 --> 00:09:43,000
ぶれいな！

199
00:09:43,083 --> 00:09:45,544
くろゆきじょうに
かってに はいってくるとは

200
00:09:45,627 --> 00:09:46,586
(ドキン) あんただって――

201
00:09:46,670 --> 00:09:49,172
かってに わたしの べっそうに
はいってきたじゃない！

202
00:09:49,256 --> 00:09:50,090
(くろゆき) あそこは もう――

203
00:09:50,173 --> 00:09:52,926
ばいきんまんと あたしの
べっそうに なっておるぞ

204
00:09:53,010 --> 00:09:55,095
オーホホホッ！

205
00:09:55,178 --> 00:09:56,596
(ドキン) なんですって～！

206
00:09:56,680 --> 00:09:58,432
(くろゆき) なんだというのだ！

207
00:10:00,392 --> 00:10:01,685
(ドキン) くうう…

208
00:10:01,768 --> 00:10:02,644
(くろゆき) ううう…

209
00:10:02,728 --> 00:10:04,229
(ばいきんまん) あのっ！ ええっと…

210
00:10:04,313 --> 00:10:07,316
ふたりとも おちついて おちついて

211
00:10:07,983 --> 00:10:09,651
(くろゆき･ドキン) ばいきんまん！
(ばいきんまん) はい！

212
00:10:09,735 --> 00:10:12,070
(くろゆき) ばいきんまんは
わたしの ともだちだろ？

213
00:10:12,154 --> 00:10:14,406
(ドキン) ばいきんまんは
わたしの なかまよね？

214
00:10:14,489 --> 00:10:17,117
(ばいきんまん)
ええっ！ えっ ええ…

215
00:10:17,367 --> 00:10:18,535
(ドキン) んんん…！

216
00:10:18,618 --> 00:10:22,664
さあ グズグズしてないで かえるわよ
ばいきんまん！

217
00:10:22,748 --> 00:10:25,500
(ばいきんまん) だああ！
(くろゆき) かえるでないぞ ばいきんまん

218
00:10:25,584 --> 00:10:28,545
(ばいきんまん) んんっ
(ドキン･くろゆき) んんー…！

219
00:10:29,212 --> 00:10:30,505
ばいきんまん！

220
00:10:31,048 --> 00:10:32,507
ばいきんまん！

221
00:10:32,591 --> 00:10:34,259
(ばいきんまん)
<グフフッ　ニャハハ～>

222
00:10:34,343 --> 00:10:38,513
<モテモテは つらいのだ
ハハッ　ニャハハッ>

223
00:10:38,597 --> 00:10:40,891
(ドキン) なまいきよ あんた

224
00:10:40,974 --> 00:10:43,226
(くろゆき) そなたこそ なまいきだ！

225
00:10:43,310 --> 00:10:47,522
(ドキン･くろゆき) んんー…

226
00:10:47,606 --> 00:10:48,982
(ばいきんまん) うわああ！

227
00:10:50,650 --> 00:10:51,943
やったわね！

228
00:10:52,027 --> 00:10:54,488
よくも あたしの べっそうを！

229
00:10:55,030 --> 00:10:56,239
ぎゃあっ！

230
00:10:56,698 --> 00:10:57,949
(くろゆき) あっ

231
00:10:58,909 --> 00:11:00,994
おかえしだ！ えいっ！

232
00:11:01,912 --> 00:11:02,996
げええっ！

233
00:11:03,080 --> 00:11:04,581
フッ

234
00:11:06,249 --> 00:11:10,170
まあ こわいですね
すごいですね　ホラーですね

235
00:11:10,253 --> 00:11:11,671
こわいクロー

236
00:11:11,755 --> 00:11:13,632
(マックロマンたち) クロ クロ…

237
00:11:13,965 --> 00:11:15,133
えいっ！

238
00:11:15,217 --> 00:11:16,635
それっ！

239
00:11:16,927 --> 00:11:18,595
ぐおおおおお！

240
00:11:18,929 --> 00:11:25,644
(ものを なげるおと)

241
00:11:26,436 --> 00:11:27,396
(しょくぱんまん) アンパンマーン！

242
00:11:27,479 --> 00:11:28,688
ん？ あっ

243
00:11:29,481 --> 00:11:32,359
(しょくぱんまん)
いったい どうなっているんでしょう？

244
00:11:32,442 --> 00:11:34,403
(アンパンマン)
ぼくにも なにが なんだか…

245
00:11:37,239 --> 00:11:38,240
ううっ

246
00:11:38,323 --> 00:11:39,408
ハアア～

247
00:11:39,491 --> 00:11:40,367
(ジャムたち) ああ…

248
00:11:40,450 --> 00:11:41,576
(アンパンマン) ばいきんまん！

249
00:11:41,660 --> 00:11:42,994
(カレーパンマン) おっ おい

250
00:11:43,078 --> 00:11:44,413
(しょくぱんまん) どうしたんですか？

251
00:11:44,496 --> 00:11:45,455
(ばいきんまん) んっ？

252
00:11:45,539 --> 00:11:46,957
ニャハーッ

253
00:11:47,040 --> 00:11:50,419
モテモテの つらさ
おまえたちには わかんないだろうな

254
00:11:50,502 --> 00:11:51,920
(みんな) ええ？

255
00:11:52,379 --> 00:11:53,713
(くろゆき) ばいきんまん！
(ばいきんまん) ん？

256
00:11:53,797 --> 00:11:56,675
(ドキン) ばいきんまん！
(ばいきんまん) パピプペポ～

257
00:11:56,758 --> 00:11:58,385
(みんな) んん～？

258
00:11:58,468 --> 00:12:00,804
(アンパンマン) なかでは なにが…

259
00:12:02,264 --> 00:12:03,390
(くろゆき) フンッ

260
00:12:03,473 --> 00:12:04,683
(ドキン) フンッ

261
00:12:04,766 --> 00:12:06,268
えいっ えいっ

262
00:12:06,351 --> 00:12:07,185
(くろゆき) はっ！

263
00:12:07,978 --> 00:12:09,312
ん… やあ！

264
00:12:09,688 --> 00:12:10,564
ああ！

265
00:12:15,569 --> 00:12:16,820
ハッ…

266
00:12:20,657 --> 00:12:21,908
(３にん) うわあ！

267
00:12:21,992 --> 00:12:24,744
(まちの ひとたち) うわ～っ

268
00:12:24,828 --> 00:12:27,831
(みんな) うわ～っ ああっ！

269
00:12:33,545 --> 00:12:35,046
(アンパンマン) たいへんだ

270
00:12:35,130 --> 00:12:37,591
しょくぱんまん
カレーパンマン

271
00:12:37,674 --> 00:12:38,800
(ふたり) よーしっ

272
00:12:40,969 --> 00:12:43,346
アーンパーンチ！

273
00:12:43,972 --> 00:12:44,806
(しょくぱんまん) フッ！

274
00:12:45,599 --> 00:12:46,933
(しょくぱんまん) しょくパーンチ！

275
00:12:47,017 --> 00:12:49,436
カレーパーンチ！

276
00:12:51,146 --> 00:12:53,940
(３にん)
スペシャル トリプルパーンチ！

277
00:12:59,404 --> 00:13:00,280
(ドキン) ん… あ…

278
00:13:00,363 --> 00:13:01,364
(くろゆき) ああ…

279
00:13:01,448 --> 00:13:02,532
(ドキン) ああ…

280
00:13:02,616 --> 00:13:04,993
(ホラーマン)
なっ なんの おとでしょう？

281
00:13:05,076 --> 00:13:06,912
(３にん) わっ わああ！

282
00:13:09,456 --> 00:13:10,999
ああっ つえが！

283
00:13:11,082 --> 00:13:12,834
(ばいきんまん) ん？
(くろゆき) キャアアア

284
00:13:12,918 --> 00:13:14,753
(ばいきんまん) わあ！ んっ

285
00:13:14,836 --> 00:13:17,005
(ドキン) ああっ
(くろゆき) キャアアッ！

286
00:13:19,341 --> 00:13:21,927
(ドキン) うわあ
(ばいきんまん) んぐっ　ぐぐぐ…

287
00:13:22,010 --> 00:13:24,513
(ホラーマン)
ホラ～ッ　おさきにーっ

288
00:13:38,276 --> 00:13:39,945
(みんな) わああっ

289
00:13:40,028 --> 00:13:41,696
(３にん) ああっ

290
00:13:46,785 --> 00:13:49,412
(ばいきんまん) ぐぐぐ…

291
00:13:49,913 --> 00:13:52,207
(ドキン)
ん… あっ ばいきんまん

292
00:13:52,290 --> 00:13:54,709
んんん…！ んん…

293
00:13:56,253 --> 00:13:58,463
あっ… つえが！

294
00:13:59,297 --> 00:14:02,467
さあ ばいきんまん
つえを こちらに

295
00:14:02,551 --> 00:14:04,386
(ばいきんまん) んんん…

296
00:14:04,469 --> 00:14:06,221
(くろゆき･ばいきんまん) わあっ！

297
00:14:06,304 --> 00:14:07,806
ハア　ハッ

298
00:14:12,519 --> 00:14:14,229
あああ…

299
00:14:23,613 --> 00:14:25,240
あああ…

300
00:14:25,323 --> 00:14:26,408
(３にん) ん？

301
00:14:26,491 --> 00:14:30,495
わああああー！

302
00:14:31,121 --> 00:14:32,789
(３にん) あああっ

303
00:14:38,503 --> 00:14:41,506
♪～

304
00:14:48,221 --> 00:14:49,931
(まちの ひとたち) おお…

305
00:14:51,600 --> 00:14:52,642
ん？ おおっ

306
00:14:52,726 --> 00:14:53,560
わあっ

307
00:15:06,531 --> 00:15:07,532
(アンパンマン) んっ
(しょくぱんまん) えいっ

308
00:15:07,616 --> 00:15:08,658
(アンパンマン) おお…

309
00:15:09,242 --> 00:15:10,577
(ジャムたち) おおお…

310
00:15:12,579 --> 00:15:14,789
(ドキン) あ…
(ばいきんまん) うぐっ

311
00:15:14,873 --> 00:15:15,707
(ふたり) んっ？

312
00:15:21,796 --> 00:15:22,839
あっ

313
00:15:22,922 --> 00:15:25,925
～♪

314
00:15:26,009 --> 00:15:27,344
(ユキダルマンたち) ユッキー

315
00:15:32,140 --> 00:15:32,974
(こなゆきひめ) ウフッ

316
00:15:33,224 --> 00:15:34,684
(みんな) あああ！

317
00:15:34,768 --> 00:15:36,186
(しょくぱんまん)
しろい おひめさまに

318
00:15:36,269 --> 00:15:38,480
(カレーパンマン)
すごい　しらゆきひめだ！

319
00:15:39,147 --> 00:15:41,941
(こなゆき) いいえ
わたしは こなゆきひめです

320
00:15:42,025 --> 00:15:44,235
こなゆきひめ？

321
00:15:44,527 --> 00:15:45,445
(こなゆき) ええ

322
00:15:46,112 --> 00:15:47,322
くろい あくまに――

323
00:15:47,405 --> 00:15:49,240
のろいの くろすいしょうを
わたされて――

324
00:15:49,324 --> 00:15:52,243
くろゆきひめに されていたのです

325
00:15:54,204 --> 00:15:55,955
ああっ

326
00:15:59,959 --> 00:16:03,046
フンッ　フッフッ

327
00:16:03,880 --> 00:16:05,215
ばいきんまん――

328
00:16:05,298 --> 00:16:07,384
あなたは
くろすいしょうを わって――

329
00:16:07,467 --> 00:16:09,928
わたしたちを たすけてくれました

330
00:16:10,845 --> 00:16:12,013
ありがとう

331
00:16:12,555 --> 00:16:14,474
(ユキダルマン)
まほうがとけた ユッキー

332
00:16:14,557 --> 00:16:15,809
ありがとう ユッキー

333
00:16:15,892 --> 00:16:18,311
(ユキダルマンたち)
ユッキー ユッキー

334
00:16:18,395 --> 00:16:20,939
うっ いい… いや～

335
00:16:21,231 --> 00:16:22,190
(こなゆき) ウフッ

336
00:16:24,317 --> 00:16:26,111
もとに もどった わたしは――

337
00:16:26,194 --> 00:16:28,822
こなゆきの おしろに
かえらなければなりません

338
00:16:28,905 --> 00:16:30,031
(ばいきんまん) んん？

339
00:16:31,241 --> 00:16:32,575
(こなゆき) ばいきんまん
(ばいきんまん) ん？

340
00:16:33,368 --> 00:16:36,705
あなたを しろくしてあげますから
いっしょに きてください

341
00:16:36,788 --> 00:16:37,956
(ふたり) ええ！

342
00:16:38,039 --> 00:16:40,041
(みんな) えええ…

343
00:16:40,125 --> 00:16:41,334
(カレーパンマン) ああ…

344
00:16:41,876 --> 00:16:44,921
おっ おれさま…

345
00:16:46,423 --> 00:16:48,717
ニヒヒヒヒッ

346
00:16:49,718 --> 00:16:51,386
ん～…

347
00:16:52,971 --> 00:16:54,431
ばいきんまん

348
00:16:55,306 --> 00:16:56,725
(ドキン) んー…

349
00:16:58,226 --> 00:17:00,979
(ばいきんまん) おっ おれさま…

350
00:17:04,941 --> 00:17:06,818
(ドキン) <ばいきんまん…>

351
00:17:08,570 --> 00:17:09,946
(ばいきんまん) くっ…

352
00:17:10,029 --> 00:17:11,823
おれさま…

353
00:17:13,700 --> 00:17:15,034
ううっ…

354
00:17:17,287 --> 00:17:18,329
うっ うっ うっ

355
00:17:18,413 --> 00:17:19,581
(アンパンマンたち) ああ…

356
00:17:20,832 --> 00:17:25,754
おれさまは あくやくだから
いくわけには いかないのだ

357
00:17:25,837 --> 00:17:26,755
(こなゆき) ああ…

358
00:17:27,130 --> 00:17:28,757
(ドキン) フフッ フンッ

359
00:17:28,840 --> 00:17:30,842
(ばいきんまん) きもちだけ…

360
00:17:30,925 --> 00:17:33,720
うん
きもちだけ もらっておくのだ

361
00:17:34,137 --> 00:17:36,264
ハハッ ヒフヘホ～！

362
00:17:36,347 --> 00:17:37,766
(ユキダルマンたち) ユッキ～

363
00:17:37,849 --> 00:17:39,392
(こなゆき) わかりました

364
00:17:39,476 --> 00:17:40,769
わたしは かえります

365
00:17:40,852 --> 00:17:41,853
(ばいきんまん) ん？

366
00:17:42,228 --> 00:17:44,773
でも こなゆきが ふったときには――

367
00:17:44,856 --> 00:17:46,733
わたしのことを
おもいだしてください

368
00:17:47,275 --> 00:17:50,153
うっ
お… おもいだすのだ

369
00:17:52,113 --> 00:17:55,033
(アンパンマンたち) さようなら～

370
00:17:55,450 --> 00:17:57,619
(こなゆき) さようなら～
(ユキダルマンたち) ユッキー

371
00:17:58,161 --> 00:18:02,040
(ジャム) ふゆになったら
キレイな ゆきを ふらせておくれ

372
00:18:02,123 --> 00:18:03,792
(チーズ) アン アア～ン

373
00:18:04,209 --> 00:18:07,295
(みんな) さようなら～

374
00:18:07,378 --> 00:18:08,922
フフッ

375
00:18:12,759 --> 00:18:14,385
うう…

376
00:18:21,392 --> 00:18:22,977
んん…

377
00:18:24,687 --> 00:18:27,690
フンッ！
かえるわよ ばいきんまん

378
00:18:27,774 --> 00:18:28,650
(ばいきんまん) ん？

379
00:18:29,734 --> 00:18:30,777
(ホラーマン) しあわせ

380
00:18:31,528 --> 00:18:32,362
フフッ

381
00:18:34,531 --> 00:18:37,033
おう！ かえるのだー！

382
00:18:37,784 --> 00:18:44,791
♪～

383
00:20:34,651 --> 00:20:37,278
(ドキン) ばいきんまん
フルーツもってきて～

384
00:20:37,362 --> 00:20:40,281
(ばいきんまん) ええっ また～？

385
00:20:40,365 --> 00:20:47,372
～♪

