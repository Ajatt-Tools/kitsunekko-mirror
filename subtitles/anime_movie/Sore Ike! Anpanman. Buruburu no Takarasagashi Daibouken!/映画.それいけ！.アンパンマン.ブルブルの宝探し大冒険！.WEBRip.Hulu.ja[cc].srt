1
00:00:19,311 --> 00:00:24,150
(おまつりの おんがく)

2
00:00:24,900 --> 00:00:28,904
(まちのひとたちの にぎやかな こえ)

3
00:00:41,125 --> 00:00:44,628
(みみせんせい) さあ まずは よさこい
｢アンパンマンおんど｣です

4
00:00:44,712 --> 00:00:45,921
みなさ～ん

5
00:00:46,005 --> 00:00:49,008
げんきに うたって
おどってくださ～い！

6
00:00:49,091 --> 00:00:50,384
(はくしゅ)

7
00:00:50,468 --> 00:00:51,844
(カバお) おっとっと

8
00:00:54,180 --> 00:00:55,181
(タイコマンの たいこのおと)

9
00:00:55,264 --> 00:01:02,271
(なるこの おと)
♪～

10
00:01:16,202 --> 00:01:17,203
♪ は～ どっこい

11
00:01:57,910 --> 00:01:59,495
♪ どっこいしょ　どっこいしょ

12
00:01:59,578 --> 00:02:01,163
♪ どっこいしょ　どっこいしょ

13
00:02:01,247 --> 00:02:02,957
♪ ソーラン　ソーラン

14
00:02:03,040 --> 00:02:04,750
♪ ソーラン　ソーラン

15
00:02:44,665 --> 00:02:51,672
～♪

16
00:02:53,215 --> 00:02:56,552
(みみ) みなさーん
なつまつりに ようこそ

17
00:02:56,886 --> 00:02:58,512
きょうは みんなでいっしょに――

18
00:02:58,596 --> 00:03:01,056
たのしく うたって
おどりましょうね

19
00:03:02,016 --> 00:03:03,559
(シドロ) シドロでーす

20
00:03:04,351 --> 00:03:06,061
(モドロ) モドロでーす

21
00:03:06,312 --> 00:03:09,982
(シドロ･モドロ) ふたりあわせて
シドロ アンド モドロでーす

22
00:03:10,065 --> 00:03:13,986
わたしたちも いっしょに
うたっておどるわよ

23
00:03:14,069 --> 00:03:15,195
(コキンちゃん) まって まって～

24
00:03:15,279 --> 00:03:16,322
(みみたち) ええっ？

25
00:03:17,740 --> 00:03:19,992
(コキン)
コキンちゃんも やるー！

26
00:03:20,075 --> 00:03:21,785
(みみたち) わあーっ

27
00:03:29,460 --> 00:03:32,004
(コキン) つぎのきょくは
｢あおいなみだ｣でーす

28
00:03:32,087 --> 00:03:33,088
(みみたち) えーっ

29
00:03:37,426 --> 00:03:40,471
♪～

30
00:03:41,138 --> 00:03:43,641
♪ パッ パヤ　パヤッパー

31
00:03:44,475 --> 00:03:47,019
♪ パッ パヤ　パッ パヤー

32
00:03:47,811 --> 00:03:50,481
♪ パッ パヤ　パヤッパー

33
00:04:45,452 --> 00:04:47,204
(しょくぱんまん)
あっ うう… あっ

34
00:04:47,329 --> 00:04:48,706
うう…

35
00:04:48,789 --> 00:04:50,958
うわーっ

36
00:04:51,166 --> 00:04:52,501
(ドキンちゃん) うえーっ

37
00:04:53,127 --> 00:04:54,461
コキンちゃん！

38
00:04:54,545 --> 00:04:57,965
ドキンおねえちゃんの いじわる～

39
00:04:58,048 --> 00:05:00,467
うえ～ん うえ～ん

40
00:05:00,551 --> 00:05:02,052
(みんなの なきごえ)

41
00:05:02,136 --> 00:05:05,180
～♪

42
00:05:05,264 --> 00:05:06,265
テヘッ

43
00:05:07,182 --> 00:05:10,102
はーい　では つぎのきょくは…

44
00:05:10,185 --> 00:05:12,604
(ばいきんまん) ここからは
おれさまたちのステージだ！

45
00:05:12,688 --> 00:05:13,689
(みみ) ええっ？

46
00:05:14,356 --> 00:05:15,899
(みんな) うわっ

47
00:05:17,985 --> 00:05:19,236
うわあっ

48
00:05:19,319 --> 00:05:20,821
ばいきんまん！

49
00:05:21,363 --> 00:05:28,370
♪～

50
00:05:30,914 --> 00:05:33,959
♪ おれはすてきな ばいきんまん

51
00:05:34,043 --> 00:05:36,879
♪ 眼にもみえない早わざで

52
00:05:37,296 --> 00:05:43,052
♪ どんな敵でもいちころさ

53
00:05:43,719 --> 00:05:46,555
♪ 世界はやがておれのもの

54
00:05:46,930 --> 00:05:50,100
♪ ばいきんまん ばいきんまん

55
00:05:50,184 --> 00:05:54,855
♪ バイキンだからキンキラキン

56
00:05:55,064 --> 00:05:58,734
♪ ハハハハハ ハヒフヘホ！

57
00:05:59,068 --> 00:06:00,652
(アンパンマン)
やめるんだ！ ばいきんまん

58
00:06:00,736 --> 00:06:03,489
(ばいきんまん)
おっ あらわれたな！ おじゃまむし！

59
00:06:03,864 --> 00:06:05,365
くらえー！

60
00:06:06,075 --> 00:06:07,159
(アンパンマン) えーい

61
00:06:09,578 --> 00:06:10,579
うわわわっ

62
00:06:10,954 --> 00:06:13,332
みんな　いまのうちに にげて

63
00:06:15,667 --> 00:06:16,710
えっ？

64
00:06:19,463 --> 00:06:20,464
えっ？

65
00:06:21,173 --> 00:06:23,008
(ばいきんまん) グフフフ～

66
00:06:23,092 --> 00:06:24,093
せーの！

67
00:06:26,345 --> 00:06:27,346
へえっ？

68
00:06:33,185 --> 00:06:35,395
(ばいきんまんたち)
がんばれ がんばれ ばいきんまん

69
00:06:35,896 --> 00:06:38,398
がんばれ がんばれ ばいきんまん

70
00:06:38,565 --> 00:06:41,026
(ばいきんまん)よーし！

71
00:06:41,110 --> 00:06:42,986
げんき100ばい！

72
00:06:43,654 --> 00:06:45,739
ばいきんまーん！

73
00:06:46,031 --> 00:06:48,492
ばいきんパーンチ！

74
00:06:49,701 --> 00:06:51,995
(アンパンマン) うわ～

75
00:06:52,412 --> 00:06:54,498
ばいばいあーん

76
00:06:56,708 --> 00:06:59,503
(ばいきんまん) ハッヒフッヘホ～！

77
00:07:02,089 --> 00:07:03,507
ハッヒ…

78
00:07:03,966 --> 00:07:06,677
んっ んん？ ゆめ？

79
00:07:06,760 --> 00:07:07,761
(うちあげはなびの おと)

80
00:07:07,845 --> 00:07:08,846
おっ

81
00:07:10,514 --> 00:07:12,015
フンッ！ だったら――

82
00:07:12,641 --> 00:07:15,144
ゆめを ほんとにしてやる！

83
00:07:20,566 --> 00:07:22,192
(おおきな おと)

84
00:07:22,276 --> 00:07:23,277
(カバおたち) んん？

85
00:07:26,363 --> 00:07:28,282
(ばいきんまん) ハヒフヘホー！

86
00:07:28,740 --> 00:07:30,784
たのしい なつまつりなんて――

87
00:07:31,034 --> 00:07:32,536
こうだー！

88
00:07:34,329 --> 00:07:37,166
みなさーん　こんなときは

89
00:07:37,249 --> 00:07:38,792
せーの！

90
00:07:38,876 --> 00:07:41,295
(みみたち)
アンパンマーン！

91
00:07:41,378 --> 00:07:46,175
(こだま) アンパンマーン！

92
00:07:46,258 --> 00:07:53,265
♪～

93
00:08:48,528 --> 00:08:55,535
～♪

94
00:09:19,184 --> 00:09:22,104
(セミの なきごえ)

95
00:09:32,239 --> 00:09:35,117
(たべるおと)

96
00:09:35,200 --> 00:09:38,370
あ～むん むぐむぐ

97
00:09:38,954 --> 00:09:41,164
あんっ むぐむぐ

98
00:09:41,248 --> 00:09:44,543
ぼくらの ひみつきち さいこー！

99
00:09:44,793 --> 00:09:48,463
(ちびぞう)
でも おやつをたべてばっかりじゃ
つまんないぞう

100
00:09:48,547 --> 00:09:51,049
(クリームパンダ)
じゃあさ ぼうけんに いこうよ

101
00:09:51,133 --> 00:09:52,134
(ピョンきち) ぼうけん？

102
00:09:52,217 --> 00:09:54,219
(ウサこ)
ぼうけんって なにするの？

103
00:09:54,303 --> 00:09:56,888
(クリームパンダ)
そんなの きまってるじゃないか

104
00:09:57,264 --> 00:09:58,849
えーっとね…

105
00:09:59,766 --> 00:10:01,268
(ちびぞうたち) うん…

106
00:10:01,560 --> 00:10:02,561
(カバお) あ～ん

107
00:10:02,644 --> 00:10:05,522
(クリームパンダ)
アハハハハ　わかんないや

108
00:10:05,605 --> 00:10:06,690
(ちびぞうたち) あ～あ

109
00:10:06,773 --> 00:10:08,191
(おおきな おと)

110
00:10:10,277 --> 00:10:11,778
(おおきな おと)
(ちびぞう) なんだぞう？

111
00:10:11,862 --> 00:10:14,948
(ちびぞうたち) うう… うわあ～

112
00:10:15,032 --> 00:10:17,868
(カバお) わあっ うわあ～ ああ…

113
00:10:17,951 --> 00:10:18,952
(アンパンマン) あっ

114
00:10:19,953 --> 00:10:21,038
(クリームパンダ) カバおくん！

115
00:10:21,121 --> 00:10:24,291
(カバお) うわ～

116
00:10:24,958 --> 00:10:25,959
(アンパンマン) ああっ

117
00:10:28,003 --> 00:10:29,504
(カレーパンマン) だいじょうぶか？

118
00:10:29,963 --> 00:10:31,423
(アンパンマン) カレーパンマン

119
00:10:31,506 --> 00:10:33,467
(カレーパンマン)
よお アンパンマン

120
00:10:34,343 --> 00:10:35,969
(ピョンきち) なんだよ これ？

121
00:10:36,053 --> 00:10:38,472
(クリームパンダ)
こんな あな なかったよ

122
00:10:38,555 --> 00:10:41,641
(ちびぞう) これのせいで
きが かたむいたんだぞう

123
00:10:41,850 --> 00:10:43,101
(あなをほる おと)

124
00:10:43,185 --> 00:10:44,311
(カレーパンマンたち) あ？

125
00:10:44,394 --> 00:10:45,395
(カレーパンマン) ん？

126
00:10:45,979 --> 00:10:46,938
だれだ！

127
00:10:47,022 --> 00:10:47,856
うわっちゃ

128
00:10:47,939 --> 00:10:49,024
(アンパンマンたち) うわあ～

129
00:10:49,107 --> 00:10:50,400
(カレーパンマン) あっ…

130
00:10:52,486 --> 00:10:54,112
(ブルブル) おまえらこそ だれだ？

131
00:10:54,196 --> 00:10:55,113
え～い！

132
00:10:57,657 --> 00:10:58,617
(カレーパンマン) ああ？

133
00:10:58,700 --> 00:11:01,995
(ブルブル)
うわあ ああっ うわ～… ああ

134
00:11:02,245 --> 00:11:05,374
(カレーパンマン)
あ～あ　なにやってんだ

135
00:11:05,457 --> 00:11:06,500
(ブルブル) なにを～

136
00:11:08,001 --> 00:11:11,004
ねえ なんで
こんなに あなをほったの？

137
00:11:11,338 --> 00:11:14,383
(ちびぞう)
ぼくたちの ひみつきちが
だいなしだぞう

138
00:11:14,466 --> 00:11:16,134
(ブルブル) フンッ これさ

139
00:11:16,218 --> 00:11:17,594
たからのちずだ

140
00:11:17,677 --> 00:11:19,096
(クリームパンダ)
たからのちず？

141
00:11:19,179 --> 00:11:22,724
(カバお) うわあ～！ みせて みせて！

142
00:11:25,435 --> 00:11:28,730
(クリームパンダ) そっか
この いわが めじるしだとおもって――

143
00:11:28,814 --> 00:11:29,940
ほったんだね

144
00:11:30,023 --> 00:11:31,024
(ブルブル) ああ

145
00:11:31,108 --> 00:11:33,485
(カレーパンマン)
…で たからものは？

146
00:11:33,860 --> 00:11:34,861
(ブルブル) なかった

147
00:11:34,945 --> 00:11:36,321
(カレーパンマン) な～んだ

148
00:11:36,405 --> 00:11:40,492
(ブルブル) ああ～
たからは いったい どこにあるんだ！

149
00:11:40,700 --> 00:11:44,246
(アンパンマン)
ジャムおじさんにきけば
なにか わかるかもしれないよ

150
00:11:44,329 --> 00:11:46,748
(ブルブル) ん？ ジャムおじさん？

151
00:11:46,832 --> 00:11:47,833
(アンパンマン) うん

152
00:11:48,500 --> 00:11:50,961
ところで おまえ なまえは？

153
00:11:51,294 --> 00:11:52,295
おれか？

154
00:11:53,672 --> 00:11:58,301
エッヘン！ おれは ほこりたかき
たからさがしの いちぞく

155
00:11:58,510 --> 00:11:59,845
ブルブルだ

156
00:12:12,399 --> 00:12:13,650
(クリームパンダ) ただいまー！

157
00:12:13,733 --> 00:12:15,318
(チーズ) アン アーン！
(ジャム･バタコさん) おかえり

158
00:12:16,987 --> 00:12:20,657
(ジャム) うーん　このちずが
どこを しめしているのかを――

159
00:12:20,740 --> 00:12:21,825
しりたいんだね

160
00:12:21,908 --> 00:12:22,951
(ブルブル) ああ

161
00:12:23,034 --> 00:12:26,329
(しょくぱんまん) おお～！
ロマンあふれる ぼうけんのたび！

162
00:12:26,413 --> 00:12:28,623
それが たからさがし

163
00:12:28,707 --> 00:12:30,333
(チーズ) ア～ン

164
00:12:30,667 --> 00:12:34,129
(メロンパンナ) ねえ　ブルブルは
なんで たからさがしをしてるの？

165
00:12:34,212 --> 00:12:37,674
ええっ　なんでって その… あの…

166
00:12:37,757 --> 00:12:40,969
た… たからが ほしいからに
きまってるだろ

167
00:12:41,052 --> 00:12:44,055
(バタコ) ひとりで
たからさがしだなんて すごいわ

168
00:12:44,139 --> 00:12:45,515
(ブルブル) とうぜんさ

169
00:12:45,599 --> 00:12:49,686
なにしろ おれは ほこりたかき
たからさがしの いちぞくだから

170
00:12:49,895 --> 00:12:53,356
かぞくは み～んな
たからさがしの めいじんなんだ

171
00:12:53,440 --> 00:12:54,941
(バタコ･メロンパンナ) へえ～

172
00:12:55,025 --> 00:12:57,861
(ジャム)う～ん
このかたちは たしか…

173
00:12:59,571 --> 00:13:01,364
(ブルブル) あっ これは…

174
00:13:01,615 --> 00:13:05,202
(ジャム) とおい みなみのうみの
オニツノじま だよ

175
00:13:05,285 --> 00:13:06,578
(クリームパンダ) オニツノじま？

176
00:13:06,661 --> 00:13:10,373
(ジャム) ひとのすんでいない
きけんなしまだそうだよ

177
00:13:10,874 --> 00:13:12,042
(ブルブル) きけん…

178
00:13:14,085 --> 00:13:15,420
(クリームパンダ) ねえ ブルブル

179
00:13:15,504 --> 00:13:18,381
こんなところに
ひとりで いくきなの？

180
00:13:18,632 --> 00:13:21,384
あ… ああ　もちろん

181
00:13:21,468 --> 00:13:24,638
(カレーパンマン) …って
ほんとは こわいんじゃないのかい？

182
00:13:24,721 --> 00:13:27,057
(ブルブル)
こ… こわいわけないだろ！

183
00:13:27,140 --> 00:13:30,519
(アンパンマン) フフフフッ
ぼくも いっしょに いこうか？

184
00:13:30,602 --> 00:13:31,645
(ブルブル) ほんと？

185
00:13:31,853 --> 00:13:33,563
(クリームパンダ) ぼくも いく！

186
00:13:33,772 --> 00:13:35,732
(カレーパンマン) しょうがねえな

187
00:13:35,941 --> 00:13:37,817
よし！ おれも いってやるよ

188
00:13:37,901 --> 00:13:39,277
(ブルブル) えーっ！

189
00:13:39,361 --> 00:13:41,821
(カレーパンマン)
なんだよ！ イヤなのか？

190
00:13:41,905 --> 00:13:43,406
(しょくぱんまん) そりゃそうですよ

191
00:13:43,490 --> 00:13:46,576
なにかと からくちの
カレーパンマンが いっしょでは

192
00:13:46,660 --> 00:13:47,661
(カレーパンマン) なにを！

193
00:13:47,994 --> 00:13:49,955
(しょくぱんまん)
でも ごあんしんください

194
00:13:50,038 --> 00:13:52,332
ふんわり やわらかな このわたし――

195
00:13:52,415 --> 00:13:55,210
しょくぱんまんも
いっしょに いきますから

196
00:13:55,293 --> 00:13:57,170
(カレーパンマン) なにが ふんわりだ

197
00:13:57,254 --> 00:13:59,339
しかくいかお しやがって

198
00:13:59,422 --> 00:14:00,674
(しょくぱんまん) なんですって！

199
00:14:01,132 --> 00:14:02,467
(クリームパンダ) ハハハ…
(アンパンマン) フフフッ

200
00:14:02,676 --> 00:14:03,677
(アンパンマン) ん？

201
00:14:07,764 --> 00:14:10,684
(ばいきんまん)
きいちゃった きいちゃった♪

202
00:14:11,560 --> 00:14:14,688
おたからは ぜんぶ
おれさまが いただきだー！

203
00:14:14,938 --> 00:14:16,648
(ドキン) あたしは
しょくぱんまんさまと――

204
00:14:16,731 --> 00:14:19,192
ぼうけんのたびが
した～い

205
00:14:19,276 --> 00:14:20,694
ぼうけんのたび？

206
00:14:20,944 --> 00:14:24,698
そうよ
そして ジャングルの おくちで…

207
00:14:27,617 --> 00:14:29,703
(かびるんるんたち)
かびっ かび　かびっ かび

208
00:14:29,786 --> 00:14:33,707
(ドキン)
イヤ～！ だれか たすけて～！

209
00:14:33,790 --> 00:14:35,208
(かびるんるんたち) かびっ かび

210
00:14:35,292 --> 00:14:38,378
(ドキン) ああーっ あ～ん
(かびるんるんたち) かび～

211
00:14:38,461 --> 00:14:40,714
(キングゴリラ) うおーっ

212
00:14:41,006 --> 00:14:43,466
やめなさい！ キングゴリラ！

213
00:14:44,968 --> 00:14:46,803
しょくぱんまんさま～

214
00:14:47,887 --> 00:14:49,431
さあ！ こっちへ

215
00:14:49,514 --> 00:14:50,515
はい

216
00:14:51,224 --> 00:14:54,477
あの… どちらへ いくんですか？

217
00:14:54,894 --> 00:14:57,272
(しょくぱんまん)
ぼうけんの たびが したいなら…

218
00:14:58,106 --> 00:15:00,066
(ホラーマン)
ホラーランドですよ

219
00:15:00,150 --> 00:15:01,151
ホラ～

220
00:15:01,943 --> 00:15:03,528
(ドキン) げっ　ホラーマン

221
00:15:03,612 --> 00:15:04,613
(ホラーマン) はい

222
00:15:04,696 --> 00:15:09,659
みのけもよだつ ホラーなせかいで
ラブラブになりましょう

223
00:15:10,660 --> 00:15:12,912
ホラ～

224
00:15:25,467 --> 00:15:30,555
(ブルブル)
<みつけるんだ　みつけるんだ　はやく>

225
00:15:32,766 --> 00:15:34,059
<そうしないと…>

226
00:15:36,686 --> 00:15:38,980
(とりの なきごえ)

227
00:15:39,064 --> 00:15:40,065
(バタコ) きをつけてね

228
00:15:40,565 --> 00:15:43,026
(メロンパンナ) むりしちゃダメよ
クリームパンダちゃん

229
00:15:43,109 --> 00:15:45,904
(クリームパンダ) だいじょうぶだよ
メロンパンナおねえちゃん

230
00:15:45,987 --> 00:15:47,030
(カレーパンマン) よし いくぞ！

231
00:15:47,113 --> 00:15:48,823
(カレーパンマン) ほいやって
(ブルブル) うわ～

232
00:15:48,907 --> 00:15:51,284
(ブルブル) うわ～ うわ～

233
00:15:51,368 --> 00:15:53,328
(アンパンマンたち) いってきまーす

234
00:15:53,411 --> 00:15:55,413
(ジャムたち) いってらっしゃーい

235
00:15:55,497 --> 00:15:56,831
(チーズ) アン アン アン

236
00:16:07,217 --> 00:16:08,218
ハア…

237
00:16:10,345 --> 00:16:12,013
うわ～！

238
00:16:12,097 --> 00:16:14,474
お… おろして～

239
00:16:14,557 --> 00:16:15,684
(カレーパンマン) ええ？

240
00:16:16,393 --> 00:16:17,936
(ブルブル) うわ～

241
00:16:18,687 --> 00:16:20,105
(アンパンマン) どうしたの？

242
00:16:20,355 --> 00:16:22,649
(ブルブル) えっと… その…

243
00:16:22,732 --> 00:16:25,276
(カレーパンマン) はは～ん
もしかして おまえ――

244
00:16:25,360 --> 00:16:27,362
たかいところが こわいんだろ

245
00:16:27,445 --> 00:16:28,488
(ブルブル) ん？

246
00:16:28,738 --> 00:16:31,199
こ… こわいわけ ないだろ！

247
00:16:31,491 --> 00:16:34,327
そうだ
とうさんに いわれたんだ

248
00:16:34,411 --> 00:16:37,622
たからさがしで
そらを とぶのは ダメだって

249
00:16:37,831 --> 00:16:40,041
(カレーパンマン)
はあ？ なんだそりゃ

250
00:16:40,667 --> 00:16:42,877
しかし こまりましたね

251
00:16:42,961 --> 00:16:45,588
あるいていくには とおすぎるよ

252
00:16:45,672 --> 00:16:47,006
(アンパンマン) う～ん…

253
00:16:47,090 --> 00:16:48,925
(きてきの おと)

254
00:16:49,008 --> 00:16:50,301
(カレーパンマン) あ？
(アンパンマン) おっ

255
00:16:50,385 --> 00:16:52,220
(アンパンマンたち) ＳＬマン！

256
00:16:59,310 --> 00:17:02,105
(ＳＬマン)
そういうことなら おやすいごようさ！

257
00:17:04,274 --> 00:17:07,485
あいつら ＳＬマンに
のっていくつもりか

258
00:17:07,569 --> 00:17:11,531
あたしも しょくぱんまんさまと
れっしゃのたびがした～い

259
00:17:11,614 --> 00:17:14,033
げっ… そうくるとおもった

260
00:17:15,827 --> 00:17:17,412
(ばいきんまん･ドキン)
ハロ～

261
00:17:17,495 --> 00:17:18,705
(アンパンマンたち)
ん？

262
00:17:18,955 --> 00:17:20,331
(カレーパンマン) なんだ？

263
00:17:20,790 --> 00:17:23,084
わがはいは バイキンソン

264
00:17:23,168 --> 00:17:24,919
あたしは ドキレーヌ

265
00:17:25,003 --> 00:17:29,048
(ふたり)
ふたりあわせて おたからハンターズ

266
00:17:29,716 --> 00:17:32,719
せかいいちの
たからさがし めいじんなのだ！

267
00:17:33,094 --> 00:17:34,304
(クリームパンダ) へえ～

268
00:17:34,387 --> 00:17:36,264
ブルブルと おなじだね

269
00:17:36,890 --> 00:17:38,349
(ブルブル) お… おう

270
00:17:38,433 --> 00:17:40,268
(ばいきんまん) ほほ～ きみもか

271
00:17:40,351 --> 00:17:42,979
(ドキン)
これも なにかの ごえんですわ

272
00:17:43,062 --> 00:17:44,063
(ばいきんまん) わがはいたちも――

273
00:17:44,147 --> 00:17:46,274
いっしょに いってやろう

274
00:17:46,524 --> 00:17:48,443
それじゃあ しゅっぱつするよ

275
00:17:48,526 --> 00:17:49,986
(アンパンマンたち) おおー！

276
00:17:50,653 --> 00:17:52,113
(きてきの おと)

277
00:17:52,822 --> 00:17:59,829
♪～

278
00:18:14,135 --> 00:18:17,889
♪ 白い雲が流れる

279
00:18:19,224 --> 00:18:22,852
♪ かわいい花咲いてる

280
00:18:23,228 --> 00:18:30,026
♪ 太陽がキラキラ キラキララ

281
00:18:30,109 --> 00:18:33,655
♪ キララ キラキラ ラララ

282
00:18:33,905 --> 00:18:36,157
♪ うれしいぼくら

283
00:18:36,241 --> 00:18:38,660
♪ おどりながら

284
00:18:38,743 --> 00:18:41,663
♪ ズンダダ ズダダン
ズンダダ ズダダン

285
00:18:41,955 --> 00:18:45,250
♪ あるいていこう

286
00:19:05,395 --> 00:19:09,107
♪ 風の歌がきこえる

287
00:19:10,441 --> 00:19:14,112
♪ 丘をこえていこうよ

288
00:19:14,404 --> 00:19:21,327
♪ 太陽がキラキラ キラキララ

289
00:19:21,411 --> 00:19:24,956
♪ キララ キラキラ ラララ

290
00:19:25,206 --> 00:19:27,333
♪ たのしい歌を

291
00:19:27,584 --> 00:19:29,961
♪ うたいながら

292
00:19:30,044 --> 00:19:32,797
♪ ズンダダ ズダダン
ズンダダ ズダダン

293
00:19:33,256 --> 00:19:36,259
♪ あるいていこう

294
00:19:43,099 --> 00:19:50,106
～♪

295
00:20:01,200 --> 00:20:03,286
(カレーパンマン)
やっぱり こわいんじゃないのか？

296
00:20:03,369 --> 00:20:04,370
(ブルブル) ええっ

297
00:20:04,579 --> 00:20:05,747
(カレーパンマン) んん？

298
00:20:05,830 --> 00:20:07,749
ち… ちがうよ！

299
00:20:07,957 --> 00:20:09,876
ちょっと さむいだけだよ

300
00:20:09,959 --> 00:20:11,210
ふ～ん

301
00:20:12,086 --> 00:20:13,838
(しょくぱんまん)
では いきましょうか

302
00:20:13,922 --> 00:20:15,173
(アンパンマンたち) おー！

303
00:20:18,092 --> 00:20:21,512
(とりの なきごえ)

304
00:20:33,066 --> 00:20:35,693
(ブルブル) うう… うーん

305
00:20:36,069 --> 00:20:38,363
(ドキン) ウフフ フフッ

306
00:20:42,700 --> 00:20:43,993
(とりの なきごえ)

307
00:20:44,077 --> 00:20:45,703
うわあ～！

308
00:20:45,787 --> 00:20:47,455
(ブルブル) うわあ～！

309
00:20:47,538 --> 00:20:48,998
(ばいきんまん) うわあ～！

310
00:20:49,248 --> 00:20:51,834
(ドキン) キャー ですわ～

311
00:20:52,126 --> 00:20:53,127
(しょくぱんまん) ああ…

312
00:20:53,920 --> 00:20:56,506
なんだよ　こわがりだなあ

313
00:20:56,589 --> 00:20:58,424
(ブルブル)
ク… クリームパンダちゃんが――

314
00:20:58,508 --> 00:21:00,134
おおきなこえ だしたから！

315
00:21:00,218 --> 00:21:01,511
(クリームパンダ) ブルブルだって！

316
00:21:02,428 --> 00:21:05,515
…にしても
ほんとに こっちで あってんのか？

317
00:21:05,890 --> 00:21:08,226
(しょくぱんまん) ジャングルに はいって
めじるしのやまが――

318
00:21:08,309 --> 00:21:10,436
みえなくなりましたからね

319
00:21:10,520 --> 00:21:14,399
(ばいきんまん) えーい！
だれか はやく なんとかせんか！

320
00:21:14,482 --> 00:21:16,985
(カレーパンマン)
…て おたからハンターズだろ？

321
00:21:17,068 --> 00:21:18,653
(しょくぱんまん)
なにか やくにたつものは――

322
00:21:18,736 --> 00:21:19,946
もってないんですか？

323
00:21:20,029 --> 00:21:21,030
(ばいきんまん) ない！

324
00:21:21,864 --> 00:21:23,741
コンパスなら もってるよ

325
00:21:23,825 --> 00:21:25,159
(ばいきんまん)
おっ いい… いいぞ！

326
00:21:25,243 --> 00:21:27,036
かせ かせ～い

327
00:21:27,120 --> 00:21:31,332
んん～ ほっほっほう
ほ～う ほう？ ほほ…

328
00:21:31,416 --> 00:21:32,542
おお～

329
00:21:32,625 --> 00:21:36,045
め… めが… まわる～

330
00:21:37,213 --> 00:21:38,339
(アンパンマン) おーい

331
00:21:38,423 --> 00:21:39,424
(ふたり) ん？

332
00:21:39,507 --> 00:21:42,051
(アンパンマン)
やまは こっちの ほうがくだよー

333
00:21:53,813 --> 00:21:55,565
(みんな) わあ…

334
00:22:09,245 --> 00:22:10,705
(ドキン) すごーい

335
00:22:10,788 --> 00:22:12,957
(クリームパンダ)
ここ おしろだったのかな？

336
00:22:14,292 --> 00:22:15,585
(ブルブル) ここだ

337
00:22:16,085 --> 00:22:17,462
ここに まちがいない！

338
00:22:17,837 --> 00:22:20,381
(ばいきんまん)
よーし！ おたからだ！

339
00:22:20,465 --> 00:22:21,883
(アンパンマン) いこう ブルブル

340
00:22:21,966 --> 00:22:22,967
(ブルブル) うん！

341
00:22:37,565 --> 00:22:39,358
(ばいきんまん)
さてと… ほい　おおっ？

342
00:22:39,442 --> 00:22:40,485
(カレーパンマンたち) あっ

343
00:22:41,402 --> 00:22:43,237
(カレーパンマン)
でっかい とびらだなあ

344
00:22:43,321 --> 00:22:45,490
(しょくぱんまん)
たからものは
このなかでしょうか？

345
00:22:45,573 --> 00:22:47,575
(クリームパンダ)
きっと そうだよ！

346
00:22:47,658 --> 00:22:48,993
(ばいきんまん)
よーし！

347
00:22:49,869 --> 00:22:52,789
うーん… うーん…

348
00:22:52,872 --> 00:22:54,499
うーん…

349
00:22:54,582 --> 00:22:57,001
このっ このっ このっ

350
00:22:57,376 --> 00:22:59,253
(カレーパンマン)
こんどは おれだ

351
00:23:00,004 --> 00:23:02,381
カレーパーンチ！

352
00:23:03,508 --> 00:23:05,551
あ～っ たったったった…

353
00:23:05,635 --> 00:23:07,303
(しょくぱんまん)
ここに なにかあります

354
00:23:07,386 --> 00:23:08,554
(ブルブル･ばいきんまん) ん？

355
00:23:09,180 --> 00:23:10,640
(アンパンマン) こっちにも あるよ

356
00:23:10,723 --> 00:23:11,724
(カレーパンマンたち)
ん？

357
00:23:12,058 --> 00:23:13,392
(しょくぱんまん) うーん

358
00:23:13,476 --> 00:23:17,772
どうやら このくぼみが
カギあなに なっているようですね

359
00:23:17,855 --> 00:23:20,316
そして そのうえには へきが

360
00:23:20,983 --> 00:23:24,779
つまり このとびらをあけるには
ふたつのカギが ひつようで――

361
00:23:24,862 --> 00:23:28,324
そのカギは ふたつのやまの
ちょうじょうに あるんです

362
00:23:28,908 --> 00:23:31,828
さすが
しょくぱんまんさまですわ～

363
00:23:32,120 --> 00:23:35,039
(アンパンマン)
じゃあ そのカギを
とりに いかないと…

364
00:23:35,123 --> 00:23:36,040
(ばいきんまん) フンッ！

365
00:23:36,124 --> 00:23:38,334
そんな めんどうなこと
やってられるか

366
00:23:38,417 --> 00:23:39,836
(アンパンマンたち) ん？

367
00:23:40,086 --> 00:23:42,338
うわあ～ ああ ああ

368
00:23:42,755 --> 00:23:44,674
そんなこと やっていいの？

369
00:23:44,757 --> 00:23:46,467
(ばいきんまん) あけたもんがちだ～

370
00:23:46,551 --> 00:23:49,554
(いいかげんにしろ)
いいかげんにしろー！

371
00:23:49,637 --> 00:23:50,847
(クリームパンダ) あっ
(ばいきんまん)おお？

372
00:24:05,027 --> 00:24:07,196
(たいがいにしろ)
たいがいにしろー！

373
00:24:07,280 --> 00:24:10,533
(そのへんにしろ)
そのへんにしろー！

374
00:24:12,243 --> 00:24:13,870
(カレーパンマン)
な… なんだ こいつら？

375
00:24:14,245 --> 00:24:17,415
(しょくぱんまん)
もしかして たからものを
まもっているんじゃ…

376
00:24:17,498 --> 00:24:18,499
(アンパンマンたち) ええっ

377
00:24:20,084 --> 00:24:21,127
(アンパンマンたち) うわあっ

378
00:24:21,377 --> 00:24:22,378
(しょくぱんまんたち) うわあっ

379
00:24:23,963 --> 00:24:24,964
(アンパンマン) うわっ

380
00:24:31,470 --> 00:24:35,516
(ブルブルたち) うわあ～ うわあ～

381
00:24:35,600 --> 00:24:37,894
(ブルブル) うう… うわ～ うっ…

382
00:24:38,519 --> 00:24:40,897
ブルブル！ それで あいつらを！

383
00:24:40,980 --> 00:24:42,023
うん

384
00:24:42,523 --> 00:24:44,025
よ… よーし！

385
00:24:45,193 --> 00:24:46,277
(いいかげんにしろ) んん？

386
00:24:46,360 --> 00:24:47,570
(ブルブル) うっ…

387
00:24:47,862 --> 00:24:50,948
うわ～

388
00:24:51,365 --> 00:24:52,867
うっ うう…

389
00:24:52,950 --> 00:24:54,619
なにやってんだよ！

390
00:25:03,044 --> 00:25:04,754
ああっ うっ く…

391
00:25:07,590 --> 00:25:09,508
(しょくぱんまん) うう…
(クリームパンダ) うわあ…

392
00:25:09,759 --> 00:25:11,510
(ブルブル)ううっ
(カレーパンマン) んん…

393
00:25:11,802 --> 00:25:13,512
(ばいきんまん) おお… おおっ
(ドキン) うう…

394
00:25:14,180 --> 00:25:16,807
(マントが やぶれるおと)

395
00:25:17,225 --> 00:25:19,644
マントが… うっ ううっ

396
00:25:19,727 --> 00:25:22,480
うわあ～　うう…

397
00:25:22,688 --> 00:25:24,065
(クリームパンダ)うわ～

398
00:25:24,148 --> 00:25:25,483
(しょくぱんまん) うわー
(ばいきんまん) うわあ

399
00:25:25,566 --> 00:25:27,944
(カレーパンマン) わあー
(ブルブル) わあ～

400
00:25:38,955 --> 00:25:40,456
(アンパンマン) ええ… んっ

401
00:25:40,957 --> 00:25:41,958
わあっ

402
00:25:45,127 --> 00:25:47,255
んん… ふっ

403
00:25:48,965 --> 00:25:49,966
みんなは？

404
00:25:50,049 --> 00:25:54,971
(クリームパンダたち) わあ～

405
00:25:55,263 --> 00:25:56,472
(しょくぱんまん) うわああ～

406
00:25:56,555 --> 00:25:57,848
(クリームパンダ) あ～っ

407
00:25:57,932 --> 00:25:59,976
(ばいきんまん) どわっ
(クリームパンダ) わああっ

408
00:26:00,351 --> 00:26:02,895
(ばいきんまん) フウ～ たすかった

409
00:26:03,145 --> 00:26:04,272
うわっはーっ

410
00:26:04,355 --> 00:26:05,356
(しょくぱんまんたち) あっ

411
00:26:05,439 --> 00:26:06,482
(おちた おと)

412
00:26:08,067 --> 00:26:11,487
(ブルブル) うわあ～

413
00:26:11,570 --> 00:26:15,491
あああ～　うわあ～

414
00:26:19,662 --> 00:26:22,999
(カレーパンマン)
アイターッ イタッタッタッタ

415
00:26:24,292 --> 00:26:27,336
ああ… これじゃあ ダメだ

416
00:26:27,420 --> 00:26:30,214
(ブルブル) えーっ　とべないの？

417
00:26:30,298 --> 00:26:31,299
ああ？

418
00:26:31,382 --> 00:26:34,844
そらをとぶのは ダメだって
おまえが いってたんじゃないか！

419
00:26:34,927 --> 00:26:35,845
うっ…

420
00:26:36,178 --> 00:26:39,640
じゃ… じゃあ
さっきのばしょに もどろうよ

421
00:26:39,890 --> 00:26:42,101
アンパンマンたちを さがさなきゃ

422
00:26:42,184 --> 00:26:44,562
いや　カギを さがしにいこう

423
00:26:44,645 --> 00:26:45,646
えーっ

424
00:26:45,730 --> 00:26:48,566
(カレーパンマン) ここからだったら
ちょうじょうのほうが ちかい

425
00:26:48,774 --> 00:26:51,652
アンパンマンたちを さがすのは
それからだ

426
00:26:51,736 --> 00:26:53,070
(ブルブル) ええーっ

427
00:26:53,154 --> 00:26:54,322
いくぞ！

428
00:26:54,572 --> 00:26:55,656
(ブルブル) うう…

429
00:26:57,867 --> 00:27:01,996
なんで よりによって
カレーパンマンなんだろう

430
00:27:02,079 --> 00:27:03,205
ハア…

431
00:27:05,708 --> 00:27:08,294
ブルブルたちは
だいじょうぶでしょうか？

432
00:27:08,669 --> 00:27:10,212
(ばいきんまん)
あんなやつらは ほっといて――

433
00:27:10,296 --> 00:27:12,715
やまのちょうじょうに いそぐのだ

434
00:27:12,798 --> 00:27:14,133
(クリームパンダ) あんなやつら？

435
00:27:14,216 --> 00:27:15,676
(ばいきんまん) いいから いいから

436
00:27:15,760 --> 00:27:16,594
(クリームパンダ) うわあっ

437
00:27:16,677 --> 00:27:19,013
(ばいきんまん)
きっと みんなも
やまに むかっている

438
00:27:19,096 --> 00:27:21,140
(ドキン) いきましょう
しょくぱんまんさま～

439
00:27:21,223 --> 00:27:22,516
(しょくぱんまん)
ああっ

440
00:27:28,773 --> 00:27:32,276
(ブルブル) ううう… うう うう…

441
00:27:32,360 --> 00:27:36,322
ハッ… ハッ… ハークション！

442
00:27:36,405 --> 00:27:38,324
うわあああっ

443
00:27:39,909 --> 00:27:41,077
うわあああっ

444
00:27:41,660 --> 00:27:42,495
うっ…

445
00:27:42,578 --> 00:27:44,497
うわあああ

446
00:27:46,499 --> 00:27:49,043
うーわあああ

447
00:27:49,377 --> 00:27:51,337
(カレーパンマン) ん？ あめだ

448
00:27:51,754 --> 00:27:53,839
どこかで あまやどりしないと

449
00:27:58,928 --> 00:28:01,847
(かみなりの おと)

450
00:28:05,393 --> 00:28:06,310
(ブルブル) ああ…

451
00:28:06,394 --> 00:28:07,311
(カレーパンマン) なあ…

452
00:28:07,395 --> 00:28:08,396
うわああっ

453
00:28:08,479 --> 00:28:11,232
…て こえをかけただけだろ？

454
00:28:11,440 --> 00:28:12,775
だいじょうぶか？

455
00:28:12,858 --> 00:28:14,819
だ… だいじょうぶだよ

456
00:28:14,902 --> 00:28:16,862
(かみなりの おと)
(ブルブル) うわあああ

457
00:28:28,165 --> 00:28:30,501
おっ やんだようだな

458
00:28:31,919 --> 00:28:34,255
(ブルブル) ああ… うう…

459
00:28:34,713 --> 00:28:36,507
(カレーパンマン) フウ…

460
00:28:37,341 --> 00:28:40,261
(クリームパンダ)
わあっ きれいな ゆうやけ！

461
00:28:40,636 --> 00:28:42,763
(しょくぱんまん)
やっと あめが やみましたね

462
00:28:42,847 --> 00:28:44,682
(ドキン) ロマンチックですわ～

463
00:28:44,765 --> 00:28:45,850
(おなかがなる おと)

464
00:28:45,933 --> 00:28:46,934
(３にん) あっ

465
00:28:47,601 --> 00:28:50,187
(ばいきんまん) はらがへった～

466
00:28:50,479 --> 00:28:53,149
(ドキン) ぜんぜん
ロマンチックじゃありませんわ

467
00:28:53,232 --> 00:28:56,777
(ばいきんまん) しか～し
わがはいに ぬかりはない！

468
00:29:01,407 --> 00:29:04,452
(クリームパンダ)
うわーっ ハハッ すごーい！

469
00:29:04,660 --> 00:29:05,661
(ばいきんまん) んぬっ
(クリームパンダ) ひゃ～

470
00:29:05,744 --> 00:29:07,913
これは わがはいだけのものー！

471
00:29:08,497 --> 00:29:11,375
(ドキン) なんですってー？

472
00:29:11,459 --> 00:29:13,669
(ばいきんまん) ジョ… ジョークです～

473
00:29:14,128 --> 00:29:16,672
さあ みんなで たべようではないか

474
00:29:16,755 --> 00:29:17,756
(クリームパンダたち) はい！

475
00:29:26,474 --> 00:29:27,892
(おなかがなる おと)
ハッ

476
00:29:28,851 --> 00:29:30,478
ハア～

477
00:29:31,854 --> 00:29:33,355
んっ くんくん

478
00:29:33,439 --> 00:29:34,440
あっ？

479
00:29:34,982 --> 00:29:36,192
くん くんくん

480
00:29:36,275 --> 00:29:37,902
くん くん くん

481
00:29:38,110 --> 00:29:39,612
くん くん

482
00:29:39,904 --> 00:29:40,946
カレー？

483
00:29:41,530 --> 00:29:43,324
さめないうちに たべな

484
00:29:43,407 --> 00:29:45,075
(ブルブル) う… うん

485
00:29:46,035 --> 00:29:48,162
はむっ うんうん うんうん

486
00:29:48,704 --> 00:29:50,998
はむっ うんうん うん

487
00:29:51,081 --> 00:29:52,583
おいしい～

488
00:29:52,666 --> 00:29:55,711
ヘッ ハハハ　よかったな

489
00:29:57,171 --> 00:29:59,256
さーて ねるか

490
00:29:59,507 --> 00:30:00,591
(ブルブル) うん

491
00:30:04,053 --> 00:30:06,680
(カレーパンマン)
きれいな ほしぞらだな

492
00:30:06,764 --> 00:30:07,806
(ブルブル) うん

493
00:30:12,561 --> 00:30:14,271
ねえ カレーパンマン

494
00:30:14,355 --> 00:30:15,356
(カレーパンマン) んん？

495
00:30:15,773 --> 00:30:16,899
(ブルブル) あのね

496
00:30:17,566 --> 00:30:21,529
ぼく ほんとうは
とっても こわがりなんだ

497
00:30:22,446 --> 00:30:23,656
そっか

498
00:30:24,698 --> 00:30:27,868
(ブルブル) かぞくは みんな
たからさがしの めいじん

499
00:30:28,786 --> 00:30:32,206
でも ぼくだけは ぜんぜんダメで…

500
00:30:33,415 --> 00:30:35,918
にいさんたちにも バカにされて――

501
00:30:36,752 --> 00:30:39,129
よけいに じしんが なくなって

502
00:30:39,672 --> 00:30:42,883
そしたら あるひ とうさんが…

503
00:30:44,260 --> 00:30:45,386
たからさがし？

504
00:30:46,053 --> 00:30:48,055
とうさんと いっしょに いくんだよね？

505
00:30:48,138 --> 00:30:50,683
(ブルブルの おとうさん)
いや おまえひとりで いくんだ

506
00:30:50,766 --> 00:30:52,017
えーっ！

507
00:30:52,226 --> 00:30:53,227
ヤダ ヤダ！

508
00:30:53,435 --> 00:30:55,813
そんなのぜったいに イヤだよ！

509
00:30:56,021 --> 00:30:58,607
いいか おまえのにいさんたちも――

510
00:30:58,691 --> 00:31:01,527
みんな ひとりで たびだち
たからをみつけ――

511
00:31:01,610 --> 00:31:03,904
たからさがしの
めいじんになったんだぞ

512
00:31:04,572 --> 00:31:05,823
だって…

513
00:31:06,115 --> 00:31:08,158
にいさんたちは
からだも おっきいし――

514
00:31:08,242 --> 00:31:09,410
つよいけど――

515
00:31:09,493 --> 00:31:13,080
ぼくは まだ ちいさいし
よわいし こわがりだし

516
00:31:13,163 --> 00:31:14,331
それに…

517
00:31:15,374 --> 00:31:17,751
それに とうさんみたいな
たてがみだって――

518
00:31:17,835 --> 00:31:19,295
はえてないし

519
00:31:19,837 --> 00:31:22,756
(おとうさん)
だいじょうぶだ
おまえならできる

520
00:31:23,132 --> 00:31:25,092
イヤだ！ いきたくない！

521
00:31:25,175 --> 00:31:26,176
ダメだ！

522
00:31:26,260 --> 00:31:27,845
たからを みつけてくるまでは――

523
00:31:27,928 --> 00:31:29,597
ぜったいに かえってくるな！

524
00:31:29,680 --> 00:31:31,307
え～！

525
00:31:32,433 --> 00:31:33,434
うう…

526
00:31:34,268 --> 00:31:37,938
うわ～ん　イヤだよ～　うわ～

527
00:31:38,022 --> 00:31:40,190
(おとうさん) ガア～ッ！
(ブルブル) うわあ～

528
00:31:40,774 --> 00:31:42,109
(おとうさん) はやく いけ！

529
00:31:42,192 --> 00:31:45,946
(ブルブル) うう… うわ～

530
00:31:46,155 --> 00:31:48,198
ハア… ハア… ううっ

531
00:31:48,282 --> 00:31:49,450
(カレーパンマン) ふーん

532
00:31:50,326 --> 00:31:54,496
それで たからさがしのたびに
でたってわけか

533
00:31:54,997 --> 00:31:56,457
(ブルブル) うっ うっ うう…

534
00:31:56,540 --> 00:31:59,460
ぼく もう
おうちに かえりたいよ

535
00:31:59,543 --> 00:32:02,588
たからさがしなんて したくないよ

536
00:32:02,671 --> 00:32:04,048
なくなよ

537
00:32:04,256 --> 00:32:07,092
“なくな”って いわれると――

538
00:32:07,176 --> 00:32:09,845
よけいに なきたくなるんだよ～

539
00:32:09,928 --> 00:32:12,765
うわ～ん　わ～ん

540
00:32:12,848 --> 00:32:15,976
わかった わかった
じゃあ なけ なけ

541
00:32:16,060 --> 00:32:19,188
うわ～ん　あ～ん

542
00:32:19,271 --> 00:32:20,147
(カレーパンマン) まだ まだ！

543
00:32:20,230 --> 00:32:24,068
(ブルブル) うわ～ん　あん あん あん

544
00:32:24,151 --> 00:32:25,235
(カレーパンマン) もっと もっと！

545
00:32:25,319 --> 00:32:30,240
(ブルブル) うわ～ん　うわあ わあ～

546
00:32:30,324 --> 00:32:31,700
(カレーパンマン) いけ いけ～！

547
00:32:31,784 --> 00:32:36,413
(ブルブル) うわ～ん　うう…

548
00:32:38,666 --> 00:32:42,586
ひっ うう… ひっ うう…

549
00:32:42,670 --> 00:32:44,546
(カレーパンマン) すっきりしたか？

550
00:32:45,756 --> 00:32:46,757
ええ？

551
00:32:47,174 --> 00:32:48,592
じゃあ ねろ

552
00:32:49,093 --> 00:32:51,470
(ブルブル) ああ… ハア…

553
00:32:54,056 --> 00:32:55,349
ハア…

554
00:32:56,517 --> 00:32:58,977
ガオーッ！

555
00:32:59,353 --> 00:33:02,147
うわああ うわあ～

556
00:33:02,356 --> 00:33:04,400
ねえ カレーパンマン

557
00:33:04,483 --> 00:33:06,276
どうすれば
こわくなくなるんだろう？

558
00:33:06,360 --> 00:33:07,361
(カレーパンマンの いびき)

559
00:33:07,444 --> 00:33:08,445
は？

560
00:33:10,197 --> 00:33:11,699
(いびき)

561
00:33:12,282 --> 00:33:13,450
(ブルブル) ああ…

562
00:33:16,578 --> 00:33:17,955
う～ん…

563
00:33:20,249 --> 00:33:21,458
うん…

564
00:33:35,889 --> 00:33:38,976
ん～！ ヘッ　いい あさひだな

565
00:33:39,351 --> 00:33:42,479
おれ たいようをみてると
なんか こころのおくが――

566
00:33:42,563 --> 00:33:44,648
カーッと あつくなってくるんだ

567
00:33:44,732 --> 00:33:45,733
(ブルブル) ああ…

568
00:33:52,740 --> 00:33:54,450
(カレーパンマン) じゃあ しゅっぱつだ！

569
00:33:54,533 --> 00:33:55,534
うん

570
00:34:00,873 --> 00:34:04,668
(とりの なきごえ)

571
00:34:14,261 --> 00:34:15,387
(ブルブル) うわっ うわ～

572
00:34:15,471 --> 00:34:16,430
ん？ あっ

573
00:34:16,513 --> 00:34:18,474
うう… うわ～

574
00:34:18,557 --> 00:34:20,017
(カレーパンマン) そこなしぬまだ！

575
00:34:20,893 --> 00:34:23,353
たすけて～

576
00:34:23,437 --> 00:34:24,521
(カレーパンマン) つかまれ！

577
00:34:24,605 --> 00:34:27,524
ううう… ダ… ダメだよう

578
00:34:28,025 --> 00:34:30,152
たいじょうぶだ！ あきらめるな！

579
00:34:30,235 --> 00:34:33,030
(ブルブル) うううっ うう～ ううっ！

580
00:34:33,614 --> 00:34:36,158
(カレーパンマン) んっ くっ んん～

581
00:34:37,159 --> 00:34:38,160
(カレーパンマン) だっ！

582
00:34:39,119 --> 00:34:41,038
(カレーパンマン) おりゃ～！
(ブルブル) うわ～

583
00:34:41,121 --> 00:34:45,417
うわ～ん　こわかったよ～

584
00:34:45,501 --> 00:34:48,629
まっ たすかったんだから
よかったじゃねえか

585
00:34:49,379 --> 00:34:50,589
(ブルブル) うわ～ん

586
00:34:50,672 --> 00:34:52,049
(カレーパンマン) さ～てと

587
00:34:52,633 --> 00:34:56,512
(ブルブルの なきごえ)

588
00:34:56,595 --> 00:34:57,971
よし！ いこうぜ！

589
00:34:58,055 --> 00:34:59,056
えっ

590
00:35:04,311 --> 00:35:07,231
(ブルブル)うわ～ ああ～ うわ～

591
00:35:07,314 --> 00:35:09,316
(カレーパンマン) くっ！ はっ！

592
00:35:10,651 --> 00:35:12,945
しっかり つかまってろよー！

593
00:35:14,530 --> 00:35:17,825
(ふたり) う… うわっ　うわ～！

594
00:35:17,908 --> 00:35:18,951
(ワニ) ワニブーッ

595
00:35:19,576 --> 00:35:20,828
(ワニ) ワワワッ ワニーッ
(カレーパンマン･ブルブル) わあ～

596
00:35:20,911 --> 00:35:22,913
(ワニ) ワニ ワニ ワニ
(ブルブル) うわああ～

597
00:35:23,205 --> 00:35:27,000
(ワニ) ワニーッ ワニ ワニ ワニ
(ブルブル) うわ～　うわ～

598
00:35:27,334 --> 00:35:28,669
(ワニ) ワーッ

599
00:35:28,752 --> 00:35:32,047
(ふたり) うわ～

600
00:35:33,924 --> 00:35:34,925
(カレーパンマン) ぎゃあっ

601
00:35:35,425 --> 00:35:37,386
(カレーパンマン) あ… イテテ…
(ブルブル) ハア…

602
00:35:37,469 --> 00:35:39,888
とんだめに あっちまったなあ

603
00:35:39,972 --> 00:35:41,723
フッ ハハハハッ

604
00:35:41,807 --> 00:35:43,809
わらいごとじゃないよ！

605
00:35:50,858 --> 00:35:51,900
(ブルブル) ああ…

606
00:35:53,986 --> 00:35:55,988
こんなの のぼれないよ

607
00:35:56,071 --> 00:35:57,072
(カレーパンマン) だいじょうぶ！

608
00:35:57,447 --> 00:35:58,532
いざってときは――

609
00:35:58,615 --> 00:36:00,075
あたって くだけろだ！

610
00:36:01,618 --> 00:36:04,079
(カレーパンマン) んっ くう… んっ

611
00:36:12,963 --> 00:36:15,674
くっ　んっ

612
00:36:15,757 --> 00:36:18,760
あっ… う～わ～ ううっ

613
00:36:18,844 --> 00:36:20,470
うっ うう…

614
00:36:20,846 --> 00:36:23,056
(カレーパンマン)
んんっ… よっ

615
00:36:23,473 --> 00:36:25,976
うっ　んっ　んん…

616
00:36:27,144 --> 00:36:30,606
(カレーパンマン) あっ… ああ～
(ブルブル) ああ～

617
00:36:31,148 --> 00:36:34,860
カレ～ パーンチ！

618
00:36:40,699 --> 00:36:41,700
(カレーパンマン) んっ

619
00:36:47,915 --> 00:36:50,876
うわ～ん　こわかったよ～

620
00:36:51,168 --> 00:36:53,587
ハア… ハア… ハア

621
00:36:53,670 --> 00:36:55,380
まっ ちょっとな

622
00:37:00,385 --> 00:37:01,261
(ブルブル) ああ…

623
00:37:01,345 --> 00:37:03,764
(かぜのおと)

624
00:37:12,439 --> 00:37:13,649
(ブルブル) むり

625
00:37:13,732 --> 00:37:17,361
うううっ
こんどこそ ぜったいに むり

626
00:37:17,569 --> 00:37:20,072
だいじょうぶ！
とにかく やってみようぜ！

627
00:37:20,155 --> 00:37:21,031
ええっ

628
00:37:23,742 --> 00:37:24,743
いくぞ！

629
00:37:24,826 --> 00:37:25,911
うん…

630
00:37:26,411 --> 00:37:27,412
ふっ

631
00:37:28,580 --> 00:37:29,998
そーれ！

632
00:37:30,082 --> 00:37:31,041
はっ！

633
00:37:35,879 --> 00:37:38,048
う～りゃーっ

634
00:37:41,760 --> 00:37:43,011
んん～

635
00:37:57,275 --> 00:37:58,193
(カレーパンマン) だあっ

636
00:38:08,495 --> 00:38:09,955
ハア…

637
00:38:10,247 --> 00:38:12,165
フウ… ヘエ…

638
00:38:12,249 --> 00:38:13,625
やったぜ

639
00:38:14,126 --> 00:38:15,293
わあ…

640
00:38:15,836 --> 00:38:16,962
ほんとだ！

641
00:38:17,921 --> 00:38:19,715
すごいよ カレーパンマン！

642
00:38:20,007 --> 00:38:22,426
ヘヘッ　どうってことないぜ

643
00:38:24,011 --> 00:38:27,305
ねえ　カレーパンマンは
なんで こわくないの？

644
00:38:27,389 --> 00:38:31,309
(カレーパンマン)
ん？ う～ん　なんでかな？

645
00:38:31,601 --> 00:38:33,228
よくわかんないけど

646
00:38:33,854 --> 00:38:36,481
やってみないと
まえに すすまないもんな

647
00:38:36,898 --> 00:38:38,025
あっ

648
00:38:38,108 --> 00:38:40,193
やってみないと まえに…

649
00:38:48,285 --> 00:38:50,328
(カレーパンマン) ふっ えいっ

650
00:39:00,213 --> 00:39:01,298
(ふたり) んっ

651
00:39:01,381 --> 00:39:02,424
あっ

652
00:39:08,096 --> 00:39:09,347
ちょうじょうだ！

653
00:39:09,431 --> 00:39:11,933
たしか へきがだと ここに…

654
00:39:12,017 --> 00:39:13,018
あっ

655
00:39:14,770 --> 00:39:15,896
ここだ

656
00:39:15,979 --> 00:39:16,980
ああ

657
00:39:17,522 --> 00:39:20,484
ふっ んん～ んっ

658
00:39:20,817 --> 00:39:22,486
うう… あっ

659
00:39:23,028 --> 00:39:24,029
(カレーパンマン) あっ

660
00:39:24,696 --> 00:39:26,031
(ブルブル) あった！

661
00:39:27,365 --> 00:39:28,658
やったな ブルブル

662
00:39:28,742 --> 00:39:29,743
うん！

663
00:39:39,294 --> 00:39:41,463
(カレーパンマン) よし！
おれの せなかに のれ！

664
00:39:43,590 --> 00:39:44,758
(ブルブル) ううん

665
00:39:44,966 --> 00:39:46,009
あ？

666
00:39:47,094 --> 00:39:49,137
(ブルブル) ぼく やってみる

667
00:39:49,221 --> 00:39:50,222
ブルブル

668
00:39:50,806 --> 00:39:53,475
やってみないと
まえに すすまないもん！

669
00:39:54,684 --> 00:39:56,103
よくいった！

670
00:40:02,192 --> 00:40:03,401
おもいっきり いくぞ！

671
00:40:03,485 --> 00:40:04,486
(ブルブル) うん

672
00:40:05,028 --> 00:40:06,029
それ！

673
00:40:11,910 --> 00:40:14,663
(カレーパンマン) うりゃ～
(ブルブル) う～ん

674
00:40:18,959 --> 00:40:20,127
(ふたり) んん～っ

675
00:40:26,049 --> 00:40:27,342
やあっ

676
00:40:35,433 --> 00:40:36,434
えっ

677
00:40:38,687 --> 00:40:40,605
うわ～

678
00:40:40,689 --> 00:40:41,690
(ブルブル) お… おちる～
(カレーパンマン) うわっ

679
00:40:42,399 --> 00:40:45,318
(カレーパンマン) うわわわっ
(ブルブル) うわ～

680
00:40:46,611 --> 00:40:48,905
しっかり つかまってろ！

681
00:40:48,989 --> 00:40:50,740
う～ん　やっ

682
00:40:56,538 --> 00:40:57,956
(ふたり) ああっ

683
00:41:11,970 --> 00:41:14,514
ヘエ… たすかった

684
00:41:15,015 --> 00:41:17,642
よくがんばったな ブルブル

685
00:41:18,059 --> 00:41:19,311
(ブルブル) ううん

686
00:41:19,686 --> 00:41:20,770
ああ？

687
00:41:20,854 --> 00:41:24,524
(ブルブル)
ダメだった　ぜんぜんダメだった

688
00:41:25,817 --> 00:41:27,944
な～に いってんだ

689
00:41:28,195 --> 00:41:30,238
なんでも あきらめてた おまえが――

690
00:41:30,322 --> 00:41:32,199
じぶんから やるって いったんだ

691
00:41:32,282 --> 00:41:35,410
おれ すっげえ うれしかったぜ

692
00:41:35,493 --> 00:41:36,578
(ブルブル) ううん

693
00:41:36,661 --> 00:41:37,704
(カレーパンマン) ああ？

694
00:41:37,787 --> 00:41:40,332
(ブルブル)
せっかく カギを みつけたのに

695
00:41:40,749 --> 00:41:42,417
ぼくのせいで…

696
00:41:42,918 --> 00:41:46,379
なーに
また さがしに いけばいいさ

697
00:41:46,463 --> 00:41:50,425
(ブルブル)
でも… だけど… ダメだったもん

698
00:41:52,302 --> 00:41:54,095
やってみたのに――

699
00:41:55,055 --> 00:41:59,059
まえに すすめなかったもん
ううっ うう…

700
00:41:59,142 --> 00:42:00,018
ブルブル

701
00:42:00,101 --> 00:42:01,770
(ブルブル) ううっ…

702
00:42:01,853 --> 00:42:02,896
(カレーパンマン) んん…

703
00:42:05,273 --> 00:42:06,942
たった いっかい
しっぱいした ぐらいで――

704
00:42:07,025 --> 00:42:08,526
へこたれてんじゃねえ

705
00:42:08,610 --> 00:42:09,611
おれだって いままで――

706
00:42:09,694 --> 00:42:10,946
なんかいも
しっぱいしてんだぞ！

707
00:42:11,029 --> 00:42:12,948
むりなんだよー！

708
00:42:13,031 --> 00:42:15,367
ぼくには できないんだよー！

709
00:42:15,450 --> 00:42:16,743
ブルブル

710
00:42:17,577 --> 00:42:18,578
(ブルブル) ううっ うう…

711
00:42:18,912 --> 00:42:19,996
(カレーパンマン) イタッ

712
00:42:20,497 --> 00:42:24,584
イ… イテーッ テッテッテッテ

713
00:42:27,963 --> 00:42:29,256
(ブルブル) むりなんだ

714
00:42:29,631 --> 00:42:32,050
ぼくには
たからさがしなんて――

715
00:42:32,133 --> 00:42:33,510
ぼうけんなんて…

716
00:42:34,344 --> 00:42:35,845
うわっ ううっ

717
00:42:35,929 --> 00:42:37,013
あ…

718
00:42:38,390 --> 00:42:39,557
ええ？

719
00:42:40,058 --> 00:42:41,059
うわああ

720
00:42:44,813 --> 00:42:46,731
うっ うわっ わ～

721
00:42:46,982 --> 00:42:48,233
(へび) シャーッ

722
00:42:48,316 --> 00:42:49,317
(ブルブル) うわあっ

723
00:42:50,860 --> 00:42:51,861
(アンパンマン) んっ

724
00:42:52,237 --> 00:42:53,321
アンパンマン

725
00:42:53,405 --> 00:42:54,781
シャーッ！

726
00:42:55,782 --> 00:42:56,783
えーい！

727
00:42:56,866 --> 00:42:58,118
(へび) うわあっ　お…

728
00:42:58,493 --> 00:43:00,787
(へびの なきごえ)

729
00:43:02,706 --> 00:43:04,457
だいじょうぶかい？ ブルブル

730
00:43:04,708 --> 00:43:05,709
あっ

731
00:43:08,169 --> 00:43:10,005
う… うん

732
00:43:10,964 --> 00:43:11,965
(アンパンマン) ん？

733
00:43:12,841 --> 00:43:16,177
(ばいきんまん) ヒー ハー ヒー ハー

734
00:43:16,261 --> 00:43:20,140
ハアッ ぐうっ　やっと… ついた

735
00:43:20,682 --> 00:43:22,475
(ドキン) カギは どこかしら？

736
00:43:22,559 --> 00:43:25,186
(しょくぱんまん)
へきがだと たしか ここに…

737
00:43:25,770 --> 00:43:28,815
ああーっ ここじゃないかなあ

738
00:43:29,232 --> 00:43:30,233
(ばいきんまん) ふんっ どけっ！
(クリームパンダ) ああっ

739
00:43:30,317 --> 00:43:31,526
(ばいきんまん) う～ん

740
00:43:32,527 --> 00:43:34,946
んっ んん…

741
00:43:35,030 --> 00:43:37,032
あったー！

742
00:43:38,491 --> 00:43:39,492
(ふたり) ああっ！

743
00:43:39,576 --> 00:43:41,077
ばいきんまん！

744
00:43:41,161 --> 00:43:42,162
えっ？

745
00:43:42,620 --> 00:43:45,999
えっ… えっ？ ああ…

746
00:43:46,249 --> 00:43:49,002
てやあっ　あそびは おわりだ！

747
00:43:49,627 --> 00:43:51,838
(クリームパンダ･しょくぱんまん)
うわっ　ゴホッ ゴホッ

748
00:43:55,258 --> 00:43:58,011
(ばいきんまん)
おたからは おれさまが いただいた！

749
00:43:58,094 --> 00:44:00,597
ハヒフヘホ～

750
00:44:01,014 --> 00:44:02,932
(しょくぱんまん)
ゴホッ ゴホッ コホッ

751
00:44:03,183 --> 00:44:05,560
だいじょうぶですか？
クリームパンダちゃん

752
00:44:05,643 --> 00:44:07,395
(クリームパンダ) うっ ううっ

753
00:44:07,479 --> 00:44:10,315
あれ？ いまのが
ばいきんまんってことは…

754
00:44:10,398 --> 00:44:11,232
(しょくぱんまん) ん…

755
00:44:11,316 --> 00:44:12,150
(ふたり) ああっ

756
00:44:12,233 --> 00:44:15,153
(ドキン) ギクッ　あ… はい…

757
00:44:16,237 --> 00:44:19,366
そうか
きみも だまされていたんですね！

758
00:44:19,449 --> 00:44:21,326
そ… そうなんです

759
00:44:21,409 --> 00:44:23,411
さすが しょくぱんまんさま

760
00:44:23,495 --> 00:44:25,705
ドキレーヌ かんげきですわ

761
00:44:25,789 --> 00:44:27,374
(バタコ) しょくぱんまーん！

762
00:44:27,457 --> 00:44:28,708
(３にん) あっ

763
00:44:28,792 --> 00:44:31,002
(メロンパンナ)
クリームパンダちゃーん！

764
00:44:31,544 --> 00:44:33,963
(クリームパンダ･
しょくぱんまん)
ああっ！ アンパンマンごう

765
00:44:34,381 --> 00:44:37,467
(ジャム) かえりが おそいから
みんなで きてみたんだよ

766
00:44:37,550 --> 00:44:39,010
(バタコ) アンパンマンは？

767
00:44:39,094 --> 00:44:41,346
(メロンパンナ)
カレーパンマンとブルブルは？

768
00:44:41,805 --> 00:44:44,015
(クリームパンダ) うん　それがね…

769
00:44:48,186 --> 00:44:49,521
(アンパンマン) ブルブル

770
00:44:49,604 --> 00:44:50,605
(ブルブル) ん？

771
00:44:54,067 --> 00:44:55,693
うっ わああっ

772
00:44:56,277 --> 00:44:59,364
ぼくのかおは
アンパンで できてるんだ

773
00:44:59,447 --> 00:45:01,324
とっても おいしいよ

774
00:45:01,533 --> 00:45:02,534
ああ…

775
00:45:07,580 --> 00:45:08,873
あ～ん

776
00:45:08,957 --> 00:45:11,126
うんうん うんうん

777
00:45:11,209 --> 00:45:13,670
んっ！ おいしい！

778
00:45:13,753 --> 00:45:16,256
フフフッ よかった

779
00:45:22,679 --> 00:45:24,556
(ブルブル) ねえ アンパンマン

780
00:45:24,639 --> 00:45:25,640
(アンパンマン) ん？

781
00:45:25,723 --> 00:45:27,976
(ブルブル)
アンパンマンは こわくないの？

782
00:45:28,476 --> 00:45:29,477
(アンパンマン) えっ？

783
00:45:30,478 --> 00:45:33,815
ぼくだって
こわいと おもうことはあるよ

784
00:45:34,149 --> 00:45:35,233
アンパンマンも？

785
00:45:35,316 --> 00:45:36,317
うん

786
00:45:37,068 --> 00:45:38,778
でも だれかが どこかで――

787
00:45:38,862 --> 00:45:41,030
ぼくの たすけを
まっていると おもうと――

788
00:45:41,114 --> 00:45:43,992
からだが いつのまにか
うごいているんだ

789
00:45:44,492 --> 00:45:46,703
(ブルブル)
カレーパンマンも そうなのかな？

790
00:45:46,786 --> 00:45:47,787
ん？

791
00:45:48,246 --> 00:45:49,330
(ブルブル) んん…

792
00:45:52,083 --> 00:45:53,960
きっと そうだと おもうよ

793
00:45:54,043 --> 00:45:55,170
(カレーパンマン) ブルブルー！

794
00:45:55,253 --> 00:45:56,546
(アンパンマン) あっ
(ブルブル) わっ

795
00:45:57,005 --> 00:45:59,966
(カレーパンマン)
どこだー？ ブルブルー！

796
00:46:00,049 --> 00:46:01,468
(アンパンマン) カレーパンマーン！

797
00:46:01,551 --> 00:46:02,552
(カレーパンマン) おっ？

798
00:46:04,053 --> 00:46:06,848
よお！ アンパンマン
げんきだったか？

799
00:46:06,931 --> 00:46:07,932
あっ？

800
00:46:09,601 --> 00:46:11,144
ブルブル！

801
00:46:11,227 --> 00:46:13,188
エッヘヘヘッ

802
00:46:13,271 --> 00:46:15,273
よかったなあ ぶじで

803
00:46:15,607 --> 00:46:16,608
えっ？

804
00:46:17,108 --> 00:46:18,234
ヘヘッ

805
00:46:18,651 --> 00:46:21,946
さあ いっしょに
カギを さがしにいこうぜ

806
00:46:23,615 --> 00:46:24,782
わあ…

807
00:46:25,450 --> 00:46:26,409
うん！

808
00:46:26,993 --> 00:46:28,203
(アンパンマン) フフフフッ

809
00:46:31,789 --> 00:46:33,458
うーん… ないっ！

810
00:46:34,083 --> 00:46:36,336
ない　ない　ない　ないっ！

811
00:46:36,419 --> 00:46:38,713
カギが な～い！

812
00:46:41,299 --> 00:46:42,300
おっ

813
00:46:44,010 --> 00:46:45,720
そうか

814
00:46:46,221 --> 00:46:48,598
あいつらが さきに

815
00:46:55,605 --> 00:46:56,606
あっ

816
00:46:57,106 --> 00:46:58,358
カレーパンマン

817
00:46:58,441 --> 00:46:59,442
(カレーパンマン) ん？

818
00:47:00,109 --> 00:47:02,487
たいようが キラキラしてるね

819
00:47:04,906 --> 00:47:07,867
(カレーパンマン)
ああ　さいこうだぜ！

820
00:47:10,161 --> 00:47:11,162
あーらよって！

821
00:47:11,246 --> 00:47:12,747
(ブルブル) うわあっ　アハハッ

822
00:47:12,830 --> 00:47:13,831
(カレーパンマン) ヘヘヘッ

823
00:47:16,167 --> 00:47:19,420
(ブルブル) フフフッ フフフッ

824
00:47:20,171 --> 00:47:21,506
(アンパンマン) フフフフッ

825
00:47:25,843 --> 00:47:26,844
うわっ

826
00:47:27,095 --> 00:47:28,096
(ブルブル･カレーパンマン) うわっ

827
00:47:28,346 --> 00:47:29,681
(ブルブル) あっ ううっ…

828
00:47:30,807 --> 00:47:31,891
(カレーパンマン･アンパンマン)
ばいきんまん！

829
00:47:31,975 --> 00:47:34,185
(ブルブル) ばい… きんまん？

830
00:47:34,269 --> 00:47:35,645
(ばいきんまん) カギを よこせ！

831
00:47:35,728 --> 00:47:36,729
(カレーパンマン) カギ？

832
00:47:36,813 --> 00:47:38,231
(ばいきんまん) これだよ！

833
00:47:38,523 --> 00:47:39,357
(カレーパンマン･アンパンマン)
ああっ！

834
00:47:39,440 --> 00:47:40,316
(カレーパンマン) それは！

835
00:47:40,400 --> 00:47:42,902
(ばいきんまん)
もうひとつの カギを もってるだろう！

836
00:47:43,111 --> 00:47:44,112
(ブルブル) ないよ

837
00:47:44,195 --> 00:47:45,488
(ばいきんまん) んっ？

838
00:47:45,572 --> 00:47:49,826
そのカギは ぼくが
なくしちゃったから ないよ

839
00:47:49,909 --> 00:47:50,994
なんだとー！

840
00:47:51,869 --> 00:47:54,455
(アンパンマン) うっ　ううっ ああ…

841
00:47:55,582 --> 00:47:58,501
うわあ～　うわ～

842
00:47:58,793 --> 00:47:59,961
アンパンマン！

843
00:48:00,044 --> 00:48:01,045
うわ… ああっ

844
00:48:01,129 --> 00:48:02,171
(ばいきんまん) やい ブルブル！

845
00:48:02,255 --> 00:48:04,007
カレーパンマンを たすけたいなら

846
00:48:04,090 --> 00:48:06,342
おまえが
カギを さがして もってこい！

847
00:48:06,426 --> 00:48:09,554
(ブルブル) ええーっ
ぼ… ぼくには むりだよ

848
00:48:09,637 --> 00:48:11,097
(ばいきんまん) これでもか？

849
00:48:11,180 --> 00:48:12,640
(カレーパンマン) ああ… ぐっ

850
00:48:12,724 --> 00:48:14,392
ああ～

851
00:48:14,851 --> 00:48:17,228
ブルブル おれは だいじょうぶ

852
00:48:17,312 --> 00:48:18,771
(ばいきんまん) さあ いけ！

853
00:48:18,855 --> 00:48:22,150
ただし たいようが しずむまでだ

854
00:48:22,233 --> 00:48:25,153
それまでに
あの とびらのところまで こい！

855
00:48:25,403 --> 00:48:26,696
そんな～

856
00:48:26,779 --> 00:48:29,198
(ばいきんまん)
つべこべいわずに さっさと いけ！

857
00:48:29,282 --> 00:48:31,451
あっ わあ～　うわ～

858
00:48:31,534 --> 00:48:33,953
うわ～ うわ～

859
00:48:45,298 --> 00:48:46,299
(いいかげんにしろ) ん？

860
00:48:48,843 --> 00:48:51,804
(ばいきんまん)
さっきは よくも やってくれたな

861
00:48:58,478 --> 00:48:59,479
ない

862
00:49:00,605 --> 00:49:01,606
ない

863
00:49:01,689 --> 00:49:04,817
たしか このへんに
おちたと おもったんだけど

864
00:49:07,820 --> 00:49:09,906
うわあ… あああ～

865
00:49:09,989 --> 00:49:11,699
(おちた おと)

866
00:49:12,116 --> 00:49:13,368
あう… ぐう

867
00:49:13,576 --> 00:49:15,578
んん… ん？

868
00:49:17,830 --> 00:49:22,460
んん… んん… んっ

869
00:49:22,543 --> 00:49:23,544
ううっ

870
00:49:24,671 --> 00:49:25,672
うっ

871
00:49:27,006 --> 00:49:29,425
んっ んんん～

872
00:49:33,012 --> 00:49:35,848
(チーズ) くん くん くん
アン アン アーン！

873
00:49:36,641 --> 00:49:40,103
(メロンパンナ) おしろのほうから
ばいきんまんの においがするって

874
00:49:40,186 --> 00:49:41,562
(ジャム) りょうかい！

875
00:49:47,860 --> 00:49:51,823
んんん… ア～ンパーンチ！

876
00:50:02,959 --> 00:50:04,335
ブルブル

877
00:50:04,877 --> 00:50:08,965
(ばいきんまん) んん～！
おそい おそい おそ～い！

878
00:50:09,048 --> 00:50:10,758
だったら おまえが いけ！

879
00:50:10,842 --> 00:50:11,884
うるさ～い！

880
00:50:11,968 --> 00:50:15,513
おれさまは なるべく らくして
おたからを てにいれるんだ！

881
00:50:15,596 --> 00:50:16,764
(チーズ) アン ア～ン！

882
00:50:16,848 --> 00:50:17,849
(ふたり) あっ

883
00:50:17,932 --> 00:50:19,600
アンパンマンごう！

884
00:50:20,143 --> 00:50:22,520
(しょくぱんまん)
カレーパンマンを はなしなさーい！

885
00:50:22,603 --> 00:50:23,813
フフフン

886
00:50:23,896 --> 00:50:25,523
うっ ぐああ…

887
00:50:26,733 --> 00:50:28,401
(ばいきんまん)
それ いじょう ちかよるな

888
00:50:30,278 --> 00:50:31,279
(チーズ･バタコ) ああ…

889
00:50:36,576 --> 00:50:38,202
(ばいきんまん) どわあ～

890
00:50:41,372 --> 00:50:42,498
(カレーパンマンたち) アンパンマン！

891
00:50:42,749 --> 00:50:44,667
(ばいきんまん) やったな～！

892
00:51:06,647 --> 00:51:08,691
さいきょうのバイコング

893
00:51:09,984 --> 00:51:12,320
バイキングコングだー！

894
00:51:12,403 --> 00:51:14,864
(バイキングコング) うお～！

895
00:51:17,450 --> 00:51:23,623
(ブルブル) ハア… ハア… ハア…

896
00:51:24,540 --> 00:51:26,542
あっ たいへんだ

897
00:51:26,834 --> 00:51:27,835
フウッ

898
00:51:29,003 --> 00:51:30,505
いそがないと

899
00:51:30,797 --> 00:51:32,715
いそがないと！ ハア…

900
00:51:36,761 --> 00:51:41,557
ハア… フウ… フウ…

901
00:51:41,641 --> 00:51:44,602
ハア… フウ… ハア…

902
00:51:44,685 --> 00:51:45,770
あっ

903
00:51:50,942 --> 00:51:52,401
ううう…

904
00:51:52,777 --> 00:51:55,613
<ダメだ　まに あわない>

905
00:51:55,822 --> 00:51:57,406
<むりなんだ>

906
00:51:58,533 --> 00:52:01,828
<やっぱり ぼくには むりなんだ>

907
00:52:03,079 --> 00:52:04,080
(カレーパンマン) だいじょうぶだ！

908
00:52:04,330 --> 00:52:05,456
(ブルブル) ハッ

909
00:52:05,748 --> 00:52:07,667
(カレーパンマン)
なんでも あきらめてた おまえが――

910
00:52:07,750 --> 00:52:09,710
じぶんから やるって いったんだ

911
00:52:10,127 --> 00:52:13,297
おれ すっげえ うれしかったぜ

912
00:52:14,715 --> 00:52:16,592
(ブルブル) んっ… ううっ

913
00:52:19,262 --> 00:52:20,346
んっ…

914
00:52:20,930 --> 00:52:23,975
フウ フウ フウ…

915
00:52:24,058 --> 00:52:25,685
フウ… フウ…

916
00:52:26,269 --> 00:52:27,687
(カレーパンマン) あきらめるな！

917
00:52:28,271 --> 00:52:30,064
あたって くだけろだ！

918
00:52:30,773 --> 00:52:33,568
やってみないと
まえに すすまないもんな

919
00:52:34,819 --> 00:52:38,197
おれ たいようをみてると
なんか こころのおくが――

920
00:52:38,281 --> 00:52:40,658
カーッと あつくなってくるんだ

921
00:52:41,909 --> 00:52:45,121
(ブルブル) ハア… ハア… フウ…

922
00:52:50,209 --> 00:52:52,628
しょーくパーンチ！

923
00:52:53,713 --> 00:52:56,674
メロンパンナの メロメロパーンチ！

924
00:52:56,757 --> 00:53:00,094
グー･チョキ･パーンチのグー！

925
00:53:01,554 --> 00:53:03,431
(アンパンマン) アーンキーック！

926
00:53:03,764 --> 00:53:05,975
(カレーパンマン) カレーパーンチ！

927
00:53:07,059 --> 00:53:08,978
(ばいきんまん) フンッ
そんなこうげきが――

928
00:53:09,061 --> 00:53:12,940
このバイキングコングに
きくもんかー！

929
00:53:14,442 --> 00:53:17,403
(３にん) うわ～

930
00:53:17,486 --> 00:53:18,571
(ドキン) ああっ

931
00:53:19,196 --> 00:53:20,948
しょくぱんまんさま～

932
00:53:21,032 --> 00:53:22,867
(ばいきんまん) くらえ～！

933
00:53:23,451 --> 00:53:24,285
(しょくぱんまん) あああ…

934
00:53:24,368 --> 00:53:25,244
(アンパンマンたち) うっ

935
00:53:25,328 --> 00:53:26,454
(アンパンマン) いまのうちに！

936
00:53:26,537 --> 00:53:27,747
(メロンパンナ･クリームパンダ) うん！

937
00:53:28,289 --> 00:53:30,207
(ばいきんまん) にがすもんか！

938
00:53:30,958 --> 00:53:32,209
(ふたり) うわ～

939
00:53:33,169 --> 00:53:35,504
ヤダ～

940
00:53:36,631 --> 00:53:38,299
(ばいきんまん) おまえたちも！

941
00:53:38,382 --> 00:53:40,259
(アンパンマンたち) うわ～

942
00:53:41,010 --> 00:53:43,471
(アンパンマン･しょくぱんまん)
ううっ うわ～　ああ…

943
00:53:44,013 --> 00:53:45,056
(アンパンマン) ああ～
(しょくぱんまん) ううっ

944
00:53:45,139 --> 00:53:45,973
(カレーパンマン) ああっ！

945
00:53:46,223 --> 00:53:48,768
(ジャム) いかん！
いそいで あたらしい かおを！

946
00:53:48,851 --> 00:53:49,936
(バタコ) はい！
(チーズ) アンアン！

947
00:53:50,561 --> 00:53:52,647
(ばいきんまん) そうは いくか！

948
00:53:53,689 --> 00:53:55,274
(ジャムたち) うわ～

949
00:53:58,027 --> 00:53:59,737
うわ～

950
00:54:00,279 --> 00:54:03,991
キャ～
しょくぱんまんさまと いっしょ～

951
00:54:04,075 --> 00:54:06,285
みんな… ハア… ハア… あ？

952
00:54:06,369 --> 00:54:07,495
うわあっ

953
00:54:09,121 --> 00:54:10,373
(アンパンマン) カレーパンマン！

954
00:54:10,790 --> 00:54:12,917
(ばいきんまん) そ～れ

955
00:54:13,000 --> 00:54:15,628
(カレーパンマン)
ぬぬぬ… ぐう…

956
00:54:15,711 --> 00:54:16,671
ああっ

957
00:54:17,338 --> 00:54:19,131
うおおーっ！

958
00:54:19,215 --> 00:54:20,383
(カレーパンマン) あっ！

959
00:54:20,466 --> 00:54:25,054
(ブルブル) おおーっ！

960
00:54:26,597 --> 00:54:28,015
(クリームパンダ) これって…

961
00:54:28,391 --> 00:54:30,184
(ブルブル) ここだー！
(ばいきんまん) んんっ？

962
00:54:37,483 --> 00:54:39,735
♪～

963
00:54:39,986 --> 00:54:41,278
ブルブル！

964
00:54:41,779 --> 00:54:44,240
(ばいきんまん) やい！
カギは もってきたのか？

965
00:54:44,448 --> 00:54:45,449
(ブルブル) あるぞ！

966
00:54:45,658 --> 00:54:47,702
ほしいなら とりにこい！

967
00:54:48,452 --> 00:54:49,453
(ばいきんまん) なに～

968
00:54:49,537 --> 00:54:50,705
(カレーパンマン)
だあーっ

969
00:54:52,498 --> 00:54:53,499
ブルブルー！

970
00:54:53,749 --> 00:54:54,792
(アンパンマン) ぼくたちも いこう！

971
00:54:54,875 --> 00:54:55,876
(しょくぱんまんたち) はい！

972
00:54:55,960 --> 00:54:56,961
(ドキン) ええーっ

973
00:54:57,336 --> 00:54:59,630
(ジャム)
いまのうちに あたらしい かおを！

974
00:54:59,714 --> 00:55:00,798
(チーズ) アン！
(バタコ) はい！

975
00:55:04,301 --> 00:55:07,263
(ジャム)
んんっ　うーん うーん

976
00:55:08,264 --> 00:55:09,849
(ばいきんまん) まてーっ！

977
00:55:14,228 --> 00:55:15,396
カレーパンマン！

978
00:55:15,646 --> 00:55:16,897
ほーい

979
00:55:17,106 --> 00:55:18,899
(アンパンマン) んっ　はっ！

980
00:55:18,983 --> 00:55:20,901
(しょくぱんまん)
んっ んんっ　えーいっ！

981
00:55:21,569 --> 00:55:22,570
えいっ！

982
00:55:22,903 --> 00:55:23,904
(クリームパンダ) はいっ！

983
00:55:24,363 --> 00:55:27,366
(ばいきんまん) えーい
ちょこまか ちょこまかと！

984
00:55:29,410 --> 00:55:30,411
ええっ

985
00:55:30,911 --> 00:55:32,371
うう… うわあ～

986
00:55:33,497 --> 00:55:34,457
(カレーパンマン) いくぜ！

987
00:55:34,540 --> 00:55:35,499
(ブルブル) うん！

988
00:55:39,420 --> 00:55:42,298
んっ　コラッ！ おりろー！

989
00:55:43,049 --> 00:55:44,091
なにをー！

990
00:55:44,175 --> 00:55:45,176
(カレーパンマン) はいっ

991
00:55:45,259 --> 00:55:46,343
(ばいきんまん) んんっ？

992
00:55:48,888 --> 00:55:51,140
んっ… このー！

993
00:55:56,353 --> 00:55:58,647
わあ～！

994
00:55:58,731 --> 00:56:01,817
くらえっ！ げきからカレーだ！

995
00:56:02,610 --> 00:56:03,694
(ばいきんまん) うが～っ

996
00:56:06,405 --> 00:56:10,534
うう… からい からい からい
から～い！

997
00:56:10,785 --> 00:56:12,787
(カレーパンマン) やっとだな
(ブルブル) うん！

998
00:56:13,579 --> 00:56:14,872
(アンパンマン) いまのうちに

999
00:56:25,299 --> 00:56:26,675
できた！

1000
00:56:26,759 --> 00:56:29,178
(バタコ) アンパンマン！
あたらしい かおよ！

1001
00:56:29,261 --> 00:56:30,387
そーれ！

1002
00:56:37,019 --> 00:56:38,437
げんき100ばい！

1003
00:56:39,438 --> 00:56:40,856
アンパンマン！

1004
00:56:42,191 --> 00:56:45,611
ふんっ！
バイキングコングは むてきだ！

1005
00:56:51,575 --> 00:56:52,701
(アンパンマン) えーいっ

1006
00:56:53,285 --> 00:56:54,286
ふっ！

1007
00:56:58,082 --> 00:56:59,083
たあっ！

1008
00:57:02,545 --> 00:57:04,296
(ばいきんまん) おおっ　なんだ？

1009
00:57:04,755 --> 00:57:07,967
(ブルブルたち) う～ん　う～ん

1010
00:57:08,050 --> 00:57:10,886
(しろたち) う～ん… カベッ！

1011
00:57:11,220 --> 00:57:13,848
(ばいきんまん) うわあーっ

1012
00:57:16,100 --> 00:57:17,893
いまだよ！ アンパンマン！

1013
00:57:18,644 --> 00:57:19,645
(アンパンマン) うん！

1014
00:57:21,897 --> 00:57:24,692
アーンパーンチ！

1015
00:57:24,775 --> 00:57:26,485
～♪

1016
00:57:35,369 --> 00:57:37,997
(ばいきんまん) うわ～！

1017
00:57:40,833 --> 00:57:42,877
はいら～

1018
00:57:42,960 --> 00:57:46,046
ばいばいきーん

1019
00:57:48,048 --> 00:57:49,925
(３にん) あっ… おお～

1020
00:57:50,217 --> 00:57:51,218
(しょくぱんまん) わあ
(クリームパンダ) アハハッ

1021
00:57:51,760 --> 00:57:53,554
(バタコ) うわあ
(ジャム) んん～

1022
00:57:53,637 --> 00:57:54,805
(ジャム) うわっ
(バタコ) ハハッ アハッ

1023
00:57:57,933 --> 00:58:00,978
(ドキン)
しょくぱんまんさま～ これを！

1024
00:58:01,061 --> 00:58:02,813
(しょくぱんまん)
ありがとう ドキンちゃん

1025
00:58:02,897 --> 00:58:04,023
ええっ？

1026
00:58:04,481 --> 00:58:06,859
あ… えっ あっ あっ…

1027
00:58:06,942 --> 00:58:08,569
いや～ん

1028
00:58:08,652 --> 00:58:11,238
ドキンは しょくぱんまんさまと
ごいっしょできて――

1029
00:58:11,322 --> 00:58:13,949
しあわせでした～

1030
00:58:17,828 --> 00:58:19,788
(カレーパンマン)
よくがんばったな ブルブル

1031
00:58:19,872 --> 00:58:21,081
カッコよかったぜ！

1032
00:58:22,208 --> 00:58:23,167
うん！

1033
00:58:23,751 --> 00:58:25,002
エヘヘッ

1034
00:58:31,508 --> 00:58:33,469
(いいかげんにしろ) すきにしろー

1035
00:58:34,011 --> 00:58:35,137
(アンパンマンたち) はい
(ブルブル) うん！

1036
00:58:35,346 --> 00:58:36,388
(ブルブル) カレーパンマン

1037
00:58:36,472 --> 00:58:37,473
(カレーパンマン) ああ

1038
00:58:39,475 --> 00:58:40,476
んっ

1039
00:58:42,519 --> 00:58:43,520
んっ

1040
00:59:12,508 --> 00:59:14,385
(ブルブル) たからばこだ！

1041
00:59:17,930 --> 00:59:21,767
ふっ　ふんっ… んんっ

1042
00:59:22,559 --> 00:59:23,769
(アンパンマンたち) うわあっ

1043
00:59:27,690 --> 00:59:29,400
ぼうし …と

1044
00:59:31,110 --> 00:59:32,820
(ブルブル) たからのちず

1045
00:59:32,903 --> 00:59:34,029
(カレーパンマン) ええっ

1046
00:59:34,113 --> 00:59:35,823
また ちずかよ

1047
00:59:36,031 --> 00:59:37,950
いいかげんにしろー！

1048
00:59:38,200 --> 00:59:39,326
(ブルブル) ううん

1049
00:59:39,910 --> 00:59:41,453
これで よかったんだ

1050
00:59:41,537 --> 00:59:42,538
(カレーパンマン) あ？

1051
00:59:43,122 --> 00:59:45,916
ブルブルの
ほんとうの たからさがしは――

1052
00:59:46,000 --> 00:59:47,918
ここから はじまるんだよ

1053
00:59:48,002 --> 00:59:49,420
そうですね

1054
00:59:49,503 --> 00:59:51,297
(しょくぱんまん) フフフッ
(クリームパンダ) キャハハ アハハッ

1055
00:59:51,547 --> 00:59:53,173
(バタコたち) ウフフフ

1056
00:59:54,842 --> 00:59:56,218
エッヘヘヘ

1057
00:59:57,386 --> 00:59:58,721
(カレーパンマン) ほれっ
(ブルブル) うわっ

1058
00:59:59,638 --> 01:00:01,807
(カレーパンマン)
にあってるぜ ブルブル

1059
01:00:02,182 --> 01:00:04,059
(ブルブル)
ありがとう カレーパンマン！

1060
01:00:04,143 --> 01:00:05,144
(カレーパンマン) うん！

1061
01:00:08,439 --> 01:00:09,440
(ブルブル) よーし！

1062
01:00:09,773 --> 01:00:13,193
つぎの たからさがしに しゅっぱつだ！

1063
01:00:15,654 --> 01:00:22,661
♪～

1064
01:01:28,352 --> 01:01:35,359
～♪

