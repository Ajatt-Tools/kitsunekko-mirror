1
00:00:25,693 --> 00:00:27,236
(フクロウの なきごえ)

2
00:00:38,205 --> 00:00:40,833
(こどもたち) うわあ

3
00:00:42,793 --> 00:00:43,961
(メロンパンナ) きれい

4
00:00:44,044 --> 00:00:45,713
(ちびぞう) あまのがわ だぞう

5
00:00:45,796 --> 00:00:48,716
(みみせんせい) みなさん
あれは なんていう せいざでしょう？

6
00:00:49,008 --> 00:00:51,177
(こどもたち) はくちょうざで～す！

7
00:00:51,260 --> 00:00:53,095
(みみ) そうですね！

8
00:00:53,471 --> 00:00:55,222
では あちらは？

9
00:00:55,306 --> 00:00:57,266
(こどもたち) ことざで～す！

10
00:01:01,812 --> 00:01:04,064
(メロンパンナ)
むこうが こぐまざで――

11
00:01:04,148 --> 00:01:05,232
こっちは…

12
00:01:05,858 --> 00:01:06,859
ワシざ

13
00:01:07,276 --> 00:01:11,238
それから あれは… うーん…

14
00:01:11,322 --> 00:01:12,531
えっと…

15
00:01:12,865 --> 00:01:14,450
(カバお) ギョーザ それと ピザ

16
00:01:14,533 --> 00:01:15,785
(こどもたち) えーっ

17
00:01:15,868 --> 00:01:16,869
(カバお) だって ほら

18
00:01:16,952 --> 00:01:19,497
あれと これを つないで…

19
00:01:19,580 --> 00:01:21,373
ねっ おいしそうでしょ！

20
00:01:21,457 --> 00:01:24,502
(ウサこ) ちがうわ
あれは サソリざ でしょう

21
00:01:25,085 --> 00:01:27,588
(ピョンきち) まったく
カバおは くいしんぼうだな

22
00:01:27,671 --> 00:01:29,507
(カバお)
アハッ ハハハッ ごもっとも

23
00:01:29,590 --> 00:01:30,633
(ちびぞう) あっ

24
00:01:30,883 --> 00:01:32,384
ながれぼしだぞう

25
00:01:32,468 --> 00:01:33,511
(こどもたち) うわあ

26
00:01:33,594 --> 00:01:35,095
(クリームパンダ)
きれいだな～

27
00:01:35,179 --> 00:01:37,807
(みみ) ながれぼしは
おほしさまや わたしたちを――

28
00:01:37,890 --> 00:01:39,892
みまもってくれてるんですよ

29
00:01:40,226 --> 00:01:41,852
(こどもたち) へえ～

30
00:01:42,102 --> 00:01:43,938
あっ あっ…

31
00:01:44,647 --> 00:01:45,606
(メロンパンナ) なに？

32
00:01:45,689 --> 00:01:47,399
(おおきな ものおと)
(みんな) うわ～っ

33
00:01:49,443 --> 00:01:51,403
(きが たおれるおと)

34
00:01:54,323 --> 00:01:56,659
(こどもたち) わあ～っ

35
00:01:56,992 --> 00:01:59,161
(みんな) うわっ キャーッ！

36
00:02:02,915 --> 00:02:05,668
(ばいきんまん) ハヒフヘホ～

37
00:02:06,126 --> 00:02:07,253
(メロンパンナ) そのこえは…

38
00:02:07,336 --> 00:02:08,170
(クリームパンダ) ばいきんまん！

39
00:02:08,546 --> 00:02:10,631
(ばいきんまん) おれさま
きれいな おほしさまなんて――

40
00:02:10,714 --> 00:02:12,174
だ～いっきらい！

41
00:02:12,258 --> 00:02:15,636
まっくらやみを
たのしいよるに してやるぞ！

42
00:02:15,719 --> 00:02:17,429
(みみ) みなさん にげるのよ！

43
00:02:19,014 --> 00:02:21,934
(こどもたち) わー！

44
00:02:22,017 --> 00:02:23,435
(じめんがゆれる おと)

45
00:02:23,894 --> 00:02:25,521
(みんなの さけぶこえ)

46
00:02:25,604 --> 00:02:27,022
(メロンパンナたち) うわあ

47
00:02:27,106 --> 00:02:28,899
(カバお) くうっ フウ
(メロンパンナ) フウ

48
00:02:29,233 --> 00:02:30,401
(カバお)わあーっ

49
00:02:32,152 --> 00:02:34,029
(ばいきんまん) ハヒフヘホ～

50
00:02:34,113 --> 00:02:36,031
(みみたち) うわあ～

51
00:02:37,658 --> 00:02:38,993
(クリームパンダ) たすけて～

52
00:02:39,076 --> 00:02:40,077
(こどもたち) アンパンマン！

53
00:02:40,160 --> 00:02:47,167
♪～

54
00:02:52,548 --> 00:02:53,465
なにっ！

55
00:03:43,182 --> 00:03:49,188
～♪

56
00:04:16,507 --> 00:04:18,550
(キララ)
いいぞ いいぞ ながれぼしさん

57
00:04:18,634 --> 00:04:22,471
キラキラと げんきよくとんで
よぞらを あかるくしてね！

58
00:04:25,599 --> 00:04:26,684
それ！

59
00:04:33,232 --> 00:04:35,109
うわあ

60
00:04:35,567 --> 00:04:37,027
(キラリ) いけないわ　キララ！

61
00:04:37,111 --> 00:04:38,028
(キララ) んん？

62
00:04:40,739 --> 00:04:43,075
(キラリ) ながれぼしで
おほしさまが かくれて――

63
00:04:43,158 --> 00:04:45,035
みえなくなってしまうじゃない

64
00:04:45,327 --> 00:04:49,123
キラリ！
いいでしょ きれいなんだから

65
00:04:49,206 --> 00:04:50,082
あっ

66
00:04:50,833 --> 00:04:53,669
おほしさまを ひからせるのは
キラリのやくめ

67
00:04:53,752 --> 00:04:56,964
あたしは ながれぼしを
いっぱい いっぱい いーっぱい――

68
00:04:57,047 --> 00:04:58,590
とばしたいってわけ

69
00:04:58,674 --> 00:05:00,175
それ！

70
00:05:06,932 --> 00:05:08,517
おねがい おほしさま

71
00:05:08,600 --> 00:05:12,187
キラリ キラリと
あたたかく やさしく またたいて

72
00:05:26,326 --> 00:05:28,912
(キララ) もう じゃましないでよ キラリ
(キラリ) あっ

73
00:05:28,996 --> 00:05:31,582
キララ！
じゃまなんか してないわ

74
00:05:31,665 --> 00:05:35,044
してます してます してまーす！

75
00:05:35,252 --> 00:05:38,338
(キラリ) ながれぼしと おほしさまが
なかよく かがやいていないと――

76
00:05:38,422 --> 00:05:40,841
デビルスターが とびだしてしまうのよ

77
00:05:40,924 --> 00:05:43,927
あっちこっち まっくらになって
たいへんなことになって…

78
00:05:44,011 --> 00:05:45,137
それで それで…

79
00:05:45,429 --> 00:05:48,557
(キララ) あら デビルスターなんて
どこにも みえないじゃない

80
00:05:48,640 --> 00:05:49,641
へいき へいき

81
00:05:49,725 --> 00:05:52,519
(キラリ) たしかに そうだけど でも…

82
00:05:52,603 --> 00:05:55,397
あたし デビルスターなんて
しんじないわ

83
00:05:55,481 --> 00:05:57,483
だから
よぞらを あかるくする

84
00:05:57,566 --> 00:06:00,444
もっと もっと
ながれぼしを とばすのよ！

85
00:06:00,527 --> 00:06:01,445
あっ

86
00:06:07,951 --> 00:06:09,161
アハッ

87
00:06:09,703 --> 00:06:11,080
(キラリ) まって キララ！

88
00:06:11,163 --> 00:06:12,081
あっ

89
00:06:12,414 --> 00:06:13,957
(キララ) どいてよ キラリ！
(キラリ) あっ ああっ

90
00:06:18,337 --> 00:06:19,671
キャーッ！

91
00:06:19,755 --> 00:06:21,173
うわーっ！

92
00:06:24,885 --> 00:06:26,887
な… なんなの？ あっ

93
00:06:27,179 --> 00:06:28,180
ああっ

94
00:06:28,555 --> 00:06:29,389
キャーッ！

95
00:06:29,473 --> 00:06:30,641
(キラリ) キララ！

96
00:06:30,724 --> 00:06:32,643
(キララ) キャーッ！

97
00:06:33,143 --> 00:06:35,229
キラリー！

98
00:06:36,396 --> 00:06:40,317
(かみなりの おと)

99
00:06:44,196 --> 00:06:47,491
(ドクター･ヒヤリ)
ヒャー ヒャッヒャッヒャッ

100
00:06:51,453 --> 00:06:53,580
(かみなりの おと)

101
00:07:00,504 --> 00:07:03,590
(ヒヤリ)
ヒャー ヒャッヒャッヒャッ ヒャー

102
00:07:04,091 --> 00:07:06,009
いよいよ かんせいするぞ

103
00:07:06,093 --> 00:07:09,638
ながねんにわたって
けんきゅうしてきた だいはつめいが

104
00:07:10,055 --> 00:07:12,975
(かみなりの おと)

105
00:07:21,567 --> 00:07:24,486
キャー ハハハハッ

106
00:07:36,623 --> 00:07:37,875
(おおきな おと)
ん？

107
00:07:39,877 --> 00:07:41,336
ヒヤーッ！

108
00:07:47,301 --> 00:07:48,927
うぎゃあ よいしょ

109
00:07:49,011 --> 00:07:50,512
な… なんじゃ？

110
00:07:54,766 --> 00:07:56,059
よっこいしょのしょい

111
00:07:57,019 --> 00:07:58,854
よかった
うまく できあがってるぞ

112
00:07:58,937 --> 00:08:01,231
(たおれる おと)
(ヒヤリ) うおーっ

113
00:08:01,648 --> 00:08:02,566
だあっ

114
00:08:20,375 --> 00:08:22,419
(カモメの なきごえ)

115
00:08:24,004 --> 00:08:25,380
(アンパンマン) ウフフッ

116
00:08:26,882 --> 00:08:29,009
きもちいい あさだな

117
00:08:30,469 --> 00:08:32,179
ん？ なんだろう？

118
00:08:43,565 --> 00:08:46,068
たしか このあたりだったけど…

119
00:08:46,151 --> 00:08:47,110
あっ！

120
00:08:51,156 --> 00:08:51,990
ん？

121
00:08:52,074 --> 00:08:53,533
(ものおと)
(キララ) んん…

122
00:08:54,284 --> 00:08:55,202
あっ

123
00:08:55,577 --> 00:08:56,578
(キララ) ん…

124
00:08:57,037 --> 00:08:58,538
んん…

125
00:09:02,334 --> 00:09:03,710
だいじょうぶかい？

126
00:09:04,127 --> 00:09:05,504
あ… あっ！

127
00:09:05,837 --> 00:09:07,881
あっ あたしの ほしのつえ！

128
00:09:08,590 --> 00:09:09,841
ダメ ダメ！

129
00:09:09,925 --> 00:09:11,802
これは あたしのものよ！

130
00:09:11,885 --> 00:09:13,720
ぜったいに わたさないわ！

131
00:09:14,096 --> 00:09:15,681
いや ぼくは…

132
00:09:15,764 --> 00:09:17,849
ながれぼしさんは
あたしが とばすの

133
00:09:17,933 --> 00:09:20,310
とばせるのは あたしだけってわけ！

134
00:09:20,394 --> 00:09:21,728
ながれぼしさん？

135
00:09:22,145 --> 00:09:23,313
そうよ

136
00:09:23,397 --> 00:09:26,900
あたしは この ひろーい よぞらを
キラキラ～っと

137
00:09:26,984 --> 00:09:28,568
あっ　ああ～

138
00:09:28,652 --> 00:09:30,153
ない ない ない ない！

139
00:09:30,237 --> 00:09:31,989
おほしさまが なーい！

140
00:09:32,072 --> 00:09:33,115
あっ

141
00:09:33,198 --> 00:09:34,741
もう あさだからね

142
00:09:34,825 --> 00:09:35,826
(キララ) あさ？

143
00:09:35,909 --> 00:09:38,078
(アンパンマン)
おひさまが のぼって
あさになると――

144
00:09:38,161 --> 00:09:40,455
おほしさまは
かくれてしまうんだよ

145
00:09:40,539 --> 00:09:41,540
(キララ)
なによ なによ！

146
00:09:41,623 --> 00:09:43,250
ながれぼしが
とばせないじゃない

147
00:09:43,625 --> 00:09:45,252
おひさまって いじわるね

148
00:09:45,335 --> 00:09:47,129
(アンパンマン) そんなことないよ
(キララ) え？

149
00:09:47,212 --> 00:09:49,298
おひさまがしずんで よるになれば――

150
00:09:49,381 --> 00:09:51,633
おほしさまは また かがやくんだから

151
00:09:51,717 --> 00:09:53,343
(キララ) ほんと？
(アンパンマン) うん

152
00:09:53,427 --> 00:09:55,554
そうか やったー！

153
00:09:55,637 --> 00:09:57,139
(おなかがなる おと)
(キララ) あ…

154
00:09:58,307 --> 00:09:59,766
あう～

155
00:10:00,350 --> 00:10:02,436
おなかが すいているんだね

156
00:10:03,061 --> 00:10:05,022
だったら これをたべて

157
00:10:05,105 --> 00:10:07,190
え？ ハア…

158
00:10:07,274 --> 00:10:08,608
(アンパンマン) さあ どうぞ

159
00:10:08,692 --> 00:10:09,776
ん？

160
00:10:11,403 --> 00:10:12,571
ふ～ん

161
00:10:12,946 --> 00:10:13,989
うん

162
00:10:15,240 --> 00:10:16,158
はむっ

163
00:10:16,742 --> 00:10:19,286
わあ おいしい！

164
00:10:19,369 --> 00:10:21,580
はむっ はむっ　うん

165
00:10:22,080 --> 00:10:24,833
ぼく アンパンマン　よろしくね

166
00:10:25,208 --> 00:10:26,710
はむっ むぐ むぐ

167
00:10:28,920 --> 00:10:31,590
おっ うわあ

168
00:10:33,508 --> 00:10:34,926
あたし キララ

169
00:10:35,677 --> 00:10:37,179
ほしの ようせいよ

170
00:10:38,263 --> 00:10:39,806
(ジャムおじさん)
あたらしい かおだよ

171
00:10:42,142 --> 00:10:43,935
ありがとう ジャムおじさん

172
00:10:44,019 --> 00:10:45,520
これで げんき100ばいです

173
00:10:48,106 --> 00:10:49,149
(バタコさん) どうぞ

174
00:10:49,232 --> 00:10:50,359
(チーズ) アン アアン

175
00:10:50,442 --> 00:10:53,445
おいしそう　いただきまーす

176
00:10:53,737 --> 00:10:55,155
あむっ　はむ はむ はむ

177
00:10:57,324 --> 00:10:58,617
(クリームパンダ) うわあ

178
00:11:00,202 --> 00:11:02,287
(クリームパンダ)
ほしのようせいが いたなんて…

179
00:11:02,704 --> 00:11:05,582
(しょくぱんまん) かわいい
ようせいが ほしぞらをまい――

180
00:11:05,665 --> 00:11:08,168
ながれぼしを みつめる
こどもたちの ひとみが――

181
00:11:08,251 --> 00:11:09,795
キラキラと かがやく

182
00:11:10,212 --> 00:11:12,839
おお なんと
ロマンチックなんでしょう

183
00:11:12,923 --> 00:11:14,091
(カレーパンマン) やめてくれ～

184
00:11:14,174 --> 00:11:16,051
せなかが かゆくなっちまうぜ

185
00:11:16,385 --> 00:11:19,054
それで
キラリちゃんは どうしたのかな？

186
00:11:19,137 --> 00:11:20,180
(ふたり) え？

187
00:11:20,263 --> 00:11:21,306
(メロンパンナ) キラリちゃん？

188
00:11:21,598 --> 00:11:24,017
(ジャム)
キララちゃんに そっくりのこで――

189
00:11:24,101 --> 00:11:26,895
いっしょに ほしぞらを
まもっているんだ

190
00:11:26,978 --> 00:11:28,271
そうだったね

191
00:11:28,355 --> 00:11:29,231
(キララ) うん…

192
00:11:29,314 --> 00:11:31,775
(アンパンマン)
じゃあ とっても なかよしなんだね

193
00:11:32,275 --> 00:11:33,819
(キララ) ハァ…
(アンパンマン･ジャム) ん？

194
00:11:35,445 --> 00:11:36,530
あのね…

195
00:11:36,613 --> 00:11:38,698
キラリも どっかに おっこっちゃったの

196
00:11:38,782 --> 00:11:39,825
おっこちた？

197
00:11:39,908 --> 00:11:41,326
(みんな) ええっ！

198
00:11:41,701 --> 00:11:43,161
だって キラリったら――

199
00:11:43,245 --> 00:11:45,789
ながれぼしを とばしちゃ
ダメっていうのよ

200
00:11:46,206 --> 00:11:47,749
そんなの むりでしょう

201
00:11:48,083 --> 00:11:49,835
だから あたし わるくないの

202
00:11:49,918 --> 00:11:51,920
ぜんぜん わるくないんだもーん！

203
00:11:52,003 --> 00:11:54,548
フン　はむっ はむっ

204
00:11:56,508 --> 00:11:58,260
(アンパンマン) ぼく さがしてきます

205
00:11:58,343 --> 00:12:00,178
(しょくぱんまん)
わたしたちも てつだいますよ

206
00:12:00,262 --> 00:12:01,096
(カレーパンマン) ああ

207
00:12:01,346 --> 00:12:02,889
(ジャム) みんな たのんだよ

208
00:12:02,973 --> 00:12:04,391
(アンパンマンたち) はい！

209
00:12:08,603 --> 00:12:10,147
(ドキンちゃん) も～う

210
00:12:10,230 --> 00:12:14,151
アンパンマンに まけて まけて
まけて まけてばっか

211
00:12:14,526 --> 00:12:17,154
そんなに
まけ まけ いわないでよ

212
00:12:17,237 --> 00:12:19,197
あ～ら ほんとのことでしょう

213
00:12:19,281 --> 00:12:21,992
もう！ なんで かてないんだ？

214
00:12:22,075 --> 00:12:23,118
(ホラーマン) ホラホラ～

215
00:12:23,201 --> 00:12:24,828
(ドキン) もう ちかよらないで！

216
00:12:25,454 --> 00:12:27,581
(ホラーマン) か… かてないのは
おまぬけ ばいきんまんが――

217
00:12:27,664 --> 00:12:29,708
そうじゅうしているから なんですね

218
00:12:29,791 --> 00:12:30,917
な～に～！

219
00:12:31,543 --> 00:12:33,170
ピンポン ピンポン！

220
00:12:33,253 --> 00:12:35,505
だいせいかいじゃ　ほい

221
00:12:35,589 --> 00:12:37,799
カルシウム100ばい ホラーマン！

222
00:12:37,883 --> 00:12:38,717
(ばいきんまん) ハヒ！

223
00:12:38,800 --> 00:12:40,302
ドクター･ヒヤリ

224
00:12:40,552 --> 00:12:42,095
(ヒヤリ) だが きょうからは ちがう

225
00:12:42,179 --> 00:12:44,806
だだんだんが うまれかわるのじゃ

226
00:12:44,890 --> 00:12:47,726
みよ！ だだんだんの こころを！

227
00:12:49,769 --> 00:12:51,646
(ばいきんまん)
だだんだんのこころ？

228
00:13:01,865 --> 00:13:04,159
(ヒヤリ)
じぶんで かんがえ
じぶんで うごき――

229
00:13:04,242 --> 00:13:06,578
じぶんのちからで たたかう
だだんだん

230
00:13:06,661 --> 00:13:10,707
ジャイアントだだんだんの
たんじょうじゃ！

231
00:13:14,711 --> 00:13:17,380
(かびるんるんたち)
かびかび かび かび かびかび～

232
00:13:18,590 --> 00:13:19,424
かび～

233
00:13:20,175 --> 00:13:22,427
(ヒヤリ) ヒャーッ
ヒャッヒャッヒャッヒャッヒャッ

234
00:13:23,386 --> 00:13:26,848
(みんな) うわーっ！

235
00:13:28,767 --> 00:13:31,144
(ヒヤリ) ヒャーッ
ヒャッヒャッヒャッヒャッヒャッ

236
00:13:31,228 --> 00:13:32,229
(ばいきんまん) えっ
(ホラーマン) ホラ？

237
00:13:39,277 --> 00:13:41,112
(ヒヤリ) ええっと
なっ… なんじゃ？

238
00:13:41,696 --> 00:13:44,616
(ドキン)
なんだか ジャイアントだだんだんに
にてるわね

239
00:13:45,116 --> 00:13:46,743
(ホラーマン) その… ステキ

240
00:13:46,826 --> 00:13:48,995
まあ ステッキですね　エヘ

241
00:13:49,287 --> 00:13:50,705
(ギラリ) ギラー

242
00:13:50,789 --> 00:13:52,123
(ドキン) わあ
(ホラーマン) ホ… ホラ…

243
00:13:52,207 --> 00:13:54,751
(ホラーマン) まあ ギラリと
にらまれちゃいましたねえ

244
00:13:54,834 --> 00:13:55,835
(ギラリ) ギラッ！

245
00:13:58,129 --> 00:14:00,048
(ジャイアントだだんだん)
ダダンダーン

246
00:14:00,757 --> 00:14:03,385
(ばいきんまん) おっ おっ おーっ！
(ホラーマン･ドキン) うわーっ！

247
00:14:03,468 --> 00:14:06,263
(ヒヤリ) わっ どこへいく？
とまらんぞーっ！

248
00:14:12,769 --> 00:14:14,563
(ばいきんまん) おい どうなってんだ？

249
00:14:14,646 --> 00:14:15,981
(ヒヤリ) どうやら あいつは――

250
00:14:16,064 --> 00:14:18,567
ジャイアントだだんだんを
うごかせるようじゃ

251
00:14:19,025 --> 00:14:21,361
あるいは
こころの いちぶかもしれん

252
00:14:21,444 --> 00:14:22,487
(ばいきんまん) なんだと！

253
00:14:22,571 --> 00:14:25,532
(ヒヤリ) しかし なぜ あんなやつが
うまれてしまったんだ？

254
00:14:25,615 --> 00:14:27,534
(ばいきんまん)
えーい　なやんでる ばあいか！

255
00:14:27,617 --> 00:14:28,577
まてまて～！

256
00:14:28,660 --> 00:14:29,661
(ドキン) ちょっと ばいきんま～ん

257
00:14:29,744 --> 00:14:31,246
(ホラーマン) あたしも おともします

258
00:14:31,329 --> 00:14:32,789
ホラ～

259
00:14:34,124 --> 00:14:35,208
(キララ) ごちそうさま！

260
00:14:35,542 --> 00:14:36,418
アハッ

261
00:14:36,501 --> 00:14:37,377
(メロンパンナ) フフッ

262
00:14:37,460 --> 00:14:39,754
(クリームパンダ) ねえねえ
ぼくにも みせてよ

263
00:14:39,838 --> 00:14:41,464
キララちゃんの ながれぼし

264
00:14:41,548 --> 00:14:42,549
(チーズ) アンアン

265
00:14:42,632 --> 00:14:44,467
うん いいよ

266
00:14:45,010 --> 00:14:48,513
ながれぼしさん キララ キララと
げんきよく たのしく――

267
00:14:48,597 --> 00:14:50,181
とんで！

268
00:14:52,017 --> 00:14:52,976
(メロンパンナ) え？

269
00:14:53,059 --> 00:14:54,269
(チーズ) ア～ン？

270
00:14:54,352 --> 00:14:57,939
(キララ) あっ… これって
ちょっとした しっぱいってわけ

271
00:14:58,231 --> 00:15:00,108
こんどは ちゃんと とばすわよ！

272
00:15:00,191 --> 00:15:01,401
それ！

273
00:15:01,735 --> 00:15:04,404
そんな… そんな… そんな！

274
00:15:04,738 --> 00:15:07,407
そんなーっ！

275
00:15:08,116 --> 00:15:10,285
(バタコ)
おひさまのした だからじゃない？

276
00:15:10,368 --> 00:15:11,953
(ジャム) そうかもしれないし――

277
00:15:12,037 --> 00:15:14,831
キラリちゃんが
いないからかもしれないねえ

278
00:15:14,914 --> 00:15:17,167
(キララ) え… そんなことない！

279
00:15:17,250 --> 00:15:18,918
あたしひとりでも とばせる

280
00:15:19,127 --> 00:15:20,962
なんだって できるんだもん

281
00:15:21,046 --> 00:15:24,424
えい！ えい！ えーいっ！

282
00:15:26,134 --> 00:15:27,636
あっ あーっ！

283
00:15:27,719 --> 00:15:29,846
あーっ！ あーっ！

284
00:15:29,929 --> 00:15:31,556
(メロンパンナ) キララちゃーん！

285
00:15:35,143 --> 00:15:37,520
(かぜの おと)

286
00:15:40,106 --> 00:15:41,107
(ギラリ) ギラッ

287
00:15:41,650 --> 00:15:44,402
(ことりの なきごえ)

288
00:15:47,656 --> 00:15:49,199
(アンパンマン) どうだった？

289
00:15:49,282 --> 00:15:50,659
(しょくぱんまん) いませんね

290
00:15:50,742 --> 00:15:53,286
(カレーパンマン) ひょっとして
ひとりで かえったんじゃないか？

291
00:15:53,370 --> 00:15:55,997
(アンパンマン) う～ん
でも もうすこし さがしてみよう

292
00:15:56,081 --> 00:15:58,750
(しょくぱんまん)
それじゃあ わたしは
むこうのほうへ いってみますよ

293
00:15:58,833 --> 00:16:00,627
(カレーパンマン)
よーし おれは こっちだ

294
00:16:02,212 --> 00:16:03,296
(メロンパンナ) アンパンマーン！

295
00:16:03,380 --> 00:16:04,297
(アンパンマン) ん？

296
00:16:07,967 --> 00:16:09,302
(キララ) うわーっ！

297
00:16:10,470 --> 00:16:11,680
わあーっ！

298
00:16:11,763 --> 00:16:13,890
とまれ とまれーっ！

299
00:16:14,516 --> 00:16:15,517
くうっ

300
00:16:16,851 --> 00:16:17,852
うっ

301
00:16:18,645 --> 00:16:20,146
たすかった！

302
00:16:20,772 --> 00:16:21,940
うわっ

303
00:16:22,023 --> 00:16:23,441
アタッ アイタッ！

304
00:16:28,363 --> 00:16:29,614
(キララ) それ！

305
00:16:29,989 --> 00:16:31,199
ええーい！

306
00:16:32,033 --> 00:16:33,159
も～う

307
00:16:33,451 --> 00:16:35,745
きらい きらい だいっきらい！

308
00:16:38,456 --> 00:16:39,416
アイタッ

309
00:16:42,502 --> 00:16:43,336
ハア…

310
00:16:43,420 --> 00:16:45,547
(アンパンマン) キララちゃーん
(キララ) あっ

311
00:16:47,132 --> 00:16:48,133
(アンパンマン) きいたよ

312
00:16:48,216 --> 00:16:51,052
キラリちゃんを みつけるまで
パンこうじょうで まってて

313
00:16:51,678 --> 00:16:53,221
(キララ) しらない キラリなんて

314
00:16:53,304 --> 00:16:54,389
(アンパンマンたち) えっ！

315
00:16:54,472 --> 00:16:57,016
(キララ) あたしは もっと もっと
ながれぼしを とばしたいの

316
00:16:57,100 --> 00:16:59,602
キラリの おほしさまに
じゃまされたくないの！

317
00:16:59,686 --> 00:17:00,854
(アンパンマン) キララちゃん

318
00:17:00,937 --> 00:17:01,813
(おおきな おと)
(４にん) わあっ

319
00:17:01,896 --> 00:17:04,315
(アンパンマン) ああああっ！
(メロンパンナたち) うっ うわっ！

320
00:17:06,526 --> 00:17:08,069
(アンパンマン) あぶない！
(キララたち) キャーッ！

321
00:17:10,989 --> 00:17:12,490
(だだんだん) ダダンダーン

322
00:17:12,574 --> 00:17:13,867
(アンパンマン) だだんだん

323
00:17:18,663 --> 00:17:20,081
(アンパンマンたち) うわっ

324
00:17:20,165 --> 00:17:21,166
ああっ

325
00:17:21,458 --> 00:17:23,585
(ギラリ) ギラーッ

326
00:17:23,668 --> 00:17:24,544
あっ

327
00:17:26,129 --> 00:17:27,589
(アンパンマン) にげるんだ！
(キララ) キャーッ

328
00:17:29,048 --> 00:17:29,966
(ギラリ) ギラ

329
00:17:30,717 --> 00:17:32,093
(だだんだん) ダダンダーン

330
00:17:32,635 --> 00:17:34,345
(キララたち) ああっ ああ…

331
00:17:34,429 --> 00:17:35,513
(アンパンマン) たあっ

332
00:17:36,014 --> 00:17:37,056
アンパンマン！

333
00:17:37,932 --> 00:17:39,184
あっ あーっ！

334
00:17:39,267 --> 00:17:41,102
ああーっ！

335
00:17:41,770 --> 00:17:42,937
(クリームパンダ) キララちゃん！

336
00:17:43,021 --> 00:17:44,606
(アンパンマン) やめろ はなすんだ！

337
00:17:46,649 --> 00:17:48,318
(アンパンマン) うっ えいっ

338
00:17:48,401 --> 00:17:49,694
きみは だれだ？

339
00:17:49,944 --> 00:17:51,988
どうして
キララちゃんを ねらうんだ

340
00:17:52,280 --> 00:17:53,865
(ばいきんまん) ハヒフヘホ～

341
00:17:54,115 --> 00:17:55,116
ばいきんまん！

342
00:17:55,200 --> 00:17:58,119
(ホラーマン) ホラ～
このこは ギラリちゃんなんですね

343
00:17:58,411 --> 00:17:59,370
ギラリちゃん？

344
00:17:59,662 --> 00:18:02,081
(ドキン)だって
ギラリと にらむんだも～ん

345
00:18:02,165 --> 00:18:05,460
(ばいきんまん)
さあ ジャイアントだだんだんで
こうげきだーっ！

346
00:18:07,045 --> 00:18:08,254
(だだんだんの あしおと)
(ばいきんまん) なに？

347
00:18:08,546 --> 00:18:10,006
(アンパンマン) そうは させないぞ！

348
00:18:10,340 --> 00:18:11,883
(ギラリ) ギラー

349
00:18:12,091 --> 00:18:13,885
(アンパンマン) ふっ！ ああっ

350
00:18:16,304 --> 00:18:17,347
アンパンマン！

351
00:18:17,430 --> 00:18:18,348
(ギラリ) ギラッ

352
00:18:20,183 --> 00:18:22,018
あっ ヤダ ヤダ

353
00:18:22,101 --> 00:18:24,062
はなして はなしてよ！

354
00:18:26,898 --> 00:18:28,316
(キララ) え？
(ギラリ) ギラ？

355
00:18:28,608 --> 00:18:29,526
(メロンパンナ) え？

356
00:18:30,902 --> 00:18:31,820
(ばいきんまん) ハ… ハヒ！

357
00:18:31,903 --> 00:18:34,072
(ドキン) なんなの このひかり？
(ホラーマン) ホラ～

358
00:18:41,162 --> 00:18:42,914
(だだんだん) ダダ… ダンダン

359
00:18:44,791 --> 00:18:46,334
ダダッ ダダ

360
00:18:47,502 --> 00:18:49,379
ダダ ダ…

361
00:18:50,004 --> 00:18:50,880
ダア～

362
00:18:51,631 --> 00:18:52,632
わあ わっ！

363
00:18:52,715 --> 00:18:53,758
(アンパンマン) いまだ！ えいっ

364
00:18:54,008 --> 00:18:55,385
(ばいきんまん) そうは させるか！

365
00:18:57,345 --> 00:18:59,013
うりゃーっ！

366
00:18:59,097 --> 00:19:00,849
(アンパンマン) ふっ！ はあっ

367
00:19:03,601 --> 00:19:05,270
しょくぱんまん　カレーパンマン

368
00:19:05,645 --> 00:19:06,646
(ふたり) うん

369
00:19:06,980 --> 00:19:07,897
いくぜ！

370
00:19:07,981 --> 00:19:09,148
(ふたり) それーっ！

371
00:19:09,232 --> 00:19:10,984
(ばいきんまん) あ～っ！

372
00:19:13,778 --> 00:19:16,197
ステキ！ しょくぱんまんさま～

373
00:19:16,739 --> 00:19:18,700
(アンパンマン) けがは ないかい？
(キララ) うん

374
00:19:19,576 --> 00:19:20,702
(アンパンマン) よし いこう

375
00:19:38,136 --> 00:19:40,054
(ジャム)
ジャイアントだだんだん…

376
00:19:40,138 --> 00:19:43,308
とんでもないものを つくったようだね

377
00:19:43,391 --> 00:19:46,519
(バタコ) でも ねらわれたのは
キララちゃん だったんでしょう？

378
00:19:46,603 --> 00:19:47,437
(クリームパンダ) うん

379
00:19:47,520 --> 00:19:50,398
ギラリって こが
あやつってるみたいだけど

380
00:19:50,481 --> 00:19:52,400
あのこは だれなのかしら？

381
00:19:52,483 --> 00:19:54,110
それに あのひかりは…

382
00:20:00,450 --> 00:20:05,788
♪～

383
00:20:05,872 --> 00:20:11,210
♪ 燃える光と やさしい光

384
00:20:11,294 --> 00:20:16,674
♪ 金色の夢 銀色の夢

385
00:20:16,758 --> 00:20:22,305
♪ 昼と夜との ふたつの光

386
00:20:22,388 --> 00:20:25,850
♪ 夢を夢見て

387
00:20:25,934 --> 00:20:32,190
♪ 二人は 光る

388
00:20:32,273 --> 00:20:33,858
(アンパンマン)
こんな まっかなうみ――

389
00:20:33,942 --> 00:20:36,736
きっと
キララちゃんは はじめてだよね

390
00:20:36,819 --> 00:20:37,820
えっ？

391
00:20:38,988 --> 00:20:40,198
げんきをだして

392
00:20:40,281 --> 00:20:42,533
キラリちゃんは
かならず みつかるよ

393
00:20:43,785 --> 00:20:46,871
うん みつける　ぜったいに！

394
00:20:47,664 --> 00:20:50,291
フフフッ
やっぱり だいすきなんだね――

395
00:20:50,375 --> 00:20:51,584
キラリちゃんのことが

396
00:20:51,668 --> 00:20:52,585
あっ

397
00:20:53,670 --> 00:20:57,006
だから ほしぞらは いつも
あんなに かがやいているんだね

398
00:20:57,090 --> 00:20:59,592
ながれぼしだって
げんきに とんでいるんだね

399
00:20:59,926 --> 00:21:00,843
あっ…

400
00:21:01,678 --> 00:21:04,555
(アンパンマン) ほら もうすぐ
おひさまが しずむよ

401
00:21:04,889 --> 00:21:05,848
わあ

402
00:21:05,932 --> 00:21:08,518
♪ ルルルル ルルル

403
00:21:08,601 --> 00:21:11,020
♪ ルルルル ルルル

404
00:21:11,396 --> 00:21:14,857
♪ ルルル ルルルルル

405
00:21:14,941 --> 00:21:16,192
♪ ルルルル

406
00:21:16,275 --> 00:21:19,862
ゆうやけぞらも あさのそらも
ぼくは すきだよ

407
00:21:19,946 --> 00:21:21,197
でもね…

408
00:21:21,698 --> 00:21:24,701
ほしぞらは
もっと もっと すきなんだ

409
00:21:25,451 --> 00:21:26,494
もっと もっと？

410
00:21:26,869 --> 00:21:27,912
(アンパンマン) そう

411
00:21:27,996 --> 00:21:31,207
おほしさまや ながれぼしを
ながめながら とんでいると――

412
00:21:31,290 --> 00:21:34,502
ぼくの こころにある ほし
いのちのほしに――

413
00:21:34,585 --> 00:21:37,422
ゆうきが げんきが
わいてくるからね

414
00:21:37,547 --> 00:21:38,881
いのちのほし？

415
00:21:38,965 --> 00:21:40,049
(アンパンマン) うん

416
00:21:40,133 --> 00:21:43,219
キララちゃんと キラリちゃんの
おかげだよ

417
00:21:44,345 --> 00:21:45,388
ああ…

418
00:21:46,389 --> 00:21:48,307
ううん　あのね――

419
00:21:48,391 --> 00:21:50,018
もしかしたら キラリは…

420
00:21:50,101 --> 00:21:51,227
(アンパンマン) え？

421
00:21:51,310 --> 00:21:53,521
～♪

422
00:21:53,604 --> 00:21:56,441
ううん… なんでもない

423
00:21:58,109 --> 00:22:00,778
しょくぱんまんたちが
みつけてるかもしれない

424
00:22:00,862 --> 00:22:02,697
パンこうじょうへ もどろう

425
00:22:18,713 --> 00:22:21,466
(ことりの なきごえ)

426
00:22:23,176 --> 00:22:24,552
(クロワッサンひめ) きれいね

427
00:22:24,635 --> 00:22:26,220
このクロワッサンせいは――

428
00:22:26,304 --> 00:22:28,931
うちゅうで いちばん
うつくしい ほしだわ

429
00:22:29,015 --> 00:22:32,685
(クロワッサンおうひ) ほんとね
クロワッサンひめの いうとおりね

430
00:22:32,769 --> 00:22:33,895
(かぜの おと)
(クロワッサンおうひ) あら？

431
00:22:33,978 --> 00:22:35,354
どうしたのかしら

432
00:22:35,438 --> 00:22:36,814
(クロワッサンひめ) あっ あれは！

433
00:22:37,106 --> 00:22:39,067
まあ なにかしら？

434
00:22:43,404 --> 00:22:44,864
(クロワッサンひめ) あっ まちが…

435
00:22:44,947 --> 00:22:46,282
(クロワッサンおうひ) はやく なかへ

436
00:22:47,408 --> 00:22:50,036
(みんな) うわ～っ

437
00:22:53,164 --> 00:22:54,582
(ゴミラ) はむ はむ はむっ

438
00:22:54,957 --> 00:22:57,585
はむっ はむ はむ　は～

439
00:22:57,668 --> 00:23:01,130
(ゴミラ)
おいしいな～　ぼく しあわせ

440
00:23:01,214 --> 00:23:02,590
あっ ああっ

441
00:23:05,927 --> 00:23:07,929
わあっ あっ ああ…

442
00:23:08,012 --> 00:23:11,390
うわっ ああっ わあーっ！

443
00:23:12,433 --> 00:23:14,602
(リーダー) そういん
しごとをやめて たいひ

444
00:23:14,685 --> 00:23:17,105
そういん ちかへ たいひ！
うわっ！

445
00:23:19,357 --> 00:23:21,109
(こてつじいさん) もしや これは…

446
00:23:21,192 --> 00:23:22,110
(こてつちゃん) あぶないてつ！
(こてつじいさん) うわあ

447
00:23:22,443 --> 00:23:24,112
(こてつじいさん) だあっ　うっ…
(こてつちゃん) うっ

448
00:23:24,362 --> 00:23:25,321
ああっ

449
00:23:25,404 --> 00:23:27,365
(こてつじいさん) こてつちゃん…
(こてつちゃん) え？

450
00:23:27,740 --> 00:23:29,867
パンこうじょうへ いくんじゃ

451
00:23:29,951 --> 00:23:32,829
ジャムおじさんに しらせるのだ

452
00:23:32,912 --> 00:23:35,373
ああ～っ こてつじいさん！

453
00:23:39,877 --> 00:23:40,878
(こてつちゃん) てつ！

454
00:23:44,132 --> 00:23:46,676
うわあーっ！

455
00:23:50,680 --> 00:23:53,766
て… て… てつーっ！

456
00:23:56,435 --> 00:24:02,024
♪～

457
00:24:02,108 --> 00:24:03,776
♪ ダン ダン ダダン

458
00:24:04,152 --> 00:24:05,778
♪ ダダン ダン

459
00:24:06,112 --> 00:24:09,282
♪ ダン ダン ダダンダ ダン

460
00:24:09,991 --> 00:24:13,619
♪ だんだん近づく 足音は

461
00:24:13,870 --> 00:24:16,956
♪ ダンダン ダダンダ ダン

462
00:24:17,790 --> 00:24:20,918
♪ あれがうわさの

463
00:24:21,002 --> 00:24:23,129
♪ ダダン ダ ダン！

464
00:24:23,212 --> 00:24:26,883
♪ 地ひびきたてて

465
00:24:26,966 --> 00:24:30,428
♪ やってくる

466
00:24:31,012 --> 00:24:32,680
(ばいきんまん) ハヒフヘホ～

467
00:24:32,763 --> 00:24:36,559
♪ 強いぞ！ すごいぞ！

468
00:24:36,893 --> 00:24:38,436
♪ ダダン ダ ダン

469
00:24:38,811 --> 00:24:40,479
♪ ダダンダ ダン ダン

470
00:24:40,688 --> 00:24:44,984
♪ ダダン ダダン ダン

471
00:24:45,067 --> 00:24:46,736
～♪

472
00:24:47,069 --> 00:24:50,281
(ヒヤリ)
どうやら よそうがいのエネルギーが
はいってしまったらしい

473
00:24:50,364 --> 00:24:51,866
そのために…

474
00:24:51,949 --> 00:24:53,743
だが しんぱいは いらん

475
00:24:54,410 --> 00:24:56,370
パワーアップした
ジャイアントだだんだんは――

476
00:24:56,454 --> 00:24:57,788
むてきじゃ！

477
00:24:57,872 --> 00:25:01,375
こんどという こんどこそ
アンパンマンを やっつけてやる！

478
00:25:01,459 --> 00:25:03,002
たのんだぞ ギラリ

479
00:25:04,045 --> 00:25:05,630
(ばいきんまん) んっ！ どこいった？

480
00:25:05,713 --> 00:25:06,756
(ドキン) しーらない

481
00:25:07,089 --> 00:25:09,258
あの キララとかいう
おんなのこを――

482
00:25:09,342 --> 00:25:12,053
つかまえることしか
かんがえてないようじゃのう

483
00:25:12,136 --> 00:25:13,554
なるほど

484
00:25:13,638 --> 00:25:15,056
グフフフフッ

485
00:25:15,139 --> 00:25:17,016
いいさくせんを おもいついたぞ！

486
00:25:25,608 --> 00:25:29,028
(ちびぞう)
わしざも はくちょうざも
ことざも みえないぞう

487
00:25:29,278 --> 00:25:32,782
(カバお) それに あまのがわも
ギョーザも ピザも きえてるよ

488
00:25:32,865 --> 00:25:35,409
(ピョンきち) ギョーザやピザは
はじめから ないだろう

489
00:25:35,493 --> 00:25:36,494
(ウサこ) でも へんね

490
00:25:36,577 --> 00:25:39,247
くもってもいないのに
ほしが みえないなんて

491
00:25:39,330 --> 00:25:41,040
(みみ) もうすこし まってみましょう

492
00:25:43,042 --> 00:25:44,210
(アンパンマン)
キラリちゃんは まだ――

493
00:25:44,293 --> 00:25:45,586
そらに かえっていないんだ

494
00:25:45,670 --> 00:25:47,880
(おおきな おと)
(みんな) わあっ

495
00:25:49,590 --> 00:25:52,009
(ジャム) みんな ふせるんだ！
(アンパンマンたち) うわあ

496
00:25:52,093 --> 00:25:54,011
(はげしく ぶつかるおと)

497
00:25:57,848 --> 00:26:00,017
(アンパンマンたち)
ハア ハア ハア
うわあっ！

498
00:26:03,562 --> 00:26:04,563
(バタコ) こてつちゃん！

499
00:26:04,897 --> 00:26:06,065
どうして ここに？

500
00:26:06,148 --> 00:26:07,441
それに このすがたは…

501
00:26:08,234 --> 00:26:09,485
(キララ) そんな…

502
00:26:10,778 --> 00:26:11,988
(キララ) うそでしょう…
(アンパンマン) え？

503
00:26:12,071 --> 00:26:14,198
(ビームの おと)
(あんぱんまんたち) ああっ

504
00:26:16,701 --> 00:26:17,827
あっ

505
00:26:17,910 --> 00:26:19,662
(メロンパンナ) なんなの あれは？

506
00:26:20,955 --> 00:26:22,415
(キララ) デビルスター

507
00:26:22,498 --> 00:26:23,749
(アンパンマン) デビルスター？

508
00:26:23,833 --> 00:26:26,377
(ジャム) もしかすると
こてつちゃんは あれのせいで…

509
00:26:26,460 --> 00:26:27,712
(バタコたち) ええっ！

510
00:26:27,962 --> 00:26:29,547
あたしのせいだ…

511
00:26:29,922 --> 00:26:31,215
あたしが わるいんだわ

512
00:26:32,508 --> 00:26:33,592
(アンパンマン) キララちゃん！

513
00:26:34,343 --> 00:26:36,178
(カレーパンマン) えいっ
(しょくぱんまん) はあっ

514
00:26:36,929 --> 00:26:38,139
デビルスターには――

515
00:26:38,222 --> 00:26:41,475
すべてのせかいを ほろぼすちからが
あると いわれている

516
00:26:41,559 --> 00:26:44,603
ねえ なぜ きゅうに あらわれたの？
デビルスターは

517
00:26:44,687 --> 00:26:45,688
(ジャム) う～ん…

518
00:26:45,771 --> 00:26:47,523
よぞらのほしが きえたことと――

519
00:26:47,606 --> 00:26:50,234
なにか かんけいが
あるのかもしれないね

520
00:26:54,530 --> 00:26:56,073
とんで ながれぼしさん

521
00:26:56,157 --> 00:26:57,742
いっぱい とぶのよ！

522
00:26:59,076 --> 00:27:00,202
とんで とんで！

523
00:27:00,286 --> 00:27:02,121
おねがいよ！

524
00:27:03,039 --> 00:27:04,165
えーいっ！

525
00:27:04,582 --> 00:27:06,751
おねがーい　えーい！

526
00:27:06,834 --> 00:27:07,918
わ～！

527
00:27:08,544 --> 00:27:09,920
みんなのところへ かえろう

528
00:27:10,004 --> 00:27:10,880
えっ

529
00:27:10,963 --> 00:27:12,256
そうは いかないわ！

530
00:27:12,340 --> 00:27:15,843
だって だって もうすぐ
デビルスターが くるのよ

531
00:27:15,926 --> 00:27:18,387
みんな こてつちゃんみたいに
されちゃうのよ！

532
00:27:18,929 --> 00:27:19,889
なんだって！

533
00:27:20,306 --> 00:27:21,599
でも ダメ

534
00:27:21,682 --> 00:27:23,309
あたし ひとりじゃ…

535
00:27:23,392 --> 00:27:24,894
キラリがいなきゃ…

536
00:27:24,977 --> 00:27:26,354
(ばいきんまん) みつけたぞ

537
00:27:27,855 --> 00:27:28,814
ばいきんまん！

538
00:27:28,898 --> 00:27:30,149
(じめんがゆれる おと)
(ふたり) あああっ

539
00:27:36,155 --> 00:27:37,073
(キララ) あっ！

540
00:27:37,365 --> 00:27:38,199
(ギラリ) ギラッ

541
00:27:38,532 --> 00:27:40,201
まずは
あいつを やっつけろ！

542
00:27:40,284 --> 00:27:42,661
そうすれば
キララを つかまえられるぞ

543
00:27:42,745 --> 00:27:44,163
(ギラリ) ギラー！

544
00:27:44,246 --> 00:27:46,207
(だだんだん) ダダンダーン！

545
00:27:50,669 --> 00:27:51,837
(アンパンマン) にげるんだ！
(キララ) キャーッ！

546
00:27:53,631 --> 00:27:54,632
(ギラリ) ギラー！

547
00:27:54,715 --> 00:27:56,967
(だだんだん) ダダンダーン！

548
00:27:57,843 --> 00:28:00,805
ギラリとアンパンマンを
たたかわせて たかみのけんぶつか

549
00:28:00,888 --> 00:28:04,683
ジャイアントだだんだん！
アンパンマンを にがすな！

550
00:28:06,352 --> 00:28:08,312
(クリームパンダ)
さっきより おおきくなってるよ！

551
00:28:08,396 --> 00:28:10,231
(メロンパンナ)
きっと ちかづいてるんだわ

552
00:28:10,314 --> 00:28:12,525
(ジャム) このままでは
わたしたちのせかいも――

553
00:28:12,608 --> 00:28:14,860
てつのほしと おなじ うんめいに

554
00:28:14,944 --> 00:28:15,778
(バタコたち) ええっ

555
00:28:15,861 --> 00:28:17,780
(アンパンマン) いっ くくっ うっ

556
00:28:21,033 --> 00:28:21,992
うっ！

557
00:28:34,380 --> 00:28:35,423
あっ

558
00:28:35,506 --> 00:28:37,716
(だだんだん) ダダンダーン

559
00:28:37,800 --> 00:28:38,717
(アンパンマン) うわっ

560
00:28:38,801 --> 00:28:40,052
(ふたり) うわーっ！

561
00:28:40,344 --> 00:28:41,720
(キララ) うわっ
(アンパンマン) キララちゃーん！

562
00:28:41,804 --> 00:28:43,013
(キララ) キャーッ！

563
00:28:44,181 --> 00:28:45,599
キララちゃーん！

564
00:28:47,393 --> 00:28:48,394
だあっ

565
00:28:48,811 --> 00:28:49,645
あー！

566
00:28:49,728 --> 00:28:51,689
(カレーパンマン･しょくぱんまん)
ダブルパーンチ！

567
00:28:52,398 --> 00:28:53,399
よかった

568
00:28:56,318 --> 00:28:57,695
(しょくぱんまん) ここに かくれてて

569
00:28:57,778 --> 00:28:58,904
(キララ) ありがとう

570
00:28:58,988 --> 00:29:00,739
(アンパンマン)
しょくぱんまん カレーパンマン

571
00:29:00,823 --> 00:29:03,033
(しょくぱんまん)
かえりが おそいんで
みにきたんですが――

572
00:29:03,117 --> 00:29:04,618
だいせいかいでしたね

573
00:29:04,702 --> 00:29:07,538
(カレーパンマン)
あいつを かたづけて
デビルスターを くいとめようぜ

574
00:29:07,621 --> 00:29:09,790
(ばいきんまん)
かたづけられて たまるか！

575
00:29:10,082 --> 00:29:12,751
(ばいきんまん) ３にん まとめて
コテンパンにしてやれ！

576
00:29:12,835 --> 00:29:15,713
(ドキン) ダメ ダメ
しょくぱんまんさまだけは ダメ～

577
00:29:15,796 --> 00:29:19,049
(ホラーマン) ホラー あたしを
コテンパンにしないでくださーい

578
00:29:19,592 --> 00:29:20,843
(ギラリ) ギラー！

579
00:29:25,723 --> 00:29:26,849
(アンパンマン) いくぞ！
(カレーパンマンたち) おう！

580
00:29:31,187 --> 00:29:33,063
(３にん) トリプルパーンチ！

581
00:29:34,023 --> 00:29:34,982
うわーっ！

582
00:29:35,941 --> 00:29:38,110
うわあーっ！ うっ

583
00:29:41,447 --> 00:29:43,032
わあっ やっ わっ

584
00:29:43,115 --> 00:29:44,116
(アンパンマン) うわっ

585
00:29:44,200 --> 00:29:45,618
(ふたり) だあっ あっ

586
00:29:46,994 --> 00:29:48,162
(アンパンマン) みんな だいじょうぶ？

587
00:29:48,245 --> 00:29:49,079
(しょくぱんまん) はい

588
00:29:49,163 --> 00:29:50,623
なんて ちからもちなんでしょう

589
00:29:50,706 --> 00:29:51,874
(カレーパンマン) あいつ
どこへ いったんだ？

590
00:29:51,957 --> 00:29:53,792
(おおきな おと)
(３にん) うわーっ！

591
00:29:56,921 --> 00:29:58,839
わあーっ！ えいっ

592
00:29:58,923 --> 00:30:00,549
(カレーパンマン)
だめだ にげきれねえ

593
00:30:01,467 --> 00:30:02,760
(アンパンマン) みんな あのいわを！

594
00:30:02,843 --> 00:30:03,677
(しょくぱんまん･カレーパンマン)
おう！

595
00:30:05,262 --> 00:30:07,139
(３にん) トリプルパーンチ！

596
00:30:10,518 --> 00:30:12,186
(いわが ぶつかるおと)
(だだんだん) ダッ…

597
00:30:22,363 --> 00:30:23,364
(ギラリ) ギラ！

598
00:30:23,906 --> 00:30:25,574
(アンパンマンたち) ああっ
(ギラリ) ギラー！

599
00:30:25,658 --> 00:30:27,368
(アンパンマン) うわーっ
(キララ) とおっ

600
00:30:28,827 --> 00:30:29,787
あっ

601
00:30:30,579 --> 00:30:31,455
ふっ！

602
00:30:40,339 --> 00:30:41,465
(アンパンマンたち) わあーっ！

603
00:30:46,011 --> 00:30:47,805
(キララ) ああっ
(アンパンマン) わあ～

604
00:31:02,444 --> 00:31:06,156
(だだんだん) ダダンダーン！

605
00:31:08,909 --> 00:31:10,411
(ドキン) なんなの これ？

606
00:31:10,494 --> 00:31:11,829
(ばいきんまん) す… すごい

607
00:31:11,912 --> 00:31:13,455
ヒャーッ ヒャッヒャッヒャッ

608
00:31:13,539 --> 00:31:16,917
おそらく ギラリのちからが
しんか させたのだ

609
00:31:17,001 --> 00:31:18,210
(カレーパンマンたち) えっ！
(アンパンマン) なんだって！

610
00:31:18,294 --> 00:31:19,128
(ギラリ) ギラッ

611
00:31:19,211 --> 00:31:20,337
(アンパンマンたち) んん？
(キララ) やめて！

612
00:31:20,421 --> 00:31:22,131
(キララ)
こんなことしてる ばあいじゃないわ

613
00:31:22,464 --> 00:31:24,174
そうでしょ キラリ！

614
00:31:25,551 --> 00:31:26,885
キラリ… ちゃん？

615
00:31:26,969 --> 00:31:28,137
(しょくぱんまん) なんですって？
(カレーパンマン) ええ？

616
00:31:28,220 --> 00:31:31,599
(カレーパンマン)
キララちゃんと キラリちゃんは
ふたごの ほしのようせいで――

617
00:31:31,932 --> 00:31:35,102
ギラリがキラリで
つまり その… ええっ！

618
00:31:35,185 --> 00:31:38,105
そうか！ ほしのようせいの
エネルギーだったのか

619
00:31:38,439 --> 00:31:40,482
だけど
どうして たたかってるの？

620
00:31:40,566 --> 00:31:42,151
りゆうなんか どうでもいい！

621
00:31:42,234 --> 00:31:44,486
とにかく
アンパンマンを やっつけろ！

622
00:31:45,696 --> 00:31:47,323
(３にん) うわーっ！

623
00:31:49,325 --> 00:31:50,492
(３にん) ええっ！

624
00:31:50,743 --> 00:31:52,536
(キララ) デビルスター
(アンパンマン) えっ！

625
00:31:53,621 --> 00:31:54,496
(キララ) ついに…

626
00:32:03,631 --> 00:32:04,673
(ばいきんまん) ハヒ！

627
00:32:04,757 --> 00:32:06,091
デビルスターじゃと？

628
00:32:12,640 --> 00:32:13,849
(アンパンマン) まちが！
(しょくぱんまん) ああ！

629
00:32:19,938 --> 00:32:22,316
(まちのひとたち) キャー

630
00:32:25,194 --> 00:32:27,488
うわ～っ

631
00:32:28,739 --> 00:32:29,615
ぎゃあ

632
00:32:29,990 --> 00:32:31,158
(こどもたち) うう… うっ

633
00:32:31,241 --> 00:32:33,160
(みみ) はやく！ はやく！
はやく なかへ！

634
00:32:33,243 --> 00:32:34,495
(ウサこ) せんせい こわいよ～

635
00:32:34,578 --> 00:32:35,579
(カバお) こわいよ せんせい

636
00:32:35,663 --> 00:32:37,539
(くるまの はしるおと)
(みんな) あっ

637
00:32:39,249 --> 00:32:40,376
(みみ) バタコさん！

638
00:32:40,459 --> 00:32:41,627
みんな のって！

639
00:32:42,336 --> 00:32:43,504
(ギラリ) ギラ！

640
00:32:44,088 --> 00:32:45,506
(だだんだん) ダーン
(アンパンマンたち) うわっ！

641
00:32:47,883 --> 00:32:48,842
(アンパンマンたち) くっ

642
00:32:49,593 --> 00:32:50,511
(カレーパンマン) わあっ

643
00:32:53,681 --> 00:32:54,598
(カレーパンマン) うわっ

644
00:32:56,892 --> 00:32:58,060
(だだんだん) ダーン

645
00:32:58,310 --> 00:32:59,395
(３にん) うわっ

646
00:32:59,687 --> 00:33:00,604
えっ？

647
00:33:03,023 --> 00:33:05,442
うわあーっ！ あーっ！

648
00:33:05,651 --> 00:33:07,069
やめて！

649
00:33:09,863 --> 00:33:11,699
(しょくぱんまんたち) うっ…

650
00:33:12,491 --> 00:33:14,118
(アンパンマン) うっ ううっ…
(キララ) アンパンマン

651
00:33:14,368 --> 00:33:16,120
ありがとう キララちゃん

652
00:33:16,203 --> 00:33:17,913
でも あぶないから にげて

653
00:33:18,580 --> 00:33:19,498
(アンパンマン) うわっ

654
00:33:19,998 --> 00:33:22,626
(キララ) おねがい やめて　キラリ！

655
00:33:24,461 --> 00:33:27,172
もうやめて
あたしが わるかったの

656
00:33:27,256 --> 00:33:29,383
おねがい おもいだして！

657
00:33:29,466 --> 00:33:30,634
キララちゃん

658
00:33:30,926 --> 00:33:32,136
(しょくぱんまん) アンパンマン

659
00:33:32,219 --> 00:33:33,262
(ビームの おと)
(３にん) うわっ

660
00:33:35,305 --> 00:33:37,224
(カレーパンマン) ああっ まちが！

661
00:33:37,474 --> 00:33:38,851
(アンパンマン)
ふたりは まちのみんなを！

662
00:33:38,934 --> 00:33:41,311
(しょくぱんまん) でも…
(アンパンマン) ここは ぼくにまかせて

663
00:33:41,395 --> 00:33:42,438
さあ はやく！

664
00:33:42,521 --> 00:33:44,148
(しょくぱんまん) わかりました
(カレーパンマン) よーし

665
00:33:45,858 --> 00:33:49,236
しょくぱんまんさま
あたしも ごいっしょします～

666
00:33:49,319 --> 00:33:51,780
ドキンちゃん
あたしも ごいっしょします

667
00:33:51,864 --> 00:33:52,823
ホラー！

668
00:33:52,906 --> 00:33:54,491
(ヒヤリ) ヒヤ～

669
00:33:54,992 --> 00:33:57,327
こいつは ただごとじゃないぞ

670
00:33:57,411 --> 00:33:59,288
ただごとでも なにごとでも いい

671
00:33:59,371 --> 00:34:01,248
アンパンマンをやっつけろ！

672
00:34:01,331 --> 00:34:03,751
(だだんだん) ダダンダーン！

673
00:34:03,834 --> 00:34:04,668
うわっ！

674
00:34:05,794 --> 00:34:07,463
(だだんだん) ウーッ ダーン！

675
00:34:07,546 --> 00:34:08,589
(アンパンマン) ええいっ

676
00:34:09,882 --> 00:34:11,508
ううっ　やっ

677
00:34:12,384 --> 00:34:13,469
(アンパンマン) キラリちゃん

678
00:34:13,552 --> 00:34:14,887
(ギラリ) ギラー！

679
00:34:14,970 --> 00:34:16,388
(アンパンマン) キラリちゃん
(ギラリ) ギッ！

680
00:34:16,472 --> 00:34:18,515
(アンパンマン) きみは ふたりで
よぞらに かえりたい

681
00:34:18,599 --> 00:34:20,434
だから
キララちゃんを おいかけてる

682
00:34:20,517 --> 00:34:21,727
そうなんだね？

683
00:34:21,810 --> 00:34:22,978
(ギラリ) ギラ！

684
00:34:23,312 --> 00:34:25,397
キララちゃんも きっと
おなじ きもちだよ

685
00:34:29,860 --> 00:34:31,695
(キララ) ごめんね キラリ

686
00:34:31,904 --> 00:34:33,405
あたしが わるかった

687
00:34:33,489 --> 00:34:35,324
あたしが まちがってたわ

688
00:34:35,699 --> 00:34:38,410
だから かえろう
ふたりで いっしょに

689
00:34:39,286 --> 00:34:40,746
(キララ) ああっ！
(アンパンマン) わっ　ああっ

690
00:34:40,829 --> 00:34:41,705
(キララ) キャーッ！

691
00:34:41,789 --> 00:34:42,915
(ばいきんまん) ウフフフッ

692
00:34:42,998 --> 00:34:44,666
(ギラリ) ギラ
(アンパンマン) なにを するんだ！

693
00:34:44,750 --> 00:34:46,835
ハヒフヘホ～

694
00:34:46,919 --> 00:34:48,003
(ばいきんまん) やい ギラリ
(キララ) キャッ！

695
00:34:48,086 --> 00:34:49,421
こいつを かえしてほしければ――

696
00:34:49,505 --> 00:34:51,048
アンパンマンを やっつけろ

697
00:34:51,131 --> 00:34:52,049
えっ？

698
00:34:52,132 --> 00:34:54,051
ダメ ダメ ダメ ダメ！

699
00:34:54,134 --> 00:34:56,053
そんなことしたら ぜっこうよ！

700
00:34:56,136 --> 00:34:57,805
だまれ だまれ だまれ～！

701
00:34:58,055 --> 00:34:59,306
(アンパンマン) キララちゃん！
(ギラリ) ギラ！

702
00:34:59,389 --> 00:35:01,809
おっーと！ これで どうだ！

703
00:35:02,184 --> 00:35:03,060
(アンパンマン) キラリちゃん！

704
00:35:03,644 --> 00:35:05,145
ぐっ！ うっ うっ…

705
00:35:05,229 --> 00:35:07,064
(キララ) ああ！ アンパンマン！

706
00:35:07,147 --> 00:35:08,273
(ギラリ) キラ！

707
00:35:08,649 --> 00:35:11,985
か… かおが ゆがんで
ちからが でない…

708
00:35:13,195 --> 00:35:15,155
(ばいきんまん) とどめだーっ！

709
00:35:15,239 --> 00:35:16,907
(アンパンマン) わあーっ！

710
00:35:17,658 --> 00:35:18,826
(ばいきんまん) それー！

711
00:35:19,576 --> 00:35:21,203
(ばいきんまん) そ～れ！
(アンパンマン) やっ うわっ

712
00:35:21,286 --> 00:35:23,914
(ばいきんまん) あっ ほれ ほれ！
どうした アンパンマン！

713
00:35:23,997 --> 00:35:26,708
(キララ) キラリ おねがい
アンパンマンを たすけて！

714
00:35:28,544 --> 00:35:30,212
(ばいきんまん) この！ この！
(アンパンマン) うっ うっ

715
00:35:31,046 --> 00:35:32,548
(ばいきんまん) なに？
(キララ) ああっ

716
00:35:33,507 --> 00:35:35,050
ありがとう キラリ

717
00:35:35,384 --> 00:35:37,594
おねがい
アンパンマンも たすけて

718
00:35:38,220 --> 00:35:40,472
あっ キラリ どこへ？

719
00:35:40,931 --> 00:35:41,974
はなして！

720
00:35:42,266 --> 00:35:44,560
キラリ おもいだして

721
00:35:44,643 --> 00:35:46,144
あたしが わるかったから

722
00:35:46,228 --> 00:35:48,564
もう ながれぼしで
おほしさまの ひかりを――

723
00:35:48,647 --> 00:35:50,065
じゃましないから

724
00:35:50,148 --> 00:35:52,359
おねがい キラリ

725
00:36:13,297 --> 00:36:15,883
(ギラリ) キ… ラ… ラ…

726
00:36:19,303 --> 00:36:20,596
キラリ…

727
00:36:24,892 --> 00:36:26,894
(ばいきんまん) ハヒ？
(アンパンマン) キラリちゃん

728
00:36:36,320 --> 00:36:37,321
キラリ

729
00:36:41,199 --> 00:36:42,367
ああっ

730
00:36:45,579 --> 00:36:46,538
キララ？

731
00:36:46,622 --> 00:36:49,708
(キララ) あっ　キラリ！

732
00:36:49,791 --> 00:36:52,085
えーん えーん　ごめんなさい

733
00:36:54,046 --> 00:36:55,172
キララ

734
00:36:58,967 --> 00:37:00,135
よかった

735
00:37:00,510 --> 00:37:02,095
よくなーい！

736
00:37:02,179 --> 00:37:03,889
やれ ジャイアントだだんだん！

737
00:37:03,972 --> 00:37:06,266
(エネルギーが きれるおと)

738
00:37:07,935 --> 00:37:09,144
なに！

739
00:37:14,650 --> 00:37:15,901
(ばいきんまん) なんだー？

740
00:37:16,109 --> 00:37:19,154
えーい こうなったら
おまえから やっつけてやる

741
00:37:19,237 --> 00:37:20,155
(キラリ) キララ！
(キララ) えっ

742
00:37:20,238 --> 00:37:21,239
(ばいきんまん) とりゃっ！

743
00:37:22,908 --> 00:37:23,951
グギッ！

744
00:37:24,034 --> 00:37:27,371
どわあーっ！

745
00:37:28,747 --> 00:37:29,957
わあっ

746
00:37:35,796 --> 00:37:37,005
(キララ) アンパンマン

747
00:37:37,673 --> 00:37:39,174
(アンパンマン) キラリちゃんだね
(キラリ) ええ

748
00:37:39,257 --> 00:37:40,384
(アンパンマン) よかった

749
00:37:40,676 --> 00:37:43,011
キララちゃん
ジャムおじさんに しらせて

750
00:37:43,095 --> 00:37:44,054
(キララ) うん

751
00:37:44,137 --> 00:37:46,306
キラリ ちからをかして

752
00:37:46,390 --> 00:37:47,265
(キラリ) ええ

753
00:37:48,058 --> 00:37:50,310
ながれぼしさん とんで！

754
00:37:54,106 --> 00:37:58,110
おねがい おほしさま
キラリ キラリと またたいて！

755
00:38:08,286 --> 00:38:09,871
(おかあさん) こっちよ はやく！
(こども) ああ～っ

756
00:38:10,497 --> 00:38:11,456
(ふたり) わあーっ！

757
00:38:13,417 --> 00:38:14,668
(しょくぱんまん)
けがは ありませんか？

758
00:38:14,751 --> 00:38:16,545
(おかあさん) はい
(こども) ありがとう

759
00:38:16,628 --> 00:38:19,756
(カレーパンマン) しかし
ひどいことに なっちまったな

760
00:38:19,840 --> 00:38:22,092
(メロンパンナ)
しょくぱんまん！ カレーパンマン！

761
00:38:22,175 --> 00:38:24,678
(カレーパンマン) ん？
(クリームパンダ) こっち こっち！

762
00:38:26,263 --> 00:38:30,017
(ジャム)
アンパンマンとキララちゃんが
ジャイアントだだんだんに？

763
00:38:30,100 --> 00:38:33,478
(メロンパンナ)
それに あのギラリってこが
キラリちゃんだったなんて…

764
00:38:33,562 --> 00:38:35,731
(カバお) あっ！ みてみて ほしだよ！

765
00:38:35,814 --> 00:38:36,940
(みみたち) あ… うわあ

766
00:38:37,024 --> 00:38:39,943
(ちびぞう)
ことざでも はくちょうざでもなくて…

767
00:38:40,027 --> 00:38:41,695
アンパンマンざ だぞう

768
00:38:41,778 --> 00:38:42,988
(みんな) うわあ！

769
00:38:43,071 --> 00:38:44,281
(みみ) ジャムおじさん

770
00:38:44,364 --> 00:38:45,490
(ジャム) うん

771
00:38:45,574 --> 00:38:48,785
(ジャム) バタコ チーズ
あたらしいかおを やくよ！

772
00:38:48,869 --> 00:38:49,911
(バタコ) はい
(チーズ) アン アアン

773
00:38:50,787 --> 00:38:52,456
(ばいきんまん) このーっ！

774
00:38:52,539 --> 00:38:53,957
よくも やったな！

775
00:38:54,041 --> 00:38:54,958
(３にん) うわーっ！

776
00:38:56,084 --> 00:38:58,336
(ばいきんまん)
まーて まて まてーい！

777
00:39:05,719 --> 00:39:06,678
(アンパンマン) うっ

778
00:39:07,220 --> 00:39:08,764
(アンパンマン) ああっ
(キララ) わあっ

779
00:39:11,600 --> 00:39:12,851
(３にん) うわ～っ

780
00:39:13,393 --> 00:39:16,063
(ばいきんまん) いまだーっ！

781
00:39:19,024 --> 00:39:20,233
(バタコ) アンパンマーン！

782
00:39:20,442 --> 00:39:21,359
なにっ！

783
00:39:22,194 --> 00:39:23,361
(バタコ) ふっ！ あ…

784
00:39:23,737 --> 00:39:24,571
(ふたり) あっ

785
00:39:26,156 --> 00:39:27,449
(ジャム) うん？
(チーズ) アアーン

786
00:39:27,532 --> 00:39:28,784
バタコ！ だあっ

787
00:39:28,867 --> 00:39:30,077
アアアアン

788
00:39:31,703 --> 00:39:32,829
アンパンマーン！

789
00:39:32,913 --> 00:39:33,997
あたらしい かおよ！

790
00:39:34,498 --> 00:39:36,291
そうは させるかーっ！

791
00:39:38,168 --> 00:39:39,252
ううっ

792
00:39:39,711 --> 00:39:42,047
え？ あわわわわーっ ハヒ

793
00:39:44,132 --> 00:39:45,884
(ヒヤリ) しらんぞ しらんぞ

794
00:39:45,967 --> 00:39:48,553
あとのことは しらんぞー！

795
00:39:50,013 --> 00:39:50,931
ぐわっ

796
00:39:54,559 --> 00:39:55,644
(クリームパンダ) パス！

797
00:39:56,103 --> 00:39:57,229
(メロンパンナ) はい

798
00:39:58,021 --> 00:39:59,022
うわっ

799
00:40:00,357 --> 00:40:01,274
おねえちゃん！

800
00:40:01,983 --> 00:40:02,943
はい！

801
00:40:03,485 --> 00:40:04,361
(クリームパンダ) それっ！

802
00:40:07,906 --> 00:40:10,283
げんき100ばい　アンパンマン！

803
00:40:11,076 --> 00:40:12,035
だあっ

804
00:40:12,119 --> 00:40:13,787
(キララ･キラリ) うう～っ
(アンパンマン) わあっ

805
00:40:14,037 --> 00:40:14,913
(キララ･キラリ) あー！ キャーッ！

806
00:40:14,996 --> 00:40:16,123
(アンパンマン) ふっ！ くっ

807
00:40:17,791 --> 00:40:19,584
(キララ) そんな そんな そんな！

808
00:40:20,085 --> 00:40:23,505
あたしたちの ほしのひかりが
つうじないなんて

809
00:40:24,131 --> 00:40:27,008
(キラリ) デビルスターの ちからが
つよくなっているんだわ

810
00:40:27,092 --> 00:40:28,718
(アンパンマン) ひとまず あそこへ

811
00:40:33,098 --> 00:40:34,599
(キララ) どうしよう

812
00:40:35,016 --> 00:40:36,518
どうすれば いいの？

813
00:40:38,770 --> 00:40:39,855
(アンパンマン)
だいじょうぶだよ

814
00:40:39,938 --> 00:40:40,772
(キララたち) えっ？

815
00:40:41,606 --> 00:40:45,193
みんなのむねに こころのほしの
ひかりが あるかぎり――

816
00:40:45,443 --> 00:40:47,654
このせかいは かがやきつづける

817
00:40:48,363 --> 00:40:49,364
えい！

818
00:40:49,447 --> 00:40:50,949
(キララたち) アンパンマン！

819
00:40:54,286 --> 00:40:56,288
(カレーパンマン) みんな こっちだ！

820
00:40:56,621 --> 00:40:58,290
(しょくぱんまん) いそいでください！

821
00:41:00,417 --> 00:41:03,170
(カレーパンマン)
はやく くいとめなきゃ
まちは めちゃめちゃだ

822
00:41:03,253 --> 00:41:05,380
(しょくぱんまん) そんなことは
わたしが ゆるしません

823
00:41:05,463 --> 00:41:06,381
(カレーパンマン) おれも いくぜ！

824
00:41:06,464 --> 00:41:07,591
(みんな) がんばれ！

825
00:41:07,674 --> 00:41:09,426
(みみ) きをつけてくださいね

826
00:41:10,427 --> 00:41:11,928
(ドキン) あたしたちも いくわよ

827
00:41:12,012 --> 00:41:13,763
(ホラーマン)
アイアイサーです ホラー

828
00:41:16,850 --> 00:41:17,851
(アンパンマン) ええい

829
00:41:23,982 --> 00:41:25,734
なんて おおきいんだ

830
00:41:28,195 --> 00:41:30,405
アンパーンチ！

831
00:41:31,448 --> 00:41:35,327
うわっ うわあーっ！

832
00:41:35,410 --> 00:41:36,578
(キララ･キラリ) ああっ

833
00:41:36,912 --> 00:41:37,913
(メロンパンナ) あっ

834
00:41:39,080 --> 00:41:40,290
しょくぱんまんだわ！

835
00:41:40,373 --> 00:41:41,541
(クリームパンダ) カレーパンマンも！

836
00:41:41,791 --> 00:41:44,669
(カレーパンマン) いくぜ！
カレーパーンチ！

837
00:41:45,086 --> 00:41:46,087
ギャ～ッ

838
00:41:46,171 --> 00:41:47,214
があっ

839
00:41:47,672 --> 00:41:49,716
(しょくぱんまん)
あっ カレーパンマン！

840
00:41:53,678 --> 00:41:54,554
(４にん) あっ

841
00:41:55,931 --> 00:41:57,224
こんどは
わたしが あいてです

842
00:41:58,975 --> 00:41:59,893
うわっ

843
00:41:59,976 --> 00:42:01,728
しょくパーンチ！

844
00:42:03,021 --> 00:42:03,939
うわっ

845
00:42:04,147 --> 00:42:06,441
(ドキン) しょくぱんまんさま～

846
00:42:06,524 --> 00:42:08,693
あたしが おたすけします

847
00:42:09,110 --> 00:42:11,279
(ホラーマン) ホッ ホホホッ ホラー

848
00:42:11,363 --> 00:42:12,572
さよなら さよなら…

849
00:42:14,032 --> 00:42:15,575
(メロンパンナたち) ああっ

850
00:42:15,659 --> 00:42:17,369
(クリームパンダ) もう だれにも…

851
00:42:17,452 --> 00:42:19,537
だれにも とめられないんだ

852
00:42:20,747 --> 00:42:23,375
にどど ほしが
みられなくなってしまう

853
00:42:34,719 --> 00:42:35,929
どうしたら…

854
00:42:36,429 --> 00:42:38,473
あたしひとりじゃ なにもできない

855
00:42:38,765 --> 00:42:40,934
ううん… キラリといっしょでも――

856
00:42:41,017 --> 00:42:43,895
ちっぽけな ちからしか
だせないかもしれない

857
00:42:43,979 --> 00:42:45,230
でも…

858
00:42:45,313 --> 00:42:47,607
でも あたし
キラリを しんじてる

859
00:42:47,691 --> 00:42:48,608
ハッ

860
00:42:49,567 --> 00:42:51,653
うん　いきましょう キララ

861
00:42:51,736 --> 00:42:56,574
♪～

862
00:42:57,325 --> 00:43:00,161
(キラリ･キララ)
ほしよ　わたしたちに ちからを！

863
00:43:00,370 --> 00:43:02,247
わたしたちに ひかりを！

864
00:43:07,711 --> 00:43:08,878
それーっ！

865
00:43:13,300 --> 00:43:14,634
(クリームパンダ) うわあ

866
00:43:14,968 --> 00:43:16,386
あったか～い

867
00:43:24,936 --> 00:43:26,938
えいっ　あきらめるもんか

868
00:43:27,022 --> 00:43:28,565
さいごまで がんばるんだ

869
00:43:30,608 --> 00:43:31,651
うっ あっ

870
00:43:31,735 --> 00:43:32,694
あっ

871
00:43:33,653 --> 00:43:34,654
ええっ

872
00:43:36,990 --> 00:43:38,533
キララちゃん キラリちゃん

873
00:43:46,833 --> 00:43:47,917
(メロンパンナ) うわあっ

874
00:43:52,213 --> 00:43:53,548
(クリームパンダ) ああっ
(メロンパンナ) にげて！

875
00:43:55,800 --> 00:43:56,843
(クリームパンダ･メロンパンナ)
うわっ！

876
00:44:04,225 --> 00:44:06,353
(ふたり) うう～ん　キャッ！

877
00:44:06,853 --> 00:44:07,687
あっ

878
00:44:09,898 --> 00:44:10,732
(アンパンマン) うっ

879
00:44:11,733 --> 00:44:16,404
(だだんだん) ダダン ダーン！

880
00:44:24,329 --> 00:44:25,330
うん

881
00:44:25,830 --> 00:44:27,332
いきましょう いっしょに

882
00:44:37,300 --> 00:44:39,636
(だだんだん) ダダン ダーン！

883
00:44:39,719 --> 00:44:40,887
(アンパンマン) わあーっ

884
00:44:40,970 --> 00:44:42,806
キララちゃん！ キラリちゃん！

885
00:44:47,185 --> 00:44:48,228
(キララ･キラリ) キャーッ！

886
00:44:51,189 --> 00:44:52,690
(アンパンマン) ふっ！ ぐっ ぐうっ

887
00:44:53,108 --> 00:44:56,277
(だだんだん) ダダンダーン！

888
00:44:58,530 --> 00:45:00,448
(メロンパンナ) あっ！
(クリームパンダ) デビルスターが！

889
00:45:00,532 --> 00:45:01,408
(くまの おとうさん)
もどっていくぞ！

890
00:45:01,491 --> 00:45:03,952
(まちのひとたち)
アンパンマン がんばれ！

891
00:45:08,748 --> 00:45:11,000
(だだんだん) ダダンダーン！

892
00:45:13,545 --> 00:45:17,799
ダーア… ン…

893
00:45:20,176 --> 00:45:21,136
だだんだん！

894
00:45:24,347 --> 00:45:26,099
だあっ　ああっ

895
00:45:26,599 --> 00:45:27,642
わあっ

896
00:45:27,725 --> 00:45:29,853
キララちゃん！ キラリちゃーん！

897
00:45:29,936 --> 00:45:34,107
～♪

898
00:45:37,944 --> 00:45:39,237
ああっ ふっ！

899
00:45:50,290 --> 00:45:52,917
ほしのひかり ほしのちからだ

900
00:45:53,001 --> 00:45:55,670
げんきが ゆうきが わいてきたぞ

901
00:45:59,632 --> 00:46:03,052
スターライト･アンパーンチ！

902
00:46:03,136 --> 00:46:05,597
(こだま) アンパーンチ

903
00:46:29,370 --> 00:46:30,371
(ふたり) ああっ

904
00:46:32,123 --> 00:46:33,082
(みんな) ああ～っ

905
00:46:36,252 --> 00:46:37,212
(すなおとこ) ん？

906
00:46:38,630 --> 00:46:39,964
(パイナップルマン) お… アタッ
(パインちゃん) あっ

907
00:46:43,301 --> 00:46:48,598
(みんなの よろこぶこえ)

908
00:46:51,684 --> 00:46:54,312
ホラ ホラ ホラ ホラ エヘ ホラ

909
00:46:54,395 --> 00:46:56,564
どうして あんたが いるのよ！

910
00:46:57,565 --> 00:46:58,691
(ホラーマン) ホラ～

911
00:47:00,318 --> 00:47:02,237
うぐっ　もどったぞ

912
00:47:04,948 --> 00:47:06,074
ん？ ハヒ！

913
00:47:08,660 --> 00:47:09,869
(バタコたち) わあっ

914
00:47:09,953 --> 00:47:11,120
(しょくぱんまん) うっ うん？
(カレーパンマン) ああっ！

915
00:47:11,371 --> 00:47:12,288
(クリームパンダ) みんな！

916
00:47:12,372 --> 00:47:14,541
(メロンパンナ)
よかったわ　もとに もどって

917
00:47:15,041 --> 00:47:16,751
(チーズ) アンアン
(カレーパンマンたち) ん？

918
00:47:21,047 --> 00:47:22,882
(しょくぱんまん･カレーパンマン)
アンパンマン！

919
00:47:24,592 --> 00:47:26,928
(メロンパンナ) ねえ
キララちゃんとキラリちゃんは？

920
00:47:27,011 --> 00:47:28,137
(アンパンマン) えっ

921
00:47:28,388 --> 00:47:29,347
う～ん…

922
00:47:30,139 --> 00:47:32,684
(メロンパンナ) まさか
デビルスターと いっしょに？

923
00:47:32,767 --> 00:47:35,395
(クリームパンダ)
そんな… そんな そんな！

924
00:47:35,478 --> 00:47:36,896
うそでしょう…

925
00:47:44,237 --> 00:47:45,613
でも…

926
00:47:51,119 --> 00:47:52,662
(カバお) あっ いちばんぼしだ！

927
00:47:52,745 --> 00:47:54,706
(ちびぞう) はくちょうざに ことざ

928
00:47:54,789 --> 00:47:57,166
こぐまざも みえてきたぞう

929
00:47:57,834 --> 00:48:00,003
(ピョンきち) みて！ ながれぼしだよ

930
00:48:00,086 --> 00:48:02,505
(ウサこ) ほら あっちにも！
(みみ) ステキ

931
00:48:09,262 --> 00:48:10,305
あっ

932
00:48:22,567 --> 00:48:25,069
キララちゃん キラリちゃん

933
00:48:25,361 --> 00:48:29,198
ずーっと かんじてたよ
ぼくのむねに

934
00:48:30,950 --> 00:48:31,909
(ふたり) うん

935
00:48:32,327 --> 00:48:34,370
(ヒヤリ) う～ん わからん

936
00:48:34,454 --> 00:48:37,206
なぜ ジャイアントだだんだんが
やぶれたのか――

937
00:48:37,290 --> 00:48:39,042
さっぱり わからん

938
00:48:39,125 --> 00:48:42,462
フン！ こころなんて
よけいなものを のっけたからだよ

939
00:48:42,545 --> 00:48:43,963
んんっ なんじゃと！

940
00:48:44,047 --> 00:48:44,964
(ばいきんまん) フンだっ！

941
00:48:46,090 --> 00:48:46,924
このっ！

942
00:48:47,050 --> 00:48:48,635
(ドキン) ふあ～あ

943
00:48:48,718 --> 00:48:51,262
ホラーマン あとは よろしくね～

944
00:48:51,346 --> 00:48:52,680
(ホラーマン) はい はい はい はい

945
00:48:52,764 --> 00:48:55,183
ドキンちゃんのためなら
なんでもしますよ

946
00:48:55,266 --> 00:48:56,684
ホラー　はいよーっ！

947
00:48:56,768 --> 00:48:58,353
(ばいきんまん) んなーっ！ おっと
(ヒヤリ) なにが わかる！

948
00:48:58,436 --> 00:48:59,896
(ばいきんまん) おっと！

949
00:49:00,772 --> 00:49:03,024
つぎこそ かならず やっつけてやる

950
00:49:03,066 --> 00:49:04,817
おぼえてろよ アンパンマン

951
00:49:04,901 --> 00:49:07,528
バイバイキーン！

952
00:49:09,364 --> 00:49:11,741
(アンパンマン)
ジャイアントだだんだんが？

953
00:49:11,824 --> 00:49:12,700
(キララ) うん

954
00:49:12,784 --> 00:49:14,577
まもってくれたってわけ

955
00:49:22,627 --> 00:49:25,713
(ふたり) だだんだーん！

956
00:49:30,301 --> 00:49:31,886
(バタコ) しんじられないわ

957
00:49:31,969 --> 00:49:34,555
ばいきんまんと ドクター･ヒヤリの
つくったメカが――

958
00:49:34,639 --> 00:49:38,101
ふたりを… ううん
みんなを まもるなんて

959
00:49:38,184 --> 00:49:39,560
(チーズ) ア～ン

960
00:49:39,644 --> 00:49:43,481
(ジャム) ひょっとすると
めばえたのかも しれないねえ

961
00:49:43,564 --> 00:49:47,276
ジャイアントだだんだんに
ほんとうの こころが

962
00:49:47,944 --> 00:49:49,904
ほんとうの こころか…

963
00:50:00,998 --> 00:50:08,005
♪～

964
00:51:13,362 --> 00:51:20,369
～♪

