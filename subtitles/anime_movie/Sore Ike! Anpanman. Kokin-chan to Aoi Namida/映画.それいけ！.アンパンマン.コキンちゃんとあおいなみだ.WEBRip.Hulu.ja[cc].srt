1
00:00:05,005 --> 00:00:12,012
♪～

2
00:00:43,294 --> 00:00:45,880
(しんぞうの おと)

3
00:01:12,907 --> 00:01:14,408
(アンパンマン)
うーわっ！

4
00:01:14,492 --> 00:01:16,118
なんだろう？

5
00:01:16,660 --> 00:01:23,667
～♪

6
00:01:23,751 --> 00:01:25,211
あっ…

7
00:01:25,294 --> 00:01:26,128
わっ

8
00:01:26,212 --> 00:01:27,671
んん？ うわあ！

9
00:01:30,758 --> 00:01:33,886
わっ　よっ　ああっ

10
00:01:35,638 --> 00:01:37,014
あぶなーい！

11
00:01:37,848 --> 00:01:39,016
(たまごのからが われるおと)

12
00:01:39,099 --> 00:01:40,267
あっ　うわあっ！

13
00:01:40,976 --> 00:01:43,479
(コキンちゃん) えーん えーん！

14
00:01:43,562 --> 00:01:45,189
(アンパンマン) うわあ

15
00:01:45,272 --> 00:01:47,024
もう だいじょうぶだよ

16
00:01:47,107 --> 00:01:48,901
(コキン) え～ん

17
00:01:48,984 --> 00:01:50,736
(アンパンマン) ねえ なかないで

18
00:01:50,820 --> 00:01:52,780
ぼく アンパンマン
きみは？

19
00:01:52,863 --> 00:01:54,657
(コキン) え～ん

20
00:01:54,740 --> 00:01:55,866
(アンパンマン) こまったなあ

21
00:01:55,950 --> 00:01:58,035
どうしたら
なきやんでくれるんだろう？

22
00:01:58,661 --> 00:02:02,289
コキンちゃん おなかペコペコなの
えーん

23
00:02:02,373 --> 00:02:03,874
(アンパンマン)
コキンちゃんっていうんだね

24
00:02:03,958 --> 00:02:05,918
ぼくのかおを たべるといいよ

25
00:02:06,001 --> 00:02:07,044
はい

26
00:02:07,753 --> 00:02:10,714
うわーん　もぐもぐ…

27
00:02:10,798 --> 00:02:12,258
おいし～！

28
00:02:12,341 --> 00:02:13,175
よかったあ

29
00:02:13,259 --> 00:02:15,553
(コキン) あ～ん あ～ん
(アンパンマン) え？

30
00:02:15,928 --> 00:02:19,056
コキンちゃん
もっともっと たべたーい！

31
00:02:19,348 --> 00:02:21,058
あーん　おいし おいし

32
00:02:21,141 --> 00:02:23,060
あーん　おいし おいし おいし

33
00:02:23,143 --> 00:02:24,854
(コキン) あーん
(アンパンマン) ああっ ああ…

34
00:02:24,937 --> 00:02:27,273
(コキン) あーん　もぐもぐ…

35
00:02:27,356 --> 00:02:30,359
(アンパンマン)
かおがねれて ちからが でない…

36
00:02:30,442 --> 00:02:31,569
ああ…

37
00:02:31,944 --> 00:02:33,320
あーん

38
00:02:34,321 --> 00:02:35,781
ああ おいしかった！

39
00:02:35,865 --> 00:02:37,241
ありがとねー

40
00:02:37,324 --> 00:02:39,285
ばいばいきーん

41
00:02:39,368 --> 00:02:43,956
(しょくぱんまんの はなうた)

42
00:02:44,039 --> 00:02:45,165
(しょくぱんまん) ん？

43
00:02:45,749 --> 00:02:47,042
アンパンマン

44
00:02:48,377 --> 00:02:51,672
(てんどんまん)
♪ てんてんどんどん てんどんどん

45
00:02:51,755 --> 00:02:53,966
(カツドンマン)
♪ くろぶた おにくを パンこで つつみ

46
00:02:54,049 --> 00:02:56,802
(かまめしどん)
♪ かまかま～どんどん
 かま～どんどん～

47
00:02:56,886 --> 00:02:58,178
(コキン) アハハハハッ

48
00:02:58,262 --> 00:02:59,096
(かまめしどん) ん？

49
00:02:59,179 --> 00:03:01,765
(カツドンマン･てんどんまん) ん？
(コキン) アハハハッ

50
00:03:01,849 --> 00:03:03,350
(てんどんまん)
なにが おかしいんざんすか？

51
00:03:03,893 --> 00:03:06,687
(コキン) だって！
だって だって… へんなうた！

52
00:03:06,770 --> 00:03:08,230
(てんどんまんトリオ) へんなうた？
(コキン) アハハハハッ

53
00:03:08,314 --> 00:03:10,065
(コキン) ん？
(てんどんまんトリオ) んん？

54
00:03:11,400 --> 00:03:14,028
(コキン) おこったかおも おっかしー
アハハハッ！

55
00:03:14,111 --> 00:03:16,447
(てんどんまんトリオ)
むっ　なんだってー！

56
00:03:16,530 --> 00:03:18,699
(コキン) わ～ん わ～ん

57
00:03:18,782 --> 00:03:19,617
(てんどんまんトリオ) ええ！

58
00:03:20,075 --> 00:03:21,827
(てんどんまん)
むきに なりすぎたざんす

59
00:03:21,911 --> 00:03:23,287
(カツドンマン) アイム ソーリー

60
00:03:23,370 --> 00:03:25,623
(かまめしどん) なきやんでけろ～

61
00:03:25,706 --> 00:03:27,666
(コキン) え～ん え～ん え～ん

62
00:03:27,750 --> 00:03:30,127
(かまめしどん) うう… ひっ

63
00:03:30,210 --> 00:03:31,378
わ～ん

64
00:03:31,462 --> 00:03:32,296
(カツドンマン･てんどんまん) ええ？

65
00:03:32,379 --> 00:03:33,631
(ドキン) ん？

66
00:03:33,714 --> 00:03:35,132
(かまめしどん) わ～ん

67
00:03:35,215 --> 00:03:36,425
(てんどんまん)
どうして ないてるざんす？

68
00:03:36,508 --> 00:03:37,885
(かまめしどん) なに いってんだ！

69
00:03:37,968 --> 00:03:40,304
おら ないてなんか… あー！

70
00:03:40,387 --> 00:03:42,848
(カツドンマン)
ないてるじゃないですかー

71
00:03:42,932 --> 00:03:46,644
なしてか
かってに なみだがでてきて

72
00:03:47,895 --> 00:03:49,647
(コキン) あー おもしろかった

73
00:03:49,730 --> 00:03:50,648
じゃねー

74
00:03:50,731 --> 00:03:52,608
(かまめしどん) うわ～ん

75
00:03:53,025 --> 00:03:55,653
あれ？ おら どうしたんだ？

76
00:03:55,736 --> 00:03:59,782
(ばいきんまんの いびき)
(コキン) ランララララ ラランララ♪

77
00:04:01,575 --> 00:04:02,409
(コキン) ん？

78
00:04:02,743 --> 00:04:05,746
ん～？
なにー？ なにー？

79
00:04:05,829 --> 00:04:06,830
あっ

80
00:04:07,539 --> 00:04:08,499
ん？

81
00:04:09,375 --> 00:04:10,250
ん？

82
00:04:10,334 --> 00:04:13,045
わ～い　とんだ とんだー！

83
00:04:13,420 --> 00:04:17,341
(エンジンの おと)

84
00:04:18,175 --> 00:04:19,510
(ばいきんまん) んっ…

85
00:04:19,593 --> 00:04:20,844
あー！

86
00:04:21,345 --> 00:04:23,806
だれだ！ おれさまのＵＦＯ…

87
00:04:23,889 --> 00:04:24,807
んおっ？

88
00:04:26,100 --> 00:04:28,018
(コキン) アハハハッ！
(ばいきんまん) わあー！

89
00:04:28,602 --> 00:04:29,603
イテッ

90
00:04:29,979 --> 00:04:33,273
あっ かえせー！
もどってこーい！

91
00:04:34,066 --> 00:04:35,150
(コキン) ラン ラン ラン ラ～ッ！

92
00:04:35,234 --> 00:04:38,070
(ばいきんまん) ええっ うわああー！

93
00:04:38,153 --> 00:04:40,030
(コキン) アハハハッ

94
00:04:40,114 --> 00:04:40,948
(ばいきんまん) くるな！

95
00:04:41,323 --> 00:04:43,450
おもしろーい　ポチッ

96
00:04:43,534 --> 00:04:45,244
(コキン) わ～い！

97
00:04:45,327 --> 00:04:48,914
(コキン) ドーン ドーン ドーン
(ばいきんまん) わーっ あっ ハア ハア

98
00:04:48,998 --> 00:04:50,708
わーっ うおっ うわああ！

99
00:04:51,458 --> 00:04:52,626
うわー！

100
00:04:52,710 --> 00:04:54,628
(コキン) ジャーンプ！

101
00:04:55,421 --> 00:04:57,006
(コキン) あちょー

102
00:04:57,089 --> 00:04:59,133
(ばいきんまん) わわわっ　うおーっと

103
00:04:59,216 --> 00:05:00,843
(コキン) わ～い　アハハッ

104
00:05:00,926 --> 00:05:02,052
(ばいきんまん) わわわっ

105
00:05:02,136 --> 00:05:03,345
(コキン) アハハハハッ

106
00:05:03,762 --> 00:05:04,722
アタッ

107
00:05:04,930 --> 00:05:06,724
ハア ハア…

108
00:05:06,807 --> 00:05:08,934
(ばいきんまん) ヒイ ハア ハア…
(コキン) たのし～！

109
00:05:09,018 --> 00:05:10,477
(ばいきんまん)うおっ おっ おっ？

110
00:05:10,561 --> 00:05:12,521
(ぶつかった おと)

111
00:05:12,604 --> 00:05:14,106
んがー！

112
00:05:20,029 --> 00:05:21,488
あーあ　こわれちゃった

113
00:05:22,031 --> 00:05:23,073
えいっ　つまんないの

114
00:05:23,157 --> 00:05:24,324
(ばいきんまん) わー！

115
00:05:24,408 --> 00:05:25,951
おれさまのＵＦＯが！

116
00:05:26,035 --> 00:05:27,619
もっと あそびたかったのに

117
00:05:27,703 --> 00:05:28,912
(ばくはつの おと)

118
00:05:28,996 --> 00:05:30,497
(ばいきんまん) むー…

119
00:05:30,789 --> 00:05:31,999
コラーッ！

120
00:05:32,332 --> 00:05:33,584
ん？ なに？

121
00:05:33,667 --> 00:05:35,127
“なに？”じゃない！

122
00:05:35,210 --> 00:05:36,920
よくも よくも おまえは！

123
00:05:37,004 --> 00:05:39,840
(コキン) うえ～ん うわ～ん うわ～ん
(ばいきんまん) えっ？

124
00:05:39,923 --> 00:05:42,885
あっ… いやいや
なかなくても…

125
00:05:42,968 --> 00:05:44,511
よわったなあ…

126
00:05:45,304 --> 00:05:46,930
(ドキンちゃん)
なにやってるの？ ばいきんまん

127
00:05:47,014 --> 00:05:49,349
んあ！
きいてよ ドキンちゃん

128
00:05:49,433 --> 00:05:51,226
えーん… おねえちゃん！

129
00:05:51,310 --> 00:05:52,352
ん？ ええ？

130
00:05:52,436 --> 00:05:53,270
(コキン) あ…

131
00:05:53,353 --> 00:05:54,938
(コキン) うわ～ん わ～ん

132
00:05:55,022 --> 00:05:56,607
(ドキン) コキンちゃん

133
00:05:56,690 --> 00:05:59,318
(コキン) わ～ん わ～ん

134
00:05:59,401 --> 00:06:00,944
(ドキン) うそなきは やめなさい

135
00:06:01,028 --> 00:06:02,780
(コキン) はーい
(ばいきんまん) え！ うそなき？

136
00:06:02,863 --> 00:06:03,781
ええっ…

137
00:06:03,864 --> 00:06:05,783
(ドキン)
どうして こんなとこにいるの？

138
00:06:06,325 --> 00:06:07,493
あそびにきちゃった

139
00:06:07,576 --> 00:06:10,370
(ばいきんまん) えー！
ドキンちゃんの いもうと？

140
00:06:10,454 --> 00:06:11,288
(コキン) うん

141
00:06:11,538 --> 00:06:12,873
えっ ええ

142
00:06:12,956 --> 00:06:15,542
コキンちゃん
うそなきの めいじんなの

143
00:06:15,626 --> 00:06:16,794
エへヘヘッ

144
00:06:21,381 --> 00:06:28,388
(ファンファーレの おと)

145
00:06:30,015 --> 00:06:31,225
(ホラーマン) ホラー！

146
00:06:31,308 --> 00:06:34,019
これより バイキンせいから
あそびにきてくれた――

147
00:06:34,103 --> 00:06:37,314
コキンちゃんの
かんげいパーティーをはじめまーす

148
00:06:37,397 --> 00:06:39,817
(かびるんるんの よろこぶこえ)

149
00:06:39,900 --> 00:06:44,071
♪～

150
00:06:53,163 --> 00:06:56,333
♪ あおいなみだの コキンちゃん

151
00:06:56,583 --> 00:06:59,586
♪ ウソ泣き上手の 泣きまねで

152
00:06:59,920 --> 00:07:02,840
♪ あおいなみだを こぼしたら

153
00:07:03,215 --> 00:07:06,802
♪ 悲しくないのに 泣けてくる

154
00:07:09,096 --> 00:07:12,099
(コキン) エ～ン エ～ン エ～ン

155
00:07:12,349 --> 00:07:15,561
♪ コキン コキン　コキンちゃん

156
00:07:15,644 --> 00:07:19,982
♪ あおいなみだ あ･あ･あ･あ

157
00:07:23,944 --> 00:07:25,362
(ばいきんまん) うわああ！

158
00:07:27,197 --> 00:07:28,866
(ホラーマン) ホラ～！

159
00:07:30,617 --> 00:07:32,119
(ふたり) ああ…

160
00:07:32,202 --> 00:07:36,373
～♪

161
00:07:37,332 --> 00:07:38,876
(ジャムおじさん)
あたらしい かおだよ

162
00:07:42,296 --> 00:07:44,131
げんき100ばい　アンパンマン

163
00:07:45,215 --> 00:07:46,800
(アンパンマン)
ありがとうございます

164
00:07:46,884 --> 00:07:50,137
(しょくぱんまん)
アンパンマンが あったっていう
コキンちゃんって おんなのこ…

165
00:07:50,220 --> 00:07:54,016
(バタコさん)
ないてたのに ケロッとなきやんで
いなくなったんでしょ？

166
00:07:54,099 --> 00:07:56,894
(ジャム) うーん
はじめてきく なまえだねえ

167
00:07:56,977 --> 00:07:58,145
(チーズ) アン アン

168
00:07:58,520 --> 00:08:00,647
(３にん) んん…

169
00:08:02,024 --> 00:08:04,151
(コキン) ランララララ ララララン♪

170
00:08:05,235 --> 00:08:06,153
ん？

171
00:08:06,820 --> 00:08:08,655
んん… イヤアッ！

172
00:08:09,698 --> 00:08:12,159
わあ～っ
おねえちゃんのへやだ～！

173
00:08:12,242 --> 00:08:14,161
へえ～　んっ？

174
00:08:14,578 --> 00:08:17,206
わあ～ かわいい～！

175
00:08:19,583 --> 00:08:21,251
(ドキン)
ねえねえ コキンちゃんは？

176
00:08:21,335 --> 00:08:22,169
(ばいきんまん･ホラーマン) え？

177
00:08:22,252 --> 00:08:23,837
(コキン) ランラララ♪
(ばいきんまん) あっ いた！

178
00:08:23,921 --> 00:08:24,755
(コキン) ん？

179
00:08:24,838 --> 00:08:26,590
(ドキン) あっ
それは わたしの！

180
00:08:26,673 --> 00:08:27,633
コキンちゃん これ――

181
00:08:27,716 --> 00:08:29,176
きにいっちゃったんだ
もーん

182
00:08:29,259 --> 00:08:30,344
(ドキン) かえしなさーい！

183
00:08:30,427 --> 00:08:32,221
はやくコキンちゃん
つれてきて！

184
00:08:32,304 --> 00:08:33,555
(コキン) ランララララ♪

185
00:08:33,639 --> 00:08:36,225
(ホラーマン)
まってください コキンちゃん！

186
00:08:36,308 --> 00:08:38,352
(コキン) やっだよー！
アハハッ

187
00:08:38,435 --> 00:08:40,312
ランララララララ♪

188
00:08:40,395 --> 00:08:42,231
(ばいきんまんたち) うわっ うわああ！

189
00:08:42,314 --> 00:08:43,815
(コキン) ランララララ♪

190
00:08:43,899 --> 00:08:44,733
(ばいきんまん) まてー！

191
00:08:46,526 --> 00:08:47,444
(コキン) えいっ

192
00:08:48,237 --> 00:08:50,989
(ばいきんまんたち)
ハアッ ハアッ うわー！

193
00:08:51,073 --> 00:08:52,532
(コキン) ばいばいきーん

194
00:08:54,493 --> 00:08:56,453
(ばいきんまんたち) ハア ハア…

195
00:08:56,870 --> 00:09:00,207
(ばいきんまん) むうっ！
みつけたら おしりペンペンだ！

196
00:09:00,290 --> 00:09:01,333
ウフフッ

197
00:09:04,920 --> 00:09:06,672
(ロボットが うごきだす おと)

198
00:09:06,755 --> 00:09:07,631
(ばいきんまんたち) えっ？

199
00:09:07,714 --> 00:09:08,882
(ホラーマン) ホラ？

200
00:09:09,549 --> 00:09:11,260
コキンちゃんが のってます

201
00:09:11,593 --> 00:09:14,179
わーい！
うごいた うごいた～

202
00:09:14,263 --> 00:09:16,640
ところで ばいきんまん
あれ なんです？

203
00:09:16,723 --> 00:09:19,017
かいはつちゅうの
ボーリングロボットだ

204
00:09:19,101 --> 00:09:21,687
そのロボットが
ボールをもってるってことは…

205
00:09:21,770 --> 00:09:23,230
(かびるんるんたち) カビー！

206
00:09:23,313 --> 00:09:25,774
(ばいきんまん) にげろー！
(ホラーマン) ホラー！

207
00:09:25,941 --> 00:09:27,859
(ばいきんまん) うわ～っ

208
00:09:27,943 --> 00:09:28,777
(ホラーマン) うわあ！

209
00:09:29,611 --> 00:09:31,071
ああー！

210
00:09:31,154 --> 00:09:31,989
わあ！

211
00:09:32,739 --> 00:09:33,949
ぐえっ

212
00:09:34,032 --> 00:09:35,951
ぐぐぐぐぐ…

213
00:09:36,034 --> 00:09:37,452
わーい おもしろかった

214
00:09:37,536 --> 00:09:38,870
(ホラーマン) ホラッ！

215
00:09:38,954 --> 00:09:40,747
(コキン) なにすんのよー！

216
00:09:40,831 --> 00:09:42,249
(ばいきんまん) やっと つかまえたぞ

217
00:09:42,332 --> 00:09:44,543
(コキン) はなしてよー！

218
00:09:44,626 --> 00:09:48,005
(コキン) うえ～ん うわ～ん うわ～ん

219
00:09:48,088 --> 00:09:50,007
(ばいきんまん)
ヘンッ！ だまされないぞ

220
00:09:50,799 --> 00:09:52,884
うそなきしても ダメなんだからな！

221
00:09:52,968 --> 00:09:55,012
(なみだが あたったおと)
(ばいきんまん) えっ？ あっ？

222
00:09:55,387 --> 00:09:57,097
(ばいきんまん) お～い おいおい

223
00:09:57,180 --> 00:09:58,557
(ホラーマン) どうしたんですか？

224
00:09:58,640 --> 00:09:59,474
(ばいきんまん) なにが？

225
00:09:59,558 --> 00:10:01,018
(ホラーマン)
ないているじゃありませんか

226
00:10:01,101 --> 00:10:02,060
(コキン) フフーン

227
00:10:02,144 --> 00:10:06,606
(ばいきんまんと コキンの なきごえ)

228
00:10:06,690 --> 00:10:07,983
(ホラーマン) うっ

229
00:10:08,066 --> 00:10:10,652
(ホラーマン) ホラ～ ホラホラ～

230
00:10:10,736 --> 00:10:11,695
どうしたんでしょ

231
00:10:11,778 --> 00:10:14,865
かなしくもないのに
なみだがとまりま… うううっ

232
00:10:14,948 --> 00:10:15,782
ホラ～

233
00:10:15,866 --> 00:10:18,201
(コキン) ばいばいきーん

234
00:10:18,285 --> 00:10:20,620
もう どこ いっちゃたのよ

235
00:10:20,704 --> 00:10:22,748
コキンちゃんも
ばいきんまんたちも！

236
00:10:22,831 --> 00:10:26,251
(ばいきんまんの なきごえ)
(ドキン) えっ なに？

237
00:10:26,335 --> 00:10:29,421
(ばいきんまんたちの なきごえ)
(ドキン) ええー！

238
00:10:32,591 --> 00:10:34,217
(ドキン) もう なんなの これは！

239
00:10:34,301 --> 00:10:37,304
(ばいきんまん) コキンちゃんが
うそなきしたら きゅうに

240
00:10:37,387 --> 00:10:39,431
(ドキン) あのなみだには
かなしくもないのに――

241
00:10:39,514 --> 00:10:41,725
ひとを なかせる ちからが
あるのよ！

242
00:10:41,808 --> 00:10:43,685
(ばいきんまん) えっ そうなの？

243
00:10:43,769 --> 00:10:45,645
(コキン) でかけてくるねー

244
00:10:45,729 --> 00:10:47,731
(ドキン)ちょっ ちょっと
あたしのＵＦＯ！

245
00:10:47,814 --> 00:10:49,358
はやく コキンちゃん おって！

246
00:10:49,441 --> 00:10:50,525
(ばいきんまん) あっ はい！

247
00:10:52,736 --> 00:10:54,529
(コキン) レッツ ゴー！

248
00:10:54,613 --> 00:10:57,366
(フラワーマン)
♪ フラワー フラワー

249
00:10:57,449 --> 00:11:00,452
♪ オー ソーレ ミーオー

250
00:11:00,535 --> 00:11:03,747
♪ オ ソーレ ミーオー

251
00:11:03,830 --> 00:11:06,458
ほれ みよー♪

252
00:11:06,541 --> 00:11:08,335
フラワーマンが そだてた♪

253
00:11:08,418 --> 00:11:13,548
いろとりどりの
うつくしいフラワーたちを～♪

254
00:11:13,965 --> 00:11:15,467
(コキン) バビューン！
(フラワーマン) なに！

255
00:11:15,550 --> 00:11:16,635
(コキン) ビューン

256
00:11:16,718 --> 00:11:18,303
(コキン) ヤッホー！
(フラワーマン) えっ！

257
00:11:19,137 --> 00:11:21,556
えっ　えっ　えっ

258
00:11:21,640 --> 00:11:24,351
キャー！ なにすんのよー！

259
00:11:24,434 --> 00:11:26,353
あー おもしろかった！

260
00:11:26,436 --> 00:11:28,063
こんどは どこいこっかなー

261
00:11:28,355 --> 00:11:30,065
みつけたぞー！

262
00:11:30,148 --> 00:11:31,191
(コキン) ビューンッ

263
00:11:31,274 --> 00:11:32,317
(ばいきんまん) つかまえた！

264
00:11:32,609 --> 00:11:34,444
イヤッ はなしてよー！

265
00:11:34,528 --> 00:11:36,071
(カレーパンマン) コラーッ！
(ふたり) んっ？

266
00:11:36,154 --> 00:11:38,824
(カレーパンマン) まちの いたずらは
ばいきんまんの しわざか！

267
00:11:38,907 --> 00:11:40,075
ええっ！ ちっ ちが…

268
00:11:40,158 --> 00:11:42,702
そうなの！
ばいきんまんがやったの！

269
00:11:42,786 --> 00:11:44,413
こんどは
コキンちゃんをいじめるのー！

270
00:11:44,496 --> 00:11:46,331
なっ なに～！

271
00:11:46,581 --> 00:11:48,917
こんな ちいさな おんなのこまで
なかせて

272
00:11:49,000 --> 00:11:49,960
ゆるさないぞー！

273
00:11:50,043 --> 00:11:52,462
わーっ！
ちょっと まったー！

274
00:11:52,754 --> 00:11:54,881
カレーパーンチ！

275
00:11:55,298 --> 00:11:59,094
(ばいきんまん)
だから ちがうんだってー！

276
00:12:00,303 --> 00:12:02,514
へへーん　どんなもんだい

277
00:12:02,597 --> 00:12:03,974
もう だいじょうぶだぜ！

278
00:12:04,057 --> 00:12:04,891
あっそ

279
00:12:04,975 --> 00:12:06,435
(アンパンマン) コキンちゃん
(コキン) ん？

280
00:12:06,518 --> 00:12:08,603
(しょくぱんまん)
まちのみんなが こまってますよ

281
00:12:08,687 --> 00:12:09,771
(メロンパンナ) いたずらは やめて

282
00:12:09,855 --> 00:12:10,689
(カレーパンマン) ええっ

283
00:12:10,772 --> 00:12:13,066
あれは ばいきんまんの
しわざじゃないのか

284
00:12:13,150 --> 00:12:14,067
(しょくぱんまん) ええ

285
00:12:14,151 --> 00:12:15,068
(カレーパンマン) あっちゃー

286
00:12:15,152 --> 00:12:16,987
(メロンパンナ)
あやまりに いきましょうよ

287
00:12:17,279 --> 00:12:18,238
(コキン) なによー！

288
00:12:18,321 --> 00:12:20,282
コキンちゃん
ドライブしてただけだもん！

289
00:12:20,365 --> 00:12:21,491
ベーッ！ フンッ

290
00:12:22,242 --> 00:12:23,535
(アンパンマン) コキンちゃん！

291
00:12:23,618 --> 00:12:24,494
あ…

292
00:12:25,537 --> 00:12:26,955
プンプンだ

293
00:12:27,038 --> 00:12:30,333
あっ！
どうなっても しらないんだから

294
00:12:30,417 --> 00:12:33,086
うわ～ん うわ～ん

295
00:12:33,170 --> 00:12:37,257
うわ～ん うわ～ん

296
00:12:37,340 --> 00:12:39,050
(でかこかあさん)
あら？ あめかしら？

297
00:12:39,134 --> 00:12:40,051
(ふたり) うっ

298
00:12:40,135 --> 00:12:44,014
うわ～ん ううっ うわ～ん

299
00:12:44,097 --> 00:12:45,515
(フラワーマン)
なぜ ないてるのかしら？

300
00:12:45,599 --> 00:12:47,434
わからないのよー！

301
00:12:47,517 --> 00:12:48,810
(フラワーマン) はあ？

302
00:12:48,894 --> 00:12:51,771
お～い おいおい おいおい

303
00:12:51,855 --> 00:12:55,734
(まちのひとたちの なきごえ)

304
00:12:56,026 --> 00:12:57,777
(しょくぱんまん)
たいへんなことになりましたね

305
00:12:58,236 --> 00:13:00,238
(アンパンマン) てわけして
コキンちゃんをさがそう

306
00:13:00,322 --> 00:13:01,156
(しょくぱんまんたち) うん

307
00:13:03,742 --> 00:13:05,368
(カバお) やー！ フッ

308
00:13:05,452 --> 00:13:06,286
(こどもたち) わー！

309
00:13:06,369 --> 00:13:08,705
(コキン) え～ん え～んえん

310
00:13:08,830 --> 00:13:10,790
(こどもたちの なきごえ)

311
00:13:10,874 --> 00:13:11,875
(カバお) わ～ん

312
00:13:11,958 --> 00:13:15,670
(みみせんせい) へんね
なみだが とまらないわ～

313
00:13:15,754 --> 00:13:17,797
(コキン) え～んえん えんえん

314
00:13:17,881 --> 00:13:19,382
(バタコ･チーズ) ん？
(ジャム) お？

315
00:13:19,466 --> 00:13:21,176
(３にん) え～ん え～ん

316
00:13:21,259 --> 00:13:23,136
(てんどんまん)
いや おかしかったざんすねえ――

317
00:13:23,220 --> 00:13:24,387
おいおい ないて

318
00:13:24,471 --> 00:13:25,722
(カツドンマン) イエス
きょうからユーは――

319
00:13:25,805 --> 00:13:27,557
なきべそ かまめしどんです

320
00:13:27,641 --> 00:13:29,434
(てんどんまん･カツドンマン)
アハハハッ

321
00:13:29,518 --> 00:13:30,977
(かまめしどん) もう ゆるさねえど！

322
00:13:31,061 --> 00:13:31,937
(てんどんまん･カツドンマン)
アハハハッ！

323
00:13:32,020 --> 00:13:33,855
(コキン) え～ん え～ん

324
00:13:33,939 --> 00:13:34,856
(てんどんまんトリオ) おっ？

325
00:13:34,940 --> 00:13:37,067
(どんぶりまんトリオの なきごえ)

326
00:13:37,150 --> 00:13:39,528
(かまめしどん) おめえらだって
ないてるでねーか！

327
00:13:39,611 --> 00:13:41,363
(カツドンマン)
ホワーイ なぜでしょう？

328
00:13:41,446 --> 00:13:43,782
(てんどんまん) おかしいのに
なみだが とまらないざんす

329
00:13:43,865 --> 00:13:44,866
フフーン

330
00:13:44,950 --> 00:13:46,034
(アンパンマン) コキンちゃーん

331
00:13:46,117 --> 00:13:47,661
あっ

332
00:13:47,744 --> 00:13:51,248
(どんぶりまんトリオの なきごえ)

333
00:13:51,331 --> 00:13:53,041
(アンパンマン) そっちは あぶないよ！

334
00:13:54,709 --> 00:13:56,461
(しょくぱんまん)
カレーパンマン いそいでください！

335
00:13:56,545 --> 00:13:57,837
(カレーパンマン) まってくれー！

336
00:13:57,921 --> 00:13:59,339
(カツドンマン) オー ノー！

337
00:13:59,422 --> 00:14:01,925
もう だれも おいかけてこないわ

338
00:14:02,008 --> 00:14:03,426
アンパンマンも たいしたことない…

339
00:14:03,510 --> 00:14:04,344
キャッ！

340
00:14:04,427 --> 00:14:06,012
うわあー！

341
00:14:06,096 --> 00:14:10,642
イヤー！ うわあああ～！

342
00:14:10,725 --> 00:14:12,936
イヤー！

343
00:14:13,520 --> 00:14:14,604
ううっ　なに ここ？

344
00:14:14,688 --> 00:14:16,439
(ブラックバードンのヒナ) ピイ
(コキン) えっ？

345
00:14:16,523 --> 00:14:17,524
うわああ！

346
00:14:17,607 --> 00:14:19,401
うわあああ！

347
00:14:19,901 --> 00:14:23,613
なによ～！
こっちへ こないでよー！

348
00:14:23,697 --> 00:14:24,698
うわああ！

349
00:14:24,781 --> 00:14:26,241
あああ～！

350
00:14:26,324 --> 00:14:27,909
(ブラックバードン) ギャアア

351
00:14:28,451 --> 00:14:31,162
へへ…
どうも こんにちは

352
00:14:31,246 --> 00:14:33,164
(ブラックバードン) ギャアア
(コキン) ううっ

353
00:14:33,248 --> 00:14:36,126
(コキン) イヤ～ン あ～ん
(ブラックバードン) クエ？

354
00:14:36,209 --> 00:14:39,671
(コキン) え～ん え～ん

355
00:14:39,754 --> 00:14:41,006
うう…

356
00:14:41,339 --> 00:14:42,173
ハア…

357
00:14:42,257 --> 00:14:44,718
(ブラックバードンのヒナたち)
ピッピー！ ピ～ッ

358
00:14:44,801 --> 00:14:45,635
(コキン) うわわっ

359
00:14:45,719 --> 00:14:50,599
(コキン) わ～ん わ～ん わ～ん

360
00:14:50,682 --> 00:14:53,685
(みんなの なきごえ)

361
00:14:53,768 --> 00:14:54,603
(ブラックバードン) グエ？

362
00:14:54,686 --> 00:14:55,937
グワアアッ！

363
00:14:56,021 --> 00:14:58,106
(コキン)
ちょっ ちょっと なかないでよ！

364
00:14:58,189 --> 00:15:00,775
コキンちゃんが
おこられるじゃないのー！

365
00:15:00,859 --> 00:15:03,236
グワアアアッ！

366
00:15:03,320 --> 00:15:07,365
(コキン) イヤッ　イヤッ　イヤーッ

367
00:15:07,449 --> 00:15:10,160
たすけてー！

368
00:15:10,660 --> 00:15:12,370
(アンパンマン) わあっ！
(メロンパンナ) コキンちゃんが！

369
00:15:12,454 --> 00:15:13,496
(しょくぱんまん) たいへんです！

370
00:15:13,580 --> 00:15:16,082
(カレーパンマン) ブラックバードンを
おこらせちまったみたいだぜ

371
00:15:16,166 --> 00:15:17,417
(ドキン) コキンちゃーん！

372
00:15:17,500 --> 00:15:19,169
わっ たべられちゃう！

373
00:15:19,252 --> 00:15:20,587
おれさまに まかせて！

374
00:15:20,670 --> 00:15:22,714
コキンちゃんを はなせー！

375
00:15:23,048 --> 00:15:24,424
(ばいきんまん) どりゃああ！
(アンパンマン) ばいきんまん！

376
00:15:24,799 --> 00:15:27,469
(しょくぱんまん)
これいじょう ブラックバードンを
おこらせてはいけません！

377
00:15:27,552 --> 00:15:29,638
うるさーい！

378
00:15:29,721 --> 00:15:32,390
(コキン) わあああっ
(ブラックバードン) フンッ フンッ

379
00:15:32,474 --> 00:15:33,850
(ばいきんまん) わああっ あちゃっ

380
00:15:33,933 --> 00:15:35,310
ばいばいき～ん

381
00:15:35,393 --> 00:15:36,227
ばいきんまん

382
00:15:36,311 --> 00:15:38,980
(ばいきんまん) ああああー！

383
00:15:40,231 --> 00:15:42,192
(アンパンマン)
やめるんだ ブラックバードン！

384
00:15:43,193 --> 00:15:45,111
(メロンパンナ)
おねがいだから なかないで

385
00:15:45,195 --> 00:15:48,198
もう はやくたすけてよ～！

386
00:15:48,865 --> 00:15:49,783
(ドキン) ちょっと あんた！

387
00:15:49,866 --> 00:15:52,035
コキンちゃんを はなしなさいよ！

388
00:15:52,452 --> 00:15:53,328
(ブラックバードン)
ウワアア！

389
00:15:53,411 --> 00:15:54,496
(コキン) えっ
(ドキン) えっ！

390
00:15:54,579 --> 00:15:55,413
(アンパンマンたち)
ああっ！

391
00:15:55,497 --> 00:15:56,623
(ドキン) コキンちゃん！

392
00:15:56,706 --> 00:16:01,711
イヤアアアー！

393
00:16:01,795 --> 00:16:02,796
(しょくぱんまん) ああっ！

394
00:16:06,216 --> 00:16:07,133
(ドキン) フウ…

395
00:16:07,217 --> 00:16:08,551
(コキン) おねえちゃん

396
00:16:08,635 --> 00:16:10,136
(しょくぱんまん) よかった

397
00:16:12,597 --> 00:16:13,890
(ブラックバードン) グワ！
(アンパンマン) うわあ！

398
00:16:13,973 --> 00:16:14,891
(カレーパンマン) やめろー！
(ブラックバードン) グワッ

399
00:16:14,974 --> 00:16:15,934
(アンパンマン) おちついて！

400
00:16:16,559 --> 00:16:18,853
(メロンパンナ) みて　ブラックバードン！
(ブラックバードン) グエ？

401
00:16:18,937 --> 00:16:20,355
(ブラックバードンのヒナ)
ピイ ピイ

402
00:16:20,438 --> 00:16:22,732
(メロンパンナ) ほらっ
もうだいじょうぶだから

403
00:16:22,816 --> 00:16:23,858
(ブラックバードンのヒナ) ピイ

404
00:16:24,401 --> 00:16:25,944
(ブラックバードン) ピエ ピッ ピッ

405
00:16:26,027 --> 00:16:28,405
(ブラックバードンたち)
ピイ ピイ ピイ

406
00:16:28,488 --> 00:16:29,698
(メロンパンナ) フフフッ

407
00:16:29,781 --> 00:16:30,907
よかった

408
00:16:30,990 --> 00:16:33,410
(しょくぱんまん) ブラックバードンも
おちついたみたいですね

409
00:16:33,493 --> 00:16:35,954
(カレーパンマン)
ああ　めでたし めでたしだ

410
00:16:36,037 --> 00:16:37,455
(しょくぱんまん) あとは…

411
00:16:40,542 --> 00:16:42,419
うんと… うんと…

412
00:16:42,502 --> 00:16:43,461
うーんと…

413
00:16:43,545 --> 00:16:45,004
アハハハッ

414
00:16:45,088 --> 00:16:46,548
ああ こわかった！

415
00:16:46,631 --> 00:16:47,632
なんちって

416
00:16:47,716 --> 00:16:49,509
ええっと ええっと…

417
00:16:49,592 --> 00:16:52,137
えーん えーん えーんっ

418
00:16:52,220 --> 00:16:53,972
(ドキン) コキンちゃん
(コキン) うっ

419
00:16:54,597 --> 00:16:56,224
んー？ あっ…

420
00:16:57,892 --> 00:17:00,979
もう　しんぱいばかりかけて

421
00:17:01,229 --> 00:17:02,605
おねえちゃん…

422
00:17:02,689 --> 00:17:05,150
(ドキン) でも… ぶじでよかった

423
00:17:05,525 --> 00:17:07,819
(コキン) うっ うう…

424
00:17:07,902 --> 00:17:11,197
ごめんなさい　おねえちゃーん！

425
00:17:11,281 --> 00:17:17,579
(コキンの なきごえ)

426
00:17:20,665 --> 00:17:23,626
(まちのひとたちの ざわめき)

427
00:17:23,710 --> 00:17:25,003
(みんなの なきごえ)

428
00:17:25,795 --> 00:17:28,256
いままで なんで ないてたのかしら？

429
00:17:28,339 --> 00:17:30,759
(カバおたちの なきごえ)

430
00:17:31,134 --> 00:17:32,093
(カバお) あれ？

431
00:17:32,177 --> 00:17:33,887
(みみ) あたし どうしたのかしら？

432
00:17:33,970 --> 00:17:36,389
(ジャムたちの わらいごえ)

433
00:17:36,473 --> 00:17:38,850
(バタコ) なくりゆうもないのに
ないてたなんて

434
00:17:38,933 --> 00:17:40,018
(ジャム) へんだねえ

435
00:17:40,101 --> 00:17:41,102
(チーズ) アンアン

436
00:17:41,478 --> 00:17:45,857
(どんぶりまんトリオ)
アハハハッ アハハッ

437
00:17:45,940 --> 00:17:47,108
(てんどんまん) ところで――

438
00:17:47,192 --> 00:17:49,068
どんぶりのなかで
いちばん おいしいのは――

439
00:17:49,152 --> 00:17:49,986
てんどんざんす

440
00:17:50,069 --> 00:17:50,904
(かまめしどん) なにをいうんだ

441
00:17:50,987 --> 00:17:53,031
いちばん うめえのは
おらの かまめしだべよ！

442
00:17:53,114 --> 00:17:55,533
(カツドンマン) オーノー！
カツドン イズ ナンバーワン！

443
00:17:55,617 --> 00:17:57,202
てんどんが いちばんざんす！

444
00:17:57,285 --> 00:17:58,244
(かまめしどん) かまめし！

445
00:17:58,328 --> 00:17:59,496
(カツドンマン) カツドンです！

446
00:18:03,291 --> 00:18:06,419
(コキン)
めいわくかけて ごめんなさい

447
00:18:07,921 --> 00:18:08,922
んん…

448
00:18:09,005 --> 00:18:10,298
おねえちゃん これ

449
00:18:10,381 --> 00:18:11,257
あっ

450
00:18:12,717 --> 00:18:14,511
はい　エヘへヘッ

451
00:18:14,594 --> 00:18:16,721
ううん
ほしかったら あげるわ

452
00:18:16,805 --> 00:18:17,639
(コキン) えっ？

453
00:18:18,431 --> 00:18:21,017
おねえちゃん… いいの

454
00:18:22,060 --> 00:18:23,561
(ドキン) えっ？
(コキン) だって――

455
00:18:23,645 --> 00:18:27,649
ほんもののほうが ずーっと ずーっと
ステキなんだもーん！

456
00:18:27,732 --> 00:18:29,234
(ドキン) うう…

457
00:18:29,818 --> 00:18:31,277
ダメー！

458
00:18:31,569 --> 00:18:32,529
ぜったいダメ！

459
00:18:32,612 --> 00:18:35,073
しょくぱんまんさまから
はなれなさーい！

460
00:18:35,156 --> 00:18:37,283
(コキン) イヤー！
(ドキン) はなれるの！

461
00:18:37,367 --> 00:18:39,994
(コキン) イヤー！
(ドキン) ダメ ダメ ダメー！

462
00:18:40,078 --> 00:18:41,788
(コキン) イヤだも～ん

463
00:18:43,873 --> 00:18:47,210
ホラ　わたしたちから
コキンちゃんに プレゼントです

464
00:18:47,293 --> 00:18:48,795
(カビるんるんたち) カビ カビ～

465
00:18:48,920 --> 00:18:52,215
(コキン) うわ～！
おねえちゃんと おそろいのＵＦＯだ！

466
00:18:52,298 --> 00:18:53,800
ありがとう

467
00:18:53,883 --> 00:18:55,802
(ばいきんまんたち) フフフ

468
00:18:56,302 --> 00:18:58,346
おねえちゃんとも
ひさしぶりに あえたし――

469
00:18:58,429 --> 00:18:59,973
とっても たのしかった

470
00:19:00,056 --> 00:19:01,432
また あそびにくるね

471
00:19:09,274 --> 00:19:11,401
(ばいきんまん)
コキンちゃん さよならー

472
00:19:11,484 --> 00:19:13,778
(ホラーマン)
また あいましょーね

473
00:19:13,862 --> 00:19:15,864
♪～

474
00:19:15,947 --> 00:19:17,740
きをつけて かえるのよ

475
00:19:18,241 --> 00:19:19,367
うん

476
00:19:29,002 --> 00:19:32,213
♪ あおいなみだの
コキンちゃん

477
00:19:32,297 --> 00:19:35,550
♪ うるんだ瞳は 空の色

478
00:19:35,633 --> 00:19:38,803
♪ 肩ふるわせて しのび泣き

479
00:19:38,887 --> 00:19:42,265
♪ これではだれでも
だまされる

480
00:19:44,809 --> 00:19:47,687
♪ エ～ン エ～ン エ～ン

481
00:19:48,062 --> 00:19:51,274
♪ コキン コキン
コキンちゃん

482
00:19:51,357 --> 00:19:54,652
♪ あおいなみだ
あ･あ･あ･あ

483
00:19:54,736 --> 00:19:57,655
♪ コキン コキン
コキンちゃん

484
00:19:57,989 --> 00:20:01,200
♪ あおいなみだ
あ･あ･あ･あ

485
00:20:01,284 --> 00:20:04,495
♪ コキン コキン
コキンちゃん

486
00:20:04,579 --> 00:20:11,586
♪ あおいなみだ
あ･あ･あ･あ

487
00:20:18,468 --> 00:20:19,802
(ほしが ながれるおと)

488
00:20:20,470 --> 00:20:21,304
(ふたり) ああっ

489
00:20:21,387 --> 00:20:22,347
(ジャム) おお？

490
00:20:29,520 --> 00:20:31,314
(フラワーマンたち) わあ…

491
00:20:31,397 --> 00:20:33,316
(３にん) おお～

492
00:20:33,399 --> 00:20:35,068
(みんな) おお…

493
00:20:35,860 --> 00:20:37,111
(ブラックバードンのヒナ) ンン？

494
00:20:39,822 --> 00:20:41,824
～♪

495
00:20:42,408 --> 00:20:43,993
(ジャムたち) うわああ～

496
00:20:44,077 --> 00:20:45,828
(バタコたち) きれいね
(チーズ) アンアン

497
00:20:46,412 --> 00:20:47,330
(ジャム) きっと これは――

498
00:20:47,413 --> 00:20:50,083
コキンちゃんからの
てがみじゃないかなあ

499
00:20:50,166 --> 00:20:53,419
(アンパンマン)
“また あそびにくるね”って
いってるんですね

