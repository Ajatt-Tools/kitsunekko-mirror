1
00:00:05,506 --> 00:00:08,968
(アンパンマン) こんにちは
ぼくアンパンマンです

2
00:00:09,051 --> 00:00:11,470
これからはじまる おはなしでは――

3
00:00:11,554 --> 00:00:15,307
みんなでうたったり
たのしく てあそびをしたりするよ

4
00:00:15,391 --> 00:00:16,434
(コキンちゃん) フフッ
(ばいきんまん) うわっ！

5
00:00:16,517 --> 00:00:18,310
(コキン) コキンちゃんだよ！
(アンパンマン) フフッ

6
00:00:18,394 --> 00:00:20,938
(コキン) やってみるから
よ～くみててね

7
00:00:21,689 --> 00:00:25,693
♪ あおいなみだの コキンちゃん

8
00:00:25,776 --> 00:00:29,739
♪ ウソ泣き上手の 泣きまねで

9
00:00:29,822 --> 00:00:34,493
♪ あおいなみだを こぼしたら

10
00:00:34,577 --> 00:00:36,370
みんな できた？

11
00:00:36,454 --> 00:00:38,998
(ばいきんまん)
それじゃ はじまるぞ～！

12
00:00:39,081 --> 00:00:40,791
(コキン) アハハハハッ

13
00:00:41,542 --> 00:00:46,547
♪～

14
00:00:51,677 --> 00:00:53,763
(コキン)
♪ フンフフ フフフフ

15
00:00:53,846 --> 00:00:55,681
♪ フフフフフ～ン

16
00:00:55,765 --> 00:00:57,558
♪ フンフフ フンフフ…

17
00:00:57,641 --> 00:00:58,976
♪ ナナナナナ…

18
00:00:59,059 --> 00:01:00,561
うわっ！ なになに？

19
00:01:08,194 --> 00:01:10,613
なによ～ もう…

20
00:01:11,322 --> 00:01:12,281
えっ！

21
00:01:12,698 --> 00:01:17,703
～♪

22
00:01:18,245 --> 00:01:20,581
(ばいきんまん) イチ ニ…

23
00:01:20,664 --> 00:01:23,209
(ドキンちゃん) ああ おいしい

24
00:01:23,876 --> 00:01:26,712
(ばいきんまん) イチ ニ
イチ…

25
00:01:26,796 --> 00:01:28,839
(ドキン)
どうしちゃったの？
ばいきんまん

26
00:01:28,923 --> 00:01:31,550
(ドキン) はりきっちゃって
(ばいきんまん) イチ ニ… ううっ

27
00:01:31,634 --> 00:01:35,095
きょうのおれさま
なんだか ぜっこうちょう！

28
00:01:35,179 --> 00:01:37,681
きょうこそアンパンマンを…

29
00:01:37,765 --> 00:01:39,975
(コキン) ドキンおねえちゃーん！
(ばいきんまん) ん？

30
00:01:40,559 --> 00:01:41,936
(ばいきんまん･ドキン) あのこえは

31
00:01:42,520 --> 00:01:43,979
(ぶつかるおと)

32
00:01:46,649 --> 00:01:50,236
ねえねえ みてみて～
ひろったの～

33
00:01:51,362 --> 00:01:52,238
あれ？

34
00:01:55,491 --> 00:01:56,575
(てふてふ) んん～

35
00:01:56,659 --> 00:01:57,785
うえっ？

36
00:01:59,161 --> 00:02:02,331
(てふてふ) うっ… うぐぐぐぐ…

37
00:02:02,414 --> 00:02:03,541
くっ！

38
00:02:03,624 --> 00:02:05,084
(てふてふ) てふ？
(コキン) ああ～！

39
00:02:06,460 --> 00:02:07,586
てふてふ？

40
00:02:08,128 --> 00:02:10,422
(コキン) うわ… てふてふ？

41
00:02:11,173 --> 00:02:12,424
てふ？

42
00:02:14,718 --> 00:02:16,178
(てふてふ) ママ？
(コキン) えっ…

43
00:02:16,929 --> 00:02:17,972
ママ？

44
00:02:18,472 --> 00:02:20,599
ママ？ コキンちゃんが？

45
00:02:20,683 --> 00:02:22,601
てふてふ！ ママ

46
00:02:22,685 --> 00:02:24,019
(コキン) うわっ
(てふてふ) ママ～！

47
00:02:24,103 --> 00:02:26,480
アハハッ かわいい～

48
00:02:26,564 --> 00:02:28,190
ハハッ アハハハッ

49
00:02:28,274 --> 00:02:29,441
(ばいきんまん･ドキン)
コキンちゃん！

50
00:02:29,525 --> 00:02:30,651
(コキン) うっ？

51
00:02:30,734 --> 00:02:31,986
あっ おねえちゃん

52
00:02:32,444 --> 00:02:35,990
コキンちゃん ママになっちゃった～

53
00:02:44,331 --> 00:02:46,000
(ふたり) ええーっ！

54
00:02:46,417 --> 00:02:49,670
(てふてふ) てふてふ～
ママ ママ～

55
00:02:49,753 --> 00:02:51,171
(ばいきんまん) なんだ こいつ

56
00:02:51,255 --> 00:02:53,007
(ドキン) どっからつれてきたのよ？

57
00:02:53,299 --> 00:02:54,967
かえしてきなさい

58
00:02:55,050 --> 00:02:58,262
やだもん
コキンちゃん ママになったんだもん

59
00:02:58,345 --> 00:02:59,430
ママ～

60
00:02:59,513 --> 00:03:01,348
(コキン) ウフフフフ
(てふてふ) フフッ フフフフフ

61
00:03:01,765 --> 00:03:02,725
(ドキン) ダ～メ
(ばいきんまん) ん？

62
00:03:02,808 --> 00:03:04,310
(コキン) うわっ　う… うう…

63
00:03:04,393 --> 00:03:05,227
(ばいきんまん) なあ～！

64
00:03:05,769 --> 00:03:08,939
なによ～ ひっく… もう～

65
00:03:09,023 --> 00:03:09,857
(てふてふ) てふ？

66
00:03:09,940 --> 00:03:11,942
(コキン) うう… うわああ～
(てふてふ) うわああ～ん！

67
00:03:12,026 --> 00:03:12,860
(コキン) え？

68
00:03:12,943 --> 00:03:14,403
(ばいきんまん) わわわわわっ
(ドキン) えっ

69
00:03:14,486 --> 00:03:16,614
やだ ないちゃった

70
00:03:16,697 --> 00:03:18,741
いないいない… ばあっ！

71
00:03:18,824 --> 00:03:20,284
ぐふふふ…

72
00:03:20,618 --> 00:03:21,994
(てふてふの なきごえ)

73
00:03:22,077 --> 00:03:23,537
(ばいきんまん) ハア～
(コキン) おねえちゃん

74
00:03:24,163 --> 00:03:29,043
それじゃあ
ほ～ら おもしろいかおー ヘヘヘヘ

75
00:03:29,126 --> 00:03:30,377
ええ～ん ええ～ん…

76
00:03:30,461 --> 00:03:33,547
あっ コキンちゃん
おうた うたってあげる！

77
00:03:34,048 --> 00:03:36,842
さあ！ みんなもいっしょにね

78
00:03:36,926 --> 00:03:43,933
♪～

79
00:03:57,821 --> 00:04:01,200
♪ あおいなみだの コキンちゃん

80
00:04:01,283 --> 00:04:04,787
♪ ウソ泣き上手の 泣きまねで

81
00:04:04,870 --> 00:04:08,290
♪ あおいなみだを こぼしたら

82
00:04:08,374 --> 00:04:11,877
♪ 悲しくないのに 泣けてくる

83
00:04:12,878 --> 00:04:14,546
ええ～ん　えっ？

84
00:04:14,630 --> 00:04:16,924
♪ エ～ン エ～ン エ～ン

85
00:04:17,007 --> 00:04:18,050
うわあ！

86
00:04:18,133 --> 00:04:21,303
♪ コキン コキン コキンちゃん

87
00:04:21,387 --> 00:04:26,600
♪ あおいなみだ あ･あ･あ･あ

88
00:04:27,059 --> 00:04:29,603
そんなうたで なきやむわけが…

89
00:04:30,062 --> 00:04:30,896
てふっ

90
00:04:31,230 --> 00:04:32,648
(てふてふ) てふてふ～
(ばいきんまん) ん？

91
00:04:32,731 --> 00:04:34,566
(ドキン) あら？
(ばいきんまん) わらってるぞ

92
00:04:34,650 --> 00:04:37,319
おうた おうた　すき すき～

93
00:04:37,403 --> 00:04:39,613
あ… あ… ああ？ てふっ！

94
00:04:41,365 --> 00:04:42,366
てふふっ

95
00:04:42,825 --> 00:04:45,202
このこ いま おっきくなった？

96
00:04:45,285 --> 00:04:48,122
(てふてふ) ママ　おうた おうた～

97
00:04:48,205 --> 00:04:49,123
(コキン) もっと？

98
00:04:49,206 --> 00:04:50,124
(てふてふ) うん！

99
00:04:50,207 --> 00:04:52,876
(コキン) ねえ　おねえちゃんも
いっしょにやって

100
00:04:52,960 --> 00:04:54,712
ばいきんまんも

101
00:04:54,795 --> 00:04:56,463
(ばいきんまん) なんで おれさまが…

102
00:04:56,547 --> 00:04:57,381
(コキン) え？

103
00:04:57,923 --> 00:05:02,386
う… なによ～　ううっ うう…

104
00:05:02,803 --> 00:05:05,723
(コキン) うわああ～ん！
(ばいきんまん) いいっ？

105
00:05:05,806 --> 00:05:07,891
(コキン) うわああ～ん
(ばいきんまん) おっ

106
00:05:07,975 --> 00:05:12,730
(ばいきんまん) お～いおいおいおい
かなしくないのに なみだが～！

107
00:05:12,813 --> 00:05:14,815
(ばいきんまん) お～いおいおいおい
(コキン) てへっ

108
00:05:15,190 --> 00:05:16,567
(ばいきんまんの なきごえ)

109
00:05:16,650 --> 00:05:17,693
てふっ

110
00:05:18,610 --> 00:05:20,696
じゃあ いくね！

111
00:05:20,779 --> 00:05:27,786
♪～

112
00:05:38,088 --> 00:05:41,592
♪ あおいなみだの コキンちゃん

113
00:05:41,675 --> 00:05:45,012
♪ ウソ泣き上手の 泣きまねで

114
00:05:45,095 --> 00:05:48,515
♪ あおいなみだを こぼしたら

115
00:05:48,599 --> 00:05:52,770
♪ 悲しくないのに 泣けてくる

116
00:05:54,730 --> 00:05:57,900
♪ エ～ン エ～ン エ～ン

117
00:05:58,317 --> 00:06:01,612
♪ コキン コキン コキンちゃん

118
00:06:01,695 --> 00:06:07,159
♪ あおいなみだ あ･あ･あ･あ

119
00:06:17,586 --> 00:06:24,593
～♪

120
00:06:24,676 --> 00:06:25,636
(コキン) てへっ

121
00:06:26,970 --> 00:06:28,305
おうた すき！

122
00:06:28,388 --> 00:06:29,473
(コキン) あっ！

123
00:06:29,556 --> 00:06:31,391
(てふてふ) ああっ　てふ？
(コキン) アハハッ

124
00:06:31,475 --> 00:06:34,144
(コキン) アハハハハッ
(てふてふ) てふてふ ママ～

125
00:06:34,228 --> 00:06:38,023
(ドキン) ウソ～　うたってあげると
おおきくなるなんて

126
00:06:38,398 --> 00:06:40,234
いったい どうなってんのよ！

127
00:06:40,317 --> 00:06:42,903
いや おれさまにきかれても…

128
00:06:43,362 --> 00:06:46,240
そうだ　なんてよぼうかな

129
00:06:46,323 --> 00:06:47,241
てふ？

130
00:06:47,324 --> 00:06:49,201
う～ん…

131
00:06:49,952 --> 00:06:53,288
てふてふいってるから
なまえは てふてふね

132
00:06:53,372 --> 00:06:54,915
てふてふ？

133
00:06:57,835 --> 00:06:59,920
ほ～ら ママとおそろい

134
00:07:00,003 --> 00:07:01,964
てふてふ～

135
00:07:04,508 --> 00:07:06,718
あっ！ ケーキだ！

136
00:07:08,637 --> 00:07:10,055
はい どうぞ

137
00:07:10,139 --> 00:07:11,390
(てふてふ) ううん…

138
00:07:11,723 --> 00:07:14,351
え？ ケーキいらないの？

139
00:07:14,434 --> 00:07:16,186
じゃあ なにがすきなの？

140
00:07:16,603 --> 00:07:18,522
おうた！ てふっ

141
00:07:18,605 --> 00:07:20,065
そうなの？

142
00:07:20,149 --> 00:07:23,443
じゃあ これぜーんぶ
コキンちゃんのでいい？

143
00:07:23,527 --> 00:07:25,362
ママの ママの

144
00:07:25,445 --> 00:07:27,990
わーい いただきまーす

145
00:07:28,073 --> 00:07:30,117
あむむっ もぐもぐ

146
00:07:30,200 --> 00:07:32,119
(かびるんるんたち) かび～　かびっ？

147
00:07:32,703 --> 00:07:35,330
つぎは なにしてあそぼうかな～

148
00:07:35,414 --> 00:07:36,665
(てふてふ) てふてふ

149
00:07:39,376 --> 00:07:41,295
(ばいきんまん) あ～！ ケーキが！

150
00:07:41,378 --> 00:07:43,297
(ドキン)
コキンちゃんをつかまえてきて！

151
00:07:43,380 --> 00:07:44,882
(ばいきんまん) く～っ！

152
00:07:45,257 --> 00:07:46,383
(かびるんるんたち) かび～

153
00:07:46,466 --> 00:07:49,553
(コキン) おっかけっこよ～
まてまて～

154
00:07:49,636 --> 00:07:50,888
(てふてふ) てふてふ～

155
00:07:50,971 --> 00:07:53,015
(コキン) まてまて～

156
00:07:53,098 --> 00:07:55,642
(ばいきんまん) あっ！
あぶないよ コキンちゃん

157
00:07:55,726 --> 00:07:58,061
(てふてふ) てふっ ママ～ フフフフッ

158
00:07:58,145 --> 00:07:59,271
ああっ うっ！

159
00:07:59,354 --> 00:08:01,648
えっ？ てふてふーっ！

160
00:08:02,024 --> 00:08:03,734
うわあ！ コキンちゃん！

161
00:08:03,817 --> 00:08:06,111
(てふてふ) ふっぐぐぐぐ…
(コキン) ほっ！

162
00:08:08,155 --> 00:08:09,323
(てふてふ) ママ～！

163
00:08:09,406 --> 00:08:11,950
もう しんぱいさせないでよー

164
00:08:12,034 --> 00:08:13,827
わわわわわっ　わあ～！

165
00:08:13,911 --> 00:08:14,870
(コキン) そうだ！

166
00:08:15,621 --> 00:08:16,622
え？

167
00:08:16,997 --> 00:08:17,873
(コキン) おでかけしよう

168
00:08:17,956 --> 00:08:21,501
(ばいきんまん) あ～れ～！

169
00:08:25,756 --> 00:08:28,508
(ばいきんまん) くーっ！
このこのこのこの…

170
00:08:29,176 --> 00:08:30,677
(コキン) しゅっぱーつ！

171
00:08:31,303 --> 00:08:33,180
(かびるんるんたち) かび～
(ドキン) まちなさい！

172
00:08:34,473 --> 00:08:36,099
(ばいきんまん) ああっ

173
00:08:36,600 --> 00:08:40,020
(ドキン) ばいきんまん
はやくおいかけて

174
00:08:40,103 --> 00:08:43,732
(ばいきんまん) ええーっ？
なんで おれさまが？

175
00:08:43,815 --> 00:08:50,822
♪～

176
00:09:01,333 --> 00:09:04,586
♪ あおいなみだの コキンちゃん

177
00:09:04,670 --> 00:09:08,173
♪ ウソ泣き上手の 泣きまねで

178
00:09:08,257 --> 00:09:11,510
♪ あおいなみだを こぼしたら

179
00:09:11,593 --> 00:09:15,973
♪ 悲しくないのに 泣けてくる

180
00:09:17,849 --> 00:09:21,353
♪ エ～ン エ～ン エ～ン

181
00:09:21,436 --> 00:09:24,606
♪ コキン コキン コキンちゃん

182
00:09:24,690 --> 00:09:30,153
♪ あおいなみだ あ･あ･あ･あ

183
00:09:40,580 --> 00:09:47,587
～♪

184
00:09:51,091 --> 00:09:53,302
(カレーパンマン) へえ～
いいてんきだぜ

185
00:09:53,885 --> 00:09:57,389
そうだね　こまってるひとも
いないみたいだし

186
00:09:59,391 --> 00:10:01,184
あ？ なんだ ありゃ？

187
00:10:01,852 --> 00:10:04,021
へんなかたちの くもだなあ

188
00:10:04,104 --> 00:10:07,274
(しょくぱんまん) きっと
だいしぜんの しんぴですよ

189
00:10:07,357 --> 00:10:10,694
おお… しろいくもよ

190
00:10:10,777 --> 00:10:12,863
まーた はじまった

191
00:10:12,946 --> 00:10:16,783
(みんな)
♪ いとまきまき いとまきまき

192
00:10:16,867 --> 00:10:20,871
♪ ひいてひいて トントントン

193
00:10:20,954 --> 00:10:24,875
♪ いとまきまき いとまきまき

194
00:10:24,958 --> 00:10:28,795
♪ ひいてひいて トントントン

195
00:10:28,879 --> 00:10:32,799
♪ できた できた

196
00:10:32,883 --> 00:10:37,137
♪ こびとさんの おくつ

197
00:10:37,220 --> 00:10:38,555
(みんな) アハハハハッ

198
00:10:38,638 --> 00:10:39,598
(コキン) みんな～！

199
00:10:39,681 --> 00:10:40,515
(みんな) あ？

200
00:10:41,391 --> 00:10:43,560
(ちびぞう) コキンちゃんだぞう

201
00:10:45,103 --> 00:10:45,937
(コキン) ほいっ

202
00:10:48,899 --> 00:10:49,816
てふ？

203
00:10:50,484 --> 00:10:51,610
(みみせんせい) まあ～

204
00:10:51,693 --> 00:10:52,694
(メロンパンナ) そのこは？

205
00:10:53,070 --> 00:10:54,654
てふてふっていうの

206
00:10:54,738 --> 00:10:56,448
(メロンパンナ) かわいい～

207
00:10:56,740 --> 00:10:59,201
コキンちゃん ママになったの

208
00:10:59,534 --> 00:11:00,827
(みんな) ええーっ！

209
00:11:00,911 --> 00:11:02,621
(クリームパンダ)
コキンちゃんがママ？

210
00:11:03,121 --> 00:11:05,499
(コキン) うたってあげると
おおきくなるの

211
00:11:05,582 --> 00:11:07,667
(カバお) え？ どういうこと？

212
00:11:07,751 --> 00:11:09,252
(コキン) じゃあ みててね

213
00:11:09,961 --> 00:11:12,381
みんなも じゅんびはいい？

214
00:11:12,756 --> 00:11:19,763
♪～

215
00:11:33,735 --> 00:11:37,114
♪ あおいなみだの コキンちゃん

216
00:11:37,197 --> 00:11:40,659
♪ ウソ泣き上手の 泣きまねで

217
00:11:40,742 --> 00:11:44,162
♪ あおいなみだを こぼしたら

218
00:11:44,246 --> 00:11:48,291
♪ 悲しくないのに 泣けてくる

219
00:11:50,252 --> 00:11:53,713
♪ エ～ン エ～ン エ～ン

220
00:11:53,797 --> 00:11:57,259
♪ コキン コキン コキンちゃん

221
00:11:57,342 --> 00:12:01,930
♪ あおいなみだ あ･あ･あ･あ

222
00:12:02,013 --> 00:12:09,020
～♪

223
00:12:09,104 --> 00:12:10,730
(てふてふ) うわーい

224
00:12:11,064 --> 00:12:14,276
てふてふ おうただいすき

225
00:12:14,818 --> 00:12:17,446
(ピョンきち)
ほんとだ　おおきくなった

226
00:12:17,529 --> 00:12:21,074
(カバお) ぼくらがうたっても
おおきくなるのかなあ？

227
00:12:21,158 --> 00:12:23,368
(ウサこ) みんなで
うたってみましょうよ

228
00:12:23,452 --> 00:12:26,621
(みみ) それじゃ
おおきなこえで げんきよくね！

229
00:12:26,705 --> 00:12:28,248
(みんな) はーい！

230
00:12:28,331 --> 00:12:35,338
♪～

231
00:12:36,047 --> 00:12:39,718
♪ ぼくらはみんな 生きている

232
00:12:39,801 --> 00:12:43,638
♪ 生きているから 歌うんだ

233
00:12:43,722 --> 00:12:47,392
♪ ぼくらはみんな 生きている

234
00:12:47,476 --> 00:12:51,271
♪ 生きているから かなしいんだ

235
00:12:51,771 --> 00:12:55,192
♪ 手のひらを太陽に

236
00:12:55,275 --> 00:12:59,237
♪ すかしてみれば

237
00:12:59,321 --> 00:13:06,203
♪ まっかに流れる ぼくの血潮

238
00:13:06,286 --> 00:13:10,707
♪ ミミズだって オケラだって

239
00:13:10,790 --> 00:13:15,003
♪ アメンボだって

240
00:13:15,086 --> 00:13:18,548
♪ みんな みんな生きているんだ

241
00:13:18,632 --> 00:13:21,843
♪ 友だちなんだ

242
00:13:23,386 --> 00:13:25,514
おうただいすき！

243
00:13:25,597 --> 00:13:27,432
(ちびぞう) また おおきくなったぞう！

244
00:13:27,516 --> 00:13:28,934
(てふてふ) だあっ
(コキン) アハハッ

245
00:13:29,017 --> 00:13:30,936
てふてふ たのしい！

246
00:13:31,019 --> 00:13:33,522
アハハハッ ぎゅう～

247
00:13:34,231 --> 00:13:38,068
(てふてふ) ママ　おうた おうた
みんなでおうた！

248
00:13:38,401 --> 00:13:39,569
(みんな) うん！

249
00:13:40,237 --> 00:13:43,573
(ドキン) コキンちゃーん
コキンちゃーん

250
00:13:43,657 --> 00:13:44,741
(しょくぱんまん) どうしたんですか？

251
00:13:44,824 --> 00:13:47,536
(ドキン) あっ しょくぱんまんさま

252
00:13:48,161 --> 00:13:52,499
あっ あの…
コキンちゃんをさがしてるんですけど

253
00:13:52,582 --> 00:13:54,209
(アンパンマン) コキンちゃんを？

254
00:13:54,292 --> 00:13:57,212
(カレーパンマン) おれたちが
いっしょに さがしてやるぜ

255
00:13:57,295 --> 00:13:58,380
(ドキン) ありがと

256
00:13:59,589 --> 00:14:01,925
みんな！
コキンちゃんたちといっしょに――

257
00:14:02,008 --> 00:14:04,302
げんきいっぱい てあそびしましょ！

258
00:14:04,386 --> 00:14:05,512
てふ～

259
00:14:05,595 --> 00:14:12,602
♪～

260
00:14:19,651 --> 00:14:22,946
♪ あおいなみだの コキンちゃん
(チーズ) アンアン！

261
00:14:23,530 --> 00:14:25,657
(シドロ) なになに？
(モドロ) たのしそう

262
00:14:25,740 --> 00:14:28,535
(シドロ･モドロ)
わたしたちも やりたーい！

263
00:14:30,036 --> 00:14:32,038
♪ 悲しくないのに…
(ばいきんまん) コキンちゃん

264
00:14:32,122 --> 00:14:35,041
はやく かえらないと
ドキンちゃんに しかられるよ

265
00:14:35,125 --> 00:14:35,959
(コキン) やーだもん

266
00:14:36,042 --> 00:14:36,918
(てふてふ) うええ～ん！

267
00:14:37,002 --> 00:14:39,838
(ばいきんまん) うわあああ！
なくなー！

268
00:14:39,921 --> 00:14:41,756
♪ コキン コキン コキンちゃん

269
00:14:41,840 --> 00:14:42,674
(てふてふ) てふっ

270
00:14:42,757 --> 00:14:43,592
(メロンパンナ) ウソなき

271
00:14:43,675 --> 00:14:45,218
(クリームパンダ)
コキンちゃんに そっくり

272
00:14:45,635 --> 00:14:46,636
(コキン) てへっ
(てふてふ) てふ～

273
00:14:51,099 --> 00:14:58,106
～♪

274
00:14:58,189 --> 00:15:00,859
(ばいきんまん) うう～ん　この～！

275
00:15:02,819 --> 00:15:06,239
もうおこった！
おれさま かえる！

276
00:15:07,407 --> 00:15:09,868
(コキン) たのしいね～ てふてふ

277
00:15:09,951 --> 00:15:12,078
(てふてふ) ママ　あ…

278
00:15:12,203 --> 00:15:13,997
(コキン) あれ？
ねむくなっちゃったの？

279
00:15:14,289 --> 00:15:16,333
(てふてふの あくび)

280
00:15:16,416 --> 00:15:17,584
(コキン) てふてふ？

281
00:15:19,085 --> 00:15:20,086
どうしたの？

282
00:15:20,378 --> 00:15:22,213
(てふてふの ねいき)

283
00:15:25,467 --> 00:15:26,343
(コキン) うわっ

284
00:15:26,426 --> 00:15:27,385
(メロンパンナ･クリームパンダ)
ええ～っ！

285
00:15:27,469 --> 00:15:29,846
(コキン) うわっ！ ねえ てふてふ

286
00:15:29,929 --> 00:15:31,723
おきてよ～

287
00:15:32,974 --> 00:15:35,393
てふてふ～ うう…

288
00:15:35,477 --> 00:15:37,646
(ばいきんまん) コキンちゃんなんか
しらないもんね！

289
00:15:37,729 --> 00:15:41,733
(コキン) てふてふ！ ねえ てふてふ！

290
00:15:41,816 --> 00:15:43,985
(コキン) うっ ううう～
(ばいきんまん) フン！

291
00:15:44,069 --> 00:15:48,907
(コキン) ばいきんまん
てふてふが～ ええ～ん

292
00:15:48,990 --> 00:15:50,617
(ばいきんまん) もう！

293
00:15:52,077 --> 00:15:53,453
コキンちゃん

294
00:15:53,536 --> 00:15:56,706
(コキン) てふてふが てふてふが～

295
00:15:57,582 --> 00:15:58,958
いたぜ

296
00:16:00,043 --> 00:16:01,127
(ドキン) コキンちゃん

297
00:16:04,464 --> 00:16:06,383
(コキン) ドキンおねえちゃん

298
00:16:07,217 --> 00:16:09,803
てふてふが
うごかなくなっちゃった

299
00:16:09,886 --> 00:16:10,762
(ドキン) え？
(アンパンマンたち) ええ？

300
00:16:13,306 --> 00:16:15,392
コキンちゃん　うたって！

301
00:16:15,475 --> 00:16:16,559
(コキン) え？

302
00:16:18,186 --> 00:16:21,398
そうね　てふてふは
うたがだいすきなんだもん

303
00:16:21,856 --> 00:16:25,110
(ちびぞう) コキンちゃんのうたで
めをさますかもしれないぞう

304
00:16:25,652 --> 00:16:26,861
(コキン) でも…

305
00:16:27,153 --> 00:16:29,489
コキンちゃんはママなんでしょ！

306
00:16:29,864 --> 00:16:31,074
あっ…

307
00:16:31,574 --> 00:16:32,701
うん！

308
00:16:38,873 --> 00:16:45,714
♪ あおいなみだの コキンちゃん

309
00:16:46,256 --> 00:16:53,012
♪ ウソ泣き上手の 泣きまねで

310
00:16:53,722 --> 00:17:00,687
♪ あおいなみだを こぼしたら

311
00:17:01,104 --> 00:17:07,986
♪ 悲しくないのに 泣けてくる

312
00:17:13,825 --> 00:17:14,951
(みんな) あっ！

313
00:17:16,911 --> 00:17:18,121
(コキン) ああ…

314
00:17:19,956 --> 00:17:26,963
♪～

315
00:17:31,342 --> 00:17:34,763
♪ あおいなみだの コキンちゃん

316
00:17:34,846 --> 00:17:38,224
♪ ウソ泣き上手の 泣きまねで

317
00:17:38,308 --> 00:17:41,644
♪ あおいなみだを こぼしたら

318
00:17:41,728 --> 00:17:45,899
♪ 悲しくないのに 泣けてくる

319
00:17:47,734 --> 00:17:51,154
♪ エ～ン エ～ン エ～ン

320
00:17:51,488 --> 00:17:54,908
♪ コキン コキン コキンちゃん

321
00:17:54,991 --> 00:17:59,412
♪ あおいなみだ あ･あ･あ･あ

322
00:18:00,455 --> 00:18:07,462
～♪

323
00:18:11,841 --> 00:18:13,259
(コキン) ああ～…

324
00:18:18,473 --> 00:18:19,557
(てふてふ) ママ

325
00:18:19,641 --> 00:18:20,892
(ばいきんまん) ああ…

326
00:18:20,975 --> 00:18:22,477
てふてふなの？

327
00:18:23,311 --> 00:18:26,064
ママのおうたで おおきくなったよ

328
00:18:26,397 --> 00:18:27,565
わああ

329
00:18:27,857 --> 00:18:29,359
てふてふ～

330
00:18:29,442 --> 00:18:31,069
(てふてふ) ママ～

331
00:18:31,611 --> 00:18:33,905
(カバお) ねえねえ
ぼくたちも うたおうよ

332
00:18:34,906 --> 00:18:38,076
♪ 手のひらを太陽に

333
00:18:38,451 --> 00:18:42,330
♪ すかしてみれば

334
00:18:42,413 --> 00:18:49,337
♪ まっかに流れる ぼくの血潮

335
00:18:49,420 --> 00:18:53,842
♪ ミミズだって オケラだって

336
00:18:53,925 --> 00:18:57,971
♪ アメンボだって

337
00:18:58,054 --> 00:19:00,306
♪ みんな みんな…

338
00:19:01,808 --> 00:19:02,809
みて！ あれ！

339
00:19:02,892 --> 00:19:03,726
(ピョンきち･ちびぞう) ああっ

340
00:19:07,564 --> 00:19:10,066
(ジャムおじさん)
なかまが むかえにきたんだね

341
00:19:10,149 --> 00:19:11,943
(てふてふ) いかなきゃ
(コキン) えっ！

342
00:19:12,819 --> 00:19:15,780
とってもたのしかった
ありがとう

343
00:19:15,864 --> 00:19:17,365
てふてふ

344
00:19:18,741 --> 00:19:20,827
おうた だいすき！

345
00:19:21,494 --> 00:19:23,288
ママ だーいすき！

346
00:19:23,746 --> 00:19:25,790
うっ ううっ

347
00:19:26,666 --> 00:19:29,460
きっと また あいにくるね！

348
00:19:29,752 --> 00:19:31,796
うう… うっ

349
00:19:32,463 --> 00:19:33,298
またね！

350
00:19:34,507 --> 00:19:36,759
また あおうね～！

351
00:19:36,843 --> 00:19:43,850
♪～

352
00:19:43,933 --> 00:19:45,602
(ドキン) いっちゃった…

353
00:19:48,730 --> 00:19:51,316
(ばいきんまん) さあ
かえるよ　コキンちゃん

354
00:19:51,399 --> 00:19:52,233
(コキン) やだ！

355
00:19:52,317 --> 00:19:53,192
(ドキン･ばいきんまん)
ええっ！

356
00:19:53,902 --> 00:19:55,570
もっと あそぶ！

357
00:19:56,529 --> 00:19:57,864
(ドキン･ばいきんまん)
ダメ！

358
00:19:57,947 --> 00:19:59,574
(ドキン) かえるの！
(コキン) うえっ？

359
00:20:00,783 --> 00:20:05,413
うっ… なによ なによ
うっ ううっ…

360
00:20:05,622 --> 00:20:08,875
ドキンおねえちゃんの
いじわる～！

361
00:20:08,958 --> 00:20:10,877
うえ～ん

362
00:20:10,960 --> 00:20:13,254
(ばいきんまん)
お～いおいおいおい

363
00:20:13,338 --> 00:20:16,883
かなしくないのに
なみだが～

364
00:20:16,966 --> 00:20:19,344
もう　コキンちゃんったら

365
00:20:54,003 --> 00:21:01,010
～♪

366
00:21:01,094 --> 00:21:02,345
てへっ

