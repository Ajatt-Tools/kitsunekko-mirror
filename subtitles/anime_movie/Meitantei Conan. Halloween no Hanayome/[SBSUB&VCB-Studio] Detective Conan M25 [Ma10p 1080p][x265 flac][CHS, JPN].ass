Dialogue: 5,1:43:49.65,1:43:50.45,Default,,0,0,0,,		魔法？	\N{\rDefault-JP}		おまじない？	
Dialogue: 5,1:43:54.82,1:43:55.81,Default,,0,0,0,,		真是的	\N{\rDefault-JP}		ったく	
Dialogue: 5,1:43:56.24,1:43:58.96,Default,,0,0,0,,		你还有心思想这个  那应该是没事吧	\N{\rDefault-JP}		そんな元気があるなら大丈夫そうね	
Dialogue: 5,1:43:59.37,1:44:01.21,Default,,0,0,0,,		佐藤…警官…	\N{\rDefault-JP}		佐藤…さん…	
Dialogue: 5,1:49:15.90,1:49:17.55,Default,,0,0,0,,		高木	\N{\rDefault-JP}		高木	
Dialogue: 5,1:49:17.58,1:49:19.46,Default,,0,0,0,,		谁准你死掉的	\N{\rDefault-JP}		何勝手に死ねんだ	
Dialogue: 5,1:49:19.46,1:49:20.65,Default,,0,0,0,,		蠢货	\N{\rDefault-JP}		バカヤロ	
Dialogue: 5,1:49:22.62,1:49:23.91,Default,,0,0,0,,		拿下	\N{\rDefault-JP}		それ  確保	
Dialogue: 5,1:49:30.49,1:49:31.92,Default,,0,0,0,,		该死的暴徒	\N{\rDefault-JP}		おのれ  暴漢	
Dialogue: 5,1:49:33.24,1:49:34.56,Default,,0,0,0,,		上啊	\N{\rDefault-JP}		それいけ	
Dialogue: 5,1:49:34.56,1:49:35.80,Default,,0,0,0,,		很好  就这样	\N{\rDefault-JP}		よし  そこだ	
Dialogue: 5,1:49:41.05,1:49:41.93,Default,,0,0,0,,		我说	\N{\rDefault-JP}		ちょっと	
Dialogue: 5,1:49:42.11,1:49:44.35,Default,,0,0,0,,		我不是在医院睡觉的吗  又怎么了	\N{\rDefault-JP}		病院で寝てたのに  今度は何？	
Dialogue: 5,1:49:44.59,1:49:46.07,Default,,0,0,0,,		你们搞什么	\N{\rDefault-JP}		何をやっとる	
Dialogue: 5,1:49:46.07,1:49:49.72,Default,,0,0,0,,		这次是有人威胁要袭击方面本部长奶奶的葬礼	\N{\rDefault-JP}		今度は方面本部長のおばあさまの葬式を襲撃すると	
Dialogue: 5,1:49:49.72,1:49:51.33,Default,,0,0,0,,		都收到预告了	\N{\rDefault-JP}		予告があったんだぞ	
Dialogue: 5,1:49:51.39,1:49:53.21,Default,,0,0,0,,		就算是训练也别松懈	\N{\rDefault-JP}		訓練だからって気を抜くな	
Dialogue: 5,1:49:53.21,1:49:54.12,Default,,0,0,0,,		是	\N{\rDefault-JP}		はい	
Dialogue: 5,1:49:55.45,1:49:56.32,Default,,0,0,0,,		那个	\N{\rDefault-JP}		あの	
Dialogue: 5,1:49:56.62,1:49:59.54,Default,,0,0,0,,		我有必要打扮成这样吗	\N{\rDefault-JP}		僕  この格好する意味あります？	
Dialogue: 5,1:49:59.99,1:50:01.06,Default,,0,0,0,,		我说	\N{\rDefault-JP}		ねぇ	
Dialogue: 5,1:50:01.39,1:50:02.83,Default,,0,0,0,,		喂	\N{\rDefault-JP}		おい	
Dialogue: 5,1:50:17.13,1:50:20.10,Default,,0,0,0,,		我好想你啊  雪莉	\N{\rDefault-JP}		会いたかったぜ  シェリー	
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
						
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,下面由银弹工具箱自动合并添加
Dialogue: 5,0:08:42.04,0:08:45.37,M25-Russian-Chi-A,,0,0,0,,	{\pos(768,1080)}	你在哪里？

Dialogue: 5,0:08:42.87,0:08:45.37,M25-Russian-Chi-A,,0,0,0,,	{\pos(1020,1080)}	求你了

Dialogue: 5,0:08:43.66,0:08:45.37,M25-Russian-Chi-A,,0,0,0,,	{\pos(1210,1080)}	回来吧

Dialogue: 5,0:31:51.06,0:31:51.93,M25-Russian-Chi-A,,0,0,0,,		快逃！

Dialogue: 5,0:32:00.44,0:32:01.94,M25-Russian-Chi-A,,0,0,0,,		你先下去

Dialogue: 5,0:32:01.94,0:32:05.70,M25-Russian-Chi-A,,0,0,0,,		要是被警察拦住  就把这张名片给他们看

Dialogue: 5,0:32:13.37,0:32:14.08,M25-Russian-Chi-A,,0,0,0,,		我先逃了！

Dialogue: 5,0:51:48.21,0:51:50.34,M25-Russian-Chi-A,,0,0,0,,		总之我给他们打了电话

Dialogue: 5,0:51:50.34,0:51:51.34,M25-Russian-Chi-A,,0,0,0,,		要松田警官过来

Dialogue: 5,0:51:52.13,0:51:54.01,M25-Russian-Chi-A,,0,0,0,,		真的不会有问题吗？

Dialogue: 5,0:51:54.01,0:51:55.63,M25-Russian-Chi-A,,0,0,0,,		我们要想把那家伙逼到绝境

Dialogue: 5,0:51:55.63,0:51:56.76,M25-Russian-Chi-A,,0,0,0,,		就只有这么做

Dialogue: 5,0:51:56.76,0:51:58.76,M25-Russian-Chi-A,,0,0,0,,		要是拒绝  这个人就会死

Dialogue: 5,0:51:59.18,0:52:01.31,M25-Russian-Chi-A,,0,0,0,,		他们一定不希望这样的事发生

Dialogue: 5,1:00:02.83,1:00:04.33,M25-Russian-Chi-A,,0,0,0,,		喂  你做什么！

Dialogue: 5,1:00:04.33,1:00:05.58,M25-Russian-Chi-A,,0,0,0,,		艾莲妮卡!!

Dialogue: 5,1:00:14.42,1:00:16.18,M25-Russian-Chi-A,,0,0,0,,		艾莲妮卡  你想做什么？

Dialogue: 5,1:00:16.18,1:00:18.18,M25-Russian-Chi-A,,0,0,0,,		不仅露脸  还把名字……

Dialogue: 5,1:00:18.18,1:00:20.81,M25-Russian-Chi-A,,0,0,0,,		为了亲手抓住那家伙

Dialogue: 5,1:01:13.02,1:01:14.40,M25-Russian-Chi-A,,0,0,0,,		……好吧

Dialogue: 5,1:01:16.74,1:01:17.74,M25-Russian-Chi-A,,0,0,0,,		都拿下来吧

Dialogue: 5,1:01:34.46,1:01:35.96,M25-Russian-Chi-A,,0,0,0,,	{\pos(960,1080)}	拿纸笔来

Dialogue: 5,1:04:15.92,1:04:16.75,M25-Russian-Chi-A,,0,0,0,,		混蛋……!!

Dialogue: 5,1:04:17.00,1:04:19.13,M25-Russian-Chi-A,,0,0,0,,		所以我才反对!!

Dialogue: 5,1:04:19.13,1:04:21.50,M25-Russian-Chi-A,,0,0,0,,		我们不需要这种家伙帮忙!!

Dialogue: 5,1:04:50.95,1:04:51.95,M25-Russian-Chi-A,,0,0,0,,		该死的……

Dialogue: 5,1:04:52.20,1:04:53.49,M25-Russian-Chi-A,,0,0,0,,		竟敢耍我们!!

Dialogue: 5,1:04:56.96,1:04:58.58,M25-Russian-Chi-A,,0,0,0,,		可恶!!  刚才明明甩掉他们了啊…

Dialogue: 5,1:04:58.83,1:04:59.42,M25-Russian-Chi-A,,0,0,0,,		混蛋～!!!

Dialogue: 5,1:05:12.60,1:05:14.22,M25-Russian-Chi-A,,0,0,0,,		你找死吗  小鬼！

Dialogue: 5,1:05:14.22,1:05:15.85,M25-Russian-Chi-A,,0,0,0,,		等等！别对小孩开枪！

Dialogue: 5,1:05:15.85,1:05:18.23,M25-Russian-Chi-A,,0,0,0,,		…情况不妙  我们撤

Dialogue: 5,1:05:18.52,1:05:19.23,M25-Russian-Chi-A,,0,0,0,,		可恶！

Dialogue: 5,1:05:26.03,1:05:27.03,M25-Russian-Chi-A,,0,0,0,,		……普拉米亚

Dialogue: 5,1:05:27.28,1:05:28.90,M25-Russian-Chi-A,,0,0,0,,		我们定要杀死！

Dialogue: 5,1:06:18.33,1:06:21.46,M25-Russian-Chi-A,,0,0,0,,		我不想让你变成我“儿子”那样

Dialogue: 5,1:10:09.43,1:10:12.94,M25-Russian-Chi-A,,0,0,0,,		就是今天了  普拉米亚一定会出现在那栋大楼

Dialogue: 5,1:10:13.19,1:10:16.32,M25-Russian-Chi-A,,0,0,0,,		无论如何都要杀死他

Dialogue: 5,1:10:16.32,1:10:18.82,M25-Russian-Chi-A,,0,0,0,,		这可能是最后的机会了

Dialogue: 5,1:10:19.61,1:10:22.82,M25-Russian-Chi-A,,0,0,0,,		所以我们「纳达乌尼奇托基提」

Dialogue: 5,1:10:22.82,1:10:24.58,M25-Russian-Chi-A,,0,0,0,,		才会全员来到日本

Dialogue: 5,1:10:25.74,1:10:26.99,M25-Russian-Chi-A,,0,0,0,,		不论如何

Dialogue: 5,1:10:27.54,1:10:29.04,M25-Russian-Chi-A,,0,0,0,,		只要发生爆炸

Dialogue: 5,1:10:29.04,1:10:32.25,M25-Russian-Chi-A,,0,0,0,,		就必定会有无辜的人丧命…

Dialogue: 5,1:10:33.63,1:10:36.00,M25-Russian-Chi-A,,0,0,0,,		你又想起了那时的事吗？

Dialogue: 5,1:10:36.59,1:10:38.34,M25-Russian-Chi-A,,0,0,0,,		那次确实是为时已晚……

Dialogue: 5,1:10:41.68,1:10:45.18,M25-Russian-Chi-A,,0,0,0,,		基里尔————！

Dialogue: 5,1:10:48.10,1:10:49.73,M25-Russian-Chi-A,,0,0,0,,		我也很想救他

Dialogue: 5,1:10:49.73,1:10:52.02,M25-Russian-Chi-A,,0,0,0,,		但是  就算冲进火海  你儿子也……

Dialogue: 5,1:10:53.73,1:10:54.61,M25-Russian-Chi-A,,0,0,0,,		……闭嘴

Dialogue: 5,1:10:54.98,1:10:56.61,M25-Russian-Chi-A,,0,0,0,,		对  对不起  艾莲妮卡

Dialogue: 5,1:10:57.02,1:10:58.03,M25-Russian-Chi-A,,0,0,0,,		不说这个了

Dialogue: 5,1:10:58.36,1:11:00.61,M25-Russian-Chi-A,,0,0,0,,		快恢复你平时的冷静

Dialogue: 5,1:11:03.11,1:11:04.62,M25-Russian-Chi-A,,0,0,0,,		你没事吧！  德米特里？！

Dialogue: 5,1:18:06.75,1:18:08.12,M25-Russian-Chi-A,,0,0,0,,		到时间了  走吧

Dialogue: 5,1:18:09.37,1:18:10.12,M25-Russian-Chi-A,,0,0,0,,		什么？！

Dialogue: 5,1:18:24.43,1:18:27.18,M25-Russian-Chi-A,,0,0,0,,		你有完没完！  就凭你这种小鬼……

Dialogue: 5,1:18:31.06,1:18:33.06,M25-Russian-Chi-A,,0,0,0,,		我知道普拉米亚的身份了！

Dialogue: 5,1:18:34.02,1:18:35.77,M25-Russian-Chi-A,,0,0,0,,		你竟然会说俄语？！

Dialogue: 5,1:19:44.97,1:19:45.97,M25-Russian-Chi-A,,0,0,0,,		不许动

Dialogue: 5,1:21:49.26,1:21:50.26,M25-Russian-Chi-A,,0,0,0,,		快躲起来！

Dialogue: 5,1:22:23.00,1:22:23.88,M25-Russian-Chi-A,,0,0,0,,		你没事吧？

Dialogue: 5,1:22:24.38,1:22:25.00,M25-Russian-Chi-A,,0,0,0,,		没事

Dialogue: 5,1:22:25.25,1:22:26.13,M25-Russian-Chi-A,,0,0,0,,		怎么办？

Dialogue: 5,1:22:26.75,1:22:28.88,M25-Russian-Chi-A,,0,0,0,,		请尽量拖延时间

Dialogue: 5,1:22:28.88,1:22:31.01,M25-Russian-Chi-A,,0,0,0,,		我要先去一个地方

Dialogue: 5,1:22:31.26,1:22:32.01,M25-Russian-Chi-A,,0,0,0,,		你们要顺利逃脱啊

Dialogue: 5,1:22:32.39,1:22:33.14,M25-Russian-Chi-A,,0,0,0,,		知道了

Dialogue: 5,1:23:25.94,1:23:27.32,M25-Russian-Chi-A,,0,0,0,,		到处都是警察

Dialogue: 5,1:23:27.32,1:23:29.07,M25-Russian-Chi-A,,0,0,0,,		要逃离这里可不容易

Dialogue: 5,1:23:29.36,1:23:30.74,M25-Russian-Chi-A,,0,0,0,,		不能伤害警察

Dialogue: 5,1:23:31.15,1:23:33.03,M25-Russian-Chi-A,,0,0,0,,		这是我们和那个少年的约定

Dialogue: 5,1:23:33.61,1:23:36.78,M25-Russian-Chi-A,,0,0,0,,		他说一定会把普拉米亚带到我们面前

Dialogue: 5,1:23:37.16,1:23:38.66,M25-Russian-Chi-A,,0,0,0,,		相信那个少年吧

Dialogue: 5,1:35:04.09,1:35:06.10,M25-Russian-Chi-A,,0,0,0,,		……可以趁现在杀了她

Dialogue: 5,1:35:10.52,1:35:13.52,M25-Russian-Chi-A,,0,0,0,,		基里尔……妈妈这就替你报仇……

Dialogue: 5,1:36:41.23,1:36:42.99,M25-Russian-Chi-A,,0,0,0,,		一起阻止普拉米亚的炸弹

Dialogue: 5,1:37:26.07,1:37:27.20,M25-Russian-Chi-A,,0,0,0,,		……去帮他们吧

Dialogue: 5,1:37:27.20,1:37:29.45,M25-Russian-Chi-A,,0,0,0,,		通知其他成员

Dialogue: 5,1:37:29.95,1:37:31.20,M25-Russian-Chi-A,,0,0,0,,		……真要放过她吗？

Dialogue: 5,1:37:31.20,1:37:33.95,M25-Russian-Chi-A,,0,0,0,,		这说不定是最后的机会……

Dialogue: 5,1:37:34.20,1:37:35.45,M25-Russian-Chi-A,,0,0,0,,		……那个少年说得没错

Dialogue: 5,1:37:35.45,1:37:39.71,M25-Russian-Chi-A,,0,0,0,,		不能让更多人遭遇和我们一样的不幸

Dialogue: 5,1:37:41.21,1:37:42.13,M25-Russian-Chi-A,,0,0,0,,		……好吧

Dialogue: 5,1:38:12.20,1:38:13.33,M25-Russian-Chi-A,,0,0,0,,		我来帮忙

Dialogue: 5,1:38:13.83,1:38:14.83,M25-Russian-Chi-A,,0,0,0,,		……谢谢

Dialogue: 5,1:39:58.64,1:40:00.14,M25-Russian-Chi-A,,0,0,0,,		我们帮你  小弟弟

Dialogue: 5,1:40:01.14,1:40:02.64,M25-Russian-Chi-A,,0,0,0,,		谢尔盖！  大家！

Dialogue: 5,1:40:02.89,1:40:05.27,M25-Russian-Chi-A,,0,0,0,,		艾莲妮卡  你是我们的领袖

Dialogue: 5,1:40:05.27,1:40:07.40,M25-Russian-Chi-A,,0,0,0,,		不管你去哪里  我们都会追随你

Dialogue: 5,1:40:08.07,1:40:09.15,M25-Russian-Chi-A,,0,0,0,,		其他人也都同意了

Dialogue: 5,1:40:09.15,1:40:10.53,M25-Russian-Chi-A,,0,0,0,,		你不需要独自承担

Dialogue: 5,1:40:12.78,1:40:14.03,M25-Russian-Chi-A,,0,0,0,,		……谢谢你们

Dialogue: 5,1:40:16.07,1:40:18.45,M25-Russian-Chi-A,,0,0,0,,		一  二！

Dialogue: 5,1:40:21.12,1:40:23.25,M25-Russian-Chi-A,,0,0,0,,		一  二！

Dialogue: 5,1:41:18.76,1:41:20.26,M25-Russian-Chi-A,,0,0,0,,		抓紧了！

