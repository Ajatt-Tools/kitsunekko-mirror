Dialogue: 5,0:00:30.86,0:00:33.64,DefaultSingle-J,,0,0,0,,		いつかこんな日が来るとは思ってましたけど	
Dialogue: 5,0:00:33.88,0:00:36.04,DefaultSingle-J,,0,0,0,,		ついにやったね  高木刑事	
Dialogue: 5,0:00:36.04,0:00:37.14,DefaultSingle-J,,0,0,0,,		でもよぉ	
Dialogue: 5,0:00:37.26,0:00:39.31,DefaultSingle-J,,0,0,0,,		えらい急に決まったよなぁ	
Dialogue: 5,0:00:41.57,0:00:43.15,DefaultSingle-J,,0,0,0,,		本当に来ますかね	
Dialogue: 5,0:00:43.55,0:00:46.52,DefaultSingle-J,,0,0,0,,		匿名のタレコミだ  望み薄かな	
Dialogue: 5,0:00:46.63,0:00:48.15,DefaultSingle-J,,0,0,0,,		この男なんですよね	
Dialogue: 5,0:00:48.51,0:00:50.40,DefaultSingle-J,,0,0,0,,		降谷さんの同期を  その…	
Dialogue: 5,0:00:52.59,0:00:54.46,DefaultSingle-J,,0,0,0,,		すみません  余計なことを	
Dialogue: 5,0:00:54.46,0:00:55.88,DefaultSingle-J,,0,0,0,,		どうも引っかかるんだ	
Dialogue: 5,0:00:56.36,0:00:58.18,DefaultSingle-J,,0,0,0,,		爆弾の知識はともかく	
Dialogue: 5,0:00:58.26,0:01:03.42,DefaultSingle-J,,0,0,0,,		脱走の計画を練り  実行するだけの力がその男にあるとは思えなくてね	
Dialogue: 5,0:01:03.58,0:01:05.13,DefaultSingle-J,,0,0,0,,		それってつまり…	
Dialogue: 5,0:01:15.13,0:01:17.97,DefaultSingle-J,,0,0,0,,		佐藤刑事  とってもキレイです	
Dialogue: 5,0:01:21.54,0:01:23.70,DefaultSingle-J,,0,0,0,,		俺も  いつか蘭と…	
Dialogue: 5,0:01:24.22,0:01:25.90,DefaultSingle-J,,0,0,0,,		どうかした  コナン君	
Dialogue: 5,0:01:27.43,0:01:28.70,DefaultSingle-J,,0,0,0,,		なんでもないよ	
Dialogue: 5,0:01:28.75,0:01:33.25,DefaultSingle-J,,0,0,0,,		このガキんちょ  蘭を嫁にしたいとか思ってるんじゃないの？	
Dialogue: 5,0:01:33.80,0:01:35.20,DefaultSingle-J,,0,0,0,,		まさかぁ	
Dialogue: 5,0:01:35.96,0:01:37.45,DefaultSingle-J,,0,0,0,,		正解です	
Dialogue: 5,0:01:45.00,0:01:46.72,DefaultSingle-J,,0,0,0,,		高木渉さん	
Dialogue: 5,0:01:47.10,0:01:48.64,DefaultSingle-J,,0,0,0,,		あなたは生涯	
Dialogue: 5,0:01:48.64,0:01:50.92,DefaultSingle-J,,0,0,0,,		美和子さんを守り続け	
Dialogue: 5,0:01:50.92,0:01:56.02,DefaultSingle-J,,0,0,0,,		笑顔を絶やさず  幸せにすることを誓いますか	
Dialogue: 5,0:01:56.60,0:01:58.26,DefaultSingle-J,,0,0,0,,		はい  誓います	
Dialogue: 5,0:02:00.75,0:02:01.98,DefaultSingle-J,,0,0,0,,		美和子さん	
Dialogue: 5,0:02:02.35,0:02:04.65,DefaultSingle-J,,0,0,0,,		あなたはどのようなときも	
Dialogue: 5,0:02:03.06,0:02:04.84,DefaultSingle-J,置顶,0,0,0,,		助けて  助けてくれ	
Dialogue: 5,0:02:04.84,0:02:06.09,DefaultSingle-J,置顶,0,0,0,,		なんだ  それは？	
Dialogue: 5,0:02:04.88,0:02:11.86,DefaultSingle-J,,0,0,0,,		渉さんの支えとなり  生涯愛し続けることを誓いますか	
Dialogue: 5,0:02:17.11,0:02:17.61,DefaultSingle-J,,0,0,0,,		は…	
Dialogue: 5,0:02:17.25,0:02:18.75,DefaultSingle-J,,0,0,0,,		美和子	
Dialogue: 5,0:02:19.04,0:02:22.41,DefaultSingle-J,,0,0,0,,		そんな奴と結婚するなら殺してやる	
Dialogue: 5,0:02:24.80,0:02:26.28,DefaultSingle-J,,0,0,0,,		確保	
Dialogue: 5,0:02:28.91,0:02:29.67,DefaultSingle-J,,0,0,0,,		おっちゃん？	
Dialogue: 5,0:02:29.67,0:02:30.60,DefaultSingle-J,,0,0,0,,		どけ	
Dialogue: 5,0:02:34.35,0:02:35.90,DefaultSingle-J,,0,0,0,,		ちょ  ま  ちょ…	
Dialogue: 5,0:02:36.13,0:02:37.73,DefaultSingle-J,,0,0,0,,		ちょっと	
Dialogue: 5,0:02:37.73,0:02:38.66,DefaultSingle-J,,0,0,0,,		イテテテ	
Dialogue: 5,0:02:38.66,0:02:39.46,DefaultSingle-J,,0,0,0,,		おい  バカ	
Dialogue: 5,0:02:39.48,0:02:41.02,DefaultSingle-J,,0,0,0,,		なんなんだよ  いったい	
Dialogue: 5,0:02:43.58,0:02:44.28,DefaultSingle-J,,0,0,0,,		ヤベェ	
Dialogue: 5,0:02:44.97,0:02:46.69,DefaultSingle-J,,0,0,0,,		しまった  靴がちげえ	
Dialogue: 5,0:02:50.79,0:02:52.24,DefaultSingle-J,,0,0,0,,		風見  離れろ	
Dialogue: 5,0:02:52.78,0:02:54.82,DefaultSingle-J,,0,0,0,,		助けてくれ	
Dialogue: 5,0:03:03.73,0:03:05.45,DefaultSingle-J,,0,0,0,,		大丈夫か  風見	
Dialogue: 5,0:03:13.44,0:03:14.55,DefaultSingle-J,,0,0,0,,		風見…	
Dialogue: 5,0:03:24.73,0:03:25.86,DefaultSingle-J,,0,0,0,,		高木くん	
Dialogue: 5,0:03:30.28,0:03:31.82,DefaultSingle-J,,0,0,0,,		訓練終了	
Dialogue: 5,0:03:33.27,0:03:34.04,DefaultSingle-J,,0,0,0,,		やられた？	
Dialogue: 5,0:03:34.04,0:03:35.24,DefaultSingle-J,,0,0,0,,		マジかよ	
Dialogue: 5,0:03:35.28,0:03:38.74,DefaultSingle-J,,0,0,0,,		何をやっとるんだ  新郎が撃たれたじゃないか	
Dialogue: 5,0:03:39.02,0:03:40.93,DefaultSingle-J,,0,0,0,,		警備態勢は見直しだ	
Dialogue: 5,0:03:42.30,0:03:44.99,DefaultSingle-J,,0,0,0,,		ペイントの塗料って落ちないんですよね	
Dialogue: 5,0:03:46.10,0:03:47.94,DefaultSingle-J,,0,0,0,,		どうしたんです？佐藤さん	
Dialogue: 5,0:03:48.92,0:03:50.85,DefaultSingle-J,,0,0,0,,		な  なんでもないわ	
Dialogue: 5,0:03:51.82,0:03:53.84,DefaultSingle-J,,0,0,0,,		いったいどういうことですか	
Dialogue: 5,0:03:53.95,0:03:55.65,DefaultSingle-J,,0,0,0,,		訳分かんねぇよ	
Dialogue: 5,0:03:55.69,0:03:59.22,DefaultSingle-J,,0,0,0,,		高木刑事と佐藤刑事の結婚式じゃなかったの？	
Dialogue: 5,0:03:59.22,0:04:00.78,DefaultSingle-J,,0,0,0,,		いやぁ  スマンスマン	
Dialogue: 5,0:04:00.78,0:04:05.60,DefaultSingle-J,,0,0,0,,		本番さながらの訓練ということで  君達には何も知らせなかったんだよ	
Dialogue: 5,0:04:05.60,0:04:06.62,DefaultSingle-J,,0,0,0,,		おいおい	
Dialogue: 5,0:04:07.08,0:04:11.79,DefaultSingle-J,,0,0,0,,		実は今度  村中努元警視正が結婚することになってな	
Dialogue: 5,0:04:11.95,0:04:16.22,DefaultSingle-J,,0,0,0,,		結婚式の警備を我々と毛利君が担当することになったんだ	
Dialogue: 5,0:04:16.22,0:04:17.74,DefaultSingle-J,,0,0,0,,		お父さん  知ってたの？	
Dialogue: 5,0:04:17.74,0:04:18.99,DefaultSingle-J,,0,0,0,,		ああ  すまん	
Dialogue: 5,0:04:17.74,0:04:20.49,DefaultSingle-J,,0,0,0,,		それでとっさに前に出られたのか	
Dialogue: 5,0:04:20.58,0:04:24.11,DefaultSingle-J,,0,0,0,,		村中元警視正は確か警部殿の同期でしたな	
Dialogue: 5,0:04:24.11,0:04:26.12,DefaultSingle-J,,0,0,0,,		ああ  出世頭だったよ	
Dialogue: 5,0:04:26.55,0:04:29.52,DefaultSingle-J,,0,0,0,,		数年前に大怪我をして退職したんだが	
Dialogue: 5,0:04:29.56,0:04:32.63,DefaultSingle-J,,0,0,0,,		入院中の病院で運命の出会いがあったらしい	
Dialogue: 5,0:04:33.44,0:04:37.13,DefaultSingle-J,,0,0,0,,		退職後は連絡もよこさず心配していたんだがな	
Dialogue: 5,0:04:37.19,0:04:38.90,DefaultSingle-J,,0,0,0,,		正直驚いたよ	
Dialogue: 5,0:04:39.15,0:04:43.03,DefaultSingle-J,,0,0,0,,		でも  どうして結婚式の警備を捜査一課がやるの？	
Dialogue: 5,0:04:43.13,0:04:46.28,DefaultSingle-J,,0,0,0,,		村中のところに脅迫状が来ているんだ	
Dialogue: 5,0:04:46.48,0:04:49.89,DefaultSingle-J,,0,0,0,,		現役時代  彼は多くの犯罪者を逮捕した	
Dialogue: 5,0:04:50.17,0:04:52.19,DefaultSingle-J,,0,0,0,,		いまだに恨んでいる者も多い	
Dialogue: 5,0:04:52.19,0:04:53.94,DefaultSingle-J,,0,0,0,,		つまり  逆恨みってこと？	
Dialogue: 5,0:04:54.01,0:04:54.82,DefaultSingle-J,,0,0,0,,		そう	
Dialogue: 5,0:04:54.95,0:04:59.28,DefaultSingle-J,,0,0,0,,		だから警備させてくれと  こちらから上層部に願い出たんだよ	
Dialogue: 5,0:04:59.43,0:05:03.22,DefaultSingle-J,,0,0,0,,		我々は村中が逮捕した連中の顔も知っている	
Dialogue: 5,0:05:03.63,0:05:07.45,DefaultSingle-J,,0,0,0,,		もしもの時は対処できると思ったんだがな	
Dialogue: 5,0:05:07.63,0:05:09.46,DefaultSingle-J,,0,0,0,,		大丈夫？美和子	
Dialogue: 5,0:05:09.46,0:05:10.58,DefaultSingle-J,,0,0,0,,		お水持ってくるね	
Dialogue: 5,0:05:10.58,0:05:11.88,DefaultSingle-J,,0,0,0,,		三年ぶりだな	
Dialogue: 5,0:05:12.53,0:05:14.21,DefaultSingle-J,,0,0,0,,		やはりアンタだったか	
Dialogue: 5,0:05:14.61,0:05:17.09,DefaultSingle-J,,0,0,0,,		奴を脱走させれば  僕が出てくる	
Dialogue: 5,0:05:17.62,0:05:19.34,DefaultSingle-J,,0,0,0,,		そういう読みだったんだろ？	
Dialogue: 5,0:05:20.85,0:05:22.97,DefaultSingle-J,,0,0,0,,		どうしたの？佐藤刑事	
Dialogue: 5,0:05:23.57,0:05:24.50,DefaultSingle-J,,0,0,0,,		コナンくん	
Dialogue: 5,0:05:25.05,0:05:26.17,DefaultSingle-J,,0,0,0,,		なんでもないわ	
Dialogue: 5,0:05:26.71,0:05:29.54,DefaultSingle-J,,0,0,0,,		と言っても  君はすぐ見抜いちゃうか	
Dialogue: 5,0:05:30.50,0:05:33.34,DefaultSingle-J,,0,0,0,,		さっき  高木君が倒れた時	
Dialogue: 5,0:05:35.38,0:05:37.78,DefaultSingle-J,,0,0,0,,		またアレが見えちゃったんだよね	
Dialogue: 5,0:05:39.66,0:05:40.50,DefaultSingle-J,,0,0,0,,		アレ…	
Dialogue: 5,0:05:41.54,0:05:42.60,DefaultSingle-J,,0,0,0,,		アレって？	
Dialogue: 5,0:05:44.32,0:05:48.85,DefaultSingle-J,,0,0,0,,		高木君を連れていこうとする…死神よ	
Dialogue: 5,0:06:03.16,0:06:05.62,DefaultSingle-J,,0,0,0,,		俺は高校生探偵工藤新一	
Dialogue: 5,0:06:05.73,0:06:09.62,DefaultSingle-J,,0,0,0,,		幼なじみで同級生の毛利蘭と遊園地に遊びに行って	
Dialogue: 5,0:06:09.76,0:06:13.65,DefaultSingle-J,,0,0,0,,		黒ずくめの男の  怪しげな取引現場を目撃した	
Dialogue: 5,0:06:14.39,0:06:16.57,DefaultSingle-J,,0,0,0,,		取引を見るのに夢中になっていた俺は	
Dialogue: 5,0:06:16.57,0:06:19.52,DefaultSingle-J,,0,0,0,,		背後から近づいてくるもう一人の仲間に気付かなかった	
Dialogue: 5,0:06:22.15,0:06:24.91,DefaultSingle-J,,0,0,0,,		俺はその男に毒薬を飲まされ	
Dialogue: 5,0:06:25.33,0:06:26.78,DefaultSingle-J,,0,0,0,,		目が覚めたら	
Dialogue: 5,0:06:31.76,0:06:34.01,DefaultSingle-J,,0,0,0,,		体が縮んでしまっていた	
Dialogue: 5,0:06:34.76,0:06:37.56,DefaultSingle-J,,0,0,0,,		工藤新一が生きているとヤツらにバレたら	
Dialogue: 5,0:06:37.56,0:06:40.86,DefaultSingle-J,,0,0,0,,		また命を狙われ  周りの人間にも危害が及ぶ	
Dialogue: 5,0:06:42.11,0:06:45.48,DefaultSingle-J,,0,0,0,,		阿笠博士の助言で正体を隠すことにした俺は	
Dialogue: 5,0:06:45.88,0:06:48.46,DefaultSingle-J,,0,0,0,,		蘭に名前を聞かれて  とっさに	
Dialogue: 5,0:06:49.05,0:06:51.29,DefaultSingle-J,,0,0,0,,		江戸川コナンと名乗り	
Dialogue: 5,0:06:51.44,0:06:53.42,DefaultSingle-J,,0,0,0,,		ヤツらの情報をつかむため	
Dialogue: 5,0:06:53.42,0:06:56.66,DefaultSingle-J,,0,0,0,,		父親が探偵をやっている  蘭の家に転がり込んだ	
Dialogue: 5,0:06:59.24,0:07:02.44,DefaultSingle-J,,0,0,0,,		こいつらは  元太  光彦  歩美	
Dialogue: 5,0:07:02.70,0:07:04.92,DefaultSingle-J,,0,0,0,,		小さくなったオレの同級生だ	
Dialogue: 5,0:07:06.07,0:07:07.64,DefaultSingle-J,,0,0,0,,		彼女は灰原哀	
Dialogue: 5,0:07:07.69,0:07:09.59,DefaultSingle-J,,0,0,0,,		黒ずくめの組織の科学者で	
Dialogue: 5,0:07:09.59,0:07:13.07,DefaultSingle-J,,0,0,0,,		例の毒薬「アポトキシン４８６９」の開発者	
Dialogue: 5,0:07:13.43,0:07:16.58,DefaultSingle-J,,0,0,0,,		だが  姉を殺されたことから組織に反抗	
Dialogue: 5,0:07:16.87,0:07:20.76,DefaultSingle-J,,0,0,0,,		命を絶つためその薬を飲んだところ  体が縮んでしまった	
Dialogue: 5,0:07:21.27,0:07:25.00,DefaultSingle-J,,0,0,0,,		今は奴らの目を逃れるため  阿笠博士の家に住んでいる	
Dialogue: 5,0:07:27.81,0:07:32.32,DefaultSingle-J,,0,0,0,,		その黒ずくめの組織のメンバーの一人がこの男  安室透	
Dialogue: 5,0:07:32.94,0:07:36.40,DefaultSingle-J,,0,0,0,,		だがその正体は  公安警察を指揮する	
Dialogue: 5,0:07:36.42,0:07:40.82,DefaultSingle-J,,0,0,0,,		警察庁警備局の秘密組織「ゼロ」に所属する警察官で	
Dialogue: 5,0:07:40.82,0:07:42.41,DefaultSingle-J,,0,0,0,,		本名は降谷零	
Dialogue: 5,0:07:42.70,0:07:45.16,DefaultSingle-J,,0,0,0,,		組織の内情を探るべく潜入中	
Dialogue: 5,0:07:46.11,0:07:51.81,DefaultSingle-J,,0,0,0,,		高木刑事と付き合っている佐藤刑事の１期前に警察学校を卒業した生徒で	
Dialogue: 5,0:07:51.93,0:07:54.92,DefaultSingle-J,,0,0,0,,		ヤンチャな仲間があと四人いたらしいんだけど…	
Dialogue: 5,0:07:54.92,0:07:56.21,DefaultSingle-J,,0,0,0,,		ちょっと  コナンくん	
Dialogue: 5,0:07:56.21,0:07:58.13,DefaultSingle-J,,0,0,0,,		おめぇ  喋りすぎだぞ	
Dialogue: 5,0:07:58.13,0:08:00.36,DefaultSingle-J,,0,0,0,,		はっきり言って  ネタバレです	
Dialogue: 5,0:08:00.79,0:08:03.34,DefaultSingle-J,,0,0,0,,		さっさといつもの  言っちゃいなさいよ	
Dialogue: 5,0:08:04.12,0:08:04.84,DefaultSingle-J,,0,0,0,,		おう	
Dialogue: 5,0:08:05.92,0:08:08.24,DefaultSingle-J,,0,0,0,,		小さくなっても  頭脳は同じ	
Dialogue: 5,0:08:08.58,0:08:10.70,DefaultSingle-J,,0,0,0,,		迷宮なしの名探偵	
Dialogue: 5,0:08:11.30,0:08:14.53,DefaultSingle-J,,0,0,0,,		真実はいつも一つ	
Dialogue: 5,0:08:36.69,0:08:38.80,DefaultSingle-J,,0,0,0,,		マツダ  ジンペイ…	
Dialogue: 5,0:08:52.11,0:08:55.01,DefaultSingle-J,,0,0,0,,		結婚式のごちそう食べたかったなぁ	
Dialogue: 5,0:08:55.08,0:08:58.28,DefaultSingle-J,,0,0,0,,		まさか訓練だなんて思いませんでしたよ	
Dialogue: 5,0:08:58.28,0:09:00.84,DefaultSingle-J,,0,0,0,,		でも佐藤刑事  キレイだったよね	
Dialogue: 5,0:09:02.55,0:09:05.54,DefaultSingle-J,,0,0,0,,		女性にとって花嫁衣装は特別だから	
Dialogue: 5,0:09:06.04,0:09:10.52,DefaultSingle-J,,0,0,0,,		江戸川君も誰かさんの花嫁姿  妄想してたみたいだし	
Dialogue: 5,0:09:11.55,0:09:12.96,DefaultSingle-J,,0,0,0,,		誰かさんって誰？	
Dialogue: 5,0:09:12.96,0:09:13.87,DefaultSingle-J,,0,0,0,,		誰ですか	
Dialogue: 5,0:09:13.87,0:09:15.32,DefaultSingle-J,,0,0,0,,		小林先生か	
Dialogue: 5,0:09:15.60,0:09:16.84,DefaultSingle-J,,0,0,0,,		ってなんで？	
Dialogue: 5,0:09:17.30,0:09:19.62,DefaultSingle-J,,0,0,0,,		つか  さっきから何作ってんだ	
Dialogue: 5,0:09:19.62,0:09:21.80,DefaultSingle-J,,0,0,0,,		ハロウィンのコスプレ衣装ですよ	
Dialogue: 5,0:09:21.80,0:09:23.65,DefaultSingle-J,,0,0,0,,		これ着てみんなで楽しむの	
Dialogue: 5,0:09:23.99,0:09:26.21,DefaultSingle-J,,0,0,0,,		もちろん  コナンと灰原もな	
Dialogue: 5,0:09:26.73,0:09:27.81,DefaultSingle-J,,0,0,0,,		ちょ  ちょっと待ってよ	
Dialogue: 5,0:09:27.81,0:09:29.05,DefaultSingle-J,,0,0,0,,		俺はそんなの…	
Dialogue: 5,0:09:31.38,0:09:32.48,DefaultSingle-J,,0,0,0,,		なんですか	
Dialogue: 5,0:09:37.99,0:09:40.06,DefaultSingle-J,,0,0,0,,		な  なんだよ  この穴	
Dialogue: 5,0:09:41.04,0:09:41.80,DefaultSingle-J,,0,0,0,,		あいててて	
Dialogue: 5,0:09:41.80,0:09:42.69,DefaultSingle-J,,0,0,0,,		博士	
Dialogue: 5,0:09:42.90,0:09:45.82,DefaultSingle-J,,0,0,0,,		いやぁ  スマンスマン  びっくりさせたかいのォ	
Dialogue: 5,0:09:45.94,0:09:48.18,DefaultSingle-J,,0,0,0,,		今度はいったい何をしてたの？	
Dialogue: 5,0:09:48.43,0:09:49.57,DefaultSingle-J,,0,0,0,,		これじゃよ	
Dialogue: 5,0:09:49.57,0:09:52.67,DefaultSingle-J,,0,0,0,,		それって  コナン君のボールが出るベルト？	
Dialogue: 5,0:09:52.71,0:09:56.76,DefaultSingle-J,,0,0,0,,		超巨大ボールを発射できるように改良中なんだが	
Dialogue: 5,0:09:56.76,0:09:58.33,DefaultSingle-J,,0,0,0,,		うまくいかなくての	
Dialogue: 5,0:09:58.68,0:10:01.10,DefaultSingle-J,,0,0,0,,		もう少しで完成なんじゃ	
Dialogue: 5,0:10:01.12,0:10:04.81,DefaultSingle-J,,0,0,0,,		表面の伸縮性と強度のバランスを調整すれば…	
Dialogue: 5,0:10:04.81,0:10:05.56,DefaultSingle-J,,0,0,0,,		っつか	
Dialogue: 5,0:10:05.56,0:10:08.26,DefaultSingle-J,,0,0,0,,		落っこちてケガするところだったじゃんかよ	
Dialogue: 5,0:10:08.73,0:10:10.45,DefaultSingle-J,,0,0,0,,		スマンスマン  大丈夫か	
Dialogue: 5,0:10:10.45,0:10:13.16,DefaultSingle-J,,0,0,0,,		許さねぇよ  うな重食わせろ	
Dialogue: 5,0:10:13.16,0:10:15.64,DefaultSingle-J,@,0,0,0,,		いやぁ  それはちょっとうなじゅけないな	
Dialogue: 5,0:10:15.79,0:10:18.60,DefaultSingle-J,,0,0,0,,		すぐ食わせてくれそうな人ならいるぜ	
Dialogue: 5,0:10:23.29,0:10:24.90,DefaultSingle-J,,0,0,0,,		冗談じゃねぇぞ	
Dialogue: 5,0:10:25.17,0:10:28.27,DefaultSingle-J,,0,0,0,,		なんで俺がこいつらにおごらなくちゃならねぇんだ	
Dialogue: 5,0:10:28.34,0:10:30.50,DefaultSingle-J,,0,0,0,,		まあまあ  いいじゃないたまには	
Dialogue: 5,0:10:30.50,0:10:32.44,DefaultSingle-J,,0,0,0,,		ゴチになります	
Dialogue: 5,0:10:32.64,0:10:35.08,DefaultSingle-J,,0,0,0,,		昨日の訓練の件で警視庁行くから	
Dialogue: 5,0:10:35.10,0:10:37.70,DefaultSingle-J,,0,0,0,,		この辺で昼飯食おうって言っただけだぞ	
Dialogue: 5,0:10:37.74,0:10:40.75,DefaultSingle-J,,0,0,0,,		だから  みんなで食べたほうが美味しいじゃない	
Dialogue: 5,0:10:40.75,0:10:42.53,DefaultSingle-J,,0,0,0,,		ボク  天ぷら食べたいです	
Dialogue: 5,0:10:42.53,0:10:43.46,DefaultSingle-J,,0,0,0,,		私も	
Dialogue: 5,0:10:43.46,0:10:46.46,DefaultSingle-J,,0,0,0,,		オレ  うなぎ  うな重食いたい	
Dialogue: 5,0:10:46.46,0:10:47.43,DefaultSingle-J,,0,0,0,,		いいですね	
Dialogue: 5,0:10:47.43,0:10:49.14,DefaultSingle-J,,0,0,0,,		おい  いい加減にしろよ	
Dialogue: 5,0:10:51.47,0:10:52.15,DefaultSingle-J,,0,0,0,,		ねぇ	
Dialogue: 5,0:10:52.52,0:10:54.09,DefaultSingle-J,,0,0,0,,		コレ  落としたわよ	
Dialogue: 5,0:11:11.98,0:11:12.90,DefaultSingle-J,,0,0,0,,		灰原	
Dialogue: 5,0:11:12.95,0:11:13.92,DefaultSingle-J,,0,0,0,,		お父さん	
Dialogue: 5,0:11:20.86,0:11:22.12,DefaultSingle-J,,0,0,0,,		おっちゃん  灰原	
Dialogue: 5,0:11:22.12,0:11:24.50,DefaultSingle-J,,0,0,0,,		おじさん  しっかりして  おじさん	
Dialogue: 5,0:11:22.95,0:11:23.98,DefaultSingle-J,,0,0,0,,		灰原	
Dialogue: 5,0:11:24.81,0:11:26.32,DefaultSingle-J,,0,0,0,,		私は大丈夫	
Dialogue: 5,0:11:26.50,0:11:27.17,DefaultSingle-J,,0,0,0,,		でも…	
Dialogue: 5,0:11:27.75,0:11:28.76,DefaultSingle-J,,0,0,0,,		おっちゃん	
Dialogue: 5,0:11:30.65,0:11:31.71,DefaultSingle-J,,0,0,0,,		蘭姉ちゃん	
Dialogue: 5,0:11:32.10,0:11:33.59,DefaultSingle-J,,0,0,0,,		救急車呼んで	
Dialogue: 5,0:11:33.59,0:11:34.18,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:11:41.21,0:11:41.98,DefaultSingle-J,,0,0,0,,		危ない	
Dialogue: 5,0:11:44.15,0:11:45.24,DefaultSingle-J,,0,0,0,,		早く消せ	
Dialogue: 5,0:11:45.39,0:11:46.83,DefaultSingle-J,,0,0,0,,		くそ  近づけない	
Dialogue: 5,0:11:52.75,0:11:57.30,DefaultSingle-J,,0,0,0,,		じゃあ  ボクは現場検証が終わったら阿笠博士のところにいるから	
Dialogue: 5,0:11:57.50,0:11:58.10,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:12:01.39,0:12:04.63,DefaultSingle-J,,0,0,0,,		すると  目の前で突然火に包まれたのね	
Dialogue: 5,0:12:04.63,0:12:05.35,DefaultSingle-J,,0,0,0,,		そう	
Dialogue: 5,0:12:05.76,0:12:06.59,DefaultSingle-J,,0,0,0,,		灰原	
Dialogue: 5,0:12:06.89,0:12:09.95,DefaultSingle-J,,0,0,0,,		お前  直前にメモを拾って渡しに行ったよな	
Dialogue: 5,0:12:10.10,0:12:13.71,DefaultSingle-J,,0,0,0,,		ええ  何が書かれてたかまでは見てないけど	
Dialogue: 5,0:12:14.01,0:12:16.30,DefaultSingle-J,,0,0,0,,		そのとき  何か会話してなかったか	
Dialogue: 5,0:12:17.04,0:12:17.87,DefaultSingle-J,,0,0,0,,		えっと	
Dialogue: 5,0:12:18.24,0:12:20.28,DefaultSingle-J,,0,0,0,,		「ありがとう  拾ってくれて」	
Dialogue: 5,0:12:20.42,0:12:24.04,DefaultSingle-J,,0,0,0,,		「ある人に伝えたいとても大事なメモなんだ」って	
Dialogue: 5,0:12:24.04,0:12:25.35,DefaultSingle-J,,0,0,0,,		ロシア語で言ってたわ	
Dialogue: 5,0:12:25.62,0:12:27.09,DefaultSingle-J,,0,0,0,,		大事なメモ…	
Dialogue: 5,0:12:25.75,0:12:28.39,DefaultSingle-J,置顶,0,0,0,,		すごい  ロシア語わかるの？	
Dialogue: 5,0:12:27.85,0:12:31.96,DefaultSingle-J,,0,0,0,,		少なくとも黒ずくめの組織が灰原を狙ったわけじゃなさそうだ	
Dialogue: 5,0:12:28.39,0:12:29.44,DefaultSingle-J,置顶,0,0,0,,		少しだけ	
Dialogue: 5,0:12:32.85,0:12:35.96,DefaultSingle-J,,0,0,0,,		事故や自然現象とは考えられないですね	
Dialogue: 5,0:12:36.43,0:12:38.11,DefaultSingle-J,,0,0,0,,		被害者を狙った犯行でしょう	
Dialogue: 5,0:12:38.43,0:12:41.14,DefaultSingle-J,,0,0,0,,		持っていたタブレットが爆発源かと思われます	
Dialogue: 5,0:12:43.03,0:12:46.12,DefaultSingle-J,,0,0,0,,		ねぇ  鞄のポケットのところに何か入ってるよ	
Dialogue: 5,0:12:47.12,0:12:48.10,DefaultSingle-J,,0,0,0,,		確かに	
Dialogue: 5,0:12:48.98,0:12:50.36,DefaultSingle-J,,0,0,0,,		名刺のようだな	
Dialogue: 5,0:12:51.07,0:12:52.63,DefaultSingle-J,,0,0,0,,		こ  これは…	
Dialogue: 5,0:12:53.07,0:12:55.11,DefaultSingle-J,,0,0,0,,		一通り話は聞きました	
Dialogue: 5,0:12:56.14,0:12:57.34,DefaultSingle-J,,0,0,0,,		どうかしました	
Dialogue: 5,0:12:57.45,0:12:58.87,DefaultSingle-J,,0,0,0,,		これを見てくれ	
Dialogue: 5,0:13:01.64,0:13:03.14,DefaultSingle-J,,0,0,0,,		そ  それ…	
Dialogue: 5,0:13:04.13,0:13:05.71,DefaultSingle-J,,0,0,0,,		松田陣平	
Dialogue: 5,0:13:06.24,0:13:10.56,DefaultSingle-J,,0,0,0,,		元警視庁刑事部捜査一課強行犯三係の刑事	
Dialogue: 5,0:13:11.14,0:13:12.18,DefaultSingle-J,,0,0,0,,		三年前	
Dialogue: 5,0:13:12.24,0:13:15.61,DefaultSingle-J,,0,0,0,,		とある事件がきっかけで  捜査一課に転属となったが	
Dialogue: 5,0:13:16.02,0:13:18.11,DefaultSingle-J,,0,0,0,,		連続爆破事件の捜査中	
Dialogue: 5,0:13:18.33,0:13:21.73,DefaultSingle-J,,0,0,0,,		犯人の作った爆弾が爆発し  殉職	
Dialogue: 5,0:13:23.53,0:13:26.13,DefaultSingle-J,,0,0,0,,		名刺に書かれている所属は捜査一課	
Dialogue: 5,0:13:26.87,0:13:30.30,DefaultSingle-J,,0,0,0,,		確か彼が一課にいったのはほんの一週間くらいだったはず	
Dialogue: 5,0:13:31.16,0:13:34.18,DefaultSingle-J,,0,0,0,,		被害者はいつどこで名刺を手に入れたんだ	
Dialogue: 5,0:13:34.89,0:13:36.43,DefaultSingle-J,,0,0,0,,		マジで真ん前だな	
Dialogue: 5,0:13:36.43,0:13:38.13,DefaultSingle-J,,0,0,0,,		警察への抗議とかか	
Dialogue: 5,0:13:38.17,0:13:39.51,DefaultSingle-J,,0,0,0,,		おっかねーな	
Dialogue: 5,0:13:39.54,0:13:42.12,DefaultSingle-J,,0,0,0,,		勘弁してくれよって感じだよな	
Dialogue: 5,0:13:43.91,0:13:45.26,DefaultSingle-J,,0,0,0,,		と言うことで	
Dialogue: 5,0:13:45.54,0:13:47.42,DefaultSingle-J,,0,0,0,,		被害者の身元は不明	
Dialogue: 5,0:13:47.73,0:13:51.77,DefaultSingle-J,,0,0,0,,		子供たちの証言を基に似顔絵を作らせてはいるが…	
Dialogue: 5,0:13:52.23,0:13:55.30,DefaultSingle-J,,0,0,0,,		被害者が落としたメモも見てないんですかね	
Dialogue: 5,0:13:55.66,0:14:00.15,DefaultSingle-J,,0,0,0,,		あの燃え方だと  メモも焼失した可能性が高いだろうな	
Dialogue: 5,0:14:00.59,0:14:04.16,DefaultSingle-J,,0,0,0,,		今のところ  手掛かりはこの名刺だけということになる	
Dialogue: 5,0:14:04.49,0:14:07.12,DefaultSingle-J,,0,0,0,,		松田さんってこんな顔だったんですね	
Dialogue: 5,0:14:07.24,0:14:08.02,DefaultSingle-J,,0,0,0,,		そっか	
Dialogue: 5,0:14:08.33,0:14:11.79,DefaultSingle-J,,0,0,0,,		千葉くんの赴任は松田くんの殉職の後だったな	
Dialogue: 5,0:14:12.13,0:14:15.50,DefaultSingle-J,,0,0,0,,		確かに目元を隠すと高木さんに似てるかも	
Dialogue: 5,0:14:15.61,0:14:16.29,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:14:16.84,0:14:19.07,DefaultSingle-J,,0,0,0,,		高木君が張り込みで変装したら	
Dialogue: 5,0:14:19.10,0:14:20.79,DefaultSingle-J,,0,0,0,,		松田さんにそっくりだった	
Dialogue: 5,0:14:21.32,0:14:22.64,DefaultSingle-J,,0,0,0,,		お待たせしました	
Dialogue: 5,0:14:22.79,0:14:25.36,DefaultSingle-J,,0,0,0,,		一応  当時の日報も持ってきました	
Dialogue: 5,0:14:25.49,0:14:26.41,DefaultSingle-J,,0,0,0,,		佐藤君	
Dialogue: 5,0:14:26.41,0:14:31.49,DefaultSingle-J,,0,0,0,,		配属中  松田君と組んでいたのは君だ  何か思い当たることはないか	
Dialogue: 5,0:14:31.54,0:14:32.31,DefaultSingle-J,,0,0,0,,		いいえ	
Dialogue: 5,0:14:32.62,0:14:36.71,DefaultSingle-J,,0,0,0,,		外国の人に名刺を渡していれば覚えてると思うのですが…	
Dialogue: 5,0:14:37.15,0:14:39.43,DefaultSingle-J,,0,0,0,,		聴き込みは他の者に任せて	
Dialogue: 5,0:14:39.46,0:14:42.04,DefaultSingle-J,,0,0,0,,		君は当時のことを思い出してみてくれ	
Dialogue: 5,0:14:42.19,0:14:43.22,DefaultSingle-J,,0,0,0,,		わかりました	
Dialogue: 5,0:14:52.85,0:14:54.62,DefaultSingle-J,,0,0,0,,		気づいてないとでも思った？	
Dialogue: 5,0:14:56.49,0:14:57.42,DefaultSingle-J,,0,0,0,,		ったく	
Dialogue: 5,0:14:57.42,0:15:00.10,DefaultSingle-J,,0,0,0,,		君のことだから  盗み聞きしてたんでしょう	
Dialogue: 5,0:15:00.97,0:15:02.12,DefaultSingle-J,,0,0,0,,		とにかく入って	
Dialogue: 5,0:15:03.61,0:15:07.46,DefaultSingle-J,,0,0,0,,		こんな物見なくてもあいつとの一週間は大体覚えてる	
Dialogue: 5,0:15:08.09,0:15:09.60,DefaultSingle-J,,0,0,0,,		高木君には内緒よ	
Dialogue: 5,0:15:09.86,0:15:13.28,DefaultSingle-J,,0,0,0,,		すごい刑事さんだったんでしょ？松田刑事って	
Dialogue: 5,0:15:13.47,0:15:14.10,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 5,0:15:14.51,0:15:16.96,DefaultSingle-J,,0,0,0,,		態度がでかくて  口が悪くて	
Dialogue: 5,0:15:18.36,0:15:19.11,DefaultSingle-J,,0,0,0,,		でも…	
Dialogue: 5,0:15:20.20,0:15:24.47,DefaultSingle-J,,0,0,0,,		もしよかったら  ボクに教えてくれない？松田刑事のこと	
Dialogue: 5,0:15:25.82,0:15:29.12,DefaultSingle-J,,0,0,0,,		話してるうちに何か思い出すかもしれないでしょ？	
Dialogue: 5,0:15:30.21,0:15:30.99,DefaultSingle-J,,0,0,0,,		そう…	
Dialogue: 5,0:15:32.34,0:15:33.20,DefaultSingle-J,,0,0,0,,		そうね	
Dialogue: 5,0:15:34.35,0:15:38.91,DefaultSingle-J,,0,0,0,,		彼が捜査一課に配属になったのは  三年前の１１月１日	
Dialogue: 5,0:15:39.02,0:15:41.50,DefaultSingle-J,,0,0,0,,		ハロウィンの翌日だったから覚えてるわ	
Dialogue: 5,0:15:42.14,0:15:45.54,DefaultSingle-J,,0,0,0,,		だけど急な転属だったから名刺は間に合わなっかたの	
Dialogue: 5,0:15:46.20,0:15:48.86,DefaultSingle-J,,0,0,0,,		渡せたのは１１月４日の朝	
Dialogue: 5,0:15:49.03,0:15:51.16,DefaultSingle-J,,0,0,0,,		これも祝日明けだったから覚えてる	
Dialogue: 5,0:15:51.40,0:15:54.78,DefaultSingle-J,,0,0,0,,		松田刑事が殉職したのは１１月７日	
Dialogue: 5,0:15:54.91,0:15:58.35,DefaultSingle-J,,0,0,0,,		名刺を渡すチャンスがあったのは  この四日間だね	
Dialogue: 5,0:15:58.47,0:16:00.83,DefaultSingle-J,,0,0,0,,		でも４日は一日内勤だったし	
Dialogue: 5,0:16:00.83,0:16:04.68,DefaultSingle-J,,0,0,0,,		５日も護送任務で留置場と拘置所の往復で終わり	
Dialogue: 5,0:16:04.87,0:16:09.89,DefaultSingle-J,,0,0,0,,		７日は彼が亡くなる直前まで連続爆破犯の追跡をしてたから…	
Dialogue: 5,0:16:09.89,0:16:12.62,DefaultSingle-J,,0,0,0,,		ってことは  名刺を渡すチャンスがあったのって…	
Dialogue: 5,0:16:13.00,0:16:15.12,DefaultSingle-J,,0,0,0,,		そう  １１月６日だけ	
Dialogue: 5,0:16:15.65,0:16:19.69,DefaultSingle-J,,0,0,0,,		だけど  勤務が終わってから誰かに渡した可能性もあるよね	
Dialogue: 5,0:16:19.84,0:16:23.77,DefaultSingle-J,,0,0,0,,		あいつ  うちの課に来てから一週間寮に帰らないで	
Dialogue: 5,0:16:23.77,0:16:25.55,DefaultSingle-J,,0,0,0,,		庁内に泊まり込んでいたのよ	
Dialogue: 5,0:16:25.94,0:16:30.14,DefaultSingle-J,,0,0,0,,		今から思うと  連続爆破事件のこと調べていたんでしょうね	
Dialogue: 5,0:16:30.69,0:16:34.62,DefaultSingle-J,,0,0,0,,		でも  何か特別なことがあったって記憶はないのよね	
Dialogue: 5,0:16:34.76,0:16:36.54,DefaultSingle-J,,0,0,0,,		強盗犯捕まえて	
Dialogue: 5,0:16:36.91,0:16:38.76,DefaultSingle-J,,0,0,0,,		バスの暴走と止めたでしょ	
Dialogue: 5,0:16:39.15,0:16:41.46,DefaultSingle-J,,0,0,0,,		あと  飛び降り志願者の制止	
Dialogue: 5,0:16:41.89,0:16:44.20,DefaultSingle-J,,0,0,0,,		午前中はそんなものだったかな	
Dialogue: 5,0:16:45.68,0:16:48.03,DefaultSingle-J,,0,0,0,,		午後は担当事件の聞き込みだった	
Dialogue: 5,0:16:48.74,0:16:51.53,DefaultSingle-J,,0,0,0,,		ちょっと何よ  先の説得の仕方	
Dialogue: 5,0:16:52.01,0:16:53.77,DefaultSingle-J,,0,0,0,,		助けられたからよかったけど	
Dialogue: 5,0:16:53.80,0:16:56.18,DefaultSingle-J,,0,0,0,,		いつショックを受けて飛び降りるんじゃないかと	
Dialogue: 5,0:16:56.21,0:16:57.41,DefaultSingle-J,,0,0,0,,		ヒヤヒヤしたわよ	
Dialogue: 5,0:16:58.26,0:17:00.28,DefaultSingle-J,,0,0,0,,		少しは私の言うことも聞いて…	
Dialogue: 5,0:17:01.30,0:17:03.29,DefaultSingle-J,,0,0,0,,		メール？速いわね	
Dialogue: 5,0:17:03.65,0:17:06.38,DefaultSingle-J,,0,0,0,,		ああ  人より指先が器用なんでな	
Dialogue: 5,0:17:06.40,0:17:08.36,DefaultSingle-J,,0,0,0,,		もしかして彼女かしら？	
Dialogue: 5,0:17:08.36,0:17:10.36,DefaultSingle-J,,0,0,0,,		いや  ダチに書いてんだ	
Dialogue: 5,0:17:10.76,0:17:13.70,DefaultSingle-J,,0,0,0,,		送信しても受け取ってくれねぇ親友に	
Dialogue: 5,0:17:13.93,0:17:15.31,DefaultSingle-J,,0,0,0,,		受け取ってくれない？	
Dialogue: 5,0:17:15.89,0:17:18.96,DefaultSingle-J,,0,0,0,,		そいつは四年前に吹っ飛んじまったからよ	
Dialogue: 5,0:17:20.35,0:17:22.70,DefaultSingle-J,,0,0,0,,		米花町３丁目で殺人事件発生	
Dialogue: 5,0:17:23.09,0:17:24.63,DefaultSingle-J,,0,0,0,,		犯人はバイクで逃走中	
Dialogue: 5,0:17:25.10,0:17:26.82,DefaultSingle-J,,0,0,0,,		了解  追跡します	
Dialogue: 5,0:17:28.37,0:17:31.57,DefaultSingle-J,,0,0,0,,		やっぱ普通じゃねぇな  この町	
Dialogue: 5,0:17:32.04,0:17:35.04,DefaultSingle-J,,0,0,0,,		その件の聴取が午後三時頃までかかって	
Dialogue: 5,0:17:35.09,0:17:37.20,DefaultSingle-J,,0,0,0,,		その後桜田門に戻ってきたの	
Dialogue: 5,0:17:37.49,0:17:41.13,DefaultSingle-J,,0,0,0,,		ねぇ  聴取って松田刑事と一緒に受けていたの？	
Dialogue: 5,0:17:41.22,0:17:42.82,DefaultSingle-J,,0,0,0,,		いえ  別々よ	
Dialogue: 5,0:17:45.43,0:17:47.06,DefaultSingle-J,,0,0,0,,		悪い  待たせたな	
Dialogue: 5,0:17:47.06,0:17:50.27,DefaultSingle-J,,0,0,0,,		どこに行ってたのよ  もう６時過ぎよ	
Dialogue: 5,0:17:50.33,0:17:51.27,DefaultSingle-J,,0,0,0,,		ちょっとな	
Dialogue: 5,0:17:52.96,0:17:53.73,DefaultSingle-J,,0,0,0,,		あれは…	
Dialogue: 5,0:17:54.85,0:17:55.68,DefaultSingle-J,,0,0,0,,		どうしたの？	
Dialogue: 5,0:17:55.85,0:17:57.37,DefaultSingle-J,,0,0,0,,		今思い出したんだけど	
Dialogue: 5,0:17:57.37,0:18:00.12,DefaultSingle-J,,0,0,0,,		松田君  ポケットに数珠を入れてたのよ	
Dialogue: 5,0:18:00.12,0:18:01.15,DefaultSingle-J,,0,0,0,,		数珠？	
Dialogue: 5,0:18:02.35,0:18:05.56,DefaultSingle-J,,0,0,0,,		さっき言ってた松田刑事がメールを打っていた人って…	
Dialogue: 5,0:18:05.57,0:18:07.17,DefaultSingle-J,,0,0,0,,		多分  彼と同期で	
Dialogue: 5,0:18:07.17,0:18:11.38,DefaultSingle-J,,0,0,0,,		爆発物処理班に所属していた  萩原研二隊員	
Dialogue: 5,0:18:11.59,0:18:15.45,DefaultSingle-J,,0,0,0,,		今から七年前  爆弾解体中に殉職したらしいの	
Dialogue: 5,0:18:15.45,0:18:17.02,DefaultSingle-J,,0,0,0,,		その人の命日って？	
Dialogue: 5,0:18:17.59,0:18:20.06,DefaultSingle-J,,0,0,0,,		あいつと同じ  １１月７日だわ	
Dialogue: 5,0:18:20.19,0:18:24.28,DefaultSingle-J,,0,0,0,,		命日の７日は連続爆破犯が連絡してくる日	
Dialogue: 5,0:18:24.28,0:18:28.75,DefaultSingle-J,,0,0,0,,		松田刑事はその連絡が来るまで  ずっと本庁に詰めてたんだよね	
Dialogue: 5,0:18:28.75,0:18:31.17,DefaultSingle-J,,0,0,0,,		つまり  その日はお墓参りに行けない	
Dialogue: 5,0:18:31.87,0:18:33.89,DefaultSingle-J,,0,0,0,,		だから６日に行ったんじゃない？	
Dialogue: 5,0:18:34.35,0:18:38.06,DefaultSingle-J,,0,0,0,,		萩原さんのお墓は確か渋谷のすぐ近くのお寺のはず	
Dialogue: 5,0:18:40.18,0:18:41.77,DefaultSingle-J,,0,0,0,,		どうしたんです  佐藤さん	
Dialogue: 5,0:18:42.33,0:18:43.24,DefaultSingle-J,,0,0,0,,		これ頼む	
Dialogue: 5,0:18:43.28,0:18:44.55,DefaultSingle-J,,0,0,0,,		ま  待ってください	
Dialogue: 5,0:18:44.55,0:18:45.56,DefaultSingle-J,,0,0,0,,		高木さん	
Dialogue: 5,0:18:45.83,0:18:48.57,DefaultSingle-J,,0,0,0,,		事情聴取を終えたのは午後３時	
Dialogue: 5,0:18:49.01,0:18:52.58,DefaultSingle-J,,0,0,0,,		同期の墓参りをするために渋谷のお寺に行ったとしても	
Dialogue: 5,0:18:52.78,0:18:57.22,DefaultSingle-J,,0,0,0,,		夕方６時過ぎに帰ってくるのは  いくらなんでも時間がかかり過ぎている	
Dialogue: 5,0:18:57.97,0:19:00.58,DefaultSingle-J,,0,0,0,,		その三時間に何があったのか	
Dialogue: 5,0:19:00.93,0:19:03.32,DefaultSingle-J,,0,0,0,,		なんで君がここにいるんだい  コナン君	
Dialogue: 5,0:19:05.64,0:19:06.96,DefaultSingle-J,,0,0,0,,		はいはい	
Dialogue: 5,0:19:07.16,0:19:10.21,DefaultSingle-J,,0,0,0,,		彼らのことならよく覚えております	
Dialogue: 5,0:19:10.29,0:19:13.37,DefaultSingle-J,,0,0,0,,		数年前まで四人で来られてましたよ	
Dialogue: 5,0:19:13.37,0:19:14.09,DefaultSingle-J,,0,0,0,,		四人？	
Dialogue: 5,0:19:14.46,0:19:18.52,DefaultSingle-J,,0,0,0,,		皆さん  萩原さんの同期だと言っておられました	
Dialogue: 5,0:19:18.52,0:19:21.66,DefaultSingle-J,,0,0,0,,		三年前に来た時のこと覚えていらっしゃいますか	
Dialogue: 5,0:19:21.66,0:19:22.85,DefaultSingle-J,,0,0,0,,		何時頃来たとか	
Dialogue: 5,0:19:23.07,0:19:26.61,DefaultSingle-J,,0,0,0,,		毎年午後の３時過ぎくらいだったと思います	
Dialogue: 5,0:19:26.73,0:19:31.25,DefaultSingle-J,,0,0,0,,		ただどういうわけか  最近は参拝される人数が減っていき	
Dialogue: 5,0:19:31.25,0:19:32.95,DefaultSingle-J,,0,0,0,,		去年はお一人に	
Dialogue: 5,0:19:33.19,0:19:35.04,DefaultSingle-J,,0,0,0,,		寂しい限りです	
Dialogue: 5,0:19:35.04,0:19:38.08,DefaultSingle-J,,0,0,0,,		その最後の一人の名前はわかりますか	
Dialogue: 5,0:19:38.08,0:19:39.93,DefaultSingle-J,,0,0,0,,		名前は確か…	
Dialogue: 5,0:19:39.94,0:19:43.96,DefaultSingle-J,,0,0,0,,		そう  フルヤさんという方だったと思います	
Dialogue: 5,0:19:52.35,0:19:54.12,DefaultSingle-J,,0,0,0,,		フルヤレイ	
Dialogue: 5,0:19:58.47,0:20:00.87,DefaultSingle-J,,0,0,0,,		どれだけ調べてもこのとおりです	
Dialogue: 5,0:20:00.94,0:20:03.78,DefaultSingle-J,,0,0,0,,		本当にいるんですか  そのフルヤって男	
Dialogue: 5,0:20:03.90,0:20:05.98,DefaultSingle-J,,0,0,0,,		松田くんの同期だった男よ	
Dialogue: 5,0:20:06.40,0:20:09.83,DefaultSingle-J,,0,0,0,,		例え警察を辞めていたとしても  データは残っているはず	
Dialogue: 5,0:20:09.83,0:20:12.47,DefaultSingle-J,,0,0,0,,		佐藤警部補に高木巡査部長	
Dialogue: 5,0:20:13.55,0:20:14.84,DefaultSingle-J,,0,0,0,,		あなたは確か…	
Dialogue: 5,0:20:14.89,0:20:17.28,DefaultSingle-J,,0,0,0,,		警視庁公安部の風見です	
Dialogue: 5,0:20:17.28,0:20:18.66,DefaultSingle-J,,0,0,0,,		ちょっとよろしいですか	
Dialogue: 5,0:20:21.12,0:20:23.03,DefaultSingle-J,,0,0,0,,		捜査を中止しろ？	
Dialogue: 5,0:20:23.23,0:20:26.38,DefaultSingle-J,,0,0,0,,		この事件は我々公安が担当します	
Dialogue: 5,0:20:26.38,0:20:29.29,DefaultSingle-J,,0,0,0,,		バカなこと言わないで  これは私達のヤマよ	
Dialogue: 5,0:20:29.33,0:20:32.30,DefaultSingle-J,,0,0,0,,		君達にどうこう言う権利はないです	
Dialogue: 5,0:20:32.55,0:20:34.92,DefaultSingle-J,,0,0,0,,		これは要請ではなく命令ですから	
Dialogue: 5,0:20:36.53,0:20:37.95,DefaultSingle-J,,0,0,0,,		話は以上です	
Dialogue: 5,0:20:42.90,0:20:44.16,DefaultSingle-J,,0,0,0,,		冗談じゃないわ	
Dialogue: 5,0:20:44.51,0:20:46.73,DefaultSingle-J,,0,0,0,,		こんな横暴  到底承服できない	
Dialogue: 5,0:20:47.19,0:20:48.88,DefaultSingle-J,,0,0,0,,		冷静になってください	
Dialogue: 5,0:20:49.10,0:20:52.20,DefaultSingle-J,,0,0,0,,		悔しいですけど  僕らにはどうにもできません	
Dialogue: 5,0:20:52.20,0:20:54.94,DefaultSingle-J,,0,0,0,,		私は冷静よ  変なこと言わないで	
Dialogue: 5,0:20:54.99,0:20:56.15,DefaultSingle-J,,0,0,0,,		で  でも…	
Dialogue: 5,0:20:56.97,0:20:58.47,DefaultSingle-J,,0,0,0,,		ちょっと上と掛け合ってくる	
Dialogue: 5,0:20:58.85,0:21:00.05,DefaultSingle-J,,0,0,0,,		佐藤さん	
Dialogue: 5,0:21:03.08,0:21:05.41,DefaultSingle-J,,0,0,0,,		そんなに熱くなるのはやっぱり…	
Dialogue: 5,0:21:05.61,0:21:09.16,DefaultSingle-J,,0,0,0,,		松田さんが関わっているから  彼女は冷静じゃない	
Dialogue: 5,0:21:09.16,0:21:10.12,DefaultSingle-J,,0,0,0,,		白鳥さん	
Dialogue: 5,0:21:10.98,0:21:13.50,DefaultSingle-J,,0,0,0,,		なんて顔をしているようだね  君	
Dialogue: 5,0:21:14.44,0:21:15.24,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 5,0:21:15.99,0:21:18.70,DefaultSingle-J,,0,0,0,,		松田さんの名刺を見てから佐藤さん	
Dialogue: 5,0:21:18.99,0:21:21.13,DefaultSingle-J,,0,0,0,,		周りが見えていない気がして	
Dialogue: 5,0:21:22.89,0:21:25.26,DefaultSingle-J,,0,0,0,,		白鳥さん  前に言いましたよね	
Dialogue: 5,0:21:25.61,0:21:30.54,DefaultSingle-J,,0,0,0,,		彼女が松田刑事のことを引きずってる限り  我々に勝ち目はないって	
Dialogue: 5,0:21:30.54,0:21:33.15,DefaultSingle-J,,0,0,0,,		ああ  だがそれは間違いだった	
Dialogue: 5,0:21:34.43,0:21:36.83,DefaultSingle-J,,0,0,0,,		勝ち目がないのは僕だけだった	
Dialogue: 5,0:21:37.01,0:21:37.84,DefaultSingle-J,,0,0,0,,		違うかい？	
Dialogue: 5,0:21:39.73,0:21:42.67,DefaultSingle-J,,0,0,0,,		でもやっぱりダメなんですよ  僕なんかじゃあ…	
Dialogue: 5,0:21:43.27,0:21:46.10,DefaultSingle-J,,0,0,0,,		しかし君もずいぶん出世したもんだ	
Dialogue: 5,0:21:46.10,0:21:47.40,DefaultSingle-J,,0,0,0,,		出  出世？	
Dialogue: 5,0:21:47.83,0:21:51.84,DefaultSingle-J,,0,0,0,,		自ら命を賭して大勢の命を救った伝説の刑事に	
Dialogue: 5,0:21:51.84,0:21:53.28,DefaultSingle-J,,0,0,0,,		嫉妬しているんだから	
Dialogue: 5,0:21:53.28,0:21:55.47,DefaultSingle-J,,0,0,0,,		いや  僕は嫉妬なんて…	
Dialogue: 5,0:21:55.47,0:21:57.52,DefaultSingle-J,,0,0,0,,		松田刑事のことは関係ない	
Dialogue: 5,0:21:57.62,0:22:00.56,DefaultSingle-J,,0,0,0,,		事件を横取りされたのなら取り返せばいい	
Dialogue: 5,0:22:01.52,0:22:04.97,DefaultSingle-J,,0,0,0,,		急がないと佐藤さん  一人で公安に怒鳴り込むぞ	
Dialogue: 5,0:22:05.82,0:22:07.24,DefaultSingle-J,,0,0,0,,		す  すみません	
Dialogue: 5,0:22:07.29,0:22:08.57,DefaultSingle-J,,0,0,0,,		ありがとうございました	
Dialogue: 5,0:22:10.22,0:22:14.67,DefaultSingle-J,,0,0,0,,		ま  君たちの恋路は  かなり邪魔をした負い目があるからね	
Dialogue: 5,0:22:17.35,0:22:18.22,DefaultSingle-J,,0,0,0,,		小林先生	
Dialogue: 5,0:22:20.79,0:22:24.91,DefaultSingle-J,,0,0,0,,		骨は折れてなかったんだけど  頭を強く打ったみたいなの	
Dialogue: 5,0:22:25.16,0:22:29.29,DefaultSingle-J,,0,0,0,,		明日  別の病院に転院して詳しく検査を受けるんだって	
Dialogue: 5,0:22:29.53,0:22:30.50,DefaultSingle-J,,0,0,0,,		おっちゃん…	
Dialogue: 5,0:22:32.33,0:22:33.17,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,0:22:35.56,0:22:37.07,DefaultSingle-J,,0,0,0,,		どちら様ですか	
Dialogue: 5,0:22:37.23,0:22:39.11,DefaultSingle-J,,0,0,0,,		村中努と申します	
Dialogue: 5,0:22:39.41,0:22:40.91,DefaultSingle-J,,0,0,0,,		こっちはフィアンセの…	
Dialogue: 5,0:22:40.91,0:22:42.80,DefaultSingle-J,,0,0,0,,		クリスティーヌ·リシャールです	
Dialogue: 5,0:22:43.26,0:22:45.57,DefaultSingle-J,,0,0,0,,		村中さんにクリスティーヌさん…	
Dialogue: 5,0:22:46.53,0:22:48.02,DefaultSingle-J,,0,0,0,,		昨日の訓練の…	
Dialogue: 5,0:22:51.32,0:22:52.81,DefaultSingle-J,,0,0,0,,		目暮がそんなことを	
Dialogue: 5,0:22:53.35,0:22:57.02,DefaultSingle-J,,0,0,0,,		それは皆さんにもご迷惑をかけてしまって申し訳ない	
Dialogue: 5,0:22:57.23,0:22:59.07,DefaultSingle-J,,0,0,0,,		いいえ  気にしないでください	
Dialogue: 5,0:22:59.51,0:23:01.60,DefaultSingle-J,,0,0,0,,		だた  ちょっとビックリしちゃっただけで	
Dialogue: 5,0:23:01.76,0:23:03.57,DefaultSingle-J,,0,0,0,,		私からもお詫びします	
Dialogue: 5,0:23:03.85,0:23:05.40,DefaultSingle-J,,0,0,0,,		いいんです  いいんです	
Dialogue: 5,0:23:05.90,0:23:07.74,DefaultSingle-J,,0,0,0,,		日本語お上手なんですね	
Dialogue: 5,0:23:08.03,0:23:10.11,DefaultSingle-J,,0,0,0,,		両親共にフランス人ですが	
Dialogue: 5,0:23:10.11,0:23:13.22,DefaultSingle-J,,0,0,0,,		私は二十歳のときから日本で暮らしています	
Dialogue: 5,0:23:13.22,0:23:15.54,DefaultSingle-J,,0,0,0,,		彼女とは病院で出会ったんです	
Dialogue: 5,0:23:15.83,0:23:18.17,DefaultSingle-J,,0,0,0,,		肩をケガして入院してた時に	
Dialogue: 5,0:23:18.35,0:23:22.75,DefaultSingle-J,,0,0,0,,		私が診察券を失くして困っていたら  彼が見つけてくれたの	
Dialogue: 5,0:23:23.88,0:23:25.67,DefaultSingle-J,,0,0,0,,		運命の出会いですね	
Dialogue: 5,0:23:25.83,0:23:27.74,DefaultSingle-J,,0,0,0,,		まぁ  そんなところかな	
Dialogue: 5,0:23:28.55,0:23:30.80,DefaultSingle-J,,0,0,0,,		今日はどうしてここに来たの？	
Dialogue: 5,0:23:30.85,0:23:35.10,DefaultSingle-J,,0,0,0,,		実は毛利探偵には披露宴でスピーチをお願いしていたんだ	
Dialogue: 5,0:23:35.38,0:23:38.69,DefaultSingle-J,,0,0,0,,		私も彼女も眠りの小五郎の大ファンだから	
Dialogue: 5,0:23:38.69,0:23:40.27,DefaultSingle-J,,0,0,0,,		そうだったんですか	
Dialogue: 5,0:23:40.55,0:23:44.13,DefaultSingle-J,,0,0,0,,		まったく許せんよ  毛利探偵を狙うなんて	
Dialogue: 5,0:23:44.36,0:23:47.48,DefaultSingle-J,,0,0,0,,		いえ  父は狙われたわけではないんです	
Dialogue: 5,0:23:47.67,0:23:50.66,DefaultSingle-J,,0,0,0,,		爆弾の爆発から子供を守ろうとして	
Dialogue: 5,0:23:51.07,0:23:51.96,DefaultSingle-J,,0,0,0,,		なんと	
Dialogue: 5,0:23:52.07,0:23:56.44,DefaultSingle-J,,0,0,0,,		被害者の落とし物に気づいた子供がそれを拾って渡そうとしたとたん	
Dialogue: 5,0:23:56.44,0:23:57.75,DefaultSingle-J,,0,0,0,,		炎が上がったんです	
Dialogue: 5,0:23:57.97,0:24:00.18,DefaultSingle-J,,0,0,0,,		父はそれを助けようとして	
Dialogue: 5,0:24:00.33,0:24:03.92,DefaultSingle-J,,0,0,0,,		じゃ子供を救った英雄ね  眠りの小五郎は	
Dialogue: 5,0:24:04.01,0:24:05.14,DefaultSingle-J,,0,0,0,,		そうだな	
Dialogue: 5,0:24:05.65,0:24:08.29,DefaultSingle-J,,0,0,0,,		大変なときに押しかけてすみませんでした	
Dialogue: 5,0:24:08.67,0:24:11.90,DefaultSingle-J,,0,0,0,,		目を覚ましたら  毛利探偵にもよろしくお伝えください	
Dialogue: 5,0:24:11.94,0:24:12.68,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,0:24:14.14,0:24:15.43,DefaultSingle-J,,0,0,0,,		ありがとうございました	
Dialogue: 5,0:24:15.79,0:24:18.82,DefaultSingle-J,,0,0,0,,		そういえば式を挙げる場所とても素敵でした	
Dialogue: 5,0:24:18.95,0:24:19.85,DefaultSingle-J,,0,0,0,,		でしょう？	
Dialogue: 5,0:24:19.93,0:24:22.94,DefaultSingle-J,,0,0,0,,		渋谷の街が一望できて  一目で決めたの	
Dialogue: 5,0:24:23.91,0:24:25.87,DefaultSingle-J,,0,0,0,,		昨日は天気が悪くて…	
Dialogue: 5,0:24:25.97,0:24:28.70,DefaultSingle-J,,0,0,0,,		もやがかかっててよく見えなかったよね	
Dialogue: 5,0:24:28.85,0:24:29.62,DefaultSingle-J,,0,0,0,,		まあ	
Dialogue: 5,0:24:29.87,0:24:32.92,DefaultSingle-J,,0,0,0,,		だったら明日  皆さんで見学にいらっしゃらない？	
Dialogue: 5,0:24:32.93,0:24:35.96,DefaultSingle-J,,0,0,0,,		おいおい  毛利探偵がこんな時に…	
Dialogue: 5,0:24:36.37,0:24:41.12,DefaultSingle-J,,0,0,0,,		ハロウィンの飾りつけもあんなに素敵なのに\N見られないなんてかわいそうだわ	
Dialogue: 5,0:24:41.25,0:24:42.26,DefaultSingle-J,,0,0,0,,		いいでしょ？	
Dialogue: 5,0:24:42.36,0:24:44.89,DefaultSingle-J,,0,0,0,,		まぁ  君がそこまで言うなら	
Dialogue: 5,0:24:45.46,0:24:47.10,DefaultSingle-J,,0,0,0,,		ありがとうございます	
Dialogue: 5,0:24:49.43,0:24:50.94,DefaultSingle-J,,0,0,0,,		じゃあな  また明日	
Dialogue: 5,0:24:54.31,0:24:58.77,DefaultSingle-J,,0,0,0,,		お父さんが言ってたんだけど  村中さん  昔はすっごく厳しい人で	
Dialogue: 5,0:24:58.89,0:25:01.77,DefaultSingle-J,,0,0,0,,		「鬼の村中」って恐れられてたそうよ	
Dialogue: 5,0:25:02.21,0:25:03.53,DefaultSingle-J,,0,0,0,,		そうなの	
Dialogue: 5,0:25:03.53,0:25:06.31,DefaultSingle-J,,0,0,0,,		今の村上さんから想像できないね	
Dialogue: 5,0:25:06.31,0:25:09.65,DefaultSingle-J,,0,0,0,,		きっとクリスティーヌさんのおかげで優しくなったのね	
Dialogue: 5,0:25:10.75,0:25:12.19,DefaultSingle-J,,0,0,0,,		もうこんな時間	
Dialogue: 5,0:25:12.55,0:25:14.66,DefaultSingle-J,,0,0,0,,		わたし達もそろそろ帰ろっか	
Dialogue: 5,0:25:15.95,0:25:17.12,DefaultSingle-J,,0,0,0,,		蘭姉ちゃん	
Dialogue: 5,0:25:17.27,0:25:22.01,DefaultSingle-J,,0,0,0,,		ボク阿笠博士のところに泊まるから  今日はおじさんのそばにいてあげて	
Dialogue: 5,0:25:22.64,0:25:23.46,DefaultSingle-J,,0,0,0,,		でも…	
Dialogue: 5,0:25:23.52,0:25:25.47,DefaultSingle-J,,0,0,0,,		ボクは一人で大丈夫だから	
Dialogue: 5,0:25:26.62,0:25:27.56,DefaultSingle-J,,0,0,0,,		ありがとう	
Dialogue: 5,0:25:28.08,0:25:29.42,DefaultSingle-J,,0,0,0,,		じゃ気をつけてね	
Dialogue: 5,0:25:29.57,0:25:30.10,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:25:37.52,0:25:40.62,DefaultSingle-J,,0,0,0,,		そこにいるんでしょ  ボクに何か用？	
Dialogue: 5,0:25:47.27,0:25:48.09,DefaultSingle-J,,0,0,0,,		お疲れ	
Dialogue: 5,0:25:48.33,0:25:49.49,DefaultSingle-J,,0,0,0,,		お疲れ様です	
Dialogue: 5,0:25:54.94,0:25:57.08,DefaultSingle-J,,0,0,0,,		ぼ  僕も手伝います	
Dialogue: 5,0:25:57.25,0:25:58.93,DefaultSingle-J,,0,0,0,,		無理しなくていいのに	
Dialogue: 5,0:25:58.93,0:26:00.44,DefaultSingle-J,,0,0,0,,		無理なんかしてません	
Dialogue: 5,0:26:05.18,0:26:06.28,DefaultSingle-J,,0,0,0,,		死神よ	
Dialogue: 5,0:26:07.45,0:26:09.58,DefaultSingle-J,,0,0,0,,		あの連続爆破事件のように	
Dialogue: 5,0:26:09.73,0:26:12.42,DefaultSingle-J,,0,0,0,,		また最近死神がちらつきはじめて	
Dialogue: 5,0:26:12.90,0:26:16.35,DefaultSingle-J,,0,0,0,,		だからあなたの言うとおり  熱くなり過ぎてたのかも	
Dialogue: 5,0:26:16.61,0:26:17.51,DefaultSingle-J,,0,0,0,,		ごめんなさい	
Dialogue: 5,0:26:17.75,0:26:18.77,DefaultSingle-J,,0,0,0,,		佐藤さん…	
Dialogue: 5,0:26:19.15,0:26:21.35,DefaultSingle-J,,0,0,0,,		もう  こんな思いするくらいなら	
Dialogue: 5,0:26:21.45,0:26:25.28,DefaultSingle-J,,0,0,0,,		さっさと刑事辞めて  高木くんのお嫁さんになっちゃおっかな	
Dialogue: 5,0:26:25.28,0:26:26.05,DefaultSingle-J,,0,0,0,,		なんて	
Dialogue: 5,0:26:26.97,0:26:29.42,DefaultSingle-J,,0,0,0,,		そんな悲しいこと言わないでください	
Dialogue: 5,0:26:30.26,0:26:33.59,DefaultSingle-J,,0,0,0,,		刑事が事件を放り出して辞めるなんて言ったら	
Dialogue: 5,0:26:33.59,0:26:35.04,DefaultSingle-J,,0,0,0,,		負けなんじゃないですか	
Dialogue: 5,0:26:35.04,0:26:36.03,DefaultSingle-J,,0,0,0,,		高木君…	
Dialogue: 5,0:26:36.38,0:26:39.40,DefaultSingle-J,,0,0,0,,		僕は佐藤さんが負けるとこなんて見たくない	
Dialogue: 5,0:26:39.85,0:26:43.25,DefaultSingle-J,,0,0,0,,		僕が大好きで  恋焦がれているのは…	
Dialogue: 5,0:26:44.34,0:26:46.92,DefaultSingle-J,,0,0,0,,		刑事の佐藤美和子なんだから	
Dialogue: 5,0:26:48.67,0:26:51.13,DefaultSingle-J,,0,0,0,,		そ  そうだよね	
Dialogue: 5,0:26:51.89,0:26:52.87,DefaultSingle-J,,0,0,0,,		ワタル	
Dialogue: 5,0:26:53.98,0:26:56.72,DefaultSingle-J,,0,0,0,,		でもさっきの話は別ですよ	
Dialogue: 5,0:26:56.74,0:26:58.65,DefaultSingle-J,,0,0,0,,		そ  その…	
Dialogue: 5,0:26:59.33,0:27:01.82,DefaultSingle-J,,0,0,0,,		僕のお嫁さんになるって言う…	
Dialogue: 5,0:27:01.82,0:27:03.06,DefaultSingle-J,,0,0,0,,		って  いない	
Dialogue: 5,0:27:11.64,0:27:12.54,DefaultSingle-J,,0,0,0,,		降りるんだ	
Dialogue: 5,0:27:44.12,0:27:47.31,DefaultSingle-J,,0,0,0,,		こんなところに連れてきて  いったいどういうつもり	
Dialogue: 5,0:27:47.63,0:27:48.56,DefaultSingle-J,,0,0,0,,		安室さん	
Dialogue: 5,0:27:50.37,0:27:52.32,DefaultSingle-J,,0,0,0,,		やっぱりわかってたんだね	
Dialogue: 5,0:27:52.47,0:27:55.88,DefaultSingle-J,,0,0,0,,		警視庁前で起きた外国人焼死事件の捜査に	
Dialogue: 5,0:27:55.88,0:27:58.34,DefaultSingle-J,,0,0,0,,		ストップがかかったって聞いたからね	
Dialogue: 5,0:27:58.47,0:28:01.90,DefaultSingle-J,,0,0,0,,		そんなことができるのはよほどの権力者か	
Dialogue: 5,0:28:01.90,0:28:02.74,DefaultSingle-J,,0,0,0,,		あるいは…	
Dialogue: 5,0:28:02.83,0:28:03.76,DefaultSingle-J,,0,0,0,,		公安	
Dialogue: 5,0:28:05.05,0:28:09.16,DefaultSingle-J,,0,0,0,,		今度の事件には殉職した松田刑事が関わっていて	
Dialogue: 5,0:28:09.16,0:28:11.97,DefaultSingle-J,,0,0,0,,		あなたは警察学校で彼と同期だった	
Dialogue: 5,0:28:12.38,0:28:13.70,DefaultSingle-J,,0,0,0,,		さらにその件で	
Dialogue: 5,0:28:13.70,0:28:17.11,DefaultSingle-J,,0,0,0,,		捜査一課の佐藤刑事と高木刑事が動きはじめてる	
Dialogue: 5,0:28:17.11,0:28:19.94,DefaultSingle-J,,0,0,0,,		その状況を考えたら答えはすぐ出るよ	
Dialogue: 5,0:28:20.29,0:28:22.26,DefaultSingle-J,,0,0,0,,		そこまで読み切った上で	
Dialogue: 5,0:28:22.26,0:28:26.27,DefaultSingle-J,,0,0,0,,		わざと一人になり  我々に拘束される機会を作った	
Dialogue: 5,0:28:28.26,0:28:30.62,DefaultSingle-J,,0,0,0,,		君は一体何者なんだい	
Dialogue: 5,0:28:32.28,0:28:35.07,DefaultSingle-J,,0,0,0,,		そんなことより  ここはなんの施設なの？	
Dialogue: 5,0:28:35.35,0:28:37.76,DefaultSingle-J,,0,0,0,,		公安が所有する地下シェルターさ	
Dialogue: 5,0:28:38.11,0:28:41.37,DefaultSingle-J,,0,0,0,,		僕と君を隔てているガラスは特殊強化ガラス	
Dialogue: 5,0:28:41.60,0:28:43.10,DefaultSingle-J,,0,0,0,,		電波も遮断する	
Dialogue: 5,0:28:43.34,0:28:47.01,DefaultSingle-J,,0,0,0,,		ここでもし大爆発が起きたとしても  君は無傷だし	
Dialogue: 5,0:28:47.27,0:28:49.96,DefaultSingle-J,,0,0,0,,		地上の誰もそのことに気づきはしない	
Dialogue: 5,0:28:50.34,0:28:52.40,DefaultSingle-J,,0,0,0,,		その首輪みたいな物って…	
Dialogue: 5,0:28:52.48,0:28:54.38,DefaultSingle-J,,0,0,0,,		そう  爆弾だ	
Dialogue: 5,0:28:54.63,0:28:57.22,DefaultSingle-J,,0,0,0,,		時限式なのか無線式なのかも不明	
Dialogue: 5,0:28:57.48,0:28:59.19,DefaultSingle-J,,0,0,0,,		解体方法もわからない	
Dialogue: 5,0:28:59.55,0:29:01.63,DefaultSingle-J,,0,0,0,,		悔しけど  お手上げなんだ	
Dialogue: 5,0:29:02.66,0:29:06.54,DefaultSingle-J,,0,0,0,,		捜査一課の刑事さんたちが僕に会いたがっていることは知っている	
Dialogue: 5,0:29:07.07,0:29:09.50,DefaultSingle-J,,0,0,0,,		でもこれじゃ会うわけには行かないだろう	
Dialogue: 5,0:29:09.80,0:29:10.62,DefaultSingle-J,,0,0,0,,		それに	
Dialogue: 5,0:29:10.83,0:29:14.73,DefaultSingle-J,,0,0,0,,		彼らに面が割れると  潜入捜査もご破算だしね	
Dialogue: 5,0:29:15.58,0:29:18.24,DefaultSingle-J,,0,0,0,,		ポアロのアルバイトも辞めなくちゃならなくなる	
Dialogue: 5,0:29:18.73,0:29:20.51,DefaultSingle-J,,0,0,0,,		それでボクを呼んだんだ	
Dialogue: 5,0:29:20.83,0:29:23.60,DefaultSingle-J,,0,0,0,,		僕の知っている情報は全て伝える	
Dialogue: 5,0:29:23.77,0:29:26.30,DefaultSingle-J,,0,0,0,,		だから一課の捜査に協力してほしい	
Dialogue: 5,0:29:26.77,0:29:32.16,DefaultSingle-J,,0,0,0,,		で  三年前の１１月６日  安室さんは松田刑事に会ったんだよね	
Dialogue: 5,0:29:32.47,0:29:34.13,DefaultSingle-J,,0,0,0,,		ああ  会ったよ	
Dialogue: 5,0:29:34.45,0:29:36.71,DefaultSingle-J,,0,0,0,,		同期四人で  久しぶりにね	
Dialogue: 5,0:29:46.43,0:29:47.52,DefaultSingle-J,,0,0,0,,		やれやれ	
Dialogue: 5,0:29:47.60,0:29:48.82,DefaultSingle-J,,0,0,0,,		遅刻だぞ	
Dialogue: 5,0:29:49.05,0:29:50.54,DefaultSingle-J,,0,0,0,,		来ないかと思ったよ	
Dialogue: 5,0:29:50.98,0:29:51.85,DefaultSingle-J,,0,0,0,,		松田	
Dialogue: 5,0:29:52.02,0:29:53.15,DefaultSingle-J,,0,0,0,,		悪い  悪い	
Dialogue: 5,0:29:53.59,0:29:55.90,DefaultSingle-J,,0,0,0,,		事件事件で抜け出せなくってよ	
Dialogue: 5,0:29:56.14,0:29:59.64,DefaultSingle-J,,0,0,0,,		捜一に移ったんだってな  居心地はどうなんだ	
Dialogue: 5,0:29:59.68,0:30:01.40,DefaultSingle-J,,0,0,0,,		まあまあってとこかね	
Dialogue: 5,0:30:01.74,0:30:04.88,DefaultSingle-J,,0,0,0,,		俺も来月から警視庁に配属が決まったから	
Dialogue: 5,0:30:04.88,0:30:07.73,DefaultSingle-J,,0,0,0,,		下手うって追い出されないでくれよ  先輩	
Dialogue: 5,0:30:07.73,0:30:08.63,DefaultSingle-J,,0,0,0,,		バーカ	
Dialogue: 5,0:30:08.86,0:30:11.83,DefaultSingle-J,,0,0,0,,		刑事としてはお前の方が先輩だろうがよ	
Dialogue: 5,0:30:11.98,0:30:12.71,DefaultSingle-J,,0,0,0,,		でも	
Dialogue: 5,0:30:12.91,0:30:15.75,DefaultSingle-J,,0,0,0,,		松田が来てくれて  萩原も喜んでるよな	
Dialogue: 5,0:30:16.00,0:30:17.57,DefaultSingle-J,,0,0,0,,		来ねぇ訳ねぇだろう	
Dialogue: 5,0:30:18.21,0:30:20.46,DefaultSingle-J,,0,0,0,,		こいつの仇をとるって約束	
Dialogue: 5,0:30:23.39,0:30:25.56,DefaultSingle-J,,0,0,0,,		まだ果たせてねぇんだからよ	
Dialogue: 5,0:30:26.55,0:30:29.97,DefaultSingle-J,,0,0,0,,		その次の日に  あんなことが起こるなんてね	
Dialogue: 5,0:30:30.73,0:30:32.27,DefaultSingle-J,,0,0,0,,		それだけじゃないよね	
Dialogue: 5,0:30:33.25,0:30:35.31,DefaultSingle-J,,0,0,0,,		その後に何かあったんじゃない？	
Dialogue: 5,0:30:35.49,0:30:37.51,DefaultSingle-J,,0,0,0,,		爆弾に関係する事件が	
Dialogue: 5,0:30:37.59,0:30:39.19,DefaultSingle-J,,0,0,0,,		どうして  そう思うんだい？	
Dialogue: 5,0:30:39.47,0:30:40.86,DefaultSingle-J,,0,0,0,,		ちょっと調べたんだ	
Dialogue: 5,0:30:41.14,0:30:43.95,DefaultSingle-J,,0,0,0,,		お墓があるお寺は渋谷の近くだったよね	
Dialogue: 5,0:30:44.27,0:30:45.70,DefaultSingle-J,,0,0,0,,		三年前のその日	
Dialogue: 5,0:30:45.70,0:30:48.70,DefaultSingle-J,,0,0,0,,		渋谷の雑居ビルでガス漏れ騒ぎがあったって	
Dialogue: 5,0:30:49.40,0:30:51.18,DefaultSingle-J,,0,0,0,,		君の推理通りさ	
Dialogue: 5,0:30:51.71,0:30:52.71,DefaultSingle-J,,0,0,0,,		あの日…	
Dialogue: 5,0:30:54.17,0:30:55.71,DefaultSingle-J,,0,0,0,,		渋谷駅で降ろしてくれ	
Dialogue: 5,0:30:56.11,0:30:57.71,DefaultSingle-J,,0,0,0,,		あとは一人で帰るから	
Dialogue: 5,0:30:57.93,0:31:00.52,DefaultSingle-J,,0,0,0,,		悪いが送るのは駅の手前までだ	
Dialogue: 5,0:31:00.56,0:31:05.01,DefaultSingle-J,,0,0,0,,		そういや諸伏と同じく  人目についちゃいけねぇ立場だったな	
Dialogue: 5,0:31:05.79,0:31:08.56,DefaultSingle-J,,0,0,0,,		どうやら仕事のようだな  刑事さん	
Dialogue: 5,0:31:08.68,0:31:10.81,DefaultSingle-J,,0,0,0,,		ったく  なんて日だ	
Dialogue: 5,0:31:11.46,0:31:14.10,DefaultSingle-J,,0,0,0,,		僕と松田がそこに行って話を聞くと	
Dialogue: 5,0:31:14.41,0:31:19.20,DefaultSingle-J,,0,0,0,,		どうやら廃ビルの中に誰かが忍び込んで  暴れているみたいだと言っていてね	
Dialogue: 5,0:31:19.74,0:31:22.68,DefaultSingle-J,,0,0,0,,		直前まで一緒にいたあいつらも応援に呼んだけど	
Dialogue: 5,0:31:22.77,0:31:24.43,DefaultSingle-J,,0,0,0,,		彼らが到着する前に	
Dialogue: 5,0:31:24.59,0:31:28.87,DefaultSingle-J,,0,0,0,,		とりあえず  僕と松田で中の様子を見ておこうってことになったんだ	
Dialogue: 5,0:31:35.96,0:31:37.78,DefaultSingle-J,,0,0,0,,		気を失っている見たいだ	
Dialogue: 5,0:31:38.33,0:31:39.80,DefaultSingle-J,,0,0,0,,		日本人じゃねぇな	
Dialogue: 5,0:31:40.36,0:31:41.22,DefaultSingle-J,,0,0,0,,		大丈夫か	
Dialogue: 5,0:31:44.10,0:31:46.52,DefaultSingle-J,,0,0,0,,		落ち着け  俺たちは刑事だ	
Dialogue: 5,0:31:46.81,0:31:49.30,DefaultSingle-J,,0,0,0,,		刑事だ  け  い  じ	
Dialogue: 5,0:31:49.53,0:31:50.40,DefaultSingle-J,,0,0,0,,		分かるか	
Dialogue: 5,0:31:52.75,0:31:55.03,DefaultSingle-J,,0,0,0,,		ロシア語だ  逃げろと言っている	
Dialogue: 5,0:31:55.30,0:31:56.44,DefaultSingle-J,,0,0,0,,		先に降りてろ	
Dialogue: 5,0:31:56.68,0:31:59.64,DefaultSingle-J,,0,0,0,,		警察に止められたら  この名刺を見せるんだ	
Dialogue: 5,0:32:10.48,0:32:12.61,DefaultSingle-J,,0,0,0,,		まだお客さんがいるみたいだな	
Dialogue: 5,0:32:20.20,0:32:23.75,DefaultSingle-J,,0,0,0,,		さすが  なんでも持ってやがるな  公安は	
Dialogue: 5,0:32:25.73,0:32:26.54,DefaultSingle-J,,0,0,0,,		動くな	
Dialogue: 5,0:32:34.92,0:32:35.86,DefaultSingle-J,,0,0,0,,		マズイな	
Dialogue: 5,0:32:36.14,0:32:36.89,DefaultSingle-J,,0,0,0,,		なんだ	
Dialogue: 5,0:32:37.11,0:32:38.80,DefaultSingle-J,,0,0,0,,		後ろにあるのは爆弾だ	
Dialogue: 5,0:32:39.10,0:32:41.30,DefaultSingle-J,,0,0,0,,		下手に撃ったらドカンの可能性がある	
Dialogue: 5,0:32:41.59,0:32:42.83,DefaultSingle-J,,0,0,0,,		あの大きさだと	
Dialogue: 5,0:32:42.85,0:32:44.84,DefaultSingle-J,,0,0,0,,		このビルにいたらまずお陀仏だ	
Dialogue: 5,0:32:45.30,0:32:46.44,DefaultSingle-J,,0,0,0,,		止められるか	
Dialogue: 5,0:32:46.65,0:32:48.34,DefaultSingle-J,,0,0,0,,		止められないとでも？	
Dialogue: 5,0:32:49.33,0:32:50.28,DefaultSingle-J,,0,0,0,,		頼んだよ	
Dialogue: 5,0:32:56.72,0:32:57.58,DefaultSingle-J,,0,0,0,,		待て	
Dialogue: 5,0:33:00.57,0:33:03.37,DefaultSingle-J,,0,0,0,,		僕は奴を追う  松田は早く爆弾を	
Dialogue: 5,0:33:03.37,0:33:05.55,DefaultSingle-J,,0,0,0,,		ああ  そっちこそ頼むぜ	
Dialogue: 5,0:33:05.72,0:33:06.28,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:33:30.34,0:33:31.53,DefaultSingle-J,,0,0,0,,		下に降りた？	
Dialogue: 5,0:33:32.90,0:33:34.66,DefaultSingle-J,,0,0,0,,		マズイ  狙いは松田か	
Dialogue: 5,0:33:38.53,0:33:39.41,DefaultSingle-J,,0,0,0,,		テメェ	
Dialogue: 5,0:33:39.55,0:33:43.11,DefaultSingle-J,,0,0,0,,		楽しい楽しい爆弾の解体中だってのに	
Dialogue: 5,0:33:43.13,0:33:44.70,DefaultSingle-J,,0,0,0,,		邪魔してんじゃねぇ	
Dialogue: 5,0:33:46.94,0:33:47.72,DefaultSingle-J,,0,0,0,,		班長	
Dialogue: 5,0:33:47.97,0:33:51.01,DefaultSingle-J,,0,0,0,,		丸腰で  銃持ってる奴にすごんでんじゃねぇ	
Dialogue: 5,0:33:55.62,0:33:56.28,DefaultSingle-J,,0,0,0,,		ヒロ	
Dialogue: 5,0:33:56.38,0:33:57.22,DefaultSingle-J,,0,0,0,,		ゼロは無事？	
Dialogue: 5,0:33:57.45,0:33:59.15,DefaultSingle-J,,0,0,0,,		すまん  助かった	
Dialogue: 5,0:33:59.15,0:34:03.03,DefaultSingle-J,,0,0,0,,		奴がぶっ壊した車のドアを持ってきて正解だったな	
Dialogue: 5,0:34:06.79,0:34:07.67,DefaultSingle-J,,0,0,0,,		待て	
Dialogue: 5,0:34:14.18,0:34:15.03,DefaultSingle-J,,0,0,0,,		クソ	
Dialogue: 5,0:34:15.23,0:34:16.60,DefaultSingle-J,,0,0,0,,		二人ともよけろ	
Dialogue: 5,0:34:17.09,0:34:18.16,DefaultSingle-J,,0,0,0,,		逃がさないよ	
Dialogue: 5,0:34:28.19,0:34:28.96,DefaultSingle-J,,0,0,0,,		班長	
Dialogue: 5,0:34:29.24,0:34:29.96,DefaultSingle-J,,0,0,0,,		頼む	
Dialogue: 5,0:34:31.35,0:34:32.26,DefaultSingle-J,,0,0,0,,		マジかよ	
Dialogue: 5,0:34:45.39,0:34:47.00,DefaultSingle-J,,0,0,0,,		無茶しやがって	
Dialogue: 5,0:34:47.23,0:34:48.34,DefaultSingle-J,,0,0,0,,		ヒロ  班長	
Dialogue: 5,0:34:48.65,0:34:51.22,DefaultSingle-J,,0,0,0,,		まだこいつの仲間が潜んでいるかもしれない	
Dialogue: 5,0:34:51.25,0:34:52.24,DefaultSingle-J,,0,0,0,,		松田を頼む	
Dialogue: 5,0:34:52.24,0:34:53.32,DefaultSingle-J,,0,0,0,,		お  おう	
Dialogue: 5,0:34:53.39,0:34:55.10,DefaultSingle-J,,0,0,0,,		お前も気をつけろよ	
Dialogue: 5,0:34:55.10,0:34:55.70,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:34:56.01,0:34:58.83,DefaultSingle-J,,0,0,0,,		班長  俺はゼロの援護に回るよ	
Dialogue: 5,0:34:59.13,0:35:02.83,DefaultSingle-J,,0,0,0,,		奴は只者じゃない  一人で相手するにはキツイと思う	
Dialogue: 5,0:35:02.91,0:35:05.00,DefaultSingle-J,,0,0,0,,		おう  じゃあ頼むぞ	
Dialogue: 5,0:35:05.00,0:35:05.50,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:35:28.92,0:35:29.94,DefaultSingle-J,,0,0,0,,		手榴弾	
Dialogue: 5,0:35:35.81,0:35:37.41,DefaultSingle-J,,0,0,0,,		まだ逃げてるだって？	
Dialogue: 5,0:35:37.57,0:35:39.75,DefaultSingle-J,,0,0,0,,		仲間がいるかもしれんしな	
Dialogue: 5,0:35:39.75,0:35:40.65,DefaultSingle-J,,0,0,0,,		いねぇよ	
Dialogue: 5,0:35:41.40,0:35:44.03,DefaultSingle-J,,0,0,0,,		いたら俺を殺そうと戻ってこねぇだろ	
Dialogue: 5,0:35:44.12,0:35:45.66,DefaultSingle-J,,0,0,0,,		そ  そうだな	
Dialogue: 5,0:35:46.94,0:35:48.92,DefaultSingle-J,,0,0,0,,		班長  ガム持ってねぇか	
Dialogue: 5,0:35:49.33,0:35:50.74,DefaultSingle-J,,0,0,0,,		噛むと集中できる	
Dialogue: 5,0:35:51.23,0:35:52.92,DefaultSingle-J,,0,0,0,,		どいつもこいつも	
Dialogue: 5,0:35:53.38,0:35:55.79,DefaultSingle-J,,0,0,0,,		もう班長じゃねぇんだがな	
Dialogue: 5,0:36:32.82,0:36:34.34,DefaultSingle-J,,0,0,0,,		ゼロ  無事か	
Dialogue: 5,0:36:34.57,0:36:35.85,DefaultSingle-J,,0,0,0,,		ヒ  ヒロ…	
Dialogue: 5,0:36:39.01,0:36:39.63,DefaultSingle-J,,0,0,0,,		クソッ	
Dialogue: 5,0:36:40.71,0:36:41.60,DefaultSingle-J,,0,0,0,,		待て  ヒロ	
Dialogue: 5,0:36:41.84,0:36:44.82,DefaultSingle-J,,0,0,0,,		奴は手負いだ  あとは応援に任せよう	
Dialogue: 5,0:36:46.27,0:36:47.56,DefaultSingle-J,,0,0,0,,		大丈夫か  ゼロ	
Dialogue: 5,0:36:47.63,0:36:49.79,DefaultSingle-J,,0,0,0,,		ああ  助かったよ  ヒロ	
Dialogue: 5,0:36:50.64,0:36:53.19,DefaultSingle-J,,0,0,0,,		少しでも揺すったり傾けたりすると	
Dialogue: 5,0:36:53.45,0:36:55.44,DefaultSingle-J,,0,0,0,,		液体が漏れ出してドカンだ	
Dialogue: 5,0:36:55.57,0:36:57.70,DefaultSingle-J,,0,0,0,,		ごめん  取り逃してしまったよ	
Dialogue: 5,0:36:58.59,0:36:59.70,DefaultSingle-J,,0,0,0,,		大丈夫か  ゼロ	
Dialogue: 5,0:36:59.70,0:37:01.70,DefaultSingle-J,,0,0,0,,		心配ない  状況は？	
Dialogue: 5,0:37:02.00,0:37:03.70,DefaultSingle-J,,0,0,0,,		こっちもあんまりよくねぇな	
Dialogue: 5,0:37:04.21,0:37:07.71,DefaultSingle-J,,0,0,0,,		ここは俺に任せて  周辺の人達を避難させてくれ	
Dialogue: 5,0:37:07.80,0:37:08.78,DefaultSingle-J,,0,0,0,,		で  でも…	
Dialogue: 5,0:37:08.78,0:37:09.82,DefaultSingle-J,,0,0,0,,		いいから行け	
Dialogue: 5,0:37:09.82,0:37:10.96,DefaultSingle-J,,0,0,0,,		あと三分だ	
Dialogue: 5,0:37:11.04,0:37:13.04,DefaultSingle-J,,0,0,0,,		ガス漏れとか適当な理由で	
Dialogue: 5,0:37:13.04,0:37:14.91,DefaultSingle-J,,0,0,0,,		このビルの周りから避難させろ	
Dialogue: 5,0:37:15.47,0:37:16.36,DefaultSingle-J,,0,0,0,,		わかった	
Dialogue: 5,0:37:16.43,0:37:17.59,DefaultSingle-J,,0,0,0,,		行くぞ  ヒロ	
Dialogue: 5,0:37:18.69,0:37:19.82,DefaultSingle-J,,0,0,0,,		班長もだ	
Dialogue: 5,0:37:20.56,0:37:21.88,DefaultSingle-J,,0,0,0,,		わかったよ	
Dialogue: 5,0:37:22.13,0:37:22.93,DefaultSingle-J,,0,0,0,,		松田	
Dialogue: 5,0:37:23.89,0:37:26.62,DefaultSingle-J,,0,0,0,,		下で  待ってるから	
Dialogue: 5,0:37:28.43,0:37:30.33,DefaultSingle-J,,0,0,0,,		約束はできねぇな	
Dialogue: 5,0:37:30.47,0:37:31.98,DefaultSingle-J,,0,0,0,,		すぐ離れろ	
Dialogue: 5,0:38:00.23,0:38:02.01,DefaultSingle-J,,0,0,0,,		あっぶねぇ	
Dialogue: 5,0:38:10.14,0:38:11.19,DefaultSingle-J,,0,0,0,,		遠隔か	
Dialogue: 5,0:38:11.24,0:38:12.03,DefaultSingle-J,,0,0,0,,		クソッ	
Dialogue: 5,0:38:14.27,0:38:17.07,DefaultSingle-J,,0,0,0,,		こんなとき  ハギなら  あいつなら何を	
Dialogue: 5,0:38:17.33,0:38:18.82,DefaultSingle-J,,0,0,0,,		陣平ちゃん  電話	
Dialogue: 5,0:38:34.07,0:38:36.17,DefaultSingle-J,,0,0,0,,		さすがに肝冷えだぜ	
Dialogue: 5,0:38:36.74,0:38:38.42,DefaultSingle-J,,0,0,0,,		萩  ありがとな	
Dialogue: 5,0:38:38.99,0:38:42.42,DefaultSingle-J,,0,0,0,,		お前が昔やったことを  急に思い出してよ	
Dialogue: 5,0:38:46.28,0:38:48.86,DefaultSingle-J,,0,0,0,,		とっさに真似したら  うまくいったぜ	
Dialogue: 5,0:38:50.91,0:38:52.84,DefaultSingle-J,,0,0,0,,		墓参りのお礼かな	
Dialogue: 5,0:39:04.74,0:39:08.56,DefaultSingle-J,,0,0,0,,		これが四人揃った  最後の日の出来事さ	
Dialogue: 5,0:39:10.21,0:39:12.94,DefaultSingle-J,,0,0,0,,		つまり  あの被害者はそのときの…	
Dialogue: 5,0:39:13.15,0:39:14.33,DefaultSingle-J,,0,0,0,,		間違いないだろうね	
Dialogue: 5,0:39:15.01,0:39:17.98,DefaultSingle-J,,0,0,0,,		だけど  男が何者であったのかはわからない	
Dialogue: 5,0:39:18.57,0:39:21.59,DefaultSingle-J,,0,0,0,,		その事件は  一切報道されていないよね	
Dialogue: 5,0:39:21.92,0:39:24.41,DefaultSingle-J,,0,0,0,,		ガス漏れ事故で表向き処理された	
Dialogue: 5,0:39:24.53,0:39:28.34,DefaultSingle-J,,0,0,0,,		公安が介入して  全ての情報を上が封印したんだ	
Dialogue: 5,0:39:28.69,0:39:30.89,DefaultSingle-J,,0,0,0,,		回収された爆弾はどうなったの？	
Dialogue: 5,0:39:32.54,0:39:33.38,DefaultSingle-J,,0,0,0,,		これって	
Dialogue: 5,0:39:33.50,0:39:37.23,DefaultSingle-J,,0,0,0,,		爆弾は解析のため  シェルターの一つに運び込まれた	
Dialogue: 5,0:39:37.69,0:39:41.32,DefaultSingle-J,,0,0,0,,		だが  成分などを解析する前に謎の爆発があり	
Dialogue: 5,0:39:41.55,0:39:44.20,DefaultSingle-J,,0,0,0,,		関わっていた者は皆死んでしまった	
Dialogue: 5,0:39:45.52,0:39:48.93,DefaultSingle-J,,0,0,0,,		捜査に必要かもしれないから今回しか使えないけど	
Dialogue: 5,0:39:48.93,0:39:50.32,DefaultSingle-J,,0,0,0,,		風見の連絡先	
Dialogue: 5,0:39:50.65,0:39:55.24,DefaultSingle-J,,0,0,0,,		それと  あの時松田が解体していた爆弾の写真と構造	
Dialogue: 5,0:39:55.24,0:39:58.29,DefaultSingle-J,,0,0,0,,		あと僕の同僚四人が写った写真を送るよ	
Dialogue: 5,0:39:59.08,0:40:03.51,DefaultSingle-J,,0,0,0,,		左から諸伏  松田  伊達  僕を挟んで萩原だ	
Dialogue: 5,0:40:03.80,0:40:06.34,DefaultSingle-J,,0,0,0,,		あれ  この人どっかで	
Dialogue: 5,0:40:07.21,0:40:09.23,DefaultSingle-J,,0,0,0,,		そろそろお別れの時間みたいだ	
Dialogue: 5,0:40:09.55,0:40:12.16,DefaultSingle-J,,0,0,0,,		敵は想像以上に危険で手ごわい	
Dialogue: 5,0:40:12.35,0:40:14.28,DefaultSingle-J,,0,0,0,,		君にも知ってもらいたくてね	
Dialogue: 5,0:40:14.64,0:40:17.01,DefaultSingle-J,,0,0,0,,		僕はこのとおり身動きが取れない	
Dialogue: 5,0:40:17.39,0:40:18.76,DefaultSingle-J,,0,0,0,,		健闘を祈る	
Dialogue: 5,0:40:22.80,0:40:23.94,DefaultSingle-J,,0,0,0,,		すごい	
Dialogue: 5,0:40:24.13,0:40:28.49,DefaultSingle-J,,0,0,0,,		この前来た時は天気が悪くてよく見えませんでしたからね	
Dialogue: 5,0:40:29.09,0:40:30.21,DefaultSingle-J,,0,0,0,,		あそこ	
Dialogue: 5,0:40:30.21,0:40:32.70,DefaultSingle-J,,0,0,0,,		うまそうなもの売ってる店が見える	
Dialogue: 5,0:40:33.15,0:40:33.92,DefaultSingle-J,置顶,0,0,0,,		どこどこ	
Dialogue: 5,0:40:33.92,0:40:35.93,DefaultSingle-J,置顶,0,0,0,,		あそこだよ  あそこ	
Dialogue: 5,0:40:34.31,0:40:36.31,DefaultSingle-J,,0,0,0,,		騒がしくってすみません	
Dialogue: 5,0:40:35.93,0:40:38.14,DefaultSingle-J,置顶,0,0,0,,		あそこで売ってるものが見えるんですか	
Dialogue: 5,0:40:36.36,0:40:38.16,DefaultSingle-J,,0,0,0,,		にぎやかでいいですよ	
Dialogue: 5,0:40:38.34,0:40:40.72,DefaultSingle-J,,0,0,0,,		それより  毛利探偵の具合は？	
Dialogue: 5,0:40:40.73,0:40:44.96,DefaultSingle-J,,0,0,0,,		意識も戻って  今朝この近くの病院に転院しました	
Dialogue: 5,0:40:45.65,0:40:47.22,DefaultSingle-J,,0,0,0,,		いてぇ	
Dialogue: 5,0:40:47.42,0:40:49.13,DefaultSingle-J,,0,0,0,,		なんとかしてくれ	
Dialogue: 5,0:40:49.39,0:40:50.21,DefaultSingle-J,置顶,0,0,0,,		いてぇ	
Dialogue: 5,0:40:49.57,0:40:50.72,DefaultSingle-J,,0,0,0,,		おかしいわね	
Dialogue: 5,0:40:50.72,0:40:52.73,DefaultSingle-J,,0,0,0,,		もう麻酔が効くはずなんだけど	
Dialogue: 5,0:40:52.73,0:40:54.40,DefaultSingle-J,,0,0,0,,		耐性でもあるのかしら？	
Dialogue: 5,0:40:54.40,0:40:57.98,DefaultSingle-J,,0,0,0,,		痛み止めが切れて  子供みたいに大騒ぎしていますけど	
Dialogue: 5,0:40:59.81,0:41:00.98,DefaultSingle-J,,0,0,0,,		見て見て	
Dialogue: 5,0:41:00.99,0:41:02.69,DefaultSingle-J,,0,0,0,,		ヘリコプター近い	
Dialogue: 5,0:41:02.90,0:41:06.19,DefaultSingle-J,,0,0,0,,		ここヒカリエの屋上には  ヘリポートもあるんです	
Dialogue: 5,0:41:06.63,0:41:08.17,DefaultSingle-J,,0,0,0,,		披露宴が終わった後は	
Dialogue: 5,0:41:08.17,0:41:11.46,DefaultSingle-J,,0,0,0,,		ヘリで東京上空を周回する予定なんですよ	
Dialogue: 5,0:41:12.26,0:41:13.65,DefaultSingle-J,,0,0,0,,		ステキ	
Dialogue: 5,0:41:13.65,0:41:16.00,DefaultSingle-J,,0,0,0,,		ロマンチックですね	
Dialogue: 5,0:41:16.00,0:41:17.13,DefaultSingle-J,,0,0,0,,		ちょっとごめんなさい	
Dialogue: 5,0:41:17.55,0:41:18.71,DefaultSingle-J,,0,0,0,,		はい  どうしたの？	
Dialogue: 5,0:41:19.37,0:41:19.92,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 5,0:41:22.17,0:41:24.63,DefaultSingle-J,,0,0,0,,		あの  この後打ち合わせがあって	
Dialogue: 5,0:41:25.26,0:41:26.16,DefaultSingle-J,,0,0,0,,		もしもし？	
Dialogue: 5,0:41:26.65,0:41:27.46,DefaultSingle-J,,0,0,0,,		もしもし？	
Dialogue: 5,0:41:27.96,0:41:28.87,DefaultSingle-J,,0,0,0,,		どうしたんだい？	
Dialogue: 5,0:41:29.15,0:41:32.32,DefaultSingle-J,,0,0,0,,		友達がどうしても渡したいものがあるんだけど	
Dialogue: 5,0:41:32.32,0:41:34.38,DefaultSingle-J,,0,0,0,,		渋谷にいるから来てほしいって	
Dialogue: 5,0:41:34.48,0:41:36.36,DefaultSingle-J,,0,0,0,,		それは困るな	
Dialogue: 5,0:41:36.47,0:41:39.62,DefaultSingle-J,,0,0,0,,		この後  司会をする方と打ち合わせがあるのに	
Dialogue: 5,0:41:39.62,0:41:40.98,DefaultSingle-J,,0,0,0,,		そう言ったんだけど	
Dialogue: 5,0:41:41.55,0:41:43.54,DefaultSingle-J,,0,0,0,,		ボク達が行ってきましょうか	
Dialogue: 5,0:41:44.37,0:41:46.02,DefaultSingle-J,,0,0,0,,		この近くなんだよね	
Dialogue: 5,0:41:46.09,0:41:47.25,DefaultSingle-J,,0,0,0,,		いや  しかし…	
Dialogue: 5,0:41:47.25,0:41:48.65,DefaultSingle-J,,0,0,0,,		任せてくれ	
Dialogue: 5,0:41:48.94,0:41:51.16,DefaultSingle-J,,0,0,0,,		子供だからと侮るなかれ	
Dialogue: 5,0:41:51.16,0:41:53.32,DefaultSingle-J,,0,0,0,,		依頼があればなんでも引き受けます	
Dialogue: 5,0:41:53.32,0:41:56.48,DefaultSingle-J,,0,0,0,,		オレ達最強の小学一年生	
Dialogue: 5,0:41:57.31,0:42:00.41,DefaultSingle-J,,0,0,0,,		少年探偵団  参上	
Dialogue: 5,0:42:00.64,0:42:03.28,DefaultSingle-J,,0,0,0,,		いつの間に最強になったんだよ	
Dialogue: 5,0:42:03.32,0:42:05.26,DefaultSingle-J,,0,0,0,,		なら  お願いできるかしら	
Dialogue: 5,0:42:05.43,0:42:08.42,DefaultSingle-J,,0,0,0,,		今  メールで地図をもらったから  紙に描くわね	
Dialogue: 5,0:42:08.60,0:42:10.05,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,0:42:10.07,0:42:11.33,DefaultSingle-J,,0,0,0,,		すまないね	
Dialogue: 5,0:42:11.33,0:42:12.80,DefaultSingle-J,,0,0,0,,		みんなだけで大丈夫？	
Dialogue: 5,0:42:13.17,0:42:16.96,DefaultSingle-J,,0,0,0,,		わたしも行ってあげたいけど  また病院に戻らなきゃいけないの	
Dialogue: 5,0:42:17.06,0:42:19.46,DefaultSingle-J,,0,0,0,,		これくらい朝飯前だっつーの	
Dialogue: 5,0:42:19.46,0:42:20.99,DefaultSingle-J,,0,0,0,,		はい  これ地図	
Dialogue: 5,0:42:21.13,0:42:22.62,DefaultSingle-J,,0,0,0,,		ありがとうございます	
Dialogue: 5,0:42:22.62,0:42:23.82,DefaultSingle-J,,0,0,0,,		コナン君も…	
Dialogue: 5,0:42:24.35,0:42:24.94,DefaultSingle-J,,0,0,0,,		あれ	
Dialogue: 5,0:42:25.35,0:42:27.78,DefaultSingle-J,,0,0,0,,		どこ行くの？コナン君  哀ちゃん	
Dialogue: 5,0:42:35.30,0:42:36.33,DefaultSingle-J,,0,0,0,,		ここですね	
Dialogue: 5,0:42:39.17,0:42:42.58,DefaultSingle-J,,0,0,0,,		な  なんか思ってたのと違うな	
Dialogue: 5,0:42:42.93,0:42:44.60,DefaultSingle-J,,0,0,0,,		でも間違いないですよ	
Dialogue: 5,0:42:44.84,0:42:46.42,DefaultSingle-J,,0,0,0,,		ここの六階って	
Dialogue: 5,0:42:47.10,0:42:48.70,DefaultSingle-J,,0,0,0,,		とりあえず行こうぜ	
Dialogue: 5,0:42:48.70,0:42:49.40,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:42:57.82,0:42:59.03,DefaultSingle-J,,0,0,0,,		ここですね	
Dialogue: 5,0:43:01.19,0:43:02.85,DefaultSingle-J,,0,0,0,,		すみません	
Dialogue: 5,0:43:03.46,0:43:07.48,DefaultSingle-J,,0,0,0,,		クリスティーヌさんに代わってプレゼントを受け取りに来た者ですけど	
Dialogue: 5,0:43:07.79,0:43:09.66,DefaultSingle-J,,0,0,0,,		誰がいませんか	
Dialogue: 5,0:43:11.09,0:43:13.13,DefaultSingle-J,,0,0,0,,		人の気配はしないな	
Dialogue: 5,0:43:13.91,0:43:16.62,DefaultSingle-J,,0,0,0,,		プレゼントは覆われた布の中	
Dialogue: 5,0:43:16.92,0:43:18.37,DefaultSingle-J,,0,0,0,,		あれのことじゃねぇか	
Dialogue: 5,0:43:18.69,0:43:19.74,DefaultSingle-J,,0,0,0,,		大きいね	
Dialogue: 5,0:43:20.10,0:43:20.99,DefaultSingle-J,,0,0,0,,		オレが行く	
Dialogue: 5,0:43:21.32,0:43:23.09,DefaultSingle-J,,0,0,0,,		お前達はここで待っててくれ	
Dialogue: 5,0:43:23.51,0:43:25.26,DefaultSingle-J,,0,0,0,,		気をつけてください	
Dialogue: 5,0:43:36.36,0:43:37.85,DefaultSingle-J,,0,0,0,,		それがプレゼント？	
Dialogue: 5,0:43:37.87,0:43:39.19,DefaultSingle-J,,0,0,0,,		なんだ  それ？	
Dialogue: 5,0:43:39.30,0:43:40.06,DefaultSingle-J,,0,0,0,,		これは…	
Dialogue: 5,0:43:41.63,0:43:43.27,DefaultSingle-J,,0,0,0,,		爆弾だ  すぐ逃げろ	
Dialogue: 5,0:43:46.51,0:43:48.69,DefaultSingle-J,,0,0,0,,		やられた  完全に罠だ	
Dialogue: 5,0:43:48.69,0:43:50.19,DefaultSingle-J,,0,0,0,,		爆発まで二分もない	
Dialogue: 5,0:43:50.29,0:43:53.03,DefaultSingle-J,,0,0,0,,		なんとかして脱出するから先に下りててくれ	
Dialogue: 5,0:43:53.09,0:43:53.84,DefaultSingle-J,,0,0,0,,		で  でも…	
Dialogue: 5,0:43:53.84,0:43:55.49,DefaultSingle-J,,0,0,0,,		いいから早く行け	
Dialogue: 5,0:43:56.29,0:43:57.16,DefaultSingle-J,,0,0,0,,		行くわよ	
Dialogue: 5,0:43:57.79,0:43:59.93,DefaultSingle-J,,0,0,0,,		コ  コナンおいてくのかよ	
Dialogue: 5,0:43:59.93,0:44:02.63,DefaultSingle-J,,0,0,0,,		今は江戸川君の言うことを信じるしかないでしょ	
Dialogue: 5,0:44:02.90,0:44:04.92,DefaultSingle-J,,0,0,0,,		早く  時間がないわ	
Dialogue: 5,0:44:04.92,0:44:05.74,DefaultSingle-J,,0,0,0,,		クソッ	
Dialogue: 5,0:44:05.74,0:44:08.40,DefaultSingle-J,,0,0,0,,		コナン君  必ず脱出してくださいね	
Dialogue: 5,0:44:08.40,0:44:08.96,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:44:19.46,0:44:21.60,DefaultSingle-J,,0,0,0,,		このパイプを伝っていけばなんとか	
Dialogue: 5,0:44:26.31,0:44:28.68,DefaultSingle-J,,0,0,0,,		爆弾の構造はほぼ同じ	
Dialogue: 5,0:44:28.78,0:44:29.78,DefaultSingle-J,,0,0,0,,		いけるか	
Dialogue: 5,0:44:29.99,0:44:32.27,DefaultSingle-J,,0,0,0,,		いったいどうなってんだよ  これ	
Dialogue: 5,0:44:32.79,0:44:33.83,DefaultSingle-J,,0,0,0,,		江戸川君	
Dialogue: 5,0:44:35.12,0:44:35.94,DefaultSingle-J,,0,0,0,,		なんだ	
Dialogue: 5,0:44:36.59,0:44:38.05,DefaultSingle-J,,0,0,0,,		何が落ちましたよ	
Dialogue: 5,0:44:39.91,0:44:41.19,DefaultSingle-J,,0,0,0,,		なんですか  これ	
Dialogue: 5,0:44:43.08,0:44:44.95,DefaultSingle-J,,0,0,0,,		みんな  協力してくれ	
Dialogue: 5,0:44:45.08,0:44:45.99,DefaultSingle-J,,0,0,0,,		コナンくん	
Dialogue: 5,0:44:45.99,0:44:47.71,DefaultSingle-J,,0,0,0,,		どういうことだよ	
Dialogue: 5,0:44:47.87,0:44:48.61,DefaultSingle-J,,0,0,0,,		ポット？	
Dialogue: 5,0:44:48.61,0:44:49.80,DefaultSingle-J,,0,0,0,,		それをどかして	
Dialogue: 5,0:44:50.03,0:44:51.84,DefaultSingle-J,,0,0,0,,		必要なのはその布よ	
Dialogue: 5,0:44:55.54,0:44:57.67,DefaultSingle-J,,0,0,0,,		なるほど  そういうことか	
Dialogue: 5,0:44:58.66,0:45:01.26,DefaultSingle-J,,0,0,0,,		江戸川君  なるべく下におりてきて	
Dialogue: 5,0:45:01.61,0:45:04.24,DefaultSingle-J,,0,0,0,,		その高さじゃ受け止めても助からないわ	
Dialogue: 5,0:45:04.36,0:45:05.17,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:45:05.37,0:45:07.17,DefaultSingle-J,,0,0,0,,		早く早く	
Dialogue: 5,0:45:07.22,0:45:08.52,DefaultSingle-J,,0,0,0,,		わーってるよ	
Dialogue: 5,0:45:17.30,0:45:18.48,DefaultSingle-J,,0,0,0,,		江戸川君	
Dialogue: 5,0:45:18.48,0:45:19.33,DefaultSingle-J,,0,0,0,,		あつ	
Dialogue: 5,0:45:26.48,0:45:27.42,DefaultSingle-J,,0,0,0,,		コナン	
Dialogue: 5,0:45:27.49,0:45:28.37,DefaultSingle-J,,0,0,0,,		こっち	
Dialogue: 5,0:45:36.33,0:45:37.57,DefaultSingle-J,,0,0,0,,		待って  こっちよ	
Dialogue: 5,0:45:45.74,0:45:46.39,DefaultSingle-J,,0,0,0,,		痛え	
Dialogue: 5,0:45:46.51,0:45:47.69,DefaultSingle-J,,0,0,0,,		大丈夫ですか	
Dialogue: 5,0:45:48.00,0:45:48.99,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:45:49.35,0:45:50.46,DefaultSingle-J,,0,0,0,,		ありがとな	
Dialogue: 5,0:45:51.19,0:45:52.56,DefaultSingle-J,,0,0,0,,		早く逃げるわよ	
Dialogue: 5,0:45:52.56,0:45:53.37,DefaultSingle-J,,0,0,0,,		は  はい	
Dialogue: 5,0:46:02.18,0:46:03.81,DefaultSingle-J,,0,0,0,,		危なかった	
Dialogue: 5,0:46:03.81,0:46:05.14,DefaultSingle-J,,0,0,0,,		間一髪でしたね	
Dialogue: 5,0:46:05.14,0:46:07.32,DefaultSingle-J,,0,0,0,,		コナン君  無事でよかった	
Dialogue: 5,0:46:07.88,0:46:09.50,DefaultSingle-J,,0,0,0,,		コナン君  みんな	
Dialogue: 5,0:46:10.15,0:46:11.30,DefaultSingle-J,,0,0,0,,		蘭姉ちゃん	
Dialogue: 5,0:46:12.22,0:46:14.26,DefaultSingle-J,,0,0,0,,		ケガはない？みんな無事？	
Dialogue: 5,0:46:14.26,0:46:15.63,DefaultSingle-J,,0,0,0,,		うん  なんとかね	
Dialogue: 5,0:46:15.67,0:46:18.33,DefaultSingle-J,,0,0,0,,		爆弾が仕掛けられていたって本当かね	
Dialogue: 5,0:46:18.33,0:46:19.63,DefaultSingle-J,,0,0,0,,		本当だよ	
Dialogue: 5,0:46:22.12,0:46:25.09,DefaultSingle-J,,0,0,0,,		ちょ  ちょっと  そんないっぺんにしゃべらないで	
Dialogue: 5,0:46:25.09,0:46:26.65,DefaultSingle-J,,0,0,0,,		一人ずつちゃんと聞くから	
Dialogue: 5,0:46:31.08,0:46:35.01,DefaultSingle-J,,0,0,0,,		ポットの中身と上着に付いた液体の分析をしてくれない	
Dialogue: 5,0:46:43.61,0:46:46.14,DefaultSingle-J,,0,0,0,,		本当に無事でよかった	
Dialogue: 5,0:46:46.14,0:46:49.91,DefaultSingle-J,,0,0,0,,		火事になったところが君達が向かったビルだと聞いたときは	
Dialogue: 5,0:46:49.91,0:46:51.96,DefaultSingle-J,,0,0,0,,		さすがに血の気が引いたよ	
Dialogue: 5,0:46:52.15,0:46:55.29,DefaultSingle-J,,0,0,0,,		怖かったけど排水管を伝って下りたんだ	
Dialogue: 5,0:46:55.74,0:46:56.71,DefaultSingle-J,,0,0,0,,		すごいな	
Dialogue: 5,0:46:57.03,0:46:58.50,DefaultSingle-J,,0,0,0,,		俺より勇気があるね	
Dialogue: 5,0:47:03.15,0:47:04.54,DefaultSingle-J,,0,0,0,,		クリスティーヌさん	
Dialogue: 5,0:47:04.67,0:47:08.14,DefaultSingle-J,,0,0,0,,		ボク達は大丈夫だから  そんなに思い詰めないで	
Dialogue: 5,0:47:08.67,0:47:09.63,DefaultSingle-J,,0,0,0,,		ありがとう	
Dialogue: 5,0:47:10.05,0:47:11.81,DefaultSingle-J,,0,0,0,,		コナン君の話によると	
Dialogue: 5,0:47:12.08,0:47:16.48,DefaultSingle-J,,0,0,0,,		タイマー式の爆弾がいきなり作動し  部屋の扉が閉められたと	
Dialogue: 5,0:47:16.81,0:47:20.66,DefaultSingle-J,,0,0,0,,		入ってきた人間を確実に殺害するつもりだったのでしょう	
Dialogue: 5,0:47:21.55,0:47:25.99,DefaultSingle-J,,0,0,0,,		それでクリスティーヌさんに連絡してきた招待者というのは？	
Dialogue: 5,0:47:26.13,0:47:30.24,DefaultSingle-J,,0,0,0,,		確認してみたのですが  そんな連絡をした覚えはないと	
Dialogue: 5,0:47:30.24,0:47:32.73,DefaultSingle-J,,0,0,0,,		現場周辺の聞き込みをしてきます	
Dialogue: 5,0:47:32.91,0:47:36.76,DefaultSingle-J,,0,0,0,,		爆弾を運び込んだ者を見ている人がいるかもしれません	
Dialogue: 5,0:47:36.92,0:47:40.51,DefaultSingle-J,,0,0,0,,		それならもう大丈夫だ  すでに千葉がやっている	
Dialogue: 5,0:47:40.95,0:47:44.83,DefaultSingle-J,,0,0,0,,		渋谷といっても  このあたりは人通りも少なくて	
Dialogue: 5,0:47:45.02,0:47:47.30,DefaultSingle-J,,0,0,0,,		目撃者は期待薄ですか	
Dialogue: 5,0:47:51.15,0:47:52.81,DefaultSingle-J,,0,0,0,,		ちょっと  大丈夫ですか	
Dialogue: 5,0:47:56.84,0:47:58.15,DefaultSingle-J,,0,0,0,,		何をするんだ	
Dialogue: 5,0:48:17.11,0:48:18.46,DefaultSingle-J,,0,0,0,,		ああ  そうか	
Dialogue: 5,0:48:18.79,0:48:21.10,DefaultSingle-J,,0,0,0,,		また何かわかったら連絡をくれ	
Dialogue: 5,0:48:22.00,0:48:22.83,DefaultSingle-J,,0,0,0,,		目暮	
Dialogue: 5,0:48:23.10,0:48:25.84,DefaultSingle-J,,0,0,0,,		すまんがそろそろ帰らせてくれないか	
Dialogue: 5,0:48:26.33,0:48:28.14,DefaultSingle-J,,0,0,0,,		彼女が相当まいってる	
Dialogue: 5,0:48:29.25,0:48:31.00,DefaultSingle-J,,0,0,0,,		これはすまない	
Dialogue: 5,0:48:31.80,0:48:34.07,DefaultSingle-J,,0,0,0,,		帰っていただいて大丈夫です	
Dialogue: 5,0:48:34.23,0:48:34.79,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,0:48:35.13,0:48:35.80,DefaultSingle-J,置顶,0,0,0,,		立てるかい？	
Dialogue: 5,0:48:35.47,0:48:37.29,DefaultSingle-J,,0,0,0,,		仕掛けられていた爆弾…	
Dialogue: 5,0:48:36.17,0:48:36.69,DefaultSingle-J,置顶,0,0,0,,		ああ	
Dialogue: 5,0:48:37.65,0:48:41.78,DefaultSingle-J,,0,0,0,,		あれは三年前  安室さんたちが解除したものによく似ていた	
Dialogue: 5,0:48:42.64,0:48:45.50,DefaultSingle-J,,0,0,0,,		爆弾にはそれを作った者の個性が出るという	
Dialogue: 5,0:48:42.91,0:48:43.85,DefaultSingle-J,置顶,0,0,0,,		それじゃあ	
Dialogue: 5,0:48:43.94,0:48:44.64,DefaultSingle-J,置顶,0,0,0,,		ああ	
Dialogue: 5,0:48:45.32,0:48:46.48,DefaultSingle-J,置顶,0,0,0,,		お疲れ様でした	
Dialogue: 5,0:48:46.24,0:48:49.18,DefaultSingle-J,,0,0,0,,		二つの事件は同一犯の可能性が高い	
Dialogue: 5,0:48:49.93,0:48:53.18,DefaultSingle-J,,0,0,0,,		彼女には心のケアが必要かもしれんな	
Dialogue: 5,0:48:53.18,0:48:54.27,DefaultSingle-J,,0,0,0,,		そうですね	
Dialogue: 5,0:48:54.44,0:48:55.72,DefaultSingle-J,,0,0,0,,		千葉君からだわ	
Dialogue: 5,0:48:55.92,0:48:56.58,DefaultSingle-J,,0,0,0,,		もしもし	
Dialogue: 5,0:49:02.42,0:49:05.67,DefaultSingle-J,,0,0,0,,		もう一度言う  千葉刑事の身柄は預かっている	
Dialogue: 5,0:49:06.26,0:49:10.05,DefaultSingle-J,,0,0,0,,		無事に返してほしければ松田陣平刑事を連れてこい	
Dialogue: 5,0:49:10.05,0:49:11.37,DefaultSingle-J,,0,0,0,,		松田刑事？	
Dialogue: 5,0:49:11.41,0:49:12.55,DefaultSingle-J,,0,0,0,,		目的はなんだ	
Dialogue: 5,0:49:12.81,0:49:14.55,DefaultSingle-J,,0,0,0,,		千葉君は無事なんだろうな	
Dialogue: 5,0:49:15.12,0:49:16.28,DefaultSingle-J,,0,0,0,,		また連絡する	
Dialogue: 5,0:49:19.41,0:49:21.55,DefaultSingle-J,,0,0,0,,		彼は連れていきたくても…	
Dialogue: 5,0:49:21.75,0:49:23.91,DefaultSingle-J,,0,0,0,,		犯人の目的はなんだ	
Dialogue: 5,0:49:24.27,0:49:25.94,DefaultSingle-J,,0,0,0,,		どうして今ごろ松田刑事を	
Dialogue: 5,0:49:26.57,0:49:31.12,DefaultSingle-J,,0,0,0,,		確かにあの爆破事件は警察官が殉職したと報道されただけで	
Dialogue: 5,0:49:31.15,0:49:34.02,DefaultSingle-J,,0,0,0,,		松田刑事個人の名前は世に出ていない	
Dialogue: 5,0:49:34.56,0:49:35.60,DefaultSingle-J,,0,0,0,,		逆に言うと	
Dialogue: 5,0:49:35.61,0:49:37.93,DefaultSingle-J,,0,0,0,,		彼の死を知られてしまった場合…	
Dialogue: 5,0:49:38.22,0:49:40.03,DefaultSingle-J,,0,0,0,,		いったいどうすれば	
Dialogue: 5,0:49:40.26,0:49:42.54,DefaultSingle-J,,0,0,0,,		このままでは千葉君の命が…	
Dialogue: 5,0:49:42.72,0:49:43.84,DefaultSingle-J,,0,0,0,,		あの…	
Dialogue: 5,0:49:44.55,0:49:47.15,DefaultSingle-J,,0,0,0,,		僕に考えがあるんですけど	
Dialogue: 5,0:49:48.24,0:49:52.72,DefaultSingle-J,,0,0,0,,		捜査一課の刑事が拉致されるとは  さすがに予想外だったね	
Dialogue: 5,0:49:52.87,0:49:55.72,DefaultSingle-J,,0,0,0,,		コナンという少年が撮影したものです	
Dialogue: 5,0:49:56.10,0:49:59.98,DefaultSingle-J,,0,0,0,,		これを見る限り  三年前の爆弾と非常に似ています	
Dialogue: 5,0:50:00.19,0:50:02.12,DefaultSingle-J,,0,0,0,,		同一犯ということか	
Dialogue: 5,0:50:02.21,0:50:04.75,DefaultSingle-J,,0,0,0,,		奴についての資料はもう手元に	
Dialogue: 5,0:50:04.98,0:50:07.82,DefaultSingle-J,,0,0,0,,		上層部が重い腰を上げてくれてね	
Dialogue: 5,0:50:07.89,0:50:09.24,DefaultSingle-J,,0,0,0,,		さっき届いたよ	
Dialogue: 5,0:50:09.87,0:50:12.22,DefaultSingle-J,,0,0,0,,		コナン君が採取した液体火薬は	
Dialogue: 5,0:50:12.38,0:50:13.87,DefaultSingle-J,,0,0,0,,		現在  分析中です	
Dialogue: 5,0:50:14.29,0:50:17.35,DefaultSingle-J,,0,0,0,,		終わり次第  中和剤の製作に取りかかります	
Dialogue: 5,0:50:17.92,0:50:20.19,DefaultSingle-J,,0,0,0,,		命がけで採取してくれたんだ	
Dialogue: 5,0:50:20.81,0:50:22.19,DefaultSingle-J,,0,0,0,,		無駄にはできない	
Dialogue: 5,0:50:22.67,0:50:24.25,DefaultSingle-J,,0,0,0,,		これからどうしますか	
Dialogue: 5,0:50:24.55,0:50:28.23,DefaultSingle-J,,0,0,0,,		一課と協力して拉致された刑事を無事取り返すんだ	
Dialogue: 5,0:50:28.71,0:50:32.09,DefaultSingle-J,,0,0,0,,		我々の持っている情報は全て開示して構わない	
Dialogue: 5,0:50:32.40,0:50:33.27,DefaultSingle-J,,0,0,0,,		わかりました	
Dialogue: 5,0:50:35.88,0:50:38.30,DefaultSingle-J,,0,0,0,,		とりあえずこちらも手を尽くした	
Dialogue: 5,0:50:38.73,0:50:41.42,DefaultSingle-J,,0,0,0,,		さぁ  君はどう動く	
Dialogue: 5,0:50:42.15,0:50:44.62,DefaultSingle-J,,0,0,0,,		本気なんですか  危険すぎます	
Dialogue: 5,0:50:44.62,0:50:46.33,DefaultSingle-J,,0,0,0,,		危険は承知の上だ	
Dialogue: 5,0:50:46.47,0:50:48.99,DefaultSingle-J,,0,0,0,,		だが  隠しマイクも発信器もつける	
Dialogue: 5,0:50:49.30,0:50:51.90,DefaultSingle-J,,0,0,0,,		何かあればすぐ我々が駆けつけられるように…	
Dialogue: 5,0:50:51.90,0:50:53.87,DefaultSingle-J,,0,0,0,,		間に合わなかったらどうするんですか	
Dialogue: 5,0:50:55.04,0:50:57.10,DefaultSingle-J,,0,0,0,,		もしまた三年前のときみたいに…	
Dialogue: 5,0:50:57.10,0:50:57.99,DefaultSingle-J,,0,0,0,,		佐藤くん	
Dialogue: 5,0:50:59.43,0:51:00.74,DefaultSingle-J,,0,0,0,,		大丈夫ですよ	
Dialogue: 5,0:51:01.25,0:51:03.74,DefaultSingle-J,,0,0,0,,		自分  わりと悪運強いんで	
Dialogue: 5,0:51:04.75,0:51:07.33,DefaultSingle-J,,0,0,0,,		この状況で千葉を助けられるのは	
Dialogue: 5,0:51:07.98,0:51:09.42,DefaultSingle-J,,0,0,0,,		僕だけなんですから	
Dialogue: 5,0:51:10.41,0:51:14.59,DefaultSingle-J,,0,0,0,,		今  公安の風見君から捜査協力の申し出があった	
Dialogue: 5,0:51:15.01,0:51:17.84,DefaultSingle-J,,0,0,0,,		ここからは公安と合同で動くことになる	
Dialogue: 5,0:51:18.06,0:51:20.76,DefaultSingle-J,,0,0,0,,		なんとしても千葉を無事に取り返すぞ	
Dialogue: 5,0:51:20.88,0:51:21.48,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,0:51:21.78,0:51:22.71,DefaultSingle-J,,0,0,0,,		行きましょう	
Dialogue: 5,0:51:24.16,0:51:26.09,DefaultSingle-J,,0,0,0,,		絶対に死なせたりしないから	
Dialogue: 5,0:51:26.72,0:51:28.18,DefaultSingle-J,,0,0,0,,		ねぇ  佐藤刑事	
Dialogue: 5,0:51:28.70,0:51:32.33,DefaultSingle-J,,0,0,0,,		これって警視庁の前で起きた爆破事件の証拠品？	
Dialogue: 5,0:51:32.39,0:51:33.36,DefaultSingle-J,,0,0,0,,		ええ  そうよ	
Dialogue: 5,0:51:33.65,0:51:36.01,DefaultSingle-J,,0,0,0,,		後で植え込みの中で見つけたらしいの	
Dialogue: 5,0:51:36.34,0:51:38.11,DefaultSingle-J,,0,0,0,,		何かのメモかしらね	
Dialogue: 5,0:51:38.37,0:51:41.87,DefaultSingle-J,,0,0,0,,		「ある人に伝えたいとても大事なメモなんだって」	
Dialogue: 5,0:51:42.38,0:51:46.31,DefaultSingle-J,,0,0,0,,		これが  松田刑事に見せたかったメッセージ？	
Dialogue: 5,0:52:01.91,0:52:05.14,DefaultSingle-J,,0,0,0,,		それで  こんなところに集めてどうしようっていうの？	
Dialogue: 5,0:52:05.35,0:52:06.89,DefaultSingle-J,,0,0,0,,		情報交換だ	
Dialogue: 5,0:52:08.19,0:52:10.46,DefaultSingle-J,,0,0,0,,		フルヤという男に会わせてくれるの？	
Dialogue: 5,0:52:10.55,0:52:11.85,DefaultSingle-J,,0,0,0,,		それはできない	
Dialogue: 5,0:52:12.00,0:52:14.41,DefaultSingle-J,,0,0,0,,		彼は今  隔離された施設にいる	
Dialogue: 5,0:52:14.73,0:52:16.90,DefaultSingle-J,,0,0,0,,		首に爆弾をつけられているので	
Dialogue: 5,0:52:21.22,0:52:24.81,DefaultSingle-J,,0,0,0,,		先月  君達が逮捕した連続爆破犯が	
Dialogue: 5,0:52:24.81,0:52:27.04,DefaultSingle-J,,0,0,0,,		何者かの手引きにより脱走した	
Dialogue: 5,0:52:27.44,0:52:31.47,DefaultSingle-J,,0,0,0,,		降谷はこの男を追跡中  何者かに襲われ	
Dialogue: 5,0:52:31.47,0:52:33.58,DefaultSingle-J,,0,0,0,,		首輪型の爆弾をつけられた	
Dialogue: 5,0:52:33.87,0:52:35.79,DefaultSingle-J,,0,0,0,,		それで？逃走した男は？	
Dialogue: 5,0:52:36.02,0:52:40.44,DefaultSingle-J,,0,0,0,,		降谷がつけられたものと同型の爆弾が爆発し  死亡した	
Dialogue: 5,0:52:40.44,0:52:41.32,DefaultSingle-J,,0,0,0,,		そんな…	
Dialogue: 5,0:52:41.32,0:52:45.51,DefaultSingle-J,,0,0,0,,		一連の動きは何者かによる罠だと我々は見ている	
Dialogue: 5,0:52:45.54,0:52:47.18,DefaultSingle-J,,0,0,0,,		降谷を誘い出すための	
Dialogue: 5,0:52:47.81,0:52:49.17,DefaultSingle-J,,0,0,0,,		分析の結果	
Dialogue: 5,0:52:49.17,0:52:54.54,DefaultSingle-J,,0,0,0,,		首輪爆弾には二液混合式の特殊爆薬が使われているとわかった	
Dialogue: 5,0:52:54.59,0:52:58.60,DefaultSingle-J,,0,0,0,,		同種の爆弾は三年前の事件にも使用されている	
Dialogue: 5,0:52:59.35,0:53:03.53,DefaultSingle-J,,0,0,0,,		で  いったい何者なんだ？君らは突き止めているんだろう？	
Dialogue: 5,0:53:03.53,0:53:05.66,DefaultSingle-J,,0,0,0,,		正体不明の殺し屋だ	
Dialogue: 5,0:53:05.86,0:53:09.07,DefaultSingle-J,,0,0,0,,		国籍  性別  年齢  すべて不明	
Dialogue: 5,0:53:09.11,0:53:12.71,DefaultSingle-J,,0,0,0,,		世界中で活動しているが  活動拠点はロシアで	
Dialogue: 5,0:53:12.77,0:53:15.12,DefaultSingle-J,,0,0,0,,		「プラーミャ」と呼ばれ恐れられている	
Dialogue: 5,0:53:15.14,0:53:18.92,DefaultSingle-J,,0,0,0,,		ねぇ  「プラーミャ」ってロシア語で「炎」って意味だよね	
Dialogue: 5,0:53:19.15,0:53:23.14,DefaultSingle-J,,0,0,0,,		その人の使う爆薬って爆発するとどんな感じになるの？	
Dialogue: 5,0:53:23.14,0:53:25.96,DefaultSingle-J,,0,0,0,,		その少年もここに連れてきたんですか	
Dialogue: 5,0:53:26.29,0:53:28.93,DefaultSingle-J,,0,0,0,,		怪しげな爆弾を二度も見た目撃者ですから	
Dialogue: 5,0:53:29.19,0:53:31.34,DefaultSingle-J,,0,0,0,,		連れてきた方が早いかと思いまして	
Dialogue: 5,0:53:32.37,0:53:34.75,DefaultSingle-J,,0,0,0,,		それで  爆弾はどんな感じなの？	
Dialogue: 5,0:53:34.82,0:53:38.13,DefaultSingle-J,,0,0,0,,		燃焼力  爆発力  共に非常に強い	
Dialogue: 5,0:53:38.34,0:53:42.19,DefaultSingle-J,,0,0,0,,		液体が混じり合った瞬間  爆発し  一気に燃え広がる	
Dialogue: 5,0:53:43.08,0:53:46.86,DefaultSingle-J,,0,0,0,,		それって  ボクらが見た外国の人の時とよく似てるよ	
Dialogue: 5,0:53:46.88,0:53:48.94,DefaultSingle-J,,0,0,0,,		あの警視庁前で殺害された？	
Dialogue: 5,0:53:48.97,0:53:49.58,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,0:53:49.77,0:53:52.48,DefaultSingle-J,,0,0,0,,		だが  なぜわざわざ警視庁の前に	
Dialogue: 5,0:53:52.48,0:53:53.32,DefaultSingle-J,,0,0,0,,		そういえば	
Dialogue: 5,0:53:53.32,0:53:57.09,DefaultSingle-J,,0,0,0,,		被害者がなぜ警視庁を訪ねてきたのかも不明なままね	
Dialogue: 5,0:53:58.33,0:54:00.09,DefaultSingle-J,,0,0,0,,		ヒントはこの名刺じゃない？	
Dialogue: 5,0:54:00.53,0:54:01.53,DefaultSingle-J,,0,0,0,,		松田君？	
Dialogue: 5,0:54:01.87,0:54:05.22,DefaultSingle-J,,0,0,0,,		あの外国の人  松田刑事に会いにきたんじゃない？	
Dialogue: 5,0:54:05.73,0:54:09.47,DefaultSingle-J,,0,0,0,,		リスクを冒してでも松田刑事の協力が必要だった	
Dialogue: 5,0:54:09.59,0:54:11.08,DefaultSingle-J,,0,0,0,,		それはつまり…	
Dialogue: 5,0:54:11.21,0:54:14.76,DefaultSingle-J,,0,0,0,,		あの被害者と今回千葉君を拉致した犯人たちは…	
Dialogue: 5,0:54:14.76,0:54:16.35,DefaultSingle-J,,0,0,0,,		なんらかの繋がりがある	
Dialogue: 5,0:54:17.30,0:54:19.78,DefaultSingle-J,,0,0,0,,		今日の雑居ビル爆破事件だが	
Dialogue: 5,0:54:19.80,0:54:24.86,DefaultSingle-J,,0,0,0,,		それにもプラーミャが使う特殊爆弾が使用された可能性が高いとのことだ	
Dialogue: 5,0:54:25.39,0:54:29.94,DefaultSingle-J,,0,0,0,,		コナン君達がやってきたのは  プラーミャにとっても予想外のことだった	
Dialogue: 5,0:54:30.19,0:54:32.60,DefaultSingle-J,,0,0,0,,		本当はそこで村中夫妻を…	
Dialogue: 5,0:54:32.72,0:54:35.79,DefaultSingle-J,,0,0,0,,		あいつの結婚式には脅迫状が来ていた	
Dialogue: 5,0:54:35.83,0:54:38.70,DefaultSingle-J,,0,0,0,,		やはり  プラーミャの狙いは村中夫婦	
Dialogue: 5,0:54:39.22,0:54:40.01,DefaultSingle-J,,0,0,0,,		ただ	
Dialogue: 5,0:54:40.01,0:54:44.00,DefaultSingle-J,,0,0,0,,		外国人焼死事件や千葉の拉致とどう関わってくるのか	
Dialogue: 5,0:54:44.00,0:54:45.45,DefaultSingle-J,,0,0,0,,		まだわかってません	
Dialogue: 5,0:54:45.45,0:54:50.22,DefaultSingle-J,,0,0,0,,		それにプラーミャは降谷って人の消息だって知っているくらいだから	
Dialogue: 5,0:54:50.39,0:54:54.22,DefaultSingle-J,,0,0,0,,		きっと松田刑事の殉職も知っていると思うけど	
Dialogue: 5,0:54:54.50,0:54:59.50,DefaultSingle-J,,0,0,0,,		ねぇ  その降谷って人の同期のうち  四人は亡くなっているんだよね	
Dialogue: 5,0:54:59.70,0:55:03.55,DefaultSingle-J,,0,0,0,,		松田刑事と爆発物処理班の萩原隊員は	
Dialogue: 5,0:55:03.55,0:55:04.94,DefaultSingle-J,,0,0,0,,		爆発物解体中に	
Dialogue: 5,0:55:05.15,0:55:06.99,DefaultSingle-J,,0,0,0,,		伊達刑事は交通事故	
Dialogue: 5,0:55:07.42,0:55:09.35,DefaultSingle-J,,0,0,0,,		諸伏って人はどうだったの？	
Dialogue: 5,0:55:09.42,0:55:10.49,DefaultSingle-J,,0,0,0,,		諸伏？	
Dialogue: 5,0:55:10.69,0:55:13.80,DefaultSingle-J,,0,0,0,,		申し訳ないが  それは極秘扱いだ	
Dialogue: 5,0:55:13.84,0:55:15.62,DefaultSingle-J,,0,0,0,,		相変わらず秘密主義なのね	
Dialogue: 5,0:55:15.93,0:55:17.26,DefaultSingle-J,,0,0,0,,		これだけは言える	
Dialogue: 5,0:55:17.37,0:55:19.62,DefaultSingle-J,,0,0,0,,		今回の事件とは無関係だ	
Dialogue: 5,0:55:19.74,0:55:21.19,DefaultSingle-J,,0,0,0,,		それを信じろと？	
Dialogue: 5,0:55:21.27,0:55:22.39,DefaultSingle-J,,0,0,0,,		まあ待て	
Dialogue: 5,0:55:22.50,0:55:25.00,DefaultSingle-J,,0,0,0,,		今は千葉君の救出が最優先だ	
Dialogue: 5,0:55:25.09,0:55:29.38,DefaultSingle-J,,0,0,0,,		高木君はこの爆弾の解体方法を頭に叩き込んでおけ	
Dialogue: 5,0:55:29.49,0:55:30.99,DefaultSingle-J,,0,0,0,,		解析してるんだよな	
Dialogue: 5,0:55:30.99,0:55:32.64,DefaultSingle-J,,0,0,0,,		すぐ資料を用意する	
Dialogue: 5,0:55:32.82,0:55:34.66,DefaultSingle-J,,0,0,0,,		わ  わかりました	
Dialogue: 5,0:55:35.19,0:55:36.98,DefaultSingle-J,,0,0,0,,		と言いたいんですが	
Dialogue: 5,0:55:37.09,0:55:42.94,DefaultSingle-J,,0,0,0,,		実は僕  科学・工学系が全然ダメで  その上不器用なんですよ	
Dialogue: 5,0:55:42.94,0:55:45.93,DefaultSingle-J,,0,0,0,,		それでよく松田君になろうだなんて	
Dialogue: 5,0:55:45.93,0:55:50.53,DefaultSingle-J,,0,0,0,,		あの  具体的に松田さんってどんな感じの方だったんですか	
Dialogue: 5,0:55:51.09,0:55:53.66,DefaultSingle-J,,0,0,0,,		ワイルドだけど意外に優しくて	
Dialogue: 5,0:55:53.71,0:55:57.07,DefaultSingle-J,,0,0,0,,		柴犬とドーベルマンを足して２で割った感じかな	
Dialogue: 5,0:55:57.29,0:55:58.04,DefaultSingle-J,,0,0,0,,		はい？	
Dialogue: 5,0:56:04.73,0:56:05.60,DefaultSingle-J,,0,0,0,,		もしもし	
Dialogue: 5,0:56:05.82,0:56:06.92,DefaultSingle-J,,0,0,0,,		松田に代われ	
Dialogue: 5,0:56:07.24,0:56:10.07,DefaultSingle-J,,0,0,0,,		その前に千葉君の声を聞かせてくれない？	
Dialogue: 5,0:56:10.07,0:56:11.88,DefaultSingle-J,,0,0,0,,		松田に代わるのが先だ	
Dialogue: 5,0:56:11.97,0:56:15.63,DefaultSingle-J,,0,0,0,,		ぐずぐずしているとこの刑事の声が永遠に聞けなくなるぞ	
Dialogue: 5,0:56:17.87,0:56:18.88,DefaultSingle-J,,0,0,0,,		もしもし	
Dialogue: 5,0:56:19.10,0:56:21.69,DefaultSingle-J,,0,0,0,,		これからしばらく言うとおりに動いてもらう	
Dialogue: 5,0:56:21.86,0:56:24.04,DefaultSingle-J,,0,0,0,,		すぐにミヤシタパーク前へ向かえ	
Dialogue: 5,0:56:24.40,0:56:25.63,DefaultSingle-J,,0,0,0,,		また電話する	
Dialogue: 5,0:56:27.47,0:56:28.16,DefaultSingle-J,,0,0,0,,		行こう	
Dialogue: 5,0:56:29.04,0:56:31.70,DefaultSingle-J,,0,0,0,,		君達は面が割れている恐れがある	
Dialogue: 5,0:56:32.08,0:56:34.95,DefaultSingle-J,,0,0,0,,		尾行には我々公安の捜査員を使う	
Dialogue: 5,0:56:35.19,0:56:39.24,DefaultSingle-J,,0,0,0,,		高木巡査部長以外は離れたところでモニターで確認を	
Dialogue: 5,0:56:43.34,0:56:44.64,DefaultSingle-J,,0,0,0,,		お願いします	
Dialogue: 5,0:56:44.98,0:56:46.28,DefaultSingle-J,,0,0,0,,		お願いします	
Dialogue: 5,0:56:52.78,0:56:53.43,DefaultSingle-J,,0,0,0,,		どうだ	
Dialogue: 5,0:56:53.92,0:56:55.60,DefaultSingle-J,,0,0,0,,		不審な者はいないか	
Dialogue: 5,0:56:55.97,0:56:58.22,DefaultSingle-J,,0,0,0,,		いえ  今のところは何も	
Dialogue: 5,0:56:58.40,0:56:59.70,DefaultSingle-J,,0,0,0,,		気を抜くなよ	
Dialogue: 5,0:56:59.95,0:57:02.48,DefaultSingle-J,,0,0,0,,		どんな相手で何人いるかもわからない	
Dialogue: 5,0:57:02.66,0:57:03.64,DefaultSingle-J,,0,0,0,,		了解しました	
Dialogue: 5,0:57:04.56,0:57:06.48,DefaultSingle-J,,0,0,0,,		トリック·オア·トリート	
Dialogue: 5,0:57:06.63,0:57:18.03,DefaultSingle-J,,0,0,0,,		トリック·オア·トリート  トリック·オア·トリート…	
Dialogue: 5,0:57:18.13,0:57:18.96,DefaultSingle-J,,0,0,0,,		なんだ	
Dialogue: 5,0:57:19.13,0:57:20.54,DefaultSingle-J,,0,0,0,,		ハロウィンのイベント？	
Dialogue: 5,0:57:20.67,0:57:24.22,DefaultSingle-J,,0,0,0,,		トリック·オア·トリート	
Dialogue: 5,0:57:25.74,0:57:27.56,DefaultSingle-J,,0,0,0,,		わあ  お菓子だ	
Dialogue: 5,0:57:27.58,0:57:28.54,DefaultSingle-J,,0,0,0,,		ちょーだい	
Dialogue: 5,0:57:29.22,0:57:30.65,DefaultSingle-J,,0,0,0,,		あれ  新商品の	
Dialogue: 5,0:57:30.65,0:57:31.88,DefaultSingle-J,,0,0,0,,		タダでもらえんの？	
Dialogue: 5,0:57:33.87,0:57:36.43,DefaultSingle-J,,0,0,0,,		ハロウィンのイベントだと？聞いてないぞ	
Dialogue: 5,0:57:36.43,0:57:37.60,DefaultSingle-J,,0,0,0,,		早くやめさせろ	
Dialogue: 5,0:57:37.66,0:57:39.54,DefaultSingle-J,,0,0,0,,		いっぱい落ちてる	
Dialogue: 5,0:57:39.54,0:57:40.72,DefaultSingle-J,,0,0,0,,		やった	
Dialogue: 5,0:57:40.74,0:57:42.27,DefaultSingle-J,,0,0,0,,		美味しい	
Dialogue: 5,0:57:50.55,0:57:52.49,DefaultSingle-J,,0,0,0,,		何をやっている  早く向かえ	
Dialogue: 5,0:57:52.49,0:57:54.99,DefaultSingle-J,,0,0,0,,		それが…人が多すぎて…	
Dialogue: 5,0:57:54.99,0:57:56.73,DefaultSingle-J,,0,0,0,,		急げ  見失うぞ	
Dialogue: 5,0:57:58.54,0:57:59.49,DefaultSingle-J,,0,0,0,,		ま  待て	
Dialogue: 5,0:58:11.13,0:58:14.63,DefaultSingle-J,,0,0,0,,		それで  アルバイトでイベントに協力してくれないかと？	
Dialogue: 5,0:58:14.86,0:58:15.47,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 5,0:58:15.47,0:58:19.12,DefaultSingle-J,,0,0,0,,		お金をはずむから少しの間だけ協力してくれって	
Dialogue: 5,0:58:19.12,0:58:20.37,DefaultSingle-J,,0,0,0,,		佐藤警部補	
Dialogue: 5,0:58:21.50,0:58:22.77,DefaultSingle-J,,0,0,0,,		これを見てくれ	
Dialogue: 5,0:58:23.14,0:58:25.39,DefaultSingle-J,,0,0,0,,		高木巡査部長がつけていた物だ	
Dialogue: 5,0:58:29.33,0:58:32.07,DefaultSingle-J,,0,0,0,,		警察犬を連れてきて  においを追跡します	
Dialogue: 5,0:58:32.54,0:58:33.73,DefaultSingle-J,,0,0,0,,		よろしいですね	
Dialogue: 5,0:58:34.55,0:58:35.22,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,0:59:11.02,0:59:12.73,DefaultSingle-J,,0,0,0,,		地下貯水槽…	
Dialogue: 5,0:59:17.95,0:59:19.41,DefaultSingle-J,,0,0,0,,		かぶり物を取れ	
Dialogue: 5,0:59:20.67,0:59:21.82,DefaultSingle-J,,0,0,0,,		やれやれ	
Dialogue: 5,0:59:22.24,0:59:23.99,DefaultSingle-J,,0,0,0,,		とんだハロウィンだな	
Dialogue: 5,0:59:25.06,0:59:27.91,DefaultSingle-J,,0,0,0,,		柴犬とドーベルマン  柴犬とドーベルマン	
Dialogue: 5,0:59:28.11,0:59:29.42,DefaultSingle-J,,0,0,0,,		松田刑事ね	
Dialogue: 5,0:59:29.85,0:59:31.18,DefaultSingle-J,,0,0,0,,		千葉の無事を確認させ…	
Dialogue: 5,0:59:31.18,0:59:32.42,DefaultSingle-J,,0,0,0,,		こちらへ来なさい	
Dialogue: 5,0:59:36.71,0:59:39.76,DefaultSingle-J,,0,0,0,,		麻酔か何かで眠らされているだけか	
Dialogue: 5,0:59:40.62,0:59:42.08,DefaultSingle-J,,0,0,0,,		わかった  わかった	
Dialogue: 5,0:59:42.29,0:59:44.06,DefaultSingle-J,,0,0,0,,		んじゃあ聞かせてもらおうか	
Dialogue: 5,0:59:44.43,0:59:47.16,DefaultSingle-J,,0,0,0,,		こうしてまで俺を呼びつけたわけをよ	
Dialogue: 5,0:59:47.47,0:59:50.31,DefaultSingle-J,,0,0,0,,		手荒なことをして悪かった  お詫びする	
Dialogue: 5,0:59:51.17,0:59:54.07,DefaultSingle-J,,0,0,0,,		デカを拉致ってどの口がそれを言うかね	
Dialogue: 5,0:59:54.47,0:59:57.32,DefaultSingle-J,,0,0,0,,		松田刑事  わかってくれとは言わない	
Dialogue: 5,0:59:57.60,1:00:00.87,DefaultSingle-J,,0,0,0,,		だが  我々にはもうこれしか手がないのだ	
Dialogue: 5,1:00:08.28,1:00:10.74,DefaultSingle-J,,0,0,0,,		私はエレニカ・ラブレンチエワ	
Dialogue: 5,1:00:11.28,1:00:14.21,DefaultSingle-J,,0,0,0,,		プラーミャを追ってロシアから日本に来た	
Dialogue: 5,1:00:21.55,1:00:22.55,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 5,1:00:22.79,1:00:27.33,DefaultSingle-J,,0,0,0,,		そこまでされちゃあ  話を聞かないわけにはいかねぇな	
Dialogue: 5,1:00:28.53,1:00:30.08,DefaultSingle-J,,0,0,0,,		難しいですね	
Dialogue: 5,1:00:30.48,1:00:34.06,DefaultSingle-J,,0,0,0,,		かなりたくさんの人が集まったのとお菓子の匂いが邪魔をして	
Dialogue: 5,1:00:34.19,1:00:36.78,DefaultSingle-J,,0,0,0,,		一刻も早く追わねばならんのに	
Dialogue: 5,1:00:38.63,1:00:39.32,DefaultSingle-J,,0,0,0,,		もしもし	
Dialogue: 5,1:00:39.32,1:00:41.57,DefaultSingle-J,,0,0,0,,		場所がわかりました  地下貯水槽です	
Dialogue: 5,1:00:41.75,1:00:42.81,DefaultSingle-J,,0,0,0,,		なんですって？	
Dialogue: 5,1:00:42.82,1:00:44.65,DefaultSingle-J,,0,0,0,,		発信元は不明なんですが	
Dialogue: 5,1:00:44.65,1:00:47.56,DefaultSingle-J,,0,0,0,,		突然監視画面に映像が入り込んできたんです	
Dialogue: 5,1:00:48.05,1:00:52.19,DefaultSingle-J,,0,0,0,,		プラーミャは特殊な液体火薬を使う恐ろしいテロリストだ	
Dialogue: 5,1:00:52.63,1:00:55.47,DefaultSingle-J,,0,0,0,,		奴の手によって殺された者は数知れず	
Dialogue: 5,1:00:56.52,1:00:59.51,DefaultSingle-J,,0,0,0,,		私の家族もまた  奴に殺された	
Dialogue: 5,1:01:00.15,1:01:03.58,DefaultSingle-J,,0,0,0,,		ここにいる者は皆  あの忌まわしい爆弾によって	
Dialogue: 5,1:01:03.58,1:01:06.26,DefaultSingle-J,,0,0,0,,		家族や大切な人を殺された者達だ	
Dialogue: 5,1:01:06.69,1:01:09.60,DefaultSingle-J,,0,0,0,,		そしてプラーミャへの復讐を誓い	
Dialogue: 5,1:01:10.15,1:01:12.20,DefaultSingle-J,,0,0,0,,		共に立ち上がった同志だ	
Dialogue: 5,1:01:26.26,1:01:29.81,DefaultSingle-J,,0,0,0,,		我々は独自とプラーミャの追跡を行っている	
Dialogue: 5,1:01:30.06,1:01:31.76,DefaultSingle-J,,0,0,0,,		そう言うことか	
Dialogue: 5,1:01:32.10,1:01:33.96,DefaultSingle-J,,0,0,0,,		彼らは民間人の集まり	
Dialogue: 5,1:01:34.41,1:01:37.10,DefaultSingle-J,,0,0,0,,		だから入手できる情報も限られていて	
Dialogue: 5,1:01:37.14,1:01:39.46,DefaultSingle-J,,0,0,0,,		松田刑事の殉職も知らなかったんだ	
Dialogue: 5,1:01:39.83,1:01:41.42,DefaultSingle-J,,0,0,0,,		事情はわかった	
Dialogue: 5,1:01:41.56,1:01:43.47,DefaultSingle-J,,0,0,0,,		で  俺に何をしろと？	
Dialogue: 5,1:01:43.83,1:01:47.00,DefaultSingle-J,,0,0,0,,		プラーミャが作った爆弾について教えてほしい	
Dialogue: 5,1:01:47.55,1:01:51.72,DefaultSingle-J,,0,0,0,,		あなたは三年前  ビルに仕掛けられた爆弾を解除している	
Dialogue: 5,1:01:52.08,1:01:55.31,DefaultSingle-J,,0,0,0,,		その爆弾の構造を私達に教えてもらいたい	
Dialogue: 5,1:01:55.41,1:01:56.48,DefaultSingle-J,,0,0,0,,		なるほど	
Dialogue: 5,1:01:56.83,1:02:00.62,DefaultSingle-J,,0,0,0,,		特性をつかめば  どこかに仕掛けるか事前に予測できる	
Dialogue: 5,1:02:01.11,1:02:04.24,DefaultSingle-J,,0,0,0,,		そうすれば奴を捕まえられるかもしれない	
Dialogue: 5,1:02:05.99,1:02:08.62,DefaultSingle-J,,0,0,0,,		警察に協力するつもりはないのかい？	
Dialogue: 5,1:02:08.97,1:02:10.99,DefaultSingle-J,,0,0,0,,		警察は信用できない	
Dialogue: 5,1:02:12.88,1:02:17.69,DefaultSingle-J,,0,0,0,,		警視庁の前で死んだ外国人  彼も君達の仲間なのか	
Dialogue: 5,1:02:19.01,1:02:21.13,DefaultSingle-J,,0,0,0,,		彼は私の兄  オレグだ	
Dialogue: 5,1:02:22.07,1:02:24.38,DefaultSingle-J,,0,0,0,,		プラーミャには一つの決まりがある	
Dialogue: 5,1:02:24.67,1:02:26.52,DefaultSingle-J,,0,0,0,,		爆破を決行する前に	
Dialogue: 5,1:02:26.52,1:02:30.39,DefaultSingle-J,,0,0,0,,		準備に使ったアジトに火をつけ  証拠を隠滅するのだ	
Dialogue: 5,1:02:30.71,1:02:33.85,DefaultSingle-J,,0,0,0,,		数カ月前  兄はそのアジトを見つけ	
Dialogue: 5,1:02:34.37,1:02:35.66,DefaultSingle-J,,0,0,0,,		一人で向かった	
Dialogue: 5,1:02:39.46,1:02:42.32,DefaultSingle-J,,0,0,0,,		兄はタブレットを持ち出すことに成功した	
Dialogue: 5,1:02:43.09,1:02:49.04,DefaultSingle-J,,0,0,0,,		そこには爆弾の設計図らしきものと東京に関係があるものが映ったらしい	
Dialogue: 5,1:02:49.63,1:02:52.15,DefaultSingle-J,,0,0,0,,		だが  数秒で画面が消えてしまい	
Dialogue: 5,1:02:52.15,1:02:55.13,DefaultSingle-J,,0,0,0,,		そこからはまったく反応しなくなったと言っていた	
Dialogue: 5,1:02:56.08,1:02:59.72,DefaultSingle-J,,0,0,0,,		それで  東京のことは東京の者に訊くのが早いと	
Dialogue: 5,1:03:00.15,1:03:01.76,DefaultSingle-J,,0,0,0,,		警視庁に向かったのだ	
Dialogue: 5,1:03:02.74,1:03:05.55,DefaultSingle-J,,0,0,0,,		だからあのタブレットは少し焦げていたのか	
Dialogue: 5,1:03:06.19,1:03:10.25,DefaultSingle-J,,0,0,0,,		だが  彼を殺した爆弾はあのタブレットに仕掛けられていた	
Dialogue: 5,1:03:10.71,1:03:11.57,DefaultSingle-J,,0,0,0,,		つまり	
Dialogue: 5,1:03:11.79,1:03:14.74,DefaultSingle-J,,0,0,0,,		奪われることを想定した罠だったってことだ	
Dialogue: 5,1:03:15.61,1:03:17.13,DefaultSingle-J,,0,0,0,,		事情はわかった	
Dialogue: 5,1:03:17.51,1:03:21.39,DefaultSingle-J,,0,0,0,,		だが  君の兄は三年前の事件の現場にもいた	
Dialogue: 5,1:03:21.41,1:03:23.13,DefaultSingle-J,,0,0,0,,		それはどういうわけだ	
Dialogue: 5,1:03:23.14,1:03:25.94,DefaultSingle-J,,0,0,0,,		あれは  私達が仕掛けた作戦だった	
Dialogue: 5,1:03:26.37,1:03:28.45,DefaultSingle-J,,0,0,0,,		プラーミャにビル爆破を依頼し	
Dialogue: 5,1:03:28.67,1:03:31.70,DefaultSingle-J,,0,0,0,,		その現場で奴を捕まえるつもりだったのだ	
Dialogue: 5,1:03:31.90,1:03:34.24,DefaultSingle-J,,0,0,0,,		だが失敗し  逃げられた	
Dialogue: 5,1:03:34.67,1:03:38.27,DefaultSingle-J,,0,0,0,,		俺達はその尻拭いをさせられたってわけか	
Dialogue: 5,1:03:38.27,1:03:39.96,DefaultSingle-J,,0,0,0,,		兄はいつも言っていた	
Dialogue: 5,1:03:40.54,1:03:42.96,DefaultSingle-J,,0,0,0,,		松田という刑事にもう一度会いたい	
Dialogue: 5,1:03:43.22,1:03:47.47,DefaultSingle-J,,0,0,0,,		あいつは我々ができなかった  プラーミャの爆弾を止めたんだと	
Dialogue: 5,1:03:47.92,1:03:50.49,DefaultSingle-J,,0,0,0,,		それで私達はあなたのことを調べ	
Dialogue: 5,1:03:50.49,1:03:53.71,DefaultSingle-J,,0,0,0,,		昔の顔写真などのわずかな情報を手に入れた	
Dialogue: 5,1:03:54.26,1:03:57.05,DefaultSingle-J,,0,0,0,,		そして  あなたをここに呼んだのだ	
Dialogue: 5,1:03:57.06,1:03:58.83,DefaultSingle-J,,0,0,0,,		これは光栄だねぇ	
Dialogue: 5,1:03:59.53,1:04:02.86,DefaultSingle-J,,0,0,0,,		私の命より大事な家族を殺されたんだ	
Dialogue: 5,1:04:03.38,1:04:04.77,DefaultSingle-J,,0,0,0,,		なんだってやるさ	
Dialogue: 5,1:04:05.94,1:04:08.53,DefaultSingle-J,,0,0,0,,		話は終わりだ  さっさと描いてもらおう	
Dialogue: 5,1:04:10.03,1:04:11.58,DefaultSingle-J,,0,0,0,,		描きたくねぇな	
Dialogue: 5,1:04:12.44,1:04:15.92,DefaultSingle-J,,0,0,0,,		アンタらの個人的な恨みに付き合ってらんねぇんだよ	
Dialogue: 5,1:04:21.94,1:04:24.88,DefaultSingle-J,,0,0,0,,		松田刑事  あなたに選択肢はない	
Dialogue: 5,1:04:25.27,1:04:27.45,DefaultSingle-J,,0,0,0,,		千葉刑事がどうなってもいいと？	
Dialogue: 5,1:04:27.51,1:04:30.42,DefaultSingle-J,,0,0,0,,		アンタらじゃ荷が重いって言ってんだよ	
Dialogue: 5,1:04:30.95,1:04:34.16,DefaultSingle-J,,0,0,0,,		ちゃんと捕まえて罰を受けてもらうからよ	
Dialogue: 5,1:04:34.67,1:04:37.26,DefaultSingle-J,,0,0,0,,		警察に任せろって言ってんだ	
Dialogue: 5,1:04:39.72,1:04:41.20,DefaultSingle-J,,0,0,0,,		ま  松田さん？	
Dialogue: 5,1:04:41.20,1:04:43.04,DefaultSingle-J,,0,0,0,,		ウソ  俺  死んじゃったの？	
Dialogue: 5,1:04:43.04,1:04:43.91,DefaultSingle-J,,0,0,0,,		死んだ？	
Dialogue: 5,1:04:44.51,1:04:46.81,DefaultSingle-J,,0,0,0,,		だって  松田さんはとっくに殉職して…	
Dialogue: 5,1:04:46.81,1:04:47.82,DefaultSingle-J,,0,0,0,,		バカ  千葉…	
Dialogue: 5,1:04:54.37,1:04:55.44,DefaultSingle-J,,0,0,0,,		警察だ	
Dialogue: 5,1:04:55.44,1:04:56.89,DefaultSingle-J,,0,0,0,,		全員そこを動くな	
Dialogue: 5,1:05:01.96,1:05:03.92,DefaultSingle-J,,0,0,0,,		そこまでにしておいたら？	
Dialogue: 5,1:05:04.35,1:05:08.34,DefaultSingle-J,,0,0,0,,		みんなが争うことで一番得をするのはプラーミャだよ	
Dialogue: 5,1:05:08.96,1:05:10.09,DefaultSingle-J,往边上移一下，放在主台词的位置会引人误会,0,0,0,,		コナン君？	
Dialogue: 5,1:05:10.47,1:05:12.50,DefaultSingle-J,,0,0,0,,		じゃあ  さっきの映像も君が？	
Dialogue: 5,1:05:19.93,1:05:20.47,DefaultSingle-J,,0,0,0,,		来るな	
Dialogue: 5,1:05:21.80,1:05:24.00,DefaultSingle-J,,0,0,0,,		ここは子供が来るところじゃない	
Dialogue: 5,1:05:30.99,1:05:31.82,DefaultSingle-J,,0,0,0,,		しまった	
Dialogue: 5,1:05:31.82,1:05:32.57,DefaultSingle-J,,0,0,0,,		なに	
Dialogue: 5,1:05:32.57,1:05:34.41,DefaultSingle-J,,0,0,0,,		すぐ明かりを用意するんだ	
Dialogue: 5,1:05:34.60,1:05:35.45,DefaultSingle-J,,0,0,0,,		逃がすな	
Dialogue: 5,1:05:35.45,1:05:37.07,DefaultSingle-J,,0,0,0,,		上だ  上へ行ったぞ	
Dialogue: 5,1:05:37.07,1:05:38.12,DefaultSingle-J,,0,0,0,,		追うんだ	
Dialogue: 5,1:05:41.63,1:05:42.43,DefaultSingle-J,,0,0,0,,		クソ	
Dialogue: 5,1:05:49.11,1:05:50.36,DefaultSingle-J,,0,0,0,,		電源を探せ	
Dialogue: 5,1:05:50.36,1:05:51.19,DefaultSingle-J,,0,0,0,,		急げ	
Dialogue: 5,1:05:51.19,1:05:52.51,DefaultSingle-J,,0,0,0,,		人質は無事か	
Dialogue: 5,1:05:52.79,1:05:54.26,DefaultSingle-J,,0,0,0,,		おい  いくぞ	
Dialogue: 5,1:05:56.03,1:05:57.23,DefaultSingle-J,,0,0,0,,		ここです	
Dialogue: 5,1:05:57.79,1:05:58.78,DefaultSingle-J,,0,0,0,,		高木君	
Dialogue: 5,1:05:58.91,1:05:59.88,DefaultSingle-J,,0,0,0,,		大丈夫？	
Dialogue: 5,1:06:00.78,1:06:02.41,DefaultSingle-J,,0,0,0,,		ええ  なんとか	
Dialogue: 5,1:06:02.74,1:06:07.29,DefaultSingle-J,,0,0,0,,		途中まではマカデミー賞ものの演技だと思ったんですけどね	
Dialogue: 5,1:06:07.64,1:06:09.13,DefaultSingle-J,,0,0,0,,		最後の最後で…	
Dialogue: 5,1:06:09.97,1:06:11.94,DefaultSingle-J,,0,0,0,,		とにかく  無事でよかった	
Dialogue: 5,1:06:14.39,1:06:15.55,DefaultSingle-J,,0,0,0,,		大丈夫か	
Dialogue: 5,1:06:15.91,1:06:17.55,DefaultSingle-J,,0,0,0,,		ありがとうございます	
Dialogue: 5,1:06:22.09,1:06:23.37,DefaultSingle-J,,0,0,0,,		息子…	
Dialogue: 5,1:06:29.87,1:06:32.80,DefaultSingle-J,,0,0,0,,		もう  心配したんだから	
Dialogue: 5,1:06:33.55,1:06:36.12,DefaultSingle-J,,0,0,0,,		な  苗子ちゃん  僕は大丈夫だから	
Dialogue: 5,1:06:38.02,1:06:40.40,DefaultSingle-J,,0,0,0,,		な  なんか  すみません	
Dialogue: 5,1:06:42.57,1:06:45.29,DefaultSingle-J,,0,0,0,,		それで  逃走したグループの行方は？	
Dialogue: 5,1:06:45.48,1:06:47.31,DefaultSingle-J,,0,0,0,,		全力で追わせているが	
Dialogue: 5,1:06:48.47,1:06:52.07,DefaultSingle-J,,0,0,0,,		式は中止しよう  皆の安全が第一だ	
Dialogue: 5,1:06:52.33,1:06:55.84,DefaultSingle-J,,0,0,0,,		しかし  プラーミャが君を狙っていることは間違いない	
Dialogue: 5,1:06:56.30,1:06:58.35,DefaultSingle-J,,0,0,0,,		今後二人には警護をつける	
Dialogue: 5,1:06:58.51,1:07:00.07,DefaultSingle-J,,0,0,0,,		よろしくお願いするよ	
Dialogue: 5,1:07:01.75,1:07:04.06,DefaultSingle-J,,0,0,0,,		あなた  こんなものがメッセージで	
Dialogue: 5,1:07:05.92,1:07:08.96,DefaultSingle-J,,0,0,0,,		「結婚式は予定どおり行うこと」	
Dialogue: 5,1:07:09.04,1:07:10.70,DefaultSingle-J,,0,0,0,,		「もし中止した場合」	
Dialogue: 5,1:07:11.38,1:07:14.22,DefaultSingle-J,,0,0,0,,		「より多くの犠牲者が出ることになるだろう」	
Dialogue: 5,1:07:15.01,1:07:16.16,DefaultSingle-J,,0,0,0,,		なんだって？	
Dialogue: 5,1:07:18.33,1:07:20.77,DefaultSingle-J,,0,0,0,,		結局  結婚式はやるんだね	
Dialogue: 5,1:07:20.79,1:07:23.39,DefaultSingle-J,,0,0,0,,		うん  今はそうするしかないわ	
Dialogue: 5,1:07:23.62,1:07:24.30,DefaultSingle-J,,0,0,0,,		でも	
Dialogue: 5,1:07:24.63,1:07:27.89,DefaultSingle-J,,0,0,0,,		プラーミャの好きにはさせない  絶対に捕まえてやるから	
Dialogue: 5,1:07:28.20,1:07:31.15,DefaultSingle-J,,0,0,0,,		なぜだ  なぜ  プラーミャはこんなことを	
Dialogue: 5,1:07:31.58,1:07:34.44,DefaultSingle-J,,0,0,0,,		村中さんの結婚式が中止になったとしても	
Dialogue: 5,1:07:34.44,1:07:36.90,DefaultSingle-J,,0,0,0,,		別の場所で狙えばいいだけの話	
Dialogue: 5,1:07:37.32,1:07:39.49,DefaultSingle-J,,0,0,0,,		どうして結婚式にこだわるんだ	
Dialogue: 5,1:07:40.29,1:07:42.84,DefaultSingle-J,,0,0,0,,		どうしたの  コナン君  怖い顔して	
Dialogue: 5,1:07:43.05,1:07:44.64,DefaultSingle-J,,0,0,0,,		な  なんでもないよ	
Dialogue: 5,1:07:45.27,1:07:46.05,DefaultSingle-J,,0,0,0,,		電話だ	
Dialogue: 5,1:07:46.45,1:07:47.59,DefaultSingle-J,,0,0,0,,		じゃあ帰るね	
Dialogue: 5,1:07:48.01,1:07:49.43,DefaultSingle-J,,0,0,0,,		気をつけて帰ってね	
Dialogue: 5,1:07:49.43,1:07:50.17,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,1:07:51.79,1:07:54.55,DefaultSingle-J,,0,0,0,,		そっちから連絡してくるとは思わなかったよ	
Dialogue: 5,1:07:54.89,1:07:57.42,DefaultSingle-J,,0,0,0,,		一刻も早く君に伝えたくてね	
Dialogue: 5,1:07:57.75,1:08:00.83,DefaultSingle-J,,0,0,0,,		プラーミャを追う組織の情報をつかんだんだ	
Dialogue: 5,1:08:01.33,1:08:03.97,DefaultSingle-J,,0,0,0,,		組織の名は「ナーダ・ウニチトージティ」	
Dialogue: 5,1:08:04.26,1:08:07.18,DefaultSingle-J,,0,0,0,,		ロシアからヨーロッパにかけてのネットワークを持ち	
Dialogue: 5,1:08:07.22,1:08:09.81,DefaultSingle-J,,0,0,0,,		独自にプラーミャを追跡してたようだ	
Dialogue: 5,1:08:09.89,1:08:11.93,DefaultSingle-J,,0,0,0,,		ナーダ・ウニチトージティ	
Dialogue: 5,1:08:11.97,1:08:13.67,DefaultSingle-J,,0,0,0,,		息の根を止めねば	
Dialogue: 5,1:08:13.81,1:08:15.88,DefaultSingle-J,,0,0,0,,		プラーミャの息の根を  ってことか	
Dialogue: 5,1:08:15.89,1:08:18.07,DefaultSingle-J,,0,0,0,,		リーダーはエレニカと名乗る女性	
Dialogue: 5,1:08:18.66,1:08:20.82,DefaultSingle-J,,0,0,0,,		顔に火傷のあとが残っている	
Dialogue: 5,1:08:21.06,1:08:24.36,DefaultSingle-J,,0,0,0,,		プラーミャへの煮え切らない各国警察の対応に	
Dialogue: 5,1:08:24.36,1:08:29.33,DefaultSingle-J,,0,0,0,,		苛立ちを募らせた彼女らは  報復のため組織を立ち上げたんだ	
Dialogue: 5,1:08:29.52,1:08:30.24,DefaultSingle-J,,0,0,0,,		ただ	
Dialogue: 5,1:08:30.24,1:08:34.92,DefaultSingle-J,,0,0,0,,		いかに民間組織とはいえ  プラーミャにとってはかなり嫌な相手だ	
Dialogue: 5,1:08:35.13,1:08:39.34,DefaultSingle-J,,0,0,0,,		世界中どこまでも追ってきて  仕事の邪魔をするのだから	
Dialogue: 5,1:08:39.54,1:08:42.99,DefaultSingle-J,,0,0,0,,		日本で起きている爆破事件も関係しているのかも	
Dialogue: 5,1:08:43.17,1:08:46.08,DefaultSingle-J,,0,0,0,,		外国人焼死事件や雑居ビルの爆弾	
Dialogue: 5,1:08:46.28,1:08:49.10,DefaultSingle-J,,0,0,0,,		ビルの爆弾については少し引っかかるんだ	
Dialogue: 5,1:08:49.35,1:08:52.36,DefaultSingle-J,,0,0,0,,		僕なら時限式ではなく無線式を使う	
Dialogue: 5,1:08:52.38,1:08:54.35,DefaultSingle-J,,0,0,0,,		その方が確実だからね	
Dialogue: 5,1:08:54.55,1:08:58.44,DefaultSingle-J,,0,0,0,,		そして今度はわざわざ向こうから警察に連絡を入れてきた	
Dialogue: 5,1:08:59.15,1:09:01.61,DefaultSingle-J,,0,0,0,,		プラーミャにはなんらかの意図があるはず	
Dialogue: 5,1:09:01.81,1:09:02.62,DefaultSingle-J,,0,0,0,,		もう一つ	
Dialogue: 5,1:09:02.71,1:09:05.77,DefaultSingle-J,,0,0,0,,		安室さんに首輪爆弾をはめた理由もわからない	
Dialogue: 5,1:09:06.02,1:09:08.13,DefaultSingle-J,,0,0,0,,		三年前の復讐をしたいなら	
Dialogue: 5,1:09:08.13,1:09:10.96,DefaultSingle-J,,0,0,0,,		おびき出したあの場所ですぐに殺すはずでしょ？	
Dialogue: 5,1:09:11.14,1:09:14.12,DefaultSingle-J,,0,0,0,,		それについては僕もずっと考えているんだ	
Dialogue: 5,1:09:14.50,1:09:16.82,DefaultSingle-J,,0,0,0,,		焼死事件の証拠のメモは見た？	
Dialogue: 5,1:09:16.82,1:09:17.38,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,1:09:17.60,1:09:20.47,DefaultSingle-J,,0,0,0,,		あれが何を意味しているのかもまだわからないね	
Dialogue: 5,1:09:20.82,1:09:22.83,DefaultSingle-J,,0,0,0,,		だけどもう結婚式までの時間が…	
Dialogue: 5,1:09:22.83,1:09:24.50,DefaultSingle-J,,0,0,0,,		僕の友人が言ってたよ	
Dialogue: 5,1:09:25.51,1:09:27.96,DefaultSingle-J,,0,0,0,,		焦りこそ最大のトラップだって	
Dialogue: 5,1:09:28.87,1:09:32.52,DefaultSingle-J,,0,0,0,,		この程度の危機  君は何度も乗り越えてきたんだろ？	
Dialogue: 5,1:09:33.63,1:09:34.80,DefaultSingle-J,,0,0,0,,		健闘を祈る	
Dialogue: 5,1:09:38.99,1:09:40.28,DefaultSingle-J,,0,0,0,,		遅くなりました	
Dialogue: 5,1:09:40.77,1:09:43.44,DefaultSingle-J,,0,0,0,,		さすがにここにいるのも飽きてきたしね	
Dialogue: 5,1:09:43.90,1:09:46.17,DefaultSingle-J,,0,0,0,,		頼んだよ  風見	
Dialogue: 5,1:09:47.78,1:09:50.58,DefaultSingle-J,,0,0,0,,		そして  結婚式当日	
Dialogue: 5,1:09:57.28,1:09:59.17,DefaultSingle-J,,0,0,0,,		ハッピハロウィン	
Dialogue: 5,1:11:08.10,1:11:10.87,DefaultSingle-J,,0,0,0,,		なんだか大変なことになっちゃったね	
Dialogue: 5,1:11:11.09,1:11:11.92,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,1:11:12.45,1:11:16.37,DefaultSingle-J,,0,0,0,,		結婚式は村中さんとクリスティーヌさんだけでやるんだって	
Dialogue: 5,1:11:16.51,1:11:17.64,DefaultSingle-J,,0,0,0,,		そっか	
Dialogue: 5,1:11:17.94,1:11:21.18,DefaultSingle-J,,0,0,0,,		せっかくの結婚式なのに  かわいそう	
Dialogue: 5,1:11:24.46,1:11:26.65,DefaultSingle-J,,0,0,0,,		こっちはのんきなものね	
Dialogue: 5,1:11:27.72,1:11:29.01,DefaultSingle-J,,0,0,0,,		このメモ  なに？	
Dialogue: 5,1:11:30.96,1:11:34.66,DefaultSingle-J,,0,0,0,,		警視庁前で爆発が起きた時に  目の前に落ちてきたメモを	
Dialogue: 5,1:11:34.66,1:11:36.42,DefaultSingle-J,,0,0,0,,		思い出して  ちょっと書いてみたの	
Dialogue: 5,1:11:36.42,1:11:38.14,DefaultSingle-J,,0,0,0,,		蘭姉ちゃん  メモを見たの	
Dialogue: 5,1:11:38.33,1:11:40.69,DefaultSingle-J,,0,0,0,,		見たといってもチラッとだけよ	
Dialogue: 5,1:11:40.99,1:11:43.90,DefaultSingle-J,,0,0,0,,		英語じゃないみたいで  なんだかよくわからなくて	
Dialogue: 5,1:11:44.13,1:11:47.03,DefaultSingle-J,,0,0,0,,		お父さんが起きたら聞いてみようと思ってたんだけど	
Dialogue: 5,1:11:47.47,1:11:49.44,DefaultSingle-J,,0,0,0,,		円マークじゃなかった	
Dialogue: 5,1:11:49.85,1:11:51.42,DefaultSingle-J,,0,0,0,,		この図形  どこかで…	
Dialogue: 5,1:11:55.87,1:11:57.00,DefaultSingle-J,,0,0,0,,		コナン君？	
Dialogue: 5,1:12:03.14,1:12:06.00,DefaultSingle-J,,0,0,0,,		村中のところに脅迫状が来ているんだ	
Dialogue: 5,1:12:06.00,1:12:10.25,DefaultSingle-J,,0,0,0,,		えっと  ある人に伝えたいとても大事なメモなんだって	
Dialogue: 5,1:12:10.25,1:12:11.61,DefaultSingle-J,,0,0,0,,		ロシア語で	
Dialogue: 5,1:12:11.61,1:12:14.01,DefaultSingle-J,,0,0,0,,		彼女とは病院で出会ったんです	
Dialogue: 5,1:12:14.01,1:12:16.35,DefaultSingle-J,,0,0,0,,		肩をケガして入院してた時に	
Dialogue: 5,1:12:16.44,1:12:18.17,DefaultSingle-J,,0,0,0,,		運命の出会いですね	
Dialogue: 5,1:12:18.17,1:12:19.50,DefaultSingle-J,,0,0,0,,		まあ  そんなところか	
Dialogue: 5,1:12:19.50,1:12:23.71,DefaultSingle-J,,0,0,0,,		被害者の落とし物に気づいた子供がそれを拾って渡そうとしたとたん	
Dialogue: 5,1:12:23.71,1:12:25.00,DefaultSingle-J,,0,0,0,,		炎が上がったんです	
Dialogue: 5,1:12:25.00,1:12:27.86,DefaultSingle-J,,0,0,0,,		友達がどうしても渡したいものがあるんだけど	
Dialogue: 5,1:12:27.86,1:12:30.98,DefaultSingle-J,,0,0,0,,		これが  松田刑事に見せたかったメッセージ？	
Dialogue: 5,1:12:30.98,1:12:35.02,DefaultSingle-J,,0,0,0,,		コナンくんたちがやってきたのはプラーミャにとっても予想外のことだった	
Dialogue: 5,1:12:35.02,1:12:36.70,DefaultSingle-J,,0,0,0,,		本当はそこで村中夫婦を…	
Dialogue: 5,1:12:36.70,1:12:38.69,DefaultSingle-J,,0,0,0,,		プラーミャへの復讐を誓い	
Dialogue: 5,1:12:38.69,1:12:40.78,DefaultSingle-J,,0,0,0,,		共に立ち上がった同志だ	
Dialogue: 5,1:12:40.93,1:12:44.00,DefaultSingle-J,,0,0,0,,		「結婚式は予定どおり行うこと」	
Dialogue: 5,1:12:44.50,1:12:46.20,DefaultSingle-J,,0,0,0,,		「もし中止した場合」	
Dialogue: 5,1:12:47.75,1:12:50.73,DefaultSingle-J,,0,0,0,,		「より多くの犠牲者が出ることになるだろう」	
Dialogue: 5,1:12:54.26,1:12:55.32,DefaultSingle-J,,0,0,0,,		ここだ	
Dialogue: 5,1:12:55.71,1:12:57.39,DefaultSingle-J,,0,0,0,,		ここに答えがあったんだ	
Dialogue: 5,1:12:57.88,1:12:59.05,DefaultSingle-J,,0,0,0,,		コナンくん	
Dialogue: 5,1:12:59.76,1:13:01.28,DefaultSingle-J,,0,0,0,,		どうしたの一体	
Dialogue: 5,1:13:01.43,1:13:02.56,DefaultSingle-J,,0,0,0,,		これを見て	
Dialogue: 5,1:13:02.97,1:13:05.69,DefaultSingle-J,,0,0,0,,		ハロウィン当日の交通規制区間だよ	
Dialogue: 5,1:13:06.05,1:13:10.50,DefaultSingle-J,,0,0,0,,		道玄坂下のＹ字路から宮益坂方向に道が伸びてるでしょ	
Dialogue: 5,1:13:10.50,1:13:11.10,DefaultSingle-J,,0,0,0,,		うん	
Dialogue: 5,1:13:11.14,1:13:13.55,DefaultSingle-J,,0,0,0,,		そこにまず神宮通りが交差	
Dialogue: 5,1:13:13.63,1:13:17.00,DefaultSingle-J,,0,0,0,,		渋谷駅のガードをくぐった明治通りも交差する	
Dialogue: 5,1:13:17.47,1:13:19.68,DefaultSingle-J,,0,0,0,,		これを90度回転すると	
Dialogue: 5,1:13:20.11,1:13:21.79,DefaultSingle-J,,0,0,0,,		円マークになるわね	
Dialogue: 5,1:13:22.02,1:13:26.09,DefaultSingle-J,,0,0,0,,		ボクが見た燃え残ったメモは  ここのラインがちょうど燃えていたから	
Dialogue: 5,1:13:26.09,1:13:28.03,DefaultSingle-J,,0,0,0,,		円マークと勘違いしてたんだ	
Dialogue: 5,1:13:28.25,1:13:29.01,DefaultSingle-J,,0,0,0,,		でも	
Dialogue: 5,1:13:29.01,1:13:33.09,DefaultSingle-J,,0,0,0,,		村中さん達が結婚式を挙げるヒカリエは渋谷にあるんだし	
Dialogue: 5,1:13:33.49,1:13:36.49,DefaultSingle-J,,0,0,0,,		わざわざそんな絵を描かなくても	
Dialogue: 5,1:13:36.49,1:13:38.35,DefaultSingle-J,,0,0,0,,		いや  ヒカリエだけじゃない	
Dialogue: 5,1:13:38.81,1:13:40.90,DefaultSingle-J,,0,0,0,,		もしかしたら  その周辺一帯も…	
Dialogue: 5,1:13:43.41,1:13:46.21,DefaultSingle-J,,0,0,0,,		コナン君  まるで新一みたいなこと言うね	
Dialogue: 5,1:13:47.51,1:13:49.75,DefaultSingle-J,,0,0,0,,		って  新一兄ちゃんが言ってたんだ	
Dialogue: 5,1:13:49.75,1:13:52.54,DefaultSingle-J,,0,0,0,,		また新一に事件のこと相談してたの？	
Dialogue: 5,1:13:52.54,1:13:53.61,DefaultSingle-J,,0,0,0,,		う  うん	
Dialogue: 5,1:13:53.82,1:13:56.87,DefaultSingle-J,,0,0,0,,		それと  もう一つの謎も解けたって言ってたよ	
Dialogue: 5,1:13:57.38,1:14:00.23,DefaultSingle-J,,0,0,0,,		ボクが巻き込まれそうになったビルの爆発	
Dialogue: 5,1:14:00.36,1:14:03.50,DefaultSingle-J,,0,0,0,,		やっぱりあれは村中さんを狙ったものじゃなかった	
Dialogue: 5,1:14:03.53,1:14:04.83,DefaultSingle-J,,0,0,0,,		どういうこと？	
Dialogue: 5,1:14:04.93,1:14:07.63,DefaultSingle-J,,0,0,0,,		あれは最初からボク達を狙ってたんだ	
Dialogue: 5,1:14:08.02,1:14:11.25,DefaultSingle-J,,0,0,0,,		この証拠のメモを目撃した可能性のある人物を	
Dialogue: 5,1:14:11.43,1:14:13.15,DefaultSingle-J,,0,0,0,,		犯人は消そうとしたんだよ	
Dialogue: 5,1:14:13.25,1:14:14.29,DefaultSingle-J,,0,0,0,,		待って	
Dialogue: 5,1:14:14.39,1:14:18.26,DefaultSingle-J,,0,0,0,,		犯人はなんて子供達があの雑居ビルに行くってわかったの？	
Dialogue: 5,1:14:18.41,1:14:20.65,DefaultSingle-J,,0,0,0,,		爆弾はタイマー式だったんだよね	
Dialogue: 5,1:14:20.75,1:14:23.22,DefaultSingle-J,,0,0,0,,		前もって仕掛けてあったって聞いたよ	
Dialogue: 5,1:14:23.97,1:14:27.27,DefaultSingle-J,,0,0,0,,		あそこにみんなが行くように仕向けた人がいるでしょ？	
Dialogue: 5,1:14:28.39,1:14:31.92,DefaultSingle-J,,0,0,0,,		まさか…打ち合わせが入ってるって言った…	
Dialogue: 5,1:14:32.07,1:14:35.74,DefaultSingle-J,,0,0,0,,		犯人は顔かたちを変えて日本に潜伏している	
Dialogue: 5,1:14:36.10,1:14:38.30,DefaultSingle-J,,0,0,0,,		公安の刑事さんはそう言ってた	
Dialogue: 5,1:14:38.30,1:14:40.19,DefaultSingle-J,,0,0,0,,		それは困るな	
Dialogue: 5,1:14:40.26,1:14:43.47,DefaultSingle-J,,0,0,0,,		この後  司会をする方と打ち合わせがあるのに	
Dialogue: 5,1:14:44.64,1:14:47.04,DefaultSingle-J,,0,0,0,,		正体は  村中努さん？	
Dialogue: 5,1:14:48.00,1:14:51.98,DefaultSingle-J,,0,0,0,,		確かに  引退してしばらく隠居生活を送っていた人なら	
Dialogue: 5,1:14:51.98,1:14:54.57,DefaultSingle-J,,0,0,0,,		すり替わるチャンスはあったかもしれないけど	
Dialogue: 5,1:14:54.60,1:14:56.49,DefaultSingle-J,,0,0,0,,		警察のＯＢなのよ	
Dialogue: 5,1:14:56.97,1:15:00.81,DefaultSingle-J,,0,0,0,,		被害者の落とし物に気づいた子供がそれを拾って渡そうとした…	
Dialogue: 5,1:15:02.01,1:15:04.19,DefaultSingle-J,,0,0,0,,		わたしがあの時しゃべったから…	
Dialogue: 5,1:15:04.66,1:15:07.90,DefaultSingle-J,,0,0,0,,		あのとき蘭姉ちゃんは子供の名前は出さなかった	
Dialogue: 5,1:15:08.07,1:15:11.10,DefaultSingle-J,,0,0,0,,		だからどの子供が拾ったのかわからなかったんだ	
Dialogue: 5,1:15:11.41,1:15:14.20,DefaultSingle-J,,0,0,0,,		それで  全員爆弾で殺害しようとした	
Dialogue: 5,1:15:15.02,1:15:17.47,DefaultSingle-J,,0,0,0,,		っていうのが  新一兄ちゃんの推理だよ	
Dialogue: 5,1:15:17.47,1:15:18.45,DefaultSingle-J,,0,0,0,,		ひどい…	
Dialogue: 5,1:15:18.94,1:15:20.20,DefaultSingle-J,,0,0,0,,		あとはこの文字	
Dialogue: 5,1:15:20.69,1:15:22.62,DefaultSingle-J,,0,0,0,,		これは英語じゃなくてロシア語だ	
Dialogue: 5,1:15:22.94,1:15:26.46,DefaultSingle-J,,0,0,0,,		上はたぶん「プーリア」弾丸の意味で	
Dialogue: 5,1:15:26.92,1:15:30.05,DefaultSingle-J,,0,0,0,,		下はこれ  なんだ？数字の「40」…	
Dialogue: 5,1:15:31.29,1:15:34.00,DefaultSingle-J,,0,0,0,,		蘭姉ちゃん  ボクこのことみんなに知らせてくる	
Dialogue: 5,1:15:34.10,1:15:35.16,DefaultSingle-J,,0,0,0,,		待って	
Dialogue: 5,1:15:35.18,1:15:39.09,DefaultSingle-J,,0,0,0,,		じゃあ村中さんは自分で自分の殺害予告を出してるってこと？	
Dialogue: 5,1:15:39.23,1:15:41.15,DefaultSingle-J,,0,0,0,,		新一はなんて言ってたの？	
Dialogue: 5,1:15:41.15,1:15:42.41,DefaultSingle-J,,0,0,0,,		コナン君	
Dialogue: 5,1:15:46.59,1:15:47.75,DefaultSingle-J,,0,0,0,,		大丈夫ですか	
Dialogue: 5,1:15:48.74,1:15:51.94,DefaultSingle-J,,0,0,0,,		正直に言うと  怖くてたまらないの	
Dialogue: 5,1:15:52.06,1:15:54.24,DefaultSingle-J,,0,0,0,,		我々が絶対にお守りします	
Dialogue: 5,1:15:54.56,1:15:57.24,DefaultSingle-J,,0,0,0,,		日本でもう二人も殺しているんでしょう？	
Dialogue: 5,1:15:57.43,1:16:00.20,DefaultSingle-J,,0,0,0,,		それに  あのビルに仕掛けられた爆弾…	
Dialogue: 5,1:16:00.29,1:16:01.12,DefaultSingle-J,,0,0,0,,		大丈夫	
Dialogue: 5,1:16:01.14,1:16:04.16,DefaultSingle-J,,0,0,0,,		プラーミャには指一本触れさせませんから	
Dialogue: 5,1:16:07.97,1:16:08.84,DefaultSingle-J,,0,0,0,,		危ね	
Dialogue: 5,1:16:13.84,1:16:19.31,DefaultSingle-J,置顶,0,0,0,,		こちら渋谷では  今年もハロウィンを楽しもうと  たくさんの人が集まってます	
Dialogue: 5,1:16:17.65,1:16:21.61,DefaultSingle-J,,0,0,0,,		せっかくのハロウィンだってのに博士んちかよ	
Dialogue: 5,1:16:21.97,1:16:23.58,DefaultSingle-J,,0,0,0,,		退屈だの	
Dialogue: 5,1:16:24.46,1:16:26.77,DefaultSingle-J,,0,0,0,,		歩美も渋谷行きたかったなぁ	
Dialogue: 5,1:16:26.86,1:16:31.10,DefaultSingle-J,,0,0,0,,		仕方ないですよ  ボク達だけで行くわけにいかないですし	
Dialogue: 5,1:16:31.10,1:16:34.04,DefaultSingle-J,,0,0,0,,		大人達はそれどころじゃないみたいだしね	
Dialogue: 5,1:16:34.33,1:16:35.81,DefaultSingle-J,,0,0,0,,		大人しくしてましょう	
Dialogue: 5,1:16:35.97,1:16:36.83,DefaultSingle-J,,0,0,0,,		ジャジャーン	
Dialogue: 5,1:16:36.83,1:16:40.03,DefaultSingle-J,,0,0,0,,		ハロハロハロウィンの楽しいクイズです	
Dialogue: 5,1:16:40.71,1:16:41.53,DefaultSingle-J,,0,0,0,,		きた…	
Dialogue: 5,1:16:43.32,1:16:45.88,DefaultSingle-J,,0,0,0,,		高層ビルが林立する大都会	
Dialogue: 5,1:16:45.88,1:16:50.72,DefaultSingle-J,,0,0,0,,		その夜の眺望を守ろうとど真ん中で頑張る警察があります	
Dialogue: 5,1:16:50.72,1:16:52.93,DefaultSingle-J,,0,0,0,,		次のうちどれでしょう？	
Dialogue: 5,1:16:53.45,1:16:55.02,DefaultSingle-J,,0,0,0,,		新宿警察	
Dialogue: 5,1:16:55.11,1:16:56.70,DefaultSingle-J,,0,0,0,,		渋谷警察	
Dialogue: 5,1:16:56.79,1:16:58.51,DefaultSingle-J,,0,0,0,,		品川警察	
Dialogue: 5,1:16:58.71,1:17:00.55,DefaultSingle-J,,0,0,0,,		池袋警察	
Dialogue: 5,1:17:00.79,1:17:03.85,DefaultSingle-J,,0,0,0,,		今はクイズ解いてる気分じゃありませんよ	
Dialogue: 5,1:17:03.85,1:17:06.30,DefaultSingle-J,,0,0,0,,		頭使うと腹減るしよ	
Dialogue: 5,1:17:06.38,1:17:08.62,DefaultSingle-J,,0,0,0,,		ホントに渋谷行きたかったなぁ	
Dialogue: 5,1:17:08.62,1:17:10.98,DefaultSingle-J,,0,0,0,,		歩美ちゃん  正解じゃ	
Dialogue: 5,1:17:11.23,1:17:13.43,DefaultSingle-J,,0,0,0,,		答えは渋谷警察	
Dialogue: 5,1:17:13.45,1:17:16.07,DefaultSingle-J,,0,0,0,,		ど真ん中に「夜景」があるからのォ	
Dialogue: 5,1:17:16.07,1:17:18.10,DefaultSingle-J,,0,0,0,,		そんなのどうでもいいよ	
Dialogue: 5,1:17:18.10,1:17:20.30,DefaultSingle-J,,0,0,0,,		時間かけて考えたのに	
Dialogue: 5,1:17:20.94,1:17:22.38,DefaultSingle-J,,0,0,0,,		はいはい  何じゃ	
Dialogue: 5,1:17:23.42,1:17:24.64,DefaultSingle-J,,0,0,0,,		な  なんじゃとォ？	
Dialogue: 5,1:17:24.64,1:17:26.58,DefaultSingle-J,,0,0,0,,		いやしかし  あれはまだ…	
Dialogue: 5,1:17:26.58,1:17:28.21,DefaultSingle-J,,0,0,0,,		どうしたんですか  博士	
Dialogue: 5,1:17:28.51,1:17:29.98,DefaultSingle-J,,0,0,0,,		誰からのメール？	
Dialogue: 5,1:17:30.13,1:17:31.84,DefaultSingle-J,,0,0,0,,		もしかしてコナンくん？	
Dialogue: 5,1:17:32.17,1:17:33.48,DefaultSingle-J,,0,0,0,,		いやいや  違う違う	
Dialogue: 5,1:17:33.67,1:17:35.76,DefaultSingle-J,,0,0,0,,		ただそのォ  なんというか…	
Dialogue: 5,1:17:36.86,1:17:38.81,DefaultSingle-J,,0,0,0,,		なんか隠してねーか	
Dialogue: 5,1:18:13.75,1:18:15.30,DefaultSingle-J,,0,0,0,,		どうしてここがわかった	
Dialogue: 5,1:18:15.33,1:18:17.76,DefaultSingle-J,,0,0,0,,		後ろの人にかぶり物を当てたとき	
Dialogue: 5,1:18:17.79,1:18:18.73,DefaultSingle-J,,0,0,0,,		ちょっとね	
Dialogue: 5,1:18:20.59,1:18:21.60,DefaultSingle-J,,0,0,0,,		あのときに？	
Dialogue: 5,1:18:22.09,1:18:24.18,DefaultSingle-J,,0,0,0,,		話があるんだ  エレニカさん	
Dialogue: 5,1:18:27.85,1:18:31.06,DefaultSingle-J,,0,0,0,,		今夜  この辺りは危険だ  さっさと帰りなさい	
Dialogue: 5,1:18:36.53,1:18:39.36,DefaultSingle-J,,0,0,0,,		それでは  指輪の交換を	
Dialogue: 5,1:18:49.24,1:18:50.32,DefaultSingle-J,,0,0,0,,		おい  どうした	
Dialogue: 5,1:18:50.32,1:18:51.59,DefaultSingle-J,,0,0,0,,		警部  大変です	
Dialogue: 5,1:18:51.59,1:18:55.54,DefaultSingle-J,,0,0,0,,		そちらに手配中の一味が子供を人質にとって…	
Dialogue: 5,1:18:55.63,1:18:56.53,DefaultSingle-J,,0,0,0,,		クソッ	
Dialogue: 5,1:18:57.51,1:18:59.04,DefaultSingle-J,,0,0,0,,		プラーミャ  覚悟しろ	
Dialogue: 5,1:19:00.02,1:19:01.01,DefaultSingle-J,,0,0,0,,		動くな	
Dialogue: 5,1:19:01.34,1:19:03.26,DefaultSingle-J,,0,0,0,,		子供の頭が吹き飛ぶぞ	
Dialogue: 5,1:19:03.39,1:19:04.40,DefaultSingle-J,,0,0,0,,		コナン君	
Dialogue: 5,1:19:04.53,1:19:05.43,DefaultSingle-J,,0,0,0,,		銃を捨てろ	
Dialogue: 5,1:19:06.85,1:19:09.43,DefaultSingle-J,,0,0,0,,		こんなことをして  どういうつもりだ	
Dialogue: 5,1:19:09.68,1:19:11.70,DefaultSingle-J,,0,0,0,,		プラーミャの正体がわかった	
Dialogue: 5,1:19:11.73,1:19:12.81,DefaultSingle-J,,0,0,0,,		何だって	
Dialogue: 5,1:19:14.25,1:19:16.21,DefaultSingle-J,,0,0,0,,		手前二人  そこをどけ	
Dialogue: 5,1:19:16.93,1:19:20.43,DefaultSingle-J,,0,0,0,,		後ろの刑事は入り口の扉を閉めて鍵をかけろ	
Dialogue: 5,1:19:36.16,1:19:37.25,DefaultSingle-J,,0,0,0,,		両手を上げろ	
Dialogue: 5,1:19:38.41,1:19:39.13,DefaultSingle-J,,0,0,0,,		プラーミャ	
Dialogue: 5,1:19:40.38,1:19:43.53,DefaultSingle-J,,0,0,0,,		何を言ってる  彼は狙われてる身だぞ	
Dialogue: 5,1:19:47.67,1:19:48.90,DefaultSingle-J,,0,0,0,,		あなたが犯人？	
Dialogue: 5,1:19:48.90,1:19:50.12,DefaultSingle-J,,0,0,0,,		ち  違う	
Dialogue: 5,1:19:50.22,1:19:52.62,DefaultSingle-J,,0,0,0,,		なんで私が自分自身に脅迫を…	
Dialogue: 5,1:19:52.62,1:19:53.64,DefaultSingle-J,,0,0,0,,		動くな	
Dialogue: 5,1:19:53.78,1:19:57.37,DefaultSingle-J,,0,0,0,,		新郎新婦二人ともだ  早く両手を上げるんだ	
Dialogue: 5,1:20:00.98,1:20:02.40,DefaultSingle-J,,0,0,0,,		どうした  花嫁	
Dialogue: 5,1:20:03.07,1:20:04.90,DefaultSingle-J,,0,0,0,,		お前も両手を上げるんだ	
Dialogue: 5,1:20:06.01,1:20:07.02,DefaultSingle-J,,0,0,0,,		待ってくれ	
Dialogue: 5,1:20:07.10,1:20:11.74,DefaultSingle-J,,0,0,0,,		彼女は三年前に負った交通事故の後遺症で右肩が上がらないんだ	
Dialogue: 5,1:20:11.96,1:20:13.38,DefaultSingle-J,,0,0,0,,		交通事故？	
Dialogue: 5,1:20:14.35,1:20:17.83,DefaultSingle-J,,0,0,0,,		三年前  日本の刑事に銃で撃たれたせいで	
Dialogue: 5,1:20:17.83,1:20:19.44,DefaultSingle-J,,0,0,0,,		右腕が上がらないんだろ？	
Dialogue: 5,1:20:19.81,1:20:22.13,DefaultSingle-J,,0,0,0,,		なぁ  クリスティーヌ・リシャール	
Dialogue: 5,1:20:22.53,1:20:23.14,DefaultSingle-J,,0,0,0,,		いや	
Dialogue: 5,1:20:24.05,1:20:25.02,DefaultSingle-J,,0,0,0,,		プラーミャ	
Dialogue: 5,1:20:26.11,1:20:28.42,DefaultSingle-J,,0,0,0,,		わ  私が犯人？	
Dialogue: 5,1:20:28.43,1:20:29.86,DefaultSingle-J,,0,0,0,,		いい加減にしてくれ	
Dialogue: 5,1:20:30.04,1:20:31.81,DefaultSingle-J,,0,0,0,,		なぜ彼女が犯人だと	
Dialogue: 5,1:20:33.04,1:20:33.78,DefaultSingle-J,,0,0,0,,		これは？	
Dialogue: 5,1:20:33.81,1:20:35.23,DefaultSingle-J,,0,0,0,,		金属探知機だ	
Dialogue: 5,1:20:35.67,1:20:39.61,DefaultSingle-J,等俄语词,0,0,0,,		プラーミャの肩「плечо」には銃弾「пуля」が埋まってる	
Dialogue: 5,1:20:40.10,1:20:42.14,DefaultSingle-J,,0,0,0,,		近づければ反応するはずだ	
Dialogue: 5,1:20:42.17,1:20:43.18,DefaultSingle-J,,0,0,0,,		待ってください	
Dialogue: 5,1:20:43.23,1:20:45.98,DefaultSingle-J,,0,0,0,,		手術で金属ボルトが入っているんです  だから…	
Dialogue: 5,1:20:45.98,1:20:46.74,DefaultSingle-J,,0,0,0,,		そういえば	
Dialogue: 5,1:20:46.92,1:20:50.74,DefaultSingle-J,,0,0,0,,		あなた  さっき控室でプラーミャは二人殺したと言ったわね	
Dialogue: 5,1:20:51.07,1:20:53.75,DefaultSingle-J,,0,0,0,,		脱走した連続爆破犯の殺害	
Dialogue: 5,1:20:54.17,1:20:56.79,DefaultSingle-J,,0,0,0,,		その件は公式に発表されていないのに	
Dialogue: 5,1:20:56.97,1:20:57.93,DefaultSingle-J,,0,0,0,,		どうして二人だと	
Dialogue: 5,1:20:57.93,1:20:59.13,DefaultSingle-J,,0,0,0,,		君まで  なんだ	
Dialogue: 5,1:20:59.42,1:21:03.58,DefaultSingle-J,,0,0,0,,		俺達の結婚式を万全の警備で守ってくれるんじゃなかったのか	
Dialogue: 5,1:21:03.58,1:21:08.56,DefaultSingle-J,,0,0,0,,		それなのに  こんなに簡単に侵入を許し  犯人扱いまでして	
Dialogue: 5,1:21:08.70,1:21:10.66,DefaultSingle-J,,0,0,0,,		結婚式がメチャクチャだ	
Dialogue: 5,1:21:11.11,1:21:12.87,DefaultSingle-J,,0,0,0,,		すまない  クリスティーヌ	
Dialogue: 5,1:21:12.87,1:21:14.89,DefaultSingle-J,,0,0,0,,		せっかくの晴れ舞台が	
Dialogue: 5,1:21:22.24,1:21:26.01,DefaultSingle-J,,0,0,0,,		私としたことが  最後にやってしまったな	
Dialogue: 5,1:21:26.09,1:21:28.01,DefaultSingle-J,,0,0,0,,		クリスティーヌ  何を言…	
Dialogue: 5,1:21:32.99,1:21:34.97,DefaultSingle-J,,0,0,0,,		うるさい  うるさい	
Dialogue: 5,1:21:35.07,1:21:36.33,DefaultSingle-J,,0,0,0,,		ク  クリス…	
Dialogue: 5,1:21:36.33,1:21:37.78,DefaultSingle-J,,0,0,0,,		まったくうるさい	
Dialogue: 5,1:21:37.86,1:21:39.87,DefaultSingle-J,,0,0,0,,		ハエのような奴らだな  お前らは	
Dialogue: 5,1:21:50.40,1:21:51.03,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,1:21:51.03,1:21:52.62,DefaultSingle-J,,0,0,0,,		みんなも早く隠れて	
Dialogue: 5,1:21:52.62,1:21:53.39,DefaultSingle-J,,0,0,0,,		コナン君？	
Dialogue: 5,1:21:53.39,1:21:54.18,DefaultSingle-J,,0,0,0,,		急いで	
Dialogue: 5,1:21:54.18,1:21:55.46,DefaultSingle-J,,0,0,0,,		わわ  わかった	
Dialogue: 5,1:21:57.16,1:21:59.33,DefaultSingle-J,,0,0,0,,		私の正体を知る者は	
Dialogue: 5,1:22:00.76,1:22:02.94,DefaultSingle-J,,0,0,0,,		誰一人生かすことはできない	
Dialogue: 5,1:22:08.14,1:22:10.74,DefaultSingle-J,,0,0,0,,		やめてくれ  クリスティーヌ	
Dialogue: 5,1:22:14.89,1:22:16.70,DefaultSingle-J,,0,0,0,,		村中	
Dialogue: 5,1:22:18.49,1:22:20.45,DefaultSingle-J,,0,0,0,,		目暮警部  大丈夫ですか	
Dialogue: 5,1:22:20.47,1:22:22.03,DefaultSingle-J,,0,0,0,,		早くこちらに隠れて	
Dialogue: 5,1:22:34.39,1:22:37.19,DefaultSingle-J,,0,0,0,,		花嫁が犯人だよ  二階の通路に…	
Dialogue: 5,1:22:40.09,1:22:41.62,DefaultSingle-J,,0,0,0,,		他の入り口から行くぞ	
Dialogue: 5,1:22:42.64,1:22:44.48,DefaultSingle-J,,0,0,0,,		村中  しっかりしろ	
Dialogue: 5,1:22:44.72,1:22:48.48,DefaultSingle-J,,0,0,0,,		目暮  すまない  俺は本当に愚かだ	
Dialogue: 5,1:22:48.48,1:22:51.86,DefaultSingle-J,,0,0,0,,		バカヤロ  そんなこと今に始まったことじゃない	
Dialogue: 5,1:22:52.14,1:22:54.10,DefaultSingle-J,,0,0,0,,		今さら気にしてどうする	
Dialogue: 5,1:22:54.10,1:22:56.62,DefaultSingle-J,,0,0,0,,		頭より先に勘で体が動く	
Dialogue: 5,1:22:56.83,1:22:58.45,DefaultSingle-J,,0,0,0,,		鬼の村中よ	
Dialogue: 5,1:22:58.91,1:22:59.90,DefaultSingle-J,,0,0,0,,		目暮…	
Dialogue: 5,1:23:01.26,1:23:02.04,DefaultSingle-J,,0,0,0,,		佐藤さん	
Dialogue: 5,1:23:02.08,1:23:03.11,DefaultSingle-J,,0,0,0,,		佐藤君	
Dialogue: 5,1:23:06.93,1:23:07.96,DefaultSingle-J,,0,0,0,,		危ない	
Dialogue: 5,1:23:08.49,1:23:09.18,DefaultSingle-J,,0,0,0,,		クソ	
Dialogue: 5,1:23:14.35,1:23:15.94,DefaultSingle-J,,0,0,0,,		ま  待ちなさい	
Dialogue: 5,1:23:15.97,1:23:17.28,DefaultSingle-J,,0,0,0,,		高木君  重い	
Dialogue: 5,1:23:17.28,1:23:18.03,DefaultSingle-J,,0,0,0,,		追うわよ	
Dialogue: 5,1:23:18.22,1:23:19.02,DefaultSingle-J,,0,0,0,,		は  はい	
Dialogue: 5,1:23:19.30,1:23:20.90,DefaultSingle-J,,0,0,0,,		きっと屋上に向かったはずよ	
Dialogue: 5,1:23:20.90,1:23:23.17,DefaultSingle-J,,0,0,0,,		奴はヘリで逃げるつもりですかね	
Dialogue: 5,1:23:23.17,1:23:25.94,DefaultSingle-J,,0,0,0,,		結婚式のセレモニーとしてチャーターしたヘリね  急がないと	
Dialogue: 5,1:23:50.18,1:23:51.42,DefaultSingle-J,,0,0,0,,		遅れてやがる	
Dialogue: 5,1:23:51.59,1:23:54.43,DefaultSingle-J,,0,0,0,,		もうあきらめた方がいいと思うけどな	
Dialogue: 5,1:23:56.12,1:23:57.67,DefaultSingle-J,,0,0,0,,		クリスティーヌさん	
Dialogue: 5,1:24:01.22,1:24:02.06,DefaultSingle-J,,0,0,0,,		つか	
Dialogue: 5,1:24:02.62,1:24:05.44,DefaultSingle-J,,0,0,0,,		もうプラーミャって呼んだ方がよさそうだね	
Dialogue: 5,1:24:05.81,1:24:08.31,DefaultSingle-J,,0,0,0,,		お前  いったい何者だ	
Dialogue: 5,1:24:08.47,1:24:09.99,DefaultSingle-J,,0,0,0,,		江戸川コナン	
Dialogue: 5,1:24:11.09,1:24:12.32,DefaultSingle-J,,0,0,0,,		探偵さ	
Dialogue: 5,1:24:16.61,1:24:18.00,DefaultSingle-J,,0,0,0,,		うそ  開かない	
Dialogue: 5,1:24:18.00,1:24:19.12,DefaultSingle-J,,0,0,0,,		探偵だと？	
Dialogue: 5,1:24:19.25,1:24:21.62,DefaultSingle-J,,0,0,0,,		アンタの計画は失敗したんだ	
Dialogue: 5,1:24:21.83,1:24:24.75,DefaultSingle-J,,0,0,0,,		彼らをまとめて殺害する計画はね	
Dialogue: 5,1:24:25.25,1:24:28.20,DefaultSingle-J,,0,0,0,,		エレニカさん達ナーダ・ウニチトージティは	
Dialogue: 5,1:24:28.20,1:24:31.00,DefaultSingle-J,,0,0,0,,		アンタを追って世界中どこへでもやってきた	
Dialogue: 5,1:24:31.44,1:24:33.98,DefaultSingle-J,,0,0,0,,		さすがのプラーミャも追い詰められた	
Dialogue: 5,1:24:34.06,1:24:36.51,DefaultSingle-J,,0,0,0,,		だから  起死回生となる計画を立てたんだ	
Dialogue: 5,1:24:37.11,1:24:39.13,DefaultSingle-J,,0,0,0,,		彼らを一カ所に集め	
Dialogue: 5,1:24:39.13,1:24:41.18,DefaultSingle-J,,0,0,0,,		得意の爆弾で吹き飛ばす	
Dialogue: 5,1:24:43.86,1:24:47.01,DefaultSingle-J,,0,0,0,,		さすが探偵を名乗るだけのことはある	
Dialogue: 5,1:24:47.01,1:24:49.27,DefaultSingle-J,,0,0,0,,		お前の言うとおりだ  少年	
Dialogue: 5,1:24:49.97,1:24:55.42,DefaultSingle-J,,0,0,0,,		私はまず自分が引退するという噂を流し  続いて村中に近づいたのよ	
Dialogue: 5,1:24:55.43,1:24:59.78,DefaultSingle-J,,0,0,0,,		そして村中さんを何者かが狙っているっていう話を作った	
Dialogue: 5,1:24:59.93,1:25:03.72,DefaultSingle-J,,0,0,0,,		プラーミャが絡んでいるとなれば奴らは勇んでやってくる	
Dialogue: 5,1:25:03.85,1:25:07.66,DefaultSingle-J,,0,0,0,,		私を捕まえる最後の機会じゃないかと焦ってね	
Dialogue: 5,1:25:07.81,1:25:10.52,DefaultSingle-J,,0,0,0,,		アンタにはもう一つ目的があった	
Dialogue: 5,1:25:10.52,1:25:12.04,DefaultSingle-J,,0,0,0,,		目撃者の抹殺だ	
Dialogue: 5,1:25:13.02,1:25:17.70,DefaultSingle-J,,0,0,0,,		アンタはプラーミャとしての自分の姿を見た者を全て殺害してきた	
Dialogue: 5,1:25:17.70,1:25:18.32,DefaultSingle-J,,0,0,0,,		だけど…	
Dialogue: 5,1:25:18.39,1:25:22.97,DefaultSingle-J,,0,0,0,,		そう  私はかつてこの日本で屈辱を味わったんだよ	
Dialogue: 5,1:25:24.48,1:25:26.84,DefaultSingle-J,,0,0,0,,		あの四人の警察官によって	
Dialogue: 5,1:25:27.46,1:25:29.32,DefaultSingle-J,,0,0,0,,		ターゲットはそのときの…	
Dialogue: 5,1:25:29.32,1:25:30.31,DefaultSingle-J,,0,0,0,,		ご名答	
Dialogue: 5,1:25:30.42,1:25:32.59,DefaultSingle-J,,0,0,0,,		警視庁を深く調べた結果	
Dialogue: 5,1:25:32.59,1:25:34.90,DefaultSingle-J,,0,0,0,,		松田はすでに殉職していて	
Dialogue: 5,1:25:34.90,1:25:37.07,DefaultSingle-J,,0,0,0,,		伊達も交通事故で死んだ	
Dialogue: 5,1:25:37.34,1:25:40.72,DefaultSingle-J,,0,0,0,,		残るは「ゼロ」「ヒロ」と呼ばれていた二人	
Dialogue: 5,1:25:40.91,1:25:44.07,DefaultSingle-J,,0,0,0,,		「降谷」「諸伏」という名前だけはわかったが	
Dialogue: 5,1:25:44.11,1:25:48.88,DefaultSingle-J,,0,0,0,,		どれだけ調べてもその二人の情報は出てこなくてねぇ	
Dialogue: 5,1:25:49.11,1:25:52.99,DefaultSingle-J,,0,0,0,,		そこで  松田刑事を殉職させた爆破犯を使って	
Dialogue: 5,1:25:52.99,1:25:54.61,DefaultSingle-J,,0,0,0,,		おびき出そうとしたんだな	
Dialogue: 5,1:25:54.64,1:25:55.32,DefaultSingle-J,,0,0,0,,		そう	
Dialogue: 5,1:25:55.62,1:25:59.97,DefaultSingle-J,,0,0,0,,		あの男を逃走させたら慌てて穴から這い出してくるってね	
Dialogue: 5,1:26:00.17,1:26:02.17,DefaultSingle-J,,0,0,0,,		思惑どおり降谷が現れ	
Dialogue: 5,1:26:02.20,1:26:04.47,DefaultSingle-J,,0,0,0,,		爆弾をはめることに成功	
Dialogue: 5,1:26:04.60,1:26:07.56,DefaultSingle-J,,0,0,0,,		そこまでやれば絶対にもう一人出てくる	
Dialogue: 5,1:26:08.03,1:26:12.23,DefaultSingle-J,,0,0,0,,		そう読んでいたが  ここまでやっても出てこないということは	
Dialogue: 5,1:26:12.75,1:26:14.23,DefaultSingle-J,,0,0,0,,		死んでいるんだろう？	
Dialogue: 5,1:26:15.33,1:26:18.80,DefaultSingle-J,,0,0,0,,		エレニカさんの兄  オレグさんが持っていたタブレット	
Dialogue: 5,1:26:18.80,1:26:20.24,DefaultSingle-J,,0,0,0,,		あれも罠だったんだね	
Dialogue: 5,1:26:20.33,1:26:21.65,DefaultSingle-J,,0,0,0,,		その通り	
Dialogue: 5,1:26:21.89,1:26:24.27,DefaultSingle-J,,0,0,0,,		わざと盗ませたタブレットを持って	
Dialogue: 5,1:26:24.27,1:26:27.47,DefaultSingle-J,,0,0,0,,		奴が仲間の元に戻れば  そこで起爆させ	
Dialogue: 5,1:26:27.47,1:26:29.86,DefaultSingle-J,,0,0,0,,		ナーダ・ウニチトージティを吹き飛ばせる	
Dialogue: 5,1:26:30.26,1:26:32.50,DefaultSingle-J,,0,0,0,,		ところが奴は仲間に会うことなく	
Dialogue: 5,1:26:32.50,1:26:34.70,DefaultSingle-J,,0,0,0,,		ずっと単独行動をし続け	
Dialogue: 5,1:26:35.02,1:26:38.01,DefaultSingle-J,,0,0,0,,		松田に会って全てを話そうとしたわけだ	
Dialogue: 5,1:26:38.22,1:26:40.69,DefaultSingle-J,,0,0,0,,		松田はもう死んでいるというのに	
Dialogue: 5,1:26:40.93,1:26:45.14,DefaultSingle-J,,0,0,0,,		それで  タブレットに仕込んだＧＰＳでマークしていたアンタは	
Dialogue: 5,1:26:45.25,1:26:49.14,DefaultSingle-J,,0,0,0,,		警視庁に駆け込まれる前に爆弾を起動させたんだね	
Dialogue: 5,1:26:49.18,1:26:53.06,DefaultSingle-J,,0,0,0,,		タブレットに仕込ませておいた「東京」というキーワードに	
Dialogue: 5,1:26:53.08,1:26:57.24,DefaultSingle-J,,0,0,0,,		ナーダ・ウニチトージティの奴らは見事に食いついてくれたよ	
Dialogue: 5,1:26:57.54,1:27:02.50,DefaultSingle-J,,0,0,0,,		しかしあの男が私の肩にある弾丸のことまで突き止めていたとは	
Dialogue: 5,1:27:02.79,1:27:04.07,DefaultSingle-J,,0,0,0,,		誤算だったよ	
Dialogue: 5,1:27:04.34,1:27:07.08,DefaultSingle-J,,0,0,0,,		オレグさんが残したメモで気がついたんだ	
Dialogue: 5,1:27:07.37,1:27:08.79,DefaultSingle-J,,0,0,0,,		「銃弾」と「肩」	
Dialogue: 5,1:27:08.80,1:27:11.83,DefaultSingle-J,,0,0,0,,		三年前プラーミャが弾を受けたのも肩だった	
Dialogue: 5,1:27:12.06,1:27:17.20,DefaultSingle-J,,0,0,0,,		取り出そうとすると神経を傷つけ  腕の動きに支障が出ると言われてね	
Dialogue: 5,1:27:17.68,1:27:21.59,DefaultSingle-J,,0,0,0,,		精巧な爆弾を作るアンタにとって  それは致命的だ	
Dialogue: 5,1:27:21.75,1:27:23.84,DefaultSingle-J,,0,0,0,,		だから取り出すのをあきらめた	
Dialogue: 5,1:27:24.11,1:27:28.40,DefaultSingle-J,,0,0,0,,		その代償として右腕が上がらなくなったっていうのが真相か	
Dialogue: 5,1:27:29.19,1:27:31.34,DefaultSingle-J,,0,0,0,,		仕掛けた爆弾はどこにあるの？	
Dialogue: 5,1:27:31.34,1:27:33.35,DefaultSingle-J,,0,0,0,,		今さらそれを知ってどうする	
Dialogue: 5,1:27:33.55,1:27:37.62,DefaultSingle-J,,0,0,0,,		アンタの正体は警察やナーダ・ウニチトージティを含め	
Dialogue: 5,1:27:37.62,1:27:39.22,DefaultSingle-J,,0,0,0,,		多くの者に知れ渡った	
Dialogue: 5,1:27:39.45,1:27:41.86,DefaultSingle-J,,0,0,0,,		もう爆発させても意味がないだろ	
Dialogue: 5,1:27:43.82,1:27:45.36,DefaultSingle-J,,0,0,0,,		さっき言ったはずだ	
Dialogue: 5,1:27:45.69,1:27:49.62,DefaultSingle-J,,0,0,0,,		私の正体を知る者は誰一人生かすことはできない  と	
Dialogue: 5,1:27:50.91,1:27:53.62,DefaultSingle-J,,0,0,0,,		のこのこ集まって馬鹿な奴らだ	
Dialogue: 5,1:27:53.91,1:27:57.65,DefaultSingle-J,,0,0,0,,		ハロウィンを盛り上げるための飾りくらいにしか思ってないのだろう	
Dialogue: 5,1:27:58.17,1:27:58.93,DefaultSingle-J,,0,0,0,,		まさか…	
Dialogue: 5,1:27:59.93,1:28:01.13,DefaultSingle-J,,0,0,0,,		あのランタンか	
Dialogue: 5,1:28:01.60,1:28:03.86,DefaultSingle-J,,0,0,0,,		ダミーも含めた液体火薬を	
Dialogue: 5,1:28:03.86,1:28:07.14,DefaultSingle-J,,0,0,0,,		道玄坂  宮益坂などに配置しておいた	
Dialogue: 5,1:28:07.43,1:28:09.64,DefaultSingle-J,,0,0,0,,		液体は一番低い場所	
Dialogue: 5,1:28:09.64,1:28:13.42,DefaultSingle-J,,0,0,0,,		つまりスクランブル交差点を目指して流れ下る	
Dialogue: 5,1:28:13.70,1:28:17.57,DefaultSingle-J,,0,0,0,,		なるほど  渋谷の高低差を利用したってわけか	
Dialogue: 5,1:28:20.46,1:28:26.78,DefaultSingle-J,,0,0,0,,		混じり合った大量の液体爆弾はかつてないほどの大爆発を起こすだろう	
Dialogue: 5,1:28:32.36,1:28:37.33,DefaultSingle-J,,0,0,0,,		そして私の正体を知る者は全てこの世から消えるのだ	
Dialogue: 5,1:28:44.38,1:28:46.18,DefaultSingle-J,,0,0,0,,		それが聞きたかったんだよ	
Dialogue: 5,1:28:53.79,1:28:55.73,DefaultSingle-J,,0,0,0,,		おのれ  お前は…	
Dialogue: 5,1:28:56.81,1:28:57.98,DefaultSingle-J,,0,0,0,,		降谷零	
Dialogue: 5,1:28:58.64,1:29:02.20,DefaultSingle-J,,0,0,0,,		お前を捕まえようと思えば  いつでもできた	
Dialogue: 5,1:29:02.70,1:29:06.93,DefaultSingle-J,,0,0,0,,		爆弾のありかを吐かせるため  わざとここまで泳がせたのさ	
Dialogue: 5,1:29:07.31,1:29:10.74,DefaultSingle-J,,0,0,0,,		まあ  あのマークの図で大体の予想は出来ていたけど	
Dialogue: 5,1:29:10.82,1:29:12.10,DefaultSingle-J,,0,0,0,,		小僧…	
Dialogue: 5,1:29:12.91,1:29:15.29,DefaultSingle-J,,0,0,0,,		プラーミャ  もう逃げられないわよ	
Dialogue: 5,1:29:21.96,1:29:23.96,DefaultSingle-J,,0,0,0,,		私もここまでか	
Dialogue: 5,1:29:24.17,1:29:25.98,DefaultSingle-J,,0,0,0,,		さぁ  手を上げて	
Dialogue: 5,1:29:26.85,1:29:28.47,DefaultSingle-J,,0,0,0,,		頭の後ろに回すんだ	
Dialogue: 5,1:29:29.41,1:29:30.30,DefaultSingle-J,,0,0,0,,		ああ	
Dialogue: 5,1:29:30.89,1:29:33.47,DefaultSingle-J,,0,0,0,,		わかったよ	
Dialogue: 5,1:29:35.90,1:29:38.65,DefaultSingle-J,,0,0,0,,		こうなったら一人でも多く道連れだ	
Dialogue: 5,1:29:46.10,1:29:49.59,DefaultSingle-J,,0,0,0,,		行っけぇ	
Dialogue: 5,1:29:56.55,1:29:57.37,DefaultSingle-J,,0,0,0,,		外れた	
Dialogue: 5,1:29:57.41,1:29:58.37,DefaultSingle-J,,0,0,0,,		まだだ	
Dialogue: 5,1:30:04.15,1:30:07.51,DefaultSingle-J,,0,0,0,,		当たれぇ  花火ボール	
Dialogue: 5,1:30:22.66,1:30:23.44,DefaultSingle-J,,0,0,0,,		やべぇ	
Dialogue: 5,1:30:25.63,1:30:29.17,DefaultSingle-J,,0,0,0,,		用心のためにスペアは持っておくもんだな	
Dialogue: 5,1:30:30.66,1:30:35.36,DefaultSingle-J,,0,0,0,,		お前から一足先にあの世に送ってやるよ  その首輪爆弾で	
Dialogue: 5,1:30:47.83,1:30:48.48,DefaultSingle-J,,0,0,0,,		何？	
Dialogue: 5,1:30:49.41,1:30:53.78,DefaultSingle-J,,0,0,0,,		こんなこともあろうかと君からの贈り物は返しておいたよ	
Dialogue: 5,1:31:00.06,1:31:01.31,DefaultSingle-J,,0,0,0,,		ダミーだと？	
Dialogue: 5,1:31:02.91,1:31:06.46,DefaultSingle-J,,0,0,0,,		爆弾の液体は完全に分析して  中和剤を作り	
Dialogue: 5,1:31:06.46,1:31:07.94,DefaultSingle-J,,0,0,0,,		回避させてもらったよ	
Dialogue: 5,1:31:08.47,1:31:10.74,DefaultSingle-J,,0,0,0,,		僕の優秀な部下によってね	
Dialogue: 5,1:31:11.52,1:31:13.72,DefaultSingle-J,,0,0,0,,		液体はこちらで作ったもの	
Dialogue: 5,1:31:14.09,1:31:15.87,DefaultSingle-J,,0,0,0,,		気に入っていただけかな	
Dialogue: 5,1:31:16.00,1:31:16.99,DefaultSingle-J,,0,0,0,,		降谷	
Dialogue: 5,1:31:25.00,1:31:26.35,DefaultSingle-J,,0,0,0,,		下で待っててくれ	
Dialogue: 5,1:31:26.51,1:31:27.55,DefaultSingle-J,,0,0,0,,		安室さん	
Dialogue: 5,1:31:35.39,1:31:37.68,DefaultSingle-J,,0,0,0,,		今度こそ君を逃がさないよ	
Dialogue: 5,1:31:38.35,1:31:40.27,DefaultSingle-J,,0,0,0,,		しつこい男は嫌いだね	
Dialogue: 5,1:31:46.55,1:31:47.81,DefaultSingle-J,,0,0,0,,		なんて無茶な	
Dialogue: 5,1:31:48.03,1:31:50.54,DefaultSingle-J,,0,0,0,,		ヘリに飛び乗って犯人と闘うなんて	
Dialogue: 5,1:31:51.04,1:31:52.27,DefaultSingle-J,,0,0,0,,		コナン君  知り合い？	
Dialogue: 5,1:31:52.55,1:31:54.83,DefaultSingle-J,,0,0,0,,		犯人に隠れてちょうど見えなかったのよ	
Dialogue: 5,1:31:54.83,1:31:55.84,DefaultSingle-J,,0,0,0,,		下に行こう	
Dialogue: 5,1:31:55.98,1:31:56.71,DefaultSingle-J,,0,0,0,,		ちょっと	
Dialogue: 5,1:31:56.99,1:31:58.96,DefaultSingle-J,,0,0,0,,		あのパイロット  何者なの？	
Dialogue: 5,1:31:59.69,1:32:00.63,DefaultSingle-J,,0,0,0,,		マジ  あれ	
Dialogue: 5,1:32:00.63,1:32:01.66,DefaultSingle-J,,0,0,0,,		マズくない？	
Dialogue: 5,1:32:40.73,1:32:42.55,DefaultSingle-J,,0,0,0,,		離せ  この野郎	
Dialogue: 5,1:32:42.86,1:32:45.33,DefaultSingle-J,,0,0,0,,		お前の思惑はもう叶わない	
Dialogue: 5,1:32:45.65,1:32:47.22,DefaultSingle-J,,0,0,0,,		残念だったな	
Dialogue: 5,1:32:47.95,1:32:51.11,DefaultSingle-J,,0,0,0,,		クソ	
Dialogue: 5,1:32:58.94,1:33:01.14,DefaultSingle-J,,0,0,0,,		急いで渋谷から離れてください	
Dialogue: 5,1:33:01.49,1:33:04.66,DefaultSingle-J,,0,0,0,,		テロの可能性があります  すみやかに避難を	
Dialogue: 5,1:33:04.66,1:33:06.68,DefaultSingle-J,,0,0,0,,		なるべく駅から離れてください	
Dialogue: 5,1:33:06.68,1:33:07.65,DefaultSingle-J,,0,0,0,,		急いで	
Dialogue: 5,1:33:12.90,1:33:14.40,DefaultSingle-J,,0,0,0,,		なんの騒ぎ？	
Dialogue: 5,1:33:17.99,1:33:20.53,DefaultSingle-J,,0,0,0,,		これだったら歩いたほうが早いぞ	
Dialogue: 5,1:33:20.83,1:33:22.52,DefaultSingle-J,,0,0,0,,		コナン君からのメールには	
Dialogue: 5,1:33:22.52,1:33:26.29,DefaultSingle-J,,0,0,0,,		渋谷の交差点の真ん中で待ってろって書いてあったんですよね	
Dialogue: 5,1:33:26.51,1:33:27.79,DefaultSingle-J,,0,0,0,,		それを持って	
Dialogue: 5,1:33:28.13,1:33:30.00,DefaultSingle-J,,0,0,0,,		博士  いいでしょう？	
Dialogue: 5,1:33:30.00,1:33:31.28,DefaultSingle-J,,0,0,0,,		あ  ああ	
Dialogue: 5,1:33:34.02,1:33:35.58,DefaultSingle-J,,0,0,0,,		仕方ないわね	
Dialogue: 5,1:33:35.58,1:33:36.22,DefaultSingle-J,,0,0,0,,		走るわよ	
Dialogue: 5,1:33:36.33,1:33:37.33,DefaultSingle-J,,0,0,0,,		おう	
Dialogue: 5,1:33:37.57,1:33:40.35,DefaultSingle-J,,0,0,0,,		十分気をつけるんじゃぞ	
Dialogue: 5,1:33:46.10,1:33:48.39,DefaultSingle-J,,0,0,0,,		これで爆発は防げるか	
Dialogue: 5,1:33:52.49,1:33:53.96,DefaultSingle-J,,0,0,0,,		貴様のせいで…	
Dialogue: 5,1:33:55.07,1:33:59.49,DefaultSingle-J,,0,0,0,,		貴様ごときのせいで  私の計画が台無しだ	
Dialogue: 5,1:34:02.44,1:34:04.54,DefaultSingle-J,,0,0,0,,		死ねぇ	
Dialogue: 5,1:34:11.96,1:34:16.26,DefaultSingle-J,,0,0,0,,		元刑事として  これ以上犯罪を見過ごすわけにはいかない	
Dialogue: 5,1:34:16.37,1:34:17.30,DefaultSingle-J,,0,0,0,,		あなたは…	
Dialogue: 5,1:34:17.50,1:34:19.58,DefaultSingle-J,,0,0,0,,		君は早くここから離れなさい	
Dialogue: 5,1:34:20.69,1:34:24.48,DefaultSingle-J,,0,0,0,,		ここにいたらまずいんじゃないか  君は公安の人間だろう？	
Dialogue: 5,1:34:24.63,1:34:25.81,DefaultSingle-J,,0,0,0,,		なぜそれを？	
Dialogue: 5,1:34:25.84,1:34:28.14,DefaultSingle-J,,0,0,0,,		長いこと刑事をやってたんでね	
Dialogue: 5,1:34:28.30,1:34:29.88,DefaultSingle-J,,0,0,0,,		わかるんだよ  勘で	
Dialogue: 5,1:34:30.17,1:34:34.40,DefaultSingle-J,,0,0,0,,		まぁ  婚約者にはこの勘が働かなかったようだがな	
Dialogue: 5,1:34:34.81,1:34:37.64,DefaultSingle-J,,0,0,0,,		大丈夫  目暮達には黙っておくさ	
Dialogue: 5,1:34:38.20,1:34:39.55,DefaultSingle-J,,0,0,0,,		生きていればね	
Dialogue: 5,1:35:14.83,1:35:15.90,DefaultSingle-J,,0,0,0,,		ダメだ	
Dialogue: 5,1:35:17.91,1:35:19.53,DefaultSingle-J,,0,0,0,,		撃っちゃダメだ  エレニカさん	
Dialogue: 5,1:35:19.58,1:35:20.69,DefaultSingle-J,,0,0,0,,		どけ  少年	
Dialogue: 5,1:35:20.71,1:35:22.74,DefaultSingle-J,,0,0,0,,		邪魔をするならお前も撃つぞ	
Dialogue: 5,1:35:22.89,1:35:26.24,DefaultSingle-J,,0,0,0,,		プラーミャを撃ったところで息子さんはかえってこないよ	
Dialogue: 5,1:35:27.26,1:35:29.06,DefaultSingle-J,,0,0,0,,		お前に何がわかる	
Dialogue: 5,1:35:29.33,1:35:33.50,DefaultSingle-J,,0,0,0,,		私は息子も夫も兄も  みんな奴に殺された	
Dialogue: 5,1:35:33.86,1:35:36.02,DefaultSingle-J,,0,0,0,,		もう元の生活には戻れない	
Dialogue: 5,1:35:36.18,1:35:38.16,DefaultSingle-J,,0,0,0,,		悪事もたくさん働いた	
Dialogue: 5,1:35:38.55,1:35:40.18,DefaultSingle-J,,0,0,0,,		奴を殺すためだ	
Dialogue: 5,1:35:40.36,1:35:43.26,DefaultSingle-J,,0,0,0,,		全てを犠牲にして  ここまで来たんだ	
Dialogue: 5,1:35:43.71,1:35:45.86,DefaultSingle-J,,0,0,0,,		この手で殺さないと気が済まない	
Dialogue: 5,1:35:46.07,1:35:47.23,DefaultSingle-J,,0,0,0,,		どけ  少年	
Dialogue: 5,1:35:52.06,1:35:54.42,DefaultSingle-J,,0,0,0,,		なぜ  殺されねばならなかったんだ	
Dialogue: 5,1:35:54.87,1:35:56.62,DefaultSingle-J,,0,0,0,,		夫は警察官として	
Dialogue: 5,1:35:56.62,1:36:00.78,DefaultSingle-J,,0,0,0,,		政治家の子供だった殺人事件の容疑者を逮捕しただけだ	
Dialogue: 5,1:36:01.15,1:36:03.98,DefaultSingle-J,,0,0,0,,		それを裁判で証言しようとしたら消された	
Dialogue: 5,1:36:04.27,1:36:05.74,DefaultSingle-J,,0,0,0,,		息子を巻き添えに	
Dialogue: 5,1:36:06.44,1:36:09.04,DefaultSingle-J,,0,0,0,,		夫と息子は何か悪いことをしたのか	
Dialogue: 5,1:36:09.83,1:36:11.46,DefaultSingle-J,,0,0,0,,		なぁ  教えて…	
Dialogue: 5,1:36:26.29,1:36:28.80,DefaultSingle-J,,0,0,0,,		必ずこの者には罰を与える	
Dialogue: 5,1:36:28.99,1:36:32.31,DefaultSingle-J,,0,0,0,,		だから信じてほしい  日本の警察を	
Dialogue: 5,1:36:33.75,1:36:35.52,DefaultSingle-J,,0,0,0,,		エレニカさん  協力して	
Dialogue: 5,1:36:35.98,1:36:40.47,DefaultSingle-J,,0,0,0,,		これ以上悲劇を増やさないためにも  あなた達の助けが必要だ	
Dialogue: 5,1:36:46.70,1:36:48.20,DefaultSingle-J,,0,0,0,,		コナンくん	
Dialogue: 5,1:36:48.33,1:36:49.32,DefaultSingle-J,,0,0,0,,		コナン	
Dialogue: 5,1:36:49.32,1:36:51.52,DefaultSingle-J,,0,0,0,,		どこにいるんですか	
Dialogue: 5,1:36:51.81,1:36:54.02,DefaultSingle-J,,0,0,0,,		お前ら  どうしてここに	
Dialogue: 5,1:36:54.02,1:36:54.83,DefaultSingle-J,,0,0,0,,		話は後	
Dialogue: 5,1:36:55.16,1:36:56.54,DefaultSingle-J,,0,0,0,,		博士から預かったわ	
Dialogue: 5,1:36:56.57,1:36:58.55,DefaultSingle-J,,0,0,0,,		はい  これが新しいベルトよ	
Dialogue: 5,1:36:58.55,1:36:59.21,DefaultSingle-J,,0,0,0,,		サンキュ	
Dialogue: 5,1:37:00.74,1:37:02.76,DefaultSingle-J,,0,0,0,,		クソッ  もう時間がない	
Dialogue: 5,1:37:03.44,1:37:04.56,DefaultSingle-J,,0,0,0,,		こっちも	
Dialogue: 5,1:37:05.50,1:37:06.73,DefaultSingle-J,,0,0,0,,		仕方ねぇ	
Dialogue: 5,1:37:06.97,1:37:09.11,DefaultSingle-J,,0,0,0,,		博士に送ったメールは見たんだよな	
Dialogue: 5,1:37:09.12,1:37:09.93,DefaultSingle-J,,0,0,0,,		できるか	
Dialogue: 5,1:37:09.98,1:37:10.84,DefaultSingle-J,,0,0,0,,		ええ	
Dialogue: 5,1:37:10.87,1:37:13.18,DefaultSingle-J,,0,0,0,,		このサスペンダーの端を持って走り	
Dialogue: 5,1:37:13.45,1:37:16.44,DefaultSingle-J,,0,0,0,,		ガードレールとか信号機とかに結べばいいんだよね	
Dialogue: 5,1:37:16.57,1:37:17.94,DefaultSingle-J,,0,0,0,,		楽勝だぜ	
Dialogue: 5,1:37:18.03,1:37:21.06,DefaultSingle-J,,0,0,0,,		結んだら探偵バッジで江戸川君に合図	
Dialogue: 5,1:37:21.06,1:37:22.19,DefaultSingle-J,,0,0,0,,		いいわね  みんな	
Dialogue: 5,1:37:22.36,1:37:23.23,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,1:37:46.21,1:37:47.35,DefaultSingle-J,,0,0,0,,		村中	
Dialogue: 5,1:37:47.35,1:37:47.88,DefaultSingle-J,,0,0,0,,		目暮	
Dialogue: 5,1:37:48.23,1:37:49.46,DefaultSingle-J,,0,0,0,,		いいところに来た	
Dialogue: 5,1:37:49.46,1:37:50.47,DefaultSingle-J,,0,0,0,,		捕まえたのか	
Dialogue: 5,1:37:50.47,1:37:52.02,DefaultSingle-J,,0,0,0,,		ああ  後は頼む	
Dialogue: 5,1:37:52.34,1:37:53.94,DefaultSingle-J,,0,0,0,,		私も行かなくては	
Dialogue: 5,1:37:54.67,1:37:55.64,DefaultSingle-J,,0,0,0,,		どこにです？	
Dialogue: 5,1:38:02.64,1:38:04.69,DefaultSingle-J,,0,0,0,,		流れが早い  急いでくれ	
Dialogue: 5,1:38:06.25,1:38:07.98,DefaultSingle-J,,0,0,0,,		あとちょっとなのに	
Dialogue: 5,1:38:08.88,1:38:10.10,DefaultSingle-J,,0,0,0,,		手伝うわ	
Dialogue: 5,1:38:10.31,1:38:11.70,DefaultSingle-J,,0,0,0,,		そこに結べばいい？	
Dialogue: 5,1:38:14.89,1:38:16.22,DefaultSingle-J,,0,0,0,,		助かったぜ	
Dialogue: 5,1:38:16.70,1:38:18.53,DefaultSingle-J,,0,0,0,,		準備完了	
Dialogue: 5,1:38:18.53,1:38:19.38,DefaultSingle-J,,0,0,0,,		よし	
Dialogue: 5,1:38:43.15,1:38:44.28,DefaultSingle-J,,0,0,0,,		コナン君	
Dialogue: 5,1:38:45.37,1:38:46.91,DefaultSingle-J,,0,0,0,,		もうこんなところまで	
Dialogue: 5,1:38:47.70,1:38:49.26,DefaultSingle-J,,0,0,0,,		急いでくれ	
Dialogue: 5,1:38:57.41,1:38:58.45,DefaultSingle-J,,0,0,0,,		歩美	
Dialogue: 5,1:39:03.63,1:39:05.34,DefaultSingle-J,,0,0,0,,		歩美  待ってろ	
Dialogue: 5,1:39:09.17,1:39:10.27,DefaultSingle-J,,0,0,0,,		大丈夫かい？	
Dialogue: 5,1:39:16.37,1:39:17.50,DefaultSingle-J,,0,0,0,,		ひどいケガ	
Dialogue: 5,1:39:17.89,1:39:19.35,DefaultSingle-J,,0,0,0,,		どうして黙ってたの？	
Dialogue: 5,1:39:19.43,1:39:21.89,DefaultSingle-J,,0,0,0,,		今ここを離れるわけには	
Dialogue: 5,1:39:22.32,1:39:23.96,DefaultSingle-J,,0,0,0,,		これを押さえないと	
Dialogue: 5,1:39:25.04,1:39:26.53,DefaultSingle-J,,0,0,0,,		もうわかったわよ	
Dialogue: 5,1:39:26.53,1:39:27.36,DefaultSingle-J,,0,0,0,,		江戸川くん	
Dialogue: 5,1:39:27.90,1:39:29.74,DefaultSingle-J,,0,0,0,,		これ以上大きくなるとマズイわ	
Dialogue: 5,1:39:29.85,1:39:32.74,DefaultSingle-J,,0,0,0,,		もっと丈夫な柱に結び直さないと	
Dialogue: 5,1:39:32.80,1:39:35.24,DefaultSingle-J,,0,0,0,,		オレ達だけじゃ無理だ	
Dialogue: 5,1:39:35.38,1:39:38.59,DefaultSingle-J,,0,0,0,,		クソ  もっと人数が必要なのに	
Dialogue: 5,1:39:40.21,1:39:41.38,DefaultSingle-J,,0,0,0,,		高木刑事	
Dialogue: 5,1:39:40.21,1:39:41.38,DefaultSingle-J,,0,0,0,,		高木くん	
Dialogue: 5,1:39:41.46,1:39:43.67,DefaultSingle-J,,0,0,0,,		みんな避難しちまって誰もいねぇ	
Dialogue: 5,1:39:44.12,1:39:46.42,DefaultSingle-J,,0,0,0,,		このままだと渋谷が火の海に	
Dialogue: 5,1:39:47.15,1:39:48.10,DefaultSingle-J,,0,0,0,,		蘭	
Dialogue: 5,1:39:49.53,1:39:50.66,DefaultSingle-J,,0,0,0,,		新一？	
Dialogue: 5,1:39:52.41,1:39:54.50,DefaultSingle-J,,0,0,0,,		しっかりして  高木くん	
Dialogue: 5,1:40:31.31,1:40:33.00,DefaultSingle-J,,0,0,0,,		これでもう大丈夫だろう	
Dialogue: 5,1:40:33.39,1:40:35.18,DefaultSingle-J,,0,0,0,,		こっちも結び直したわ	
Dialogue: 5,1:40:35.23,1:40:36.55,DefaultSingle-J,,0,0,0,,		バッチリです	
Dialogue: 5,1:40:36.58,1:40:38.59,DefaultSingle-J,,0,0,0,,		任務完了だぜ	
Dialogue: 5,1:40:40.99,1:40:42.48,DefaultSingle-J,,0,0,0,,		サンキュー  お前ら	
Dialogue: 5,1:40:46.77,1:40:48.71,DefaultSingle-J,,0,0,0,,		何者なの？あの子	
Dialogue: 5,1:40:48.71,1:40:52.65,DefaultSingle-J,,0,0,0,,		コナンくん	
Dialogue: 5,1:40:57.17,1:41:01.59,DefaultSingle-J,,0,0,0,,		行っけぇ	
Dialogue: 5,1:41:40.34,1:41:41.25,DefaultSingle-J,,0,0,0,,		止まった	
Dialogue: 5,1:41:59.29,1:42:00.72,DefaultSingle-J,,0,0,0,,		ここにいたんだ	
Dialogue: 5,1:42:01.07,1:42:02.39,DefaultSingle-J,,0,0,0,,		なんとかなりそう？	
Dialogue: 5,1:42:03.88,1:42:07.52,DefaultSingle-J,,0,0,0,,		あと一時間もすれば完全に中和できるらしい	
Dialogue: 5,1:42:07.54,1:42:10.11,DefaultSingle-J,,0,0,0,,		さすが公安  仕事が早いね	
Dialogue: 5,1:42:10.22,1:42:12.34,DefaultSingle-J,,0,0,0,,		さすがなのは君の方だよ	
Dialogue: 5,1:42:13.05,1:42:15.11,DefaultSingle-J,,0,0,0,,		よくあんな手を思いついたな	
Dialogue: 5,1:42:15.65,1:42:17.64,DefaultSingle-J,,0,0,0,,		ヒントをくれた人がいるんだ	
Dialogue: 5,1:42:18.37,1:42:20.84,DefaultSingle-J,,0,0,0,,		ずいぶん前のことになるけど	
Dialogue: 5,1:42:24.51,1:42:27.66,DefaultSingle-J,,0,0,0,,		新一がボール変なとこ当てるから	
Dialogue: 5,1:42:28.04,1:42:30.28,DefaultSingle-J,,0,0,0,,		泣くなよ  蘭  大丈夫だから	
Dialogue: 5,1:42:32.51,1:42:33.63,DefaultSingle-J,,0,0,0,,		クソッ	
Dialogue: 5,1:42:33.79,1:42:35.33,DefaultSingle-J,,0,0,0,,		こら  ボウズ	
Dialogue: 5,1:42:36.77,1:42:39.38,DefaultSingle-J,,0,0,0,,		テメェの女  泣かしてんじゃねぇよ	
Dialogue: 5,1:42:45.28,1:42:46.36,DefaultSingle-J,,0,0,0,,		止まった	
Dialogue: 5,1:42:49.80,1:42:52.03,DefaultSingle-J,,0,0,0,,		ハギ  何やってんだ	
Dialogue: 5,1:42:52.03,1:42:54.45,DefaultSingle-J,,0,0,0,,		陣平ちゃん  電話  水道局	
Dialogue: 5,1:42:55.02,1:42:55.82,DefaultSingle-J,,0,0,0,,		なんで	
Dialogue: 5,1:42:57.19,1:42:58.94,DefaultSingle-J,,0,0,0,,		急に思い出したんだよ	
Dialogue: 5,1:42:59.35,1:43:03.14,DefaultSingle-J,,0,0,0,,		あの手を使えば爆発を止められるかもしれないって	
Dialogue: 5,1:43:03.47,1:43:07.24,DefaultSingle-J,,0,0,0,,		その人がなんだか萩原って人に似てたんだよね	
Dialogue: 5,1:43:09.99,1:43:11.09,DefaultSingle-J,,0,0,0,,		どうかした？	
Dialogue: 5,1:43:12.53,1:43:14.84,DefaultSingle-J,,0,0,0,,		いや  別に	
Dialogue: 5,1:43:17.48,1:43:20.36,DefaultSingle-J,,0,0,0,,		あれ？さっきまでいたのに	
Dialogue: 5,1:43:20.41,1:43:22.42,DefaultSingle-J,,0,0,0,,		どこ行っちゃったんだよ	
Dialogue: 5,1:43:22.51,1:43:25.68,DefaultSingle-J,,0,0,0,,		あの人達がいたから  ボク達助かったんです	
Dialogue: 5,1:43:25.68,1:43:29.04,DefaultSingle-J,,0,0,0,,		いなかったら今ごろ渋谷は火の海だっただろう	
Dialogue: 5,1:43:31.14,1:43:32.94,DefaultSingle-J,,0,0,0,,		高木君  気をしっかり	
Dialogue: 5,1:43:33.73,1:43:35.19,DefaultSingle-J,,0,0,0,,		佐藤さん	
Dialogue: 5,1:43:35.44,1:43:37.67,DefaultSingle-J,,0,0,0,,		おい  こっち手伝ってくれ	
Dialogue: 5,1:43:37.67,1:43:38.31,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,1:43:38.54,1:43:39.84,DefaultSingle-J,,0,0,0,,		佐藤さん	
Dialogue: 5,1:43:40.13,1:43:44.60,DefaultSingle-J,,0,0,0,,		たぶん僕  この後手術することになると思うんですけど	
Dialogue: 5,1:43:44.66,1:43:45.95,DefaultSingle-J,,0,0,0,,		そ  そうね	
Dialogue: 5,1:43:46.03,1:43:49.54,DefaultSingle-J,,0,0,0,,		それがうまくいくように  おまじないを	
Dialogue: 5,1:43:49.65,1:43:50.45,DefaultSingle-J,,0,0,0,,		おまじない？	
Dialogue: 5,1:43:54.82,1:43:55.81,DefaultSingle-J,,0,0,0,,		ったく	
Dialogue: 5,1:43:56.24,1:43:58.96,DefaultSingle-J,,0,0,0,,		そんな元気があるなら大丈夫そうね	
Dialogue: 5,1:43:59.37,1:44:01.21,DefaultSingle-J,,0,0,0,,		佐藤…さん…	
Dialogue: 5,1:49:15.90,1:49:17.55,DefaultSingle-J,,0,0,0,,		高木	
Dialogue: 5,1:49:17.58,1:49:19.46,DefaultSingle-J,,0,0,0,,		何勝手に死ねんだ	
Dialogue: 5,1:49:19.46,1:49:20.65,DefaultSingle-J,,0,0,0,,		バカヤロ	
Dialogue: 5,1:49:22.62,1:49:23.91,DefaultSingle-J,,0,0,0,,		それ  確保	
Dialogue: 5,1:49:30.49,1:49:31.92,DefaultSingle-J,,0,0,0,,		おのれ  暴漢	
Dialogue: 5,1:49:33.24,1:49:34.56,DefaultSingle-J,,0,0,0,,		それいけ	
Dialogue: 5,1:49:34.56,1:49:35.80,DefaultSingle-J,,0,0,0,,		よし  そこだ	
Dialogue: 5,1:49:41.05,1:49:41.93,DefaultSingle-J,,0,0,0,,		ちょっと	
Dialogue: 5,1:49:42.11,1:49:44.35,DefaultSingle-J,,0,0,0,,		病院で寝てたのに  今度は何？	
Dialogue: 5,1:49:44.59,1:49:46.07,DefaultSingle-J,,0,0,0,,		何をやっとる	
Dialogue: 5,1:49:46.07,1:49:49.72,DefaultSingle-J,,0,0,0,,		今度は方面本部長のおばあさまの葬式を襲撃すると	
Dialogue: 5,1:49:49.72,1:49:51.33,DefaultSingle-J,,0,0,0,,		予告があったんだぞ	
Dialogue: 5,1:49:51.39,1:49:53.21,DefaultSingle-J,,0,0,0,,		訓練だからって気を抜くな	
Dialogue: 5,1:49:53.21,1:49:54.12,DefaultSingle-J,,0,0,0,,		はい	
Dialogue: 5,1:49:55.45,1:49:56.32,DefaultSingle-J,,0,0,0,,		あの	
Dialogue: 5,1:49:56.62,1:49:59.54,DefaultSingle-J,,0,0,0,,		僕  この格好する意味あります？	
Dialogue: 5,1:49:59.99,1:50:01.06,DefaultSingle-J,,0,0,0,,		ねぇ	
Dialogue: 5,1:50:01.39,1:50:02.83,DefaultSingle-J,,0,0,0,,		おい	
Dialogue: 5,1:50:17.13,1:50:20.10,DefaultSingle-J,,0,0,0,,		会いたかったぜ  シェリー	
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
