1
00:00:30,156 --> 00:00:32,950
(ドキンちゃん)
フフ フンフン フンフ～ン♪

2
00:00:33,451 --> 00:00:35,953
フフフーン フーン♪

3
00:00:37,163 --> 00:00:38,956
しょくぱんまんさま…

4
00:00:39,248 --> 00:00:40,708
(しょくぱんまん)
ドキンちゃん ドキンちゃん

5
00:00:40,791 --> 00:00:42,543
ドキンちゃん
ドキンちゃん ドキンちゃん

6
00:00:42,626 --> 00:00:46,672
ドキンちゃん ドキンちゃん
ドキンちゃん ドキンちゃん

7
00:00:46,756 --> 00:00:48,215
(ばいきんまん) ドキンちゃん！

8
00:00:49,967 --> 00:00:51,218
なにしてんの？

9
00:00:51,302 --> 00:00:52,887
んん… ばいきんまん

10
00:00:52,970 --> 00:00:53,804
ハヒ？

11
00:00:54,013 --> 00:00:54,847
(ドキン) もう！

12
00:00:54,930 --> 00:00:57,183
レディーの へやに
かってに はいらないでよ～！

13
00:00:57,266 --> 00:00:59,810
(ばいきんまん) ハ～ヒ ごめんなさい
ごめんなさい ごめんなさい！

14
00:01:00,770 --> 00:01:01,937
(ドキン) ほんとに もう

15
00:01:02,021 --> 00:01:04,899
すこしは れいぎただしい
しょくぱんまんさまを みならったら！

16
00:01:04,982 --> 00:01:05,816
ばいきんまん

17
00:01:06,567 --> 00:01:07,651
フン　なーんだい――

18
00:01:07,735 --> 00:01:09,236
“しょくぱんまん しょくぱんまん”
って

19
00:01:09,320 --> 00:01:11,030
あんなやつの どこが…

20
00:01:11,113 --> 00:01:12,198
あ～ イタタ！ イタ イタ

21
00:01:12,281 --> 00:01:13,824
(ドキン) なによ もんくある!?

22
00:01:13,908 --> 00:01:15,159
(ばいきんまん) ごめんなさい！

23
00:01:15,242 --> 00:01:16,702
うっ うう…

24
00:01:16,786 --> 00:01:17,620
あっ

25
00:01:18,287 --> 00:01:19,872
まって ばいきんまん

26
00:01:19,955 --> 00:01:21,749
ばいきんま～ん！

27
00:01:21,999 --> 00:01:24,126
ゲッ　おれさまに よう？

28
00:01:24,668 --> 00:01:26,879
バイキンせんにんの
おじいちゃんちへ いって――

29
00:01:26,962 --> 00:01:28,839
クレヨン かりてきてよ

30
00:01:29,048 --> 00:01:31,217
バイキンせんにんの ところ？

31
00:01:31,300 --> 00:01:33,719
そう ドキンちゃんの
たのみだって いえば――

32
00:01:33,803 --> 00:01:36,180
な～んでも かしてくれるはずよ

33
00:01:36,597 --> 00:01:38,557
うーん“なんでも”ね…

34
00:01:38,641 --> 00:01:39,517
“なんでも”!?

35
00:01:40,351 --> 00:01:42,436
いってきま～す！

36
00:01:43,312 --> 00:01:44,730
グフフフフフッ

37
00:01:44,814 --> 00:01:46,357
“ドキンちゃんの たのみだ”って
いって――

38
00:01:46,440 --> 00:01:47,525
バイキンせんにん から――

39
00:01:47,775 --> 00:01:49,485
まほうのふでを かりてやるのだ

40
00:01:49,568 --> 00:01:51,487
ハヒフヘホ～

41
00:01:53,906 --> 00:01:55,115
(バイキンせんにん) なんじゃと？

42
00:01:55,199 --> 00:01:57,493
“まほうのふでを かしてくれ”？

43
00:01:58,160 --> 00:01:59,411
そうなのだ

44
00:01:59,495 --> 00:02:00,913
ドキンちゃんが
べんきょうするのに――

45
00:02:00,996 --> 00:02:03,165
どうしても
まほうのふでじゃなきゃ ダメだって――

46
00:02:03,249 --> 00:02:04,750
もう きかないのだ

47
00:02:05,167 --> 00:02:07,419
(せんにん)
おお ドキンちゃんがな

48
00:02:07,503 --> 00:02:11,382
よーし そういうことなら
まほうのふでを かしてやろう

49
00:02:11,465 --> 00:02:14,009
いでよ まほうのふで

50
00:02:14,760 --> 00:02:16,595
だあ！ どうも どうも なのだ

51
00:02:16,846 --> 00:02:18,597
ばいばいき～ん

52
00:02:19,181 --> 00:02:21,642
(せんにん) ドキンちゃんが
べんきょうをなあ…

53
00:02:21,725 --> 00:02:23,644
かんしん かんしん

54
00:02:24,061 --> 00:02:26,981
ん？ べんきょうするのに
まほうのふで？

55
00:02:27,064 --> 00:02:29,108
かりてしまえば こっちのもの

56
00:02:29,191 --> 00:02:31,569
しょくぱんまんを
まっくろけに してやるのだ

57
00:02:34,405 --> 00:02:36,198
(カレーパンマン)
う～ん きょうも いいてんき

58
00:02:36,282 --> 00:02:38,284
スカッとカレーばれだぜ

59
00:02:38,951 --> 00:02:40,995
チッ！ カレーパンマンか

60
00:02:41,078 --> 00:02:43,539
まっ いいや
まずは あいつでテストなのだ

61
00:02:48,878 --> 00:02:50,546
こんにちは カレーパンマン

62
00:02:50,963 --> 00:02:51,797
あん？

63
00:02:52,047 --> 00:02:54,383
いけ！ まっくろおばけ！

64
00:02:54,466 --> 00:02:56,510
(まっくろおばけ)
まっくろ くろくろくろくろ

65
00:02:56,594 --> 00:02:59,597
わっと なな… なな あ～ととと…

66
00:02:59,680 --> 00:03:03,976
うわああああ～

67
00:03:04,059 --> 00:03:04,894
げっ！

68
00:03:05,227 --> 00:03:07,438
やった やった ハヒフヘホ～

69
00:03:07,521 --> 00:03:09,899
よーし どんどん いくぞ～！

70
00:03:12,401 --> 00:03:14,653
みんな まっくろけに してやる

71
00:03:14,737 --> 00:03:16,614
それいけ まっくろおばけ！

72
00:03:16,697 --> 00:03:21,035
(まっくろおばけ)
くろくろくろくろ くろくろくろくろ

73
00:03:23,621 --> 00:03:26,165
(ジャムおじさん)
うん うん うん うん

74
00:03:26,248 --> 00:03:27,124
(まっくろおばけたち)
まっくろくろくろ

75
00:03:27,207 --> 00:03:28,125
(ジャム) お？
(チーズ) アン？

76
00:03:29,627 --> 00:03:30,586
(まっくろおばけたち)
くろくろくろ

77
00:03:30,669 --> 00:03:33,923
(ジャム) うわあー！
なんだ なんだ おおー！

78
00:03:34,006 --> 00:03:36,634
(バタコさん) キャア～！
(まっくろおばけたち) くろくろ

79
00:03:36,717 --> 00:03:39,136
(ジャムたち) わあ～

80
00:03:39,553 --> 00:03:43,390
(ジャム) よっと
よっと！ もう… ううっと…

81
00:03:43,474 --> 00:03:44,308
(チーズ) アン…

82
00:03:44,391 --> 00:03:48,187
ダメだ…
どんどん ちからが ぬけていく

83
00:03:48,270 --> 00:03:49,313
(バタコ) ジャムおじさん…

84
00:03:49,521 --> 00:03:50,773
そーれ それ！

85
00:03:50,856 --> 00:03:52,566
みんなのちからを すいとってしまえ

86
00:03:52,650 --> 00:03:55,569
(まっくろおばけたち)
まっくろ くろくろ くろくろ

87
00:03:56,070 --> 00:03:58,572
(ジャム) いかん… ちからが…

88
00:04:01,367 --> 00:04:02,910
(ジャム) たすけてくれ～

89
00:04:02,993 --> 00:04:03,827
(バタコ) アンパンマ～ン

90
00:04:03,911 --> 00:04:05,913
(アンパンマン) あっ あのこえは！

91
00:04:07,790 --> 00:04:09,166
どうしたんだろう

92
00:04:09,249 --> 00:04:10,584
パンこうじょうが！

93
00:04:12,461 --> 00:04:17,758
ジャムおじさーん バタコさーん
だいじょうぶですかー？

94
00:04:17,841 --> 00:04:19,093
(まっくろおばけ)
まっくろくろくろくろ

95
00:04:19,176 --> 00:04:21,136
(アンパンマン)
うっ！ か… かおが…

96
00:04:21,470 --> 00:04:23,389
くらえ バイキンキック！

97
00:04:24,390 --> 00:04:27,643
(アンパンマン) うわ～っ

98
00:04:27,935 --> 00:04:30,938
ナ～ハハハハッ ざまあみろ～

99
00:04:31,021 --> 00:04:32,523
ばいばいき～んっと

100
00:04:32,606 --> 00:04:33,691
(カレーパンマン) うーん…

101
00:04:33,774 --> 00:04:35,150
(アンパンマン) うわあー！
(カレーパンマン) あっ

102
00:04:35,234 --> 00:04:37,236
(アンパンマン) ああ～

103
00:04:37,319 --> 00:04:38,946
(カレーパンマン)
お～とととと　うわあ～！

104
00:04:39,905 --> 00:04:40,948
だいじょうぶか？

105
00:04:41,031 --> 00:04:43,200
かおが よごれて ちからが…

106
00:04:43,283 --> 00:04:44,660
ばいきんまんの しわざだ

107
00:04:44,910 --> 00:04:45,744
(アンパンマン) そうか…

108
00:04:45,828 --> 00:04:46,662
あっ そうだ

109
00:04:46,745 --> 00:04:49,289
アンパンマンのマントを
おれに かしてくれよ

110
00:04:50,332 --> 00:04:51,667
ぼくのマントを？

111
00:04:51,917 --> 00:04:55,087
うん　おれのマントは
よごれて ダメなんだ

112
00:04:55,170 --> 00:04:56,171
たすけをよんでくるから

113
00:05:00,759 --> 00:05:02,511
うまく とべるかな？

114
00:05:02,594 --> 00:05:03,429
それっと！

115
00:05:04,430 --> 00:05:06,432
おっと あちゃちゃちゃ！

116
00:05:07,141 --> 00:05:09,685
うう… ああ… やっと ほれ！

117
00:05:10,394 --> 00:05:13,188
たのんだよ カレーパンマン…

118
00:05:13,772 --> 00:05:16,942
(みみせんせい)
はい １ ２ ３ ４！

119
00:05:17,484 --> 00:05:20,571
(こどもたち) １ ２ ３ ４！

120
00:05:20,654 --> 00:05:22,197
(みみ) ２ ２ ３…

121
00:05:22,281 --> 00:05:25,659
よーし いけいけ まっくろおばけ～

122
00:05:25,743 --> 00:05:27,870
(まっくろおばけたち)
まっくろくろくろ

123
00:05:29,121 --> 00:05:31,832
キャア ああ… なあに ああ！

124
00:05:32,332 --> 00:05:33,751
ああ… あ…

125
00:05:33,834 --> 00:05:35,711
(カバお) うわあ な… なんだ!?

126
00:05:35,794 --> 00:05:36,754
(ピョンきち) まっくろけだ！

127
00:05:37,629 --> 00:05:39,173
(ネコみ) なに… なに？

128
00:05:39,256 --> 00:05:41,008
(ブタお) ちからが ぬけちゃったよ…

129
00:05:41,800 --> 00:05:44,720
みなさん… はやく きょうしつへ

130
00:05:44,803 --> 00:05:47,681
でもね ぼくね
ちょっぴり しあわせ

131
00:05:47,765 --> 00:05:49,725
(みみ)
なに のんきなこと いってんの！

132
00:05:49,808 --> 00:05:52,019
たすけて アンパンマン！

133
00:05:53,312 --> 00:05:55,022
いけない みんなが…

134
00:05:55,731 --> 00:05:58,400
な… なんとかしなくちゃ

135
00:05:58,484 --> 00:06:00,861
うっ… うう ダメだ…

136
00:06:02,780 --> 00:06:03,822
(みずのこ) よし みんな！

137
00:06:03,906 --> 00:06:04,823
(みずのこたち) うん！

138
00:06:06,116 --> 00:06:07,534
アンパンマン！

139
00:06:08,744 --> 00:06:11,371
あ… みずのこくんたち

140
00:06:11,997 --> 00:06:13,957
(みずのこ)
げんきをだして アンパンマン

141
00:06:14,041 --> 00:06:17,461
カレーパンマンのマントは
ぼくたちが きれいにするからね

142
00:06:17,711 --> 00:06:19,713
(アンパンマン) うっ… ありがとう

143
00:06:19,797 --> 00:06:20,923
(メロンパンナ) アンパンマーン
(みずのこたち) あっ

144
00:06:21,215 --> 00:06:23,050
(アンパンマン) メロンパンナちゃん

145
00:06:24,259 --> 00:06:26,303
(メロンパンナ)
カレーパンマンにきいて とんできたの

146
00:06:26,386 --> 00:06:28,180
(アンパンマン)
うん カレーパンマンは？

147
00:06:29,098 --> 00:06:30,682
しょくぱんまんたちと いっしょに――

148
00:06:30,766 --> 00:06:33,018
パンこうじょうの
おおそうじに いったわ

149
00:06:33,102 --> 00:06:35,521
あたしは みずのこさんたちに――

150
00:06:35,604 --> 00:06:37,397
おうえんを たのみに きたんだ

151
00:06:37,856 --> 00:06:40,859
(みずのこ) よし！ ぼくたちも
パンこうじょうへ いこう！

152
00:06:40,943 --> 00:06:42,069
(みずのこたち) おー！

153
00:06:45,072 --> 00:06:46,448
まってて　ジャムおじさんに――

154
00:06:46,532 --> 00:06:48,826
あたらしい かおを
やいてもらってくる！

155
00:06:49,743 --> 00:06:52,204
たのんだよ メロンパンナちゃん…

156
00:06:52,287 --> 00:06:57,376
(まちのひとたちの さけびごえ)

157
00:06:57,626 --> 00:06:59,878
いいぞ いいぞ いいぞ
それ それ それ！

158
00:07:01,255 --> 00:07:04,216
(メロンパンナ) うわあ
どんどん よごれが おちてる

159
00:07:04,883 --> 00:07:06,343
あとは かわかすだけだ

160
00:07:06,426 --> 00:07:08,387
たのむよ メロンパンナちゃん！

161
00:07:09,179 --> 00:07:10,097
うん！

162
00:07:15,936 --> 00:07:17,104
だいじょうぶ？

163
00:07:17,187 --> 00:07:18,397
(メロンパンナ) うん！ いそごう

164
00:07:21,066 --> 00:07:22,317
(ジャム) なんだか きゅうに――

165
00:07:22,401 --> 00:07:24,611
ちからが ぬけてしまってね

166
00:07:25,112 --> 00:07:27,739
(カレーパンマン) ばいきんまんの
まっくろおばけの せいだぜ

167
00:07:27,823 --> 00:07:30,325
(おそうじまん) なあに
ぼくらが きれいにしてみせますよ

168
00:07:30,409 --> 00:07:31,368
(タワシくん) わたしはタワシ！

169
00:07:31,451 --> 00:07:32,619
(メロンパンナ) みんなー！
(ジャムたち) ん？

170
00:07:33,203 --> 00:07:36,123
みずのこさんたちを
よんできたわよー！

171
00:07:36,582 --> 00:07:38,000
(しょくぱんまん) メロンパンナちゃん

172
00:07:38,083 --> 00:07:41,128
(カレーパンマン) うわあ
おれのマントが きれいになってら

173
00:07:42,588 --> 00:07:43,505
(しょくぱんまん) よーし

174
00:07:43,589 --> 00:07:46,925
さっそく パンこうじょうの
おおそうじを はじめましょう！

175
00:07:47,384 --> 00:07:48,510
(カレーパンマン) たのむぜ みんな！

176
00:07:48,969 --> 00:07:50,387
まかせなさい！

177
00:07:50,470 --> 00:07:51,889
(タワシ)
わたしはタワシ

178
00:07:54,266 --> 00:07:56,643
たた… タワシ
わたしはタワシ

179
00:07:57,060 --> 00:07:58,228
(ジャム) おおっ ほう

180
00:07:58,312 --> 00:07:59,146
(チーズ) アンアン！

181
00:07:59,521 --> 00:08:01,648
(シャボンダマン) ぼくたちも やるぞ

182
00:08:02,107 --> 00:08:03,233
ふう～

183
00:08:03,317 --> 00:08:04,151
(みずのこたち) それー！

184
00:08:04,902 --> 00:08:08,155
(みずのこたちの かけごえ)

185
00:08:09,031 --> 00:08:11,575
ふう～ ふう～

186
00:08:12,284 --> 00:08:14,077
(メロンパンナ) フフッ
(カレーパンマン) えい

187
00:08:17,789 --> 00:08:20,250
(ジャム)
おお！ ちからが もどってきた

188
00:08:20,334 --> 00:08:22,085
(バタコ) ありがとう みんな
(チーズ) アンアン！

189
00:08:30,510 --> 00:08:31,929
(みずのこたち)
やったー！

190
00:08:32,012 --> 00:08:32,888
(ジャム) さあ はやく――

191
00:08:32,971 --> 00:08:34,556
アンパンマンの
かおを やこう

192
00:08:34,640 --> 00:08:35,474
(バタコ) はい！

193
00:08:35,891 --> 00:08:38,560
やっぱり じぶんのマントは いいな

194
00:08:38,769 --> 00:08:40,520
みずのこくんたち ありがとう

195
00:08:41,521 --> 00:08:42,773
(みずのこ)
かわかしてくれたのは――

196
00:08:42,856 --> 00:08:44,191
メロンパンナちゃんだよ

197
00:08:44,274 --> 00:08:45,359
(メロンパンナ) フフフッ

198
00:08:45,442 --> 00:08:46,276
(カレーパンマン)
じゃあさ――

199
00:08:46,360 --> 00:08:48,070
おれたちは
さきに いくから――

200
00:08:48,153 --> 00:08:50,155
メロンパンナちゃんは
アンパンマンに――

201
00:08:50,239 --> 00:08:52,241
あたらしい かおと
マントをとどけてくれ

202
00:08:52,699 --> 00:08:53,992
うん！ まかせて

203
00:08:57,621 --> 00:08:58,455
じゃん！

204
00:08:58,956 --> 00:09:00,082
(カレーパンマン) うわあーっと
(しょくぱんまん) うあ！

205
00:09:00,165 --> 00:09:01,041
(カレーパンマン) ばいきんまん！

206
00:09:01,124 --> 00:09:02,292
(しょくぱんまん)
いたずらは やめなさい！

207
00:09:02,376 --> 00:09:03,335
やなこった

208
00:09:03,418 --> 00:09:04,836
ほれほれ
みんな まっくろにしてやる

209
00:09:04,920 --> 00:09:06,129
(まっくろおばけたち)
まっくろくろくろ

210
00:09:06,213 --> 00:09:08,507
まっくろくろくろ まっくろくろ

211
00:09:08,882 --> 00:09:11,176
おっと おなじては くわないぜ！

212
00:09:12,261 --> 00:09:14,471
(まっくろおばけたち)
まっくろくろ まっくろくろ

213
00:09:14,888 --> 00:09:15,806
おのれ おのれ

214
00:09:15,889 --> 00:09:19,559
もっと おっきな まっくろおばけ
でてこ～い！

215
00:09:20,435 --> 00:09:22,562
ううっ… こいつは おおものだぜ

216
00:09:22,646 --> 00:09:23,563
そうですね

217
00:09:23,981 --> 00:09:26,525
(ばいきんまん) ヌヒッ ヌフフフフッ

218
00:09:30,445 --> 00:09:32,072
よし やけだぞ！

219
00:09:32,155 --> 00:09:33,782
(バタコ) まって メロンパンナちゃん！

220
00:09:33,865 --> 00:09:34,741
(メロンパンナ) ん？

221
00:09:34,825 --> 00:09:38,287
こうして マントを にじゅうにすれば
はやくとべるよ

222
00:09:38,704 --> 00:09:39,788
いってきまーす！

223
00:09:41,623 --> 00:09:43,041
(ジャム) たのんだよー

224
00:09:43,333 --> 00:09:45,294
(まっくろおばけ)
まっくろくろくろくろ

225
00:09:45,377 --> 00:09:48,005
よーし いけー！
ジャンボまっくろおばけ！

226
00:09:48,088 --> 00:09:49,715
(まっくろおばけ) まっくろくろくろ

227
00:09:49,798 --> 00:09:51,425
(しょくぱんまん) うわあー！ ああ…

228
00:09:51,508 --> 00:09:54,469
(カレーパンマン) うううっ

229
00:09:55,762 --> 00:09:57,472
(メロンパンナ) アンパンマーン！
(アンパンマン) あっ

230
00:09:57,764 --> 00:09:59,725
(メロンパンナ)
あたらしい かおと マントよ！

231
00:09:59,808 --> 00:10:00,809
それ！

232
00:10:02,894 --> 00:10:04,938
ありがとう メロンパンナちゃん

233
00:10:05,856 --> 00:10:07,274
げんき100ばい

234
00:10:08,108 --> 00:10:09,192
アンパンマン！

235
00:10:09,568 --> 00:10:11,278
(カレーパンマン) うわあー！
(まっくろおばけ) まっくろくろくろ

236
00:10:11,361 --> 00:10:12,779
(カレーパンマンたち) うわあっ

237
00:10:12,863 --> 00:10:14,865
(しょくぱんまん) しつこいやつだ
(まっくろおばけ) まっくろくろくろ

238
00:10:14,948 --> 00:10:17,409
(ばいきんまん)
ナ～ハハハッ いいぞ いいぞ

239
00:10:17,492 --> 00:10:19,286
(アンパンマン) まて ばいきんまん！
(ばいきんまん) ん？

240
00:10:19,619 --> 00:10:21,580
ありゃ？ いつのまに！

241
00:10:22,205 --> 00:10:25,167
クッソ まとめて やつけてやる！

242
00:10:25,250 --> 00:10:27,794
(メロンパンナ)
メロンパンナのメロメロパンチ！

243
00:10:30,630 --> 00:10:32,049
(ばいきんまん) どわわわっ
なんだ なんだ なんだ!?

244
00:10:32,132 --> 00:10:35,635
(まっくろおばけ) メロ～
メロメロメロメロ メロ～

245
00:10:35,719 --> 00:10:37,804
(ばいきんまん)
どわ～ あらら うわ うわ うわ

246
00:10:38,138 --> 00:10:39,514
(アンパンマン) アンパン
(しょくぱんまん) しょくぱん

247
00:10:39,598 --> 00:10:40,515
(カレーパンマン) カレーパン

248
00:10:40,599 --> 00:10:42,059
(３にん) トリプルパーンチ

249
00:10:42,267 --> 00:10:45,645
(ばいきんまん)
ぐわっ！ ばいばいき～ん

250
00:10:47,564 --> 00:10:48,440
(メロンパンナ) やったー！

251
00:10:48,523 --> 00:10:49,775
(しょくぱんまん) やりましたね

252
00:10:49,858 --> 00:10:51,818
(カレーパンマン) だけど
かおのカレーが へっちゃって――

253
00:10:51,902 --> 00:10:53,320
ちからが でないぜ

254
00:10:53,403 --> 00:10:55,113
(アンパンマン) それじゃ
ジャムおじさんに たのもう

255
00:10:55,197 --> 00:10:56,031
(カレーパンマン) ああ

256
00:10:56,865 --> 00:10:57,824
(せんにん) バカもの！

257
00:10:57,908 --> 00:10:59,034
(ばいきんまん) ハヒ！

258
00:10:59,493 --> 00:11:00,744
べんきょうどころか――

259
00:11:00,744 --> 00:11:04,915
まほうのふでで いたずらばかりとは
あきれたやつじゃ もう…

260
00:11:05,332 --> 00:11:06,541
(ばいきんまん) ハヒ…

261
00:11:08,168 --> 00:11:10,712
ふつうのクレヨンがあれば いいの

262
00:11:10,796 --> 00:11:13,340
さて つづきをやろうっと！

263
00:11:14,216 --> 00:11:17,511
ドキンちゃん いったい
なんの べんきょうをしてるんじゃ？

264
00:11:18,804 --> 00:11:20,138
“べんきょう”？

265
00:11:22,307 --> 00:11:24,851
(せんにん)
ふ～ん うまいもんじゃな

266
00:11:25,519 --> 00:11:26,645
(ドキン) できた！

267
00:11:27,813 --> 00:11:29,439
ねえねえ どう？

268
00:11:32,025 --> 00:11:34,111
(ばいきんまん)
だあ！ また しょくぱんまん

269
00:11:34,194 --> 00:11:36,988
か～！ くやしい くやしい
くやしい くやしい

270
00:11:37,072 --> 00:11:37,906
(ふたり) フフフッ

271
00:11:38,323 --> 00:11:42,869
(まちのひとたちの はなしごえ)

272
00:11:43,203 --> 00:11:45,831
(しょくぱんまん)
まちも もとおどおり
きれいに なりましたね

273
00:11:45,914 --> 00:11:48,208
(アンパンマン)
うん！ みんな うれしそう

274
00:11:48,291 --> 00:11:50,293
(メロンパンナ)
まえより きれいに なったみたい

275
00:11:50,377 --> 00:11:53,505
(みみ) あ～ら ありがとう
メロンパンナちゃん

276
00:11:53,588 --> 00:11:56,299
なんか かんちがいしてるみたい
みみせんせい

277
00:11:56,383 --> 00:11:57,884
ハハハハッ

278
00:11:57,968 --> 00:11:59,928
どうだい？ とくせいのカレーは

279
00:12:00,011 --> 00:12:02,806
はい バッチリです
げんき100ばい！

280
00:12:02,889 --> 00:12:05,392
(ジャム) きょうは たっぷりあるから
みんなに ごちそうだ

281
00:12:05,475 --> 00:12:06,309
(カレーパンマン) うん

282
00:12:06,393 --> 00:12:09,688
みんな～ ジャムおじさんが
カレーをごちそうしてくれるよ！

283
00:12:09,771 --> 00:12:12,607
(まちのひとたち) わ～い やったー！

284
00:12:25,537 --> 00:12:26,621
(カレーパンマン) エヘヘッ

285
00:12:50,562 --> 00:12:52,063
(しょくぱんまん)
じゃあ また うかがいます

286
00:12:52,147 --> 00:12:53,940
(ウサこ) ありがとう しょくぱんまん

287
00:12:54,024 --> 00:12:54,900
(レアチーズ) アンアン！

288
00:12:55,150 --> 00:12:56,902
アハハハハハッ

289
00:12:56,985 --> 00:12:59,571
わかってますよ レアチーズちゃん

290
00:12:59,654 --> 00:13:01,364
チーズに よろしく つたえます

291
00:13:01,615 --> 00:13:03,450
クン… アン～

292
00:13:03,533 --> 00:13:05,243
まあ レアチーズったら

293
00:13:05,577 --> 00:13:08,246
(しょくぱんまんたちの わらいごえ)

294
00:13:09,456 --> 00:13:11,833
(ドキンちゃん) きょうこそ
しょくぱんまんさまに…

295
00:13:11,917 --> 00:13:13,335
(ネコみ) しょくぱんまーん

296
00:13:13,418 --> 00:13:14,252
(ドキン) んっ

297
00:13:15,003 --> 00:13:16,379
いっしょに あそびましょ

298
00:13:16,463 --> 00:13:17,339
(ネコみ) うん あそぼ！

299
00:13:17,422 --> 00:13:20,217
(ネコみたちの はしゃぐこえ)

300
00:13:20,300 --> 00:13:24,513
しょ… しょくぱんまんさまったら
あんな ニヤニヤしちゃって

301
00:13:25,639 --> 00:13:26,890
(ばいきんまん) ドキンちゃん！

302
00:13:26,973 --> 00:13:27,974
なによ！

303
00:13:28,058 --> 00:13:29,100
おわっと うっ…

304
00:13:29,184 --> 00:13:30,185
ああ もう！

305
00:13:30,268 --> 00:13:33,104
はなたば わたせやしないじゃないの～

306
00:13:33,188 --> 00:13:34,481
なに おこってんの？ ドキン…

307
00:13:34,564 --> 00:13:35,899
じゃまよ！ ばいきんまん

308
00:13:35,982 --> 00:13:39,736
わっ！ ららららら あああ…

309
00:13:42,072 --> 00:13:43,031
イテテテテテ

310
00:13:43,114 --> 00:13:44,741
(こどもたちの はしゃぐこえ)
(ばいきんまん) ん？

311
00:13:45,367 --> 00:13:47,035
しょくぱんまん…

312
00:13:48,286 --> 00:13:49,412
クソ～！

313
00:13:49,496 --> 00:13:51,414
また あいつのせいか

314
00:13:51,498 --> 00:13:55,252
う～ん どうにかして
しょくぱんまんを…

315
00:13:55,335 --> 00:13:56,294
ん？

316
00:13:56,503 --> 00:13:57,587
ピンポ～ン

317
00:13:57,671 --> 00:13:59,422
いい ほうほうを おもいついたぞ！

318
00:14:00,131 --> 00:14:01,925
グフフフフフッ

319
00:14:02,467 --> 00:14:03,927
ハヒフヘホ～

320
00:14:04,052 --> 00:14:09,933
(かみなりの おと)

321
00:14:14,437 --> 00:14:15,272
(ばいきんまん) …てなわけで

322
00:14:15,355 --> 00:14:18,483
これぞ てんさいかがくしゃ
ばいきんまんさまが つくりあげた――

323
00:14:18,567 --> 00:14:20,735
バイキンしょくぱんまんごう なのだ！

324
00:14:23,113 --> 00:14:24,781
このバイキンしょくぱんまんごうと――

325
00:14:24,864 --> 00:14:28,243
ほんものの しょくぱんまんごうを
とりかえれば…

326
00:14:28,326 --> 00:14:29,911
ナハハハハッ

327
00:14:29,995 --> 00:14:33,123
しょくぱんまんの にんきは
がたおち まちがいな～し

328
00:14:41,673 --> 00:14:43,633
よーし みつけたのだ

329
00:14:59,941 --> 00:15:01,526
ばいばいき～んっと

330
00:15:01,610 --> 00:15:03,486
(みずに おちたおと)

331
00:15:08,825 --> 00:15:12,495
いまの しょくぱんまんごう
みたいだったけど…

332
00:15:16,499 --> 00:15:17,417
(しょくぱんまん) それっ

333
00:15:18,960 --> 00:15:21,755
もくもくカムフラージュ
スイッチ オン！

334
00:15:23,465 --> 00:15:26,718
このめがねを かければ
くものなかでも よーく みえるのだ

335
00:15:26,926 --> 00:15:28,720
グフフフフフフッ

336
00:15:29,304 --> 00:15:30,722
いまなのだ

337
00:15:31,389 --> 00:15:33,850
(エンジンが かかったおと)
どうしたんでしょう

338
00:15:33,933 --> 00:15:34,809
ああ！

339
00:15:35,226 --> 00:15:37,771
あっ それそれそれ そ～れそれ

340
00:15:43,026 --> 00:15:44,819
ああ… だ… ダメだ

341
00:15:44,903 --> 00:15:47,197
ハンドルもブレーキも ききません！
うわっ！

342
00:15:47,280 --> 00:15:48,990
ハヒフヘホ～

343
00:15:49,074 --> 00:15:50,116
いけー！

344
00:15:51,618 --> 00:15:52,869
(カバお) おばちゃん
おはな ちょうだい

345
00:15:52,952 --> 00:15:54,579
(きゅうブレーキの おと)
(ふたり) お？

346
00:15:55,330 --> 00:15:57,415
(しょくぱんまん)
ううっ あ… あぶない！

347
00:15:57,749 --> 00:16:01,044
(ふたり) うわ～っ

348
00:16:01,127 --> 00:16:03,588
ああ なにするの？
しょくぱんまん…

349
00:16:03,922 --> 00:16:06,174
す… すみません！

350
00:16:06,257 --> 00:16:07,092
うあっ！

351
00:16:08,677 --> 00:16:09,594
(くるまのエンジンの おと)

352
00:16:09,678 --> 00:16:10,845
(ヤギがはく) ん？ ああ！

353
00:16:12,389 --> 00:16:13,431
(ぶつかる おと)
うわああー！

354
00:16:14,140 --> 00:16:16,518
(ピョンきち)
うああー ああ… ん？

355
00:16:16,601 --> 00:16:17,936
だあー！

356
00:16:18,019 --> 00:16:21,022
な… なにを するんじゃ！
しょくぱんまん

357
00:16:23,358 --> 00:16:24,484
(ふたり) うわっ！

358
00:16:26,945 --> 00:16:27,987
ん？

359
00:16:29,280 --> 00:16:31,991
わあ～

360
00:16:34,369 --> 00:16:35,704
ごめんなさーい！

361
00:16:35,995 --> 00:16:38,707
あっ やった やった
だいせいこうっと！

362
00:16:40,125 --> 00:16:40,959
(ジャムおじさん) なんだって？

363
00:16:41,251 --> 00:16:42,711
しょくぱんまんごうが!?

364
00:16:42,794 --> 00:16:43,712
(ウサこ) うん
(レアチーズ) アン！

365
00:16:43,795 --> 00:16:44,963
(ウサこ) はやく とめないと

366
00:16:45,588 --> 00:16:47,465
(アンパンマン) ジャムおじさん
ぼく いってきます

367
00:16:47,799 --> 00:16:50,218
うん！ きをつけるんだよ

368
00:16:58,893 --> 00:17:01,354
ああっ あああ うわー！

369
00:17:02,439 --> 00:17:05,191
(アンパンマン) しょくぱんまーん

370
00:17:05,275 --> 00:17:07,068
ああ アンパンマン

371
00:17:07,152 --> 00:17:08,611
いったい どうしたの？

372
00:17:08,695 --> 00:17:12,866
それが おかしいんです
くるまが かってに…

373
00:17:12,949 --> 00:17:14,409
(アンパンマン) ああっ あああ うっ…

374
00:17:14,492 --> 00:17:16,244
(きゅうブレーキの おと)

375
00:17:17,454 --> 00:17:18,538
うわっ！

376
00:17:21,958 --> 00:17:22,959
わっ！

377
00:17:23,042 --> 00:17:26,087
か… かおが よごれて ちからが…

378
00:17:26,171 --> 00:17:27,297
(たおれた おと)

379
00:17:27,797 --> 00:17:29,090
アンパンマン！

380
00:17:29,174 --> 00:17:30,258
もう ゆるしません！

381
00:17:30,759 --> 00:17:32,302
しょくパーンチ！

382
00:17:32,385 --> 00:17:33,261
(ガラスがわれる おと)

383
00:17:35,722 --> 00:17:37,891
うっ しっかり アンパンマン！

384
00:17:38,349 --> 00:17:39,517
およよよ

385
00:17:39,601 --> 00:17:41,853
フン！ まとめて やっつけてやる！

386
00:17:47,984 --> 00:17:49,068
あぶない！

387
00:17:49,277 --> 00:17:50,737
(ばくはつする おと)

388
00:17:50,820 --> 00:17:52,155
(かびるんるんたち) かびかびかび～

389
00:17:53,698 --> 00:17:54,616
かびるんるんだ

390
00:17:57,869 --> 00:17:59,287
(かびるんるんたち) かびかびかび～

391
00:17:59,996 --> 00:18:01,831
べろべろまんに やみるんるんも！

392
00:18:05,293 --> 00:18:07,545
わっ ううっ… あれ？

393
00:18:08,838 --> 00:18:10,048
(かびるんるんたち)
かびかびかびかび～

394
00:18:10,298 --> 00:18:12,550
(しょくぱんまん)
うわあ ああ ああ…

395
00:18:18,556 --> 00:18:21,559
やっぱり しょくぱんまんごうよね…

396
00:18:21,643 --> 00:18:24,979
しょくぱんまんさまに
かえしてあげたほうが いいかしら…

397
00:18:25,605 --> 00:18:28,316
しょくぱんまんさま どうぞ

398
00:18:28,399 --> 00:18:29,943
ありがとう ドキンちゃん

399
00:18:30,443 --> 00:18:33,905
しょくぱんまんごうが まいごになって
こまっていたんです

400
00:18:33,988 --> 00:18:35,281
たすかりました

401
00:18:35,365 --> 00:18:37,408
とうぜんのことを したまで ですわ

402
00:18:38,493 --> 00:18:39,661
ドキンちゃん…

403
00:18:40,954 --> 00:18:42,372
しょくぱんまんさま…

404
00:18:42,455 --> 00:18:44,290
(こともたちの はしゃぐこえ)

405
00:18:45,041 --> 00:18:49,045
(しょくぱんまん)
フフッ アッハハ アハハハ

406
00:18:49,128 --> 00:18:50,630
みんな いっしょに あそびましょ

407
00:18:50,713 --> 00:18:52,131
(ドキン) ガ～ン

408
00:18:52,632 --> 00:18:55,885
なによ なによ！
しょくぱんまんさま なん…

409
00:18:56,135 --> 00:18:57,303
…か！

410
00:18:58,638 --> 00:18:59,472
でも…

411
00:19:03,768 --> 00:19:05,478
やっぱり かえしてあげなくちゃ

412
00:19:15,822 --> 00:19:18,992
おねがい
しょくぱんまんさまに とどけて

413
00:19:20,618 --> 00:19:21,452
アン？

414
00:19:21,870 --> 00:19:22,829
アンアン！

415
00:19:22,912 --> 00:19:24,080
(ジャム) あああ… どうしたんだい？

416
00:19:24,873 --> 00:19:25,748
(チーズ) アンアン！

417
00:19:25,832 --> 00:19:27,250
(バタコさん) どうしたの？ チーズ

418
00:19:27,333 --> 00:19:28,668
(ジャム･バタコ) ああ！

419
00:19:28,751 --> 00:19:29,586
(バタコ) これは!?

420
00:19:29,669 --> 00:19:31,796
(ジャム)
しょくぱんまんごうじゃないか

421
00:19:31,880 --> 00:19:33,548
(バタコ) おかしいわね…

422
00:19:33,631 --> 00:19:34,591
(ジャム) うーん

423
00:19:34,674 --> 00:19:37,635
いったい なんで
こんなところに あるんだろう？

424
00:19:37,719 --> 00:19:40,680
あっ じゃあ
まちで あばれてるっていうのは？

425
00:19:40,763 --> 00:19:41,806
(ジャム) うーん…

426
00:19:41,890 --> 00:19:42,807
そうか！

427
00:19:45,768 --> 00:19:49,022
(しょくぱんまん)
えい はっ えい！ はっ ああ…

428
00:19:49,272 --> 00:19:52,817
マ… マントが ベトベトで
これ いじょう とべません

429
00:19:54,527 --> 00:19:55,737
(ジャム) アンパンマーン！

430
00:19:55,820 --> 00:19:56,905
(バタコ) しょくぱんまーん

431
00:19:56,988 --> 00:19:57,947
(しょくぱんまん) え？

432
00:19:59,866 --> 00:20:00,867
ジャムおじさん！

433
00:20:00,950 --> 00:20:01,910
(ジャム) しょくぱんまん

434
00:20:01,993 --> 00:20:04,412
ほんものの しょくぱんまんごうを
もってきたよ

435
00:20:04,913 --> 00:20:05,788
あら!?

436
00:20:05,872 --> 00:20:08,166
どうして
ほんものの しょくぱんまんごうが？

437
00:20:08,666 --> 00:20:11,502
そうか！
あれは にせものだったんですね

438
00:20:11,586 --> 00:20:13,796
よし！ アンパンマンを たのみます

439
00:20:13,880 --> 00:20:14,839
(かびるんるん) かび～
(やみるんるん) やみ！

440
00:20:15,465 --> 00:20:16,341
ふっ！

441
00:20:16,883 --> 00:20:18,885
はっしん しょくぱんまんごう！

442
00:20:21,721 --> 00:20:23,431
なんの こしゃくな！

443
00:20:25,683 --> 00:20:26,684
(かびるんるんたち) かび～

444
00:20:26,768 --> 00:20:27,602
(やみるんるんたち) やみ～

445
00:20:27,685 --> 00:20:28,686
(べろべろまんたち) べろ！
(かびるんるんたち) かび！

446
00:20:31,147 --> 00:20:32,440
ありゃ！ たまぎれか

447
00:20:33,191 --> 00:20:35,318
しょくパンチ バンパー！

448
00:20:35,526 --> 00:20:36,486
(ぶつかった おと)

449
00:20:41,699 --> 00:20:44,035
なにを！
まだ まだ まだ まだ まだ！

450
00:20:50,500 --> 00:20:51,542
うわああ！

451
00:20:52,585 --> 00:20:55,880
ナハハハハッ どんなもんなのだ！

452
00:20:56,506 --> 00:20:57,423
(ジャム) うん！

453
00:20:59,050 --> 00:21:00,134
げんき100ばい

454
00:21:01,636 --> 00:21:02,637
アンパンマン！

455
00:21:03,429 --> 00:21:05,598
しょくぱんまん！ いま いくよ

456
00:21:05,682 --> 00:21:08,101
(レアチーズ･チーズ)
アンアン！ アンアンアンアン！

457
00:21:09,519 --> 00:21:10,853
おっ おっと！

458
00:21:11,187 --> 00:21:13,856
(ばいきんまん)
しまった！ よけられたか！

459
00:21:14,315 --> 00:21:16,567
ああ！
そのこえは ばいきんまん！

460
00:21:17,860 --> 00:21:19,362
いまごろ わかったか！

461
00:21:20,238 --> 00:21:22,198
ばいきんまんの しわざだったんですね

462
00:21:24,158 --> 00:21:25,868
ふっ えい

463
00:21:25,952 --> 00:21:27,787
はっ えいっ はっ

464
00:21:28,371 --> 00:21:31,582
ああ… これじゃ ちかづけません

465
00:21:31,666 --> 00:21:33,793
(カバおたち)
がんばれー しょくぱんまーん

466
00:21:34,377 --> 00:21:35,545
(ヤギがはく)
にせものを やっつけてくれ

467
00:21:35,628 --> 00:21:37,880
(カバお)
しょくぱんまーん がんばれー

468
00:21:38,840 --> 00:21:41,217
よーし いちか ばちか です

469
00:21:52,020 --> 00:21:52,854
(みんな) ああ！

470
00:21:57,859 --> 00:22:01,654
ありゃ!? おれさまの
バイキンしょくぱんまんごうが！

471
00:22:02,780 --> 00:22:03,698
あ…

472
00:22:04,615 --> 00:22:06,868
ゆるさないぞ ばいきんまん！

473
00:22:07,160 --> 00:22:09,495
ア～ンパンチ！

474
00:22:09,746 --> 00:22:12,498
(ばいきんまん) ばいばいき～ん

475
00:22:14,625 --> 00:22:17,295
(こどもたちの よろこぶこえ)
(カバお) わーい やった やったー！

476
00:22:17,378 --> 00:22:20,339
やっぱり ほんものの
しょくぱんまんごうは つよいや

477
00:22:20,631 --> 00:22:22,759
(ピョンきち) うん！ さいこうだね

478
00:22:22,842 --> 00:22:25,094
(ジャム)
よくやったね しょくぱんまん

479
00:22:25,178 --> 00:22:27,805
(しょくぱんまん) いいえ
みんなの おかげです

480
00:22:28,139 --> 00:22:30,224
(バタコ)
それにしても いったい だれが――

481
00:22:30,308 --> 00:22:33,519
ほんものの しょくぱんまんごうを
とどけてくれたのかしら

482
00:22:33,603 --> 00:22:34,437
(チーズ) アン

483
00:22:35,354 --> 00:22:36,981
え… ええ

484
00:22:40,485 --> 00:22:42,070
この はなたばを おくったひとは――

485
00:22:42,153 --> 00:22:44,739
しょくぱんまんが
だいすきなんだね

486
00:22:45,198 --> 00:22:46,115
(カバお) ぼくたちも――

487
00:22:46,199 --> 00:22:48,618
しょくぱんまん だいすきだけど…

488
00:22:48,701 --> 00:22:49,744
(カバお) だれだろう
(ピョンきち) うん…

489
00:22:54,832 --> 00:22:57,460
やっぱり かえしてあげて よかった

490
00:22:58,086 --> 00:22:59,462
しょくぱんまんさま

491
00:23:00,004 --> 00:23:02,256
(カバお)
あのさ しょくぱんまんには わかる？

492
00:23:02,965 --> 00:23:03,925
(しょくぱんまん) うん？

493
00:23:04,258 --> 00:23:06,761
それはね それは…

494
00:23:21,442 --> 00:23:28,449
♪～

495
00:24:51,657 --> 00:24:58,664
～♪

