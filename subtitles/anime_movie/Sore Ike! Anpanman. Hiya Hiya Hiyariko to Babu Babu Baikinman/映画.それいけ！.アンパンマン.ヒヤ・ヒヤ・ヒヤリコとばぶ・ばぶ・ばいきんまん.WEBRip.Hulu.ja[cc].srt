1
00:00:05,131 --> 00:00:06,924
(あめと かぜのおと)

2
00:00:07,007 --> 00:00:10,845
(かみなりの おと)

3
00:00:39,415 --> 00:00:43,878
(ヒヤリコ)
できた～！ ウヒ ウヒ ウヒ ウヒッ

4
00:00:44,420 --> 00:00:47,715
ヒャーッ ヒャ ヒャ ヒャ ヒャーッ

5
00:00:47,798 --> 00:00:50,009
(かみなりの おと)

6
00:01:00,811 --> 00:01:02,813
(アンパンマン)
やめるんだ！
ばいきんまん！

7
00:01:02,897 --> 00:01:04,523
(ばいきんまん)
うるさい うるさい
うるさ～い

8
00:01:04,607 --> 00:01:06,984
アーンパーンチ！

9
00:01:08,235 --> 00:01:10,070
あら～っ

10
00:01:10,279 --> 00:01:13,324
ばいばいき～ん

11
00:01:13,824 --> 00:01:16,744
(こどもたち) わ～い やった やった～

12
00:01:17,536 --> 00:01:24,543
(ばいきんまん) うわ～っ

13
00:01:25,503 --> 00:01:28,214
(ぶつかるおと)

14
00:01:29,173 --> 00:01:30,299
うう～

15
00:01:30,382 --> 00:01:32,843
(ドキンちゃん)
おかえり ばいきんまん

16
00:01:34,011 --> 00:01:36,388
(ドキン) あら
また やられちゃったの？

17
00:01:37,056 --> 00:01:38,974
(ホラーマン)
ホラ～ よわいですね

18
00:01:39,058 --> 00:01:41,727
ダメですね
ちっとも かてませんね

19
00:01:42,186 --> 00:01:44,355
(ばいきんまん)
うるさい うるさい うるさ～い

20
00:01:45,022 --> 00:01:46,899
いっそのこと
ドクター･ヒヤリに――

21
00:01:46,982 --> 00:01:48,192
つよくなる
くすりでも――

22
00:01:48,275 --> 00:01:49,318
つくってもらえば？

23
00:01:49,401 --> 00:01:50,486
(ばいきんまん) うおっ

24
00:01:50,778 --> 00:01:52,071
それだ！

25
00:01:55,866 --> 00:01:58,452
ドクター･ヒヤリ～！

26
00:01:58,661 --> 00:02:00,996
ドクター･ヒヤリ～！

27
00:02:03,749 --> 00:02:06,377
どこなのだ？ ヒヤリ！

28
00:02:06,460 --> 00:02:08,295
ドクター･ヒヤリ！

29
00:02:10,881 --> 00:02:12,383
うわ～っ

30
00:02:12,466 --> 00:02:13,717
でえ～

31
00:02:14,552 --> 00:02:17,304
(ドクター･ヒヤリ)
ヒャ～ッ ヒャ ヒャ ヒャ ヒャッ

32
00:02:17,388 --> 00:02:18,764
(ばいきんまん) ドクター･ヒヤリ！

33
00:02:18,848 --> 00:02:20,808
よくきたな ばいきんまん

34
00:02:20,891 --> 00:02:22,893
じゃが わしは
ゆうがたまで るすじゃ

35
00:02:23,227 --> 00:02:24,103
るす？

36
00:02:24,186 --> 00:02:26,272
じょしゅのヒヤリコが
るすばんしとるから――

37
00:02:26,355 --> 00:02:27,481
いっしょに まっとれ

38
00:02:27,565 --> 00:02:28,983
じょしゅ？ ヒヤリコ？

39
00:02:29,066 --> 00:02:31,151
(ヒヤリコ) ヒャ～ッ ヒャ ヒャ ヒャッ
(ばいきんまん) ん？

40
00:02:31,443 --> 00:02:33,904
(かみなりの おと)

41
00:02:33,988 --> 00:02:36,657
(ヒヤリコ)
ヒャ～ッ ヒャ ヒャ ヒャ ヒャッ

42
00:02:37,241 --> 00:02:39,493
わたしがヒヤリコです

43
00:02:39,577 --> 00:02:42,580
ヒャ～ッ ヒャ ヒャ ヒャ ヒャッ

44
00:02:42,663 --> 00:02:43,747
ヒャッ！

45
00:02:44,039 --> 00:02:46,876
ヒャッ ヒャッ ヒャッ ヒャッ

46
00:02:47,126 --> 00:02:48,252
(ばいきんまん) おっ
(ヒヤリコ) ヒヤ～ッ

47
00:02:48,335 --> 00:02:51,338
お… おまえがヒヤリのじょしゅ？

48
00:02:51,422 --> 00:02:55,509
はい！ ヒヤリせんせいの
とっても ゆうしゅうな でしです～

49
00:02:55,593 --> 00:02:56,802
ヒヤ～ッ

50
00:02:56,886 --> 00:02:58,846
お… おれさま ばいきんまん

51
00:02:58,929 --> 00:03:00,556
ドクター･ヒヤリに
つよくなるくすりを――

52
00:03:00,681 --> 00:03:02,016
もらいにきたんだけど

53
00:03:02,099 --> 00:03:03,851
るすなら また あとで

54
00:03:03,934 --> 00:03:06,437
(ヒヤリコ) ヒャ～ッ まって～
(ばいきんまん) うおっ

55
00:03:06,520 --> 00:03:09,273
つよくなるくすりが
ほしいなんてラッキー

56
00:03:09,356 --> 00:03:12,526
ヒヤリコがつくったくすりを
ためしてみませんか？

57
00:03:12,610 --> 00:03:14,570
おまえがつくったくすり？

58
00:03:14,653 --> 00:03:15,529
はい

59
00:03:15,613 --> 00:03:18,574
そのなも“とてもつよくなーる”

60
00:03:18,657 --> 00:03:20,409
“とてもつよくなーる”？

61
00:03:20,826 --> 00:03:23,412
うん　そいつを つかえば…

62
00:03:25,998 --> 00:03:28,792
(ばいきんまん)
グレートばいきんまん！

63
00:03:30,044 --> 00:03:31,629
アーンパーンチ！

64
00:03:32,087 --> 00:03:33,631
ばいきんパーンチ！

65
00:03:36,383 --> 00:03:40,846
(アンパンマン) わあああ～っ

66
00:03:41,430 --> 00:03:43,515
ハヒフヘホ～

67
00:03:43,933 --> 00:03:45,017
グフッ

68
00:03:45,100 --> 00:03:47,102
(ヒヤリコ) ヒヤッ
(ばいきんまん) グフフフフッ

69
00:03:47,186 --> 00:03:50,189
(みんなのわらいごえ)

70
00:03:52,191 --> 00:03:54,193
えっと… これは なに？

71
00:03:54,568 --> 00:03:55,402
(ヒヤリコ) はい

72
00:03:55,486 --> 00:03:58,113
“とてもつよくなーる”が
からだに あうかどうか――

73
00:03:58,197 --> 00:04:00,157
まずは けんさです

74
00:04:00,324 --> 00:04:01,659
スイッチオン！

75
00:04:01,742 --> 00:04:02,576
(ヒヤリの ゆうれい) ヒヤッ！

76
00:04:02,660 --> 00:04:03,744
(ばいきんまん)うおっ！

77
00:04:03,827 --> 00:04:04,912
ん？

78
00:04:05,245 --> 00:04:07,915
うわ～っ

79
00:04:07,998 --> 00:04:08,832
いっ…

80
00:04:10,000 --> 00:04:10,834
うおっ！

81
00:04:10,918 --> 00:04:11,961
くっ

82
00:04:12,670 --> 00:04:13,504
あっ

83
00:04:13,587 --> 00:04:14,630
んっ！

84
00:04:16,173 --> 00:04:18,008
ブルブルブルブル…

85
00:04:21,053 --> 00:04:23,097
(でんきの おと)
(ばいきんまん) うわ～！

86
00:04:23,180 --> 00:04:24,890
く～っ

87
00:04:26,308 --> 00:04:27,935
だ～っ！

88
00:04:28,018 --> 00:04:29,186
ひぃ～

89
00:04:29,269 --> 00:04:30,604
うお～っ

90
00:04:31,522 --> 00:04:32,773
(ばくはつする おと)
(ばいきんまん) どわ～っ

91
00:04:32,856 --> 00:04:37,069
(ごうかくの おんがく)

92
00:04:37,152 --> 00:04:39,613
(ヒヤリコ) ヒャ～ッ
おめでとう　ばいきんまん

93
00:04:39,697 --> 00:04:42,616
あなたは みごと
けんさに ごうかくしました！

94
00:04:42,700 --> 00:04:44,785
(はくしゅ)
(ばいきんまん) ううっ

95
00:04:45,202 --> 00:04:46,537
(ヒヤリコ) じゃじゃ～ん

96
00:04:46,954 --> 00:04:48,205
(ばいきんまん) こっ これが！

97
00:04:48,288 --> 00:04:50,082
(ヒヤリコ) はい！
できたてホヤホヤの――

98
00:04:50,165 --> 00:04:52,042
“とてもつよくなーる”！

99
00:04:52,543 --> 00:04:54,461
じゃ いきます～

100
00:04:54,545 --> 00:04:55,838
それっ

101
00:04:56,088 --> 00:04:57,172
うおっ

102
00:04:57,589 --> 00:04:59,550
ゴホッ ゴホッ ゴホッ
ゴホッ ゴホッ ゴホッ

103
00:04:59,633 --> 00:05:01,301
んん？ ん？

104
00:05:01,385 --> 00:05:04,388
んんっ んっ んんっ んんっ

105
00:05:04,471 --> 00:05:06,306
(ばいきんまん) んっ んっ
(ヒヤリコ) うわあ

106
00:05:06,390 --> 00:05:08,642
(ばいきんまん)
うお～ おおおっ おっ おっ

107
00:05:09,727 --> 00:05:12,563
ハヒフヘホ～

108
00:05:12,646 --> 00:05:15,232
これでアンパンマンなんか
イチコロだ～

109
00:05:15,315 --> 00:05:16,775
(くうきがぬけるおと)
ん？

110
00:05:18,360 --> 00:05:21,405
んん～ うほ～っ

111
00:05:24,199 --> 00:05:25,034
バブ

112
00:05:25,117 --> 00:05:28,037
(ヒヤリコ) ヒャーッ たいへ～ん！

113
00:05:28,954 --> 00:05:32,124
(ばいきんまん) <おわっ お… おれさま
あかちゃんに なってる？>

114
00:05:32,207 --> 00:05:33,042
<んっ>

115
00:05:33,709 --> 00:05:36,253
(ヒヤリコ) よちよち
おなか ちゅいてるんでちゅね？

116
00:05:36,336 --> 00:05:38,338
これで もう だいじょうぶ

117
00:05:38,422 --> 00:05:39,506
じゃなくって！

118
00:05:39,590 --> 00:05:40,924
どど… ど… どうしよう！

119
00:05:41,008 --> 00:05:43,135
(ばいきんまん) バブバブバブバブ
(ヒヤリコ) ヒャッ ヒャ～ッ

120
00:05:43,218 --> 00:05:44,053
(ヒヤリコ) ん？

121
00:05:44,511 --> 00:05:47,514
(ばいきんまん) <げげっ
バブバブとしか しゃべれない>

122
00:05:47,598 --> 00:05:51,101
あっ あかちゃんになれて
よろこんでるんですね～

123
00:05:51,185 --> 00:05:54,063
バブッ　バブバブバブ バブバブ～ッ

124
00:05:54,855 --> 00:05:55,731
(ヒヤリコ) ヒャ～ッ

125
00:05:55,814 --> 00:05:59,068
もとに もどせって
おこってるんですね～？

126
00:05:59,985 --> 00:06:01,111
だいじょぶ だいじょぶ

127
00:06:01,195 --> 00:06:05,157
もとにもどる くすりなんて
かんたん かんたん かんた～ん

128
00:06:05,240 --> 00:06:06,325
(ゆうれいたち) ヒヤ～

129
00:06:06,950 --> 00:06:08,035
(ヒヤリコ) ジャ～ン

130
00:06:08,118 --> 00:06:10,746
たぶん あれと これと それから これ！

131
00:06:10,829 --> 00:06:12,581
ヒヤッ ヒヤッ ヒャ～

132
00:06:13,582 --> 00:06:15,125
おまたせ～

133
00:06:15,626 --> 00:06:19,630
ヒヤッ ヒヤ～ッ
こんなところに バナナのかわが！

134
00:06:21,173 --> 00:06:23,759
(ゆうれい) ヒヤ～ッ ヒヤッ… ヒ…

135
00:06:23,842 --> 00:06:25,552
(ゆうれいたち) ヒヤ？
(ばいきんまん) バブッ！

136
00:06:25,636 --> 00:06:27,721
(ヒヤリコ) ヒャ～ッ
ちょっと しっぱ～い

137
00:06:28,305 --> 00:06:31,308
だいじょぶ だいじょぶ
こんどは だいじょうぶ

138
00:06:31,391 --> 00:06:32,810
ヒヤッ ヒヤッ ヒヤッ ヒヤッ

139
00:06:32,893 --> 00:06:36,480
ヒャッ ヒャ～ッ
こんどはスケボー！

140
00:06:37,564 --> 00:06:39,858
(ゆうれい) ヒ～ッ ヒヤッ ヒ～…

141
00:06:39,942 --> 00:06:41,693
(ゆうれいたち) ヒヤ～
(ばいきんまん) バブブッ！

142
00:06:41,777 --> 00:06:44,571
(ヒヤリコ) ヒャ～ッ
またちょっと しっぱ～い

143
00:06:44,655 --> 00:06:48,367
でも だいじょうぶ だいじょうぶ
きっと きっと だいじょうぶ

144
00:06:48,450 --> 00:06:49,576
ヒヤッ ヒヤッ ヒヤッ ヒヤッ

145
00:06:49,660 --> 00:06:51,870
うっ… ヒャ～ッ

146
00:06:54,206 --> 00:06:56,416
(ゆうれいたち) ヒ～ッ ヒヤッ

147
00:06:56,875 --> 00:06:59,294
ヒヤッ ヒヤッ ヒヤッ
ヒヤッ ヒヤッ ヒヤッ ヒヤッ

148
00:06:59,753 --> 00:07:01,046
ヒヤ～ッ

149
00:07:01,630 --> 00:07:03,298
(ゆうれいたち) ヒッ ヒヤ～

150
00:07:03,549 --> 00:07:05,175
(ヒヤリコ) ヒヤッ ヒヤッ ヒヤッ

151
00:07:05,259 --> 00:07:06,343
(ゆうれいたち) ヒヤ～

152
00:07:06,426 --> 00:07:08,095
(ヒヤリコ) ヒヤ～ッ
(ゆうれい) ううっ

153
00:07:08,178 --> 00:07:09,388
(ゆうれいたち) ヒャ～ッ

154
00:07:09,471 --> 00:07:10,764
(ばいきんまん) バブ バブ バブ

155
00:07:10,848 --> 00:07:11,723
(ヒヤリコ) ヒヤ～ッ

156
00:07:11,807 --> 00:07:15,561
だいじょうぶ だいじょうぶ
ヒヤッ ヒヤッ ヒヤッ ヒヤッ

157
00:07:16,520 --> 00:07:18,981
(ばいきんまん) <ぜ… ぜんぜん
だいじょうぶじゃないぞ>

158
00:07:19,398 --> 00:07:21,608
<く～っ ドクター･ヒヤリが
かえってくるまで――>

159
00:07:21,692 --> 00:07:23,360
<どっかに かくれてるのだ>

160
00:07:23,443 --> 00:07:24,486
(ヒヤリコ) ヒヤ～ッ
(ばいきんまん) <おお？>

161
00:07:25,445 --> 00:07:27,072
ヒヤ～ッ

162
00:07:29,241 --> 00:07:30,075
うわっ

163
00:07:30,159 --> 00:07:30,993
わあ～

164
00:07:31,076 --> 00:07:32,578
(ゆうれいたち) ヒャ～ッ

165
00:07:32,661 --> 00:07:34,496
(ヒヤリコ) ヒヤ～ッ

166
00:07:34,580 --> 00:07:35,581
(ばいきんまん) <おい “ヒヤ”って…>

167
00:07:35,664 --> 00:07:36,999
(ガラスがわれた おと)
(ばいきんまん) <んん？>

168
00:07:37,666 --> 00:07:38,750
バブ！

169
00:07:40,085 --> 00:07:42,504
(ばいきんまん) <ぐわ～っ>

170
00:07:43,505 --> 00:07:45,924
(ばくはつする おと)

171
00:07:46,008 --> 00:07:49,052
(ばいきんまん) バブ～！

172
00:07:50,387 --> 00:07:53,015
ヒヤ～ッ ばいきんまんが！

173
00:07:53,515 --> 00:07:56,393
けど もとにもどす くすりを
つくらなきゃ…

174
00:07:56,476 --> 00:07:57,895
でも ばいきんまんが…

175
00:07:57,978 --> 00:07:59,354
やっぱり くすり…

176
00:07:59,438 --> 00:08:03,942
ヒヤ～ッ
どうすれば いいんですか～！

177
00:08:06,778 --> 00:08:08,989
(ばいきんまん) バブ～

178
00:08:09,072 --> 00:08:10,449
(しょくぱんまん) あぶない！

179
00:08:12,326 --> 00:08:14,661
(ばいきんまん) <ホッ たすかった>

180
00:08:14,745 --> 00:08:17,039
<げっ しょくぱんまん！>

181
00:08:17,122 --> 00:08:19,458
(カレーパンマン)
あぶねえところだったな

182
00:08:19,708 --> 00:08:22,044
(ばいきんまん)
<げげっ カレーパンマンまで？>

183
00:08:22,127 --> 00:08:24,963
ふ～ん
みたことない あかちゃんだな

184
00:08:25,255 --> 00:08:26,715
(しょくぱんまん) そうですね

185
00:08:26,798 --> 00:08:29,468
ほ～ら
いない いない いない いな～い――

186
00:08:29,801 --> 00:08:31,011
ばあ！

187
00:08:31,094 --> 00:08:32,721
バブ バブバブバブ

188
00:08:32,804 --> 00:08:36,683
(しょくぱんまん)
アハハハハッ たのしそうですね

189
00:08:36,767 --> 00:08:38,769
わたしのこと きにいったみたいです

190
00:08:38,852 --> 00:08:41,563
(カレーパンマン) フン
ちょっと おれに かしてみな

191
00:08:41,647 --> 00:08:43,232
いない いない いない いない――

192
00:08:43,649 --> 00:08:44,566
ばあ！

193
00:08:44,650 --> 00:08:47,027
バブバブ バブバブ バブ
ババババ…

194
00:08:47,110 --> 00:08:50,614
(カレーパンマン) ア～ハハハッ
すっげえ たのしそう！

195
00:08:50,697 --> 00:08:52,950
おれのことが きにいったみたいだな

196
00:08:53,033 --> 00:08:54,493
(しょくぱんまん)
そんなことは ありません

197
00:08:54,910 --> 00:08:59,206
あかちゃんは しょくぱんみたいに
やさしく ふんわりが いちばん

198
00:08:59,289 --> 00:09:01,875
おお いとしきベイビー

199
00:09:01,959 --> 00:09:03,168
そなたは てんし

200
00:09:03,252 --> 00:09:04,253
バブブ

201
00:09:04,586 --> 00:09:06,088
(カレーパンマン) ちがうね

202
00:09:06,171 --> 00:09:10,008
あかちゃんは カレーみたいに
ピリッとした しげきがすきなんだ

203
00:09:10,092 --> 00:09:11,843
ほ～ら たかい たかい たかーい

204
00:09:11,927 --> 00:09:14,888
(ばいきんまん) バブーッ

205
00:09:14,972 --> 00:09:15,973
(とりの なきごえ)

206
00:09:16,056 --> 00:09:19,476
(ばいきんまん) バブーッ

207
00:09:20,519 --> 00:09:22,312
バブッ バブーッ

208
00:09:26,233 --> 00:09:28,068
(カレーパンマン) よっと～

209
00:09:28,610 --> 00:09:29,528
どうだい

210
00:09:29,611 --> 00:09:31,697
こえも だせないぐらい
よろこんでるぜ

211
00:09:31,780 --> 00:09:32,864
(しょくぱんまん) んん… いいえ！

212
00:09:32,948 --> 00:09:36,618
やっぱり しょくぱんみたいに
ふんわり やさしいのが いいんです！

213
00:09:36,702 --> 00:09:38,912
(カレーパンマン)
カレーみたいに ピリッと しげきだぜ！

214
00:09:39,413 --> 00:09:41,248
しょくぱんみたいに ふんわり！

215
00:09:41,331 --> 00:09:42,958
カレーみたいにピリリ！

216
00:09:43,041 --> 00:09:44,167
ふんわり！

217
00:09:44,251 --> 00:09:45,210
ピリリ！

218
00:09:45,294 --> 00:09:47,587
(ふたり) んん～

219
00:09:47,671 --> 00:09:49,423
あっ？ あれ？

220
00:09:49,506 --> 00:09:50,966
あかちゃんは どこです？

221
00:09:51,633 --> 00:09:52,467
バブ

222
00:09:52,843 --> 00:09:53,677
(しょくぱんまん) おかしいな…

223
00:09:53,760 --> 00:09:56,096
(ばいきんまん)
<フウ… やっと にげられた～>

224
00:09:56,179 --> 00:09:57,639
<ん～ くそ～>

225
00:09:57,723 --> 00:10:00,684
<こんなめに あうのも みんな
あのヒヤリコのせいだ>

226
00:10:00,767 --> 00:10:01,893
<く～っ>

227
00:10:01,977 --> 00:10:03,895
<とにかく
はやく ヒヤリじょうにもどって――>

228
00:10:03,979 --> 00:10:07,357
<ドクター･ヒヤリに
もとに もどしてもらわないと>

229
00:10:07,774 --> 00:10:09,401
(ガラスがわれるおと)
(ヒヤリコ) ヒャ～ッ

230
00:10:09,484 --> 00:10:11,194
ヒヤ～ン

231
00:10:11,528 --> 00:10:12,946
(ゆうれい) ヒヤ～

232
00:10:13,363 --> 00:10:15,907
もとにもどる くすり
もとにもどる くすり

233
00:10:15,991 --> 00:10:17,701
もとにもどる くすりっと

234
00:10:17,784 --> 00:10:20,454
ヒャ～ン できた！ かな？

235
00:10:20,829 --> 00:10:22,372
(ゆうれいたち) う～

236
00:10:22,456 --> 00:10:26,168
(ヒヤリコ)
コラーッ にげちゃダメです～

237
00:10:27,419 --> 00:10:29,129
(ゆうれいたち) ヒエ～ッ

238
00:10:29,212 --> 00:10:30,130
あっ！

239
00:10:31,465 --> 00:10:33,759
ヒヤ～ ヒ～ ヒエッ

240
00:10:34,009 --> 00:10:38,055
ヒャ～ッ　ヒャッ　ヒャッ

241
00:10:38,138 --> 00:10:41,016
(ヒヤリコ) ヒャ～ッ
せいこう せいこう だいせいこう

242
00:10:41,683 --> 00:10:46,480
ばいきんまん！
いま たすけに いきますからね～

243
00:10:47,773 --> 00:10:51,318
(ゆうれいたち) ヒャッヒャッ ヒャ～ッ

244
00:10:51,651 --> 00:10:52,694
(ゆうれい) ヒヤッ？

245
00:10:54,196 --> 00:10:58,200
(ゆうれいたち) ヒヤッ？ ヒヤッ？
ヒヤッ？ ヒヤッ？

246
00:10:58,492 --> 00:10:59,951
(ばくはつする おと)

247
00:11:00,577 --> 00:11:01,453
(あかちゃんオバケ) バブ

248
00:11:01,536 --> 00:11:04,456
(オバケたち) バブ～ バブ バブ

249
00:11:04,915 --> 00:11:07,000
(ジャムおじさん)
なんだって？ あかちゃんが？

250
00:11:07,084 --> 00:11:07,959
(しょくぱんまん) そうなんです

251
00:11:08,460 --> 00:11:11,088
(カレーパンマン)
どこさがしても みつかんなくって

252
00:11:11,171 --> 00:11:13,423
(アンパンマン) みんなで
てわけして さがしましょう

253
00:11:13,507 --> 00:11:14,466
(ジャムたち) うん！

254
00:11:15,842 --> 00:11:16,802
う～ん

255
00:11:17,386 --> 00:11:18,887
(ふたり) う～ん

256
00:11:19,221 --> 00:11:20,972
(チーズ) ク～ン

257
00:11:21,056 --> 00:11:23,225
(ヒヤリコ) ばいきんま～ん

258
00:11:23,308 --> 00:11:25,477
ばいきんま～ん

259
00:11:27,020 --> 00:11:29,231
(ばいきんまん) バブ バブ フウ…

260
00:11:29,815 --> 00:11:32,317
(ばいきんまん)
<くそ ちっとも すすまない>

261
00:11:32,401 --> 00:11:35,737
<くっ… ＵＦＯがあれば
ひとっとびなのに…>

262
00:11:35,821 --> 00:11:37,239
(ドキン) うわあ　みて みて～

263
00:11:37,322 --> 00:11:38,240
(ばいきんまん) <あ？>

264
00:11:38,323 --> 00:11:39,950
(ホラーマン) ホラ～

265
00:11:40,742 --> 00:11:42,244
(ばいきんまん)
<ドキンちゃんにホラーマン！>

266
00:11:42,744 --> 00:11:44,371
<ああ たすかった>

267
00:11:44,454 --> 00:11:46,832
<これで ヒヤリじょうに
つれてってもらえる>

268
00:11:46,915 --> 00:11:50,752
(ばいきんまん) バブ
(ドキン) みて　かわいい あかちゃん

269
00:11:50,836 --> 00:11:52,254
(ホラーマン) そうですか？

270
00:11:52,337 --> 00:11:55,966
なんか みたことあるような
へんなかおだと おもうんですけど

271
00:11:56,049 --> 00:11:58,301
(ばいきんまん)
バブバブバブバブバブッ

272
00:11:58,385 --> 00:12:00,554
(ドキン) まあ げんきがいいわね

273
00:12:00,637 --> 00:12:02,764
ホラーマンのことが
きにいったのかしら？

274
00:12:02,848 --> 00:12:04,808
(ばいきんまん) バブバブバブバブッ

275
00:12:05,434 --> 00:12:06,726
(ばいきんまん) <くっ ダメだ>

276
00:12:06,810 --> 00:12:09,855
<やっぱり おれさまの
いってることが わからないんだ…>

277
00:12:10,355 --> 00:12:12,899
(ドキン) あら おねむなのかな？

278
00:12:13,984 --> 00:12:14,818
よしよし

279
00:12:18,530 --> 00:12:25,370
♪ ねん ねん ねんころ ねんころり

280
00:12:25,662 --> 00:12:29,207
(ドキン) ♪ ねん ねん ねむれば
(ホラーマン) いやあ…

281
00:12:29,291 --> 00:12:32,544
♪ ゆめのくに

282
00:12:32,878 --> 00:12:39,468
♪ ねむりのもりの ほそみちは

283
00:12:40,051 --> 00:12:47,058
♪ ねむりのくにへ つづきます

284
00:12:48,977 --> 00:12:55,775
♪ ルルルルル ルララ

285
00:12:56,151 --> 00:13:01,781
♪ ルルルルル

286
00:13:03,992 --> 00:13:05,744
(ばいきんまん) <ドキンちゃん…>

287
00:13:06,578 --> 00:13:07,829
ホラ～

288
00:13:08,371 --> 00:13:11,124
おかあさんみたいなドキンちゃんも
すてきですね

289
00:13:12,250 --> 00:13:15,128
(ばいきんまん)
<おれさま なんだか しあわせ>

290
00:13:16,546 --> 00:13:19,132
<あかちゃんも けっこう いいかも>

291
00:13:21,051 --> 00:13:22,135
ん？

292
00:13:26,598 --> 00:13:28,725
(ドキン) しょくぱんまんさま～
(ばいきんまん) バブー！

293
00:13:28,808 --> 00:13:31,186
(ホラーマン) ホラ～ まってください

294
00:13:31,269 --> 00:13:32,145
バブ

295
00:13:32,479 --> 00:13:35,815
(ドキン) ええ？
あかちゃんをさがしてるんですか？

296
00:13:35,899 --> 00:13:37,234
え… ええ

297
00:13:37,317 --> 00:13:39,402
ドキンちゃん みませんでしたか？

298
00:13:39,486 --> 00:13:41,029
(ドキン) それなら あそこに

299
00:13:41,112 --> 00:13:42,239
(ホラーマン･ドキン) あ？

300
00:13:42,948 --> 00:13:44,407
(ドキン) あれ？ いない

301
00:13:44,491 --> 00:13:46,785
(ホラーマン) ＵＦＯも ありませんよ
(ドキン) ええ？

302
00:13:47,452 --> 00:13:49,329
(ばいきんまん) <ううっ くっ>

303
00:13:49,412 --> 00:13:52,791
<ひっ は… はやく ヒヤリじょうへ>

304
00:14:13,728 --> 00:14:15,897
(ヒヤリコ) ヒャ～ン

305
00:14:16,147 --> 00:14:19,317
ばいきんまん みつからないです～

306
00:14:19,401 --> 00:14:20,277
あっ そうだ！

307
00:14:23,363 --> 00:14:28,034
これで ばいきんまんが どこにいても
だいじょうぶです～

308
00:14:28,785 --> 00:14:33,540
ヒャ～ン ヒャ～ン ヒャアア～ン

309
00:14:33,623 --> 00:14:34,791
(しょくぱんまん) んんっ
(ホラーマン) あっ

310
00:14:35,584 --> 00:14:36,960
(ホラーマン) なんですか あれ？

311
00:14:40,088 --> 00:14:40,964
(カレーパンマン) なんだ？

312
00:14:42,215 --> 00:14:43,466
(チーズ) アンア～ン

313
00:14:46,219 --> 00:14:47,721
(こどもたち) おお？

314
00:14:55,020 --> 00:14:56,354
(ジャム) んん？

315
00:14:57,022 --> 00:14:57,981
おっ？

316
00:15:02,569 --> 00:15:03,570
(アンパンマンたち) うわ～

317
00:15:03,653 --> 00:15:06,906
ゴホッ ゴホッ ゴホッ ゴホッ ゴホッ

318
00:15:06,990 --> 00:15:07,824
んん？

319
00:15:08,992 --> 00:15:09,826
ん～？

320
00:15:11,286 --> 00:15:12,829
(アンパンマンたち) わ～！
(ヒヤリコ) うわ～！

321
00:15:14,205 --> 00:15:15,332
バブ～

322
00:15:15,624 --> 00:15:17,334
(どんぶりまんトリオ) バブ～

323
00:15:17,417 --> 00:15:19,085
ヒヤ～ッ

324
00:15:19,336 --> 00:15:21,963
(ヒヤリ)
ヒャーッ ヒャッ ヒャッ ヒャッ ヒャッ

325
00:15:23,214 --> 00:15:24,466
ただいまー！

326
00:15:25,091 --> 00:15:27,844
って な… なんじゃこりゃ

327
00:15:27,927 --> 00:15:29,638
(オバケたち) バブ～

328
00:15:29,721 --> 00:15:32,349
(オバケ) バブ
(ヒヤリ) なに！ ヒヤリコが？

329
00:15:32,432 --> 00:15:34,100
(ばくはつする おと)

330
00:15:34,392 --> 00:15:35,727
(３にん) バブ～

331
00:15:36,603 --> 00:15:37,604
(ばくはつする おと)

332
00:15:37,687 --> 00:15:39,356
(カレーパンマン) バブ

333
00:15:39,439 --> 00:15:41,107
(ばくはつする おと)

334
00:15:41,441 --> 00:15:42,859
(チーズたち) バブ～

335
00:15:42,942 --> 00:15:44,361
(ばくはつする おと)

336
00:15:44,444 --> 00:15:46,112
(バタコたち) バブ～

337
00:15:46,446 --> 00:15:48,239
(ばくはつする おと)

338
00:15:48,615 --> 00:15:49,866
(カバおのママ) バブ～

339
00:15:49,949 --> 00:15:51,368
バブ～ バブ

340
00:15:51,785 --> 00:15:53,244
(ジャムたち) バブバブ

341
00:15:53,703 --> 00:15:56,873
(ヒヤリコ) ヒャ～
どどど… どうして～！

342
00:15:57,540 --> 00:16:02,337
と… とにかく おしろにもどって
おくすり つくりなおさなきゃー！

343
00:16:04,172 --> 00:16:06,299
(ばいきんまん) <くそ～ ヒヤリコめ>

344
00:16:07,092 --> 00:16:09,803
<もとに もどったら
ひどいめに あわせてやる！>

345
00:16:10,887 --> 00:16:11,805
<ん？>

346
00:16:12,013 --> 00:16:15,475
(ヒヤリコ) ヒャ～！
ど… どいて どいて～！

347
00:16:15,558 --> 00:16:16,935
バブ～ッ

348
00:16:17,018 --> 00:16:20,438
(ばいきんまん) だっ バブ～！
(ヒヤリコ) ヒヤ～ッ

349
00:16:20,522 --> 00:16:22,440
(ばいきんまん) バブ～ッ

350
00:16:22,524 --> 00:16:23,858
(ヒヤリコ) あっ ばいきんまん！

351
00:16:24,067 --> 00:16:25,735
(ばいきんまん) バブ バブ バブ～

352
00:16:27,070 --> 00:16:29,155
バブ～ッ

353
00:16:30,365 --> 00:16:31,491
あっ

354
00:16:32,492 --> 00:16:33,868
(ばいきんまん) バブ～

355
00:16:37,831 --> 00:16:38,665
(ヒヤリコ) あっ！

356
00:16:45,463 --> 00:16:46,756
ばあっ

357
00:16:46,840 --> 00:16:48,550
ばいきんまん しっかり！

358
00:16:48,633 --> 00:16:50,635
ばいきんまん！ ばいきんまん！

359
00:16:50,719 --> 00:16:51,761
(ばいきんまん) んっ

360
00:16:52,762 --> 00:16:56,141
バブバブバブバブ バブ～！

361
00:16:57,225 --> 00:16:58,893
(ばいきんまん) <…ったく ヒヤリコめ>

362
00:16:58,977 --> 00:17:00,812
<どんだけ おれさまを
ひどいめに あわせれば――>

363
00:17:00,895 --> 00:17:01,730
<きがすむってん…>

364
00:17:01,813 --> 00:17:04,566
(ヒヤリコ) うっ うっ うっ うっ
(ばいきんまん) <え？ ん？>

365
00:17:04,649 --> 00:17:06,401
う～っ うっ

366
00:17:06,776 --> 00:17:09,946
(ヒヤリコ) うわ～ん よかったです
(ばいきんまん) おおっ

367
00:17:10,029 --> 00:17:13,032
ばいきんまんが…
ばいきんまんが ぶじで～

368
00:17:13,116 --> 00:17:15,076
ええ～ん え～ん

369
00:17:15,160 --> 00:17:16,703
(ばいきんまん) <ヒヤリコ…>

370
00:17:18,538 --> 00:17:19,497
(ふたり) おおっ

371
00:17:21,249 --> 00:17:22,500
(ヒヤリコ) ヒヤッ？
(ばいきんまん) んん？

372
00:17:22,584 --> 00:17:23,585
(ヒヤリコ) ヒヤッ

373
00:17:23,668 --> 00:17:27,005
(ばいきんまん) バブ～ッ
(ヒヤリコ) ヒヤ～ッ

374
00:17:27,464 --> 00:17:28,882
(ゆうれいたち) ヒャ～

375
00:17:28,965 --> 00:17:30,759
ヒャ～

376
00:17:31,301 --> 00:17:33,261
ヒャ～

377
00:17:33,344 --> 00:17:34,387
(ヒヤリコ) ヒヤッ

378
00:17:38,141 --> 00:17:40,018
(ヒヤリ) ヒャ～ ヒャッ ヒャッ ヒャッ
(ヒヤリコ) ん？

379
00:17:40,101 --> 00:17:41,770
(ヒヤリ) あぶないとこじゃったの

380
00:17:41,853 --> 00:17:43,480
(ヒヤリコ) ヒヤリせんせい！

381
00:17:43,563 --> 00:17:44,481
(ばいきんまん･ヒヤリコ) え？

382
00:17:44,564 --> 00:17:45,565
(ヒヤリ) ん？

383
00:17:47,233 --> 00:17:48,109
(ヒヤリコ) わっ

384
00:17:48,193 --> 00:17:49,486
(ばいきんまん) おおっ とととっ

385
00:17:49,569 --> 00:17:50,779
(ヒヤリコ) だあっ

386
00:17:50,862 --> 00:17:52,655
ん？ ん？ ん？

387
00:17:53,239 --> 00:17:55,784
(ばいきんまん･ヒヤリコ)
わーい もとに もどったー！

388
00:17:55,867 --> 00:17:56,785
もどった もどった

389
00:17:56,868 --> 00:17:58,536
(ヒヤリ) ふうん

390
00:17:58,620 --> 00:18:00,580
ヒヤリコにつくれるような くすりは――

391
00:18:00,663 --> 00:18:03,249
じかんがたてば
かってに もとに もどるわい

392
00:18:03,958 --> 00:18:06,336
(４にん) バブ バブ

393
00:18:06,419 --> 00:18:07,629
うわあっ

394
00:18:09,005 --> 00:18:10,089
(３にん) わあっ

395
00:18:10,173 --> 00:18:11,341
(カレーパンマン) バブバブ

396
00:18:11,424 --> 00:18:12,342
わっ

397
00:18:13,551 --> 00:18:14,552
(ピクルス) ヒヒヒ～ン

398
00:18:15,762 --> 00:18:16,846
(みんな) うわあっ

399
00:18:17,138 --> 00:18:18,932
(ばくはつする おと)

400
00:18:19,641 --> 00:18:21,100
(ジャム) おお？

401
00:18:21,392 --> 00:18:23,102
(カレーパンマン) な… なんだ？

402
00:18:23,686 --> 00:18:25,146
(しょくぱんまん) いったい なにが…
(ホラーマン･ドキン) んん？

403
00:18:25,605 --> 00:18:27,649
(４にん) ああ？ ん？

404
00:18:28,274 --> 00:18:30,777
(ヒヤリコ) ばいきんまん ごめんなさい

405
00:18:31,194 --> 00:18:32,403
(ばいきんまん) ん？

406
00:18:32,862 --> 00:18:35,532
(ヒヤリコ) ヒヤリコ
いっつも しっぱいばっかりで――

407
00:18:35,615 --> 00:18:37,742
ヒヤリせんせいに おこられてて

408
00:18:37,826 --> 00:18:40,328
なんとか
いいところを みせようとして――

409
00:18:40,411 --> 00:18:42,664
かってに くすりを
つくっちゃったんです

410
00:18:42,747 --> 00:18:44,874
(ドキン) いきなり
あかちゃんに なっちゃうんだもん

411
00:18:44,958 --> 00:18:46,960
ほんと びっくりしたわよ

412
00:18:47,043 --> 00:18:48,127
(ホラーマン) ホラ～

413
00:18:48,211 --> 00:18:49,838
ホラーマンもです

414
00:18:49,921 --> 00:18:54,884
(ヒヤリコ) うわ～ん
みんな ごめんなさい ごめんなさい

415
00:18:55,343 --> 00:18:56,219
(ばいきんまん) フン！

416
00:18:56,302 --> 00:18:58,596
しっぱいなんかに まけちゃ
ダメなのだ！

417
00:18:58,680 --> 00:18:59,514
(ドキンたち)ええ！

418
00:19:00,056 --> 00:19:01,599
(ばいきんまん) おれさまなんか――

419
00:19:01,683 --> 00:19:03,518
アンパンマンに
なんかい やられても――

420
00:19:03,601 --> 00:19:06,354
ぜーったい あきらめないぞ

421
00:19:06,437 --> 00:19:07,856
(ヒヤリコ) ばいきんまん…

422
00:19:09,274 --> 00:19:12,986
そうです！
ばいきんまんの いうとおり――

423
00:19:13,069 --> 00:19:17,031
しっぱいなんかに くじけちゃ
まけてちゃ ダメなんです！

424
00:19:17,866 --> 00:19:18,908
(ばいきんまん) うん

425
00:19:19,200 --> 00:19:21,160
(ヒヤリ) うんうん

426
00:19:21,703 --> 00:19:24,122
(ドキン) いいこと いうじゃない
ばいきんまん

427
00:19:24,205 --> 00:19:26,249
(ホラーマン) ほんと ほんと
(ばいきんまん) まあね

428
00:19:26,332 --> 00:19:28,167
(ヒヤリコ) じゃあ さっそく～
(ばいきんまん) あ？

429
00:19:29,544 --> 00:19:31,045
ヒャッ ヒャッ ヒャ～

430
00:19:31,129 --> 00:19:33,756
ヒヤッ ヒヤッ ヒヤッ ヒヤ～ッ

431
00:19:34,215 --> 00:19:37,468
できました！
“とてもつよくなるスーパー”

432
00:19:37,552 --> 00:19:38,511
ヒャッ ヒャッ ヒャッ

433
00:19:38,595 --> 00:19:40,680
これなら ぜったい こんどこそ… あっ

434
00:19:40,763 --> 00:19:41,848
ヒャ～ッ

435
00:19:41,931 --> 00:19:45,184
(みんな) ヒヤ～ッ！

436
00:19:45,268 --> 00:19:52,275
♪～

437
00:20:56,297 --> 00:21:03,304
～♪

