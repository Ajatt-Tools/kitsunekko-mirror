Dialogue: 0,0:49:02.73,0:49:04.02,Default,,0,0,0,,(女性)うっ!\N(鹿野)変わりすぎ\Nルーイエ
Dialogue: 0,0:49:04.53,0:49:06.94,Default,,0,0,0,,( 女性)うっ…あっうあっ
Dialogue: 0,0:49:08.03,0:49:09.24,Default,,0,0,0,,シャオヘイ\N(小黒)んっうわあっ
Dialogue: 0,0:49:14.24,0:49:15.41,Default,,0,0,0,,(女性)はっ!\N(小黒)んっ\Nシャオヘイ
