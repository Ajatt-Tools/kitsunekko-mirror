1
00:00:30,072 --> 00:00:31,615
(メロンパンナ) きれいね～

2
00:00:31,699 --> 00:00:32,992
(クリームパンダ) うん

3
00:00:33,784 --> 00:00:34,785
(アンパンマン) ドリームすいせい――

4
00:00:34,869 --> 00:00:36,787
また おおきくなりましたね

5
00:00:36,871 --> 00:00:38,998
(バタコさん) まいにち
どんどん ちかづいてきてるわ

6
00:00:39,081 --> 00:00:39,957
(チーズ) アンアン

7
00:00:40,374 --> 00:00:41,500
(ジャムおじさん)
ドリームすいせいは――

8
00:00:41,584 --> 00:00:43,961
100ねんに いちどしか
ちかづいてこない――

9
00:00:44,044 --> 00:00:46,338
とても めずらしい
すいせいなんだよ

10
00:00:46,422 --> 00:00:47,673
(メロンパンナたち) へえ～

11
00:00:47,757 --> 00:00:48,591
(メロンパンナ) アハッ

12
00:01:02,188 --> 00:01:04,023
(クリームパンダ･メロンパンナ)
うわあ～

13
00:01:18,537 --> 00:01:20,122
(クリームパンダ)
ふしぎなところだね～

14
00:01:20,206 --> 00:01:21,040
(メロンパンナ) うん

15
00:01:21,332 --> 00:01:24,001
でも ふんわか あったかくて
きもちいい

16
00:01:24,084 --> 00:01:25,044
(わらいごえ)
(クリームパンダ) あれ？

17
00:01:25,127 --> 00:01:27,546
(こどもたちの はしゃぐこえ)

18
00:01:27,630 --> 00:01:30,049
(カバおたち) アハハッ
アハハッ ニャニャー

19
00:01:30,132 --> 00:01:31,342
(こどもたち) そ～れ そ～れ

20
00:01:31,425 --> 00:01:32,510
(メロンパンナ) みんな～

21
00:01:32,593 --> 00:01:33,427
(ちびぞう) あ～！

22
00:01:34,011 --> 00:01:35,054
(ウサこ) メロンパンナちゃん！

23
00:01:35,137 --> 00:01:36,555
(ちびぞう) クリームパンダちゃん！

24
00:01:37,056 --> 00:01:37,932
(クリームパンダ･メロンパンナ)
アハッ

25
00:01:38,808 --> 00:01:41,435
(メロンパンナ) うわあ
おいしそうなフルーツ

26
00:01:42,144 --> 00:01:44,146
(クリームパンダ)
ほしのかたちを しているんだね

27
00:01:44,230 --> 00:01:45,940
(ちびぞう) あまい においだぞう

28
00:01:46,023 --> 00:01:47,942
(カバおたち) いただきま～す！

29
00:01:49,902 --> 00:01:51,195
うわあ！

30
00:01:51,278 --> 00:01:53,614
(ばいきんまん) ハヒフヘホ～

31
00:01:54,198 --> 00:01:55,491
(カバおたち) ばいきんまん！

32
00:01:55,574 --> 00:01:57,660
(ばいきんまん) おとなしく
そのフルーツをよこせ！

33
00:01:57,743 --> 00:01:58,577
(カバおたち) ええっ

34
00:01:58,661 --> 00:02:01,121
(ピョンきち) じぶんのぶんは
じぶんでとれば いいじゃないか！

35
00:02:01,205 --> 00:02:02,164
(ちびぞう) そうだぞう

36
00:02:02,248 --> 00:02:04,458
まわりに
こ～んなに あるじゃないか！

37
00:02:04,542 --> 00:02:05,751
(ばいきんまん) うるさーい！

38
00:02:05,835 --> 00:02:07,002
(メロンパンナたち) うわあ！

39
00:02:07,086 --> 00:02:11,006
おれさまは おまえたちの
もっているのが たべたいの！

40
00:02:12,049 --> 00:02:14,134
(メロンパンナたち) うわあ～

41
00:02:15,261 --> 00:02:16,637
(カバお) たいへんだ～

42
00:02:16,720 --> 00:02:18,097
(ウサこ) こんなときには…

43
00:02:18,180 --> 00:02:19,849
(ちびぞう)
みんなで よぶぞう

44
00:02:19,932 --> 00:02:20,975
(クリームパンダ) せ～の…

45
00:02:21,642 --> 00:02:25,563
(みんな) アンパンマ～ン！

46
00:02:25,646 --> 00:02:32,653
♪～

47
00:02:39,034 --> 00:02:40,786
(カバおたち) うわあ～
(ばいきんまん) うお？

48
00:02:44,164 --> 00:02:46,542
うーん この～！

49
00:03:28,000 --> 00:03:35,007
～♪

50
00:03:35,633 --> 00:03:36,550
(ひばなが ちるおと)

51
00:03:36,634 --> 00:03:37,676
(みんな) あ？

52
00:03:38,594 --> 00:03:40,554
うわああ！

53
00:03:40,638 --> 00:03:41,889
(アンパンマン) みんな にげて！

54
00:03:41,972 --> 00:03:43,891
(メロンパンナたち) あああ～
(アンパンマン) だああ！

55
00:03:45,392 --> 00:03:46,477
(ちびぞう) うわっ
(アンパンマン) えいっ

56
00:03:52,858 --> 00:03:54,151
(メロンパンナ) うっ あっ！

57
00:03:54,234 --> 00:03:55,319
(アンパンマン) ええいっ

58
00:03:59,490 --> 00:04:00,407
え？

59
00:04:00,491 --> 00:04:01,659
たまご… なの？

60
00:04:04,745 --> 00:04:05,871
ああっ！

61
00:04:06,872 --> 00:04:08,749
(ちびぞうたち) わあっ
(アンパンマン) メロンパンナちゃん！

62
00:04:08,832 --> 00:04:10,626
(メロンパンナ) ハア ハア… ふっ！

63
00:04:10,709 --> 00:04:12,252
うわあっ

64
00:04:12,878 --> 00:04:14,004
うっ

65
00:04:15,172 --> 00:04:20,135
う… うわあ～！

66
00:04:20,219 --> 00:04:21,428
ハッ！

67
00:04:22,221 --> 00:04:23,806
(ことりの なきごえ)

68
00:04:23,889 --> 00:04:25,391
(クリームパンダの ねいき)

69
00:04:28,435 --> 00:04:32,022
(メロンパンナ) あ… ゆめだったんだ

70
00:04:32,106 --> 00:04:33,399
(ふとんが うごくおと)
(メロンパンナ) あ？

71
00:04:34,024 --> 00:04:35,859
うわっ ああ… あ…

72
00:04:36,443 --> 00:04:38,112
な… なに？

73
00:04:39,989 --> 00:04:41,281
え？

74
00:04:42,199 --> 00:04:45,077
だ… だって さっきのは ゆめ

75
00:04:45,411 --> 00:04:46,787
わっ！ う…

76
00:04:47,287 --> 00:04:49,707
あ… あ… あっ

77
00:04:50,165 --> 00:04:51,250
うわ！

78
00:04:51,333 --> 00:04:52,501
(クリームパンダ) うっ うっ

79
00:04:52,584 --> 00:04:54,044
うっ！ ああっ！

80
00:04:59,883 --> 00:05:01,802
(ニャニイ) ニャン ニャン…

81
00:05:04,013 --> 00:05:05,431
ニャニイ～

82
00:05:05,514 --> 00:05:06,515
(クリームパンダ) あっ… ああ

83
00:05:06,598 --> 00:05:07,683
(メロンパンナ) ねこ？

84
00:05:07,766 --> 00:05:09,226
ニャン アア～

85
00:05:09,309 --> 00:05:11,353
ニャ アア～ アア

86
00:05:11,437 --> 00:05:13,647
ニャ～… ア～

87
00:05:13,731 --> 00:05:17,568
(メロンパンナ) ウフッ
だいじょうぶ こわくないよ

88
00:05:17,651 --> 00:05:18,694
でておいで

89
00:05:20,195 --> 00:05:21,530
(ニャニイ) ン？

90
00:05:24,116 --> 00:05:25,659
ン～…

91
00:05:25,743 --> 00:05:29,204
(においを かぐこえ)

92
00:05:30,456 --> 00:05:31,707
ニャニイ

93
00:05:31,790 --> 00:05:33,208
(メロンパンナ･クリームパンダ)
アハハッ

94
00:05:33,292 --> 00:05:36,211
(メロンパンナ) ウフフ
フフッ かわいい～

95
00:05:36,295 --> 00:05:38,338
(ニャニイ) ニャニイ～

96
00:05:38,964 --> 00:05:39,965
ニャ～ン

97
00:05:40,049 --> 00:05:42,342
でも あなた どこからきたの？

98
00:05:42,426 --> 00:05:44,094
ニャニイ？

99
00:05:54,772 --> 00:05:57,566
(ことりの なきごえ)

100
00:05:57,649 --> 00:05:58,984
(メロンパンナ) はい ミルクよ

101
00:05:59,068 --> 00:06:00,444
(ニャニイ) ニャニイ～

102
00:06:01,028 --> 00:06:03,322
(ニャニイ) ウンウンウン…

103
00:06:03,405 --> 00:06:05,741
(クリームパンダ) うわ～ かわいいね

104
00:06:06,492 --> 00:06:10,370
(ジャム) う～ん ゆめで みたのと
おなじたまごが ベッドにあって――

105
00:06:10,454 --> 00:06:13,082
その こねこが
うまれたというんだね？

106
00:06:13,165 --> 00:06:14,792
(メロンパンナ) うん　そうなの

107
00:06:14,875 --> 00:06:16,418
(バタコ) ふしぎな はなしね

108
00:06:16,502 --> 00:06:17,503
(チーズ) ク～ン

109
00:06:17,836 --> 00:06:22,132
そもそも ねこは たまごから
うまれるものじゃないんだけどね

110
00:06:22,216 --> 00:06:23,175
ジャムおじさん

111
00:06:23,258 --> 00:06:25,594
ふしぎなのは それだけじゃないんだよ

112
00:06:25,677 --> 00:06:26,553
(ジャム) ん？

113
00:06:26,637 --> 00:06:28,847
あのね　ぼくと
メロンパンナおねえちゃん――

114
00:06:28,931 --> 00:06:30,474
おなじゆめを みたんだ

115
00:06:30,557 --> 00:06:31,642
おなじゆめ？

116
00:06:31,725 --> 00:06:33,477
しらないせかいに いてね

117
00:06:33,560 --> 00:06:35,687
カバおくんたちと
フルーツたべようとしたら――

118
00:06:35,771 --> 00:06:37,481
ばいきんまんが おそってきて…

119
00:06:37,564 --> 00:06:38,649
(アンパンマン) え？
(クリームパンダ･ジャム) ん？

120
00:06:38,732 --> 00:06:40,025
(ジャム) おお～ アンパンマン

121
00:06:40,109 --> 00:06:42,111
パトロール ごくろうさま

122
00:06:42,194 --> 00:06:43,904
(アンパンマン) ぼくも
おなじゆめをみました

123
00:06:43,987 --> 00:06:45,781
(バタコたち) ええっ？
(ジャム) なんだって？

124
00:06:45,864 --> 00:06:46,949
(カレーパンマン･しょくぱんまん)
ええ？

125
00:06:47,032 --> 00:06:48,534
(しょくぱんまん)
みんな おなじゆめを？

126
00:06:48,784 --> 00:06:50,577
(ピョンきち) うん　そうなんだ

127
00:06:50,661 --> 00:06:52,287
(ちびぞう) ふしぎなんだぞう

128
00:06:54,081 --> 00:06:55,374
(ドキンちゃん･ホラーマン) アハハハ

129
00:06:55,457 --> 00:06:57,292
(ドキン) へんなの～

130
00:06:57,918 --> 00:07:01,130
(ドキン) あさ おきたら
そんなボロボロになってたなんて

131
00:07:01,213 --> 00:07:03,090
(ホラーマン) ばいきんまんは
ゆめんなかでも――

132
00:07:03,173 --> 00:07:05,050
アンパンマンには かてないんですね

133
00:07:05,134 --> 00:07:07,553
(ばいきんまん) うるさ～い！

134
00:07:07,928 --> 00:07:08,804
(ホラーマン) ホラ…

135
00:07:09,179 --> 00:07:12,516
(ニャニイ)
ンニャ クウクウクウ…

136
00:07:12,766 --> 00:07:14,101
プハア～

137
00:07:14,184 --> 00:07:17,396
フフッ
そう　おいしかったのね

138
00:07:17,479 --> 00:07:18,313
よかった

139
00:07:18,397 --> 00:07:19,565
(ニャニイ) ニャニイ～

140
00:07:19,648 --> 00:07:23,152
(カレーパンマン) ふ～ん
けっこう かわいい かおしてんだな

141
00:07:23,235 --> 00:07:24,444
(ニャニイ) ニャー！

142
00:07:24,528 --> 00:07:25,654
(カレーパンマン) あー？

143
00:07:25,988 --> 00:07:27,447
(しょくぱんまん) アハハハッ

144
00:07:27,531 --> 00:07:30,659
カレーパンマンのかおが
こわかったみたいですね

145
00:07:30,742 --> 00:07:31,660
(カレーパンマン) なにー？

146
00:07:32,286 --> 00:07:34,872
(しょくぱんまん) はじめまして
あいらしき こねこさん

147
00:07:34,955 --> 00:07:36,665
わたしは しょくぱんまんです

148
00:07:36,748 --> 00:07:38,542
(ニャニイ) ニャー！ ニャア～

149
00:07:38,792 --> 00:07:39,960
(しょくぱんまん) ショック…

150
00:07:40,085 --> 00:07:43,005
イヤーヘヘヘヘッ
ウヒャヒャヒャ

151
00:07:43,088 --> 00:07:46,091
(バタコ) まだ あかちゃんだから
しらないひとが こわいのよ

152
00:07:46,175 --> 00:07:47,009
(チーズ) アン　アンアン

153
00:07:47,092 --> 00:07:48,218
(しょくぱんまん) うう～…

154
00:07:48,302 --> 00:07:49,344
(ニャニイ) ニャ～ン…

155
00:07:49,428 --> 00:07:53,056
だいじょうぶだよ
みんな とっても やさしいんだから

156
00:07:53,765 --> 00:07:55,726
(ニャニイ) ン？ ニャン？

157
00:07:55,976 --> 00:07:57,227
(カレーパンマン) うん
(クリームパンダ) エヘッ

158
00:07:57,311 --> 00:07:58,729
(しょくぱんまん) ウヘヘヘヘ…

159
00:07:58,812 --> 00:08:00,606
(ジャム) うーん ウフフ…

160
00:08:00,689 --> 00:08:02,149
(ニャニイ) ニャ
(メロンパンナ) ね？

161
00:08:02,232 --> 00:08:03,942
(ニャニイ) ニャン
(メロンパンナ) ウフフフッ

162
00:08:04,026 --> 00:08:05,694
(カレーパンマン)
けど これから どうすんだ？

163
00:08:05,777 --> 00:08:06,778
(メロンパンナ) ん？

164
00:08:06,862 --> 00:08:10,324
(しょくぱんまん)
ゆめのなかに かえしにいくなんて
できないですよね？

165
00:08:10,407 --> 00:08:11,575
(メロンパンナ) あたしが そだてる

166
00:08:11,658 --> 00:08:12,492
(バタコたち) え？

167
00:08:12,910 --> 00:08:15,245
(メロンパンナ)
あたしが このこをそだてる

168
00:08:15,329 --> 00:08:17,164
いいでしょ ジャムおじさん

169
00:08:17,247 --> 00:08:18,498
(クリームパンダ) おねえちゃん

170
00:08:18,582 --> 00:08:20,292
(ふたり) う～ん

171
00:08:21,376 --> 00:08:22,377
(アンパンマン) ん？

172
00:08:23,337 --> 00:08:24,588
(ジャム) メロンパンナちゃん

173
00:08:24,671 --> 00:08:28,425
だれかを そだてるというのは
とても たいへんなことなんだよ

174
00:08:28,508 --> 00:08:29,384
(メロンパンナ) ああ…

175
00:08:29,468 --> 00:08:31,595
(ジャム) そのこは まだ
ちいさい あかちゃんだから――

176
00:08:31,678 --> 00:08:33,055
しっかり せわをして――

177
00:08:33,138 --> 00:08:35,515
たいせつに まもってあげないと
いけないよ

178
00:08:36,058 --> 00:08:37,726
それが できるかい？

179
00:08:37,809 --> 00:08:38,769
(メロンパンナ) はい

180
00:08:38,852 --> 00:08:40,270
うーん

181
00:08:40,354 --> 00:08:42,397
それじゃ そだててあげなさい

182
00:08:42,481 --> 00:08:44,942
メロンパンナちゃんが
そのこの ママになって――

183
00:08:45,025 --> 00:08:46,777
しあわせにして あげるんだよ

184
00:08:47,236 --> 00:08:48,779
(メロンパンナ) ママ？
(ニャニイ) ニャ？

185
00:08:48,862 --> 00:08:50,614
(メロンパンナ) ママ？ はい！

186
00:08:50,989 --> 00:08:53,408
メロンパンナちゃんなら
きっと できるよ

187
00:08:53,909 --> 00:08:55,410
(バタコ) そうね
(チーズ) アンアン

188
00:08:55,953 --> 00:08:57,079
(クリームパンダ) ぼくも てつだう！

189
00:08:57,162 --> 00:08:58,789
(メロンパンナ) うん！ おねがいね

190
00:08:58,872 --> 00:09:00,916
じゃあ まず
なまえをつけなきゃ

191
00:09:01,375 --> 00:09:03,001
(みんな) う～ん…

192
00:09:03,085 --> 00:09:04,378
(カレーパンマン)
ニャンたろうは どうだ？

193
00:09:04,461 --> 00:09:05,671
(メロンパンナ) このこ おんなのこよ

194
00:09:05,754 --> 00:09:07,464
(カレーパンマン)
それじゃ ニャーこ！

195
00:09:07,547 --> 00:09:08,632
(バタコ) たまちゃん

196
00:09:08,715 --> 00:09:09,925
(クリームパンダ) チビが いいよ

197
00:09:10,008 --> 00:09:12,386
(しょくぱんまん)
ほしくずの ひとみのネコネコちゃん

198
00:09:12,469 --> 00:09:13,595
これで きまりです

199
00:09:13,679 --> 00:09:15,514
(ジャム)
ながくて よぶのは たいへんだよ

200
00:09:15,597 --> 00:09:16,431
(チーズ) アンアン

201
00:09:17,224 --> 00:09:19,643
(アンパンマン)
どんな なまえだと よろこぶかなあ

202
00:09:19,726 --> 00:09:20,852
(ニャニイ) ニャニイ～

203
00:09:20,936 --> 00:09:21,770
(メロンパンナ) あ？

204
00:09:21,853 --> 00:09:23,313
(ニャニイ) ニャーニイ

205
00:09:23,397 --> 00:09:25,357
(メロンパンナ) アハッ きめた！

206
00:09:25,440 --> 00:09:28,235
ニャニイ！
あなたのなまえは ニャニイよ！

207
00:09:28,318 --> 00:09:29,945
(ニャニイ) ニャニイ ニャニイ～

208
00:09:30,028 --> 00:09:31,321
(アンパンマン) ウフフッ

209
00:09:31,405 --> 00:09:32,698
(クリームパンダ) きにいったみたい

210
00:09:33,198 --> 00:09:36,451
(メロンパンナ) ニャニイ よろしくね
あたしがママよ

211
00:09:36,535 --> 00:09:37,703
(ニャニイ) ママ？

212
00:09:38,453 --> 00:09:39,955
そうよ ママ

213
00:09:40,038 --> 00:09:42,207
ウフッ ウフフフ…

214
00:09:42,291 --> 00:09:43,583
(ニャニイ) ママ？
(メロンパンナ) ニャニイ～

215
00:09:43,667 --> 00:09:45,585
(ニャニイ) ママ？
ママ ママ ママー

216
00:09:45,669 --> 00:09:46,628
(メロンパンナ) あたしがママよ

217
00:09:46,712 --> 00:09:47,546
(ふたり) アハッ

218
00:09:47,629 --> 00:09:49,006
(４にん) ウフフフフ

219
00:09:49,089 --> 00:09:51,300
(メロンパンナ) アハハ ウフフッ

220
00:09:51,383 --> 00:09:54,970
(ジャム) <ゆめのなかの たまごから
こねこが うまれたり――>

221
00:09:55,053 --> 00:09:59,808
<みんなが おなじゆめをみたり
いったい どうしたことか>

222
00:09:59,891 --> 00:10:02,060
♪～

223
00:10:02,144 --> 00:10:03,895
(メロンパンナ)
ニャニイ おさんぽにいこう

224
00:10:03,979 --> 00:10:05,272
(ニャニイ) ニャニイ～

225
00:10:24,875 --> 00:10:30,172
♪ ねんねん 夜ふけのねむり森

226
00:10:30,756 --> 00:10:35,844
♪ ねんねん きれいなねむり姫

227
00:10:36,595 --> 00:10:42,017
♪ 夢見て笑う どんな夢

228
00:10:42,392 --> 00:10:47,981
♪ ん～ん～ん～ ん～ん～ん～

229
00:10:48,273 --> 00:10:53,612
♪ うれしいうれしい

230
00:10:54,237 --> 00:10:59,576
♪ 夢をみてるみたい

231
00:10:59,951 --> 00:11:02,204
♪ ん～ん～ん～

232
00:11:05,874 --> 00:11:11,213
♪ ねんねん 歌うよ子守唄

233
00:11:11,713 --> 00:11:17,010
♪ ねんねんおねむり夜あけまで

234
00:11:17,552 --> 00:11:22,974
♪ やさしい歌を聴きながら

235
00:11:23,392 --> 00:11:29,022
♪ ん～ん～ん～ ん～ん～ん～

236
00:11:29,314 --> 00:11:34,653
♪ だれでもだれでも

237
00:11:35,112 --> 00:11:40,575
♪ 夢の国でねむる

238
00:11:40,992 --> 00:11:43,829
♪ ん～ん～ん～

239
00:11:43,912 --> 00:11:46,748
♪ ん～ん～ん～

240
00:11:46,832 --> 00:11:52,045
♪ ん～ん～ん～…

241
00:11:55,298 --> 00:11:56,508
(メロンパンナ) ニャニイ

242
00:11:56,591 --> 00:11:57,801
(ニャニイ) マンマ～

243
00:11:58,427 --> 00:11:59,511
(メロンパンナ) ニャニイ～

244
00:11:59,594 --> 00:12:00,887
(ニャニイ) マンマ

245
00:12:00,971 --> 00:12:04,307
(メロンパンナ) ニャニイとママ
ずーっと いっしょに いようね

246
00:12:04,391 --> 00:12:07,561
(ニャニイ) ニャニイ マンマ
ずーっと いっしょ

247
00:12:07,644 --> 00:12:08,728
(メロンパンナ) うん！

248
00:12:08,812 --> 00:12:10,814
ずーっと ずーっと いっしょ

249
00:12:11,606 --> 00:12:13,066
ずーっと ずーっと！

250
00:12:13,525 --> 00:12:15,902
(メロンパンナ)
ずーっと ずーっと ずーっと

251
00:12:15,986 --> 00:12:18,530
(ニャニイ)
ずーっと ずーっと ずーっと

252
00:12:18,613 --> 00:12:20,282
(メロンパンナ) ずーっと ずーっと

253
00:12:23,285 --> 00:12:24,494
(ドキン) うわあ

254
00:12:25,162 --> 00:12:26,371
あの こねこ かわいい

255
00:12:26,455 --> 00:12:27,581
(ホラーマン) あはー…

256
00:12:28,123 --> 00:12:30,041
(ドキン) かわいい かわい～
(ホラーマン) ホラ～

257
00:12:30,125 --> 00:12:31,209
～♪

258
00:12:31,293 --> 00:12:32,335
(ドキン) ばいきんまーん！

259
00:12:32,419 --> 00:12:33,545
(ホラーマン) うわっ

260
00:12:33,628 --> 00:12:36,089
(ドキン) メロンパンナの こねこ
つかまえてきて～

261
00:12:36,631 --> 00:12:38,300
(ばいきんまん) う～ん…

262
00:12:38,383 --> 00:12:39,426
アンパンマンを――

263
00:12:39,509 --> 00:12:42,179
アンパンマンを
やっつける ほうほうは…

264
00:12:42,262 --> 00:12:43,597
てやん～…

265
00:12:43,680 --> 00:12:47,058
(ドキン) ちょっと ばいきんまん
ばいきんまんってば！

266
00:12:47,309 --> 00:12:49,644
もういいわよ ばいきんまんなんか！

267
00:12:49,728 --> 00:12:51,354
いくわよ ホラーマン

268
00:12:51,438 --> 00:12:52,647
(ホラーマン) ホラッ ああっ

269
00:12:56,359 --> 00:12:58,528
(ニャニイ) マンマ どこいくの？

270
00:12:58,612 --> 00:13:01,448
(メロンパンナ) きょうはね
ママのおねえちゃんに あいにいくの

271
00:13:02,115 --> 00:13:03,909
ママのおねえちゃん？

272
00:13:03,992 --> 00:13:06,745
そうよ
ロールパンナおねえちゃん

273
00:13:06,828 --> 00:13:08,872
ニャニイのこと しょうかいしたいの

274
00:13:08,955 --> 00:13:10,123
(ホラーマン) ホネブーメラン！

275
00:13:10,207 --> 00:13:11,208
(メロンパンナ) あ？

276
00:13:12,542 --> 00:13:14,044
(メロンパンナ) うわっ
(ニャニイ) ニャー！

277
00:13:14,127 --> 00:13:15,295
(ニャニイ) ニャー！

278
00:13:16,379 --> 00:13:17,672
(ホラーマン) ホラ！
(ドキン) やった～！

279
00:13:19,174 --> 00:13:20,467
ニャニイ！

280
00:13:21,092 --> 00:13:22,719
(メロンパンナ) ハア ハア ハア…

281
00:13:22,802 --> 00:13:24,971
ママ！ ママ～！

282
00:13:25,388 --> 00:13:26,640
ニャニイ ニャニイー！

283
00:13:26,723 --> 00:13:27,807
(ニャニイ) ママ～！

284
00:13:27,891 --> 00:13:30,227
フーンだ　むだむだ

285
00:13:31,186 --> 00:13:34,481
ああっ！ うっ うう… うっ！

286
00:13:34,564 --> 00:13:36,066
(ニャニイ) ママ～！

287
00:13:36,149 --> 00:13:37,484
(メロンパンナ) ニャニイー…

288
00:13:39,361 --> 00:13:41,238
(ロールパンナ) ロールリボン！

289
00:13:41,321 --> 00:13:44,574
(ドキン･ホラーマン)
ううっ うわあっ わあっ

290
00:13:44,658 --> 00:13:46,326
(ニャニイ) ニャ！ ニャウーン！

291
00:13:47,452 --> 00:13:49,538
ロールパンナおねえちゃん！

292
00:13:49,621 --> 00:13:50,497
(ニャニイ) ママー！

293
00:13:50,580 --> 00:13:51,498
(メロンパンナ) ニャニイ

294
00:13:51,581 --> 00:13:54,251
(ドキン) ちょっと ロールパンナ！
なにすんのよ！

295
00:13:54,543 --> 00:13:55,502
(ロールパンナ) うん？

296
00:13:56,211 --> 00:13:57,504
(ドキン) うっ
(ホラーマン) わっ

297
00:13:57,587 --> 00:14:00,757
(ホラーマン) ホラー ホラー
(ドキン) うっ うううっ

298
00:14:00,924 --> 00:14:03,218
(ドキン) ロールパンナの おバカ～！

299
00:14:05,845 --> 00:14:07,347
(メロンパンナ)
ありがとう おねえちゃん

300
00:14:07,430 --> 00:14:09,140
(ニャニイ) ン？
(ロールパンナ) だいじょうぶだったか？

301
00:14:09,224 --> 00:14:10,684
(メロンパンナ) うん！
(ニャニイ) ニャン？

302
00:14:12,018 --> 00:14:14,312
ニャニイ ロールパンナおねえちゃんよ

303
00:14:14,396 --> 00:14:15,939
ン？ ニャー！

304
00:14:16,022 --> 00:14:18,149
おねえちゃん
このこは ニャニイ

305
00:14:18,233 --> 00:14:20,610
あたしがママになって
そだててるの

306
00:14:21,361 --> 00:14:22,862
(ロールパンナ) ニャニイ？
(メロンパンナ) わっ…

307
00:14:22,946 --> 00:14:24,364
(ニャニイ) ウン ニャーン

308
00:14:25,991 --> 00:14:27,367
ニャニイ

309
00:14:27,784 --> 00:14:28,952
(ロールパンナ) ん？

310
00:14:29,286 --> 00:14:30,829
(ニャニイ) ニャニイ～

311
00:14:32,664 --> 00:14:33,665
ニャーン

312
00:14:33,748 --> 00:14:34,583
(ロールパンナ) あっ…

313
00:14:34,666 --> 00:14:35,750
(ニャニイ) ニャン！

314
00:14:35,834 --> 00:14:38,378
ウ～ン ニャーン

315
00:14:38,461 --> 00:14:41,506
ニャ～ン ン～

316
00:14:41,590 --> 00:14:42,757
(ロールパンナ) あ…

317
00:14:43,383 --> 00:14:46,219
やわらかくて あたたかいんだな

318
00:14:46,303 --> 00:14:47,721
(メロンパンナ) うん　ニャニイ――

319
00:14:47,804 --> 00:14:49,806
おねえちゃんのこと だいすきだって

320
00:14:49,889 --> 00:14:52,767
(ロールパンナ)
だいすき？ わたしが？

321
00:14:53,393 --> 00:14:55,645
ニャニイ　ニャン？

322
00:14:56,187 --> 00:14:57,480
(ロールパンナ) ああ…

323
00:14:58,815 --> 00:15:01,026
(ニャニイ) ニャ ン～ン～

324
00:15:01,109 --> 00:15:02,736
(ロールパンナ) ウフフッ

325
00:15:03,320 --> 00:15:05,113
ウフフッ フフッ

326
00:15:10,035 --> 00:15:17,042
(つよいかぜの おと)

327
00:15:24,215 --> 00:15:25,884
(ガラスまどが ふるえるおと)

328
00:15:25,967 --> 00:15:27,886
ううう…

329
00:15:27,969 --> 00:15:30,388
え… こ… こわいよ～

330
00:15:33,683 --> 00:15:35,894
(メロンパンナ) ううう… うう…

331
00:15:35,977 --> 00:15:37,854
(クリームパンダ) ううう…

332
00:15:38,730 --> 00:15:40,148
(バタコ) ここ… どこ？

333
00:15:40,231 --> 00:15:41,900
う… う～ん…

334
00:15:41,983 --> 00:15:43,652
う… う～ん…

335
00:15:53,995 --> 00:15:56,915
♪ ニャニイ ニャニイ

336
00:15:57,332 --> 00:16:01,294
♪ ニャニイ ニャニイ

337
00:16:01,628 --> 00:16:07,592
♪ どこにいるの ニャニイ

338
00:16:07,926 --> 00:16:10,512
♪ かえっておいで

339
00:16:10,595 --> 00:16:13,473
(アンパンマンたち) ああ…

340
00:16:14,724 --> 00:16:16,726
(ジャム) ここは もしかして…

341
00:16:16,810 --> 00:16:19,604
(メロンパンナ) ああ… う… う…

342
00:16:20,021 --> 00:16:20,855
(ものおと)

343
00:16:20,939 --> 00:16:21,856
あっ！

344
00:16:24,693 --> 00:16:26,236
ああーっ！

345
00:16:26,569 --> 00:16:27,779
ハッ！

346
00:16:28,780 --> 00:16:29,864
(クリームパンダ) うう…

347
00:16:29,948 --> 00:16:31,783
(メロンパンナ) いまのゆめ なに？

348
00:16:31,866 --> 00:16:35,495
(ニャニイ) ウン ウウ～ン…

349
00:16:35,578 --> 00:16:36,663
(メロンパンナ) あっ

350
00:16:37,747 --> 00:16:39,791
ニャニイ ニャニイ！

351
00:16:40,709 --> 00:16:41,876
ママ？

352
00:16:47,674 --> 00:16:49,467
(あめの おと)

353
00:16:49,551 --> 00:16:51,553
(ジャム) みんながみた ゆめのばしょ

354
00:16:51,636 --> 00:16:54,514
あれは きっと ゆめねこのくにだよ

355
00:16:54,597 --> 00:16:55,765
(メロンパンナ) ゆめねこのくに？

356
00:16:55,849 --> 00:16:56,683
(ニャニイ) ニャン？

357
00:16:56,766 --> 00:16:58,309
(しょくぱんまん)
それは なんですか？

358
00:16:58,601 --> 00:17:01,104
(ジャム) みんな このほんをごらん

359
00:17:01,146 --> 00:17:02,439
(アンパンマンたち) ああ？

360
00:17:02,522 --> 00:17:04,441
(アンパンマン) ドリームすいせい？

361
00:17:04,524 --> 00:17:07,736
(ジャム)“ゆめねこのくには
ドリームすいせいの なかにあって――”

362
00:17:07,819 --> 00:17:11,448
“ゆめねこたちが すんでいる
ふしぎなくにだ”と かいてあるよ

363
00:17:11,531 --> 00:17:14,159
わたしたちが みたゆめは
100ねんにいちど――

364
00:17:14,242 --> 00:17:17,078
ドリームすいせいが
ちかづいたときにだけ みられる――

365
00:17:17,162 --> 00:17:19,289
そのくにのゆめ だそうだ

366
00:17:19,664 --> 00:17:21,332
え？ ゆめのくに？

367
00:17:22,000 --> 00:17:24,669
(カレーパンマン) へえ
ゆめのなかに すんでたのか

368
00:17:24,753 --> 00:17:27,005
(バタコ) でも そんな くにが
あのドリームすいせい…

369
00:17:27,088 --> 00:17:30,008
ホラ？
なんか よくきこえませんね

370
00:17:30,091 --> 00:17:31,718
もう オンボロなんだから！

371
00:17:31,801 --> 00:17:33,470
(ホラーマン) あっ あっ ホラ！

372
00:17:35,013 --> 00:17:36,598
(アンパンマン)
それじゃ ニャニイちゃんは…

373
00:17:36,973 --> 00:17:40,435
(ジャム) ゆめねこのくにに
100ねんに いちど うまれるという――

374
00:17:40,518 --> 00:17:42,729
とくべつな ゆめねこだったんだよ

375
00:17:42,812 --> 00:17:44,564
(メロンパンナ)
とくべつな ゆめねこ？

376
00:17:44,647 --> 00:17:46,941
(ジャム) うん　ほら ここに

377
00:17:47,859 --> 00:17:49,277
(アンパンマンたち) ああっ

378
00:17:49,360 --> 00:17:50,987
(クリームパンダ)
ニャニイちゃんに そっくりだ

379
00:17:51,738 --> 00:17:54,282
(ジャム) ニャニイちゃんは
メロンパンナちゃんと いっしょに――

380
00:17:54,365 --> 00:17:57,494
まちがって このせかいに
きてしまったんだね

381
00:17:57,911 --> 00:17:58,828
(メロンパンナ) ああ…

382
00:17:58,912 --> 00:17:59,996
(バタコ) そうだったの

383
00:18:00,747 --> 00:18:02,040
(アンパンマン)
だから ゆめのなかで――

384
00:18:02,123 --> 00:18:04,584
ニャニイちゃんをよぶこえが
したんですね

385
00:18:04,667 --> 00:18:05,877
(チーズ) アンアン

386
00:18:05,960 --> 00:18:08,463
(カレーパンマン) そりゃ
なんとかして かえしてやらないと

387
00:18:08,546 --> 00:18:10,131
(メロンパンナ) いやよ！
(ジャムたち) ええ？

388
00:18:10,215 --> 00:18:11,299
(メロンパンナ) ニャニイは…

389
00:18:11,382 --> 00:18:14,511
ニャニイは ずーっと あたしと
いっしょにいるんだから

390
00:18:14,928 --> 00:18:16,471
(クリームパンダ) おねえちゃん

391
00:18:16,554 --> 00:18:18,097
(ジャム) メロンパンナちゃん

392
00:18:18,181 --> 00:18:21,726
ニャニイちゃんと このまま
くらすことは できないんだよ

393
00:18:21,810 --> 00:18:22,811
(メロンパンナ) え？

394
00:18:23,144 --> 00:18:24,521
(ジャム) ゆめねこの あかちゃんは――

395
00:18:24,604 --> 00:18:28,691
ゆめねこのくににしか はえない
ネムネムの きのみを たべないと――

396
00:18:28,775 --> 00:18:30,568
いつか ひかりのつぶになって――

397
00:18:30,652 --> 00:18:32,111
きえてしまうそうなんだ

398
00:18:32,195 --> 00:18:33,029
(メロンパンナ) ええ？

399
00:18:33,112 --> 00:18:34,030
(ふたり) え？

400
00:18:34,113 --> 00:18:35,031
(しょくぱんまん) え？

401
00:18:35,114 --> 00:18:36,032
(カレーパンマン) きえて？

402
00:18:36,825 --> 00:18:38,576
(アンパンマンたち) ああ…

403
00:18:39,577 --> 00:18:40,787
(ニャニイ) ママ？

404
00:18:43,998 --> 00:18:46,417
(メロンパンナ)
わかったわ ジャムおじさん

405
00:18:46,835 --> 00:18:48,670
でも なんにちか まって

406
00:18:49,170 --> 00:18:52,882
もうすこし… ほんとうに
もうすこしだけでいいから――

407
00:18:52,966 --> 00:18:54,801
ニャニイと いっしょにいたいの

408
00:18:54,884 --> 00:18:56,177
(ジャム) うーん

409
00:18:56,678 --> 00:18:57,846
(アンパンマンたち) ええ？

410
00:18:57,929 --> 00:19:00,765
(ジャム) ニャニイちゃんを かえすには
アンパンマンごうで――

411
00:19:00,849 --> 00:19:04,727
ゆめねこのくにまで
とんでいかなければ ならないんだ

412
00:19:05,603 --> 00:19:10,358
それができるのは ドリームすいせいが
いちばん ちかづいているとき――

413
00:19:10,441 --> 00:19:11,943
こんやだけなんだよ

414
00:19:12,026 --> 00:19:12,986
(アンパンマンたち) ええ～っ

415
00:19:13,069 --> 00:19:14,153
(クリームパンダ) こんや？

416
00:19:16,114 --> 00:19:17,574
メロンパンナちゃん

417
00:19:17,657 --> 00:19:21,578
(メロンパンナ) あ… あ… ああ…

418
00:19:22,871 --> 00:19:24,330
(ばいきんまん) ゆめのくに？

419
00:19:24,706 --> 00:19:26,541
(ドキン) そうよ　ゆめのくに

420
00:19:26,624 --> 00:19:28,501
ひかりのつぶとか たまごとか――

421
00:19:28,585 --> 00:19:31,170
ネムネムのきとかが あるらしいの

422
00:19:31,254 --> 00:19:33,089
(ホラーマン)
その ネムネムのみを たべると――

423
00:19:33,172 --> 00:19:35,300
とくべつのゆめが かなうとかなんとか

424
00:19:35,383 --> 00:19:36,843
(ばいきんまん) ゆめが かなう？

425
00:19:36,926 --> 00:19:37,802
(ドキン) うん
(ホラーマン) ホラ

426
00:19:38,303 --> 00:19:40,930
おれさま そのくにの
おうさまになって…

427
00:19:42,891 --> 00:19:45,310
ハヒフヘホ～！

428
00:19:46,436 --> 00:19:47,270
ああっ！

429
00:19:47,604 --> 00:19:48,938
(ばいきんまん) はっ！
(アンパンマン) ギャッ！

430
00:19:49,606 --> 00:19:53,693
(ばいきんまん) アンパンマンを
コテンパンのギタギタにしてやるのだ

431
00:19:54,360 --> 00:19:57,196
(ドキン) あたしは
あの こねこを てにいれて…

432
00:20:00,742 --> 00:20:02,785
しょくぱんまんさまと――

433
00:20:02,869 --> 00:20:04,829
ハッピーラブラブ

434
00:20:06,289 --> 00:20:08,958
(ホラーマン)
ホラーマンのゆめは ただひとつ

435
00:20:12,754 --> 00:20:13,963
ホラ～

436
00:20:14,339 --> 00:20:17,717
ドキンちゃんと
ハッピーラブラブなんですね～

437
00:20:18,384 --> 00:20:20,803
よーし！
いくぞ ゆめのくに

438
00:20:20,887 --> 00:20:21,888
(３にん) おう！

439
00:20:34,943 --> 00:20:36,319
(ジャム) さっ おおいそぎで――

440
00:20:36,402 --> 00:20:38,863
アンパンマンごうの
しゅっぱつのじゅんびをするよ

441
00:20:38,947 --> 00:20:39,781
(バタコたち) はい！

442
00:20:43,493 --> 00:20:46,371
(ジャム) えいっ うん うんっ

443
00:20:48,122 --> 00:20:49,457
(メロンパンナ) ジャムおじさん

444
00:20:49,540 --> 00:20:51,209
お？ ん？

445
00:20:51,876 --> 00:20:53,169
(ニャニイ) ニャーン

446
00:20:53,711 --> 00:20:55,838
あのね あたし――

447
00:20:55,922 --> 00:20:58,466
ニャニイと
おさんぽに いってきたいんだけど

448
00:20:58,925 --> 00:21:01,010
(ジャム) うん　いっておいで

449
00:21:01,094 --> 00:21:03,262
(バタコ) ゆうがた までには
かえってらっしゃいね

450
00:21:03,346 --> 00:21:04,430
(メロンパンナ) はい

451
00:21:04,514 --> 00:21:05,598
いこう ニャニイ

452
00:21:05,682 --> 00:21:09,352
(ニャニイ) ワーイ
おさんぽ おさんぽ

453
00:21:09,435 --> 00:21:13,106
ママ ニャニイ
おさんぽ おさんぽ～

454
00:21:13,189 --> 00:21:14,107
(クリームパンダ) おねえちゃん

455
00:21:14,190 --> 00:21:15,108
(チーズ) ク～ン

456
00:21:15,191 --> 00:21:16,818
(３にん) う～ん…

457
00:21:19,612 --> 00:21:22,407
(ニャニイ) ニャンニャニャ
ニャニャニャニャ♪

458
00:21:22,490 --> 00:21:24,951
ニャニャニャニャ ニャン♪

459
00:21:25,326 --> 00:21:28,329
ニャンニャン ニャニャニャニャ♪

460
00:21:28,413 --> 00:21:30,456
ニャニャニャ ニャン♪

461
00:21:31,124 --> 00:21:34,085
ニャニャニャニャ ニャン ニャン♪

462
00:21:34,168 --> 00:21:36,713
ニャニャニャニャニャー♪

463
00:21:37,088 --> 00:21:42,427
ニャー ニャニャニャン
ニャー ニャニャニャ♪

464
00:21:42,969 --> 00:21:48,266
ニャー ニャニャニャン
ニャー ニャン ニャン♪

465
00:21:48,850 --> 00:21:51,102
ン？ ママ？

466
00:21:52,186 --> 00:21:55,982
(メロンパンナ) <ずーっと ずーっと
いっしょって おもってたのに>

467
00:21:56,065 --> 00:21:57,483
<きょうで…>

468
00:21:57,567 --> 00:21:59,736
<きょうで さよならなんて…>

469
00:22:00,945 --> 00:22:02,655
(ニャニイ) ン？ ママ？

470
00:22:04,741 --> 00:22:05,575
ン？

471
00:22:06,868 --> 00:22:07,785
ペロッ

472
00:22:07,869 --> 00:22:08,870
(メロンパンナ) ん？

473
00:22:09,954 --> 00:22:12,040
(ニャニイ) ペロッ ペロッ

474
00:22:15,043 --> 00:22:17,962
(メロンパンナ) やだ
やだやだ さよなら なんて

475
00:22:18,046 --> 00:22:19,839
さよなら なんて…

476
00:22:20,173 --> 00:22:21,090
ン？

477
00:22:21,549 --> 00:22:22,592
ハッ

478
00:22:22,675 --> 00:22:25,219
(メロンパンナ) <ジャムおじさんは
あんなこと いってたけど――>

479
00:22:25,303 --> 00:22:27,638
<ニャニイは こんなに
げんきなんだもん>

480
00:22:27,930 --> 00:22:30,099
<このまま
なんにも おこらないかも…>

481
00:22:36,314 --> 00:22:38,691
<そうよ
パンこうじょうに かえるのやめて――>

482
00:22:38,775 --> 00:22:41,402
<くらやみだにで ニャニイと
ロールパンナおねえちゃんと――>

483
00:22:41,486 --> 00:22:42,528
<３にん いっしょに…>

484
00:22:49,118 --> 00:22:51,329
(ニャニイ) ニャン？ ニャー

485
00:22:53,581 --> 00:22:55,917
ニャー ママ～

486
00:22:58,127 --> 00:22:59,420
ママ～

487
00:23:00,129 --> 00:23:01,464
ママ

488
00:23:02,423 --> 00:23:03,925
(ニャニイ) ママ！
(メロンパンナ) ハッ！

489
00:23:04,967 --> 00:23:06,052
(メロンパンナ) あっ…

490
00:23:06,135 --> 00:23:08,137
あ… あたし…

491
00:23:08,805 --> 00:23:10,181
なんてことを

492
00:23:10,848 --> 00:23:12,892
ママ？ ママ

493
00:23:13,309 --> 00:23:15,436
うっ ニャニイ

494
00:23:15,812 --> 00:23:19,107
うっ うっ… あたし あたし――

495
00:23:19,190 --> 00:23:20,942
どうすれば いいの？

496
00:23:22,568 --> 00:23:23,778
(ロールパンナ) メロンパンナ？

497
00:23:23,861 --> 00:23:24,695
(メロンパンナ) あっ

498
00:23:25,279 --> 00:23:26,864
ロールパンナおねえちゃん！

499
00:23:27,740 --> 00:23:29,325
(メロンパンナ) うう…
(ニャニイ) ニャ？

500
00:23:29,408 --> 00:23:30,535
(メロンパンナ) ううっ

501
00:23:31,119 --> 00:23:32,537
うわああ！

502
00:23:32,620 --> 00:23:33,788
(ロールパンナ) あっ

503
00:23:33,871 --> 00:23:36,624
(メロンパンナ) うわあ～ん

504
00:23:36,707 --> 00:23:39,085
うわあ～ん

505
00:23:40,128 --> 00:23:41,629
(アンパンマン) メロンパンナちゃーん

506
00:23:41,712 --> 00:23:43,923
(しょくぱんまん)
メロンパンナちゃ～ん

507
00:23:44,799 --> 00:23:46,259
(カレーパンマン) おかしいな～

508
00:23:46,342 --> 00:23:47,927
(アンパンマン)
どこに いっちゃったんだろう

509
00:23:48,427 --> 00:23:50,555
(しょくぱんまん)
メロンパンナちゃーん

510
00:23:50,638 --> 00:23:52,932
(３にん) メロンパンナちゃーん

511
00:23:53,015 --> 00:23:54,934
(ニャニイ) ニャ？ ニャン ニャッ

512
00:23:56,102 --> 00:23:56,936
ニャンニャン

513
00:23:57,019 --> 00:24:00,231
(ロールパンナ) そうか
ニャニイを ゆめねこのくにに…

514
00:24:00,314 --> 00:24:02,900
(メロンパンナ) うん
でも あたし イヤなの

515
00:24:02,984 --> 00:24:05,862
ずーっと ずーっと
ニャニイといっしょに いたいの

516
00:24:05,945 --> 00:24:08,447
(ニャニイ)
ニャンニャン ニャーン

517
00:24:08,739 --> 00:24:10,074
(ロールパンナ)
いっしょに いなくても――

518
00:24:10,158 --> 00:24:12,076
こころは いっしょにいられる

519
00:24:12,160 --> 00:24:13,119
(メロンパンナ) え？

520
00:24:13,619 --> 00:24:15,246
(ロールパンナ) わたしは そうだ

521
00:24:15,329 --> 00:24:17,456
メロンパンナと はなればなれでも――

522
00:24:17,999 --> 00:24:19,000
ここに

523
00:24:19,417 --> 00:24:21,961
ここに いつもメロンパンナがいる

524
00:24:22,044 --> 00:24:23,212
あ…

525
00:24:24,005 --> 00:24:25,381
(ロールパンナ) だから――

526
00:24:25,798 --> 00:24:27,717
わたしは さみしくない

527
00:24:29,051 --> 00:24:30,469
おねえちゃん

528
00:24:35,057 --> 00:24:37,476
(アンパンマン) メロンパンナちゃーん

529
00:24:37,768 --> 00:24:40,271
メロンパンナちゃーん

530
00:24:41,022 --> 00:24:41,856
ん？

531
00:24:47,486 --> 00:24:49,739
(ロールパンナ) このよに
うまれてくるものは――

532
00:24:49,822 --> 00:24:52,033
みんな なにか やくめをもっている

533
00:24:52,116 --> 00:24:53,409
(メロンパンナ) やくめ？

534
00:24:53,492 --> 00:24:56,871
(ロールパンナ) なにをするために
うまれてきたか ということだ

535
00:24:56,954 --> 00:24:58,080
(メロンパンナ) うん

536
00:25:00,124 --> 00:25:03,169
(ロールパンナ) わたしは まだ
じぶんのやくめが わからない

537
00:25:03,836 --> 00:25:05,004
(メロンパンナ) あ…

538
00:25:05,087 --> 00:25:07,924
(ロールパンナ) でもニャニイは…
ニャニイには――

539
00:25:08,007 --> 00:25:11,260
きっと ゆめねこのくにに
たいせつなやくめが あるんだ

540
00:25:11,344 --> 00:25:12,762
(メロンパンナ)
たいせつな やくめ？

541
00:25:13,471 --> 00:25:15,848
(ロールパンナ) だからこそ
ゆめのなかのこえは――

542
00:25:15,932 --> 00:25:18,017
いっしょうけんめい
ニャニイをよんでいるんだ

543
00:25:18,100 --> 00:25:20,061
(ニャニイ) ニャーン ニャッ！

544
00:25:20,144 --> 00:25:22,563
(メロンパンナ)
ニャニイに たいせつな やくめが…

545
00:25:22,647 --> 00:25:25,650
(ロールパンナ) ああ
そのやくめを はたすことが――

546
00:25:25,733 --> 00:25:27,360
ニャニイの しあわせだ

547
00:25:28,069 --> 00:25:29,779
ニャニイのしあわせ

548
00:25:31,989 --> 00:25:34,200
(ジャム) そのこは まだ
ちいさい あかちゃんだから――

549
00:25:34,283 --> 00:25:35,618
しっかり せわをして――

550
00:25:35,701 --> 00:25:38,037
たいせつに まもってあげないと
いけないよ

551
00:25:38,412 --> 00:25:40,289
それが できるかい？

552
00:25:40,373 --> 00:25:41,290
(メロンパンナ) はい

553
00:25:41,707 --> 00:25:42,875
うーん

554
00:25:42,959 --> 00:25:44,919
それじゃ そだててあげなさい

555
00:25:45,002 --> 00:25:47,380
メロンパンナちゃんが
そのこの ママになって――

556
00:25:47,463 --> 00:25:49,715
しあわせにして あげるんだよ

557
00:25:49,799 --> 00:25:50,925
(メロンパンナ) ママ？

558
00:25:51,342 --> 00:25:53,344
ママ？ はい！

559
00:25:55,054 --> 00:25:57,640
(メロンパンナ)
<そうだね そうだよね>

560
00:25:57,723 --> 00:25:59,183
(ニャニイ) ニャッ ニャッ…

561
00:25:59,267 --> 00:26:01,852
(メロンパンナ)
<あたしは ニャニイのママなんだから>

562
00:26:02,228 --> 00:26:04,146
<ニャニイのしあわせを>

563
00:26:04,230 --> 00:26:05,940
<ニャニイのしあわせを…>

564
00:26:06,023 --> 00:26:08,484
(ニャニイ) ニャーン ニャンニャン

565
00:26:08,567 --> 00:26:09,568
ニャニイ！

566
00:26:09,652 --> 00:26:12,029
(ニャニイ) ニャーン　ニャン

567
00:26:12,113 --> 00:26:13,406
(メロンパンナ) かえろう ニャニイ

568
00:26:13,489 --> 00:26:14,323
ニャーン

569
00:26:15,074 --> 00:26:16,158
みんなが まってる

570
00:26:16,242 --> 00:26:17,118
(ニャニイ) ニャーン

571
00:26:17,201 --> 00:26:19,829
(ニャニイ) ワーイ
(メロンパンナ) ウフフッ ウフフフッ

572
00:26:21,163 --> 00:26:22,873
(メロンパンナ)
ありがとう おねえちゃん

573
00:26:22,957 --> 00:26:26,877
あのね あたしのここにも
いつも おねえちゃんがいるの

574
00:26:26,961 --> 00:26:30,715
だから おねえちゃんが
いってくれたこと よくわかったの

575
00:26:30,798 --> 00:26:32,967
(ロールパンナ) これからは
ニャニイも ここにいる

576
00:26:33,426 --> 00:26:34,427
(メロンパンナ) うん！

577
00:26:35,011 --> 00:26:36,137
(ロールパンナ) うん

578
00:26:44,895 --> 00:26:45,730
(ロールパンナ) あ？

579
00:26:45,813 --> 00:26:47,064
(メロンパンナ･ニャニイ) あ？

580
00:26:47,148 --> 00:26:48,524
(ニャニイ) ニャ？

581
00:26:48,607 --> 00:26:49,734
ニャン！

582
00:26:51,319 --> 00:26:53,738
ウッ！ ニャウウウウ～

583
00:26:54,113 --> 00:26:56,240
(ロールパンナ･メロンパンナ) あっ
(ニャニイ) ウウウウ～…

584
00:26:56,324 --> 00:26:58,743
(メロンパンナ) ニャニイ
どうしたの？ ニャニイ！

585
00:26:59,160 --> 00:26:59,994
あっ！

586
00:27:01,495 --> 00:27:02,997
(ジャム) ゆめねこの あかちゃんは――

587
00:27:03,080 --> 00:27:05,207
ネムネムのきのみを たべないと――

588
00:27:05,291 --> 00:27:09,170
いつか ひかりのつぶになって
きえてしまうそうなんだ

589
00:27:09,879 --> 00:27:11,756
(ニャニイ) ニャー…
(メロンパンナ) あっ

590
00:27:12,340 --> 00:27:14,508
(メロンパンナ) ニャニイ ニャニイ！

591
00:27:14,592 --> 00:27:15,468
(アンパンマン) メロンパンナちゃん！

592
00:27:15,551 --> 00:27:16,886
(ロールパンナ･メロンパンナ) あ…

593
00:27:17,928 --> 00:27:19,013
アンパンマン！

594
00:27:19,096 --> 00:27:21,015
いこう！ パンこうじょうへ

595
00:27:22,141 --> 00:27:23,017
(メロンパンナ) うん！

596
00:27:23,434 --> 00:27:25,269
(ロールパンナ)
たのんだぞ アンパンマン

597
00:27:25,353 --> 00:27:26,812
(アンパンマン) まかせて！

598
00:27:29,690 --> 00:27:31,025
(ロールパンナ) メロンパンナ…

599
00:27:31,400 --> 00:27:33,235
(アンパンマン)
しっかり つかまっているんだよ

600
00:27:33,319 --> 00:27:34,487
(メロンパンナ) うん！

601
00:27:42,745 --> 00:27:44,663
(アンパンマン) ジャムおじさーん！

602
00:27:50,044 --> 00:27:51,170
(ジャム) んん

603
00:27:51,462 --> 00:27:53,756
(ジャム)
バタコ　びょうよみスタート！

604
00:27:53,839 --> 00:27:54,673
(バタコ) はい！

605
00:27:55,758 --> 00:27:57,676
テン ナイン――

606
00:27:57,760 --> 00:28:04,683
エイト セブン シックス
ファイブ フォー スリー トゥー――

607
00:28:04,767 --> 00:28:06,769
ワン ゼロ！

608
00:28:15,778 --> 00:28:18,447
アンパンマンごう はっしん！

609
00:28:25,538 --> 00:28:30,209
(みんな) うう～

610
00:28:33,212 --> 00:28:35,381
(ジャム) チーズ
ほじょロケット きりはなし

611
00:28:35,464 --> 00:28:36,966
メインロケット てんか！

612
00:28:37,049 --> 00:28:37,883
(チーズ) アンアン

613
00:28:45,975 --> 00:28:47,935
(ニャニイ) ニャ～ン
(メロンパンナ) ニャニイ しっかりして

614
00:28:48,018 --> 00:28:48,978
ニャニイ！

615
00:28:49,061 --> 00:28:50,438
ママ～

616
00:28:52,398 --> 00:28:54,984
(メロンパンナ)
<ごめん　ごめんね ニャニイ>

617
00:28:55,067 --> 00:28:57,403
<あたしの わがままのせいで>

618
00:29:02,700 --> 00:29:03,534
アンアン

619
00:29:03,617 --> 00:29:05,161
(チーズ) アン！ アン！ アアン
(アンパンマン) ああっ！

620
00:29:05,578 --> 00:29:06,454
(カレーパンマン) みえたぜ

621
00:29:06,537 --> 00:29:07,913
(しょくぱんまん)
ドリームすいせいです

622
00:29:07,997 --> 00:29:10,249
(ジャム) よーし　みんな いくよ！

623
00:29:10,332 --> 00:29:11,167
(バタコたち) はい！

624
00:29:11,709 --> 00:29:13,127
(ジャム) ぜんそく ぜんしん！

625
00:29:13,210 --> 00:29:15,671
ドリームすいせいに とつにゅう！

626
00:29:34,773 --> 00:29:36,484
(みんな) わああっ ううっ…

627
00:29:39,862 --> 00:29:40,696
ん？

628
00:29:44,617 --> 00:29:45,451
(みんな) うわっ！

629
00:30:01,634 --> 00:30:03,469
(カレーパンマン) な… なんだ こりゃ

630
00:30:03,886 --> 00:30:06,722
(バタコ) ゆめでみたときは
こんなんじゃなかったのに

631
00:30:06,805 --> 00:30:08,307
(ニャニイ) ニャー
(メロンパンナ) ああ…

632
00:30:12,895 --> 00:30:14,230
(ゆめねこたち) ニャー？

633
00:30:14,313 --> 00:30:15,981
ニャー ニャー

634
00:30:16,065 --> 00:30:19,151
♪ ニャニイ ニャニイ

635
00:30:19,235 --> 00:30:23,155
♪ ニャニイ ニャニイ

636
00:30:23,614 --> 00:30:29,537
♪ かえってきたの ニャニイ

637
00:30:30,120 --> 00:30:34,166
♪ はやく はやく

638
00:30:34,250 --> 00:30:35,751
(ニャニイ) ハニャッ
(メロンパンナ) ニャニイ

639
00:30:36,669 --> 00:30:37,878
(ジャム) みんな いそいで――

640
00:30:37,962 --> 00:30:39,630
ネムネムのみを あつめてきておくれ

641
00:30:39,713 --> 00:30:40,756
(アンパンマンたち) はい！

642
00:30:43,592 --> 00:30:45,386
(４にん) ああっ！

643
00:30:45,886 --> 00:30:47,304
(しょくぱんまん) これは いったい…

644
00:30:47,388 --> 00:30:49,223
(カレーパンマン)
みなんか ぜんぜんないぜ

645
00:30:50,266 --> 00:30:51,934
どうしてだろう？

646
00:30:52,017 --> 00:30:55,938
このまえ みたときは
あんなに いっぱい あったのに

647
00:30:56,897 --> 00:30:58,732
(カレーパンマン) あっ あった！

648
00:31:00,484 --> 00:31:02,278
(すいこむ おと)

649
00:31:03,821 --> 00:31:05,197
(４にん) うっ… うわあっ

650
00:31:10,077 --> 00:31:11,287
(ゆめねこたち) ニャー
(クリームパンダ) うわあ～

651
00:31:11,370 --> 00:31:12,454
(ジャム) んん？
(チーズ) クーン？

652
00:31:14,790 --> 00:31:15,749
(アンパンマンたち) ええいっ

653
00:31:15,833 --> 00:31:17,209
(ゆめねこたち) ニャーン！

654
00:31:17,293 --> 00:31:19,003
(あしおと)
(アンパンマンたち) ううっ

655
00:31:19,878 --> 00:31:22,673
(ばいきんまん) ハヒフヘホ～

656
00:31:23,340 --> 00:31:24,717
(ジャム) そのこえは…

657
00:31:24,800 --> 00:31:25,759
(アンパンマンたち) ばいきんまん！

658
00:31:25,843 --> 00:31:28,053
(ドキン) ドキンちゃんも いまーす！

659
00:31:28,137 --> 00:31:30,306
(ホラーマン) ホラーマンも いまーす

660
00:31:30,389 --> 00:31:31,890
(ばいきんまん)
ネムネムのきのみは ぜーんぶ――

661
00:31:31,974 --> 00:31:34,518
この ばいきんまんさまが
いただくのだ

662
00:31:34,852 --> 00:31:35,978
(カレーパンマン) なんだって？

663
00:31:36,061 --> 00:31:37,563
(しょくぱんまん)
どうして そんなことを

664
00:31:37,646 --> 00:31:39,064
(ばいきんまん) きまってんだろ？

665
00:31:39,148 --> 00:31:42,276
ネムネムのみを いっぱいたべて
ゆめを かなえるためさ！

666
00:31:42,359 --> 00:31:43,193
(みんな) ええ？

667
00:31:43,277 --> 00:31:44,945
(クリームパンダ) ゆめを かなえる？

668
00:31:45,029 --> 00:31:47,072
(ばいきんまん) そうとも！
おれさまのゆめは――

669
00:31:47,156 --> 00:31:49,825
この ゆめのくにの
つよーい おうさまになって――

670
00:31:49,908 --> 00:31:51,785
アンパンマンをやっつけること！

671
00:31:52,286 --> 00:31:55,873
ウフッ あたしのゆめは
ハッピーラブラブ～

672
00:31:55,956 --> 00:31:58,792
(ホラーマン)
そう　ドキンちゃんと あたしで
ハッピーラブラブ

673
00:31:58,876 --> 00:32:00,085
(なぐる おと)
(ホラーマン) ギャッハー

674
00:32:00,169 --> 00:32:01,295
(ドキン) おバカ！ ラブラブは――

675
00:32:01,378 --> 00:32:03,631
しょくぱんまんさまとに
きまってるでしょ！

676
00:32:03,714 --> 00:32:04,548
ああ

677
00:32:05,007 --> 00:32:06,717
いやん はずかしい

678
00:32:06,800 --> 00:32:09,553
しょくぱんまんさまの まえで
いっちゃった～

679
00:32:09,928 --> 00:32:12,473
(アンパンマン) ちがうんだ！
ばいきんまんもドキンちゃんも！

680
00:32:12,556 --> 00:32:14,350
(クリームパンダ) ここは
ゆめのくにじゃなくて――

681
00:32:14,433 --> 00:32:15,559
ゆめねこのくにだよ！

682
00:32:15,976 --> 00:32:18,812
(バタコ) ネムネムのみをたべても
ゆめは かなわないわ！

683
00:32:18,896 --> 00:32:20,064
(チーズ) アン！ アンアン

684
00:32:20,147 --> 00:32:23,275
(ジャム) それに ネムネムのきを
むやみにきずつけると――

685
00:32:23,359 --> 00:32:26,236
ムーマという
おそろしい かいぶつが めざめると――

686
00:32:26,320 --> 00:32:27,404
ここに かいてあるんだ

687
00:32:27,488 --> 00:32:28,322
(メロンパンナたち) ああ？

688
00:32:28,739 --> 00:32:29,948
かいぶつ？

689
00:32:30,032 --> 00:32:31,325
(アンパンマン) ムーマ？

690
00:32:31,700 --> 00:32:32,993
(ばいきんまん) ナーハッハッ

691
00:32:33,077 --> 00:32:35,663
そんなこと だれが しんじるか

692
00:32:37,039 --> 00:32:39,208
(みんなの せきこむ こえ)

693
00:32:39,500 --> 00:32:40,876
よーし！

694
00:32:41,502 --> 00:32:43,379
いくぞ バクバクロボ！

695
00:32:43,462 --> 00:32:45,714
(バクバクロボ) バクー！

696
00:32:46,382 --> 00:32:50,052
ネムネムのみを ひとつのこらず
あつめるのだ～！

697
00:32:50,135 --> 00:32:53,514
(バクバクロボ) バーク バク～

698
00:32:54,682 --> 00:32:56,058
バク～

699
00:32:56,141 --> 00:32:59,019
(カレーパンマン) うわあ！
ネムネムのみが…

700
00:32:59,103 --> 00:33:01,105
(アンパンマン) ぼくたちが
ばいきんまんをとめる！

701
00:33:01,480 --> 00:33:03,315
そのあいだに
メロンパンナちゃんたちは――

702
00:33:03,399 --> 00:33:05,693
のこってるネムネムのみを
さがすんだ！

703
00:33:05,776 --> 00:33:06,860
(メロンパンナ･クリームパンダ)
はい！

704
00:33:07,903 --> 00:33:09,154
(ジャム) バタコ チーズ――

705
00:33:09,238 --> 00:33:11,573
わたしたちも
アンパンマンごうで いくよ！

706
00:33:11,657 --> 00:33:12,741
(バタコたち) はい！

707
00:33:16,328 --> 00:33:17,162
(バクバクロボ) バックー！

708
00:33:17,246 --> 00:33:18,455
(カレーパンマン) まちやがれ！

709
00:33:20,708 --> 00:33:23,585
(ばいきんまん)
きたな～　おじゃまむしめ

710
00:33:23,961 --> 00:33:27,256
(バクバクロボ) クウー バクー！

711
00:33:27,339 --> 00:33:28,465
(しょくぱんまん) ええい！

712
00:33:29,341 --> 00:33:30,217
(ふたり) うあっ！

713
00:33:32,511 --> 00:33:35,264
(ばいきんまん) まて このー この！

714
00:33:35,514 --> 00:33:36,557
(アンパンマン) えい！

715
00:33:37,808 --> 00:33:39,518
(しょくぱんまん) イチ ニイの…

716
00:33:39,601 --> 00:33:40,686
(３にん) サン！
(ばいきんまん) どおっ！

717
00:33:40,769 --> 00:33:42,604
(ばいきんまん) おーっとっとっとー

718
00:33:44,857 --> 00:33:45,691
(クリームパンダ) いまだよ！

719
00:33:45,774 --> 00:33:46,817
(メロンパンナ) うん！

720
00:33:49,903 --> 00:33:52,698
(ばいきんまん) んー！ くっ
(３にん) んんん～

721
00:33:53,031 --> 00:33:55,159
このー！

722
00:33:55,242 --> 00:33:57,494
(ドキン) ちょっと
じかん かかりそうね～

723
00:33:57,578 --> 00:33:58,746
(ホラーマン) ですね

724
00:33:58,829 --> 00:34:01,039
じゃあ あたしたちは おさきに

725
00:34:01,373 --> 00:34:02,708
(ドキン) いっただきまーす

726
00:34:02,791 --> 00:34:04,251
(ホラーマン) あぐあぐあぐ…
(ドキン) んんんん…

727
00:34:04,334 --> 00:34:06,962
コラーッ！ ずるいぞ～！

728
00:34:07,045 --> 00:34:08,881
(３にん) あぐあぐあぐ…

729
00:34:09,381 --> 00:34:10,632
(ジャム) いくよ チーズ

730
00:34:10,716 --> 00:34:11,633
(チーズ) アン アンアン！

731
00:34:11,884 --> 00:34:14,136
ノーズパンチ はっしゃ！

732
00:34:15,345 --> 00:34:16,680
(ばいきんまんたち) どわっ！

733
00:34:17,431 --> 00:34:19,099
(アンパンマンたち) そーれっ

734
00:34:19,683 --> 00:34:21,310
(ばいきんまんたち) だはあ～

735
00:34:21,393 --> 00:34:23,061
な… なにを～

736
00:34:26,106 --> 00:34:28,358
(ばいきんまんたち) どわああ～！

737
00:34:28,776 --> 00:34:29,860
(アンパンマンたち) あああっ！

738
00:34:29,943 --> 00:34:32,446
(バクバクロボ) バクバクバクウ～！

739
00:34:32,738 --> 00:34:34,281
(アンパンマン) ああっ あぶなーい！

740
00:34:34,364 --> 00:34:35,199
(クリームパンダ･メロンパンナ) あっ！

741
00:34:36,366 --> 00:34:37,367
(クリームパンダ) えいっ

742
00:34:38,702 --> 00:34:41,163
(ばいきんまんたち)
うわあ！ あああ…

743
00:34:41,413 --> 00:34:42,539
(バクバクロボ) バクバクバク～！

744
00:34:44,416 --> 00:34:48,212
(ジャム) いかん！ このままでは
ネムネムの はやしが…

745
00:34:48,629 --> 00:34:49,963
(カレーパンマン) とまれー！

746
00:34:50,047 --> 00:34:51,340
(アンパンマンたち) ああ あっ

747
00:34:51,423 --> 00:34:53,050
(ジャム) ノーズパンチ！

748
00:34:56,011 --> 00:34:57,387
(ばいきんまん) ああ～
(ホラーマン) ホラ～ ホラ～…

749
00:34:57,721 --> 00:34:59,765
(バクバクロボ) バクバク～ クク～

750
00:35:09,858 --> 00:35:11,443
(クリームパンダ･メロンパンナ) ああっ

751
00:35:14,404 --> 00:35:15,572
(３にん) うわあっ

752
00:35:24,540 --> 00:35:25,457
(チーズ) ク～ン
(ジャム) んんー

753
00:35:40,180 --> 00:35:41,723
(３にん) うわああ…

754
00:35:43,392 --> 00:35:44,601
(メロンパンナ) うう…
(クリームパンダ) あっ！

755
00:35:49,690 --> 00:35:50,941
こ… これは

756
00:35:51,024 --> 00:35:52,025
(チーズ) アーン

757
00:35:52,442 --> 00:35:53,694
ジャムおじさん あれ！

758
00:36:08,959 --> 00:36:14,172
(ムーマ) ムー…

759
00:36:14,256 --> 00:36:16,925
マー！

760
00:36:17,009 --> 00:36:17,926
(ニャニイ･メロンパンナ) ああっ

761
00:36:18,010 --> 00:36:18,886
(３にん) うわあっ

762
00:36:18,969 --> 00:36:20,137
(ジャムたち) ああ…

763
00:36:20,220 --> 00:36:22,848
(ジャム) とうとうムーマが
めざめてしまった

764
00:36:24,266 --> 00:36:27,185
(ばいきんまん) おおっ
ほんとに いたのか～

765
00:36:27,436 --> 00:36:29,104
(ドキン) うえっ ぶきみ～

766
00:36:29,187 --> 00:36:33,692
(ホラーマン) イヤですね
まっ こわいですね ホラーですね～

767
00:36:34,234 --> 00:36:35,777
(ニャニイ) あ… あああ～

768
00:36:35,861 --> 00:36:36,695
ニャニイ

769
00:36:38,488 --> 00:36:39,573
(ムーマ) ん？

770
00:36:39,656 --> 00:36:40,699
ん？

771
00:36:41,325 --> 00:36:45,787
(ニャニイ) ニャウウン…

772
00:36:46,830 --> 00:36:48,624
ムーマー！

773
00:36:48,707 --> 00:36:49,917
(メロンパンナ) あっ

774
00:36:50,000 --> 00:36:53,086
(ジャム) いかん
ムーマのねらいは ニャニイちゃんだ！

775
00:36:54,254 --> 00:36:56,298
(ムーマ) ムーマ～

776
00:36:56,381 --> 00:36:58,216
(クリームパンダ) あぶない！
(メロンパンナ) うわっ

777
00:36:58,759 --> 00:37:01,345
ムーマー！

778
00:37:01,428 --> 00:37:02,554
(メロンパンナたち) あっ

779
00:37:03,764 --> 00:37:04,598
(ムーマ) ムー！

780
00:37:04,681 --> 00:37:05,724
(メロンパンナ) あっ

781
00:37:06,224 --> 00:37:07,309
(ムーマ) ムー！
(メロンパンナ) わあっ！

782
00:37:07,392 --> 00:37:08,936
(カレーパンマン) やめろー！

783
00:37:09,019 --> 00:37:09,978
(ムーマ) ムー！

784
00:37:10,062 --> 00:37:11,563
アンパーンチ！

785
00:37:11,647 --> 00:37:12,689
(ムーマ) ムムッ

786
00:37:13,690 --> 00:37:15,108
しょくパーンチ

787
00:37:15,192 --> 00:37:16,568
(カレーパンマン) カレーパンチ

788
00:37:16,652 --> 00:37:18,320
(ムーマ) ムマムマ

789
00:37:18,779 --> 00:37:20,364
(しょくぱんまん) んっ パンチ！

790
00:37:20,447 --> 00:37:21,490
(カレーパンマン) ええい！

791
00:37:21,782 --> 00:37:22,866
(ムーマ) ムマ

792
00:37:23,492 --> 00:37:26,662
ムーマアア！

793
00:37:29,623 --> 00:37:31,500
(カレーパンマン) ええい やったぜ

794
00:37:31,833 --> 00:37:32,876
ああ！ あっ！

795
00:37:34,836 --> 00:37:36,129
ムー！

796
00:37:36,213 --> 00:37:37,589
(ふたり) うわあっ

797
00:37:38,382 --> 00:37:40,550
うっ！ うわっ

798
00:37:40,634 --> 00:37:42,469
(アンパンマン) だああ！
(メロンパンナたち) ああっ

799
00:37:42,552 --> 00:37:43,470
(ジャムたち) うわっ

800
00:37:43,553 --> 00:37:45,764
(しょくぱんまん) ね… ねこに

801
00:37:45,847 --> 00:37:48,308
(カレーパンマン)
ニャッちまった ニャッ…

802
00:37:48,392 --> 00:37:51,436
(ドキン) ああ しょくぱんまんさま
なんて おすがたに…

803
00:37:51,520 --> 00:37:52,354
(ばいきんまん) あら～？

804
00:37:52,437 --> 00:37:54,481
(ドキン) でも ちょっと かわいい～

805
00:37:54,564 --> 00:37:55,482
(ばいきんまん･ホラーマン) ガクッ！

806
00:37:55,565 --> 00:37:57,609
(メロンパンナ)
しょくぱんまん カレーパンマン

807
00:37:57,693 --> 00:37:58,652
(ニャニイ) ニャウン…

808
00:37:58,735 --> 00:37:59,861
(メロンパンナ) ああ

809
00:38:00,904 --> 00:38:03,907
(ジャム) ここは いいから
ふたりは はやく ネムネムのみを！

810
00:38:03,991 --> 00:38:05,325
(メロンパンナ) うん！
(クリームパンダ) うん！

811
00:38:05,909 --> 00:38:08,328
(ジャム) ノーズパンチ はっしゃ！
(チーズ) クー！

812
00:38:09,746 --> 00:38:11,081
ンーハッ

813
00:38:12,791 --> 00:38:14,626
ムーマ！

814
00:38:15,127 --> 00:38:16,253
(ジャムたち) うわっ

815
00:38:18,672 --> 00:38:20,465
(ジャムたち) んニャ～…

816
00:38:20,841 --> 00:38:23,969
(ばいきんまん) ナーッハハハッ
ジャムジャムーマ

817
00:38:24,636 --> 00:38:25,554
(ばいきんまん) きにいったぞ

818
00:38:25,637 --> 00:38:27,180
おまえを おれさまの
だいいちの けらいに…

819
00:38:27,264 --> 00:38:28,265
(ムーマ) ムーマ

820
00:38:28,348 --> 00:38:29,433
(ばいきんまん) あああ～

821
00:38:30,392 --> 00:38:32,060
(バクバクロボ) バッフンニャ～

822
00:38:34,104 --> 00:38:34,980
(ばいきんまん) ニャー

823
00:38:35,063 --> 00:38:37,607
ニャンで おれさま まで～ うっ！

824
00:38:37,691 --> 00:38:39,276
(ドキン) こんニャの ひどーい

825
00:38:39,359 --> 00:38:41,695
あっ！ でも
しょくぱんまんさまと おなじで――

826
00:38:41,778 --> 00:38:43,405
ちょっと うれしいかも～

827
00:38:43,488 --> 00:38:44,865
(ホラーマン) ニャハー
(ドキン) げっ

828
00:38:44,948 --> 00:38:48,243
(ホラーマン) ドキンちゃんと
おなじで かなり うれしいニャハー

829
00:38:49,202 --> 00:38:50,746
アンパーンチ！

830
00:38:50,829 --> 00:38:51,913
(ムーマ) ムーマ！

831
00:38:52,497 --> 00:38:54,249
アンキーック！

832
00:38:54,332 --> 00:38:55,250
(ムーマ) ムーマ！

833
00:38:55,876 --> 00:38:57,961
ムーマ ムーマ！

834
00:38:58,045 --> 00:39:00,630
だあっ　ふっ！ ふっ！

835
00:39:01,298 --> 00:39:02,299
(ムーマ) ンンッ

836
00:39:02,424 --> 00:39:04,634
(しょくぱんまん･カレーパンマン)
ニャッ ニャッ ニャッ

837
00:39:04,718 --> 00:39:05,844
(しょくぱんまん) ねこになっても

838
00:39:05,927 --> 00:39:07,387
(カレーパンマン)
あきらめないニャいね

839
00:39:07,471 --> 00:39:09,514
(しょくぱんまんたち)
ニャッ ニャニャニャニャッ

840
00:39:09,598 --> 00:39:11,516
(ムーマ) ムーマ！
(しょくぱんまんたち) うああ～！

841
00:39:12,184 --> 00:39:14,644
(クリームパンダ)
ネムネムのみ！ ネムネムのみ！

842
00:39:14,728 --> 00:39:15,645
(メロンパンナ) あっ

843
00:39:15,729 --> 00:39:16,605
(クリームパンダ) ああっ

844
00:39:18,523 --> 00:39:19,399
あった！

845
00:39:19,858 --> 00:39:21,902
(ムーマ) ムーマー！

846
00:39:22,194 --> 00:39:23,278
あぶなーい！

847
00:39:23,779 --> 00:39:24,613
(メロンパンナたち) あっ

848
00:39:25,197 --> 00:39:27,407
(アンパンマン)
うわああ！ あわわ～！

849
00:39:28,200 --> 00:39:29,659
ニャー！

850
00:39:30,035 --> 00:39:31,328
(メロンパンナたち) アンパンマン！

851
00:39:31,661 --> 00:39:32,954
(アンパンマン)
ぼくは だいじょうぶ！

852
00:39:33,038 --> 00:39:35,123
ふたりは はやくネムネムのみを！

853
00:39:35,582 --> 00:39:37,876
(ジャム) いかん
あたらしい かおを やくんニャ

854
00:39:37,959 --> 00:39:39,377
(バタコ) はいニャ
(チーズ) ニャン

855
00:39:39,461 --> 00:39:40,545
ムーマ

856
00:39:40,629 --> 00:39:41,880
ムー！

857
00:39:41,963 --> 00:39:46,468
(ムーマ) ムー！ ムー！
(メロンパンナたち) えいっ やあっ

858
00:39:47,135 --> 00:39:51,098
(アンパンマンたち)
ニャッ ニャッ ニャッ ニャッ

859
00:39:54,726 --> 00:39:56,019
(３にん) せーの！

860
00:39:56,103 --> 00:39:57,771
ニャニャニャニャッ！

861
00:39:57,854 --> 00:40:00,774
(ムーマ) ウウッ エエッ ムーマ～！

862
00:40:00,857 --> 00:40:01,817
(クリームパンダ) いまのうちだよ！

863
00:40:01,900 --> 00:40:02,818
(メロンパンナ) うん！

864
00:40:08,490 --> 00:40:09,658
(ムーマのパンチの おと)
(アンパンマンたち) うわーっ！

865
00:40:09,741 --> 00:40:10,784
あっ！

866
00:40:13,453 --> 00:40:14,287
ムー！

867
00:40:14,371 --> 00:40:15,831
(クリームパンダ) あぶなーい！
(メロンパンナ) うわっ

868
00:40:16,581 --> 00:40:18,083
(メロンパンナ･クリームパンダ)
うわあ！

869
00:40:19,417 --> 00:40:20,919
クリームパンダちゃん！

870
00:40:21,294 --> 00:40:22,796
(クリームパンダ) ニャア！ ニャー…

871
00:40:22,879 --> 00:40:23,713
(チーズ) ニャア？

872
00:40:24,464 --> 00:40:26,216
ニャッニャア ニャッニャッ

873
00:40:26,299 --> 00:40:27,134
(ふたり) ニャッ？

874
00:40:27,217 --> 00:40:28,885
(バタコ)
クリームパンダちゃんも ねこに？

875
00:40:28,969 --> 00:40:30,428
いそごう！ バタコ

876
00:40:30,512 --> 00:40:33,723
(バタコ) はいニャ
でも ねこのてって つかいづらいニャ

877
00:40:33,807 --> 00:40:36,601
(ジャム･バタコ) んっ ニャニャニャ

878
00:40:36,685 --> 00:40:38,436
(メロンパンナ) えっ うえっ…

879
00:40:39,354 --> 00:40:40,188
(ムーマ) ムーマ！

880
00:40:40,272 --> 00:40:42,190
ああっ うっ… うあっ！

881
00:40:42,357 --> 00:40:43,775
マントが…

882
00:40:44,609 --> 00:40:45,527
うわあ ハア ハア…

883
00:40:45,610 --> 00:40:47,028
(ムーマ) ムーマ～

884
00:40:47,112 --> 00:40:48,446
(アンパンマンたち)
ニャッ ニャッ ニャッ！

885
00:40:49,489 --> 00:40:51,199
(ムーマ) ムーマー！

886
00:40:51,283 --> 00:40:52,200
(アンパンマンたち) ニャッ！

887
00:40:53,118 --> 00:40:54,119
(ニャニイ) あっ ママ！

888
00:40:54,202 --> 00:40:55,036
(メロンパンナ) ハア ハア…

889
00:40:55,537 --> 00:40:56,705
ああっ！

890
00:41:01,251 --> 00:41:03,461
(ムーマ) ムーマ！
(メロンパンナ) うわあっ

891
00:41:05,714 --> 00:41:09,759
ムーマ ムーマ ムーマ

892
00:41:09,843 --> 00:41:11,386
ムーマ～

893
00:41:11,469 --> 00:41:12,888
ムーマ…

894
00:41:12,971 --> 00:41:16,391
(ニャニイ) う… うわああん！

895
00:41:16,725 --> 00:41:17,934
ニャニイ

896
00:41:18,476 --> 00:41:20,312
(ムーマ) ムーマ！
(クリームパンダ) おねえちゃん

897
00:41:20,395 --> 00:41:21,396
(アンパンマン) ニャニイちゃん

898
00:41:21,479 --> 00:41:25,775
ムーマ～ ムーマ～

899
00:41:25,859 --> 00:41:26,818
(ニャニイ) うわ～ん

900
00:41:26,902 --> 00:41:28,445
(ムーマ) ム～マ～

901
00:41:28,528 --> 00:41:29,738
(ニャニイ) うわああん

902
00:41:29,821 --> 00:41:31,364
うわああん うわああん

903
00:41:31,448 --> 00:41:32,782
(メロンパンナ) なかないで ニャニイ

904
00:41:32,866 --> 00:41:34,534
なかないで

905
00:41:34,618 --> 00:41:37,370
ママが ママがいっしょよ

906
00:41:37,454 --> 00:41:41,333
(ニャニイ) うわああん うわああん

907
00:41:41,416 --> 00:41:47,631
(メロンパンナ)
♪ ねんねん ねむりのねむり姫

908
00:41:47,714 --> 00:41:53,011
♪ ねんねん ねむりの夢の中

909
00:41:53,553 --> 00:41:58,683
♪ どんな夢でも こわくない

910
00:41:59,726 --> 00:42:04,981
♪ なかないで なかないで

911
00:42:05,315 --> 00:42:10,654
♪ あなたのそばには

912
00:42:11,071 --> 00:42:16,701
♪ ママが いつもいるの

913
00:42:16,785 --> 00:42:21,873
♪ ママが あなたをまもる

914
00:42:22,499 --> 00:42:28,088
♪ ママが あなたをまもる

915
00:42:28,171 --> 00:42:29,547
ニャウン…

916
00:42:33,343 --> 00:42:35,303
(ムーマ) ムーマ！

917
00:42:39,224 --> 00:42:41,351
(メロンパンナ) うわああーっ！

918
00:42:41,434 --> 00:42:43,144
メロンパンナちゃん！

919
00:42:43,603 --> 00:42:48,316
ああーっ！

920
00:43:19,306 --> 00:43:22,183
(ニャニイ) ママ
ニャニイ まもってくれた

921
00:43:22,267 --> 00:43:23,184
ああっ

922
00:43:23,768 --> 00:43:26,313
ニャニイ つよくなる

923
00:43:26,396 --> 00:43:28,189
ママを まもる

924
00:43:28,648 --> 00:43:29,816
あっ ああ…

925
00:43:33,028 --> 00:43:34,529
ム～マ～

926
00:43:34,612 --> 00:43:35,697
(４にん) あっ

927
00:43:35,780 --> 00:43:36,698
(３にん) ああっ

928
00:43:36,781 --> 00:43:37,824
(ジャムたち) ああ？

929
00:43:49,044 --> 00:43:49,961
(ニャニイ) ふっ！

930
00:43:50,045 --> 00:43:51,713
ム？ ムー

931
00:43:51,796 --> 00:43:54,591
(ニャニイ) ふっ！ ふっ！

932
00:43:54,674 --> 00:43:55,550
ニャニイ？

933
00:43:55,633 --> 00:43:56,509
ママ

934
00:43:56,593 --> 00:43:58,595
アンパンマンたちと いっしょにいて

935
00:43:59,012 --> 00:43:59,846
うん！

936
00:44:00,513 --> 00:44:02,015
(アンパンマンたち) ニャー
(メロンパンナ) あっ

937
00:44:04,726 --> 00:44:06,644
いくぞ！ ムーマ！

938
00:44:07,354 --> 00:44:08,355
ムー！

939
00:44:08,438 --> 00:44:09,689
(ニャニイ) はっ！

940
00:44:10,231 --> 00:44:11,358
(ムーマ) ムーマ！

941
00:44:11,441 --> 00:44:12,525
(ニャニイ) ふっ！

942
00:44:13,485 --> 00:44:15,445
(ニャニイ) ふっ ふっ！

943
00:44:15,528 --> 00:44:16,988
(ムーマ) ムーマ！

944
00:44:17,072 --> 00:44:17,989
(ニャニイ) ふっ！

945
00:44:18,990 --> 00:44:19,824
いまだ！

946
00:44:23,578 --> 00:44:26,081
(ジャム) アンパンマン
あたらしい かおだよ

947
00:44:26,623 --> 00:44:28,249
ム～？

948
00:44:29,167 --> 00:44:31,211
ムーマー！

949
00:44:32,796 --> 00:44:35,507
(ジャムたち) うわああーっ

950
00:44:35,882 --> 00:44:36,716
(みんな) あっ！

951
00:44:37,092 --> 00:44:37,967
(ニャニイ) あっ

952
00:44:38,051 --> 00:44:39,260
(くちぶえ)

953
00:44:39,344 --> 00:44:40,887
(ゆめねこたち) ニャー ニャー

954
00:44:40,970 --> 00:44:44,849
ニャー ニャオー

955
00:44:44,933 --> 00:44:46,142
(ゆめねこたち) ニャー
(ジャム) あああ～

956
00:44:48,395 --> 00:44:49,354
(ホラーマン) ホラッ

957
00:44:49,437 --> 00:44:50,522
(ドキン) ニャオッ

958
00:44:51,189 --> 00:44:52,273
(ばいきんまん) グウニャオ～

959
00:44:57,570 --> 00:44:58,905
げんき100ばい

960
00:45:00,073 --> 00:45:01,533
アンパンマン！

961
00:45:02,033 --> 00:45:03,618
いこう ニャニイちゃん

962
00:45:03,701 --> 00:45:04,869
(ニャニイ) うん！

963
00:45:05,245 --> 00:45:07,414
(ムーマ) ムーマー

964
00:45:07,497 --> 00:45:10,834
(ふたり) ふっ えいっ　ふっ

965
00:45:10,917 --> 00:45:12,252
(ムーマ) ムー

966
00:45:12,335 --> 00:45:13,628
ムーマ！

967
00:45:13,920 --> 00:45:15,505
こっちだ　ムーマ！

968
00:45:16,756 --> 00:45:18,550
(ムーマ) ムウ～ ウッ！

969
00:45:19,134 --> 00:45:22,387
ウウ～…

970
00:45:22,846 --> 00:45:24,889
よーし！ えいっ

971
00:45:25,390 --> 00:45:29,269
ウウ～ ムーマ～

972
00:45:29,352 --> 00:45:31,020
(アンパンマン) えいっ！

973
00:45:31,104 --> 00:45:32,313
(ニャニイ) ふっ！ ふっ！

974
00:45:33,106 --> 00:45:34,065
(ムーマ) ムー！

975
00:45:34,149 --> 00:45:35,191
(ニャニイ) ふっ！

976
00:45:35,275 --> 00:45:37,318
(ムーマ) ムー！ ムー！
(アンパンマン) えいっ んっ

977
00:45:37,944 --> 00:45:39,279
(４にん) がんばれ～！

978
00:45:39,612 --> 00:45:41,072
(ジャムたち) アンパンマーン！

979
00:45:41,156 --> 00:45:43,032
(ばいきんまんたち) ンニャ ンニャッ

980
00:45:44,284 --> 00:45:46,661
エイッ ムーマ！

981
00:45:46,744 --> 00:45:47,954
(ニャニイ) ふっ！

982
00:45:49,622 --> 00:45:51,583
ええいっ！ えいっ！

983
00:45:52,167 --> 00:45:53,168
ウアッ！

984
00:45:54,002 --> 00:45:55,879
ムウ～…

985
00:45:55,962 --> 00:45:59,841
ムーマア～ アアア～！

986
00:46:00,467 --> 00:46:02,469
にがすものか～！

987
00:46:02,552 --> 00:46:03,428
はっ！

988
00:46:06,264 --> 00:46:09,642
(ムーマ) ムウ～マアア！

989
00:46:10,268 --> 00:46:11,102
いまだよ！

990
00:46:11,186 --> 00:46:12,145
(アンパンマン) うん！

991
00:46:15,023 --> 00:46:17,442
ア～ンパ～ンチ！

992
00:46:25,366 --> 00:46:26,201
ああっ

993
00:46:26,493 --> 00:46:27,827
(４にん) ああ…

994
00:46:28,161 --> 00:46:29,621
(ジャムたち) ああ？

995
00:46:29,704 --> 00:46:31,122
(ばいきんまんたち) ああ…

996
00:46:46,179 --> 00:46:48,097
(３にん) ああ　アハハッ

997
00:46:48,556 --> 00:46:50,558
(ジャムたち) ああ ああっ！

998
00:46:50,642 --> 00:46:52,018
(ゆめねこたち) ニャー

999
00:46:52,101 --> 00:46:53,394
(ばいきんまんたち) うわあ

1000
00:46:53,478 --> 00:46:54,812
(メロンパンナ) アハハッ

1001
00:46:54,896 --> 00:46:56,022
うわあ

1002
00:47:02,904 --> 00:47:03,696
ママ

1003
00:47:04,405 --> 00:47:05,657
(メロンパンナ) ニャニイ？

1004
00:47:06,074 --> 00:47:07,575
ニャニイ！

1005
00:47:08,535 --> 00:47:10,119
(カレーパンマン) びっくりしたな～

1006
00:47:10,203 --> 00:47:12,830
(しょくぱんまん) ニャニイちゃんが
おひめさまだったとは

1007
00:47:12,914 --> 00:47:14,374
(アンパンマン)
ニャニイちゃんの やくめは――

1008
00:47:14,457 --> 00:47:17,418
この ゆめねこのくにを
まもること だったんですね

1009
00:47:17,502 --> 00:47:20,255
でも ネムネムのみを
たべなかったのに――

1010
00:47:20,338 --> 00:47:22,340
どうして きえなかったんだろう

1011
00:47:22,423 --> 00:47:24,968
(ジャム) それは きっと
メロンパンナちゃんの おかげだよ

1012
00:47:25,051 --> 00:47:25,885
(クリームパンダ) え？

1013
00:47:26,177 --> 00:47:28,930
(ジャム) メロンパンナちゃんの
いっしょうけんめいな きもちが――

1014
00:47:29,013 --> 00:47:31,558
ネムネムのみの かわりをしたんだよ

1015
00:47:31,641 --> 00:47:32,809
(ジャム) メロンパンナちゃん――

1016
00:47:32,892 --> 00:47:35,395
ほんとうの おかあさんみたいに
がんばったものね

1017
00:47:35,478 --> 00:47:36,563
(チーズ) アンアン

1018
00:47:36,646 --> 00:47:37,647
(クリームパンダ) そうか

1019
00:47:37,730 --> 00:47:38,606
(しょくぱんまん) でも…

1020
00:47:38,690 --> 00:47:39,816
(カレーパンマン) ああ

1021
00:47:39,899 --> 00:47:40,984
(アンパンマン) うん

1022
00:47:41,067 --> 00:47:43,361
(クリームパンダ)
おわかれしなきゃ ならないんだね

1023
00:47:45,822 --> 00:47:47,073
(チーズ) ク～ン…

1024
00:47:51,661 --> 00:47:53,830
(メロンパンナ)
おわかれだね ニャニイ

1025
00:47:53,913 --> 00:47:54,789
(ニャニイ) うん

1026
00:47:54,872 --> 00:47:57,584
(メロンパンナ) もう あえないんだね

1027
00:47:57,667 --> 00:47:58,501
(ニャニイ) うん

1028
00:47:58,585 --> 00:48:00,003
(メロンパンナ) いいこで いるのよ

1029
00:48:00,086 --> 00:48:00,920
(ニャニイ) うん

1030
00:48:01,004 --> 00:48:03,464
(メロンパンナ) うん じゃなくて
はい でしょ

1031
00:48:03,548 --> 00:48:04,757
(ニャニイ) はい

1032
00:48:04,841 --> 00:48:08,428
(メロンパンナ) ネムネムのみは
よくかんで ゆっくりたべるのよ

1033
00:48:08,511 --> 00:48:09,345
(ニャニイ) はい

1034
00:48:09,429 --> 00:48:10,805
(メロンパンナ)
こまってるひとがいたら――

1035
00:48:10,888 --> 00:48:12,557
たすけてあげるのよ

1036
00:48:12,640 --> 00:48:13,474
(ニャニイ) はい

1037
00:48:13,933 --> 00:48:16,394
(メロンパンナ)
それから それから…

1038
00:48:16,477 --> 00:48:17,478
うう…

1039
00:48:18,187 --> 00:48:19,647
な… なかないよ

1040
00:48:19,731 --> 00:48:22,525
だって あたし
ニャニイのママなんだから

1041
00:48:22,609 --> 00:48:25,653
おかあさんなんだから
とっても うれしいんだもん

1042
00:48:26,571 --> 00:48:29,032
ニャニイが…
ちっちゃなニャニイが――

1043
00:48:29,115 --> 00:48:31,701
こんな りっぱな
おひめさまになって…

1044
00:48:32,160 --> 00:48:33,953
ニャニイも なかないよ

1045
00:48:34,037 --> 00:48:35,455
ママに そだててもらって――

1046
00:48:35,538 --> 00:48:37,415
とっても しあわせだったから

1047
00:48:37,498 --> 00:48:39,250
だから だから…

1048
00:48:39,334 --> 00:48:40,627
(きてきの おと)

1049
00:48:40,918 --> 00:48:41,753
(メロンパンナ) あ…
(ニャニイ) ん？

1050
00:48:42,587 --> 00:48:44,339
(きてきの おと)

1051
00:48:45,048 --> 00:48:46,341
(ニャニイ) しゅっぱつの じかん？

1052
00:48:46,424 --> 00:48:47,258
(メロンパンナ) うん

1053
00:48:47,800 --> 00:48:48,968
じゃあね

1054
00:48:49,052 --> 00:48:51,012
さよならニャニイ　げんきでね

1055
00:48:51,387 --> 00:48:52,889
さよなら ママ

1056
00:48:52,972 --> 00:48:53,890
(メロンパンナ) うん！

1057
00:49:11,908 --> 00:49:14,118
あっ おねえちゃーん！

1058
00:49:14,202 --> 00:49:16,037
(ジャム) クリームパンダちゃん
(クリームパンダ) あっ

1059
00:49:17,121 --> 00:49:19,374
(ジャム) ううん ううん

1060
00:49:19,707 --> 00:49:20,541
(クリームパンダ) ああ…

1061
00:49:23,878 --> 00:49:26,297
ニャニイ　ニャニイ

1062
00:49:27,590 --> 00:49:28,800
(ニャニイ) うっ うう…

1063
00:49:29,175 --> 00:49:30,385
ママ…

1064
00:49:30,760 --> 00:49:31,928
ママ

1065
00:49:32,762 --> 00:49:34,013
ママー！

1066
00:49:34,097 --> 00:49:35,682
ニャニイ！ ああっ

1067
00:49:38,601 --> 00:49:40,478
(ふたり) ああ…

1068
00:49:41,145 --> 00:49:42,313
ありがとう ママ

1069
00:49:42,855 --> 00:49:44,190
ニャニイは――

1070
00:49:44,273 --> 00:49:46,818
ニャニイは
ママに あえて よかった

1071
00:49:47,151 --> 00:49:48,069
あたしも…

1072
00:49:48,152 --> 00:49:50,571
あたしも ほんとうに よかった

1073
00:49:50,655 --> 00:49:51,739
ニャニイに…

1074
00:49:51,823 --> 00:49:53,074
ニャニイに あえて

1075
00:50:05,712 --> 00:50:12,719
♪～

1076
00:51:17,408 --> 00:51:24,415
～♪

