Dialogue: 1,0:00:31.21,0:00:31.96,DefaultSingle-J,,0,0,0,,		Here　you　go.
Dialogue: 1,0:00:32.21,0:00:32.72,DefaultSingle-J,,0,0,0,,		Thank　you!
Dialogue: 1,0:01:07.45,0:01:10.55,DefaultSingle-J,,0,0,0,,		人目があれば　あなたは妙なマネはできないでしょ
Dialogue: 1,0:01:10.81,0:01:12.52,DefaultSingle-J,,0,0,0,,		ずいぶんな言い草だな
Dialogue: 1,0:01:12.52,0:01:14.89,DefaultSingle-J,,0,0,0,,		まるで僕が君を狙っているみたいだ
Dialogue: 1,0:01:15.43,0:01:16.18,DefaultSingle-J,,0,0,0,,		違うの
Dialogue: 1,0:01:16.90,0:01:20.01,DefaultSingle-J,,0,0,0,,		君とは友人としていい関係が築けていたと
Dialogue: 1,0:01:20.43,0:01:22.04,DefaultSingle-J,,0,0,0,,		余計なおしゃべりはナシよ
Dialogue: 1,0:01:22.82,0:01:25.49,DefaultSingle-J,,0,0,0,,		私の提案に対する返事だけを聞かせて
Dialogue: 1,0:01:26.07,0:01:28.05,DefaultSingle-J,,0,0,0,,		イエス　それともノー
Dialogue: 1,0:01:33.82,0:01:35.07,DefaultSingle-J,,0,0,0,,		返事をする前に
Dialogue: 1,0:01:35.32,0:01:37.96,DefaultSingle-J,,0,0,0,,		君が注文した品を当ててみせよう
Dialogue: 1,0:01:38.97,0:01:41.01,DefaultSingle-J,,0,0,0,,		アイスティー　なんかじゃない
Dialogue: 1,0:01:41.25,0:01:42.25,DefaultSingle-J,,0,0,0,,		シャンパーニユ
Dialogue: 1,0:01:42.52,0:01:44.87,DefaultSingle-J,,0,0,0,,		いやワインだ　赤ではなく白
Dialogue: 1,0:01:45.83,0:01:46.91,DefaultSingle-J,,0,0,0,,		よく冷えたムルソー
Dialogue: 1,0:01:49.44,0:01:51.85,DefaultSingle-J,,0,0,0,,		ど　どうして分かったの
Dialogue: 1,0:01:52.64,0:01:54.60,DefaultSingle-J,,0,0,0,,		君の心を読んだのさ
Dialogue: 1,0:01:55.34,0:01:56.19,DefaultSingle-J,,0,0,0,,		いらないわ
Dialogue: 1,0:01:59.92,0:02:00.56,DefaultSingle-J,,0,0,0,,		ああ　ちょっと
Dialogue: 1,0:02:02.22,0:02:02.92,DefaultSingle-J,,0,0,0,,		何
Dialogue: 1,0:02:03.67,0:02:04.97,DefaultSingle-J,,0,0,0,,		答えはノーだ
Dialogue: 1,0:02:30.92,0:02:32.04,DefaultSingle-J,,0,0,0,,		First　floor!
Dialogue: 1,0:04:39.40,0:04:40.38,DefaultSingle-J,,0,0,0,,		日本語で話そう
Dialogue: 1,0:04:40.70,0:04:41.18,DefaultSingle-J,,0,0,0,,		はい
Dialogue: 1,0:04:42.41,0:04:45.54,DefaultSingle-J,,0,0,0,,		今は民間の予備警察官として働いているんだって
Dialogue: 1,0:04:45.87,0:04:47.07,DefaultSingle-J,,0,0,0,,		出世したじゃないか
Dialogue: 1,0:04:47.23,0:04:51.17,DefaultSingle-J,,0,0,0,,		教官として犯罪行動心理学をたたき込んでくださった
Dialogue: 1,0:04:51.17,0:04:52.81,DefaultSingle-J,,0,0,0,,		レオン先生のおかげです
Dialogue: 1,0:04:53.15,0:04:54.92,DefaultSingle-J,,0,0,0,,		先生だなんてよしてくれ
Dialogue: 1,0:04:55.25,0:04:56.56,DefaultSingle-J,,0,0,0,,		今は民間人さ
Dialogue: 1,0:04:57.04,0:05:00.56,DefaultSingle-J,,0,0,0,,		それにしても　犯人は爆弾まで用意していたとはな
Dialogue: 1,0:05:01.12,0:05:05.00,DefaultSingle-J,,0,0,0,,		爆破された車は被害者シェリリン・タンさんのものでした
Dialogue: 1,0:05:05.30,0:05:07.55,DefaultSingle-J,,0,0,0,,		彼女は優秀な弁護士だったから
Dialogue: 1,0:05:07.87,0:05:09.54,DefaultSingle-J,,0,0,0,,		恨まれることもあっただろうし
Dialogue: 1,0:05:10.16,0:05:11.64,DefaultSingle-J,,0,0,0,,		危険な相手との付き合いも
Dialogue: 1,0:05:46.04,0:05:46.67,DefaultSingle-J,,0,0,0,,		What　the...
Dialogue: 1,0:05:47.33,0:05:48.17,DefaultSingle-J,,0,0,0,,		It’s　blood!
Dialogue: 1,0:05:48.17,0:05:49.09,DefaultSingle-J,,0,0,0,,		Oh　my　God...
Dialogue: 1,0:05:57.14,0:05:57.84,DefaultSingle-J,,0,0,0,,		ダメよ
Dialogue: 1,0:05:59.08,0:06:00.28,DefaultSingle-J,,0,0,0,,		そこをなんとか
Dialogue: 1,0:06:01.30,0:06:02.59,DefaultSingle-J,,0,0,0,,		ダメったらダメ
Dialogue: 1,0:06:02.59,0:06:03.18,DefaultSingle-J,,0,0,0,,		頼む
Dialogue: 1,0:06:03.35,0:06:05.05,DefaultSingle-J,,0,0,0,,		どうしたんじゃ　2人とも
Dialogue: 1,0:06:05.25,0:06:08.65,DefaultSingle-J,,0,0,0,,		また例の薬を使って元の姿に戻りたいって
Dialogue: 1,0:06:08.98,0:06:10.66,DefaultSingle-J,,0,0,0,,		修学旅行の時だって
Dialogue: 1,0:06:10.66,0:06:12.67,DefaultSingle-J,,0,0,0,,		大変な思いしたばっかりなのに
Dialogue: 1,0:06:12.83,0:06:15.22,DefaultSingle-J,,0,0,0,,		あん時だってなんとか乗り切れたんだ
Dialogue: 1,0:06:15.60,0:06:16.53,DefaultSingle-J,,0,0,0,,		だから大丈夫
Dialogue: 1,0:06:16.94,0:06:17.86,DefaultSingle-J,,0,0,0,,		薬をください
Dialogue: 1,0:06:18.16,0:06:19.41,DefaultSingle-J,,0,0,0,,		ダーメ
Dialogue: 1,0:06:20.97,0:06:22.98,DefaultSingle-J,,0,0,0,,		一体どこに行くつもりなんじゃ
Dialogue: 1,0:06:22.98,0:06:24.22,DefaultSingle-J,,0,0,0,,		シンガポール
Dialogue: 1,0:06:24.22,0:06:25.53,DefaultSingle-J,,0,0,0,,		博士　これさ
Dialogue: 1,0:06:25.68,0:06:27.94,DefaultSingle-J,,0,0,0,,		この大会にあの人が出るんだよ
Dialogue: 1,0:06:28.10,0:06:29.20,DefaultSingle-J,,0,0,0,,		400戦無敗の
Dialogue: 1,0:06:31.22,0:06:32.96,DefaultSingle-J,,0,0,0,,		京極真君か
Dialogue: 1,0:06:33.34,0:06:36.10,DefaultSingle-J,,0,0,0,,		その試合を園子が見に行くって言い出してさ
Dialogue: 1,0:06:36.40,0:06:38.68,DefaultSingle-J,,0,0,0,,		小五郎のおっちゃんや蘭も一緒にって
Dialogue: 1,0:06:38.88,0:06:40.16,DefaultSingle-J,,0,0,0,,		オレも誘われたけど
Dialogue: 1,0:06:40.71,0:06:42.96,DefaultSingle-J,,0,0,0,,		この姿のままじゃ出国できねぇし
Dialogue: 1,0:06:43.14,0:06:46.46,DefaultSingle-J,,0,0,0,,		そうじゃな　パスポートは新一のものだしのう
Dialogue: 1,0:06:46.81,0:06:48.74,DefaultSingle-J,,0,0,0,,		だから頼むよ　灰原
Dialogue: 1,0:06:48.74,0:06:49.77,DefaultSingle-J,,0,0,0,,		しつこい
Dialogue: 1,0:06:51.06,0:06:53.65,DefaultSingle-J,,0,0,0,,		今回ばかりはあきらめたほうが
Dialogue: 1,0:06:54.81,0:06:56.51,DefaultSingle-J,,0,0,0,,		行きたかったなぁ
Dialogue: 1,0:06:56.91,0:06:58.87,DefaultSingle-J,,0,0,0,,		そうガックリせんでも
Dialogue: 1,0:06:59.11,0:07:01.87,DefaultSingle-J,,0,0,0,,		ようし　気晴らしにここで一発
Dialogue: 1,0:07:01.87,0:07:03.61,DefaultSingle-J,,0,0,0,,		え　もうやんの
Dialogue: 1,0:07:03.61,0:07:06.86,DefaultSingle-J,,0,0,0,,		アジア～ン　クイズです
Dialogue: 1,0:07:06.86,0:07:11.15,DefaultSingle-J,,0,0,0,,		シンガポールで一番人気のある催しはなんでしょうか
Dialogue: 1,0:07:11.15,0:07:12.97,DefaultSingle-J,,0,0,0,,		1　国歌斉唱
Dialogue: 1,0:07:13.34,0:07:15.35,DefaultSingle-J,,0,0,0,,		2　旧正月のお祝い
Dialogue: 1,0:07:15.75,0:07:17.52,DefaultSingle-J,,0,0,0,,		3　国旗掲揚
Dialogue: 1,0:07:18.11,0:07:20.62,DefaultSingle-J,,0,0,0,,		4　マリーナベイ花火大会
Dialogue: 1,0:07:21.92,0:07:23.49,DefaultSingle-J,,0,0,0,,		何　そのカッコ
Dialogue: 1,0:07:23.69,0:07:24.84,DefaultSingle-J,,0,0,0,,		答えは簡単
Dialogue: 1,0:07:25.05,0:07:27.14,DefaultSingle-J,,0,0,0,,		3番の国旗掲揚だろ
Dialogue: 1,0:07:27.14,0:07:29.27,DefaultSingle-J,,0,0,0,,		なんたって芯がポールだから
Dialogue: 1,0:07:30.07,0:07:31.10,DefaultSingle-J,,0,0,0,,		正解じゃ
Dialogue: 1,0:07:31.28,0:07:32.64,DefaultSingle-J,,0,0,0,,		さすがじゃ
Dialogue: 1,0:07:32.77,0:07:34.62,DefaultSingle-J,,0,0,0,,		よし　ではもう1問
Dialogue: 1,0:07:34.62,0:07:35.65,DefaultSingle-J,,0,0,0,,		もういいよ
Dialogue: 1,0:07:37.98,0:07:40.84,DefaultSingle-J,,0,0,0,,		やっぱ子供たちがいないとさびしいな
Dialogue: 1,0:07:49.91,0:07:51.91,DefaultSingle-J,,0,0,0,,		ちぇっ　灰原のヤツ
Dialogue: 1,0:08:17.57,0:08:19.87,DefaultSingle-J,,0,0,0,,		蘭　あっ　蘭姉ちゃん
Dialogue: 1,0:08:20.05,0:08:23.35,DefaultSingle-J,,0,0,0,,		どうしたの　こんな所で
Dialogue: 1,0:08:25.42,0:08:27.75,DefaultSingle-J,,0,0,0,,		蘭　姉ちゃ
Dialogue: 1,0:08:28.28,0:08:31.33,DefaultSingle-J,,0,0,0,,		ずっと　待ってたんだよ
Dialogue: 1,0:08:39.77,0:08:40.64,DefaultSingle-J,,0,0,0,,		なんだ　ここ
Dialogue: 1,0:08:41.03,0:08:42.65,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	すっごい　おっきいね
Dialogue: 1,0:08:42.97,0:08:45.33,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	この水が数日前に真っ赤になったんだって
Dialogue: 1,0:08:42.04,0:08:44.39,DefaultSingle-J,,0,0,0,,		蘭の声　どこなんだ　ここは
Dialogue: 1,0:08:44.71,0:08:47.11,DefaultSingle-J,,0,0,0,,		何かに閉じ込められてる　くそ
Dialogue: 1,0:08:49.48,0:08:50.31,DefaultSingle-J,,0,0,0,,		よし　これで
Dialogue: 1,0:09:07.31,0:09:11.10,DefaultSingle-J,,0,0,0,,		マーライオン
Dialogue: 1,0:09:19.70,0:09:22.58,DefaultSingle-J,,0,0,0,,		シンガポールかよ
Dialogue: 1,0:09:43.94,0:09:46.13,DefaultSingle-J,,0,0,0,,		オレは高校生探偵　工藤新一
Dialogue: 1,0:09:46.52,0:09:50.05,DefaultSingle-J,,0,0,0,,		幼なじみで同級生の毛利蘭と遊園地に遊びに行って
Dialogue: 1,0:09:50.35,0:09:54.32,DefaultSingle-J,,0,0,0,,		黒ずくめの男のあやしげな取引現場を目撃した
Dialogue: 1,0:09:56.00,0:09:58.09,DefaultSingle-J,,0,0,0,,		取引を見るのに夢中になっていたオレは
Dialogue: 1,0:09:58.27,0:10:01.64,DefaultSingle-J,,0,0,0,,		背後から近づいてくるもう一人の仲間に気付かなかった
Dialogue: 1,0:10:04.44,0:10:06.84,DefaultSingle-J,,0,0,0,,		オレはその男に毒薬を飲まされ
Dialogue: 1,0:10:07.41,0:10:08.38,DefaultSingle-J,,0,0,0,,		目が覚めたら
Dialogue: 1,0:10:12.32,0:10:14.18,DefaultSingle-J,,0,0,0,,		体が縮んでしまっていた
Dialogue: 1,0:10:16.36,0:10:18.94,DefaultSingle-J,,0,0,0,,		工藤新一が生きているとヤツらにバレたら
Dialogue: 1,0:10:18.94,0:10:22.01,DefaultSingle-J,,0,0,0,,		また命を狙われ　周りの人間にも危害が及ぶ
Dialogue: 1,0:10:23.20,0:10:26.20,DefaultSingle-J,,0,0,0,,		阿笠博士の助言で正体を隠すことにしたオレは
Dialogue: 1,0:10:26.43,0:10:27.84,DefaultSingle-J,,0,0,0,,		蘭に名前を聞かれ
Dialogue: 1,0:10:28.26,0:10:30.89,DefaultSingle-J,,0,0,0,,		とっさに　江戸川コナンと名乗り
Dialogue: 1,0:10:31.19,0:10:32.94,DefaultSingle-J,,0,0,0,,		ヤツらの情報をつかむため
Dialogue: 1,0:10:33.10,0:10:36.12,DefaultSingle-J,,0,0,0,,		父親が探偵をやっている蘭の家に転がり込んだ
Dialogue: 1,0:10:38.72,0:10:41.21,DefaultSingle-J,,0,0,0,,		そんなオレの好敵手の一人がこの男
Dialogue: 1,0:10:41.74,0:10:42.70,DefaultSingle-J,,0,0,0,,		怪盗キッド
Dialogue: 1,0:10:43.45,0:10:46.41,DefaultSingle-J,,0,0,0,,		正体不明の怪盗で　変装の名人でもあり
Dialogue: 1,0:10:46.83,0:10:49.74,DefaultSingle-J,,0,0,0,,		なぜかオレの正体を知っている油断のならないヤツ
Dialogue: 1,0:10:50.15,0:10:52.04,DefaultSingle-J,,0,0,0,,		いつかオレの手で捕まえてやるぜ
Dialogue: 1,0:10:52.81,0:10:55.24,DefaultSingle-J,,0,0,0,,		そのキッドの好敵手　京極真
Dialogue: 1,0:10:55.59,0:10:59.29,DefaultSingle-J,,0,0,0,,		高校生でありながら　４００戦無敗を誇る空手の達人
Dialogue: 1,0:10:59.70,0:11:03.41,DefaultSingle-J,,0,0,0,,		なぜか　蘭の同級生で鈴木財閥のご令嬢である
Dialogue: 1,0:11:03.41,0:11:05.14,DefaultSingle-J,,0,0,0,,		鈴木園子にゾッコンらしい
Dialogue: 1,0:11:05.14,0:11:08.27,DefaultSingle-J,,0,0,0,,		何見てんのよ　早くいつものやんなさいよ
Dialogue: 1,0:11:09.89,0:11:11.86,DefaultSingle-J,,0,0,0,,		小さくなっても頭脳は同じ
Dialogue: 1,0:11:12.52,0:11:13.99,DefaultSingle-J,,0,0,0,,		迷宮なしの名探偵
Dialogue: 1,0:11:15.40,0:11:18.60,DefaultSingle-J,,0,0,0,,		真実はいつもひとつ
Dialogue: 1,0:11:25.73,0:11:26.76,DefaultSingle-J,,0,0,0,,		オレの手
Dialogue: 1,0:11:27.60,0:11:29.07,DefaultSingle-J,,0,0,0,,		博士の道具もない
Dialogue: 1,0:11:29.88,0:11:31.66,DefaultSingle-J,,0,0,0,,		そうだ　蘭がいたはず
Dialogue: 1,0:11:33.82,0:11:35.48,DefaultSingle-J,,0,0,0,,		待って　蘭姉ちゃん
Dialogue: 1,0:11:37.74,0:11:39.86,DefaultSingle-J,,0,0,0,,		あ　新一　こっちこっち
Dialogue: 1,0:11:40.82,0:11:41.83,DefaultSingle-J,,0,0,0,,		わりぃわりぃ
Dialogue: 1,0:11:42.31,0:11:43.46,DefaultSingle-J,,0,0,0,,		待たせちまったな
Dialogue: 1,0:11:44.02,0:11:46.77,DefaultSingle-J,,0,0,0,,		どこ行ってたのよ　捜したんだからね
Dialogue: 1,0:11:47.37,0:11:50.27,DefaultSingle-J,,0,0,0,,		暑いって言うから　おっちゃんを木陰に案内してたんだよ
Dialogue: 1,0:11:50.74,0:11:52.98,DefaultSingle-J,,0,0,0,,		へえ　ありがとう
Dialogue: 1,0:11:52.98,0:11:55.61,DefaultSingle-J,,0,0,0,,		もう　相変わらずねぇ　おじさま
Dialogue: 1,0:11:56.00,0:11:56.77,DefaultSingle-J,,0,0,0,,		おい　蘭
Dialogue: 1,0:11:57.24,0:11:58.78,DefaultSingle-J,,0,0,0,,		水買ってきてくんねぇか
Dialogue: 1,0:11:58.95,0:12:00.40,DefaultSingle-J,,0,0,0,,		しょうがないなぁ
Dialogue: 1,0:12:00.74,0:12:01.81,DefaultSingle-J,,0,0,0,,		ねぇ　一緒に行こう
Dialogue: 1,0:12:03.29,0:12:04.51,DefaultSingle-J,,0,0,0,,		ほら　早く
Dialogue: 1,0:12:04.50,0:12:05.29,DefaultSingle-J,,0,0,0,,		お　おう
Dialogue: 1,0:12:05.86,0:12:08.59,DefaultSingle-J,,0,0,0,,		何よもう　いい感じじゃない
Dialogue: 1,0:12:10.19,0:12:11.86,DefaultSingle-J,,0,0,0,,		あの野郎
Dialogue: 1,0:12:15.42,0:12:16.76,DefaultSingle-J,,0,0,0,,		生き返ったぜ
Dialogue: 1,0:12:17.35,0:12:19.30,DefaultSingle-J,,0,0,0,,		お父さん何首からぶら下げてるの
Dialogue: 1,0:12:19.52,0:12:22.99,DefaultSingle-J,,0,0,0,,		あ　これはこん中にパスポートを入れてんだよ
Dialogue: 1,0:12:23.16,0:12:26.42,DefaultSingle-J,,0,0,0,,		なくしたり盗られたりしないようにだな　いいだろ
Dialogue: 1,0:12:26.42,0:12:27.53,DefaultSingle-J,,0,0,0,,		もう　お父さん
Dialogue: 1,0:12:27.53,0:12:30.98,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	そんなことまでしなくても　シンガポールは安全なんだよ
Dialogue: 1,0:12:30.21,0:12:31.79,DefaultSingle-J,,0,0,0,,		よう　お目覚めか
Dialogue: 1,0:12:32.18,0:12:33.76,DefaultSingle-J,,0,0,0,,		やっぱり　てめぇ
Dialogue: 1,0:12:34.81,0:12:37.53,DefaultSingle-J,,0,0,0,,		ってか　お前どうやってスーツケースから出たんだ
Dialogue: 1,0:12:37.72,0:12:38.77,DefaultSingle-J,,0,0,0,,		こいつだよ
Dialogue: 1,0:12:39.14,0:12:41.06,DefaultSingle-J,,0,0,0,,		こいつの先端を差し込めば
Dialogue: 1,0:12:41.31,0:12:44.29,DefaultSingle-J,,0,0,0,,		中からでも案外簡単に開くんだぜ
Dialogue: 1,0:12:44.42,0:12:46.41,DefaultSingle-J,,0,0,0,,		ボールペンぐらい問題ないと思ったが
Dialogue: 1,0:12:46.41,0:12:47.94,DefaultSingle-J,,0,0,0,,		油断も隙もねぇな
Dialogue: 1,0:12:48.81,0:12:51.33,DefaultSingle-J,,0,0,0,,		それはこっちのセリフだ　怪盗キッド
Dialogue: 1,0:12:53.42,0:12:54.66,DefaultSingle-J,,0,0,0,,		おお　あったあった
Dialogue: 1,0:12:55.78,0:12:58.16,DefaultSingle-J,,0,0,0,,		それより　どういうつもりなんだ　オメー
Dialogue: 1,0:12:58.45,0:12:59.90,DefaultSingle-J,,0,0,0,,		お見通しのくせに
Dialogue: 1,0:13:00.81,0:13:01.67,DefaultSingle-J,,0,0,0,,		あれだよ
Dialogue: 1,0:13:06.45,0:13:07.74,DefaultSingle-J,,0,0,0,,		あれは園子の
Dialogue: 1,0:13:07.97,0:13:09.49,DefaultSingle-J,,0,0,0,,		19世紀末
Dialogue: 1,0:13:10.39,0:13:16.27,DefaultSingle-J,,0,0,0,,		海賊船と共にシンガポール近海に沈んだとされていた　伝説の秘宝
Dialogue: 1,0:13:17.37,0:13:20.97,DefaultSingle-J,,0,0,0,,		世界最大級のブルーサファイア　別名
Dialogue: 1,0:13:22.05,0:13:23.45,DefaultSingle-J,,0,0,0,,		紺青の拳
Dialogue: 1,0:13:25.73,0:13:29.61,DefaultSingle-J,,0,0,0,,		去年　ジョンハン・チェン氏が引き上げに成功したビッグジュエルだよ
Dialogue: 1,0:13:30.23,0:13:34.15,DefaultSingle-J,,0,0,0,,		ジョンハン・チェンといえば　シンガポールの実力者の一人だ
Dialogue: 1,0:13:34.15,0:13:37.38,DefaultSingle-J,,0,0,0,,		そう　そしてこのおっさんは武道が大好きでな
Dialogue: 1,0:13:37.92,0:13:39.93,DefaultSingle-J,,0,0,0,,		宝石をチャンピオンベルトに埋め込み
Dialogue: 1,0:13:39.93,0:13:42.81,DefaultSingle-J,,0,0,0,,		空手トーナメントの開催を決めちまった
Dialogue: 1,0:13:43.40,0:13:46.64,DefaultSingle-J,,0,0,0,,		伝説の宝石は優勝者の手にか
Dialogue: 1,0:13:47.16,0:13:48.78,DefaultSingle-J,,0,0,0,,		金持ちの道楽だな
Dialogue: 1,0:13:48.78,0:13:50.02,DefaultSingle-J,,0,0,0,,		そういうこと
Dialogue: 1,0:13:50.33,0:13:54.66,DefaultSingle-J,,0,0,0,,		トーナメントのどさくさに宝石だけ頂いちまおうって考えてたんだけど
Dialogue: 1,0:13:54.91,0:13:57.86,DefaultSingle-J,,0,0,0,,		キッドとして入国するわけにもいかないだろ
Dialogue: 1,0:13:58.19,0:13:59.84,DefaultSingle-J,,0,0,0,,		宝石狙うだけだったら
Dialogue: 1,0:14:00.78,0:14:02.81,DefaultSingle-J,,0,0,0,,		オレまで連れてくる必要ねぇだろ
Dialogue: 1,0:14:04.04,0:14:06.50,DefaultSingle-J,,0,0,0,,		今回はちょっとばかり特別でな
Dialogue: 1,0:14:06.96,0:14:09.24,DefaultSingle-J,,0,0,0,,		まぁ　事情はおいおい話してやるよ
Dialogue: 1,0:14:09.69,0:14:10.50,DefaultSingle-J,,0,0,0,,		テメー
Dialogue: 1,0:14:12.33,0:14:13.70,DefaultSingle-J,,0,0,0,,		あれ　新一
Dialogue: 1,0:14:14.25,0:14:15.58,DefaultSingle-J,,0,0,0,,		おっと　お呼びだ
Dialogue: 1,0:14:15.74,0:14:16.59,DefaultSingle-J,,0,0,0,,		待て　キッド
Dialogue: 1,0:14:17.54,0:14:20.29,DefaultSingle-J,,0,0,0,,		蘭に何かしたら　タダじゃ済まさねぇかんな
Dialogue: 1,0:14:21.44,0:14:24.69,DefaultSingle-J,,0,0,0,,		わ　悪いがそれは保証できねぇな
Dialogue: 1,0:14:24.69,0:14:27.36,DefaultSingle-J,,0,0,0,,		だったら今ここで　てめぇの正体バラしてやる
Dialogue: 1,0:14:27.60,0:14:29.26,DefaultSingle-J,,0,0,0,,		それはやめといたほうがいい
Dialogue: 1,0:14:30.98,0:14:35.19,DefaultSingle-J,,0,0,0,,		お前が入国できたのは　このスーツケースのおかげなんだぜ
Dialogue: 1,0:14:36.71,0:14:39.86,DefaultSingle-J,,0,0,0,,		手荷物検査のX線も通さない特別仕様
Dialogue: 1,0:14:40.21,0:14:43.86,DefaultSingle-J,,0,0,0,,		そして中には12時間はもつ酸素発生機と
Dialogue: 1,0:14:44.10,0:14:46.83,DefaultSingle-J,,0,0,0,,		長時間入っていても体が痛くならない
Dialogue: 1,0:14:46.83,0:14:49.65,DefaultSingle-J,,0,0,0,,		極上のクッションが詰め込まれた優れもの
Dialogue: 1,0:14:50.90,0:14:52.66,DefaultSingle-J,,0,0,0,,		この意味が分かるかな
Dialogue: 1,0:14:53.26,0:14:54.45,DefaultSingle-J,,0,0,0,,		名探偵
Dialogue: 1,0:14:54.98,0:14:56.35,DefaultSingle-J,,0,0,0,,		オレの助けがないと
Dialogue: 1,0:14:56.35,0:14:59.24,DefaultSingle-J,,0,0,0,,		パスポートもないお前はこの国を出られない
Dialogue: 1,0:14:59.47,0:15:01.71,DefaultSingle-J,,0,0,0,,		日本に帰れなくなるってことだ
Dialogue: 1,0:15:02.70,0:15:04.25,DefaultSingle-J,,0,0,0,,		いた　新一
Dialogue: 1,0:15:04.73,0:15:07.72,DefaultSingle-J,,0,0,0,,		もう　すぐどっかにいなくなっちゃうんだから
Dialogue: 1,0:15:12.71,0:15:14.44,DefaultSingle-J,,0,0,0,,		ガ　ガキんちょじゃない
Dialogue: 1,0:15:14.87,0:15:16.22,DefaultSingle-J,,0,0,0,,		どうしてここにいんの
Dialogue: 1,0:15:16.64,0:15:17.70,DefaultSingle-J,,0,0,0,,		コナン君
Dialogue: 1,0:15:17.70,0:15:18.90,DefaultSingle-J,,0,0,0,,		あっ　逃げた
Dialogue: 1,0:15:19.88,0:15:21.93,DefaultSingle-J,,0,0,0,,		なっ　びっくりだろ
Dialogue: 1,0:15:21.93,0:15:24.09,DefaultSingle-J,,0,0,0,,		こいつ　ここの子供らしいぜ
Dialogue: 1,0:15:24.25,0:15:25.70,DefaultSingle-J,,0,0,0,,		えっ　そうなの
Dialogue: 1,0:15:26.10,0:15:28.63,DefaultSingle-J,,0,0,0,,		オメーらあっさりだまされすぎだろ
Dialogue: 1,0:15:26.10,0:15:28.31,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	それにしてもよくにてるわね
Dialogue: 1,0:15:28.31,0:15:28.94,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	ボク
Dialogue: 1,0:15:29.80,0:15:32.88,DefaultSingle-J,,0,0,0,,		お名前は　って日本語分かる？
Dialogue: 1,0:15:34.08,0:15:35.67,DefaultSingle-J,,0,0,0,,		えっと
Dialogue: 1,0:15:37.03,0:15:37.83,DefaultSingle-J,,0,0,0,,		この子
Dialogue: 1,0:15:41.53,0:15:44.96,DefaultSingle-J,,0,0,0,,		アーサー　ボクの名前はアーサー・ヒライだ
Dialogue: 1,0:15:45.68,0:15:47.07,DefaultSingle-J,,0,0,0,,		アーサー・ヒライ？
Dialogue: 1,0:15:47.27,0:15:49.99,DefaultSingle-J,,0,0,0,,		ボクのお母さんが日本人で　それで
Dialogue: 1,0:15:49.99,0:15:51.72,DefaultSingle-J,,0,0,0,,		わたしは鈴木園子
Dialogue: 1,0:15:52.07,0:15:53.43,DefaultSingle-J,,0,0,0,,		わたしは毛利蘭
Dialogue: 1,0:15:53.74,0:15:55.73,DefaultSingle-J,,0,0,0,,		それと　向こうにいるのが
Dialogue: 1,0:15:57.27,0:15:58.94,DefaultSingle-J,,0,0,0,,		お父さんの毛利小五郎
Dialogue: 1,0:15:59.70,0:16:00.49,DefaultSingle-J,,0,0,0,,		よろしくね
Dialogue: 1,0:16:01.34,0:16:02.92,DefaultSingle-J,,0,0,0,,		うん　よろしく
Dialogue: 1,0:16:03.16,0:16:06.05,DefaultSingle-J,,0,0,0,,		蘭　ごめん　ちょっと行ってくるね
Dialogue: 1,0:16:06.24,0:16:07.07,DefaultSingle-J,,0,0,0,,		あっ　うん
Dialogue: 1,0:16:08.28,0:16:10.74,DefaultSingle-J,,0,0,0,,		ぼうや　お父さんやお母さんは？
Dialogue: 1,0:16:11.43,0:16:14.20,DefaultSingle-J,,0,0,0,,		えっと　日本に行ってる
Dialogue: 1,0:16:14.20,0:16:17.59,DefaultSingle-J,,0,0,0,,		えっ　アーサー君1人でお留守番なの
Dialogue: 1,0:16:17.59,0:16:20.38,DefaultSingle-J,,0,0,0,,		うん　だけど大丈夫　慣れてるから
Dialogue: 1,0:16:20.38,0:16:21.21,DefaultSingle-J,,0,0,0,,		そう
Dialogue: 1,0:16:21.41,0:16:23.71,DefaultSingle-J,,0,0,0,,		それなら　オレたちとー緒に来るか
Dialogue: 1,0:16:24.32,0:16:25.01,DefaultSingle-J,,0,0,0,,		いいの
Dialogue: 1,0:16:25.26,0:16:26.62,DefaultSingle-J,,0,0,0,,		ああ　もちろん
Dialogue: 1,0:16:28.60,0:16:29.52,DefaultSingle-J,,0,0,0,,		あっ　そうだ
Dialogue: 1,0:16:29.75,0:16:31.46,DefaultSingle-J,,0,0,0,,		わたしもお父さん見てくるね
Dialogue: 1,0:16:31.91,0:16:32.84,DefaultSingle-J,,0,0,0,,		おっ　おう
Dialogue: 1,0:16:33.87,0:16:36.17,DefaultSingle-J,,0,0,0,,		それにしてもおっそいなぁ
Dialogue: 1,0:16:36.17,0:16:38.07,DefaultSingle-J,,0,0,0,,		メールぐらいくれたっていいのに
Dialogue: 1,0:16:38.63,0:16:41.44,DefaultSingle-J,,0,0,0,,		ここで待ち合わせのはずなんだけどな
Dialogue: 1,0:16:42.40,0:16:43.69,DefaultSingle-J,,0,0,0,,		おら　ジャマだ　どけ
Dialogue: 1,0:16:43.82,0:16:44.97,DefaultSingle-J,,0,0,0,,		どけどけ
Dialogue: 1,0:16:45.21,0:16:46.45,DefaultSingle-J,,0,0,0,,		何見てんだ　こら
Dialogue: 1,0:16:47.77,0:16:49.06,DefaultSingle-J,,0,0,0,,		なんだ　あいつら
Dialogue: 1,0:16:49.20,0:16:51.91,DefaultSingle-J,,0,0,0,,		真ん中にいるのは中富禮次郎だな
Dialogue: 1,0:16:52.13,0:16:53.25,DefaultSingle-J,,0,0,0,,		中富
Dialogue: 1,0:16:53.58,0:16:56.20,DefaultSingle-J,,0,0,0,,		ああ　中富海運社長の
Dialogue: 1,0:16:56.38,0:16:57.86,DefaultSingle-J,,0,0,0,,		やり手と評判だが
Dialogue: 1,0:16:57.86,0:16:59.85,DefaultSingle-J,,0,0,0,,		黒いウワサが絶えない人物だ
Dialogue: 1,0:17:01.17,0:17:04.48,DefaultSingle-J,,0,0,0,,		ねぇ　彼女　シンガポールまで来て1人？
Dialogue: 1,0:17:05.14,0:17:06.50,DefaultSingle-J,,0,0,0,,		よかったら俺と
Dialogue: 1,0:17:06.50,0:17:08.17,DefaultSingle-J,,0,0,0,,		今それどころじゃないの
Dialogue: 1,0:17:08.38,0:17:09.30,DefaultSingle-J,,0,0,0,,		あっち行って
Dialogue: 1,0:17:10.43,0:17:12.34,DefaultSingle-J,,0,0,0,,		そんなこと言っていいのかな
Dialogue: 1,0:17:12.56,0:17:16.61,DefaultSingle-J,,0,0,0,,		その気になったらお前1人車に連れ込むくらい簡単なんだぞ
Dialogue: 1,0:17:18.06,0:17:18.77,DefaultSingle-J,,0,0,0,,		園子
Dialogue: 1,0:17:20.07,0:17:20.93,DefaultSingle-J,,0,0,0,,		新一
Dialogue: 1,0:17:21.28,0:17:23.26,DefaultSingle-J,,0,0,0,,		余計なことするなって
Dialogue: 1,0:17:24.75,0:17:25.40,DefaultSingle-J,,0,0,0,,		おい
Dialogue: 1,0:17:38.82,0:17:41.79,DefaultSingle-J,,0,0,0,,		彼女は自分の連れですが　何か
Dialogue: 1,0:17:42.11,0:17:43.57,DefaultSingle-J,,0,0,0,,		て　てめぇは
Dialogue: 1,0:17:43.57,0:17:45.79,DefaultSingle-J,,0,0,0,,		真さん　メールぐらい見てよね
Dialogue: 1,0:17:46.04,0:17:48.64,DefaultSingle-J,,0,0,0,,		すみません　機械に疎いもので
Dialogue: 1,0:17:51.01,0:17:51.73,DefaultSingle-J,,0,0,0,,		あいてて
Dialogue: 1,0:17:52.98,0:17:55.81,DefaultSingle-J,,0,0,0,,		覚えてろよ　次は容赦しねぇからな
Dialogue: 1,0:17:56.23,0:17:59.42,DefaultSingle-J,,0,0,0,,		真さん　園子怖かった
Dialogue: 1,0:17:59.42,0:18:01.48,DefaultSingle-J,,0,0,0,,		遅れてしまい　申し訳ありません
Dialogue: 1,0:18:01.88,0:18:03.55,DefaultSingle-J,,0,0,0,,		お兄さん　カッコいい
Dialogue: 1,0:18:03.87,0:18:05.57,DefaultSingle-J,,0,0,0,,		ボクにだって　できらあ
Dialogue: 1,0:18:20.24,0:18:21.52,DefaultSingle-J,,0,0,0,,		園子　大丈夫？
Dialogue: 1,0:18:22.44,0:18:24.91,DefaultSingle-J,,0,0,0,,		うん　真さんが守ってくれたから
Dialogue: 1,0:18:25.31,0:18:27.23,DefaultSingle-J,,0,0,0,,		京極さん　お久しぶりです
Dialogue: 1,0:18:27.50,0:18:28.30,DefaultSingle-J,,0,0,0,,		こちらこそ
Dialogue: 1,0:18:29.27,0:18:29.92,DefaultSingle-J,,0,0,0,,		あなたは
Dialogue: 1,0:18:30.18,0:18:32.71,DefaultSingle-J,,0,0,0,,		はじめまして　工藤新一です
Dialogue: 1,0:18:33.11,0:18:34.29,DefaultSingle-J,,0,0,0,,		京極真です
Dialogue: 1,0:18:40.75,0:18:42.73,DefaultSingle-J,,0,0,0,,		真さん　どうかしたの
Dialogue: 1,0:18:43.03,0:18:46.85,DefaultSingle-J,,0,0,0,,		いえ　工藤君とは初めて会った気がしないもので
Dialogue: 1,0:18:50.49,0:18:52.01,DefaultSingle-J,,0,0,0,,		いや　気のせいでしょ
Dialogue: 1,0:18:53.21,0:18:55.16,DefaultSingle-J,,0,0,0,,		さあ　マーライオンも見たし
Dialogue: 1,0:18:55.16,0:18:56.49,DefaultSingle-J,,0,0,0,,		そろそろホテル行きましょ
Dialogue: 1,0:18:56.69,0:18:59.07,DefaultSingle-J,,0,0,0,,		あ　それが
Dialogue: 1,0:19:02.75,0:19:05.33,DefaultSingle-J,,0,0,0,,		大会に出場できなくなった？
Dialogue: 1,0:19:05.58,0:19:08.34,DefaultSingle-J,,0,0,0,,		わたしたち真さんの試合を見に来たのに
Dialogue: 1,0:19:08.72,0:19:11.23,DefaultSingle-J,,0,0,0,,		すみません　今日のトーナメント
Dialogue: 1,0:19:11.58,0:19:15.03,DefaultSingle-J,,0,0,0,,		自分はある方の招待を受けてエントリーしていたのですが
Dialogue: 1,0:19:15.45,0:19:16.82,DefaultSingle-J,,0,0,0,,		つまりスポンサー
Dialogue: 1,0:19:17.12,0:19:17.59,DefaultSingle-J,,0,0,0,,		はい
Dialogue: 1,0:19:18.19,0:19:21.20,DefaultSingle-J,,0,0,0,,		弁護士をされている　シェリリン・タンという方が
Dialogue: 1,0:19:21.56,0:19:24.50,DefaultSingle-J,,0,0,0,,		旅費　滞在費すべて出すから出場してみないかと
Dialogue: 1,0:19:25.11,0:19:28.06,DefaultSingle-J,,0,0,0,,		ただ　その方が突然亡くなられてしまって
Dialogue: 1,0:19:29.67,0:19:31.42,DefaultSingle-J,,0,0,0,,		今日　その方の関係者から
Dialogue: 1,0:19:31.96,0:19:34.77,DefaultSingle-J,,0,0,0,,		話はすべてなかったことにしてくれと言われました
Dialogue: 1,0:19:34.77,0:19:35.95,DefaultSingle-J,,0,0,0,,		そんな
Dialogue: 1,0:19:36.36,0:19:37.48,DefaultSingle-J,,0,0,0,,		この大会には
Dialogue: 1,0:19:37.48,0:19:40.76,DefaultSingle-J,,0,0,0,,		シンガポール最強と言われる選手も出場されるとか
Dialogue: 1,0:19:41.66,0:19:44.07,DefaultSingle-J,,0,0,0,,		一度戦ってみたい相手だったのですが
Dialogue: 1,0:19:44.70,0:19:45.90,DefaultSingle-J,,0,0,0,,		よっしゃあ
Dialogue: 1,0:19:46.12,0:19:48.58,DefaultSingle-J,,0,0,0,,		そのスポンサー　わたしがなる
Dialogue: 1,0:19:49.49,0:19:51.33,DefaultSingle-J,,0,0,0,,		わたしにまっかせなさい
Dialogue: 1,0:19:52.16,0:19:54.67,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	おじ様　お願いがあるんだけど
Dialogue: 1,0:19:51.52,0:19:54.67,DefaultSingle-J,,0,0,0,,		さすが鈴木財閥のお嬢様
Dialogue: 1,0:19:57.30,0:19:58.98,DefaultSingle-J,,0,0,0,,		万事解決
Dialogue: 1,0:19:59.27,0:20:02.83,DefaultSingle-J,,0,0,0,,		真さん　招待選手として再エントリーできたから
Dialogue: 1,0:20:02.83,0:20:04.25,DefaultSingle-J,,0,0,0,,		本当ですか　園子さん
Dialogue: 1,0:20:04.38,0:20:04.90,DefaultSingle-J,,0,0,0,,		うん
Dialogue: 1,0:20:06.76,0:20:09.74,DefaultSingle-J,,0,0,0,,		真さんのホテル　わたしたちと一緒にしちゃった
Dialogue: 1,0:20:10.00,0:20:11.38,DefaultSingle-J,,0,0,0,,		ダブルデートだね
Dialogue: 1,0:20:13.15,0:20:14.05,DefaultSingle-J,,0,0,0,,		そうだね
Dialogue: 1,0:20:14.90,0:20:17.43,DefaultSingle-J,,0,0,0,,		話がまとまったんなら　ホテル戻ろうぜ
Dialogue: 1,0:20:18.08,0:20:20.10,DefaultSingle-J,,0,0,0,,		早くビールをグビッとよう
Dialogue: 1,0:20:20.10,0:20:21.02,DefaultSingle-J,,0,0,0,,		毛利さん
Dialogue: 1,0:20:22.74,0:20:24.76,DefaultSingle-J,,0,0,0,,		毛利小五郎さんでいらっしゃいますか
Dialogue: 1,0:20:24.92,0:20:26.16,DefaultSingle-J,,0,0,0,,		あ　ええ
Dialogue: 1,0:20:26.96,0:20:29.20,DefaultSingle-J,,0,0,0,,		予備警察官のリシと申します
Dialogue: 1,0:20:29.52,0:20:30.84,DefaultSingle-J,,0,0,0,,		お会いできて光栄です
Dialogue: 1,0:20:30.84,0:20:32.78,DefaultSingle-J,,0,0,0,,		はあ　それはそれは
Dialogue: 1,0:20:33.08,0:20:36.82,DefaultSingle-J,,0,0,0,,		えっと　予備警察官？
Dialogue: 1,0:20:36.82,0:20:37.34,DefaultSingle-J,,0,0,0,,		はい
Dialogue: 1,0:20:37.83,0:20:40.32,DefaultSingle-J,,0,0,0,,		犯罪行動心理学の専門家として
Dialogue: 1,0:20:40.57,0:20:43.59,DefaultSingle-J,,0,0,0,,		特別に捜査のお手伝いをさせてもらっています
Dialogue: 1,0:20:44.28,0:20:45.18,DefaultSingle-J,,0,0,0,,		そうですか
Dialogue: 1,0:20:45.31,0:20:48.80,DefaultSingle-J,,0,0,0,,		実は　毛利さんが入国されたとの情報を聞いて
Dialogue: 1,0:20:48.80,0:20:50.06,DefaultSingle-J,,0,0,0,,		お待ちしていたのです
Dialogue: 1,0:20:50.70,0:20:52.07,DefaultSingle-J,,0,0,0,,		俺を待ってた？
Dialogue: 1,0:20:52.07,0:20:55.08,DefaultSingle-J,,0,0,0,,		はい　観光客の多くはここに来ますから
Dialogue: 1,0:20:55.66,0:20:57.70,DefaultSingle-J,,0,0,0,,		しかし　どうして俺を
Dialogue: 1,0:20:58.16,0:21:02.16,DefaultSingle-J,,0,0,0,,		実は毛利探偵の力をお借りしたい事件が起きまして
Dialogue: 1,0:21:02.99,0:21:04.34,DefaultSingle-J,,0,0,0,,		ああ　ダメダメ
Dialogue: 1,0:21:04.34,0:21:06.12,DefaultSingle-J,,0,0,0,,		俺は今休暇中なの
Dialogue: 1,0:21:06.12,0:21:09.91,DefaultSingle-J,,0,0,0,,		ああっと　ここは一緒に行ったほうがいいと思いますよ
Dialogue: 1,0:21:10.16,0:21:11.50,DefaultSingle-J,,0,0,0,,		あん　どうして
Dialogue: 1,0:21:11.91,0:21:14.65,DefaultSingle-J,,0,0,0,,		予備警察官とはいえ　仲よくしとけば
Dialogue: 1,0:21:14.82,0:21:17.75,DefaultSingle-J,,0,0,0,,		安くてうまい店紹介してもらえるかもしれないし
Dialogue: 1,0:21:18.24,0:21:20.47,DefaultSingle-J,,0,0,0,,		カジノでも　分かるでしょ
Dialogue: 1,0:21:22.29,0:21:25.12,DefaultSingle-J,,0,0,0,,		まあ　そうかもしれんなぁ
Dialogue: 1,0:21:26.81,0:21:31.14,DefaultSingle-J,,0,0,0,,		よろしい　特別にこの名探偵毛利小五郎が力を貸しましょう
Dialogue: 1,0:21:31.54,0:21:32.91,DefaultSingle-J,,0,0,0,,		おいおい
Dialogue: 1,0:21:31.87,0:21:32.67,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	光栄です
Dialogue: 1,0:21:33.63,0:21:36.53,DefaultSingle-J,,0,0,0,,		毛利探偵は父の母国日本のヒーローで
Dialogue: 1,0:21:36.53,0:21:38.15,DefaultSingle-J,,0,0,0,,		自分も大ファンなんです
Dialogue: 1,0:21:39.44,0:21:43.32,DefaultSingle-J,,0,0,0,,		実は　ある実業家の元にこんなものが届きまして
Dialogue: 1,0:21:46.63,0:21:47.74,DefaultSingle-J,,0,0,0,,		怪盗キッド
Dialogue: 1,0:21:47.19,0:21:48.82,DefaultSingle-J,,0,0,0,,	{\pos(400,1070)}	キッド様
Dialogue: 1,0:22:38.04,0:22:39.30,DefaultSingle-J,,0,0,0,,		こりゃすげぇなぁ
Dialogue: 1,0:22:39.30,0:22:41.13,DefaultSingle-J,,0,0,0,,		お父さん　おとなしくして
Dialogue: 1,0:22:41.31,0:22:43.08,DefaultSingle-J,,0,0,0,,		おっ　この甲冑も
Dialogue: 1,0:22:43.08,0:22:44.54,DefaultSingle-J,,0,0,0,,		かっちゆい
Dialogue: 1,0:22:50.83,0:22:51.68,DefaultSingle-J,,0,0,0,,		大丈夫ですか
Dialogue: 1,0:22:51.90,0:22:52.86,DefaultSingle-J,,0,0,0,,		お　おう
Dialogue: 1,0:22:52.86,0:22:55.55,DefaultSingle-J,,0,0,0,,		お父さん　ちゃんとして
Dialogue: 1,0:22:56.37,0:22:57.98,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	うちの父が　すいません
Dialogue: 1,0:22:57.98,0:22:59.11,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	本当にすいません
Dialogue: 1,0:22:57.98,0:23:01.06,DefaultSingle-J,,0,0,0,,		それで　レオン・ローというのは何者なんです
Dialogue: 1,0:23:01.45,0:23:05.40,DefaultSingle-J,,0,0,0,,		レオン先生は元々著名な犯罪行動心理学者で
Dialogue: 1,0:23:05.62,0:23:09.43,DefaultSingle-J,,0,0,0,,		警察と協力し　何人もの凶悪犯を逮捕してきました
Dialogue: 1,0:23:09.59,0:23:10.58,DefaultSingle-J,,0,0,0,,		へえ
Dialogue: 1,0:23:10.95,0:23:13.58,DefaultSingle-J,,0,0,0,,		シンガポールの名探偵ってところか
Dialogue: 1,0:23:13.97,0:23:15.78,DefaultSingle-J,,0,0,0,,		2年前警察を離れて
Dialogue: 1,0:23:16.01,0:23:19.70,DefaultSingle-J,,0,0,0,,		現在は警備会社の社長として　大成功を収めています
Dialogue: 1,0:23:20.60,0:23:24.51,DefaultSingle-J,,0,0,0,,		僕もレオン先生から犯罪行動心理学を学んでいました
Dialogue: 1,0:23:24.75,0:23:25.73,DefaultSingle-J,,0,0,0,,		なるほどね
Dialogue: 1,0:23:25.99,0:23:28.50,DefaultSingle-J,,0,0,0,,		このレオンってヤツの所に予告状が
Dialogue: 1,0:23:28.74,0:23:30.96,DefaultSingle-J,,0,0,0,,		いえ　順を追って説明します
Dialogue: 1,0:23:31.35,0:23:32.69,DefaultSingle-J,,0,0,0,,		まずこれを見てください
Dialogue: 1,0:23:33.36,0:23:37.72,DefaultSingle-J,,0,0,0,,		怪盗キッドが狙っているのは紺青の拳と呼ばれている宝石で
Dialogue: 1,0:23:38.11,0:23:40.77,DefaultSingle-J,,0,0,0,,		所有者は実業家のジョンハン・チェン氏です
Dialogue: 1,0:23:41.29,0:23:43.87,DefaultSingle-J,,0,0,0,,		キッドの予告状は彼の元に届きました
Dialogue: 1,0:23:44.30,0:23:48.17,DefaultSingle-J,,0,0,0,,		だったらそのジョンハンとかいうヤツの所ヘ行ったほうが
Dialogue: 1,0:23:48.17,0:23:52.16,DefaultSingle-J,,0,0,0,,		それが　宝石はこの屋敷の地下に保管されているのです
Dialogue: 1,0:23:52.97,0:23:54.52,DefaultSingle-J,,0,0,0,,		宝石がここに？
Dialogue: 1,0:23:54.90,0:23:57.53,DefaultSingle-J,,0,0,0,,		ええ　所有者の希望なのです
Dialogue: 1,0:23:57.98,0:24:01.35,DefaultSingle-J,,0,0,0,,		ここの金庫は独自開発された最新鋭のシステムで
Dialogue: 1,0:24:01.69,0:24:02.92,DefaultSingle-J,,0,0,0,,		銀行の金庫よりも
Dialogue: 1,0:24:03.10,0:24:04.72,DefaultSingle-J,,0,0,0,,		最新鋭か
Dialogue: 1,0:24:04.96,0:24:08.30,DefaultSingle-J,,0,0,0,,		今度ばかりは　キッドのヤツも手こずりそうだな
Dialogue: 1,0:24:08.30,0:24:10.14,DefaultSingle-J,,0,0,0,,		自分でよく言うぜ
Dialogue: 1,0:24:10.14,0:24:11.49,DefaultSingle-J,,0,0,0,,		何言ってるの
Dialogue: 1,0:24:11.67,0:24:13.75,DefaultSingle-J,,0,0,0,,		どんな最新鋭の金庫だって
Dialogue: 1,0:24:13.75,0:24:16.14,DefaultSingle-J,,0,0,0,,		キッド様にかかればちょちょいのちょいよ
Dialogue: 1,0:24:16.38,0:24:17.29,DefaultSingle-J,,0,0,0,,		ねぇ　園子
Dialogue: 1,0:24:17.29,0:24:19.21,DefaultSingle-J,,0,0,0,,		蘭だって知ってるじゃない
Dialogue: 1,0:24:19.21,0:24:21.90,DefaultSingle-J,,0,0,0,,		キッド様の華麗な盗みのテクニック
Dialogue: 1,0:24:22.56,0:24:26.54,DefaultSingle-J,,0,0,0,,		世界中のどんな女性も彼にがかればハートも盗まれ
Dialogue: 1,0:24:26.01,0:24:27.47,DefaultSingle-J,,0,0,0,,	{\pos(1600,1070)}	ストップ　園子
Dialogue: 1,0:24:32.51,0:24:35.70,DefaultSingle-J,,0,0,0,,		まあ　まあ　わたしと蘭以外はだけどね
Dialogue: 1,0:24:35.70,0:24:36.74,DefaultSingle-J,,0,0,0,,		ねぇ　蘭
Dialogue: 1,0:24:36.74,0:24:38.55,DefaultSingle-J,,0,0,0,,		うん　もちろんよ
Dialogue: 1,0:24:44.07,0:24:46.49,DefaultSingle-J,,0,0,0,,		おめぇ　ヘタすると無事じゃ済まねぇぞ
Dialogue: 1,0:24:46.49,0:24:47.88,DefaultSingle-J,,0,0,0,,		おいおいおい
Dialogue: 1,0:24:49.24,0:24:50.84,DefaultSingle-J,,0,0,0,,		ステキな中庭
Dialogue: 1,0:24:51.15,0:24:52.07,DefaultSingle-J,,0,0,0,,		まあまあね
Dialogue: 1,0:24:52.62,0:24:53.92,DefaultSingle-J,,0,0,0,,		みなさん　はじめまして
Dialogue: 1,0:24:54.81,0:24:56.29,DefaultSingle-J,,0,0,0,,		レオン・ローと申します
Dialogue: 1,0:24:56.67,0:24:59.71,DefaultSingle-J,,0,0,0,,		また　私のボディガード兼警備主任の
Dialogue: 1,0:24:59.88,0:25:02.83,DefaultSingle-J,,0,0,0,,		ヘッズリ・ジャマルッディンもー緒に同席させてください
Dialogue: 1,0:25:19.56,0:25:21.82,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	I　have　my　own　gym　in　this　mansion.
Dialogue: 1,0:25:22.41,0:25:24.70,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	Can　we　train　together　tonight?
Dialogue: 1,0:25:24.95,0:25:28.07,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	Sound　great.　Please　let　me　join　you.
Dialogue: 1,0:25:20.24,0:25:23.94,DefaultSingle-J,,0,0,0,,		おお　あなたが名探偵の毛利小五郎さん
Dialogue: 1,0:25:24.13,0:25:25.95,DefaultSingle-J,,0,0,0,,		いや　これはどうもどうも
Dialogue: 1,0:25:26.47,0:25:30.50,DefaultSingle-J,,0,0,0,,		まさかこんな外国の方にまで名が知られているとは
Dialogue: 1,0:25:35.08,0:25:36.15,DefaultSingle-J,,0,0,0,,		なんでしょうか
Dialogue: 1,0:25:42.20,0:25:45.10,DefaultSingle-J,,0,0,0,,		そして高校生探偵の工藤新一さん
Dialogue: 1,0:25:45.76,0:25:46.42,DefaultSingle-J,,0,0,0,,		よろしく
Dialogue: 1,0:25:47.77,0:25:50.70,DefaultSingle-J,,0,0,0,,		キミは探偵というよりは　マジシャンのようだね
Dialogue: 1,0:25:52.55,0:25:53.64,DefaultSingle-J,,0,0,0,,		キミの指だよ
Dialogue: 1,0:25:54.57,0:25:55.91,DefaultSingle-J,,0,0,0,,		細くてしなやかだ
Dialogue: 1,0:25:56.78,0:25:59.01,DefaultSingle-J,,0,0,0,,		探偵といっても　オレは腕っぷしより
Dialogue: 1,0:25:59.14,0:26:01.08,DefaultSingle-J,,0,0,0,,		ここで勝負するほうなんでね
Dialogue: 1,0:26:01.88,0:26:02.59,DefaultSingle-J,,0,0,0,,		なるほど
Dialogue: 1,0:26:03.16,0:26:07.43,DefaultSingle-J,,0,0,0,,		おや　あちらにいらっしゃるのは鈴木園子さんでいらっしゃいますね
Dialogue: 1,0:26:08.10,0:26:10.38,DefaultSingle-J,,0,0,0,,		こいつは油断できねぇぞ
Dialogue: 1,0:26:15.70,0:26:18.14,DefaultSingle-J,,0,0,0,,		おお　毛利小五郎先生
Dialogue: 1,0:26:18.30,0:26:21.32,DefaultSingle-J,,0,0,0,,		妻も私も　あなたの大ファンでして
Dialogue: 1,0:26:22.76,0:26:24.64,DefaultSingle-J,,0,0,0,,		フォト　1枚いいですか
Dialogue: 1,0:26:24.87,0:26:26.82,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	フォト　ああ　写真ね
Dialogue: 1,0:26:27.05,0:26:28.87,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	オッケーオッケー　よろこんで
Dialogue: 1,0:26:35.61,0:26:40.00,DefaultSingle-J,,0,0,0,,		紺青の拳もぜひ近くで見ていってもらいたい
Dialogue: 1,0:26:42.26,0:26:45.63,DefaultSingle-J,,0,0,0,,		この扉の先が我が社自慢の金庫室になります
Dialogue: 1,0:26:46.36,0:26:49.93,DefaultSingle-J,,0,0,0,,		ここは限られた者しか開くことができないのですよ
Dialogue: 1,0:27:05.44,0:27:09.27,DefaultSingle-J,,0,0,0,,		壁面は耐熱合金でできており　決して破壊することはできません
Dialogue: 1,0:27:09.82,0:27:12.51,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	また　外部からの電波も完全に遮断し
Dialogue: 1,0:27:13.28,0:27:15.95,DefaultSingle-J,,0,0,0,,		各カーゴの位置は定期的に移動される仕組みです
Dialogue: 1,0:27:16.55,0:27:19.18,DefaultSingle-J,,0,0,0,,		この金庫は私の理想が詰まった
Dialogue: 1,0:27:19.37,0:27:21.63,DefaultSingle-J,,0,0,0,,		世界で1つの特別製なのです
Dialogue: 1,0:27:23.95,0:27:25.20,DefaultSingle-J,,0,0,0,,		な　なんだ
Dialogue: 1,0:27:25.67,0:27:27.79,DefaultSingle-J,,0,0,0,,		みなさん　少し離れてください
Dialogue: 1,0:27:30.58,0:27:33.42,DefaultSingle-J,,0,0,0,,		これが海賊王の証しと言われた
Dialogue: 1,0:27:33.42,0:27:35.80,DefaultSingle-J,,0,0,0,,		紺青の拳と呼ばれる宝石です
Dialogue: 1,0:27:35.98,0:27:38.91,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	これは大きなブルーサファイアですなぁ
Dialogue: 1,0:27:37.27,0:27:38.53,DefaultSingle-J,,0,0,0,,		見える　アーサー君
Dialogue: 1,0:27:38.98,0:27:40.52,DefaultSingle-J,,0,0,0,,		うん　ありがとう
Dialogue: 1,0:27:41.14,0:27:43.51,DefaultSingle-J,,0,0,0,,		なるほど　ここにある限り
Dialogue: 1,0:27:43.51,0:27:46.09,DefaultSingle-J,,0,0,0,,		いかにキッドでも手出しはできんでしょうな
Dialogue: 1,0:27:46.63,0:27:48.42,DefaultSingle-J,,0,0,0,,		それがそうもいかないのですよ
Dialogue: 1,0:27:48.98,0:27:51.15,DefaultSingle-J,,0,0,0,,		明日からの空手トーナメント開催中は
Dialogue: 1,0:27:51.58,0:27:54.22,DefaultSingle-J,,0,0,0,,		会場にベルトを展示する決まりになっていましてね
Dialogue: 1,0:27:54.72,0:27:56.77,DefaultSingle-J,,0,0,0,,		つまり大会期間中は
Dialogue: 1,0:27:57.03,0:27:59.44,DefaultSingle-J,,0,0,0,,		会場の一室に保管することになるのです
Dialogue: 1,0:28:00.07,0:28:03.45,DefaultSingle-J,,0,0,0,,		厳重な警備態勢を敷きますが　ここよりは劣る
Dialogue: 1,0:28:03.59,0:28:04.20,DefaultSingle-J,,0,0,0,,		なるほど
Dialogue: 1,0:28:19.27,0:28:22.18,DefaultSingle-J,,0,0,0,,		警備態勢がここより劣るとおっしゃっていましたが
Dialogue: 1,0:28:22.48,0:28:25.08,DefaultSingle-J,,0,0,0,,		つまりキッドはサファイアが会場に移されるのを
Dialogue: 1,0:28:25.08,0:28:27.11,DefaultSingle-J,,0,0,0,,		待っているとお考えなんですね
Dialogue: 1,0:28:27.48,0:28:30.86,DefaultSingle-J,,0,0,0,,		そのとおり　ここを狙うのはリスクが高すぎる
Dialogue: 1,0:28:31.29,0:28:36.19,DefaultSingle-J,,0,0,0,,		ですね　僕も微力ながら　宝石の警護に協力させてください
Dialogue: 1,0:28:37.89,0:28:38.53,DefaultSingle-J,,0,0,0,,		ありがとう
Dialogue: 1,0:29:07.02,0:29:08.06,DefaultSingle-J,,0,0,0,,		楽勝
Dialogue: 1,0:29:25.16,0:29:26.74,DefaultSingle-J,,0,0,0,,		指紋いただき
Dialogue: 1,0:29:40.16,0:29:41.84,DefaultSingle-J,,0,0,0,,		簡単すぎ　か
Dialogue: 1,0:29:47.27,0:29:48.20,DefaultSingle-J,,0,0,0,,		待っていたよ
Dialogue: 1,0:29:51.27,0:29:52.27,DefaultSingle-J,,0,0,0,,		怪盗キッド
Dialogue: 1,0:29:53.28,0:29:54.85,DefaultSingle-J,,0,0,0,,		ここまで入り込むとは
Dialogue: 1,0:29:55.42,0:29:56.60,DefaultSingle-J,,0,0,0,,		さすがだね
Dialogue: 1,0:29:57.52,0:29:59.27,DefaultSingle-J,,0,0,0,,		大した自信だな
Dialogue: 1,0:29:59.79,0:30:03.38,DefaultSingle-J,,0,0,0,,		申し訳ないが　宝石を渡すわけにはいかないんだ
Dialogue: 1,0:30:04.08,0:30:07.03,DefaultSingle-J,,0,0,0,,		ジョンハン・チェンに賠償金など払いたくないからね
Dialogue: 1,0:30:08.15,0:30:11.40,DefaultSingle-J,,0,0,0,,		そんなお宝を盗み出すのがオレの仕事さ
Dialogue: 1,0:30:11.83,0:30:15.09,DefaultSingle-J,,0,0,0,,		そして盗むのが難しければ難しいほど
Dialogue: 1,0:30:15.09,0:30:17.64,DefaultSingle-J,,0,0,0,,		オレは　燃えるタチでね
Dialogue: 1,0:31:01.91,0:31:04.88,DefaultSingle-J,,0,0,0,,		まさか　テーザー銃を使ってくるとは
Dialogue: 1,0:31:39.69,0:31:40.30,DefaultSingle-J,,0,0,0,,		KID!
Dialogue: 1,0:31:44.07,0:31:45.13,DefaultSingle-J,,0,0,0,,		マジかよ
Dialogue: 1,0:32:01.58,0:32:06.15,DefaultSingle-J,,0,0,0,,		一流ってのはいつも最悪の可能性を考えて行動してるんだ
Dialogue: 1,0:32:08.44,0:32:10.58,DefaultSingle-J,,0,0,0,,		さっさとここから脱出しねぇとな
Dialogue: 1,0:32:45.92,0:32:47.23,DefaultSingle-J,,0,0,0,,		なんて突きだ
Dialogue: 1,0:32:47.50,0:32:49.65,DefaultSingle-J,,0,0,0,,		後ろに跳んでなきゃヤバかったぜ
Dialogue: 1,0:32:49.75,0:32:53.65,DefaultSingle-J,,0,0,0,,		住居不法侵入　ですよね
Dialogue: 1,0:32:54.40,0:32:56.66,DefaultSingle-J,,0,0,0,,		ってか　なんであんたがここに
Dialogue: 1,0:32:57.15,0:32:59.99,DefaultSingle-J,,0,0,0,,		ここでトレーニングをしないかと誘われていたんですが
Dialogue: 1,0:33:00.65,0:33:02.94,DefaultSingle-J,,0,0,0,,		まさかあなたとお手合わせできるとは
Dialogue: 1,0:33:02.94,0:33:04.92,DefaultSingle-J,,0,0,0,,		いやいやいや　こっちはしたくないんだが
Dialogue: 1,0:33:04.92,0:33:06.12,DefaultSingle-J,,0,0,0,,		問答無用
Dialogue: 1,0:33:07.58,0:33:08.74,DefaultSingle-J,,0,0,0,,		ちょっ　とお
Dialogue: 1,0:33:09.89,0:33:11.26,DefaultSingle-J,,0,0,0,,		覚悟
Dialogue: 1,0:33:29.65,0:33:30.82,DefaultSingle-J,,0,0,0,,		サッカーボール
Dialogue: 1,0:33:31.46,0:33:32.61,DefaultSingle-J,,0,0,0,,		ー体どこから
Dialogue: 1,0:33:33.31,0:33:35.41,DefaultSingle-J,,0,0,0,,		ありがとよ　名探偵
Dialogue: 1,0:33:50.27,0:33:51.72,DefaultSingle-J,,0,0,0,,		こいつはすげぇ
Dialogue: 1,0:33:52.00,0:33:55.93,DefaultSingle-J,,0,0,0,,		無風も自由自在で　じいちゃんに感謝しねーとな
Dialogue: 1,0:33:56.90,0:33:57.93,DefaultSingle-J,,0,0,0,,		しかし
Dialogue: 1,0:33:58.42,0:33:59.80,DefaultSingle-J,,0,0,0,,		あそこまでとはな
Dialogue: 1,0:34:18.94,0:34:20.20,DefaultSingle-J,,0,0,0,,		助かったぜ
Dialogue: 1,0:34:20.45,0:34:23.14,DefaultSingle-J,,0,0,0,,		念のため装備を返しておいて正解だった
Dialogue: 1,0:34:23.48,0:34:25.68,DefaultSingle-J,,0,0,0,,		助けたくなんかなかったけどな
Dialogue: 1,0:34:26.57,0:34:29.31,DefaultSingle-J,,0,0,0,,		そんなことより　そろそろ教えろよ
Dialogue: 1,0:34:29.49,0:34:31.71,DefaultSingle-J,,0,0,0,,		オレをここに連れてきた本当のわけを
Dialogue: 1,0:34:38.54,0:34:42.48,DefaultSingle-J,,0,0,0,,		レオンは紺青の拳の捜索を何年も前からやっていたが
Dialogue: 1,0:34:42.86,0:34:45.01,DefaultSingle-J,,0,0,0,,		引き上げまであと一歩というところで
Dialogue: 1,0:34:45.24,0:34:47.64,DefaultSingle-J,,0,0,0,,		ジョンハン・チェンに先を越されちまった
Dialogue: 1,0:34:48.42,0:34:52.67,DefaultSingle-J,,0,0,0,,		どうやら沈没船の位置を　何者かが彼にリークしたらしいんだ
Dialogue: 1,0:34:53.76,0:34:56.50,DefaultSingle-J,,0,0,0,,		最も疑わしいのが　シェリリン・タンだ
Dialogue: 1,0:34:57.07,0:35:00.08,DefaultSingle-J,,0,0,0,,		一時期はレオンの会社の顧問弁護士を務めていたが
Dialogue: 1,0:35:00.42,0:35:02.07,DefaultSingle-J,,0,0,0,,		2人の関係は悪化
Dialogue: 1,0:35:02.73,0:35:06.23,DefaultSingle-J,,0,0,0,,		ウワサによれば　彼女が京極のスポンサーになったのは
Dialogue: 1,0:35:06.77,0:35:09.21,DefaultSingle-J,,0,0,0,,		ジャマルッディンの優勝　つまり
Dialogue: 1,0:35:09.37,0:35:12.19,DefaultSingle-J,,0,0,0,,		レオンが宝石を手に入れるのを妨害したかった
Dialogue: 1,0:35:12.48,0:35:14.24,DefaultSingle-J,,0,0,0,,		もしそれが本当なら
Dialogue: 1,0:35:14.49,0:35:18.92,DefaultSingle-J,,0,0,0,,		沈没船の情報をリークしたというウワサのほうも真実味を持つ
Dialogue: 1,0:35:19.17,0:35:21.84,DefaultSingle-J,,0,0,0,,		そしてそのシェリリン・タンが殺害された
Dialogue: 1,0:35:22.61,0:35:24.46,DefaultSingle-J,,0,0,0,,		リークのウワサが本当だとすれば
Dialogue: 1,0:35:24.78,0:35:27.55,DefaultSingle-J,,0,0,0,,		レオンにはシェリリン殺害の動機があったことになる
Dialogue: 1,0:35:28.17,0:35:29.87,DefaultSingle-J,,0,0,0,,		警察はどう考えてるんだ
Dialogue: 1,0:35:30.82,0:35:34.36,DefaultSingle-J,,0,0,0,,		残念なから　レオンは容疑者リストから外された
Dialogue: 1,0:35:34.83,0:35:35.57,DefaultSingle-J,,0,0,0,,		なんで
Dialogue: 1,0:35:35.95,0:35:38.38,DefaultSingle-J,,0,0,0,,		もっと有力な容疑者がいるからさ
Dialogue: 1,0:35:38.91,0:35:39.86,DefaultSingle-J,,0,0,0,,		容疑者？
Dialogue: 1,0:35:43.78,0:35:45.47,DefaultSingle-J,,0,0,0,,		警察は発表してないが
Dialogue: 1,0:35:45.76,0:35:49.96,DefaultSingle-J,,0,0,0,,		シェリリン・タンの殺害現場には1枚のカードが残されていた
Dialogue: 1,0:35:50.71,0:35:52.11,DefaultSingle-J,,0,0,0,,		オレの予告状さ
Dialogue: 1,0:35:53.23,0:35:54.55,DefaultSingle-J,,0,0,0,,		なるほどな
Dialogue: 1,0:35:55.10,0:35:55.80,DefaultSingle-J,,0,0,0,,		でも
Dialogue: 1,0:35:56.30,0:35:59.80,DefaultSingle-J,,0,0,0,,		なんでこんな絶景を　こいつと見なきゃなんねーんだ
Dialogue: 1,0:36:00.95,0:36:02.63,DefaultSingle-J,,0,0,0,,		どうせ一緒に見るなら
Dialogue: 1,0:36:12.95,0:36:15.30,DefaultSingle-J,,0,0,0,,		アーサー・ヒライに戻るお時間だぜ
Dialogue: 1,0:36:15.94,0:36:19.07,DefaultSingle-J,,0,0,0,,		ちなみにアーサーはアーサー・コナン・ドイルだろうけど
Dialogue: 1,0:36:19.56,0:36:20.56,DefaultSingle-J,,0,0,0,,		ヒライってなんだよ
Dialogue: 1,0:36:20.97,0:36:22.45,DefaultSingle-J,,0,0,0,,		あ　それは
Dialogue: 1,0:36:22.96,0:36:26.43,DefaultSingle-J,,0,0,0,,		江戸川乱歩の本名　平井太郎から頂いたんだ
Dialogue: 1,0:36:26.43,0:36:27.70,DefaultSingle-J,,0,0,0,,		なるほどね
Dialogue: 1,0:36:27.94,0:36:31.00,DefaultSingle-J,,0,0,0,,		それより　こいつは間違いなくワナだぞ
Dialogue: 1,0:36:31.53,0:36:32.65,DefaultSingle-J,,0,0,0,,		分かってるさ
Dialogue: 1,0:36:33.25,0:36:36.34,DefaultSingle-J,,0,0,0,,		だからお前を連れてきたんだ　名探偵
Dialogue: 1,0:36:37.05,0:36:38.79,DefaultSingle-J,,0,0,0,,		この手のことは得意だろ
Dialogue: 1,0:36:39.49,0:36:40.63,DefaultSingle-J,,0,0,0,,		理由は分かった
Dialogue: 1,0:36:41.14,0:36:43.01,DefaultSingle-J,,0,0,0,,		やり方は気に入らねぇがな
Dialogue: 1,0:36:43.77,0:36:45.51,DefaultSingle-J,,0,0,0,,		このキッド様が
Dialogue: 1,0:36:46.94,0:36:49.66,DefaultSingle-J,,0,0,0,,		このまま黙っているわけにはいかないだろ
Dialogue: 1,0:36:56.23,0:36:59.91,DefaultSingle-J,,0,0,0,,		遅いじゃない　ずっと待ってたんだから
Dialogue: 1,0:37:00.33,0:37:01.21,DefaultSingle-J,,0,0,0,,		わりぃ　わりぃ
Dialogue: 1,0:37:02.41,0:37:03.39,DefaultSingle-J,,0,0,0,,		ねぇ　見て
Dialogue: 1,0:37:04.00,0:37:05.72,DefaultSingle-J,,0,0,0,,		すごくキレイな夜景
Dialogue: 1,0:37:06.90,0:37:08.18,DefaultSingle-J,,0,0,0,,		ロマンチックだね
Dialogue: 1,0:37:17.09,0:37:18.83,DefaultSingle-J,,0,0,0,,		もう　照れないでよ
Dialogue: 1,0:37:19.55,0:37:21.63,DefaultSingle-J,,0,0,0,,		わたしたち付き合ってるんでしょ
Dialogue: 1,0:37:22.83,0:37:24.26,DefaultSingle-J,,0,0,0,,		えっ　そうなの
Dialogue: 1,0:37:25.05,0:37:26.46,DefaultSingle-J,,0,0,0,,		くっそー
Dialogue: 1,0:37:26.75,0:37:29.87,DefaultSingle-J,,0,0,0,,		蘭のヤツ　ニセモノだって気づかねぇのかよ
Dialogue: 1,0:37:30.08,0:37:33.02,DefaultSingle-J,,0,0,0,,		あ　でも気づかれたら日本に帰れなくなるし
Dialogue: 1,0:37:49.03,0:37:52.39,DefaultSingle-J,,0,0,0,,		シンガポールっつったら　シンガポール・スリングだなぁ
Dialogue: 1,0:37:52.55,0:37:53.32,DefaultSingle-J,,0,0,0,,		もう1杯
Dialogue: 1,0:37:54.45,0:37:55.23,DefaultSingle-J,,0,0,0,,		毛利さん
Dialogue: 1,0:37:56.61,0:37:58.58,DefaultSingle-J,,0,0,0,,		あ　あな...　あなたは
Dialogue: 1,0:37:59.30,0:38:01.67,DefaultSingle-J,,0,0,0,,		ここ　座っても構いません？
Dialogue: 1,0:38:02.80,0:38:04.74,DefaultSingle-J,,0,0,0,,		ど　ど　どうぞ　どうぞ　どうぞ
Dialogue: 1,0:38:04.74,0:38:05.83,DefaultSingle-J,,0,0,0,,		一緒に飲みましょう
Dialogue: 1,0:38:07.43,0:38:08.93,DefaultSingle-J,,0,0,0,,		実は私
Dialogue: 1,0:38:13.86,0:38:16.44,DefaultSingle-J,,0,0,0,,		大変　私ったらなんてことを
Dialogue: 1,0:38:17.33,0:38:18.69,DefaultSingle-J,,0,0,0,,		本当にすみません
Dialogue: 1,0:38:19.39,0:38:22.11,DefaultSingle-J,,0,0,0,,		いやあ　いやいや　どうぞ　お気遣いなさらずに
Dialogue: 1,0:38:26.45,0:38:28.08,DefaultSingle-J,,0,0,0,,		ん　コール?
Dialogue: 1,0:38:28.49,0:38:30.58,DefaultSingle-J,,0,0,0,,		毛利さんあてにお電話のようです
Dialogue: 1,0:38:31.12,0:38:31.76,DefaultSingle-J,,0,0,0,,		俺に?
Dialogue: 1,0:38:32.64,0:38:33.47,DefaultSingle-J,,0,0,0,,		誰だ
Dialogue: 1,0:38:34.25,0:38:35.11,DefaultSingle-J,,0,0,0,,		毛利さん
Dialogue: 1,0:38:36.64,0:38:38.88,DefaultSingle-J,,0,0,0,,		どうしても　お話ししたいことがあるんです
Dialogue: 1,0:38:40.13,0:38:41.52,DefaultSingle-J,,0,0,0,,		明日　ここへ
Dialogue: 1,0:38:45.02,0:38:45.62,DefaultSingle-J,,0,0,0,,		ったく
Dialogue: 1,0:38:49.76,0:38:51.43,DefaultSingle-J,,0,0,0,,		なんだ　切れてんじゃねーかよ
Dialogue: 1,0:38:51.86,0:38:53.62,DefaultSingle-J,,0,0,0,,		たあっ　飲み直しだ
Dialogue: 1,0:39:04.23,0:39:06.30,DefaultSingle-J,,0,0,0,,		みんなは誰が優勝すると思う
Dialogue: 1,0:39:06.52,0:39:07.87,DefaultSingle-J,,0,0,0,,		京極選手だよ
Dialogue: 1,0:39:08.00,0:39:09.35,DefaultSingle-J,,0,0,0,,		負けたことないんだもん
Dialogue: 1,0:39:09.35,0:39:12.23,DefaultSingle-J,,0,0,0,,		えっ　そうなの　先生初耳です
Dialogue: 1,0:39:12.71,0:39:16.43,DefaultSingle-J,,0,0,0,,		正しい場所　方向で十分な量なされた努力は
Dialogue: 1,0:39:16.59,0:39:18.22,DefaultSingle-J,,0,0,0,,		実を結ぶんですね
Dialogue: 1,0:39:18.65,0:39:20.40,DefaultSingle-J,,0,0,0,,		みんな　分かったかな
Dialogue: 1,0:39:20.57,0:39:21.61,DefaultSingle-J,,0,0,0,,		はーい
Dialogue: 1,0:39:30.85,0:39:33.27,DefaultSingle-J,,0,0,0,,		Who　will　get　the　Fist　of　Blue　Sapphire?
Dialogue: 1,0:39:53.13,0:39:55.95,DefaultSingle-J,,0,0,0,,		ジャマルッディンって人メチャクチャ強そうね
Dialogue: 1,0:39:56.20,0:40:00.10,DefaultSingle-J,,0,0,0,,		重量級のパワーに　スピードとテクニックも兼ね備えてる
Dialogue: 1,0:40:00.74,0:40:01.71,DefaultSingle-J,,0,0,0,,		手ごわそうね
Dialogue: 1,0:40:02.70,0:40:07.52,DefaultSingle-J,,0,0,0,,		さすが帝丹高空手部主将　目の付けどころが違うの
Dialogue: 1,0:40:08.34,0:40:12.16,DefaultSingle-J,,0,0,0,,		なぁ　京極さんの手元に宝石が行っちまったら
Dialogue: 1,0:40:12.53,0:40:14.60,DefaultSingle-J,,0,0,0,,		もう手が出せなくなるんじゃねぇか
Dialogue: 1,0:40:14.82,0:40:16.17,DefaultSingle-J,,0,0,0,,		そうだな
Dialogue: 1,0:40:16.52,0:40:19.14,DefaultSingle-J,,0,0,0,,		あいつにはなるべく近づきたくねぇからな
Dialogue: 1,0:40:22.02,0:40:24.30,DefaultSingle-J,,0,0,0,,		あっ　真さん来た
Dialogue: 1,0:40:26.34,0:40:27.90,DefaultSingle-J,,0,0,0,,		ほら　みんなも応援
Dialogue: 1,0:40:28.24,0:40:30.97,DefaultSingle-J,,0,0,0,,		って　なんで現地のガキんちょがついてきてんのよ
Dialogue: 1,0:40:31.15,0:40:33.20,DefaultSingle-J,,0,0,0,,		なーんかなつかれちまってな
Dialogue: 1,0:41:01.23,0:41:02.75,DefaultSingle-J,,0,0,0,,		怖え
Dialogue: 1,0:41:01.45,0:41:02.40,DefaultSingle-J,,0,0,0,,	{\pos(400,1070)}	やった
Dialogue: 1,0:41:02.41,0:41:04.09,DefaultSingle-J,,0,0,0,,	{\pos(400,1070)}	真さん　カッコいい
Dialogue: 1,0:41:04.92,0:41:06.53,DefaultSingle-J,,0,0,0,,	{\pos(400,1070)}	今すぐ会いに行きたい
Dialogue: 1,0:41:07.79,0:41:08.90,DefaultSingle-J,,0,0,0,,		お父さんからだ
Dialogue: 1,0:41:10.00,0:41:12.97,DefaultSingle-J,,0,0,0,,		だからあやしいもんじゃねぇって言ってんだろが
Dialogue: 1,0:41:12.97,0:41:13.90,DefaultSingle-J,,0,0,0,,		お父さん
Dialogue: 1,0:41:14.89,0:41:15.93,DefaultSingle-J,,0,0,0,,		何があったの
Dialogue: 1,0:41:16.15,0:41:19.24,DefaultSingle-J,,0,0,0,,		蘭　こいつらに説明してくれよ
Dialogue: 1,0:41:19.62,0:41:22.00,DefaultSingle-J,,0,0,0,,		金属製のもんは全部出したんだ
Dialogue: 1,0:41:22.37,0:41:23.63,DefaultSingle-J,,0,0,0,,		だがしかし
Dialogue: 1,0:41:26.58,0:41:27.75,DefaultSingle-J,,0,0,0,,		もういいだろ
Dialogue: 1,0:41:28.78,0:41:32.05,DefaultSingle-J,,0,0,0,,		くそ　これじゃ中に入れねぇじゃねぇか
Dialogue: 1,0:41:32.76,0:41:34.64,DefaultSingle-J,,0,0,0,,		毛利さん　大丈夫ですか
Dialogue: 1,0:41:34.85,0:41:35.51,DefaultSingle-J,,0,0,0,,		あっ　リシさん
Dialogue: 1,0:41:39.64,0:41:41.14,DefaultSingle-J,,0,0,0,,		サンキユー　ミスター・リシ
Dialogue: 1,0:41:41.14,0:41:42.77,DefaultSingle-J,,0,0,0,,		合流できてよかったです
Dialogue: 1,0:41:43.36,0:41:45.57,DefaultSingle-J,,0,0,0,,		ベルトは開幕式でお披露目した後
Dialogue: 1,0:41:45.78,0:41:48.06,DefaultSingle-J,,0,0,0,,		今は地下金庫で保管されています
Dialogue: 1,0:41:48.60,0:41:50.62,DefaultSingle-J,,0,0,0,,		よろしければこの後にご案内します
Dialogue: 1,0:41:51.42,0:41:53.41,DefaultSingle-J,,0,0,0,,		それにしても　今までどちらに
Dialogue: 1,0:41:53.58,0:41:56.66,DefaultSingle-J,,0,0,0,,		いっ　い　いやあ　ちょっとパトロールに
Dialogue: 1,0:41:57.22,0:41:59.14,DefaultSingle-J,,0,0,0,,		二日酔いで寝坊だろ
Dialogue: 1,0:42:02.00,0:42:04.49,DefaultSingle-J,,0,0,0,,		暗証番号は10分ごとに変わります
Dialogue: 1,0:42:04.69,0:42:07.93,DefaultSingle-J,,0,0,0,,		管理はコンピューターが行い　メールで知らせてくれます
Dialogue: 1,0:42:08.81,0:42:11.38,DefaultSingle-J,,0,0,0,,		これが届くのはアイダン警部補と僕
Dialogue: 1,0:42:11.65,0:42:15.10,DefaultSingle-J,,0,0,0,,		それに金庫の管理者であるレオン先生の3人だけです
Dialogue: 1,0:42:18.49,0:42:20.70,DefaultSingle-J,,0,0,0,,		こりゃまたなんもない部屋だな
Dialogue: 1,0:42:20.83,0:42:22.18,DefaultSingle-J,,0,0,0,,		そんなことはありません
Dialogue: 1,0:42:22.80,0:42:25.68,DefaultSingle-J,,0,0,0,,		床には重量センサ一　天井には監視カメラ
Dialogue: 1,0:42:25.93,0:42:28.78,DefaultSingle-J,,0,0,0,,		そして会場の周りは警官が包囲していますし
Dialogue: 1,0:42:29.25,0:42:32.75,DefaultSingle-J,,0,0,0,,		おー　これならあの怪盗も手も足も出んでしょうな
Dialogue: 1,0:42:33.44,0:42:35.70,DefaultSingle-J,,0,0,0,,		あっ　毛利さん　ここは禁煙です
Dialogue: 1,0:42:35.71,0:42:37.42,DefaultSingle-J,,0,0,0,,		ああっ　そいつは失敬
Dialogue: 1,0:42:42.41,0:42:45.00,DefaultSingle-J,,0,0,0,,		酔っぱらっててすっかり忘れてた
Dialogue: 1,0:42:45.23,0:42:47.12,DefaultSingle-J,,0,0,0,,		ゆうベバーで渡されたんだ
Dialogue: 1,0:42:47.35,0:42:48.63,DefaultSingle-J,,0,0,0,,		話があるってな
Dialogue: 1,0:42:50.47,0:42:52.88,DefaultSingle-J,,0,0,0,,		これ　レオンさんの秘書の名刺だよ
Dialogue: 1,0:42:53.09,0:42:54.65,DefaultSingle-J,,0,0,0,,		えっ　そうなのか
Dialogue: 1,0:42:55.47,0:42:57.83,DefaultSingle-J,,0,0,0,,		実は酔っててよく覚えてねぇんだよ
Dialogue: 1,0:42:58.29,0:42:59.68,DefaultSingle-J,,0,0,0,,		なんで分かったんだ
Dialogue: 1,0:42:59.97,0:43:02.46,DefaultSingle-J,,0,0,0,,		レオンさんの会社のマークが入ってるよ
Dialogue: 1,0:43:02.63,0:43:03.95,DefaultSingle-J,,0,0,0,,		ん　マークね
Dialogue: 1,0:43:04.89,0:43:05.98,DefaultSingle-J,,0,0,0,,		「午後3時
Dialogue: 1,0:43:06.16,0:43:11.02,DefaultSingle-J,,0,0,0,,		ナショナルスタジアム裏3番扉の前で待つ」と書いてあるよ
Dialogue: 1,0:43:11.59,0:43:14.03,DefaultSingle-J,,0,0,0,,		あと「誰にも知らせないで」だってさ
Dialogue: 1,0:43:14.53,0:43:18.08,DefaultSingle-J,,0,0,0,,		なるほど　午後3時っつーことはだ
Dialogue: 1,0:43:18.80,0:43:20.02,DefaultSingle-J,,0,0,0,,		もうすぐじゃねーか
Dialogue: 1,0:43:20.45,0:43:21.31,DefaultSingle-J,,0,0,0,,		毛利さん
Dialogue: 1,0:43:22.04,0:43:24.11,DefaultSingle-J,,0,0,0,,		レディを待たせんのは男の恥
Dialogue: 1,0:43:39.59,0:43:41.09,DefaultSingle-J,,0,0,0,,		実にいい試合だった
Dialogue: 1,0:43:42.20,0:43:45.16,DefaultSingle-J,,0,0,0,,		明日の準決勝　決勝が今から楽しみだよ
Dialogue: 1,0:43:45.95,0:43:47.09,DefaultSingle-J,,0,0,0,,		ありがとうございます
Dialogue: 1,0:43:47.79,0:43:49.60,DefaultSingle-J,,0,0,0,,		キミの強さは特別だ
Dialogue: 1,0:43:50.31,0:43:51.11,DefaultSingle-J,,0,0,0,,		どうだろう
Dialogue: 1,0:43:51.36,0:43:53.58,DefaultSingle-J,,0,0,0,,		僕のボディガードになる気はないか
Dialogue: 1,0:43:55.59,0:43:56.55,DefaultSingle-J,,0,0,0,,		失礼します
Dialogue: 1,0:44:00.99,0:44:02.24,DefaultSingle-J,,0,0,0,,		まあ　待ちたまえ
Dialogue: 1,0:44:02.53,0:44:04.37,DefaultSingle-J,,0,0,0,,		もちろん今のは冗談さ
Dialogue: 1,0:44:04.78,0:44:06.81,DefaultSingle-J,,0,0,0,,		実はキミに1つ聞きたくてね
Dialogue: 1,0:44:08.88,0:44:09.75,DefaultSingle-J,,0,0,0,,		教えてくれ
Dialogue: 1,0:44:12.08,0:44:14.35,DefaultSingle-J,,0,0,0,,		キミの拳はなんのためにある
Dialogue: 1,0:44:15.54,0:44:18.90,DefaultSingle-J,,0,0,0,,		強さを追い求めて　その先に何がある
Dialogue: 1,0:44:20.37,0:44:22.89,DefaultSingle-J,,0,0,0,,		キミを駆り立てているものはー体なんだ
Dialogue: 1,0:44:25.54,0:44:26.82,DefaultSingle-J,,0,0,0,,		答えられないのか
Dialogue: 1,0:44:27.49,0:44:30.51,DefaultSingle-J,,0,0,0,,		目的を持たない不完全な拳は危険だ
Dialogue: 1,0:44:31.16,0:44:32.50,DefaultSingle-J,,0,0,0,,		自分だけではない
Dialogue: 1,0:44:32.88,0:44:35.30,DefaultSingle-J,,0,0,0,,		周りの人々をも不幸にしてしまう
Dialogue: 1,0:44:35.94,0:44:38.16,DefaultSingle-J,,0,0,0,,		周りの人　不幸
Dialogue: 1,0:44:38.16,0:44:41.16,DefaultSingle-J,,0,0,0,,		そう　たとえばキミの愛する人
Dialogue: 1,0:44:42.25,0:44:44.95,DefaultSingle-J,,0,0,0,,		キミにもいるんだろ　そういう人が
Dialogue: 1,0:44:46.08,0:44:47.89,DefaultSingle-J,,0,0,0,,		キミの拳が危険を呼び
Dialogue: 1,0:44:48.04,0:44:50.56,DefaultSingle-J,,0,0,0,,		愛する人が傷つくかもしれない
Dialogue: 1,0:44:51.01,0:44:54.42,DefaultSingle-J,,0,0,0,,		そんなことになったら　キミはどうする
Dialogue: 1,0:44:59.49,0:45:01.37,DefaultSingle-J,,0,0,0,,		明日の試合も楽しみにしているよ
Dialogue: 1,0:45:13.48,0:45:14.31,DefaultSingle-J,,0,0,0,,		まだ何か
Dialogue: 1,0:45:17.03,0:45:18.36,DefaultSingle-J,,0,0,0,,		あ　おつかれさま
Dialogue: 1,0:45:18.72,0:45:19.83,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:45:20.42,0:45:23.23,DefaultSingle-J,,0,0,0,,		もう　なかなか来ないから見に来ちゃった
Dialogue: 1,0:45:23.54,0:45:25.37,DefaultSingle-J,,0,0,0,,		すみません　お待たせして
Dialogue: 1,0:45:25.57,0:45:27.86,DefaultSingle-J,,0,0,0,,		じゃ　みんなでお昼食べに行こう
Dialogue: 1,0:45:28.06,0:45:29.99,DefaultSingle-J,,0,0,0,,		わたし行きたいお店があって
Dialogue: 1,0:45:29.99,0:45:31.08,DefaultSingle-J,,0,0,0,,		ごめん　園子
Dialogue: 1,0:45:31.44,0:45:33.21,DefaultSingle-J,,0,0,0,,		食事は2人で行ってきて
Dialogue: 1,0:45:33.21,0:45:34.76,DefaultSingle-J,,0,0,0,,		え　なんでよ
Dialogue: 1,0:45:34.76,0:45:35.85,DefaultSingle-J,,0,0,0,,		ほんとごめん
Dialogue: 1,0:45:36.38,0:45:40.39,DefaultSingle-J,,0,0,0,,		でも新一　宝石の警護でここ離れられそうもないから
Dialogue: 1,0:45:40.61,0:45:41.94,DefaultSingle-J,,0,0,0,,		そっか
Dialogue: 1,0:45:42.34,0:45:44.74,DefaultSingle-J,,0,0,0,,		んじゃあ　しょうがないわね
Dialogue: 1,0:45:44.74,0:45:46.88,DefaultSingle-J,,0,0,0,,		2人で行こっか　真さん
Dialogue: 1,0:45:47.13,0:45:47.61,DefaultSingle-J,,0,0,0,,		はい
Dialogue: 1,0:45:48.18,0:45:49.76,DefaultSingle-J,,0,0,0,,		また後でね　蘭
Dialogue: 1,0:45:50.35,0:45:51.57,DefaultSingle-J,,0,0,0,,		お先に失礼します
Dialogue: 1,0:45:51.89,0:45:54.57,DefaultSingle-J,,0,0,0,,		真さんにいっぱい食べてほしくてね
Dialogue: 1,0:45:54.57,0:45:55.57,DefaultSingle-J,,0,0,0,,		ありがとうございます
Dialogue: 1,0:47:10.29,0:47:11.29,DefaultSingle-J,,0,0,0,,		さてと
Dialogue: 1,0:47:14.20,0:47:16.02,DefaultSingle-J,,0,0,0,,		お宝は頂くぜ
Dialogue: 1,0:47:35.51,0:47:36.58,DefaultSingle-J,,0,0,0,,		いただき
Dialogue: 1,0:47:40.28,0:47:41.65,DefaultSingle-J,,0,0,0,,		なんか引っかかったか
Dialogue: 1,0:47:49.38,0:47:51.35,DefaultSingle-J,,0,0,0,,		死体　しかも
Dialogue: 1,0:47:52.87,0:47:53.66,DefaultSingle-J,,0,0,0,,		レイチェル？
Dialogue: 1,0:47:55.02,0:47:57.40,DefaultSingle-J,,0,0,0,,		やべえ　すぐにズラからねぇと
Dialogue: 1,0:48:01.72,0:48:02.95,DefaultSingle-J,,0,0,0,,		何か文字が
Dialogue: 1,0:48:05.48,0:48:06.15,DefaultSingle-J,,0,0,0,,		しまった
Dialogue: 1,0:48:31.81,0:48:35.39,DefaultSingle-J,,0,0,0,,		ったく　一体いつまで待たせるんだ　レイチェルさん
Dialogue: 1,0:48:35.64,0:48:37.14,DefaultSingle-J,,0,0,0,,		あと10分待って
Dialogue: 1,0:48:38.51,0:48:39.72,DefaultSingle-J,,0,0,0,,		な　なんだ
Dialogue: 1,0:48:39.95,0:48:41.50,DefaultSingle-J,,0,0,0,,		もしかしてキッドが
Dialogue: 1,0:48:41.97,0:48:43.07,DefaultSingle-J,,0,0,0,,		おい　待てよ
Dialogue: 1,0:48:49.44,0:48:50.82,DefaultSingle-J,,0,0,0,,		こりゃやべぇな
Dialogue: 1,0:48:51.17,0:48:54.10,DefaultSingle-J,,0,0,0,,		だけど　外に出られればこっちのもんさ
Dialogue: 1,0:49:02.16,0:49:03.83,DefaultSingle-J,,0,0,0,,		こんなにいたのかよ
Dialogue: 1,0:49:13.22,0:49:14.30,DefaultSingle-J,,0,0,0,,		おい　待て
Dialogue: 1,0:49:24.37,0:49:26.28,DefaultSingle-J,,0,0,0,,		おいおい　大丈夫かよ
Dialogue: 1,0:49:26.66,0:49:29.28,DefaultSingle-J,,0,0,0,,		いた　毛利さん　捜していたんです
Dialogue: 1,0:49:29.59,0:49:32.17,DefaultSingle-J,,0,0,0,,		いやあ　えらいことになったな
Dialogue: 1,0:49:32.45,0:49:35.28,DefaultSingle-J,,0,0,0,,		こんな白昼堂々とキッドが現れるとは
Dialogue: 1,0:49:35.74,0:49:37.22,DefaultSingle-J,,0,0,0,,		まっ　ご安心を
Dialogue: 1,0:49:37.53,0:49:41.52,DefaultSingle-J,,0,0,0,,		この名探偵毛利小五郎　すぐさま追跡を開始して　たちどころに
Dialogue: 1,0:49:40.06,0:49:41.52,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	それどころじゃないんです
Dialogue: 1,0:49:42.18,0:49:43.97,DefaultSingle-J,,0,0,0,,		大変なことが起こったんです
Dialogue: 1,0:49:44.26,0:49:46.14,DefaultSingle-J,,0,0,0,,		今すぐ金庫室に来てください
Dialogue: 1,0:50:02.61,0:50:04.10,DefaultSingle-J,,0,0,0,,		ここまで来れば
Dialogue: 1,0:50:14.10,0:50:15.54,DefaultSingle-J,,0,0,0,,		こっ　これは
Dialogue: 1,0:50:16.13,0:50:19.22,DefaultSingle-J,,0,0,0,,		被害者はレオン先生の秘書　レイチェルさんです
Dialogue: 1,0:50:19.22,0:50:20.51,DefaultSingle-J,,0,0,0,,		レイチェルさん？
Dialogue: 1,0:50:22.32,0:50:23.08,DefaultSingle-J,,0,0,0,,		そうか
Dialogue: 1,0:50:23.65,0:50:25.24,DefaultSingle-J,,0,0,0,,		監視カメラは調べたのか
Dialogue: 1,0:50:25.54,0:50:26.33,DefaultSingle-J,,0,0,0,,		ダメです
Dialogue: 1,0:50:26.52,0:50:29.60,DefaultSingle-J,,0,0,0,,		ハッキングされ　無人状態で撮られた映像が
Dialogue: 1,0:50:29.60,0:50:32.03,DefaultSingle-J,,0,0,0,,		くり返し送信されるようになっていました
Dialogue: 1,0:50:32.63,0:50:34.96,DefaultSingle-J,,0,0,0,,		それで　犯人の目星は
Dialogue: 1,0:50:34.96,0:50:36.22,DefaultSingle-J,,0,0,0,,		もちろんついています
Dialogue: 1,0:50:36.68,0:50:38.93,DefaultSingle-J,,0,0,0,,		今全力を挙げて追跡中ですから
Dialogue: 1,0:50:39.17,0:50:40.81,DefaultSingle-J,,0,0,0,,		追跡中って
Dialogue: 1,0:50:41.20,0:50:41.85,DefaultSingle-J,,0,0,0,,		つまり
Dialogue: 1,0:50:42.15,0:50:44.83,DefaultSingle-J,,0,0,0,,		犯人は怪盗キッドに間違いありません
Dialogue: 1,0:50:45.26,0:50:49.50,DefaultSingle-J,,0,0,0,,		なんにせよ警備装置を解除しとかなかったのは落ち度だぜ　キッド
Dialogue: 1,0:50:50.65,0:50:53.41,DefaultSingle-J,,0,0,0,,		ねぇねぇ　本当ならその時間
Dialogue: 1,0:50:53.41,0:50:57.71,DefaultSingle-J,,0,0,0,,		レイチェルさんはこのおじさんとの待ち合わせで　スタジアムに来てたはずだよね
Dialogue: 1,0:50:58.20,0:51:00.12,DefaultSingle-J,,0,0,0,,		どうして金庫室にいたの
Dialogue: 1,0:51:00.41,0:51:02.49,DefaultSingle-J,,0,0,0,,		あ　そういやそうだな
Dialogue: 1,0:51:02.89,0:51:04.96,DefaultSingle-J,,0,0,0,,		金庫室前にいた警官によれば
Dialogue: 1,0:51:05.34,0:51:08.08,DefaultSingle-J,,0,0,0,,		アイダン警部補の用事を伝えに来たそうです
Dialogue: 1,0:51:08.65,0:51:12.20,DefaultSingle-J,,0,0,0,,		急用らしくて　それを優先したんじゃないでしょうか
Dialogue: 1,0:51:12.66,0:51:15.09,DefaultSingle-J,,0,0,0,,		その後すぐにあの騒ぎでしたから
Dialogue: 1,0:51:15.41,0:51:18.88,DefaultSingle-J,,0,0,0,,		でもキッドが殺人なんて　聞いたことねぇぞ
Dialogue: 1,0:51:21.47,0:51:23.42,DefaultSingle-J,,0,0,0,,		おい　勝手に入るな
Dialogue: 1,0:51:23.68,0:51:25.63,DefaultSingle-J,,0,0,0,,		こいつまた　まったく
Dialogue: 1,0:51:28.38,0:51:30.43,DefaultSingle-J,,0,0,0,,		ねぇ　この血文字だけど
Dialogue: 1,0:51:30.43,0:51:31.18,DefaultSingle-J,,0,0,0,,		こら
Dialogue: 1,0:51:32.40,0:51:34.01,DefaultSingle-J,,0,0,0,,		ガキはすっ込んでろ
Dialogue: 1,0:51:40.65,0:51:41.60,DefaultSingle-J,,0,0,0,,		これを見てください
Dialogue: 1,0:51:42.16,0:51:42.76,DefaultSingle-J,,0,0,0,,		なるほど
Dialogue: 1,0:51:44.33,0:51:46.53,DefaultSingle-J,,0,0,0,,		完全にハメられやがったな
Dialogue: 1,0:51:47.38,0:51:47.97,DefaultSingle-J,,0,0,0,,		キッド
Dialogue: 1,0:51:54.02,0:51:55.01,DefaultSingle-J,,0,0,0,,		上等だ
Dialogue: 1,0:51:55.69,0:51:59.96,DefaultSingle-J,,0,0,0,,		お　面白くなってきたじゃねぇか
Dialogue: 1,0:52:02.24,0:52:04.69,DefaultSingle-J,,0,0,0,,		さすが園子さんのセレクトだけあって
Dialogue: 1,0:52:04.98,0:52:06.77,DefaultSingle-J,,0,0,0,,		チキンライスもスイカジュースも
Dialogue: 1,0:52:07.03,0:52:08.37,DefaultSingle-J,,0,0,0,,		とてもおいしかったです
Dialogue: 1,0:52:08.37,0:52:09.30,DefaultSingle-J,,0,0,0,,		でしょ
Dialogue: 1,0:52:12.53,0:52:13.15,DefaultSingle-J,,0,0,0,,		何か
Dialogue: 1,0:52:14.26,0:52:16.93,DefaultSingle-J,,0,0,0,,		さ　さて　おなかも膨れたことだし
Dialogue: 1,0:52:17.54,0:52:20.90,DefaultSingle-J,,0,0,0,,		真さん　わたし行きたい所があるんだけど
Dialogue: 1,0:52:21.08,0:52:22.48,DefaultSingle-J,,0,0,0,,		どこにでもお供します
Dialogue: 1,0:52:34.10,0:52:36.63,DefaultSingle-J,,0,0,0,,		ぶ　ぶつかってきたのそっちでしょ
Dialogue: 1,0:52:57.06,0:52:59.07,DefaultSingle-J,,0,0,0,,		他にも仲間が潜んでいるかもしれません
Dialogue: 1,0:52:59.70,0:53:02.20,DefaultSingle-J,,0,0,0,,		園子さん　自分から離れないでください
Dialogue: 1,0:53:02.58,0:53:03.91,DefaultSingle-J,,0,0,0,,		う　うん
Dialogue: 1,0:53:14.24,0:53:16.17,DefaultSingle-J,,0,0,0,,		キミの拳が危険を呼び
Dialogue: 1,0:53:16.33,0:53:18.75,DefaultSingle-J,,0,0,0,,		愛する人が傷つくかもしれない
Dialogue: 1,0:53:33.00,0:53:33.76,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:53:56.23,0:53:57.13,DefaultSingle-J,,0,0,0,,		見つけた
Dialogue: 1,0:53:57.78,0:53:59.09,DefaultSingle-J,,0,0,0,,		助けてください
Dialogue: 1,0:54:28.12,0:54:29.08,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:54:37.67,0:54:38.52,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:54:46.95,0:54:47.66,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:54:48.88,0:54:49.71,DefaultSingle-J,,0,0,0,,		園子さん
Dialogue: 1,0:54:50.73,0:54:53.51,DefaultSingle-J,,0,0,0,,		園子さん　園子さん
Dialogue: 1,0:55:02.57,0:55:04.28,DefaultSingle-J,,0,0,0,,		ケガの状態はどうだって
Dialogue: 1,0:55:04.87,0:55:06.70,DefaultSingle-J,,0,0,0,,		命に別状はないって
Dialogue: 1,0:55:07.22,0:55:08.82,DefaultSingle-J,,0,0,0,,		今は眠ってるから
Dialogue: 1,0:55:09.13,0:55:11.85,DefaultSingle-J,,0,0,0,,		今夜は入院して　明日検査するそうよ
Dialogue: 1,0:55:13.84,0:55:15.06,DefaultSingle-J,,0,0,0,,		本当によかった
Dialogue: 1,0:55:16.62,0:55:19.63,DefaultSingle-J,,0,0,0,,		にしても悪質なひき逃げなんて許せねぇ
Dialogue: 1,0:55:19.11,0:55:20.35,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	自分のせいです
Dialogue: 1,0:55:21.02,0:55:24.02,DefaultSingle-J,,0,0,0,,		自分のせいで　園子さんが
Dialogue: 1,0:55:26.26,0:55:27.35,DefaultSingle-J,,0,0,0,,		お待たせしました
Dialogue: 1,0:55:27.84,0:55:29.36,DefaultSingle-J,,0,0,0,,		遅くなりまして　すみません
Dialogue: 1,0:55:29.96,0:55:31.13,DefaultSingle-J,,0,0,0,,		おお　ご苦労さん
Dialogue: 1,0:55:31.84,0:55:33.13,DefaultSingle-J,,0,0,0,,		捜査の状況は？
Dialogue: 1,0:55:33.41,0:55:38.08,DefaultSingle-J,,0,0,0,,		はい　現場は人通りの少ない裏道で　目撃者もいなく
Dialogue: 1,0:55:38.51,0:55:41.24,DefaultSingle-J,,0,0,0,,		いえ　正確には人はいたのですが
Dialogue: 1,0:55:41.49,0:55:43.83,DefaultSingle-J,,0,0,0,,		パトカーを奪われる際に不意を突かれて
Dialogue: 1,0:55:43.99,0:55:45.36,DefaultSingle-J,,0,0,0,,		気絶させられていました
Dialogue: 1,0:55:51.01,0:55:52.36,DefaultSingle-J,,0,0,0,,		おジャマしてしまったかな
Dialogue: 1,0:55:52.95,0:55:55.34,DefaultSingle-J,,0,0,0,,		レオン先生　どうしてここに
Dialogue: 1,0:55:55.55,0:55:57.53,DefaultSingle-J,,0,0,0,,		事故のことを聞き　飛んできました
Dialogue: 1,0:55:57.86,0:55:59.68,DefaultSingle-J,,0,0,0,,		園子はまだ眠っていて
Dialogue: 1,0:56:00.37,0:56:02.35,DefaultSingle-J,,0,0,0,,		では　これをお渡しいただけますか
Dialogue: 1,0:56:02.65,0:56:03.87,DefaultSingle-J,,0,0,0,,		ありがとうございます
Dialogue: 1,0:56:07.86,0:56:11.12,DefaultSingle-J,,0,0,0,,		どうやら僕の心配が的中してしまったようだね
Dialogue: 1,0:56:12.00,0:56:15.07,DefaultSingle-J,,0,0,0,,		戦いの神が　キミに試練を与えているんだよ
Dialogue: 1,0:56:16.12,0:56:20.54,DefaultSingle-J,,0,0,0,,		キミにはまだ　拳をふるう心技体が備わっていないのだと
Dialogue: 1,0:56:22.13,0:56:24.56,DefaultSingle-J,,0,0,0,,		そうだ　キミにお守りをあげよう
Dialogue: 1,0:56:27.18,0:56:28.75,DefaultSingle-J,,0,0,0,,		ミサンガのようなものだよ
Dialogue: 1,0:56:29.81,0:56:30.77,DefaultSingle-J,,0,0,0,,		これが切れたら
Dialogue: 1,0:56:31.15,0:56:34.42,DefaultSingle-J,,0,0,0,,		心技体が備わったと神に認められた証し
Dialogue: 1,0:56:35.05,0:56:37.88,DefaultSingle-J,,0,0,0,,		だが　切れる前に挙をふるえば
Dialogue: 1,0:56:38.58,0:56:39.54,DefaultSingle-J,,0,0,0,,		分かっているよね
Dialogue: 1,0:56:45.17,0:56:47.45,DefaultSingle-J,,0,0,0,,		いててってえ
Dialogue: 1,0:56:48.54,0:56:50.13,DefaultSingle-J,,0,0,0,,		ひどくやられたな
Dialogue: 1,0:56:50.80,0:56:52.76,DefaultSingle-J,,0,0,0,,		この程度なんでもねぇよ
Dialogue: 1,0:56:52.88,0:56:55.17,DefaultSingle-J,,0,0,0,,		ったく　遠慮なく撃ちやがって
Dialogue: 1,0:56:55.60,0:56:57.41,DefaultSingle-J,,0,0,0,,		今回はしてやられたぜ
Dialogue: 1,0:56:58.45,0:57:01.84,DefaultSingle-J,,0,0,0,,		レイチェルさんの殺害はお前の仕業ってことになってる
Dialogue: 1,0:57:02.40,0:57:03.57,DefaultSingle-J,,0,0,0,,		すべてはワナだ
Dialogue: 1,0:57:04.50,0:57:06.62,DefaultSingle-J,,0,0,0,,		お前に罪をかぶせるためのな
Dialogue: 1,0:57:06.95,0:57:09.02,DefaultSingle-J,,0,0,0,,		まるでマジックだな
Dialogue: 1,0:57:09.31,0:57:11.57,DefaultSingle-J,,0,0,0,,		オレはそこに存在しねぇのに
Dialogue: 1,0:57:12.31,0:57:15.64,DefaultSingle-J,,0,0,0,,		観客にはまさにオレが殺人犯として
Dialogue: 1,0:57:15.85,0:57:17.89,DefaultSingle-J,,0,0,0,,		その場にいたかのように見えてる
Dialogue: 1,0:57:18.43,0:57:20.49,DefaultSingle-J,,0,0,0,,		つまり視点を入れ替えれば
Dialogue: 1,0:57:20.82,0:57:22.68,DefaultSingle-J,,0,0,0,,		タネが見えてくるって寸法か
Dialogue: 1,0:57:24.93,0:57:25.68,DefaultSingle-J,,0,0,0,,		ああ
Dialogue: 1,0:57:26.23,0:57:30.94,DefaultSingle-J,,0,0,0,,		握った拳の中に　まるで何かがあるかのように思わせるのがマジシャンで
Dialogue: 1,0:57:31.50,0:57:34.93,DefaultSingle-J,,0,0,0,,		その拳を開く前に中身を言い当てるのが
Dialogue: 1,0:57:35.10,0:57:35.99,DefaultSingle-J,,0,0,0,,		探偵だろ
Dialogue: 1,0:57:45.28,0:57:47.80,DefaultSingle-J,,0,0,0,,		中身を言い当ててくれよ　名探偵
Dialogue: 1,0:57:48.72,0:57:52.46,DefaultSingle-J,,0,0,0,,		殺人という名の　謎めいた拳の中身をな
Dialogue: 1,0:57:54.04,0:57:54.75,DefaultSingle-J,,0,0,0,,		ったく
Dialogue: 1,0:58:07.50,0:58:09.92,DefaultSingle-J,,0,0,0,,		ぼうや　まだ帰ってなかったのかい
Dialogue: 1,0:58:10.19,0:58:13.06,DefaultSingle-J,,0,0,0,,		ねぇ　今夜ひと晩泊めてくれない
Dialogue: 1,0:58:13.06,0:58:15.19,DefaultSingle-J,,0,0,0,,		え　僕のうちにかい
Dialogue: 1,0:58:15.66,0:58:18.25,DefaultSingle-J,,0,0,0,,		うちに帰ってもボク1人なんだ
Dialogue: 1,0:58:19.14,0:58:22.35,DefaultSingle-J,,0,0,0,,		あんなことがあったばかりだし　怖くって
Dialogue: 1,0:58:23.04,0:58:24.66,DefaultSingle-J,,0,0,0,,		リシさんと一緒って言えば
Dialogue: 1,0:58:24.91,0:58:27.49,DefaultSingle-J,,0,0,0,,		お父さんたちも安心すると思うんだ
Dialogue: 1,0:58:30.22,0:58:34.03,DefaultSingle-J,,0,0,0,,		あいつと２日続けて同じ部屋とか最悪だしな
Dialogue: 1,0:58:41.58,0:58:42.72,DefaultSingle-J,,0,0,0,,		うわっ　すごい
Dialogue: 1,0:58:42.99,0:58:46.20,DefaultSingle-J,,0,0,0,,		これみんなリシさんのお父さんがもらったものなの
Dialogue: 1,0:58:46.36,0:58:49.31,DefaultSingle-J,,0,0,0,,		そうだよ　親父は海洋学者でね
Dialogue: 1,0:58:49.31,0:58:51.29,DefaultSingle-J,,0,0,0,,		5年前に亡くなってしまったんだけど
Dialogue: 1,0:58:51.58,0:58:55.13,DefaultSingle-J,,0,0,0,,		研究の過程で海に沈んだ遺跡を見つけたりしていたんだ
Dialogue: 1,0:58:55.40,0:58:57.14,DefaultSingle-J,,0,0,0,,		自慢のお父さんだね
Dialogue: 1,0:58:57.29,0:58:57.79,DefaultSingle-J,,0,0,0,,		うん
Dialogue: 1,0:58:58.63,0:59:00.94,DefaultSingle-J,,0,0,0,,		じゃあ　僕はまだ仕事が残ってるから
Dialogue: 1,0:59:01.12,0:59:02.89,DefaultSingle-J,,0,0,0,,		アーサー君は先に寝ててくれ
Dialogue: 1,0:59:03.40,0:59:04.18,DefaultSingle-J,,0,0,0,,		は一い
Dialogue: 1,0:59:06.08,0:59:07.12,DefaultSingle-J,,0,0,0,,		ねぇ　リシさん
Dialogue: 1,0:59:07.46,0:59:10.14,DefaultSingle-J,,0,0,0,,		この地図に付いてる赤い印はなぁに
Dialogue: 1,0:59:11.25,0:59:14.40,DefaultSingle-J,,0,0,0,,		これは海賊に船が襲われた場所を示しているんだ
Dialogue: 1,0:59:14.89,0:59:16.78,DefaultSingle-J,,0,0,0,,		海賊って今でもいるの
Dialogue: 1,0:59:17.06,0:59:17.79,DefaultSingle-J,,0,0,0,,		いるさ
Dialogue: 1,0:59:18.15,0:59:21.10,DefaultSingle-J,,0,0,0,,		昔はシンガポールの近くにもたくさんいたんだよ
Dialogue: 1,0:59:21.62,0:59:23.54,DefaultSingle-J,,0,0,0,,		ま　目下の悩みは
Dialogue: 1,0:59:23.82,0:59:26.67,DefaultSingle-J,,0,0,0,,		海賊なんかより殺害事件なんだよなぁ
Dialogue: 1,0:59:27.07,0:59:28.72,DefaultSingle-J,,0,0,0,,		それに怪盗キッド
Dialogue: 1,0:59:29.06,0:59:31.71,DefaultSingle-J,,0,0,0,,		アイダン警部補から資料は借りたんだけど
Dialogue: 1,0:59:33.71,0:59:35.98,DefaultSingle-J,,0,0,0,,		今夜は徹夜だぞっと
Dialogue: 1,0:59:41.69,0:59:45.06,DefaultSingle-J,,0,0,0,,		リシさんには申し訳ねぇけど　ひと眠りしてもらうよ
Dialogue: 1,1:00:06.89,1:00:08.38,DefaultSingle-J,,0,0,0,,		ねぇ　それ何
Dialogue: 1,1:00:09.05,1:00:10.38,DefaultSingle-J,,0,0,0,,		そんなのしてたっけ
Dialogue: 1,1:00:10.71,1:00:12.73,DefaultSingle-J,,0,0,0,,		園子さん　気がついたんですか
Dialogue: 1,1:00:13.92,1:00:15.42,DefaultSingle-J,,0,0,0,,		実は結構前から
Dialogue: 1,1:00:16.90,1:00:18.78,DefaultSingle-J,,0,0,0,,		よかったです　本当に
Dialogue: 1,1:00:19.29,1:00:21.60,DefaultSingle-J,,0,0,0,,		ねぇ　それ何かのおまじない
Dialogue: 1,1:00:21.82,1:00:24.60,DefaultSingle-J,,0,0,0,,		えっ　ええ　そのようなものです
Dialogue: 1,1:00:29.51,1:00:31.95,DefaultSingle-J,,0,0,0,,		ダメですよ　ゆっくり休んでください
Dialogue: 1,1:00:33.60,1:00:35.59,DefaultSingle-J,,0,0,0,,		全然眠くないのよね
Dialogue: 1,1:00:36.17,1:00:38.83,DefaultSingle-J,,0,0,0,,		せっかくシンガポールまで来たのに　つまんない
Dialogue: 1,1:00:39.14,1:00:40.92,DefaultSingle-J,,0,0,0,,		ムリをすると体にさわります
Dialogue: 1,1:00:41.09,1:00:42.91,DefaultSingle-J,,0,0,0,,		今夜はおとなしくしていてください
Dialogue: 1,1:00:45.12,1:00:47.63,DefaultSingle-J,,0,0,0,,		ねぇ　前から聞きたかったんだけど
Dialogue: 1,1:00:47.63,1:00:50.42,DefaultSingle-J,,0,0,0,,		その左眉の絆創膏なんで取らないの
Dialogue: 1,1:00:51.77,1:00:55.17,DefaultSingle-J,,0,0,0,,		い　いや　これはなんでもありません　本当に
Dialogue: 1,1:01:47.72,1:01:49.51,DefaultSingle-J,,0,0,0,,		やられたらやり返す
Dialogue: 1,1:01:49.91,1:01:51.59,DefaultSingle-J,,0,0,0,,		それがオレの流儀でね
Dialogue: 1,1:02:18.01,1:02:19.54,DefaultSingle-J,,0,0,0,,		大会を棄権した？
Dialogue: 1,1:02:19.83,1:02:21.46,DefaultSingle-J,,0,0,0,,		なんでよ　わたしのせい？
Dialogue: 1,1:02:21.98,1:02:25.72,DefaultSingle-J,,0,0,0,,		我々を襲った連中がまた襲ってこないとも限りませんので
Dialogue: 1,1:02:26.28,1:02:28.72,DefaultSingle-J,,0,0,0,,		園子さんのそばから離れるわけには
Dialogue: 1,1:02:30.16,1:02:31.76,DefaultSingle-J,,0,0,0,,		やっぱわたしのせいじゃない
Dialogue: 1,1:02:32.16,1:02:35.57,DefaultSingle-J,,0,0,0,,		大会に出てよ　戦いたい相手がいるんでしょ
Dialogue: 1,1:02:36.13,1:02:36.78,DefaultSingle-J,,0,0,0,,		ええ
Dialogue: 1,1:02:37.82,1:02:40.86,DefaultSingle-J,,0,0,0,,		ですが　園子さん1人守れなかった自分には
Dialogue: 1,1:02:41.00,1:02:42.97,DefaultSingle-J,,0,0,0,,		まだ何か欠けていると感じ
Dialogue: 1,1:02:45.13,1:02:46.73,DefaultSingle-J,,0,0,0,,		そりゃ欠けてるでしょうね
Dialogue: 1,1:02:47.77,1:02:49.72,DefaultSingle-J,,0,0,0,,		真さん隠し事ばっかだし
Dialogue: 1,1:02:49.94,1:02:50.84,DefaultSingle-J,,0,0,0,,		隠し事？
Dialogue: 1,1:02:51.09,1:02:53.59,DefaultSingle-J,,0,0,0,,		ミサンガのことも　絆創膏のことも
Dialogue: 1,1:02:53.59,1:02:54.95,DefaultSingle-J,,0,0,0,,		教えてくれないじゃない
Dialogue: 1,1:02:55.63,1:02:58.61,DefaultSingle-J,,0,0,0,,		いえ　これは　ほんとにその
Dialogue: 1,1:02:59.83,1:03:00.55,DefaultSingle-J,,0,0,0,,		出てって
Dialogue: 1,1:03:01.62,1:03:05.22,DefaultSingle-J,,0,0,0,,		そんな偽りだらけの男に守られたくなんかないわ
Dialogue: 1,1:03:08.49,1:03:10.81,DefaultSingle-J,,0,0,0,,		昨日はほんと心配したんだからね
Dialogue: 1,1:03:10.98,1:03:12.99,DefaultSingle-J,,0,0,0,,		ずっと連絡取れなくなっちゃってさ
Dialogue: 1,1:03:13.21,1:03:14.17,DefaultSingle-J,,0,0,0,,		わりぃ　わりぃ
Dialogue: 1,1:03:14.36,1:03:16.91,DefaultSingle-J,,0,0,0,,		キッドを追いかけるのに夢中になっちまって
Dialogue: 1,1:03:17.08,1:03:19.06,DefaultSingle-J,,0,0,0,,		さすが月下の奇術師だぜ
Dialogue: 1,1:03:19.44,1:03:22.95,DefaultSingle-J,,0,0,0,,		この工藤新一をもってしても捕らえるのはムリ
Dialogue: 1,1:03:25.27,1:03:26.57,DefaultSingle-J,,0,0,0,,		あら　アーサー君
Dialogue: 1,1:03:26.93,1:03:27.75,DefaultSingle-J,,0,0,0,,		こんにちは
Dialogue: 1,1:03:28.35,1:03:31.32,DefaultSingle-J,,0,0,0,,		お友達の園子お姉さんは大丈夫だった？
Dialogue: 1,1:03:31.51,1:03:36.08,DefaultSingle-J,,0,0,0,,		うん　さっき病院に寄ってきたんだけど検査の結果問題ないって
Dialogue: 1,1:03:36.41,1:03:39.08,DefaultSingle-J,,0,0,0,,		午後には退院して　ホテルに戻るみたいよ
Dialogue: 1,1:03:39.38,1:03:40.78,DefaultSingle-J,,0,0,0,,		へえ　よかったね
Dialogue: 1,1:03:41.05,1:03:42.66,DefaultSingle-J,,0,0,0,,		心配してくれてありがと
Dialogue: 1,1:03:43.33,1:03:44.93,DefaultSingle-J,,0,0,0,,		じゃあ　そろそろホテルに戻ろ
Dialogue: 1,1:03:45.26,1:03:46.98,DefaultSingle-J,,0,0,0,,		帰りの荷物まとめたいし
Dialogue: 1,1:03:47.21,1:03:49.63,DefaultSingle-J,,0,0,0,,		園子お姉さんたちはほっといていいの
Dialogue: 1,1:03:49.95,1:03:52.52,DefaultSingle-J,,0,0,0,,		うん　しばらくそっとしとこうかなって
Dialogue: 1,1:03:52.95,1:03:55.14,DefaultSingle-J,,0,0,0,,		あの2人なんかモメてたっぽいから
Dialogue: 1,1:03:55.38,1:03:58.02,DefaultSingle-J,,0,0,0,,		京極さんも試合棄権しちゃったし
Dialogue: 1,1:03:59.59,1:04:01.11,DefaultSingle-J,,0,0,0,,		あれ　新一？
Dialogue: 1,1:04:05.30,1:04:07.90,DefaultSingle-J,,0,0,0,,		で　ゆうべの収穫はあったのか　名探偵
Dialogue: 1,1:04:08.69,1:04:11.66,DefaultSingle-J,,0,0,0,,		リシさんの家で見た捜査資料によると　こうだ
Dialogue: 1,1:04:17.11,1:04:18.93,DefaultSingle-J,,0,0,0,,		目撃者の証言によると
Dialogue: 1,1:04:18.93,1:04:22.33,DefaultSingle-J,,0,0,0,,		シェリリンさんが刺されたのは倒れたショッピングモールではなく
Dialogue: 1,1:04:22.56,1:04:25.29,DefaultSingle-J,,0,0,0,,		タワー3のエレベーターの中ではないかということだ
Dialogue: 1,1:04:25.94,1:04:27.77,DefaultSingle-J,,0,0,0,,		なんでわざわざエレベーターの中で
Dialogue: 1,1:04:28.19,1:04:30.22,DefaultSingle-J,,0,0,0,,		ヘタすれば逃げ場がないのにな
Dialogue: 1,1:04:34.27,1:04:36.96,DefaultSingle-J,,0,0,0,,		彼女は背中を市販のナイフで刺されたまま
Dialogue: 1,1:04:36.96,1:04:38.78,DefaultSingle-J,,0,0,0,,		ショッピングモールまで移動
Dialogue: 1,1:04:42.07,1:04:43.54,DefaultSingle-J,,0,0,0,,		そして倒れた直後
Dialogue: 1,1:04:45.30,1:04:47.69,DefaultSingle-J,,0,0,0,,		地下駐車場で彼女の車が爆発
Dialogue: 1,1:04:48.36,1:04:50.96,DefaultSingle-J,,0,0,0,,		その影響でホテル全体が停電する
Dialogue: 1,1:04:51.49,1:04:55.90,DefaultSingle-J,,0,0,0,,		これでホテル内にある防犯カメラの映像はすべて消えてしまったってわけか
Dialogue: 1,1:04:56.41,1:04:59.03,DefaultSingle-J,,0,0,0,,		気になるのは現場にレオンがいたことだ
Dialogue: 1,1:04:59.51,1:05:02.65,DefaultSingle-J,,0,0,0,,		彼は自分の部屋とシェリリンさんの部屋まで手配してた
Dialogue: 1,1:05:03.43,1:05:05.29,DefaultSingle-J,,0,0,0,,		だが彼女が殺害された時
Dialogue: 1,1:05:05.29,1:05:08.30,DefaultSingle-J,,0,0,0,,		別のエレベーターに乗っていたとの目撃者も多数
Dialogue: 1,1:05:08.97,1:05:10.76,DefaultSingle-J,,0,0,0,,		アリバイが確認されたため
Dialogue: 1,1:05:10.76,1:05:13.43,DefaultSingle-J,,0,0,0,,		捜査線上からは外されたってことか
Dialogue: 1,1:05:13.65,1:05:14.47,DefaultSingle-J,,0,0,0,,		そのとおり
Dialogue: 1,1:05:14.74,1:05:18.19,DefaultSingle-J,,0,0,0,,		そういえば　どうしてレオンはスーツケースを持っていたんだ
Dialogue: 1,1:05:18.39,1:05:21.06,DefaultSingle-J,,0,0,0,,		ああ　もちろんこの中も警察は調べたが
Dialogue: 1,1:05:21.99,1:05:23.19,DefaultSingle-J,,0,0,0,,		中身はカラ
Dialogue: 1,1:05:23.39,1:05:26.95,DefaultSingle-J,,0,0,0,,		スーツケースは修理に出していたものを引き取ってきただけだった
Dialogue: 1,1:05:27.59,1:05:31.13,DefaultSingle-J,,0,0,0,,		ホテルの近くの店が依頼を受けていたことも確認済み
Dialogue: 1,1:05:31.94,1:05:33.71,DefaultSingle-J,,0,0,0,,		アリバイは完璧か
Dialogue: 1,1:05:34.07,1:05:35.00,DefaultSingle-J,,0,0,0,,		あとは1つ
Dialogue: 1,1:05:35.47,1:05:36.26,DefaultSingle-J,,0,0,0,,		こいつだ
Dialogue: 1,1:05:36.93,1:05:39.76,DefaultSingle-J,,0,0,0,,		なぜこんなものが現場に残されていたのか
Dialogue: 1,1:05:40.17,1:05:41.99,DefaultSingle-J,,0,0,0,,		オレを巻き込む必要がどこにある
Dialogue: 1,1:05:42.36,1:05:45.03,DefaultSingle-J,,0,0,0,,		しかもわざわざ血のりを塗ってまでな
Dialogue: 1,1:05:45.45,1:05:46.03,DefaultSingle-J,,0,0,0,,		んで
Dialogue: 1,1:05:48.67,1:05:51.73,DefaultSingle-J,,0,0,0,,		レイチェルさん殺しの罪もお前に着せようとしてる
Dialogue: 1,1:05:52.14,1:05:55.40,DefaultSingle-J,,0,0,0,,		凶器のナイフはシェリリンさん殺しの時と同じものだった
Dialogue: 1,1:05:56.53,1:06:01.02,DefaultSingle-J,,0,0,0,,		レイチェルさんはオレが金庫室に入る前から台座の中に入れられていた
Dialogue: 1,1:06:01.43,1:06:03.20,DefaultSingle-J,,0,0,0,,		だが部屋に入るには
Dialogue: 1,1:06:03.20,1:06:06.63,DefaultSingle-J,,0,0,0,,		警備員や　いくつもの防犯装置を突破しなくてはならない
Dialogue: 1,1:06:06.98,1:06:08.57,DefaultSingle-J,,0,0,0,,		警備の目をかいくぐり
Dialogue: 1,1:06:08.57,1:06:11.27,DefaultSingle-J,,0,0,0,,		センサーにも触れずに侵入できる者
Dialogue: 1,1:06:12.14,1:06:13.29,DefaultSingle-J,,0,0,0,,		いや　オレじゃねぇよ
Dialogue: 1,1:06:14.66,1:06:17.01,DefaultSingle-J,,0,0,0,,		疑わしいのはやはりレオン・ローだ
Dialogue: 1,1:06:17.75,1:06:19.82,DefaultSingle-J,,0,0,0,,		金庫室の管理者のレオンなら
Dialogue: 1,1:06:19.82,1:06:21.67,DefaultSingle-J,,0,0,0,,		警備システムも熟知している
Dialogue: 1,1:06:22.38,1:06:26.00,DefaultSingle-J,,0,0,0,,		さらにベルトがスタジアムに搬入されたのは昨日の午前中だ
Dialogue: 1,1:06:26.54,1:06:30.47,DefaultSingle-J,,0,0,0,,		そしてレイチェルさんはおとといの夜までは生存が確認されている
Dialogue: 1,1:06:30.85,1:06:32.90,DefaultSingle-J,,0,0,0,,		つまり犯行はその夜から
Dialogue: 1,1:06:32.90,1:06:35.13,DefaultSingle-J,,0,0,0,,		ベルトが運ばれる前の可能性が高い
Dialogue: 1,1:06:36.22,1:06:37.57,DefaultSingle-J,,0,0,0,,		だが　なんのために
Dialogue: 1,1:06:37.89,1:06:40.77,DefaultSingle-J,,0,0,0,,		自分の秘書をどうして殺害する必要があったんだ
Dialogue: 1,1:06:41.16,1:06:43.57,DefaultSingle-J,,0,0,0,,		もしかすると動機はあれかもしれない
Dialogue: 1,1:06:44.39,1:06:47.95,DefaultSingle-J,,0,0,0,,		レイチェルさんはおっちゃんに何かを伝えようとしてた
Dialogue: 1,1:06:48.82,1:06:51.52,DefaultSingle-J,,0,0,0,,		残された手がかりはあの血文字だ
Dialogue: 1,1:06:51.65,1:06:54.90,DefaultSingle-J,,0,0,0,,		She　彼女　誰のことだ
Dialogue: 1,1:07:06.48,1:07:09.63,DefaultSingle-J,,0,0,0,,		ダメだ　何かとてつもないことが起こりそうなのに
Dialogue: 1,1:07:09.82,1:07:11.10,DefaultSingle-J,,0,0,0,,		考えがまとまらねぇ
Dialogue: 1,1:07:11.69,1:07:14.04,DefaultSingle-J,,0,0,0,,		さすがの名探偵もお手上げか
Dialogue: 1,1:07:14.66,1:07:16.58,DefaultSingle-J,,0,0,0,,		ならひとまず休憩しょうぜ
Dialogue: 1,1:07:17.31,1:07:19.00,DefaultSingle-J,,0,0,0,,		ちなみにどちらの拳に何が
Dialogue: 1,1:07:19.00,1:07:21.28,DefaultSingle-J,,0,0,0,,		左の拳にココナツウォーター
Dialogue: 1,1:07:22.00,1:07:23.06,DefaultSingle-J,,0,0,0,,		正解
Dialogue: 1,1:07:23.38,1:07:24.59,DefaultSingle-J,,0,0,0,,		どうして分かったんだ
Dialogue: 1,1:07:24.79,1:07:26.23,DefaultSingle-J,,0,0,0,,		さっき買ってただろ
Dialogue: 1,1:07:26.39,1:07:27.50,DefaultSingle-J,,0,0,0,,		見られてたか
Dialogue: 1,1:07:28.54,1:07:29.72,DefaultSingle-J,,0,0,0,,		マジックか
Dialogue: 1,1:07:30.69,1:07:35.41,DefaultSingle-J,,0,0,0,,		握った拳の中に　まるで何かがあるかのように思わせるのがマジシャンで
Dialogue: 1,1:07:35.71,1:07:39.21,DefaultSingle-J,,0,0,0,,		その拳を開く前に中身を言い当てるのが
Dialogue: 1,1:07:39.21,1:07:40.13,DefaultSingle-J,,0,0,0,,		探偵だろ
Dialogue: 1,1:07:41.42,1:07:42.47,DefaultSingle-J,,0,0,0,,		なるほどな
Dialogue: 1,1:07:43.13,1:07:45.04,DefaultSingle-J,,0,0,0,,		そういや　園子お嬢様
Dialogue: 1,1:07:45.70,1:07:47.66,DefaultSingle-J,,0,0,0,,		あの空手野郎とモメてんのか
Dialogue: 1,1:07:47.96,1:07:48.92,DefaultSingle-J,,0,0,0,,		らしいな
Dialogue: 1,1:07:49.70,1:07:52.42,DefaultSingle-J,,0,0,0,,		まあ　旅先で乱闘騒ぎに交通事故じゃ
Dialogue: 1,1:07:52.92,1:07:55.04,DefaultSingle-J,,0,0,0,,		気持ちも不安定になるか
Dialogue: 1,1:07:55.67,1:07:57.13,DefaultSingle-J,,0,0,0,,		そういうことか
Dialogue: 1,1:07:57.99,1:07:59.64,DefaultSingle-J,,0,0,0,,		園子にケガを負わせて
Dialogue: 1,1:07:59.79,1:08:01.95,DefaultSingle-J,,0,0,0,,		京極さんを精神的に揺さぶる
Dialogue: 1,1:08:02.37,1:08:04.17,DefaultSingle-J,,0,0,0,,		ジャマルッディンを優勝させるのに
Dialogue: 1,1:08:04.17,1:08:06.80,DefaultSingle-J,,0,0,0,,		最も障害となるのが京極さんだからな
Dialogue: 1,1:08:07.31,1:08:08.48,DefaultSingle-J,,0,0,0,,		なるほど
Dialogue: 1,1:08:08.76,1:08:10.92,DefaultSingle-J,,0,0,0,,		あの事故もレオンが仕掛けたってわけね
Dialogue: 1,1:08:11.31,1:08:14.20,DefaultSingle-J,,0,0,0,,		狙いどおり京極さんは大会を棄権した
Dialogue: 1,1:08:14.48,1:08:17.53,DefaultSingle-J,,0,0,0,,		これでチャンピオンベルトは間達いなくジャマルッディンのもの
Dialogue: 1,1:08:17.78,1:08:21.00,DefaultSingle-J,,0,0,0,,		つまり　雇い主であるレオンの手に渡るということだ
Dialogue: 1,1:08:21.56,1:08:23.58,DefaultSingle-J,,0,0,0,,		紺青の拳と共にな
Dialogue: 1,1:08:23.83,1:08:27.75,DefaultSingle-J,,0,0,0,,		だがなぜレオンは紺青の拳にそこまでこだわるのか
Dialogue: 1,1:08:27.93,1:08:30.63,DefaultSingle-J,,0,0,0,,		そのヒントになりそうなものをつかんだぜ
Dialogue: 1,1:08:31.40,1:08:33.41,DefaultSingle-J,,0,0,0,,		明け方レオンが会っていた男だ
Dialogue: 1,1:08:33.90,1:08:35.74,DefaultSingle-J,,0,0,0,,		こいつの身元を突き止められないか
Dialogue: 1,1:08:36.36,1:08:38.81,DefaultSingle-J,,0,0,0,,		まあ　できなくはねぇけど
Dialogue: 1,1:08:39.92,1:08:41.01,DefaultSingle-J,,0,0,0,,		あなたねぇ
Dialogue: 1,1:08:41.18,1:08:44.53,DefaultSingle-J,,0,0,0,,		やっぱ北海道に行くって突然博士に電話してきたっきり
Dialogue: 1,1:08:44.53,1:08:45.58,DefaultSingle-J,,0,0,0,,		今何してんの
Dialogue: 1,1:08:46.04,1:08:47.11,DefaultSingle-J,,0,0,0,,		わりぃ　灰原
Dialogue: 1,1:08:47.11,1:08:48.25,DefaultSingle-J,,0,0,0,,		こっちもいろいろあって
Dialogue: 1,1:08:48.44,1:08:50.57,DefaultSingle-J,,0,0,0,,		あんたたち　ちょっと静かにしてて
Dialogue: 1,1:08:50.70,1:08:51.95,DefaultSingle-J,,0,0,0,,		はーい
Dialogue: 1,1:08:51.95,1:08:53.03,DefaultSingle-J,,0,0,0,,		まったく
Dialogue: 1,1:08:53.03,1:08:55.67,DefaultSingle-J,,0,0,0,,		どうせまたどこかで事件に巻き込まれてるんでしょ
Dialogue: 1,1:08:56.13,1:08:57.43,DefaultSingle-J,,0,0,0,,		実はそのとおりでさ
Dialogue: 1,1:08:58.40,1:09:01.33,DefaultSingle-J,,0,0,0,,		今キッドの撮った写真のデータをそっちに送ったんだけど
Dialogue: 1,1:09:01.83,1:09:04.04,DefaultSingle-J,,0,0,0,,		キッド？今キッドって言った
Dialogue: 1,1:09:04.33,1:09:06.83,DefaultSingle-J,,0,0,0,,		ウソ　怪盗キッドが出たの
Dialogue: 1,1:09:06.83,1:09:08.52,DefaultSingle-J,,0,0,0,,		電話　コナン君ですよね
Dialogue: 1,1:09:08.82,1:09:11.38,DefaultSingle-J,,0,0,0,,		コナン君が今いるのって北海道でしたっけ
Dialogue: 1,1:09:11.58,1:09:13.58,DefaultSingle-J,,0,0,0,,		キッドが何盗むんだよ
Dialogue: 1,1:09:13.98,1:09:15.55,DefaultSingle-J,,0,0,0,,		木彫りのクマさんとか
Dialogue: 1,1:09:15.55,1:09:17.01,DefaultSingle-J,,0,0,0,,		札幌ラーメンかな
Dialogue: 1,1:09:17.01,1:09:18.76,DefaultSingle-J,,0,0,0,,		そんなの盗みませんよ
Dialogue: 1,1:09:19.17,1:09:20.26,DefaultSingle-J,,0,0,0,,		哀ちゃん
Dialogue: 1,1:09:20.61,1:09:21.96,DefaultSingle-J,,0,0,0,,		電話代わってください
Dialogue: 1,1:09:21.96,1:09:22.80,DefaultSingle-J,,0,0,0,,		オレも
Dialogue: 1,1:09:24.72,1:09:27.42,DefaultSingle-J,,0,0,0,,		ごめん　今子供たちが遊びに来てて
Dialogue: 1,1:09:27.42,1:09:28.25,DefaultSingle-J,,0,0,0,,		ああ　そっか
Dialogue: 1,1:09:28.63,1:09:30.51,DefaultSingle-J,,0,0,0,,		詳しい話は帰ってからするから
Dialogue: 1,1:09:30.69,1:09:33.54,DefaultSingle-J,,0,0,0,,		今はそれに映ってる男の身元を調べてほしんだ
Dialogue: 1,1:09:34.35,1:09:35.88,DefaultSingle-J,,0,0,0,,		はいはい　分かったわ
Dialogue: 1,1:09:36.32,1:09:38.69,DefaultSingle-J,,0,0,0,,		で　あなたほんとに大丈夫なのね
Dialogue: 1,1:09:39.03,1:09:40.50,DefaultSingle-J,,0,0,0,,		ああ　なんとかな
Dialogue: 1,1:09:41.11,1:09:43.52,DefaultSingle-J,,0,0,0,,		どうせ言ってもムダなんでしょうけど
Dialogue: 1,1:09:43.52,1:09:44.70,DefaultSingle-J,,0,0,0,,		無茶しないように
Dialogue: 1,1:09:44.88,1:09:45.55,DefaultSingle-J,,0,0,0,,		サンキユー
Dialogue: 1,1:09:47.27,1:09:48.24,DefaultSingle-J,,0,0,0,,		これで大丈夫だ
Dialogue: 1,1:09:48.75,1:09:50.90,DefaultSingle-J,,0,0,0,,		で　この後どうする　名探偵
Dialogue: 1,1:09:52.03,1:09:53.05,DefaultSingle-J,,0,0,0,,		様子を見る
Dialogue: 1,1:09:53.26,1:09:56.35,DefaultSingle-J,,0,0,0,,		紺青の拳を手に入れたレオンがどう動くのか
Dialogue: 1,1:09:57.20,1:09:58.71,DefaultSingle-J,,0,0,0,,		だがその前におっちゃんだ
Dialogue: 1,1:09:59.59,1:10:01.12,DefaultSingle-J,,0,0,0,,		お　おい　待てよ
Dialogue: 1,1:11:25.43,1:11:28.01,DefaultSingle-J,,0,0,0,,		キミとはよくよく縁でつながっているな
Dialogue: 1,1:11:28.55,1:11:32.25,DefaultSingle-J,,0,0,0,,		この計画が成功した暁には互いにパートナーだ
Dialogue: 1,1:11:32.66,1:11:34.02,DefaultSingle-J,,0,0,0,,		よろしく頼むよ
Dialogue: 1,1:11:34.43,1:11:36.56,DefaultSingle-J,,0,0,0,,		あんたにはずいぶんと世話になった
Dialogue: 1,1:11:36.99,1:11:40.69,DefaultSingle-J,,0,0,0,,		盗みの疑いをかけられて警察に連れて行かれそうになった俺を
Dialogue: 1,1:11:41.15,1:11:43.64,DefaultSingle-J,,0,0,0,,		あんたが助けてくれたのが最初だった
Dialogue: 1,1:11:43.98,1:11:46.02,DefaultSingle-J,,0,0,0,,		それからもまあ　いろいろとな
Dialogue: 1,1:11:47.35,1:11:50.33,DefaultSingle-J,,0,0,0,,		キミがあの中富禮次郎と分かったものだからね
Dialogue: 1,1:11:50.90,1:11:55.04,DefaultSingle-J,,0,0,0,,		日本の海運王と呼ばれた中富十三の息子の
Dialogue: 1,1:11:55.24,1:11:57.67,DefaultSingle-J,,0,0,0,,		親父の名前は口にしないでくれ
Dialogue: 1,1:11:57.81,1:11:59.66,DefaultSingle-J,,0,0,0,,		あ　これは失敬
Dialogue: 1,1:12:00.27,1:12:01.17,DefaultSingle-J,,0,0,0,,		いずれにせよ
Dialogue: 1,1:12:01.61,1:12:03.28,DefaultSingle-J,,0,0,0,,		今夜ですべてが変わる
Dialogue: 1,1:12:04.19,1:12:06.77,DefaultSingle-J,,0,0,0,,		その瞬間を間近で見物するのはどうだい
Dialogue: 1,1:12:09.63,1:12:10.85,DefaultSingle-J,,0,0,0,,		さあ　共に行こう
Dialogue: 1,1:12:11.48,1:12:15.56,DefaultSingle-J,,0,0,0,,		シンガポールの歴史に刻む1ページの目撃者となるために
Dialogue: 1,1:12:20.68,1:12:21.83,DefaultSingle-J,,0,0,0,,		わりぃな　おっちゃん
Dialogue: 1,1:12:23.12,1:12:24.23,DefaultSingle-J,,0,0,0,,		な　なんだ　いきなり
Dialogue: 1,1:12:26.19,1:12:27.70,DefaultSingle-J,,0,0,0,,		いや　やめて　エッチ
Dialogue: 1,1:12:28.66,1:12:29.23,DefaultSingle-J,,0,0,0,,		これだ
Dialogue: 1,1:12:31.78,1:12:32.55,DefaultSingle-J,,0,0,0,,		中富？
Dialogue: 1,1:12:33.17,1:12:35.95,DefaultSingle-J,,0,0,0,,		中富って　中富海運のことか
Dialogue: 1,1:12:36.41,1:12:37.08,DefaultSingle-J,,0,0,0,,		おそらく
Dialogue: 1,1:12:37.61,1:12:39.69,DefaultSingle-J,,0,0,0,,		おっちゃん　これ借りてくぜ
Dialogue: 1,1:12:42.84,1:12:46.28,DefaultSingle-J,,0,0,0,,		今　おっちゃんって言わなかったか　あのガキ
Dialogue: 1,1:12:48.03,1:12:50.22,DefaultSingle-J,,0,0,0,,		突然日本を離れるのはなぜですか？
Dialogue: 1,1:12:50.42,1:12:52.23,DefaultSingle-J,,0,0,0,,		バカンスだよ　バカンス
Dialogue: 1,1:12:52.60,1:12:55.14,DefaultSingle-J,,0,0,0,,		シンガポールには５年前にもいかれてますよね
Dialogue: 1,1:12:55.28,1:12:58.03,DefaultSingle-J,,0,0,0,,		ああ　それ以来だ　それが？
Dialogue: 1,1:12:58.53,1:13:02.76,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	中富社長には現在　政治家への贈賄疑惑がかけられており
Dialogue: 1,1:13:02.99,1:13:04.94,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	福島議員との関係性を
Dialogue: 1,1:12:59.86,1:13:01.79,DefaultSingle-J,,0,0,0,,		マーライオン広場にいたヤツか
Dialogue: 1,1:13:01.99,1:13:04.44,DefaultSingle-J,,0,0,0,,		あの空手野郎にやられたけどな
Dialogue: 1,1:13:07.85,1:13:08.65,DefaultSingle-J,,0,0,0,,		灰原か
Dialogue: 1,1:13:09.31,1:13:10.89,DefaultSingle-J,,0,0,0,,		例の男の正体分かったか
Dialogue: 1,1:13:11.22,1:13:12.91,DefaultSingle-J,,0,0,0,,		ええ　なんとかね
Dialogue: 1,1:13:13.32,1:13:16.65,DefaultSingle-J,,0,0,0,,		名前はユージーン・リム　なんとびっくり海賊よ
Dialogue: 1,1:13:16.92,1:13:17.72,DefaultSingle-J,,0,0,0,,		海賊？
Dialogue: 1,1:13:17.89,1:13:21.03,DefaultSingle-J,,0,0,0,,		最近はシンガポールでの目撃情報があるわね
Dialogue: 1,1:13:21.38,1:13:23.79,DefaultSingle-J,,0,0,0,,		さすが灰原　頼りになるぜ
Dialogue: 1,1:13:24.13,1:13:25.72,DefaultSingle-J,,0,0,0,,		おだてるってことは
Dialogue: 1,1:13:25.96,1:13:28.50,DefaultSingle-J,,0,0,0,,		まだ何か調べてほしいことがあるのかしら
Dialogue: 1,1:13:28.85,1:13:29.63,DefaultSingle-J,,0,0,0,,		あっ　ああ
Dialogue: 1,1:13:31.31,1:13:35.11,DefaultSingle-J,,0,0,0,,		中富禮次郎って名前聞いたことあるか　中富海運の
Dialogue: 1,1:13:35.35,1:13:36.11,DefaultSingle-J,,0,0,0,,		知ってるわ
Dialogue: 1,1:13:37.44,1:13:40.63,DefaultSingle-J,,0,0,0,,		中富海運が所有する船の状況が知りたい
Dialogue: 1,1:13:41.02,1:13:43.29,DefaultSingle-J,,0,0,0,,		シンガポール周辺にいる船だけでいい
Dialogue: 1,1:13:47.19,1:13:50.68,DefaultSingle-J,,0,0,0,,		シンガポール周辺には貨物船が２隻とタンカーが１隻
Dialogue: 1,1:13:51.16,1:13:52.47,DefaultSingle-J,,0,0,0,,		ちょっと気になるのは
Dialogue: 1,1:13:52.68,1:13:55.15,DefaultSingle-J,,0,0,0,,		そのタンカーが予定の航路を外れてること
Dialogue: 1,1:13:55.50,1:13:58.26,DefaultSingle-J,,0,0,0,,		そいつだ　そのタンカーのデータを送ってくれ
Dialogue: 1,1:13:58.53,1:14:00.60,DefaultSingle-J,,0,0,0,,		オッケー　また連絡する
Dialogue: 1,1:14:00.90,1:14:01.45,DefaultSingle-J,,0,0,0,,		頼む
Dialogue: 1,1:14:02.56,1:14:03.95,DefaultSingle-J,,0,0,0,,		タンカーがどうかしたのか
Dialogue: 1,1:14:04.50,1:14:06.84,DefaultSingle-J,,0,0,0,,		レイチェルの残したsheの文字だよ
Dialogue: 1,1:14:08.21,1:14:10.52,DefaultSingle-J,,0,0,0,,		sheは船を表す単語でもある
Dialogue: 1,1:14:17.25,1:14:19.35,DefaultSingle-J,,0,0,0,,		電話の話は本当なのか
Dialogue: 1,1:14:19.82,1:14:23.25,DefaultSingle-J,,0,0,0,,		今起きているすべてがレオン先生の企てだなんて
Dialogue: 1,1:14:23.94,1:14:26.03,DefaultSingle-J,,0,0,0,,		僕にも分かるよう説明してほしい
Dialogue: 1,1:14:26.96,1:14:30.27,DefaultSingle-J,,0,0,0,,		発端はジョンハン・チェンが見つけたブルーサファイア
Dialogue: 1,1:14:30.45,1:14:31.54,DefaultSingle-J,,0,0,0,,		紺青の拳
Dialogue: 1,1:14:32.30,1:14:35.24,DefaultSingle-J,,0,0,0,,		彼はそれを空手トーナメントのベルトにはめ込み
Dialogue: 1,1:14:35.24,1:14:37.01,DefaultSingle-J,,0,0,0,,		優勝者に進呈するとした
Dialogue: 1,1:14:37.61,1:14:40.15,DefaultSingle-J,,0,0,0,,		レオンさんはジャマルッディンさんを出場させ
Dialogue: 1,1:14:40.15,1:14:42.06,DefaultSingle-J,,0,0,0,,		宝石を手に入れようとしたんだよ
Dialogue: 1,1:14:42.98,1:14:45.39,DefaultSingle-J,,0,0,0,,		ところが　思わぬ横やりが入った
Dialogue: 1,1:14:45.99,1:14:49.93,DefaultSingle-J,,0,0,0,,		空手400戦無敗　京極真の大会エントリーだ
Dialogue: 1,1:14:50.56,1:14:54.38,DefaultSingle-J,,0,0,0,,		彼を招待した者　それが殺害されたシェリリン・タンさん
Dialogue: 1,1:14:54.54,1:14:56.70,DefaultSingle-J,,0,0,0,,		ど　動機がそうだとしても
Dialogue: 1,1:14:56.92,1:14:58.79,DefaultSingle-J,,0,0,0,,		レオン先生にはアリバイがある
Dialogue: 1,1:14:59.05,1:15:00.52,DefaultSingle-J,,0,0,0,,		彼女が刺された時
Dialogue: 1,1:15:00.52,1:15:02.44,DefaultSingle-J,,0,0,0,,		別のエレベーターに乗ってたんだから
Dialogue: 1,1:15:03.11,1:15:04.39,DefaultSingle-J,,0,0,0,,		真相はこうさ
Dialogue: 1,1:15:05.02,1:15:06.75,DefaultSingle-J,,0,0,0,,		レオンとプールサイドで会った後
Dialogue: 1,1:15:07.05,1:15:10.48,DefaultSingle-J,,0,0,0,,		彼女は自分の部屋に戻るためにエレベーターに乗った
Dialogue: 1,1:15:11.91,1:15:16.37,DefaultSingle-J,,0,0,0,,		だが　彼女が宿泊していたタワー3の部屋は16階
Dialogue: 1,1:15:17.18,1:15:18.36,DefaultSingle-J,,0,0,0,,		ホテルの構造上
Dialogue: 1,1:15:18.36,1:15:21.45,DefaultSingle-J,,0,0,0,,		34階で必ず乗り換えなければ戻れなかった
Dialogue: 1,1:15:22.55,1:15:24.77,DefaultSingle-J,,0,0,0,,		彼女は自分の部屋に戻る途中に
Dialogue: 1,1:15:25.44,1:15:27.64,DefaultSingle-J,,0,0,0,,		別の部屋へと連れ込まれてしまった
Dialogue: 1,1:15:28.40,1:15:29.97,DefaultSingle-J,,0,0,0,,		秘書レイチェルによって
Dialogue: 1,1:15:30.75,1:15:33.58,DefaultSingle-J,,0,0,0,,		レイチェルが共犯者？まさか
Dialogue: 1,1:15:34.34,1:15:38.05,DefaultSingle-J,,0,0,0,,		レオンがその日　プールサイドの宿泊者専用のレストランに
Dialogue: 1,1:15:38.05,1:15:41.37,DefaultSingle-J,,0,0,0,,		入るためだけに取った部屋は　34階だった
Dialogue: 1,1:15:43.09,1:15:45.35,DefaultSingle-J,,0,0,0,,		そして　降りてきたレオンは
Dialogue: 1,1:15:45.35,1:15:47.62,DefaultSingle-J,,0,0,0,,		その部屋でシェリリンさんを刺殺
Dialogue: 1,1:15:49.44,1:15:51.13,DefaultSingle-J,,0,0,0,,		遺体をトランクに入れた
Dialogue: 1,1:15:51.89,1:15:55.28,DefaultSingle-J,,0,0,0,,		その後　レイチェルとレオンは　別々のエレベーターに乗った
Dialogue: 1,1:15:55.98,1:15:59.26,DefaultSingle-J,,0,0,0,,		トリックに使われたのは　マジックナイフの一種だろうな
Dialogue: 1,1:15:59.70,1:16:02.29,DefaultSingle-J,,0,0,0,,		ただし　血はシェリリンさん本人のもの
Dialogue: 1,1:16:03.11,1:16:04.12,DefaultSingle-J,,0,0,0,,		First　floor
Dialogue: 1,1:16:07.20,1:16:09.34,DefaultSingle-J,,0,0,0,,		刺されたフリをしたレイチェルは倒れる
Dialogue: 1,1:16:11.78,1:16:12.67,DefaultSingle-J,,0,0,0,,		その直後
Dialogue: 1,1:16:16.45,1:16:21.20,DefaultSingle-J,,0,0,0,,		すべては　爆発による停電の中　人知れず行われた
Dialogue: 1,1:16:36.69,1:16:37.60,DefaultSingle-J,,0,0,0,,		そんな
Dialogue: 1,1:16:38.47,1:16:41.34,DefaultSingle-J,,0,0,0,,		レオンの真の計画を知ってしまったレイチェルは
Dialogue: 1,1:16:41.91,1:16:45.93,DefaultSingle-J,,0,0,0,,		その恐ろしさに　毛利探偵にー切を打ち明ける気でいたんだ
Dialogue: 1,1:16:46.46,1:16:48.21,DefaultSingle-J,,0,0,0,,		それをレオンに気づかれた
Dialogue: 1,1:16:48.87,1:16:52.32,DefaultSingle-J,,0,0,0,,		金庫室に来たレイチェルさんはキッドの変装だったんだ
Dialogue: 1,1:16:52.89,1:16:56.10,DefaultSingle-J,,0,0,0,,		キッドも利用されたんだよ　レオンさんの計画に
Dialogue: 1,1:16:57.05,1:17:00.00,DefaultSingle-J,,0,0,0,,		本物のレイチェルさんはもう殺害されていて
Dialogue: 1,1:17:00.00,1:17:01.93,DefaultSingle-J,,0,0,0,,		台座の中に押し込められていた
Dialogue: 1,1:17:02.75,1:17:05.59,DefaultSingle-J,,0,0,0,,		キッドがレイチェルさんに変装してやってくると読んで
Dialogue: 1,1:17:05.76,1:17:09.36,DefaultSingle-J,,0,0,0,,		アリバイ工作と事件をキッドの仕業に見せかけるためにね
Dialogue: 1,1:17:10.00,1:17:11.61,DefaultSingle-J,,0,0,0,,		そんなことがどうして
Dialogue: 1,1:17:11.89,1:17:15.23,DefaultSingle-J,,0,0,0,,		じゃあ　リシさんだったら誰に変装すれば安全だと思う
Dialogue: 1,1:17:16.14,1:17:19.06,DefaultSingle-J,,0,0,0,,		そうだなぁ　いくら上手に変装しても
Dialogue: 1,1:17:19.16,1:17:21.99,DefaultSingle-J,,0,0,0,,		本物とバッタリ出くわしたら意味ないし
Dialogue: 1,1:17:22.24,1:17:25.49,DefaultSingle-J,,0,0,0,,		あらかじめ何時にどこにいるか分かってる人がいいよね
Dialogue: 1,1:17:25.60,1:17:29.73,DefaultSingle-J,,0,0,0,,		そうか　レイチェルは午後3時に毛利さんと待ち合わせしていた
Dialogue: 1,1:17:30.06,1:17:30.79,DefaultSingle-J,,0,0,0,,		それで
Dialogue: 1,1:17:31.12,1:17:35.45,DefaultSingle-J,,0,0,0,,		そう　キッドは金庫室に来る恐れのない人物に変装する
Dialogue: 1,1:17:35.45,1:17:39.36,DefaultSingle-J,,0,0,0,,		そう読んだレオンさんのワナにまんまとハマったってわけだよ
Dialogue: 1,1:17:41.17,1:17:42.15,DefaultSingle-J,,0,0,0,,		教えてくれ
Dialogue: 1,1:17:42.52,1:17:44.68,DefaultSingle-J,,0,0,0,,		先生は何をしようとしているんだ
Dialogue: 1,1:17:45.03,1:17:47.41,DefaultSingle-J,,0,0,0,,		すべてはバカげた計画のためだよ
Dialogue: 1,1:17:47.93,1:17:51.85,DefaultSingle-J,,0,0,0,,		レオンはユージーン・リムという海賊の首領と接触していて
Dialogue: 1,1:17:52.44,1:17:56.01,DefaultSingle-J,,0,0,0,,		レイチェルの殺害現場の台座に残されていた文字は　she
Dialogue: 1,1:17:56.89,1:18:00.46,DefaultSingle-J,,0,0,0,,		そして　そのレイチェルが毛利探偵にひそかに託したのは
Dialogue: 1,1:18:00.46,1:18:02.07,DefaultSingle-J,,0,0,0,,		中富海運のメダル
Dialogue: 1,1:18:02.64,1:18:04.25,DefaultSingle-J,,0,0,0,,		すべて船にまつわるもの
Dialogue: 1,1:18:04.60,1:18:06.30,DefaultSingle-J,,0,0,0,,		それになんの関係が
Dialogue: 1,1:18:06.30,1:18:07.06,DefaultSingle-J,,0,0,0,,		リシさん
Dialogue: 1,1:18:08.05,1:18:11.34,DefaultSingle-J,,0,0,0,,		これは探偵のお兄さんが東京から送ってもらった
Dialogue: 1,1:18:11.56,1:18:15.04,DefaultSingle-J,,0,0,0,,		この周辺にいる中富所有の船の航路解析だよ
Dialogue: 1,1:18:15.82,1:18:18.91,DefaultSingle-J,,0,0,0,,		タンカーが1隻予定の航路を大きく外れてる
Dialogue: 1,1:18:19.56,1:18:22.29,DefaultSingle-J,,0,0,0,,		このまま進めば　行き先はマリーナベイ
Dialogue: 1,1:18:23.45,1:18:25.60,DefaultSingle-J,,0,0,0,,		レオンさんは海賊を使って
Dialogue: 1,1:18:25.60,1:18:27.93,DefaultSingle-J,,0,0,0,,		タンカーを街に突っ込ませるつもりなんだ
Dialogue: 1,1:18:32.81,1:18:36.55,DefaultSingle-J,,0,0,0,,		第一　先生がなぜそんなことをする必要があるんだ
Dialogue: 1,1:18:36.70,1:18:37.73,DefaultSingle-J,,0,0,0,,		その理由は
Dialogue: 1,1:18:38.65,1:18:41.28,DefaultSingle-J,,0,0,0,,		レオンさんがなんて言うかは知らないけどさ
Dialogue: 1,1:18:41.91,1:18:44.72,DefaultSingle-J,,0,0,0,,		この街を破壊して造り直すとしたら
Dialogue: 1,1:18:44.94,1:18:47.59,DefaultSingle-J,,0,0,0,,		莫大なお金が動くことだけは確かだ
Dialogue: 1,1:18:48.81,1:18:51.25,DefaultSingle-J,,0,0,0,,		レオンさんが紺青の拳にこだわったのは
Dialogue: 1,1:18:51.44,1:18:55.10,DefaultSingle-J,,0,0,0,,		海賊を思いどおりに操る引き換えとして必要だったから
Dialogue: 1,1:18:55.41,1:18:58.82,DefaultSingle-J,,0,0,0,,		だ　だけど　海賊は警察の目を逃れ
Dialogue: 1,1:18:58.82,1:19:00.26,DefaultSingle-J,,0,0,0,,		あちこちに散らばっている
Dialogue: 1,1:19:00.63,1:19:02.01,DefaultSingle-J,,0,0,0,,		どうやって連絡したんだ
Dialogue: 1,1:19:02.51,1:19:03.74,DefaultSingle-J,,0,0,0,,		マーライオンだよ
Dialogue: 1,1:19:04.42,1:19:07.38,DefaultSingle-J,,0,0,0,,		マーライオンが赤い水を吐く事件があったでしょ
Dialogue: 1,1:19:07.71,1:19:11.21,DefaultSingle-J,,0,0,0,,		世界的に報道されたから　海賊の目にも留まったはず
Dialogue: 1,1:19:11.53,1:19:13.66,DefaultSingle-J,,0,0,0,,		あれがきっと決行の合図だったんだ
Dialogue: 1,1:19:14.48,1:19:15.74,DefaultSingle-J,,0,0,0,,		でもそれより今は
Dialogue: 1,1:19:15.94,1:19:18.14,DefaultSingle-J,,0,0,0,,		そうだ　早くしないと手遅れになる
Dialogue: 1,1:19:18.35,1:19:20.81,DefaultSingle-J,,0,0,0,,		そう言われても僕の一存では
Dialogue: 1,1:19:21.11,1:19:24.03,DefaultSingle-J,,0,0,0,,		警察を動かすにも　もっと証拠が必要だ
Dialogue: 1,1:19:24.04,1:19:25.52,DefaultSingle-J,,0,0,0,,		それじゃ間に合わない
Dialogue: 1,1:19:25.52,1:19:26.82,DefaultSingle-J,,0,0,0,,		他に方法はないの？
Dialogue: 1,1:19:27.14,1:19:29.51,DefaultSingle-J,,0,0,0,,		そうだ　ジョンハン・チェン氏に相談しよう
Dialogue: 1,1:19:29.73,1:19:31.98,DefaultSingle-J,,0,0,0,,		彼なら軍や警察にも顔が利く
Dialogue: 1,1:19:32.28,1:19:34.24,DefaultSingle-J,,0,0,0,,		きっと力を貸してくれるはずだ
Dialogue: 1,1:19:34.53,1:19:36.04,DefaultSingle-J,,0,0,0,,		リシさん　もう1つだけ
Dialogue: 1,1:19:36.48,1:19:37.14,DefaultSingle-J,,0,0,0,,		なんだい
Dialogue: 1,1:19:37.91,1:19:40.74,DefaultSingle-J,,0,0,0,,		計画どおりにタンカーが街に突っ込んできたら
Dialogue: 1,1:19:40.97,1:19:43.30,DefaultSingle-J,,0,0,0,,		その時レオンさんはどこにいると思う？
Dialogue: 1,1:19:43.94,1:19:47.08,DefaultSingle-J,,0,0,0,,		そうだな　先生は慎重な人だから
Dialogue: 1,1:19:47.27,1:19:49.40,DefaultSingle-J,,0,0,0,,		どこか遠くで見物するだろうね
Dialogue: 1,1:19:49.83,1:19:52.65,DefaultSingle-J,,0,0,0,,		もしかすると　もう国内にはいないかもしれない
Dialogue: 1,1:19:53.22,1:19:54.41,DefaultSingle-J,,0,0,0,,		じゃあ　急ぐから
Dialogue: 1,1:19:55.66,1:19:56.42,DefaultSingle-J,,0,0,0,,		分かった
Dialogue: 1,1:19:56.95,1:19:57.64,DefaultSingle-J,,0,0,0,,		ありがとう
Dialogue: 1,1:20:06.00,1:20:08.43,DefaultSingle-J,,0,0,0,,		もう　お父さんどこにいるのよ
Dialogue: 1,1:20:08.58,1:20:10.21,DefaultSingle-J,,0,0,0,,		ショー始まっちゃうよ
Dialogue: 1,1:20:11.20,1:20:13.40,DefaultSingle-J,,0,0,0,,		新一もどっかに行っちゃったままだし
Dialogue: 1,1:20:16.28,1:20:17.80,DefaultSingle-J,,0,0,0,,		まったく今回の事件は
Dialogue: 1,1:20:18.06,1:20:19.83,DefaultSingle-J,,0,0,0,,		なんでオレが巻き込まれたんだ
Dialogue: 1,1:20:20.49,1:20:23.35,DefaultSingle-J,,0,0,0,,		シェリリンさん殺しの現場にオレのカードを残したのは
Dialogue: 1,1:20:23.35,1:20:24.76,DefaultSingle-J,,0,0,0,,		本当にレオンなのか
Dialogue: 1,1:20:25.58,1:20:26.19,DefaultSingle-J,,0,0,0,,		いいや
Dialogue: 1,1:20:27.47,1:20:30.08,DefaultSingle-J,,0,0,0,,		エレベーターに貼られたカードが見つかったのは
Dialogue: 1,1:20:30.08,1:20:32.49,DefaultSingle-J,,0,0,0,,		現場検証が始まってかなりたってから
Dialogue: 1,1:20:33.32,1:20:34.43,DefaultSingle-J,,0,0,0,,		なぜだと思う？
Dialogue: 1,1:20:36.69,1:20:38.80,DefaultSingle-J,,0,0,0,,		最新のタンカーの進路解析だ
Dialogue: 1,1:20:41.46,1:20:42.61,DefaultSingle-J,,0,0,0,,		なっ　何
Dialogue: 1,1:20:42.97,1:20:45.36,DefaultSingle-J,,0,0,0,,		まずい　このままだとタンカーがホテルに
Dialogue: 1,1:20:54.68,1:20:56.37,DefaultSingle-J,,0,0,0,,		Wow,　it's　amazing!
Dialogue: 1,1:21:07.13,1:21:09.49,DefaultSingle-J,,0,0,0,,		蘭　電話に出てくれ
Dialogue: 1,1:22:39.33,1:22:41.73,DefaultSingle-J,,0,0,0,,		おーい　蘭　楽しんでるか
Dialogue: 1,1:22:41.73,1:22:43.63,DefaultSingle-J,,0,0,0,,		お父さん　今どこ
Dialogue: 1,1:22:44.84,1:22:47.79,DefaultSingle-J,,0,0,0,,		なんだか知んないけど　でっかい船が見えるぞ
Dialogue: 1,1:22:48.66,1:22:50.25,DefaultSingle-J,,0,0,0,,		ねぇ　ちょっとお父さん
Dialogue: 1,1:22:51.07,1:22:52.29,DefaultSingle-J,,0,0,0,,		まさかホテルの上？
Dialogue: 1,1:22:52.70,1:22:54.39,DefaultSingle-J,,0,0,0,,		もしもし　もしもし
Dialogue: 1,1:23:02.86,1:23:04.44,DefaultSingle-J,,0,0,0,,		園子さん　園子さん
Dialogue: 1,1:23:05.74,1:23:06.23,DefaultSingle-J,,0,0,0,,		何
Dialogue: 1,1:23:06.75,1:23:08.30,DefaultSingle-J,,0,0,0,,		外で何かあったようです
Dialogue: 1,1:23:08.69,1:23:10.56,DefaultSingle-J,,0,0,0,,		ホテルを出たほうがいいのではないかと
Dialogue: 1,1:23:14.48,1:23:14.98,DefaultSingle-J,,0,0,0,,		はい
Dialogue: 1,1:23:16.19,1:23:17.53,DefaultSingle-J,,0,0,0,,		ええ　分かりました
Dialogue: 1,1:23:18.26,1:23:19.00,DefaultSingle-J,,0,0,0,,		誰からです？
Dialogue: 1,1:23:19.61,1:23:20.64,DefaultSingle-J,,0,0,0,,		警察の人
Dialogue: 1,1:23:20.87,1:23:24.04,DefaultSingle-J,,0,0,0,,		ヘタに外に出ると　また狙われるかもしれないから
Dialogue: 1,1:23:24.21,1:23:25.64,DefaultSingle-J,,0,0,0,,		部屋で待機していてって
Dialogue: 1,1:23:26.42,1:23:27.87,DefaultSingle-J,,0,0,0,,		護衛の人が来るみたい
Dialogue: 1,1:23:30.07,1:23:31.29,DefaultSingle-J,,0,0,0,,		し　しかし
Dialogue: 1,1:23:31.96,1:23:34.27,DefaultSingle-J,,0,0,0,,		いいの　わたしはここにいるから
Dialogue: 1,1:23:36.27,1:23:37.00,DefaultSingle-J,,0,0,0,,		分かりました
Dialogue: 1,1:23:47.12,1:23:49.82,DefaultSingle-J,,0,0,0,,		まずい　この人混みだとホテルに近づけねぇ
Dialogue: 1,1:23:50.95,1:23:52.79,DefaultSingle-J,,0,0,0,,		しゃあねぇ　一か八かだ
Dialogue: 1,1:24:06.08,1:24:07.99,DefaultSingle-J,,0,0,0,,		こりゃ貸し切りだな
Dialogue: 1,1:24:09.10,1:24:10.12,DefaultSingle-J,,0,0,0,,		な　なんだよ
Dialogue: 1,1:24:12.66,1:24:14.79,DefaultSingle-J,,0,0,0,,		ね　眠りの小五郎
Dialogue: 1,1:24:28.96,1:24:30.84,DefaultSingle-J,,0,0,0,,		ダメだ　つながらねぇ
Dialogue: 1,1:24:36.43,1:24:37.63,DefaultSingle-J,,0,0,0,,		わっ　やべぇ
Dialogue: 1,1:24:45.58,1:24:48.09,DefaultSingle-J,,0,0,0,,		もう　どこにいるのよ　お父さん
Dialogue: 1,1:25:18.77,1:25:19.47,DefaultSingle-J,,0,0,0,,		ま　待て
Dialogue: 1,1:25:22.03,1:25:22.97,DefaultSingle-J,,0,0,0,,		驚いたな
Dialogue: 1,1:25:23.29,1:25:25.82,DefaultSingle-J,,0,0,0,,		キミにここまでの能力があったとはね
Dialogue: 1,1:25:26.50,1:25:28.30,DefaultSingle-J,,0,0,0,,		私も読み切れなかったよ
Dialogue: 1,1:25:30.52,1:25:31.15,DefaultSingle-J,,0,0,0,,		リシ
Dialogue: 1,1:25:32.35,1:25:34.38,DefaultSingle-J,,0,0,0,,		こうなったら潔く認めよう
Dialogue: 1,1:25:34.82,1:25:37.23,DefaultSingle-J,,0,0,0,,		そう　これはすべて私の計画だ
Dialogue: 1,1:25:37.61,1:25:39.11,DefaultSingle-J,,0,0,0,,		少し話そうじゃないか
Dialogue: 1,1:25:39.56,1:25:41.74,DefaultSingle-J,,0,0,0,,		そんな物騒なものはしまってくれ
Dialogue: 1,1:25:42.68,1:25:46.00,DefaultSingle-J,,0,0,0,,		レオン先生こそ何か勘違いをしているんじゃないかな
Dialogue: 1,1:26:14.34,1:26:16.22,DefaultSingle-J,,0,0,0,,		タンカーが止まった　キッド
Dialogue: 1,1:26:16.52,1:26:17.98,DefaultSingle-J,,0,0,0,,		ここは警察に任せよう
Dialogue: 1,1:26:18.21,1:26:18.66,DefaultSingle-J,,0,0,0,,		ああ
Dialogue: 1,1:26:22.74,1:26:25.87,DefaultSingle-J,,0,0,0,,		お　おとなしくする　撃たないでくれ
Dialogue: 1,1:26:27.27,1:26:28.25,DefaultSingle-J,,0,0,0,,		助けて
Dialogue: 1,1:26:28.77,1:26:31.05,DefaultSingle-J,,0,0,0,,		殺さないでくれ
Dialogue: 1,1:26:32.10,1:26:34.38,DefaultSingle-J,,0,0,0,,		リシ君　まさか撃つとは
Dialogue: 1,1:26:48.39,1:26:49.39,DefaultSingle-J,,0,0,0,,		レオン先生
Dialogue: 1,1:26:49.83,1:26:52.90,DefaultSingle-J,,0,0,0,,		失礼ですが　少し腕が鈍ったんじゃないですか
Dialogue: 1,1:26:53.51,1:26:56.24,DefaultSingle-J,,0,0,0,,		世界を動かしていたのはあなたじゃない
Dialogue: 1,1:26:59.04,1:26:59.84,DefaultSingle-J,,0,0,0,,		僕さ
Dialogue: 1,1:27:00.93,1:27:03.00,DefaultSingle-J,,0,0,0,,		まさか　キミが
Dialogue: 1,1:27:03.80,1:27:06.02,DefaultSingle-J,,0,0,0,,		ま　待て　待ってくれ
Dialogue: 1,1:27:06.35,1:27:07.98,DefaultSingle-J,,0,0,0,,		こ　これをキミにやろう
Dialogue: 1,1:27:08.62,1:27:10.20,DefaultSingle-J,,0,0,0,,		中には宝石が入っている
Dialogue: 1,1:27:10.47,1:27:11.78,DefaultSingle-J,,0,0,0,,		いい取引だろう　リシ君
Dialogue: 1,1:27:25.15,1:27:26.29,DefaultSingle-J,,0,0,0,,		怪盗キッド
Dialogue: 1,1:27:28.01,1:27:29.87,DefaultSingle-J,,0,0,0,,		なんでここにアーサー君が
Dialogue: 1,1:27:31.10,1:27:34.47,DefaultSingle-J,,0,0,0,,		えっと　屋上へは34階で乗り換えなきゃいけないんだっけ
Dialogue: 1,1:27:34.65,1:27:35.90,DefaultSingle-J,,0,0,0,,		Thirtyfourth　floor!
Dialogue: 1,1:27:57.09,1:27:58.29,DefaultSingle-J,,0,0,0,,		何をするんだ
Dialogue: 1,1:27:58.47,1:28:01.54,DefaultSingle-J,,0,0,0,,		僕は首謀者である2人を捕まえようとしていたんだ
Dialogue: 1,1:28:01.98,1:28:04.85,DefaultSingle-J,,0,0,0,,		ヘタな芝居はやめるんだな　リシ・ラマナサン
Dialogue: 1,1:28:05.35,1:28:07.54,DefaultSingle-J,,0,0,0,,		あんたが黒幕だということは分かってる
Dialogue: 1,1:28:08.35,1:28:10.07,DefaultSingle-J,,0,0,0,,		最初に疑問を持ったのは
Dialogue: 1,1:28:10.26,1:28:12.63,DefaultSingle-J,,0,0,0,,		現場に残されていたキッドの予告状だ
Dialogue: 1,1:28:13.21,1:28:15.58,DefaultSingle-J,,0,0,0,,		警官が予告状に気づいたのは
Dialogue: 1,1:28:15.73,1:28:19.35,DefaultSingle-J,,0,0,0,,		リシ　あんたが現場に到着してすぐだったよな
Dialogue: 1,1:28:19.48,1:28:22.96,DefaultSingle-J,,0,0,0,,		そしてさっき　レオンさんはどこにいるか聞いた時
Dialogue: 1,1:28:22.96,1:28:25.11,DefaultSingle-J,,0,0,0,,		あんたへの疑いは決定的になったんだ
Dialogue: 1,1:28:25.57,1:28:26.12,DefaultSingle-J,,0,0,0,,		何
Dialogue: 1,1:28:26.63,1:28:29.13,DefaultSingle-J,,0,0,0,,		レオンさんほどのうぬぼれの強い人が
Dialogue: 1,1:28:29.53,1:28:32.87,DefaultSingle-J,,0,0,0,,		計画の達成を目前にして海外に逃げるわけがない
Dialogue: 1,1:28:33.70,1:28:36.89,DefaultSingle-J,,0,0,0,,		きっと一番見晴らしのいい場所で見物しているはず
Dialogue: 1,1:28:37.90,1:28:40.25,DefaultSingle-J,,0,0,0,,		そのことにあんたが気づかないはずがない
Dialogue: 1,1:28:41.55,1:28:44.50,DefaultSingle-J,,0,0,0,,		驚いたな　あれは僕を試したんだな
Dialogue: 1,1:28:44.66,1:28:46.09,DefaultSingle-J,,0,0,0,,		すべては5年前
Dialogue: 1,1:28:46.76,1:28:49.45,DefaultSingle-J,,0,0,0,,		お父さんの事故が計画の始まりだったんだね
Dialogue: 1,1:28:50.15,1:28:54.26,DefaultSingle-J,,0,0,0,,		海洋学者殺し否認の容疑者一転して罪を認める
Dialogue: 1,1:28:54.99,1:28:55.66,DefaultSingle-J,,0,0,0,,		確か
Dialogue: 1,1:28:57.49,1:29:01.27,DefaultSingle-J,,0,0,0,,		中富さんがシンガポールを訪れたのも5年前だったよね
Dialogue: 1,1:29:01.90,1:29:03.27,DefaultSingle-J,,0,0,0,,		いっ　いや　俺は
Dialogue: 1,1:29:03.71,1:29:05.72,DefaultSingle-J,,0,0,0,,		犯人をレオンさんが捕まえ
Dialogue: 1,1:29:05.72,1:29:08.78,DefaultSingle-J,,0,0,0,,		シェリリンさんが弁護し　有罪を認めさせた
Dialogue: 1,1:29:09.41,1:29:11.04,DefaultSingle-J,,0,0,0,,		ただの偶然だとは思えない
Dialogue: 1,1:29:11.49,1:29:12.57,DefaultSingle-J,,0,0,0,,		どういうことだ
Dialogue: 1,1:29:13.19,1:29:17.54,DefaultSingle-J,,0,0,0,,		中富海運が所有するタンカーを手に入れるためのワナだったのさ
Dialogue: 1,1:29:18.22,1:29:20.04,DefaultSingle-J,,0,0,0,,		すべては仕組まれていたんだ
Dialogue: 1,1:29:20.80,1:29:23.48,DefaultSingle-J,,0,0,0,,		そして　もう1つのワナがあったことに
Dialogue: 1,1:29:25.10,1:29:26.65,DefaultSingle-J,,0,0,0,,		あんたは気がついたんだろ
Dialogue: 1,1:29:27.59,1:29:29.91,DefaultSingle-J,,0,0,0,,		僕も最初は事故だと思っていた
Dialogue: 1,1:29:30.54,1:29:33.87,DefaultSingle-J,,0,0,0,,		だが　親父の遺品整理をしていて気づいたんだ
Dialogue: 1,1:29:34.31,1:29:38.56,DefaultSingle-J,,0,0,0,,		親父は海底遺跡を調査中　偶然　海賊王の証し
Dialogue: 1,1:29:38.94,1:29:43.15,DefaultSingle-J,,0,0,0,,		紺青の拳が眠っている可能性の高い沈没船を発見したんだ
Dialogue: 1,1:29:44.17,1:29:46.56,DefaultSingle-J,,0,0,0,,		だからまず親父を殺害したんだろ
Dialogue: 1,1:29:46.80,1:29:49.43,DefaultSingle-J,,0,0,0,,		先に宝石を引き上げさせないためにな
Dialogue: 1,1:29:59.20,1:30:03.59,DefaultSingle-J,,0,0,0,,		正義感の強い父なら　必ず助けに入るとにらんだんだろう
Dialogue: 1,1:30:14.19,1:30:17.45,DefaultSingle-J,,0,0,0,,		ど　どういうことだ　レオン　お前
Dialogue: 1,1:30:17.85,1:30:18.54,DefaultSingle-J,,0,0,0,,		離せ
Dialogue: 1,1:30:21.53,1:30:24.53,DefaultSingle-J,,0,0,0,,		リシ君　キミは何か誤解をしている
Dialogue: 1,1:30:25.19,1:30:27.40,DefaultSingle-J,,0,0,0,,		父上を殺害した犯人は刑務所へ
Dialogue: 1,1:30:27.40,1:30:29.60,DefaultSingle-J,,0,0,0,,		親父の死に疑問を持った僕は
Dialogue: 1,1:30:29.60,1:30:32.99,DefaultSingle-J,,0,0,0,,		この国であんたに弟子入りして　予備警察官になった
Dialogue: 1,1:30:33.36,1:30:35.63,DefaultSingle-J,,0,0,0,,		そして事故について調べ始めた
Dialogue: 1,1:30:36.35,1:30:39.10,DefaultSingle-J,,0,0,0,,		弁護を担当したシェリリン・タンに近づき
Dialogue: 1,1:30:39.36,1:30:43.00,DefaultSingle-J,,0,0,0,,		禮次郎の件をネタにレオンをゆすらないかと持ちかけたら
Dialogue: 1,1:30:43.22,1:30:44.82,DefaultSingle-J,,0,0,0,,		あっさり教えてくれたよ
Dialogue: 1,1:30:45.22,1:30:46.50,DefaultSingle-J,,0,0,0,,		そしてレイチェル
Dialogue: 1,1:30:46.71,1:30:51.89,DefaultSingle-J,,0,0,0,,		そう　彼女を通して　お前たちの情報は全て筒抜けだったのさ
Dialogue: 1,1:30:53.24,1:30:56.34,DefaultSingle-J,,0,0,0,,		ならばキッドの予告状を貼ったのはなぜだ
Dialogue: 1,1:30:56.79,1:30:58.27,DefaultSingle-J,,0,0,0,,		教えてもらおうか
Dialogue: 1,1:30:59.15,1:31:00.41,DefaultSingle-J,,0,0,0,,		紺青の拳
Dialogue: 1,1:31:00.77,1:31:03.07,DefaultSingle-J,,0,0,0,,		そして身に覚えのない殺人事件
Dialogue: 1,1:31:04.01,1:31:07.04,DefaultSingle-J,,0,0,0,,		この2つをぶら下げれば　怪盗はきっと来る
Dialogue: 1,1:31:07.53,1:31:10.28,DefaultSingle-J,,0,0,0,,		そしてお前たちの計画をジャマしてくれる
Dialogue: 1,1:31:11.52,1:31:14.66,DefaultSingle-J,,0,0,0,,		あの高校生探偵の登場は予定外だったが
Dialogue: 1,1:31:14.93,1:31:17.39,DefaultSingle-J,,0,0,0,,		しっかりと役目を果たしてくれたよ
Dialogue: 1,1:31:18.05,1:31:21.76,DefaultSingle-J,,0,0,0,,		中富さん　あんたは盗みの疑いをかけられたところを
Dialogue: 1,1:31:21.76,1:31:23.49,DefaultSingle-J,,0,0,0,,		レオンに救われたそうだが
Dialogue: 1,1:31:23.49,1:31:25.45,DefaultSingle-J,,0,0,0,,		果たしてそれは偶然かな
Dialogue: 1,1:31:26.11,1:31:27.64,DefaultSingle-J,,0,0,0,,		よく考えてみて
Dialogue: 1,1:31:27.98,1:31:31.10,DefaultSingle-J,,0,0,0,,		もしかすると　そのすべてが
Dialogue: 1,1:31:32.93,1:31:34.01,DefaultSingle-J,,0,0,0,,		貴様
Dialogue: 1,1:31:35.51,1:31:37.82,DefaultSingle-J,,0,0,0,,		よく調べ上げたな　リシ君
Dialogue: 1,1:31:43.36,1:31:45.54,DefaultSingle-J,,0,0,0,,		ここはどこだ　確か
Dialogue: 1,1:31:46.40,1:31:47.50,DefaultSingle-J,,0,0,0,,		お父さん
Dialogue: 1,1:31:52.73,1:31:53.33,DefaultSingle-J,,0,0,0,,		蘭
Dialogue: 1,1:31:53.97,1:31:54.45,DefaultSingle-J,,0,0,0,,		何
Dialogue: 1,1:31:58.95,1:32:00.42,DefaultSingle-J,,0,0,0,,		お　なんだ
Dialogue: 1,1:32:00.42,1:32:01.27,DefaultSingle-J,,0,0,0,,		お父さん
Dialogue: 1,1:32:04.65,1:32:05.24,DefaultSingle-J,,0,0,0,,		蘭
Dialogue: 1,1:32:14.08,1:32:15.57,DefaultSingle-J,,0,0,0,,		なんだ　お前ら
Dialogue: 1,1:32:17.17,1:32:18.19,DefaultSingle-J,,0,0,0,,		さて　リシ君
Dialogue: 1,1:32:18.92,1:32:20.87,DefaultSingle-J,,0,0,0,,		残念ながら形勢逆転だ
Dialogue: 1,1:32:39.83,1:32:40.64,DefaultSingle-J,,0,0,0,,		た　助けて
Dialogue: 1,1:32:56.78,1:32:58.28,DefaultSingle-J,,0,0,0,,		お前たちの狙いは
Dialogue: 1,1:33:00.02,1:33:01.84,DefaultSingle-J,,0,0,0,,		よく気のつくぼうやだな
Dialogue: 1,1:33:02.21,1:33:06.55,DefaultSingle-J,,0,0,0,,		そのとおり　このホテルには鈴木財閥のお嬢様がいる
Dialogue: 1,1:33:06.78,1:33:09.31,DefaultSingle-J,,0,0,0,,		誘拐すれば身代金は桁違いだ
Dialogue: 1,1:33:09.78,1:33:12.63,DefaultSingle-J,,0,0,0,,		お嬢様はもう避難しているんじゃねーか
Dialogue: 1,1:33:12.85,1:33:14.57,DefaultSingle-J,,0,0,0,,		まだスイートにいるはずだよ
Dialogue: 1,1:33:14.90,1:33:18.57,DefaultSingle-J,,0,0,0,,		僕が電話で絶対に部屋を出るなと言っておいたからね
Dialogue: 1,1:33:22.05,1:33:23.65,DefaultSingle-J,,0,0,0,,		ちょ　ちょっと　真さん
Dialogue: 1,1:33:23.65,1:33:24.58,DefaultSingle-J,,0,0,0,,		失礼します
Dialogue: 1,1:33:25.71,1:33:27.45,DefaultSingle-J,,0,0,0,,		エレベーターが全部止まっていました
Dialogue: 1,1:33:28.38,1:33:29.35,DefaultSingle-J,,0,0,0,,		ここを出ましょう
Dialogue: 1,1:33:37.08,1:33:40.01,DefaultSingle-J,,0,0,0,,		ま　真さん　これどういうこと？
Dialogue: 1,1:33:46.80,1:33:51.05,DefaultSingle-J,,0,0,0,,		見ろ　結局すべては私の思い描いたとおりになるんだ
Dialogue: 1,1:33:51.35,1:33:53.61,DefaultSingle-J,,0,0,0,,		この街は焼き尽くされ　生まれ変わる
Dialogue: 1,1:34:02.18,1:34:04.28,DefaultSingle-J,,0,0,0,,		お前が見ることはないがな
Dialogue: 1,1:34:34.92,1:34:35.99,DefaultSingle-J,,0,0,0,,		くらえ
Dialogue: 1,1:34:40.23,1:34:41.21,DefaultSingle-J,,0,0,0,,		真さん
Dialogue: 1,1:34:48.53,1:34:50.82,DefaultSingle-J,,0,0,0,,		何　何なになに
Dialogue: 1,1:34:57.47,1:34:59.59,DefaultSingle-J,,0,0,0,,	{\pos(400,1070)}	来た　来た来た来た
Dialogue: 1,1:35:44.50,1:35:45.31,DefaultSingle-J,,0,0,0,,		大丈夫か
Dialogue: 1,1:35:45.68,1:35:46.62,DefaultSingle-J,,0,0,0,,		あ　ああ
Dialogue: 1,1:35:46.98,1:35:49.95,DefaultSingle-J,,0,0,0,,		このままじゃ　街が本当に破壊されちまう
Dialogue: 1,1:35:51.17,1:35:53.39,DefaultSingle-J,,0,0,0,,		くっそ　何かいい方法は
Dialogue: 1,1:35:55.86,1:35:58.03,DefaultSingle-J,,0,0,0,,		あれを使えば　いける
Dialogue: 1,1:35:58.58,1:35:59.12,DefaultSingle-J,,0,0,0,,		キッド
Dialogue: 1,1:36:01.50,1:36:03.40,DefaultSingle-J,,0,0,0,,		って　お前本気か
Dialogue: 1,1:36:03.40,1:36:03.94,DefaultSingle-J,,0,0,0,,		もちろん
Dialogue: 1,1:36:17.63,1:36:21.58,DefaultSingle-J,,0,0,0,,		おい　あの作戦の前に海賊連中をなんとかしねーと
Dialogue: 1,1:36:22.00,1:36:23.86,DefaultSingle-J,,0,0,0,,		トランプ銃もあと1発
Dialogue: 1,1:36:24.02,1:36:25.47,DefaultSingle-J,,0,0,0,,		残ってるじゃねぇか
Dialogue: 1,1:36:29.89,1:36:32.01,DefaultSingle-J,,0,0,0,,		一発逆転の奥の手が
Dialogue: 1,1:36:32.68,1:36:33.90,DefaultSingle-J,,0,0,0,,		なるほどな
Dialogue: 1,1:36:34.49,1:36:35.56,DefaultSingle-J,,0,0,0,,		突っ込むぞ
Dialogue: 1,1:36:56.54,1:36:57.45,DefaultSingle-J,,0,0,0,,		真さん
Dialogue: 1,1:37:12.73,1:37:13.25,DefaultSingle-J,,0,0,0,,		キッド
Dialogue: 1,1:37:14.34,1:37:15.69,DefaultSingle-J,,0,0,0,,		オレを船首のほうへ
Dialogue: 1,1:37:16.83,1:37:18.02,DefaultSingle-J,,0,0,0,,		分かってるよ
Dialogue: 1,1:37:22.88,1:37:24.27,DefaultSingle-J,,0,0,0,,		蘭　下がっていろ
Dialogue: 1,1:37:25.85,1:37:27.69,DefaultSingle-J,,0,0,0,,		蘭
Dialogue: 1,1:37:31.32,1:37:33.87,DefaultSingle-J,,0,0,0,,		いっけぇ！
Dialogue: 1,1:37:48.98,1:37:50.42,DefaultSingle-J,,0,0,0,,		どうなってんだ　こりゃ
Dialogue: 1,1:37:50.42,1:37:51.75,DefaultSingle-J,,0,0,0,,		新一の声が
Dialogue: 1,1:37:52.84,1:37:54.34,DefaultSingle-J,,0,0,0,,		お姉さん　大丈夫？
Dialogue: 1,1:37:54.45,1:37:56.56,DefaultSingle-J,,0,0,0,,		アーサー君　どうしてここに
Dialogue: 1,1:37:56.70,1:37:59.41,DefaultSingle-J,,0,0,0,,		あ　お姉さんが心配で
Dialogue: 1,1:38:00.22,1:38:01.04,DefaultSingle-J,,0,0,0,,		ありがとう
Dialogue: 1,1:38:02.47,1:38:05.19,DefaultSingle-J,,0,0,0,,		もう　あいつはどこにいんのよ
Dialogue: 1,1:38:07.73,1:38:09.10,DefaultSingle-J,,0,0,0,,		無事でよかったぜ
Dialogue: 1,1:38:15.67,1:38:16.87,DefaultSingle-J,,0,0,0,,		サンキュー
Dialogue: 1,1:38:21.12,1:38:22.00,DefaultSingle-J,,0,0,0,,		真さん
Dialogue: 1,1:38:44.52,1:38:45.28,DefaultSingle-J,,0,0,0,,		当てたか
Dialogue: 1,1:38:46.95,1:38:48.40,DefaultSingle-J,,0,0,0,,		大丈夫です　園子さん
Dialogue: 1,1:38:57.35,1:38:58.39,DefaultSingle-J,,0,0,0,,		ハーイ
Dialogue: 1,1:39:11.94,1:39:13.32,DefaultSingle-J,,0,0,0,,		真さん　血が
Dialogue: 1,1:39:14.32,1:39:16.28,DefaultSingle-J,,0,0,0,,		園子さん　失礼します
Dialogue: 1,1:39:16.75,1:39:19.36,DefaultSingle-J,,0,0,0,,		へっ　ちよっと　何やってるの
Dialogue: 1,1:39:19.36,1:39:21.46,DefaultSingle-J,,0,0,0,,		こんな所で　真さん?
Dialogue: 1,1:39:21.85,1:39:23.29,DefaultSingle-J,,0,0,0,,		ダメだって
Dialogue: 1,1:39:27.03,1:39:29.64,DefaultSingle-J,,0,0,0,,		背負い結びです　園子さん
Dialogue: 1,1:39:30.22,1:39:31.49,DefaultSingle-J,,0,0,0,,		今度こそ絶対に
Dialogue: 1,1:39:32.43,1:39:33.67,DefaultSingle-J,,0,0,0,,		離れないでください
Dialogue: 1,1:39:35.58,1:39:38.79,DefaultSingle-J,,0,0,0,,		これじゃあ　離れたくても離れられないけど
Dialogue: 1,1:40:52.48,1:40:53.40,DefaultSingle-J,,0,0,0,,		京極さん
Dialogue: 1,1:40:54.09,1:40:55.49,DefaultSingle-J,,0,0,0,,		何かにつかまって
Dialogue: 1,1:41:50.83,1:41:51.75,DefaultSingle-J,,0,0,0,,		返すぜ
Dialogue: 1,1:41:54.16,1:41:55.01,DefaultSingle-J,,0,0,0,,		そいつは
Dialogue: 1,1:41:55.46,1:41:57.95,DefaultSingle-J,,0,0,0,,		オレの探している宝石じゃなかったんでね
Dialogue: 1,1:42:06.83,1:42:09.93,DefaultSingle-J,,0,0,0,,		園子さん　ちょっとこちらに座っててください
Dialogue: 1,1:42:10.85,1:42:14.79,DefaultSingle-J,,0,0,0,,		すいません　ちょっと固く結びすぎてしまって
Dialogue: 1,1:42:19.63,1:42:21.27,DefaultSingle-J,,0,0,0,,		あっ　ほどけました
Dialogue: 1,1:42:22.66,1:42:25.16,DefaultSingle-J,,0,0,0,,		あっ　いや　いやそれは　その
Dialogue: 1,1:42:26.25,1:42:28.16,DefaultSingle-J,,0,0,0,,		お守り　というか
Dialogue: 1,1:42:28.75,1:42:31.08,DefaultSingle-J,,0,0,0,,		これ　ずっとつけてたの
Dialogue: 1,1:42:31.22,1:42:32.51,DefaultSingle-J,,0,0,0,,		あ　はい
Dialogue: 1,1:42:33.02,1:42:36.43,DefaultSingle-J,,0,0,0,,		男がすたると思って言い出せませんでしたが
Dialogue: 1,1:42:37.40,1:42:38.39,DefaultSingle-J,,0,0,0,,		なーんだ
Dialogue: 1,1:42:38.86,1:42:41.22,DefaultSingle-J,,0,0,0,,		いつも守られてると思ったけど
Dialogue: 1,1:42:41.60,1:42:44.24,DefaultSingle-J,,0,0,0,,		私が真さんを守ってたんだね
Dialogue: 1,1:42:52.30,1:42:53.75,DefaultSingle-J,,0,0,0,,		そっか　そっか
Dialogue: 1,1:42:53.75,1:42:55.49,DefaultSingle-J,,0,0,0,,		絆創膏返してくださいよ
Dialogue: 1,1:42:55.49,1:42:56.50,DefaultSingle-J,,0,0,0,,		ダーメ
Dialogue: 1,1:42:56.50,1:42:56.48,DefaultSingle-J,,0,0,0,,		お願いします
Dialogue: 1,1:42:58.67,1:42:59.71,DefaultSingle-J,,0,0,0,,	{\a6\fscx90\fscy90}	園子さん
Dialogue: 1,1:42:57.48,1:42:59.46,DefaultSingle-J,,0,0,0,,		一生宝物にするんだ
Dialogue: 1,1:42:59.46,1:43:00.61,DefaultSingle-J,,0,0,0,,		ラブラブね
Dialogue: 1,1:43:09.19,1:43:12.12,DefaultSingle-J,,0,0,0,,		お前は一体　何者なんだ
Dialogue: 1,1:43:12.78,1:43:14.65,DefaultSingle-J,,0,0,0,,		ただの子供じゃないだろ
Dialogue: 1,1:43:16.94,1:43:18.05,DefaultSingle-J,,0,0,0,,		江戸川コナン
Dialogue: 1,1:43:18.56,1:43:19.50,DefaultSingle-J,,0,0,0,,		探偵さ
Dialogue: 1,1:47:13.51,1:47:14.57,DefaultSingle-J,,0,0,0,,		でもいいのか
Dialogue: 1,1:47:14.88,1:47:18.30,DefaultSingle-J,,0,0,0,,		あの強ぇ彼氏をまたアメリカに行かせちまって
Dialogue: 1,1:47:18.56,1:47:19.74,DefaultSingle-J,,0,0,0,,		いいの　いいの
Dialogue: 1,1:47:20.10,1:47:23.25,DefaultSingle-J,,0,0,0,,		真さんはやっぱどっかで戦ってないとね
Dialogue: 1,1:47:24.96,1:47:26.59,DefaultSingle-J,,0,0,0,,		おお　出てきたぞ
Dialogue: 1,1:47:26.77,1:47:28.26,DefaultSingle-J,,0,0,0,,		ねぇ　あれ何
Dialogue: 1,1:47:28.55,1:47:32.22,DefaultSingle-J,,0,0,0,,		おい　そんなにくっつくなよ　歩きづれーだろ
Dialogue: 1,1:47:32.22,1:47:35.30,DefaultSingle-J,,0,0,0,,		ダーメ　もう絶対に離さないわ
Dialogue: 1,1:47:35.31,1:47:36.43,DefaultSingle-J,,0,0,0,,		えっ　そう
Dialogue: 1,1:47:38.06,1:47:40.07,DefaultSingle-J,,0,0,0,,		ずーっと待ってたんだから
Dialogue: 1,1:47:40.85,1:47:41.84,DefaultSingle-J,,0,0,0,,		この時を
Dialogue: 1,1:47:43.46,1:47:45.40,DefaultSingle-J,,0,0,0,,		キッド　待ってたぞ
Dialogue: 1,1:47:45.65,1:47:46.66,DefaultSingle-J,,0,0,0,,		へっ　マジ
Dialogue: 1,1:47:46.93,1:47:48.62,DefaultSingle-J,,0,0,0,,		あんたが新一じゃないことぐらい
Dialogue: 1,1:47:48.62,1:47:50.21,DefaultSingle-J,,0,0,0,,		最初から分かってたんだから
Dialogue: 1,1:47:50.33,1:47:51.28,DefaultSingle-J,,0,0,0,,		新一はね
Dialogue: 1,1:47:51.61,1:47:54.28,DefaultSingle-J,,0,0,0,,		お父さんのこと　おっちゃんなんて呼んだりしないのよ
Dialogue: 1,1:47:54.60,1:47:56.41,DefaultSingle-J,,0,0,0,,		えっ　だって　いつもあいつ
Dialogue: 1,1:47:57.11,1:48:00.11,DefaultSingle-J,,0,0,0,,		そういや　蘭の前ではおっちゃんって言ったことねぇな
Dialogue: 1,1:48:00.66,1:48:03.86,DefaultSingle-J,,0,0,0,,		一度ならず二度も新一に化けるなんて許さない
Dialogue: 1,1:48:03.86,1:48:06.98,DefaultSingle-J,,0,0,0,,		お嬢さん　その腕絶対に離さないでくださいよ
Dialogue: 1,1:48:07.19,1:48:08.31,DefaultSingle-J,,0,0,0,,		確保
Dialogue: 1,1:48:11.47,1:48:12.55,DefaultSingle-J,,0,0,0,,		キッド
Dialogue: 1,1:48:12.98,1:48:14.12,DefaultSingle-J,,0,0,0,,		捕まえろ
Dialogue: 1,1:48:15.15,1:48:17.05,DefaultSingle-J,,0,0,0,,		絶対離さないからね
Dialogue: 1,1:48:17.51,1:48:18.51,DefaultSingle-J,,0,0,0,,		逃がすな
Dialogue: 1,1:48:19.99,1:48:20.73,DefaultSingle-J,,0,0,0,,		博士
Dialogue: 1,1:48:27.85,1:48:28.90,DefaultSingle-J,,0,0,0,,		いないぞ
Dialogue: 1,1:48:32.03,1:48:34.26,DefaultSingle-J,,0,0,0,,		ああっ　もう逃げられた
Dialogue: 1,1:48:34.26,1:48:35.45,DefaultSingle-J,,0,0,0,,		くそう
Dialogue: 1,1:48:35.45,1:48:38.46,DefaultSingle-J,,0,0,0,,		まだ近くにいるはずだ　追え
Dialogue: 1,1:48:44.05,1:48:45.02,DefaultSingle-J,,0,0,0,,		コナン君
Dialogue: 1,1:48:45.89,1:48:47.82,DefaultSingle-J,,0,0,0,,		おかえりなさい　蘭姉ちゃん
Dialogue: 1,1:48:49.27,1:48:50.33,DefaultSingle-J,,0,0,0,,		ただいま
Dialogue: 1,1:48:51.66,1:48:52.93,DefaultSingle-J,,0,0,0,,		さびしくなかった？
Dialogue: 1,1:48:54.20,1:48:55.05,DefaultSingle-J,,0,0,0,,		バーロ
Dialogue: 1,1:48:55.53,1:48:57.43,DefaultSingle-J,,0,0,0,,		ずっと一緒にいたっつーの
Dialogue: 1,1:49:15.58,1:49:16.28,DefaultSingle-J,,0,0,0,,		届け
Dialogue: 1,1:49:17.29,1:49:19.80,DefaultSingle-J,,0,0,0,,		遥か　彼方へ
Dialogue: 1,0:00:00.00,0:00:05.00,DefaultSingle-J,,0,0,0,,
