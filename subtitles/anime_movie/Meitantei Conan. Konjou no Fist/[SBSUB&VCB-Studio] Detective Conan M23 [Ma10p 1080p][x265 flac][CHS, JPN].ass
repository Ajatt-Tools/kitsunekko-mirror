Dialogue: 1,1:48:32.03,1:48:34.26,Default,,0,0,0,,		啊  又让他跑了	\N{\rDefault-JP}	ああっ　もう逃げられた
Dialogue: 1,1:48:34.26,1:48:35.45,Default,,0,0,0,,		可恶	\N{\rDefault-JP}	くそう
Dialogue: 1,1:48:35.45,1:48:38.46,Default,,0,0,0,,		他应该还在附近  给我追	\N{\rDefault-JP}	まだ近くにいるはずだ　追え
Dialogue: 1,1:48:44.05,1:48:45.02,Default,,0,0,0,,		柯南	\N{\rDefault-JP}	コナン君
Dialogue: 1,1:48:45.89,1:48:47.82,Default,,0,0,0,,		欢迎回来  小兰姐姐	\N{\rDefault-JP}	おかえりなさい　蘭姉ちゃん
Dialogue: 1,1:48:49.27,1:48:50.33,Default,,0,0,0,,		我回来了	\N{\rDefault-JP}	ただいま
Dialogue: 1,1:48:51.66,1:48:52.93,Default,,0,0,0,,		有想我吗	\N{\rDefault-JP}	さびしくなかった？
Dialogue: 1,1:48:54.20,1:48:55.05,Default,,0,0,0,,		傻瓜	\N{\rDefault-JP}	バーロ
Dialogue: 1,1:48:55.53,1:48:57.43,Default,,0,0,0,,		我一直都和你在一起呢	\N{\rDefault-JP}	ずっと一緒にいたっつーの
Dialogue: 1,1:49:15.58,1:49:16.28,Default,,0,0,0,,		去吧	\N{\rDefault-JP}	届け
Dialogue: 1,1:49:17.29,1:49:19.80,Default,,0,0,0,,		去那遥远的彼岸	\N{\rDefault-JP}	遥か　彼方へ
Dialogue: 1,0:00:00.00,0:00:05.00,Default,,0,0,0,,
Dialogue: 1,0:00:57.45,0:00:59.28,M23-EngSpeak-Chi-A,,0,0,0,,		让你久等了吗
Dialogue: 1,0:00:59.28,0:01:01.91,M23-EngSpeak-Chi-A,,0,0,0,,		你还真是选了个奇怪的地方见面
Dialogue: 1,0:01:02.04,0:01:04.12,M23-EngSpeak-Chi-A,,0,0,0,,		我们还是说日语吧
Dialogue: 1,0:01:04.12,0:01:05.66,M23-EngSpeak-Chi-A,,0,0,0,,		免得隔墙有耳
Dialogue: 1,0:01:46.91,0:01:48.67,M23-EngSpeak-Chi-A,,0,0,0,,		这是您点的默尔索
Dialogue: 1,0:01:54.76,0:01:55.34,M23-EngSpeak-Chi-A,,0,0,0,,		呃  那个
Dialogue: 1,0:02:15.19,0:02:16.32,M23-EngSpeak-Chi-A,,0,0,0,,		谢谢帮忙
Dialogue: 1,0:02:53.02,0:02:54.52,M23-EngSpeak-Chi-A,,0,0,0,,		嘿  你没事吧
Dialogue: 1,0:03:12.63,0:03:13.46,M23-EngSpeak-Chi-A,,0,0,0,,		发生了什么
Dialogue: 1,0:03:21.43,0:03:22.80,M23-EngSpeak-Chi-A,,0,0,0,,		请保持冷静
Dialogue: 1,0:03:22.80,0:03:24.30,M23-EngSpeak-Chi-A,,0,0,0,,		请跟从我们的引导
Dialogue: 1,0:03:30.18,0:03:31.10,M23-EngSpeak-Chi-A,,0,0,0,,		嘿  等等
Dialogue: 1,0:03:31.89,0:03:32.94,M23-EngSpeak-Chi-A,,0,0,0,,		你在干什么
Dialogue: 1,0:03:33.94,0:03:35.81,M23-EngSpeak-Chi-A,,0,0,0,,		保护犯罪现场
Dialogue: 1,0:03:35.81,0:03:36.69,M23-EngSpeak-Chi-A,,0,0,0,,		否则
Dialogue: 1,0:03:36.69,0:03:39.49,M23-EngSpeak-Chi-A,,0,0,0,,		案发现场就要被人群破坏了  不是吗
Dialogue: 1,0:03:54.29,0:03:55.21,M23-EngSpeak-Chi-A,,0,0,0,,		警官
Dialogue: 1,0:03:55.46,0:03:57.09,M23-EngSpeak-Chi-A,,0,0,0,,		我叫来的人呢
Dialogue: 1,0:03:57.09,0:03:58.40,M23-EngSpeak-Chi-A,,0,0,0,,		他已经在里面了
Dialogue: 1,0:03:58.63,0:03:59.46,M23-EngSpeak-Chi-A,,0,0,0,,		谢谢
Dialogue: 1,0:04:01.47,0:04:03.34,M23-EngSpeak-Chi-A,,0,0,0,,		抱歉让你久等了  里希
Dialogue: 1,0:04:03.51,0:04:05.01,M23-EngSpeak-Chi-A,,0,0,0,,		艾丹警官
Dialogue: 1,0:04:05.18,0:04:06.97,M23-EngSpeak-Chi-A,,0,0,0,,		谢谢您叫我过来
Dialogue: 1,0:04:07.18,0:04:10.31,M23-EngSpeak-Chi-C,,0,0,0,,		案发现场是在这前面的商场
Dialogue: 1,0:04:10.64,0:04:13.27,M23-EngSpeak-Chi-C,,0,0,0,,		这案子可有点麻烦了
Dialogue: 1,0:04:14.81,0:04:16.27,M23-EngSpeak-Chi-A,,0,0,0,,		那位里昂·劳先生
Dialogue: 1,0:04:16.27,0:04:18.23,M23-EngSpeak-Chi-A,,0,0,0,,		是尸体的第一发现者
Dialogue: 1,0:04:18.98,0:04:19.98,M23-EngSpeak-Chi-A,,0,0,0,,		里昂老师
Dialogue: 1,0:04:20.99,0:04:23.82,M23-EngSpeak-Chi-A,,0,0,0,,		你是他的得意门生吧
Dialogue: 1,0:04:23.82,0:04:26.82,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h可不可以麻烦你告诉他  不要过多干涉这起案件？
Dialogue: 1,0:04:27.12,0:04:28.83,M23-EngSpeak-Chi-A,,0,0,0,,		我可说不出这话
Dialogue: 1,0:04:28.83,0:04:30.29,M23-EngSpeak-Chi-A,,0,0,0,,		我去和他打个招呼
Dialogue: 1,0:04:31.45,0:04:32.62,M23-EngSpeak-Chi-A,,0,0,0,,		里昂老师
Dialogue: 1,0:04:32.79,0:04:35.29,M23-EngSpeak-Chi-A,,0,0,0,,		这不是里希吗  好久不见了
Dialogue: 1,0:04:35.29,0:04:36.04,M23-EngSpeak-Chi-A,,0,0,0,,		是啊
Dialogue: 1,0:05:11.74,0:05:13.37,M23-EngSpeak-Chi-A,,0,0,0,,		警官在吗
Dialogue: 1,0:05:14.20,0:05:16.25,M23-EngSpeak-Chi-A,,0,0,0,,		不好意思  请让一下
Dialogue: 1,0:05:16.67,0:05:17.71,M23-EngSpeak-Chi-A,,0,0,0,,		怎么了
Dialogue: 1,0:05:17.71,0:05:19.84,M23-EngSpeak-Chi-A,,0,0,0,,		电梯的墙壁上有奇怪的东西
Dialogue: 1,0:05:20.63,0:05:21.23,M23-EngSpeak-Chi-A,,0,0,0,,		什么
Dialogue: 1,0:05:21.96,0:05:23.26,M23-EngSpeak-Chi-A,,0,0,0,,		这是什么
Dialogue: 1,0:18:06.89,0:18:08.56,M23-EngSpeak-Chi-A,,0,0,0,,		嘿  空手道男孩
Dialogue: 1,0:18:08.73,0:18:10.19,M23-EngSpeak-Chi-A,,0,0,0,,		你真勇敢啊
Dialogue: 1,0:18:18.15,0:18:20.07,M23-EngSpeak-Chi-A,,0,0,0,,		嘿  别害羞嘛
Dialogue: 1,0:21:54.20,0:21:58.79,M23-EngSpeak-Chi-A,,0,0,0,,		我收到消息说铃木财团成了京极真的新赞助人
Dialogue: 1,0:21:58.79,0:22:00.42,M23-EngSpeak-Chi-A,,0,0,0,,		你能打败他吗
Dialogue: 1,0:22:00.42,0:22:01.96,M23-EngSpeak-Chi-A,,0,0,0,,		无须担心
Dialogue: 1,0:22:01.96,0:22:03.50,M23-EngSpeak-Chi-C,,0,0,0,,		不管是谁
Dialogue: 1,0:22:03.50,0:22:05.97,M23-EngSpeak-Chi-C,,0,0,0,,		我都会一击将其打倒
Dialogue: 1,0:22:05.97,0:22:07.43,M23-EngSpeak-Chi-A,,0,0,0,,		那我就放心了
Dialogue: 1,0:22:08.59,0:22:09.64,M23-EngSpeak-Chi-A,,0,0,0,,		进来
Dialogue: 1,0:22:09.80,0:22:10.97,M23-EngSpeak-Chi-A,,0,0,0,,		打扰了
Dialogue: 1,0:22:11.39,0:22:14.14,M23-EngSpeak-Chi-C,,0,0,0,,		纳马拉桑先生到了
Dialogue: 1,0:22:14.14,0:22:15.48,M23-EngSpeak-Chi-C,,0,0,0,,		他有客人想要引荐给您
Dialogue: 1,0:22:15.64,0:22:16.93,M23-EngSpeak-Chi-A,,0,0,0,,		到得很早啊
Dialogue: 1,0:22:16.93,0:22:19.19,M23-EngSpeak-Chi-A,,0,0,0,,		请带他们去会客室
Dialogue: 1,0:22:19.19,0:22:20.61,M23-EngSpeak-Chi-A,,0,0,0,,		我明白了
Dialogue: 1,0:22:21.77,0:22:23.86,M23-EngSpeak-Chi-A,,0,0,0,,		说起来  基德的事查得怎么样了
Dialogue: 1,0:22:24.07,0:22:26.99,M23-EngSpeak-Chi-A,,0,0,0,,		非常抱歉  我们还在调查
Dialogue: 1,0:22:27.45,0:22:29.49,M23-EngSpeak-Chi-A,,0,0,0,,		还有雪琳·丹的事
Dialogue: 1,0:22:29.49,0:22:32.66,M23-EngSpeak-Chi-A,,0,0,0,,		看来我们的情报管理出了问题啊
Dialogue: 1,0:22:32.66,0:22:34.87,M23-EngSpeak-Chi-A,,0,0,0,,		犯人方面  已经有了眉目
Dialogue: 1,0:22:34.87,0:22:36.75,M23-EngSpeak-Chi-A,,0,0,0,,		那就交给你了
Dialogue: 1,0:25:08.77,0:25:10.23,M23-EngSpeak-Chi-A,,0,0,0,,		京极先生
Dialogue: 1,0:25:11.11,0:25:13.10,M23-EngSpeak-Chi-A,,0,0,0,,		我一直期待与你见面
Dialogue: 1,0:25:13.40,0:25:14.36,M23-EngSpeak-Chi-A,,0,0,0,,		谢谢
Dialogue: 1,0:25:14.36,0:25:15.99,M23-EngSpeak-Chi-A,,0,0,0,,		我也练空手道
Dialogue: 1,0:25:15.99,0:25:18.99,M23-EngSpeak-Chi-A,,0,0,0,,		一直希望有机会能与你一战
Dialogue: 1,0:25:31.13,0:25:32.22,M23-EngSpeak-Chi-A,,0,0,0,,		真奇怪
Dialogue: 1,0:25:33.01,0:25:34.84,M23-EngSpeak-Chi-A,,0,0,0,,		我感受不到任何气场
Dialogue: 1,0:25:40.51,0:25:41.76,M23-EngSpeak-Chi-A,,0,0,0,,		怎么可能
Dialogue: 1,0:26:10.92,0:26:13.12,M23-EngSpeak-Chi-A,,0,0,0,,		您不能进去  请等一下
Dialogue: 1,0:26:13.25,0:26:15.51,M23-EngSpeak-Chi-A,,0,0,0,,		没关系  让我进去
Dialogue: 1,0:26:25.02,0:26:27.98,M23-EngSpeak-Chi-A,,0,0,0,,		非常抱歉  他突然就进来了
Dialogue: 1,0:26:27.98,0:26:29.12,M23-EngSpeak-Chi-A,,0,0,0,,		没关系
Dialogue: 1,0:26:29.10,0:26:32.82,M23-EngSpeak-Chi-A,,0,0,0,,		接下来我会带大家参观我司的保险库
Dialogue: 1,0:26:32.82,0:26:33.61,M23-EngSpeak-Chi-A,,0,0,0,,		那太好了
Dialogue: 1,0:26:33.61,0:26:35.61,M23-EngSpeak-Chi-A,,0,0,0,,		我也要一起去
Dialogue: 1,0:27:09.27,0:27:09.98,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h干什么？
Dialogue: 1,0:27:10.85,0:27:12.61,M23-EngSpeak-Chi-A,,0,0,0,,		抱歉抱歉  没什么
Dialogue: 1,0:28:04.20,0:28:06.78,M23-EngSpeak-Chi-A,,0,0,0,,		但还有体育场的安保...
Dialogue: 1,0:28:07.74,0:28:10.79,M23-EngSpeak-Chi-A,,0,0,0,,		是  我们会竭尽全力进行戒备
Dialogue: 1,0:28:12.54,0:28:14.29,M23-EngSpeak-Chi-A,,0,0,0,,		如果绀青之拳出了什么意外
Dialogue: 1,0:28:14.29,0:28:18.55,M23-EngSpeak-Chi-A,,0,0,0,,		你就等着赔付那笔巨额赔偿金吧
Dialogue: 1,0:30:29.43,0:30:30.64,M23-EngSpeak-Chi-A,,0,0,0,,		没意思
Dialogue: 1,0:30:37.73,0:30:40.54,M23-EngSpeak-Chi-A,,0,0,0,,		希望新加坡的水能够合你胃口
Dialogue: 1,0:31:47.00,0:31:47.88,M23-EngSpeak-Chi-A,,0,0,0,,		怎么回事
Dialogue: 1,0:31:54.47,0:31:55.43,M23-EngSpeak-Chi-A,,0,0,0,,		怎么了
Dialogue: 1,0:31:55.55,0:31:56.51,M23-EngSpeak-Chi-A,,0,0,0,,		是基德
Dialogue: 1,0:31:57.06,0:31:59.43,M23-EngSpeak-Chi-A,,0,0,0,,		不用担心  我会一直...
Dialogue: 1,0:32:06.44,0:32:08.44,M23-EngSpeak-Chi-A,,0,0,0,,		...快他一步的
Dialogue: 1,0:32:20.75,0:32:21.62,M23-EngSpeak-Chi-A,,0,0,0,,		他在这
Dialogue: 1,0:38:24.11,0:38:26.45,M23-EngSpeak-Chi-A,,0,0,0,,		毛利先生  有您的电话
Dialogue: 1,0:40:43.71,0:40:45.18,M23-EngSpeak-Chi-A,,0,0,0,,		行礼
Dialogue: 1,0:40:50.26,0:40:51.51,M23-EngSpeak-Chi-A,,0,0,0,,		开始
Dialogue: 1,0:41:25.42,0:41:26.58,M23-EngSpeak-Chi-A,,0,0,0,,		不准进入
Dialogue: 1,0:41:27.75,0:41:28.50,M23-EngSpeak-Chi-A,,0,0,0,,		不行
Dialogue: 1,0:41:35.51,0:41:38.35,M23-EngSpeak-Chi-A,,0,0,0,,		他是工作人员  请让他进来
Dialogue: 1,0:41:38.64,0:41:39.64,M23-EngSpeak-Chi-A,,0,0,0,,		好的  警官
Dialogue: 1,0:46:07.32,0:46:10.33,M23-EngSpeak-Chi-A,,0,0,0,,		听好了  都给我提高警惕
Dialogue: 1,0:46:10.33,0:46:14.00,M23-EngSpeak-Chi-A,,0,0,0,,		发现可疑之处立刻报告
Dialogue: 1,0:46:14.00,0:46:15.50,M23-EngSpeak-Chi-A,,0,0,0,,		迅速处置
Dialogue: 1,0:46:16.00,0:46:16.71,M23-EngSpeak-Chi-A,,0,0,0,,		另外
Dialogue: 1,0:46:18.67,0:46:20.00,M23-EngSpeak-Chi-A,,0,0,0,,		你没事吧
Dialogue: 1,0:46:20.25,0:46:21.88,M23-EngSpeak-Chi-A,,0,0,0,,		非常抱歉
Dialogue: 1,0:46:22.13,0:46:23.76,M23-EngSpeak-Chi-A,,0,0,0,,		应该是我道歉才对
Dialogue: 1,0:46:32.72,0:46:34.31,M23-EngSpeak-Chi-A,,0,0,0,,		艾丹警官
Dialogue: 1,0:46:35.23,0:46:38.14,M23-EngSpeak-Chi-A,,0,0,0,,		抱歉  我有点在意...
Dialogue: 1,0:46:38.39,0:46:40.52,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h不  不好意思  什么？
Dialogue: 1,0:46:40.90,0:46:42.27,M23-EngSpeak-Chi-A,,0,0,0,,		好了
Dialogue: 1,0:46:42.57,0:46:44.61,M23-EngSpeak-Chi-A,,0,0,0,,		请加油工作
Dialogue: 1,0:46:45.07,0:46:46.03,M23-EngSpeak-Chi-A,,0,0,0,,		是  包在我身上
Dialogue: 1,0:46:47.78,0:46:49.99,M23-EngSpeak-Chi-A,,0,0,0,,		保险库的情况如何
Dialogue: 1,0:46:50.28,0:46:52.33,M23-EngSpeak-Chi-A,,0,0,0,,		报告长官  一切正常
Dialogue: 1,0:46:52.53,0:46:54.66,M23-EngSpeak-Chi-A,,0,0,0,,		不好意思  打扰一下
Dialogue: 1,0:46:54.66,0:46:55.41,M23-EngSpeak-Chi-A,,0,0,0,,		发生什么了
Dialogue: 1,0:46:55.41,0:46:58.87,M23-EngSpeak-Chi-A,,0,0,0,,		艾丹警官让你们快点去找他
Dialogue: 1,0:46:59.17,0:47:00.33,M23-EngSpeak-Chi-A,,0,0,0,,		可  可是
Dialogue: 1,0:47:00.58,0:47:02.13,M23-EngSpeak-Chi-A,,0,0,0,,		我会负责看守这里的
Dialogue: 1,0:47:02.46,0:47:03.42,M23-EngSpeak-Chi-A,,0,0,0,,		好  好的
Dialogue: 1,0:47:03.59,0:47:05.71,M23-EngSpeak-Chi-A,,0,0,0,,		我们马上就回来  拜托你了
Dialogue: 1,0:48:11.99,0:48:13.11,M23-EngSpeak-Chi-A,,0,0,0,,		站住
Dialogue: 1,0:48:18.29,0:48:19.62,M23-EngSpeak-Chi-A,,0,0,0,,		马上把枪放下
Dialogue: 1,0:48:20.12,0:48:22.00,M23-EngSpeak-Chi-A,,0,0,0,,		基德  你被逮捕了
Dialogue: 1,0:48:25.88,0:48:26.38,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h什么？
Dialogue: 1,0:48:46.86,0:48:48.02,M23-EngSpeak-Chi-A,,0,0,0,,		他在这儿
Dialogue: 1,0:49:19.10,0:49:19.76,M23-EngSpeak-Chi-A,,0,0,0,,		可恶
Dialogue: 1,0:49:20.06,0:49:22.85,M23-EngSpeak-Chi-A,,0,0,0,,		快  给我追  一定要抓到他
Dialogue: 1,0:49:22.85,0:49:23.77,M23-EngSpeak-Chi-A,,0,0,0,,		是  警官
Dialogue: 1,0:49:50.04,0:49:50.71,M23-EngSpeak-Chi-A,,0,0,0,,		看
Dialogue: 1,0:49:51.09,0:49:53.72,M23-EngSpeak-Chi-A,,0,0,0,,		有只巨大的鸟在飞
Dialogue: 1,0:52:28.20,0:52:29.79,M23-EngSpeak-Chi-A,,0,0,0,,		这下糟糕了
Dialogue: 1,0:52:30.25,0:52:31.33,M23-EngSpeak-Chi-A,,0,0,0,,		喂  小姑娘
Dialogue: 1,0:52:31.33,0:52:33.84,M23-EngSpeak-Chi-A,,0,0,0,,		你要怎么赔我啊
Dialogue: 1,0:52:36.63,0:52:39.21,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h哈？我不知道你在说什么
Dialogue: 1,0:52:39.46,0:52:40.51,M23-EngSpeak-Chi-A,,0,0,0,,		过来
Dialogue: 1,0:52:47.47,0:52:48.14,M23-EngSpeak-Chi-A,,0,0,0,,		混蛋
Dialogue: 1,0:54:31.03,0:54:31.91,M23-EngSpeak-Chi-A,,0,0,0,,		她还好吗
Dialogue: 1,0:54:31.91,0:54:34.00,M23-EngSpeak-Chi-A,,0,0,0,,		我已经叫了救护车了
Dialogue: 1,0:54:34.00,0:54:35.16,M23-EngSpeak-Chi-A,,0,0,0,,		她是外国人吗
Dialogue: 1,1:01:14.52,1:01:16.27,M23-EngSpeak-Chi-A,,0,0,0,,		我说过  我们在事成之前
Dialogue: 1,1:01:16.27,1:01:18.23,M23-EngSpeak-Chi-A,,0,0,0,,		都不要见面了吧
Dialogue: 1,1:01:18.48,1:01:20.65,M23-EngSpeak-Chi-A,,0,0,0,,		你不是大言不惭地说  你的计划很完美吗
Dialogue: 1,1:01:20.65,1:01:22.82,M23-EngSpeak-Chi-A,,0,0,0,,		但是真的没问题吗
Dialogue: 1,1:01:23.82,1:01:27.07,M23-EngSpeak-Chi-A,,0,0,0,,		你虽然外表强悍  内心却如此胆小怕事啊
Dialogue: 1,1:01:27.32,1:01:29.58,M23-EngSpeak-Chi-A,,0,0,0,,		你说话注意点
Dialogue: 1,1:01:38.59,1:01:40.46,M23-EngSpeak-Chi-A,,0,0,0,,		我这个人一向守信用
Dialogue: 1,1:01:40.46,1:01:41.59,M23-EngSpeak-Chi-A,,0,0,0,,		请放心
Dialogue: 1,1:02:04.78,1:02:08.53,M23-EngSpeak-Chi-A,,0,0,0,,		半决赛第二场  京极真对阵李坦
Dialogue: 1,1:02:08.53,1:02:11.08,M23-EngSpeak-Chi-A,,0,0,0,,		由于京极真选手弃权
Dialogue: 1,1:02:11.08,1:02:13.87,M23-EngSpeak-Chi-A,,0,0,0,,		李坦选手进入决赛
Dialogue: 1,1:02:14.08,1:02:14.62,M23-EngSpeak-Chi-A,,0,0,0,,		可恶
Dialogue: 1,1:02:15.21,1:02:16.92,M23-EngSpeak-Chi-A,,0,0,0,,		多管闲事
Dialogue: 1,1:10:06.26,1:10:09.35,M23-EngSpeak-Chi-A,,0,0,0,,		中瀚杯空手道大赛的冠军得主是...
Dialogue: 1,1:10:09.97,1:10:13.35,M23-EngSpeak-Chi-A,,0,0,0,,		贾马尔丁
Dialogue: 1,1:10:19.15,1:10:22.23,M23-EngSpeak-Chi-A,,0,0,0,,		所以  你们认为我拟定的城市发展计划如何
Dialogue: 1,1:10:25.28,1:10:27.86,M23-EngSpeak-Chi-A,,0,0,0,,		我们无法接受你的方案
Dialogue: 1,1:10:28.11,1:10:28.74,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h为什么？
Dialogue: 1,1:10:28.87,1:10:31.41,M23-EngSpeak-Chi-A,,0,0,0,,		实施这个计划  对你们而言并无损失
Dialogue: 1,1:10:31.41,1:10:33.58,M23-EngSpeak-Chi-A,,0,0,0,,		对国家而言  也是有百利而无一害的
Dialogue: 1,1:10:34.08,1:10:35.62,M23-EngSpeak-Chi-A,,0,0,0,,		你太急躁了
Dialogue: 1,1:10:35.62,1:10:38.12,M23-EngSpeak-Chi-A,,0,0,0,,		如果按照你的计划进行如此大规模的开发
Dialogue: 1,1:10:38.12,1:10:40.46,M23-EngSpeak-Chi-A,,0,0,0,,		就可能会有人无家可归
Dialogue: 1,1:10:40.63,1:10:42.92,M23-EngSpeak-Chi-A,,0,0,0,,		我们可以为他们提供其他的住所
Dialogue: 1,1:10:42.92,1:10:44.46,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h我的计划是完美的！
Dialogue: 1,1:10:45.59,1:10:47.43,M23-EngSpeak-Chi-A,,0,0,0,,		你还是太年轻了
Dialogue: 1,1:10:47.43,1:10:49.76,M23-EngSpeak-Chi-A,,0,0,0,,		多学习沉淀一下再来吧
Dialogue: 1,1:10:56.73,1:10:58.14,M23-EngSpeak-Chi-A,,0,0,0,,		老糊涂们
Dialogue: 1,1:10:58.77,1:11:01.52,M23-EngSpeak-Chi-A,,0,0,0,,		你们的时代已经终结了
Dialogue: 1,1:11:02.23,1:11:04.90,M23-EngSpeak-Chi-A,,0,0,0,,		我会建造一座新的城市
Dialogue: 1,1:11:18.50,1:11:19.62,M23-EngSpeak-Chi-A,,0,0,0,,		把手举起来
Dialogue: 1,1:11:20.63,1:11:21.84,M23-EngSpeak-Chi-A,,0,0,0,,		好的  好的
Dialogue: 1,1:21:52.63,1:21:54.05,M23-EngSpeak-Chi-A,,0,0,0,,		它在往这边开
Dialogue: 1,1:22:59.87,1:23:01.03,M23-EngSpeak-Chi-A,,0,0,0,,		能成功吗
Dialogue: 1,1:23:01.33,1:23:02.33,M23-EngSpeak-Chi-A,,0,0,0,,		应该没问题
Dialogue: 1,1:23:56.92,1:23:58.67,M23-EngSpeak-Chi-A,,0,0,0,,		快看  是基德
Dialogue: 1,1:23:59.22,1:24:01.68,M23-EngSpeak-Chi-A,,0,0,0,,		是基德  基德在这
Dialogue: 1,1:24:23.87,1:24:26.20,M23-EngSpeak-Chi-A,,0,0,0,,		我是真的看不透这个男人
Dialogue: 1,1:24:58.48,1:24:59.32,M23-EngSpeak-Chi-A,,0,0,0,,		快看
Dialogue: 1,1:24:59.99,1:25:02.15,M23-EngSpeak-Chi-A,,0,0,0,,		这座城市即将经我之手
Dialogue: 1,1:25:02.45,1:25:03.86,M23-EngSpeak-Chi-A,,0,0,0,,		脱胎换骨
Dialogue: 1,1:25:06.87,1:25:08.37,M23-EngSpeak-Chi-A,,0,0,0,,		你干什么
Dialogue: 1,1:25:47.95,1:25:49.12,M23-EngSpeak-Chi-A,,0,0,0,,		不许动
Dialogue: 1,1:25:51.37,1:25:52.54,M23-EngSpeak-Chi-A,,0,0,0,,		这里没人
Dialogue: 1,1:25:52.54,1:25:54.00,M23-EngSpeak-Chi-A,,0,0,0,,		我们先试着把船停下来
Dialogue: 1,1:26:19.48,1:26:20.52,M23-EngSpeak-Chi-A,,0,0,0,,		我的油轮
Dialogue: 1,1:26:20.82,1:26:22.07,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h发生了什么？
Dialogue: 1,1:26:35.25,1:26:36.25,M23-EngSpeak-Chi-A,,0,0,0,,		贾马尔丁
Dialogue: 1,1:26:37.63,1:26:38.38,M23-EngSpeak-Chi-A,,0,0,0,,		等  等一下
Dialogue: 1,1:26:39.04,1:26:40.75,M23-EngSpeak-Chi-A,,0,0,0,,		贾马尔丁  你在干什么
Dialogue: 1,1:26:41.05,1:26:42.96,M23-EngSpeak-Chi-A,,0,0,0,,		我为你工作的唯一理由
Dialogue: 1,1:26:42.96,1:26:44.97,M23-EngSpeak-Chi-A,,0,0,0,,		是想和京极真分个高下
Dialogue: 1,1:26:44.97,1:26:47.30,M23-EngSpeak-Chi-A,,0,0,0,,		我现在没有理由再供你驱使
Dialogue: 1,1:26:47.55,1:26:48.26,M23-EngSpeak-Chi-A,,0,0,0,,		什么
Dialogue: 1,1:27:36.10,1:27:36.89,M23-EngSpeak-Chi-A,,0,0,0,,		喂
Dialogue: 1,1:27:37.35,1:27:38.23,M23-EngSpeak-Chi-A,,0,0,0,,		等一下
Dialogue: 1,1:27:49.91,1:27:50.66,M23-EngSpeak-Chi-A,,0,0,0,,		他们的目标
Dialogue: 1,1:27:50.66,1:27:53.08,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h该不会是滨海湾金沙酒店吧？
Dialogue: 1,1:29:50.82,1:29:51.82,M23-EngSpeak-Chi-A,,0,0,0,,		救命
Dialogue: 1,1:29:51.82,1:29:53.45,M23-EngSpeak-Chi-A,,0,0,0,,		有人推了我一把
Dialogue: 1,1:29:55.78,1:29:57.12,M23-EngSpeak-Chi-A,,0,0,0,,		有人去救他了
Dialogue: 1,1:29:57.12,1:29:57.91,M23-EngSpeak-Chi-A,,0,0,0,,		赶快
Dialogue: 1,1:29:57.91,1:29:59.20,M23-EngSpeak-Chi-A,,0,0,0,,		救救他
Dialogue: 1,1:32:06.91,1:32:07.79,M23-EngSpeak-Chi-A,,0,0,0,,		撤退
Dialogue: 1,1:32:07.79,1:32:10.17,M23-EngSpeak-Chi-A,,0,0,0,,		都撤退重整  通知直升机组
Dialogue: 1,1:32:21.64,1:32:24.35,M23-EngSpeak-Chi-A,,0,0,0,,		尤金  计划大概是要失败了
Dialogue: 1,1:32:24.64,1:32:26.31,M23-EngSpeak-Chi-A,,0,0,0,,		你把宝石拿走吧
Dialogue: 1,1:32:26.52,1:32:29.10,M23-EngSpeak-Chi-A,,0,0,0,,		好好关照现场的诸位
Dialogue: 1,1:32:34.23,1:32:35.65,M23-EngSpeak-Chi-A,,0,0,0,,		你  你们在干什么
Dialogue: 1,1:32:36.19,1:32:37.19,M23-EngSpeak-Chi-A,,0,0,0,,		不许动
Dialogue: 1,1:32:41.07,1:32:44.78,M23-EngSpeak-Chi-A,,0,0,0,,		既然已经拿到宝石了  你就没用了
Dialogue: 1,1:32:44.78,1:32:45.62,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h什么？
Dialogue: 1,1:32:46.33,1:32:49.50,M23-EngSpeak-Chi-A,,0,0,0,,		我就不奉陪了
Dialogue: 1,1:32:49.50,1:32:52.25,M23-EngSpeak-Chi-A,,0,0,0,,		毕竟众所周知  我并不守诺
Dialogue: 1,1:32:52.25,1:32:55.54,M23-EngSpeak-Chi-A,,0,0,0,,		现在有一桩更赚的单子等着我
Dialogue: 1,1:33:32.66,1:33:34.04,M23-EngSpeak-Chi-A,,0,0,0,,		在那  我们追
Dialogue: 1,1:33:34.79,1:33:36.84,M23-EngSpeak-Chi-A,,0,0,0,,		别开枪  你们会误伤她
Dialogue: 1,1:34:09.41,1:34:11.66,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h什么  他们要向我们发射火箭炮？
Dialogue: 1,1:34:29.93,1:34:30.81,M23-EngSpeak-Chi-A,,0,0,0,,		该死
Dialogue: 1,1:34:37.77,1:34:39.06,M23-EngSpeak-Chi-A,,0,0,0,,		抓住他们
Dialogue: 1,1:34:51.28,1:34:52.12,M23-EngSpeak-Chi-A,,0,0,0,,		给我追
Dialogue: 1,1:34:56.83,1:34:57.87,M23-EngSpeak-Chi-A,,0,0,0,,		开门
Dialogue: 1,1:34:57.87,1:34:59.00,M23-EngSpeak-Chi-A,,0,0,0,,		该死的小鬼
Dialogue: 1,1:35:04.63,1:35:06.63,M23-EngSpeak-Chi-A,,0,0,0,,		这里发生什么事了
Dialogue: 1,1:35:06.63,1:35:07.59,M23-EngSpeak-Chi-A,,0,0,0,,		我也不知道
Dialogue: 1,1:35:07.59,1:35:09.89,M23-EngSpeak-Chi-A,,0,0,0,,		大部分海盗都在酒店里
Dialogue: 1,1:35:09.89,1:35:11.93,M23-EngSpeak-Chi-A,,0,0,0,,		酒店里面的情况如何
Dialogue: 1,1:35:11.93,1:35:14.60,M23-EngSpeak-Chi-A,,0,0,0,,		这里也很危险  请回去吧
Dialogue: 1,1:36:07.90,1:36:09.24,M23-EngSpeak-Chi-A,,0,0,0,,		是刚才那家伙
Dialogue: 1,1:36:09.24,1:36:10.41,M23-EngSpeak-Chi-A,,0,0,0,,		把他打下来
Dialogue: 1,1:36:12.07,1:36:13.41,M23-EngSpeak-Chi-A,,0,0,0,,		老大  我们打不中他
Dialogue: 1,1:36:13.41,1:36:15.08,M23-EngSpeak-Chi-A,,0,0,0,,		狡猾的小鸟
Dialogue: 1,1:36:36.64,1:36:37.22,M23-EngSpeak-Chi-A,,0,0,0,,		等等
Dialogue: 1,1:37:00.75,1:37:01.46,M23-EngSpeak-Chi-A,,0,0,0,,		抓住他们
Dialogue: 1,1:37:03.92,1:37:05.09,M23-EngSpeak-Chi-A,,0,0,0,,		别碍事
Dialogue: 1,1:37:07.09,1:37:08.63,M23-EngSpeak-Chi-A,,0,0,0,,		他是
Dialogue: 1,1:37:10.92,1:37:12.01,M23-EngSpeak-Chi-A,,0,0,0,,		我的猎物
Dialogue: 1,1:38:10.53,1:38:11.36,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h什么？
Dialogue: 1,1:38:22.79,1:38:24.71,M23-EngSpeak-Chi-A,,0,0,0,,		基德抢走了宝石
Dialogue: 1,1:38:24.71,1:38:26.50,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h你能把他打下来吗？
Dialogue: 1,1:38:26.71,1:38:27.96,M23-EngSpeak-Chi-A,,0,0,0,,		好的  老大
Dialogue: 1,1:38:34.80,1:38:37.01,M23-EngSpeak-Chi-A,,0,0,0,,		该死  飞来飞去的
Dialogue: 1,1:38:37.30,1:38:38.35,M23-EngSpeak-Chi-A,,0,0,0,,		吃我一炮
Dialogue: 1,1:38:52.94,1:38:53.86,M23-EngSpeak-Chi-A,,0,0,0,,		噢  不好
Dialogue: 1,1:38:54.24,1:38:54.82,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h什么？
Dialogue: 1,1:38:55.61,1:38:56.20,M23-EngSpeak-Chi-A,,0,0,0,,		基德
Dialogue: 1,1:38:56.32,1:38:57.03,M23-EngSpeak-Chi-A,,0,0,0,,		是你
Dialogue: 1,1:38:58.95,1:38:59.57,M23-EngSpeak-Chi-A,,0,0,0,,		等  等等
Dialogue: 1,1:39:07.21,1:39:08.38,M23-EngSpeak-Chi-A,,0,0,0,,		妈呀  救命啊
Dialogue: 1,1:39:09.17,1:39:10.50,M23-EngSpeak-Chi-A,,0,0,0,,		要掉下去了
Dialogue: 1,1:40:22.66,1:40:23.91,M23-EngSpeak-Chi-A,,0,0,0,,		跑哪去了
Dialogue: 1,1:41:38.65,1:41:39.90,M23-EngSpeak-Chi-A,,0,0,0,,		\h\h您没事吧？
Dialogue: 1,0:00:00.00,0:00:05.00,Default,,0,0,0,,
Dialogue: 1,0:00:29.31,0:00:31.31,Default,,0,0,0,,
Dialogue: 1,0:00:57.45,0:00:59.28,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Did　I　make　you　wait?
Dialogue: 1,0:00:59.28,0:01:01.91,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	This　is　a　strange　place　to　meet.
Dialogue: 1,0:01:02.04,0:01:04.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Can　we　talk　in　Japanese?
Dialogue: 1,0:01:04.12,0:01:05.66,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	So　that　people　around　us　won't　listen.
Dialogue: 1,0:01:46.91,0:01:48.67,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Here　is　your　Meursault.
Dialogue: 1,0:01:54.76,0:01:55.34,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Uh,　um.
Dialogue: 1,0:02:15.19,0:02:16.32,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Thanks　for　the　help.
Dialogue: 1,0:02:53.02,0:02:54.52,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey,　are　you　okay?
Dialogue: 1,0:03:12.63,0:03:13.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,0:03:21.43,0:03:22.80,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Please　be　calm!
Dialogue: 1,0:03:22.80,0:03:24.30,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Follow　our　instruction!
Dialogue: 1,0:03:30.18,0:03:31.10,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey,　wait!
Dialogue: 1,0:03:31.89,0:03:32.94,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　are　you　doing?
Dialogue: 1,0:03:33.94,0:03:35.81,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Preserving　the　scene　of　the　crime.
Dialogue: 1,0:03:35.81,0:03:36.69,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Otherwise,...
Dialogue: 1,0:03:36.69,0:03:39.49,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...this　will　be　trampled　over.　Right?
Dialogue: 1,0:03:54.29,0:03:55.21,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Sir!
Dialogue: 1,0:03:55.46,0:03:57.09,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	The　one　I　called?
Dialogue: 1,0:03:57.09,0:03:58.40,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	He's　already　inside.
Dialogue: 1,0:03:58.63,0:03:59.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Thanks.
Dialogue: 1,0:04:01.47,0:04:03.34,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Sorry　to　make　you　wait,　Rishi.
Dialogue: 1,0:04:03.51,0:04:05.01,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Inspector　Aidan!
Dialogue: 1,0:04:05.18,0:04:06.97,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Thank　you　for　calling　me.
Dialogue: 1,0:04:07.18,0:04:10.31,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	The　incident　happened　in　the　shopping　mall　ahead.
Dialogue: 1,0:04:10.64,0:04:13.27,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	This　case　could　be　a　little　tricky.
Dialogue: 1,0:04:14.81,0:04:16.27,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	That　Leon　Lowe...
Dialogue: 1,0:04:16.27,0:04:18.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...first　discovered　the　body
Dialogue: 1,0:04:18.98,0:04:19.98,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Oh,　Mr.　Lowe!
Dialogue: 1,0:04:20.99,0:04:23.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　were　his　favorite　student,　right?
Dialogue: 1,0:04:23.82,0:04:26.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Could　you　ask　him　not　to　interfere　too　much?
Dialogue: 1,0:04:27.12,0:04:28.83,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　can't　ask　him　that.
Dialogue: 1,0:04:28.83,0:04:30.29,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I'll　go　say　hello.
Dialogue: 1,0:04:31.45,0:04:32.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Mr.　Lowe!
Dialogue: 1,0:04:32.79,0:04:35.29,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Rishi!　It　has　been　a　while!
Dialogue: 1,0:04:35.29,0:04:36.04,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes!
Dialogue: 1,0:05:11.74,0:05:13.37,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Is　inspector　there?
Dialogue: 1,0:05:14.20,0:05:16.25,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Excuse　me,　make　way.
Dialogue: 1,0:05:16.67,0:05:17.71,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What's　going　on?
Dialogue: 1,0:05:17.71,0:05:19.84,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There's　something　on　the　elevator　wall.
Dialogue: 1,0:05:20.63,0:05:21.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,0:05:21.96,0:05:23.26,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　is　this?
Dialogue: 1,0:18:06.89,0:18:08.56,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey,　Karate　boy!
Dialogue: 1,0:18:08.73,0:18:10.19,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	How　brave!
Dialogue: 1,0:18:18.15,0:18:20.07,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey,　come　on!
Dialogue: 1,0:21:54.20,0:21:58.79,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　received　the　report　that　SUZUKI　Group　became　the　sponsor　of　Kyogoku.
Dialogue: 1,0:21:58.79,0:22:00.42,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Can　you　beat　him?
Dialogue: 1,0:22:00.42,0:22:01.96,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There's　no　need　for　concern.
Dialogue: 1,0:22:01.96,0:22:03.50,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	No　matter　who,
Dialogue: 1,0:22:03.50,0:22:05.97,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	I'll　put　him　down　in　one　blow.
Dialogue: 1,0:22:05.97,0:22:07.43,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Good　to　know.
Dialogue: 1,0:22:08.59,0:22:09.64,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Come　in.
Dialogue: 1,0:22:09.80,0:22:10.97,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Excuse　me.
Dialogue: 1,0:22:11.39,0:22:14.14,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	Mr.　Ramanathan　has　arrived　with　someone...
Dialogue: 1,0:22:14.14,0:22:15.48,M23-EngSpeak-Eng-C,,0,0,0,,	{\pos(960,1088)}	...he'd　like　to　introduce.
Dialogue: 1,0:22:15.64,0:22:16.93,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	He's　early.
Dialogue: 1,0:22:16.93,0:22:19.19,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Please　bring　him　into　the　lounge.
Dialogue: 1,0:22:19.19,0:22:20.61,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Understood.
Dialogue: 1,0:22:21.77,0:22:23.86,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	So,　how　about　KID?
Dialogue: 1,0:22:24.07,0:22:26.99,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Apologies.　We're　still　investigating.
Dialogue: 1,0:22:27.45,0:22:29.49,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Along　with　Sherilyn　Tan.
Dialogue: 1,0:22:29.49,0:22:32.66,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There　are　issues　with　handling　information.
Dialogue: 1,0:22:32.66,0:22:34.87,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　have　a　hunch　who　is　behind　it.
Dialogue: 1,0:22:34.87,0:22:36.75,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　take　care　with　them.
Dialogue: 1,0:25:08.77,0:25:10.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Mr.　Kyogoku.
Dialogue: 1,0:25:11.11,0:25:13.10,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　was　hoping　to　see　you.
Dialogue: 1,0:25:13.40,0:25:14.36,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Thank　you.
Dialogue: 1,0:25:14.36,0:25:15.99,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　do　Karate,　too.
Dialogue: 1,0:25:15.99,0:25:18.99,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　always　wanted　to　have　a　match　with　you.
Dialogue: 1,0:25:31.13,0:25:32.22,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　weird.
Dialogue: 1,0:25:33.01,0:25:34.84,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　don't　feel　anything.
Dialogue: 1,0:25:40.51,0:25:41.76,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	No　way...
Dialogue: 1,0:26:10.92,0:26:13.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　can't　come　in...　Please　wait.
Dialogue: 1,0:26:13.25,0:26:15.51,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	That's　okay,　don't　bother.
Dialogue: 1,0:26:25.02,0:26:27.98,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Sorry,　he　came　in　all　of　a　sudden.
Dialogue: 1,0:26:27.98,0:26:29.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　alright.
Dialogue: 1,0:26:29.10,0:26:32.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　would　like　to　show　everyone　our　safe　room.
Dialogue: 1,0:26:32.82,0:26:33.61,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	That's　good!
Dialogue: 1,0:26:33.61,0:26:35.61,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I'd　love　to　come　along.
Dialogue: 1,0:27:09.27,0:27:09.98,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,0:27:10.85,0:27:12.61,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Sorry,　sorry!　Nothing!
Dialogue: 1,0:28:04.20,0:28:06.78,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	But　there's　also　security　for　the　stadium.
Dialogue: 1,0:28:07.74,0:28:10.79,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes!　We　shall　guard　it　at　any　cost!
Dialogue: 1,0:28:12.54,0:28:14.29,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	If　anything　happens　to　the　Fist
Dialogue: 1,0:28:14.29,0:28:18.55,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	you　will　be　paying　a　hefty　compensation　fee.
Dialogue: 1,0:30:29.43,0:30:30.64,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　over.
Dialogue: 1,0:30:37.73,0:30:40.54,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　hope　you　like　the　taste　of　Singaporean　water.
Dialogue: 1,0:31:47.00,0:31:47.88,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,0:31:54.47,0:31:55.43,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　happened?
Dialogue: 1,0:31:55.55,0:31:56.51,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　KID!
Dialogue: 1,0:31:57.06,0:31:59.43,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Don't　worry,　I'm　always...
Dialogue: 1,0:32:06.44,0:32:08.44,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...one　step　ahead.
Dialogue: 1,0:32:20.75,0:32:21.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There　he　is.
Dialogue: 1,0:38:24.11,0:38:26.45,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Mr.　Mori,　call　for　you.
Dialogue: 1,0:40:43.71,0:40:45.18,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Bow　to　each　other.
Dialogue: 1,0:40:50.26,0:40:51.51,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Begin!
Dialogue: 1,0:41:25.42,0:41:26.58,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	No　entry!
Dialogue: 1,0:41:27.75,0:41:28.50,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	No.
Dialogue: 1,0:41:35.51,0:41:38.35,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	He's　a　staff　member,　please　let　him　in.
Dialogue: 1,0:41:38.64,0:41:39.64,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes,　sir.
Dialogue: 1,0:46:07.32,0:46:10.33,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Now,　be　alert　and　look　everywhere.
Dialogue: 1,0:46:10.33,0:46:14.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	If　you　see　anything　unusual,　report　it,...
Dialogue: 1,0:46:14.00,0:46:15.50,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...and　act　immediately.
Dialogue: 1,0:46:16.00,0:46:16.71,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	And...
Dialogue: 1,0:46:18.67,0:46:20.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Are　you　okay?
Dialogue: 1,0:46:20.25,0:46:21.88,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I'm　so　sorry!
Dialogue: 1,0:46:22.13,0:46:23.76,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I'm　sorry,　too.
Dialogue: 1,0:46:32.72,0:46:34.31,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Inspector　Aidan.
Dialogue: 1,0:46:35.23,0:46:38.14,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Sorry,　I　couldn't　help　but　notice...
Dialogue: 1,0:46:38.39,0:46:40.52,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I...　I'm　sorry,　what?
Dialogue: 1,0:46:40.90,0:46:42.27,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There　you　go.
Dialogue: 1,0:46:42.57,0:46:44.61,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Keep　up　the　good　work.
Dialogue: 1,0:46:45.07,0:46:46.03,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes,　madam!
Dialogue: 1,0:46:47.78,0:46:49.99,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Everything　ok　with　the　safe?
Dialogue: 1,0:46:50.28,0:46:52.33,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes,　sir.　Everything　is　alright.
Dialogue: 1,0:46:52.53,0:46:54.66,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Excuse　me,　I'm　so　sorry!
Dialogue: 1,0:46:54.66,0:46:55.41,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What's　the　matter?
Dialogue: 1,0:46:55.41,0:46:58.87,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Inspector　Aidan　is　calling　you　to　come　quick!
Dialogue: 1,0:46:59.17,0:47:00.33,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	B...　But...
Dialogue: 1,0:47:00.58,0:47:02.13,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I'll　look　after　this　place.
Dialogue: 1,0:47:02.46,0:47:03.42,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	O...　Okay.
Dialogue: 1,0:47:03.59,0:47:05.71,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	We'll　be　back　soon.　Thank　you.
Dialogue: 1,0:48:11.99,0:48:13.11,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Stop　right　there!
Dialogue: 1,0:48:18.29,0:48:19.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Drop　the　gun　now!
Dialogue: 1,0:48:20.12,0:48:22.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	KID,　you're　under　arrest!
Dialogue: 1,0:48:25.88,0:48:26.38,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,0:48:46.86,0:48:48.02,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	He's　here!
Dialogue: 1,0:49:19.10,0:49:19.76,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Damn!
Dialogue: 1,0:49:20.06,0:49:22.85,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Go,　arrest　him!　At　any　cost!
Dialogue: 1,0:49:22.85,0:49:23.77,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Yes,　sir!
Dialogue: 1,0:49:50.04,0:49:50.71,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Look!
Dialogue: 1,0:49:51.09,0:49:53.72,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There　is　a　giant　bird　in　the　sky.
Dialogue: 1,0:52:28.20,0:52:29.79,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	This　looks　bad!
Dialogue: 1,0:52:30.25,0:52:31.33,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey,　girl.
Dialogue: 1,0:52:31.33,0:52:33.84,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　are　you　gonna　do　about　this?
Dialogue: 1,0:52:36.63,0:52:39.21,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Huh?　I　don't　know　what　you　mean?
Dialogue: 1,0:52:39.46,0:52:40.51,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Come　here!
Dialogue: 1,0:52:47.47,0:52:48.14,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Shit!
Dialogue: 1,0:54:31.03,0:54:31.91,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Is　she　alright?
Dialogue: 1,0:54:31.91,0:54:34.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Looks　alive.　I　am　calling　the　ambulance.
Dialogue: 1,0:54:34.00,0:54:35.16,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Is　she　a　foreigner?
Dialogue: 1,1:01:14.52,1:01:16.27,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　thought　we　were　not　supposed　to　meet...
Dialogue: 1,1:01:16.27,1:01:18.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...until　everything　was　done.
Dialogue: 1,1:01:18.48,1:01:20.65,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　bragged　your　plan　was　perfect.
Dialogue: 1,1:01:20.65,1:01:22.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	But　are　you　totally　sure?
Dialogue: 1,1:01:23.82,1:01:27.07,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　look　tough,　but　actually　you　are　a　coward.
Dialogue: 1,1:01:27.32,1:01:29.58,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Now　watch　your　mouth.
Dialogue: 1,1:01:38.59,1:01:40.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　always　keep　promises.
Dialogue: 1,1:01:40.46,1:01:41.59,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　do.
Dialogue: 1,1:02:04.78,1:02:08.53,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	We　have　an　announcement　to　make.　In　the　second　semifinals　match.
Dialogue: 1,1:02:08.53,1:02:11.08,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Makoto　Kyogoku　has　withdrawn,...
Dialogue: 1,1:02:11.08,1:02:13.87,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...and　Tan　Lee　will　proceed　to　the　finals.
Dialogue: 1,1:02:14.08,1:02:14.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Damn　it!
Dialogue: 1,1:02:15.21,1:02:16.92,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　didn't　ask　for　this!
Dialogue: 1,1:10:06.26,1:10:09.35,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	The　winner　of　Zhonghan　Cup　Karate　is...
Dialogue: 1,1:10:09.97,1:10:13.35,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Jamaldin!
Dialogue: 1,1:10:19.15,1:10:22.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	So,　what　do　you　think　of　my　city　plan?
Dialogue: 1,1:10:25.28,1:10:27.86,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	We　can　not　accept　your　proposal.
Dialogue: 1,1:10:28.11,1:10:28.74,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Why?
Dialogue: 1,1:10:28.87,1:10:31.41,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　lose　nothing　with　this　plan!
Dialogue: 1,1:10:31.41,1:10:33.58,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It　also　benefits　the　country.
Dialogue: 1,1:10:34.08,1:10:35.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　too　hasty.
Dialogue: 1,1:10:35.62,1:10:38.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	If　you　proceed　with　this　much　development,
Dialogue: 1,1:10:38.12,1:10:40.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...some　maybe　forced　out　of　their　homes.
Dialogue: 1,1:10:40.63,1:10:42.92,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	We　can　give　them　another　place!
Dialogue: 1,1:10:42.92,1:10:44.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	My　plan　is　perfect!
Dialogue: 1,1:10:45.59,1:10:47.43,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　are　too　young.
Dialogue: 1,1:10:47.43,1:10:49.76,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Learn　some　more　and　come　back.
Dialogue: 1,1:10:56.73,1:10:58.14,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Old　fool...
Dialogue: 1,1:10:58.77,1:11:01.52,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Your　era　is　now　at　an　end.
Dialogue: 1,1:11:02.23,1:11:04.90,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　will　build　the　new　city.
Dialogue: 1,1:11:18.50,1:11:19.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hands　in　the　air!
Dialogue: 1,1:11:20.63,1:11:21.84,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Okay,　okay...
Dialogue: 1,1:21:52.63,1:21:54.05,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　heading　this　way!
Dialogue: 1,1:22:59.87,1:23:01.03,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Can　we　make　it?
Dialogue: 1,1:23:01.33,1:23:02.33,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　think　so.
Dialogue: 1,1:23:56.92,1:23:58.67,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Look,　It's　KID!
Dialogue: 1,1:23:59.22,1:24:01.68,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　KID!　KID's　here!
Dialogue: 1,1:24:23.87,1:24:26.20,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　really　don't　know　just　about　him...
Dialogue: 1,1:24:58.48,1:24:59.32,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Look!
Dialogue: 1,1:24:59.99,1:25:02.15,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	This　city　will　be　born　again.
Dialogue: 1,1:25:02.45,1:25:03.86,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	With　my　hands.
Dialogue: 1,1:25:06.87,1:25:08.37,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Why　are　you...
Dialogue: 1,1:25:47.95,1:25:49.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Freeze!
Dialogue: 1,1:25:51.37,1:25:52.54,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There's　no　one　here.
Dialogue: 1,1:25:52.54,1:25:54.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	We'll　stop　the　ship　now.
Dialogue: 1,1:26:19.48,1:26:20.52,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	The　tanker!
Dialogue: 1,1:26:20.82,1:26:22.07,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　happened...?
Dialogue: 1,1:26:35.25,1:26:36.25,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Jamaldin.
Dialogue: 1,1:26:37.63,1:26:38.38,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	W...　wait!
Dialogue: 1,1:26:39.04,1:26:40.75,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Jamaldin,　what　are　you　thinking!
Dialogue: 1,1:26:41.05,1:26:42.96,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	The　only　reason　I　work　for　you...
Dialogue: 1,1:26:42.96,1:26:44.97,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...is　to　fight　against　Kyogoku.
Dialogue: 1,1:26:44.97,1:26:47.30,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　have　no　such　reason　anymore.
Dialogue: 1,1:26:47.55,1:26:48.26,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?!
Dialogue: 1,1:27:36.10,1:27:36.89,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hey!
Dialogue: 1,1:27:37.35,1:27:38.23,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Wait!
Dialogue: 1,1:27:49.91,1:27:50.66,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Are　they...
Dialogue: 1,1:27:50.66,1:27:53.08,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...heading　to　the　Marina　Bay　Sands?
Dialogue: 1,1:29:50.82,1:29:51.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Help!
Dialogue: 1,1:29:51.82,1:29:53.45,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Someone　pushed　me　in　the　back!
Dialogue: 1,1:29:55.78,1:29:57.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Help　is　on　the　way!
Dialogue: 1,1:29:57.12,1:29:57.91,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Hurry!
Dialogue: 1,1:29:57.91,1:29:59.20,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Save　him!!
Dialogue: 1,1:32:06.91,1:32:07.79,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Pull　back!
Dialogue: 1,1:32:07.79,1:32:10.17,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	And　regroup!　Tell　the　chopper　too.
Dialogue: 1,1:32:21.64,1:32:24.35,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Eugene,　the　plan　seems　to　have　failed.
Dialogue: 1,1:32:24.64,1:32:26.31,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　can　take　this　jewel.
Dialogue: 1,1:32:26.52,1:32:29.10,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Take　care　of　everyone　here.
Dialogue: 1,1:32:34.23,1:32:35.65,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Wha...　what　are　you　doing?
Dialogue: 1,1:32:36.19,1:32:37.19,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Don't　move.
Dialogue: 1,1:32:41.07,1:32:44.78,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Now　that　I　have　the　jewel,　I　have　no　need　for　you.
Dialogue: 1,1:32:44.78,1:32:45.62,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,1:32:46.33,1:32:49.50,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　have　no　time　for　your　nonsense.
Dialogue: 1,1:32:49.50,1:32:52.25,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　am　known　to　break　promises.
Dialogue: 1,1:32:52.25,1:32:55.54,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　just　there　was　a　more　lucrative　offer.
Dialogue: 1,1:33:32.66,1:33:34.04,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	There!　Come　on!
Dialogue: 1,1:33:34.79,1:33:36.84,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Don't　shoot!　You'll　hit　her.
Dialogue: 1,1:34:09.41,1:34:11.66,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?!　They　are　going　to　shoot　rockets　at　us?!
Dialogue: 1,1:34:29.93,1:34:30.81,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Damn　it!
Dialogue: 1,1:34:37.77,1:34:39.06,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Get　them　now!
Dialogue: 1,1:34:51.28,1:34:52.12,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	After　them!
Dialogue: 1,1:34:56.83,1:34:57.87,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Open　the　door!
Dialogue: 1,1:34:57.87,1:34:59.00,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You　kids!
Dialogue: 1,1:35:04.63,1:35:06.63,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What　is　going　on　here?
Dialogue: 1,1:35:06.63,1:35:07.59,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	I　don't　know.
Dialogue: 1,1:35:07.59,1:35:09.89,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Most　of　the　pirates　are　now　in　the　hotel.
Dialogue: 1,1:35:09.89,1:35:11.93,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Just　what　is　going　on　inside?
Dialogue: 1,1:35:11.93,1:35:14.60,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	It's　dangerous　here,　too.　Please　get　back.
Dialogue: 1,1:36:07.90,1:36:09.24,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	That's　the　guy　again!
Dialogue: 1,1:36:09.24,1:36:10.41,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Shoot　him　down!
Dialogue: 1,1:36:12.07,1:36:13.41,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Boss,　we　can't　hit　up!
Dialogue: 1,1:36:13.41,1:36:15.08,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Pesky　little　bird.
Dialogue: 1,1:36:36.64,1:36:37.22,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Wait!
Dialogue: 1,1:37:00.75,1:37:01.46,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Get　them!
Dialogue: 1,1:37:03.92,1:37:05.09,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Stay　back!
Dialogue: 1,1:37:07.09,1:37:08.63,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	He　is...
Dialogue: 1,1:37:10.92,1:37:12.01,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	...mine!
Dialogue: 1,1:38:10.53,1:38:11.36,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,1:38:22.79,1:38:24.71,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	KID　took　the　jewel.
Dialogue: 1,1:38:24.71,1:38:26.50,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Can　you　shoot　him　down?
Dialogue: 1,1:38:26.71,1:38:27.96,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Okay,　boss.
Dialogue: 1,1:38:34.80,1:38:37.01,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Damn,　stay　still...
Dialogue: 1,1:38:37.30,1:38:38.35,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Take　this!
Dialogue: 1,1:38:52.94,1:38:53.86,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Oh,　no...
Dialogue: 1,1:38:54.24,1:38:54.82,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	What?
Dialogue: 1,1:38:55.61,1:38:56.20,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	KID!
Dialogue: 1,1:38:56.32,1:38:57.03,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	You!
Dialogue: 1,1:38:58.95,1:38:59.57,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	W...　Wait!
Dialogue: 1,1:39:07.21,1:39:08.38,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Help　me,　mom!
Dialogue: 1,1:39:09.17,1:39:10.50,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Falling　down!!!
Dialogue: 1,1:40:22.66,1:40:23.91,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Where　is　he?!
Dialogue: 1,1:41:38.65,1:41:39.90,M23-EngSpeak-Eng-A,,0,0,0,,	{\pos(960,1088)}	Are　you　alright?
