Dialogue: 0,0:00:01.48,0:00:04.35,DefaultSingle-J,,0,0,0,,	今回ばかりはお前の力が必要だ
Dialogue: 0,0:00:05.58,0:00:06.44,DefaultSingle-J,,0,0,0,,	名探偵
Dialogue: 0,0:00:08.06,0:00:08.43,DefaultSingle-J,,0,0,0,,	えっ
Dialogue: 0,0:00:13.45,0:00:15.54,DefaultSingle-J,,0,0,0,,	シンガポールで起きた殺人事件
Dialogue: 0,0:00:16.23,0:00:18.82,DefaultSingle-J,,0,0,0,,	現場には血塗られたキッドの予告状
Dialogue: 0,0:00:19.34,0:00:21.67,DefaultSingle-J,,0,0,0,,	その狙いは伝説の秘宝
Dialogue: 0,0:00:22.05,0:00:25.60,DefaultSingle-J,,0,0,0,,	しかし　４００戦無敗の最強の空手家
Dialogue: 0,0:00:25.96,0:00:27.62,DefaultSingle-J,,0,0,0,,	京極真が立ちはだかる
Dialogue: 0,0:00:28.71,0:00:29.88,DefaultSingle-J,,0,0,0,,	なぜお前が
Dialogue: 0,0:00:29.88,0:00:31.44,DefaultSingle-J,,0,0,0,,	問答無用
Dialogue: 0,0:00:34.29,0:00:36.52,DefaultSingle-J,,0,0,0,,	キッド　なぜ俺をここに
Dialogue: 0,0:00:36.63,0:00:39.11,DefaultSingle-J,,0,0,0,,	中身を言い当ててくれよ　名探偵
Dialogue: 0,0:00:39.54,0:00:43.52,DefaultSingle-J,,0,0,0,,	殺人という名の謎めいた拳の　中身をな
Dialogue: 0,0:00:48.08,0:00:51.26,DefaultSingle-J,,0,0,0,,	キッドのホームをまもなく片付くかと
Dialogue: 0,0:00:51.47,0:00:53.05,DefaultSingle-J,,0,0,0,,	偽りだらけの男に
Dialogue: 0,0:00:53.40,0:00:55.01,DefaultSingle-J,,0,0,0,,	守られたくなんかないわ
Dialogue: 0,0:00:55.75,0:00:56.91,DefaultSingle-J,,0,0,0,,	ねえ　新一
Dialogue: 0,0:00:57.41,0:01:00.17,DefaultSingle-J,,0,0,0,,	私たち　付き合ってるんだよね
Dialogue: 0,0:01:00.59,0:01:03.34,DefaultSingle-J,,0,0,0,,	あんたが黒幕だということはわかってる
Dialogue: 0,0:01:05.00,0:01:07.37,DefaultSingle-J,,0,0,0,,	海底に葬られた伝説の秘宝が
Dialogue: 0,0:01:07.90,0:01:10.96,DefaultSingle-J,,0,0,0,,	時を経て　シンガポールの闇を呼び覚ます
Dialogue: 0,0:01:11.24,0:01:12.16,DefaultSingle-J,,0,0,0,,	まさか　あいつ
Dialogue: 0,0:01:13.35,0:01:15.93,DefaultSingle-J,,0,0,0,,	今度こそ絶対に自分から離れないでください
Dialogue: 0,0:01:17.14,0:01:20.46,DefaultSingle-J,,0,0,0,,	お宝を盗み出しのが　俺の仕事だ
Dialogue: 0,0:01:21.18,0:01:22.90,DefaultSingle-J,,0,0,0,,	死ぬなよ　キッド
Dialogue: 0,0:01:23.53,0:01:25.31,DefaultSingle-J,,0,0,0,,	劇場版名探偵コナン
Dialogue: 0,0:01:25.58,0:01:26.83,DefaultSingle-J,,0,0,0,,	紺青の拳
