Dialogue: 1,0:11:03.81,0:11:05.98,Staff,,0,0,0,,{\fad(100,0)\blur5\bord0.5\fs100\fsp15\c&H000000&\3c&H646464&\pos(960,890)}与你相恋到生命尽头\N{\fs30}Nekomoe kissaten
Dialogue: 5,0:00:03.06,0:00:04.22,Text_JP,,0,0,0,,シーナ
Dialogue: 5,0:00:04.22,0:00:04.90,Text_JP,,0,0,0,,え
Dialogue: 5,0:00:11.89,0:00:13.62,Text_JP,,0,0,0,,シーナはどうしたいの
Dialogue: 5,0:00:14.47,0:00:15.25,Text_JP,,0,0,0,,私？
Dialogue: 5,0:00:16.38,0:00:18.79,Text_JP,,0,0,0,,私の　望みは…
Dialogue: 5,0:00:28.26,0:00:31.04,Text_JP,,0,0,0,,私の　望み…
Dialogue: 5,0:02:03.65,0:02:04.88,Text_JP,,0,0,0,,ねえ　シーナ
Dialogue: 5,0:02:05.33,0:02:07.97,Text_JP,,0,0,0,,本当にペンもノートもいらないの
Dialogue: 5,0:02:08.26,0:02:11.24,Text_JP,,0,0,0,,うん　返礼の日は授業じゃないから
Dialogue: 5,0:02:11.59,0:02:14.85,Text_JP,,0,0,0,,ほら　制服もいつもと違うでしょ
Dialogue: 5,0:02:17.42,0:02:21.10,Text_JP,,0,0,0,,なお　書庫の掃除は数年ぶりになりますので
Dialogue: 5,0:02:21.10,0:02:23.37,Text_JP,,0,0,0,,隅々までしっかりお願いします
Dialogue: 5,0:02:23.37,0:02:24.97,Text_JP,,0,0,0,,ええ
Dialogue: 5,0:02:26.62,0:02:28.38,Top_JP,,0,0,0,,みんな　嫌がってたね
Dialogue: 5,0:02:35.09,0:02:36.30,Text_JP,,0,0,0,,どっちだっけ
Dialogue: 5,0:02:36.30,0:02:37.93,Text_JP,,0,0,0,,ミミ　わかるよ
Dialogue: 5,0:02:37.93,0:02:39.37,Text_JP,,0,0,0,,本がいっぱいあるところでしょ
Dialogue: 5,0:02:39.37,0:02:41.88,Text_JP,,0,0,0,,走らなくても大丈夫だよお…
Dialogue: 5,0:02:43.01,0:02:46.20,Text_JP,,0,0,0,,わあ　こんなにあるんだ
Dialogue: 5,0:02:48.07,0:02:49.73,Text_JP,,0,0,0,,あら　来たわね
Dialogue: 5,0:02:49.91,0:02:52.10,Text_JP,,0,0,0,,ごめんね　ちょっと遅れちゃった
Dialogue: 5,0:02:52.10,0:02:54.07,Text_JP,,0,0,0,,ミミが寝坊したんだよ
Dialogue: 5,0:02:54.07,0:02:55.74,Text_JP,,0,0,0,,笑っていうことじゃないでしょ
Dialogue: 5,0:02:57.85,0:02:59.66,Text_JP,,0,0,0,,奥に　オミ先生いるから
Dialogue: 5,0:02:59.66,0:03:02.58,Text_JP,,0,0,0,,どこ掃除すればいいか　教えてくれると思う
Dialogue: 5,0:03:02.90,0:03:03.81,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:03:05.03,0:03:08.94,Text_JP,,0,0,0,,棚の整理が済んだら　床掃除もありますからね
Dialogue: 5,0:03:08.94,0:03:11.50,Text_JP,,0,0,0,,オミ先生　遅れてすみません
Dialogue: 5,0:03:11.82,0:03:12.76,Text_JP,,0,0,0,,トツキさん
Dialogue: 5,0:03:13.28,0:03:16.74,Text_JP,,0,0,0,,では　二人はこの列の掃除をお願いします
Dialogue: 5,0:03:16.74,0:03:17.47,Text_JP,,0,0,0,,はい
Dialogue: 5,0:03:17.89,0:03:19.16,Text_JP,,0,0,0,,行こう　ミミ
Dialogue: 5,0:03:19.16,0:03:19.97,Text_JP,,0,0,0,,うん
Dialogue: 5,0:03:24.65,0:03:26.04,Text_JP,,0,0,0,,すごい埃
Dialogue: 5,0:03:28.73,0:03:31.59,Text_JP,,0,0,0,,シーナ　これ全部千切れてる
Dialogue: 5,0:03:33.11,0:03:35.17,Text_JP,,0,0,0,,ダメだよ　ちゃんと拾って
Dialogue: 5,0:03:35.17,0:03:38.42,Text_JP,,0,0,0,,傷んだ本は分けておいてって　オミ先生言ってたでしょ
Dialogue: 5,0:03:38.42,0:03:39.49,Text_JP,,0,0,0,,そっか
Dialogue: 5,0:03:39.68,0:03:43.15,Text_JP,,0,0,0,,えっと　これが51ページだから…
Dialogue: 5,0:03:45.13,0:03:46.01,Text_JP,,0,0,0,,「呪い」？
Dialogue: 5,0:03:47.64,0:03:49.76,Text_JP,,0,0,0,,「魔法の　代償」…
Dialogue: 5,0:03:52.08,0:03:57.17,Text_JP,,0,0,0,,そう　ミミはね　蘇生魔法で蘇らせた子
Dialogue: 5,0:03:57.70,0:03:59.68,Text_JP,,0,0,0,,母親が禁忌を破ってね
Dialogue: 5,0:04:02.47,0:04:04.22,Text_JP,,0,0,0,,シーナはどうしたいの
Dialogue: 5,0:04:05.32,0:04:08.04,Text_JP,,0,0,0,,解く方法とか　あるのかな
Dialogue: 5,0:04:09.12,0:04:10.21,Text_JP,,0,0,0,,シーナ
Dialogue: 5,0:04:10.77,0:04:12.69,Text_JP,,0,0,0,,文字がうにょうにょ
Dialogue: 5,0:04:14.19,0:04:15.42,Text_JP,,0,0,0,,シーナもやろう
Dialogue: 5,0:04:15.75,0:04:17.91,Text_JP,,0,0,0,,ちょっと　ダメだってば
Dialogue: 5,0:04:18.73,0:04:21.45,Text_JP,,0,0,0,,第一　私には無理だよ
Dialogue: 5,0:04:21.45,0:04:22.87,Text_JP,,0,0,0,,え　なんで
Dialogue: 5,0:04:23.14,0:04:27.86,Text_JP,,0,0,0,,私の魔力じゃ　本を1冊持ち上げるだけで精一杯なんだもん
Dialogue: 5,0:04:33.81,0:04:34.51,Text_JP,,0,0,0,,ほら
Dialogue: 5,0:04:36.52,0:04:39.02,Text_JP,,0,0,0,,誰かを助けられるわけでもないし
Dialogue: 5,0:04:39.38,0:04:41.22,Text_JP,,0,0,0,,ほんと　役立たずだよね
Dialogue: 5,0:04:41.75,0:04:43.59,Text_JP,,0,0,0,,でも　お掃除は上手だよ
Dialogue: 5,0:04:44.73,0:04:46.88,Text_JP,,0,0,0,,美味しいクッキーも焼けるし
Dialogue: 5,0:04:49.22,0:04:50.08,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:05:05.97,0:05:09.41,Text_JP,,0,0,0,,ごめんね　向こうでずっと踏み台使ってたから
Dialogue: 5,0:05:12.55,0:05:13.41,Text_JP,,0,0,0,,ハル
Dialogue: 5,0:05:14.01,0:05:16.03,Text_JP,,0,0,0,,先生があっち手伝えって
Dialogue: 5,0:05:16.57,0:05:17.51,Text_JP,,0,0,0,,今行く
Dialogue: 5,0:05:19.57,0:05:21.68,Text_JP,,0,0,0,,じゃあ　残り預かるね
Dialogue: 5,0:05:22.06,0:05:22.75,Text_JP,,0,0,0,,うん
Dialogue: 5,0:05:28.09,0:05:28.94,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:05:34.02,0:05:36.24,Text_JP,,0,0,0,,本　ばらばらになっちゃった
Dialogue: 5,0:05:36.24,0:05:37.06,Text_JP,,0,0,0,,なんで
Dialogue: 5,0:05:37.63,0:05:40.25,Text_JP,,0,0,0,,大丈夫　どこもぶつけなかった
Dialogue: 5,0:05:40.57,0:05:42.02,Text_JP,,0,0,0,,痛いところはない
Dialogue: 5,0:05:42.56,0:05:43.33,Text_JP,,0,0,0,,ここ
Dialogue: 5,0:05:45.59,0:05:46.73,Text_JP,,0,0,0,,痛かったね
Dialogue: 5,0:05:50.67,0:05:51.62,Text_JP,,0,0,0,,よしよし
Dialogue: 5,0:05:52.77,0:05:53.94,Text_JP,,0,0,0,,大丈夫だよ
Dialogue: 5,0:05:57.83,0:05:59.44,Text_JP,,0,0,0,,もっと…
Dialogue: 5,0:05:59.44,0:06:00.15,Text_JP,,0,0,0,,え
Dialogue: 5,0:06:00.67,0:06:01.56,Text_JP,,0,0,0,,もっと…
Dialogue: 5,0:06:06.11,0:06:06.92,Text_JP,,0,0,0,,ミミ…
Dialogue: 5,0:06:10.71,0:06:12.92,Text_JP,,0,0,0,,もっとして　もっと
Dialogue: 5,0:06:15.42,0:06:16.40,Text_JP,,0,0,0,,シーナ？
Dialogue: 5,0:06:16.66,0:06:18.25,Text_JP,,0,0,0,,すごい音がしたけど
Dialogue: 5,0:06:19.65,0:06:21.49,Text_JP,,0,0,0,,大丈夫　平気だよ
Dialogue: 5,0:06:39.10,0:06:40.91,Text_JP,,0,800,0,,終わった
Dialogue: 5,0:06:39.10,0:06:40.91,Text_JP,,800,0,0,,終わった
Dialogue: 5,0:06:42.18,0:06:44.22,Text_JP,,0,0,0,,結構汚れちゃったね
Dialogue: 5,0:06:44.48,0:06:46.22,Text_JP,,0,0,0,,へんれい　楽しかった
Dialogue: 5,0:06:46.22,0:06:47.43,Text_JP,,0,0,0,,それは何より
Dialogue: 5,0:06:47.65,0:06:50.49,Text_JP,,0,0,0,,でも　返礼の日はこれだけじゃないんだよ
Dialogue: 5,0:06:50.49,0:06:51.46,Text_JP,,0,0,0,,そうなの
Dialogue: 5,0:06:52.73,0:06:53.48,Text_JP,,0,0,0,,ほら
Dialogue: 5,0:06:55.93,0:06:57.99,Text_JP,,0,0,0,,みんな　集まってる
Dialogue: 5,0:06:58.61,0:06:59.78,Text_JP,,0,0,0,,見に行こっか
Dialogue: 5,0:06:59.78,0:07:00.53,Text_JP,,0,0,0,,うん
Dialogue: 5,0:07:01.41,0:07:02.35,Text_JP,,0,0,0,,あっ　そうだ
Dialogue: 5,0:07:02.64,0:07:05.25,Text_JP,,0,0,0,,その前に　ちょっと取ってきたいものあるから
Dialogue: 5,0:07:05.25,0:07:07.94,Text_JP,,0,0,0,,ここで待っててくれる　すぐ戻るから
Dialogue: 5,0:07:08.27,0:07:09.59,Text_JP,,0,0,0,,ほーい
Dialogue: 5,0:07:21.03,0:07:22.93,Text_JP,,0,0,0,,キラキラー
Dialogue: 5,0:07:23.72,0:07:25.79,Text_JP,,0,0,0,,ねえ　もしかして…
Dialogue: 5,0:07:26.25,0:07:27.48,Text_JP,,0,0,0,,君が「ミミ」
Dialogue: 5,0:07:30.04,0:07:31.00,Text_JP,,0,0,0,,ミミ
Dialogue: 5,0:07:32.84,0:07:35.71,Text_JP,,0,0,0,,しまった　置いてくんじゃなかったな
Dialogue: 5,0:07:35.71,0:07:37.11,Top_JP,,0,0,0,,かわいい
Dialogue: 5,0:07:37.11,0:07:38.27,Top_JP,,0,0,0,,リボンが似合うね
Dialogue: 5,0:07:38.27,0:07:40.69,Top_JP,,0,0,0,,おお　ぴったり
Dialogue: 5,0:07:41.28,0:07:43.97,Text_JP,,0,0,0,,先輩たちが　盛り上がってる
Dialogue: 5,0:07:45.57,0:07:47.81,Text_JP,,0,0,0,,本当　お人形さんみたい
Dialogue: 5,0:07:47.81,0:07:49.33,Text_JP,,0,0,0,,よく似合ってる
Dialogue: 5,0:07:50.29,0:07:51.60,Text_JP,,0,0,0,,こっち見て
Dialogue: 5,0:07:51.60,0:07:52.57,Text_JP,,0,0,0,,いいよ
Dialogue: 5,0:07:52.57,0:07:53.30,Text_JP,,0,0,0,,ミミ
Dialogue: 5,0:07:54.14,0:07:56.68,Text_JP,,0,0,0,,ああ　シーナ
Dialogue: 5,0:07:57.86,0:07:58.88,Text_JP,,0,0,0,,すみません
Dialogue: 5,0:08:02.41,0:08:03.72,Text_JP,,0,0,0,,どういう状況
Dialogue: 5,0:08:03.72,0:08:06.84,Text_JP,,0,0,0,,いや　ごめんね　着せ替え人形にしちゃって
Dialogue: 5,0:08:06.84,0:08:08.97,Text_JP,,0,0,0,,何着せても可愛くて
Dialogue: 5,0:08:09.14,0:08:10.18,Text_JP,,0,0,0,,い…いえ
Dialogue: 5,0:08:10.18,0:08:12.15,Text_JP,,0,0,0,,でも　シャツも汚れてたし
Dialogue: 5,0:08:12.15,0:08:13.56,Text_JP,,0,0,0,,ちょうどいいかなって
Dialogue: 5,0:08:14.12,0:08:14.80,Text_JP,,0,0,0,,あれ
Dialogue: 5,0:08:15.93,0:08:16.98,Text_JP,,0,0,0,,この人…
Dialogue: 5,0:08:18.52,0:08:20.00,Text_JP,,0,0,0,,チューしてた人
Dialogue: 5,0:08:20.00,0:08:22.04,Text_JP,,0,0,0,,えっ　ちょっと　ミミ
Dialogue: 5,0:08:22.57,0:08:24.79,Text_JP,,0,0,0,,すみません　すみません　すみません
Dialogue: 5,0:08:24.79,0:08:25.52,Text_JP,,0,0,0,,すみません…
Dialogue: 5,0:08:25.52,0:08:27.36,Text_JP,,0,0,0,,16クラスのエスタだよ
Dialogue: 5,0:08:27.80,0:08:30.14,Text_JP,,0,0,0,,よかったら持っていって　その服
Dialogue: 5,0:08:30.14,0:08:30.98,Text_JP,,0,0,0,,いいの
Dialogue: 5,0:08:32.42,0:08:34.97,Text_JP,,0,0,0,,これぞ　返礼の日の醍醐味だよ
Dialogue: 5,0:08:34.97,0:08:35.82,Text_JP,,0,0,0,,ゴミ？
Dialogue: 5,0:08:36.61,0:08:39.35,Text_JP,,0,0,0,,廊下に　いろんな物が並んでいるでしょ
Dialogue: 5,0:08:39.35,0:08:39.87,Text_JP,,0,0,0,,うん
Dialogue: 5,0:08:40.11,0:08:42.98,Text_JP,,0,0,0,,並んでいる物は　何でも持って帰っていいの
Dialogue: 5,0:08:43.36,0:08:44.43,Text_JP,,0,0,0,,これも
Dialogue: 5,0:08:44.43,0:08:45.32,Text_JP,,0,0,0,,気に入った
Dialogue: 5,0:08:46.97,0:08:47.70,Text_JP,,0,0,0,,うん
Dialogue: 5,0:08:48.29,0:08:50.71,Text_JP,,0,0,0,,あ…ありがとうございます
Dialogue: 5,0:08:51.11,0:08:53.80,Text_JP,,0,0,0,,ミミ　お休みの日も制服だったから
Dialogue: 5,0:08:54.43,0:08:55.31,Text_JP,,0,0,0,,よかったね
Dialogue: 5,0:08:55.47,0:08:56.21,Text_JP,,0,0,0,,うん
Dialogue: 5,0:08:56.21,0:08:57.17,Text_JP,,0,0,0,,似合ってるよ
Dialogue: 5,0:08:57.17,0:08:58.31,Text_JP,,0,0,0,,本当
Dialogue: 5,0:08:58.87,0:08:59.96,Text_JP,,0,0,0,,君もどう
Dialogue: 5,0:09:00.25,0:09:01.06,Text_JP,,0,0,0,,えっ
Dialogue: 5,0:09:01.06,0:09:02.40,Text_JP,,0,0,0,,同じワンピース
Dialogue: 5,0:09:09.25,0:09:11.43,Text_JP,,0,0,0,,こっちは　僕が着てた方だけど
Dialogue: 5,0:09:12.87,0:09:15.34,Text_JP,,0,0,0,,いや　嬉しいですけど
Dialogue: 5,0:09:15.34,0:09:18.13,Text_JP,,0,0,0,,でも　私はこんなかわいい服…
Dialogue: 5,0:09:18.85,0:09:21.67,Text_JP,,0,0,0,,お願い　貰ってくれないかな
Dialogue: 5,0:09:22.34,0:09:24.38,Text_JP,,0,0,0,,もう　一緒に着られないから
Dialogue: 5,0:09:39.97,0:09:40.79,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:09:44.54,0:09:45.52,Text_JP,,0,0,0,,おそろい？
Dialogue: 5,0:09:47.37,0:09:48.10,Text_JP,,0,0,0,,うん
Dialogue: 5,0:09:49.49,0:09:51.51,Text_JP,,0,0,0,,あの　よかったら…
Dialogue: 5,0:09:55.48,0:09:57.46,Text_JP,,0,0,0,,そっか　君かあ
Dialogue: 5,0:09:57.95,0:10:00.60,Text_JP,,0,0,0,,返礼の日に　美味しいお菓子置いていく子
Dialogue: 5,0:10:00.60,0:10:00.99,Text_JP,,0,0,0,,えっ
Dialogue: 5,0:10:00.99,0:10:03.00,Text_JP,,0,0,0,,いつも話題になってるんだよお
Dialogue: 5,0:10:03.55,0:10:06.21,Text_JP,,0,0,0,,すみません　ほんのお礼のつもりで
Dialogue: 5,0:10:07.67,0:10:09.51,Text_JP,,0,0,0,,噂のクッキー　嬉しい
Dialogue: 5,0:10:09.95,0:10:10.87,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:10:12.08,0:10:13.80,Text_JP,,0,0,0,,ミミも食べる
Dialogue: 5,0:10:13.80,0:10:14.89,Text_JP,,0,0,0,,帰ってからね
Dialogue: 5,0:10:20.07,0:10:21.18,Text_JP,,0,0,0,,おいしい
Dialogue: 5,0:10:22.59,0:10:24.94,Text_JP,,0,0,0,,なんで枯れてるの　貰ってきたの
Dialogue: 5,0:10:25.13,0:10:27.19,Text_JP,,0,0,0,,まだ　枯れきってないから
Dialogue: 5,0:10:29.77,0:10:31.07,Text_JP,,0,0,0,,本当にいいの
Dialogue: 5,0:10:31.61,0:10:33.93,Text_JP,,0,0,0,,後で処分するつもりだったんだよ
Dialogue: 5,0:10:34.22,0:10:36.29,Text_JP,,0,0,0,,もう　花も咲きそうにないし
Dialogue: 5,0:10:37.59,0:10:39.32,Text_JP,,0,0,0,,まだ　生きてるもの
Dialogue: 5,0:10:41.69,0:10:43.57,Text_JP,,0,0,0,,生きてる　ね
Dialogue: 5,0:10:43.96,0:10:46.86,Text_JP,,0,0,0,,シーナ　一緒に食べよう
Dialogue: 5,0:10:47.53,0:10:48.15,Text_JP,,0,0,0,,うん
Dialogue: 5,0:11:33.85,0:11:34.72,Text_JP,,0,0,0,,ただいま
Dialogue: 5,0:11:35.09,0:11:35.98,Text_JP,,0,0,0,,おかえり
Dialogue: 5,0:11:37.31,0:11:38.35,Text_JP,,0,0,0,,早かったね
Dialogue: 5,0:11:38.35,0:11:39.39,Text_JP,,0,0,0,,そうなの
Dialogue: 5,0:11:39.75,0:11:41.71,Text_JP,,0,0,0,,どうする　何か食べ…
Dialogue: 5,0:11:43.11,0:11:45.05,Text_JP,,0,0,0,,ミミ　それ…
Dialogue: 5,0:11:46.58,0:11:50.69,Text_JP,,0,0,0,,ああ　今日は汚れてないと思ったのに
Dialogue: 5,0:11:51.41,0:11:53.95,Text_JP,,0,0,0,,ミミが　怪我してるわけじゃないのね
Dialogue: 5,0:11:54.65,0:11:57.57,Text_JP,,0,0,0,,うん　ミミはへいきー
Dialogue: 5,0:12:00.71,0:12:03.76,Text_JP,,0,0,0,,お風呂まだ空いてるから　一緒に行こうか
Dialogue: 5,0:12:03.76,0:12:04.50,Text_JP,,0,0,0,,うん
Dialogue: 5,0:12:09.48,0:12:13.17,Text_JP,,0,0,0,,今日は　フラン先生のところで着替えてこなくてよかったの
Dialogue: 5,0:12:13.17,0:12:15.28,Text_JP,,0,0,0,,そのまま帰ってきちゃった
Dialogue: 5,0:12:15.28,0:12:17.93,Text_JP,,0,0,0,,それって　フラン先生に怒られない
Dialogue: 5,0:12:18.10,0:12:21.39,Text_JP,,0,0,0,,だって　シーナが待っててくれると思ったから
Dialogue: 5,0:12:22.35,0:12:23.31,Text_JP,,0,0,0,,それに…
Dialogue: 5,0:12:23.80,0:12:26.05,Text_JP,,0,0,0,,お風呂入るのも　シーナとがいい
Dialogue: 5,0:12:28.52,0:12:29.33,Text_JP,,0,0,0,,うん…
Dialogue: 5,0:12:30.02,0:12:31.50,Text_JP,,0,0,0,,早く行こう
Dialogue: 5,0:12:31.90,0:12:34.56,Text_JP,,0,0,0,,ちょっと　夜だから静かに
Dialogue: 5,0:12:47.32,0:12:49.61,Text_JP,,0,0,0,,へんれいのひ　楽しかったね
Dialogue: 5,0:12:50.33,0:12:51.38,Text_JP,,0,0,0,,そうだね
Dialogue: 5,0:12:51.54,0:12:53.38,Text_JP,,0,0,0,,またみんなで回りたいね
Dialogue: 5,0:12:55.37,0:12:56.27,Text_JP,,0,0,0,,そうだね
Dialogue: 5,0:12:56.70,0:12:58.54,Text_JP,,0,0,0,,次はいつかなあ
Dialogue: 5,0:12:58.99,0:13:00.93,Text_JP,,0,0,0,,流すから　目閉じててね
Dialogue: 5,0:13:01.40,0:13:02.13,Text_JP,,0,0,0,,うん
Dialogue: 5,0:13:03.57,0:13:06.41,Text_JP,,0,0,0,,ミミから　血の匂いがする
Dialogue: 5,0:13:08.42,0:13:11.59,Text_JP,,0,0,0,,今日もミミは　たくさんの敵を…
Dialogue: 5,0:13:12.01,0:13:14.44,Text_JP,,0,0,0,,人を　殺し続けている
Dialogue: 5,0:13:15.48,0:13:17.44,Text_JP,,0,0,0,,こんな小さな体で
Dialogue: 5,0:13:18.27,0:13:22.05,Text_JP,,0,0,0,,自分が何をしているのか　わからないまま
Dialogue: 5,0:13:31.94,0:13:33.79,Text_JP,,0,0,0,,ミミ　自分で流せるよ
Dialogue: 5,0:13:42.00,0:13:43.38,Text_JP,,0,0,0,,シーナも洗ったげる
Dialogue: 5,0:13:43.38,0:13:44.72,Text_JP,,0,0,0,,えっ　わ…私は…
Dialogue: 5,0:13:48.69,0:13:50.69,Text_JP,,0,0,0,,いたたたたたたたたた…
Dialogue: 5,0:13:50.98,0:13:52.75,Text_JP,,0,0,0,,じゃん　ウサギ
Dialogue: 5,0:13:53.85,0:13:54.90,Text_JP,,0,0,0,,ミミも見て
Dialogue: 5,0:13:56.41,0:13:57.16,Text_JP,,0,0,0,,チュー
Dialogue: 5,0:14:03.24,0:14:04.94,Text_JP,,0,0,0,,頭　流してあげるね
Dialogue: 5,0:14:04.94,0:14:06.71,Text_JP,,0,0,0,,えっ　ちょ…ミミ
Dialogue: 5,0:14:06.71,0:14:08.77,Text_JP,,0,0,0,,私も　自分で流せるし
Dialogue: 5,0:14:08.77,0:14:11.33,Text_JP,,0,0,0,,ほら　早くお風呂入らないと体冷えちゃうから…
Dialogue: 5,0:14:12.47,0:14:13.79,Text_JP,,0,0,0,,ちょっと　ミミ　ダメ
Dialogue: 5,0:14:13.79,0:14:14.95,Text_JP,,0,0,0,,強いってば
Dialogue: 5,0:14:14.32,0:14:15.54,Top_JP,,0,0,0,,それ　それえ
Dialogue: 5,0:14:16.35,0:14:19.56,Text_JP,,0,0,0,,ほら　お風呂あったまるよ　ミミ
Dialogue: 5,0:14:21.26,0:14:24.72,Text_JP,,0,0,0,,ミミは　ずっと昔から人を殺してきた
Dialogue: 5,0:14:25.89,0:14:28.87,Text_JP,,0,0,0,,その　悲しみも苦しみもわからず
Dialogue: 5,0:14:29.31,0:14:33.24,Text_JP,,0,0,0,,そして　そんな日々がこれからも続いていく
Dialogue: 5,0:14:34.40,0:14:36.99,Text_JP,,0,0,0,,そんなの　私は…
Dialogue: 5,0:14:37.70,0:14:39.08,Text_JP,,0,0,0,,私は嫌だよ
Dialogue: 5,0:14:39.97,0:14:40.73,Text_JP,,0,0,0,,ミミ…
Dialogue: 5,0:14:49.67,0:14:51.41,Text_JP,,0,0,0,,貸し切りだねえ
Dialogue: 5,0:14:51.41,0:14:53.31,Text_JP,,0,0,0,,そうだねえ
Dialogue: 5,0:14:54.77,0:14:56.63,Text_JP,,0,0,0,,あったかいねえ
Dialogue: 5,0:14:56.63,0:14:58.22,Text_JP,,0,0,0,,あったかいねえ…
Dialogue: 5,0:15:01.77,0:15:02.79,Text_JP,,0,0,0,,バタ足…
Dialogue: 5,0:15:03.64,0:15:06.14,Text_JP,,0,0,0,,まあ　誰もいないからいいか
Dialogue: 5,0:15:18.52,0:15:20.69,Text_JP,,0,0,0,,じゃーん　水冠
Dialogue: 5,0:15:20.69,0:15:21.89,Text_JP,,0,0,0,,似合ってる
Dialogue: 5,0:15:24.89,0:15:25.82,Text_JP,,0,0,0,,ありがとう
Dialogue: 5,0:15:29.56,0:15:31.41,Text_JP,,0,0,0,,それは　何の魔法
Dialogue: 5,0:15:31.67,0:15:34.41,Text_JP,,0,0,0,,これは　今日テキが使ってたやつだよ
Dialogue: 5,0:15:35.94,0:15:38.42,Text_JP,,0,0,0,,こんな風に　とげとげしててねえ
Dialogue: 5,0:15:38.88,0:15:39.69,Text_JP,,0,0,0,,でも…
Dialogue: 5,0:15:41.69,0:15:44.29,Text_JP,,0,0,0,,ミミ　いっぱいやっつけたんだ
Dialogue: 5,0:15:47.39,0:15:48.07,Text_JP,,0,0,0,,ミミ…
Dialogue: 5,0:15:48.07,0:15:48.74,Text_JP,,0,0,0,,ん？
Dialogue: 5,0:15:49.22,0:15:54.18,Text_JP,,0,0,0,,例えばね　ミミが戦場に行ったきり帰ってこれなかったら
Dialogue: 5,0:15:54.18,0:15:55.08,Text_JP,,0,0,0,,どう思う
Dialogue: 5,0:15:55.40,0:15:58.36,Text_JP,,0,0,0,,フラン先生や私に　二度と会えなくなったら
Dialogue: 5,0:15:58.36,0:15:59.92,Text_JP,,0,0,0,,そんなの　嫌だよ
Dialogue: 5,0:15:59.92,0:16:02.90,Text_JP,,0,0,0,,だけど　戦争ってそういうことなの
Dialogue: 5,0:16:03.89,0:16:06.21,Text_JP,,0,0,0,,ミミが今日やっつけた人たちにも
Dialogue: 5,0:16:06.21,0:16:07.95,Text_JP,,0,0,0,,きっと　帰りたい場所があって
Dialogue: 5,0:16:08.34,0:16:10.90,Text_JP,,0,0,0,,「ただいま」って　言いたい相手がいたと思う
Dialogue: 5,0:16:11.20,0:16:12.12,Text_JP,,0,0,0,,だけど…
Dialogue: 5,0:16:12.54,0:16:16.30,Text_JP,,0,0,0,,死んでしまったら　もう二度と誰にも会えないし
Dialogue: 5,0:16:16.30,0:16:17.64,Text_JP,,0,0,0,,どこにも帰れない
Dialogue: 5,0:16:18.14,0:16:20.96,Text_JP,,0,0,0,,戦争は　すごく悲しいものなの
Dialogue: 5,0:16:21.24,0:16:23.10,Text_JP,,0,0,0,,でも　ミミ死なないよ
Dialogue: 5,0:16:23.10,0:16:23.59,Text_JP,,0,0,0,,だから…
Dialogue: 5,0:16:24.26,0:16:25.69,Text_JP,,0,0,0,,そうじゃなくて…
Dialogue: 5,0:16:26.61,0:16:28.61,Text_JP,,0,0,0,,ミミを否定したいわけじゃない
Dialogue: 5,0:16:29.10,0:16:34.16,Text_JP,,0,0,0,,でも　誰の命も物みたいに扱っていいはずがない
Dialogue: 5,0:16:34.67,0:16:38.69,Text_JP,,0,0,0,,えっと…ミミも敵も　本当はみんな大切で
Dialogue: 5,0:16:38.69,0:16:41.38,Text_JP,,0,0,0,,テキも　テキも大切なの
Dialogue: 5,0:16:41.38,0:16:42.61,Text_JP,,0,0,0,,それは…
Dialogue: 5,0:16:43.87,0:16:47.54,Text_JP,,0,0,0,,そうだ　ミミにこんなこと言えるほど
Dialogue: 5,0:16:47.54,0:16:49.60,Text_JP,,0,0,0,,私も分かっているわけじゃない
Dialogue: 5,0:16:50.70,0:16:52.20,Text_JP,,0,0,0,,どうしたらいいかなんて
Dialogue: 5,0:16:53.50,0:16:55.20,Text_JP,,0,0,0,,シーナはどうしたいの
Dialogue: 5,0:16:56.33,0:16:58.90,Text_JP,,0,0,0,,ごめんね　おかしなこと言って
Dialogue: 5,0:16:59.31,0:17:02.16,Text_JP,,0,0,0,,でも　どうしてもミミに聞いてほしくて
Dialogue: 5,0:17:07.97,0:17:09.66,Text_JP,,0,0,0,,ありがとう　シーナ
Dialogue: 5,0:17:09.97,0:17:10.97,Text_JP,,0,0,0,,え
Dialogue: 5,0:17:10.97,0:17:12.46,Text_JP,,0,0,0,,おかしくなんかないよ
Dialogue: 5,0:17:12.46,0:17:14.93,Text_JP,,0,0,0,,ミミ　ちゃんと大切にできるよ
Dialogue: 5,0:17:20.98,0:17:21.86,Text_JP,,0,0,0,,シーナ？
Dialogue: 5,0:17:22.31,0:17:23.59,Text_JP,,0,0,0,,のぼせちゃった
Dialogue: 5,0:17:26.78,0:17:28.07,Text_JP,,0,0,0,,どうぞお
Dialogue: 5,0:17:29.54,0:17:30.92,Text_JP,,0,0,0,,失礼します
Dialogue: 5,0:17:33.92,0:17:35.51,Text_JP,,0,0,0,,なるほどね
Dialogue: 5,0:17:35.51,0:17:37.66,Text_JP,,0,0,0,,どおりで　昨夜来なかったわけだ
Dialogue: 5,0:17:37.89,0:17:42.47,Text_JP,,0,0,0,,それで　床についた血を落とす薬品か何かあればと思って
Dialogue: 5,0:17:43.31,0:17:46.42,Text_JP,,0,0,0,,ミミ　保健室の机の棚の中
Dialogue: 5,0:17:46.42,0:17:48.63,Text_JP,,0,0,0,,緑の小瓶　自分で取ってきな
Dialogue: 5,0:17:48.86,0:17:51.62,Text_JP,,0,0,0,,ええ　もう
Dialogue: 5,0:17:54.10,0:17:55.69,Text_JP,,0,0,0,,大変だったでしょう
Dialogue: 5,0:17:55.69,0:17:56.40,Text_JP,,0,0,0,,え
Dialogue: 5,0:17:56.85,0:17:58.47,Text_JP,,0,0,0,,アイツ　風呂に入れるの
Dialogue: 5,0:17:58.85,0:18:01.14,Text_JP,,0,0,0,,じっとしてないし　すぐ泳ぐし
Dialogue: 5,0:18:03.34,0:18:05.09,Text_JP,,0,0,0,,でも　楽しかったです
Dialogue: 5,0:18:05.46,0:18:07.28,Text_JP,,0,0,0,,ミミが楽しそうだったから
Dialogue: 5,0:18:08.85,0:18:12.92,Text_JP,,0,0,0,,じゃあ　これからはお風呂入れるの毎回お願いしちゃおうかな
Dialogue: 5,0:18:13.65,0:18:14.40,Text_JP,,0,0,0,,あの…
Dialogue: 5,0:18:15.49,0:18:17.34,Text_JP,,0,0,0,,このままでいいんでしょうか
Dialogue: 5,0:18:17.67,0:18:21.71,Text_JP,,0,0,0,,ミミ　敵を倒すこと何も悪いって思ってないんですよ
Dialogue: 5,0:18:22.19,0:18:25.26,Text_JP,,0,0,0,,誰かの命を奪ってるのに　いいことだって
Dialogue: 5,0:18:25.26,0:18:26.44,Text_JP,,0,0,0,,そうね
Dialogue: 5,0:18:26.79,0:18:27.81,Text_JP,,0,0,0,,じゃあ　教える
Dialogue: 5,0:18:28.32,0:18:32.14,Text_JP,,0,0,0,,人の命の尊さと　それを奪うことの罪を
Dialogue: 5,0:18:32.14,0:18:33.17,Text_JP,,0,0,0,,それは…
Dialogue: 5,0:18:33.84,0:18:37.52,Text_JP,,0,0,0,,今まで数え切れないほどの人間を殺してきたあの子が
Dialogue: 5,0:18:37.52,0:18:41.89,Text_JP,,0,0,0,,その罪を理解したとして　果たして受け止められるかしら
Dialogue: 5,0:18:42.58,0:18:44.78,Text_JP,,0,0,0,,死ぬことすらできないあの子が
Dialogue: 5,0:18:45.83,0:18:46.36,Text_JP,,0,0,0,,でも…
Dialogue: 5,0:18:48.10,0:18:49.11,Text_JP,,0,0,0,,でも　嫌です
Dialogue: 5,0:18:50.15,0:18:51.32,Text_JP,,0,0,0,,じゃあ　どうしたいの
Dialogue: 5,0:18:51.83,0:18:55.40,Text_JP,,0,0,0,,ミミを　普通の体に戻すことはできないんですか
Dialogue: 5,0:18:55.40,0:18:57.09,Text_JP,,0,0,0,,戻せたとして　どうするの
Dialogue: 5,0:18:57.47,0:19:00.37,Text_JP,,0,0,0,,そうなれば　戦場に行かなくても済むのかなって
Dialogue: 5,0:19:00.37,0:19:05.08,Text_JP,,0,0,0,,それと引き換えに　ここにいる生徒全員戦場に駆り出されることになる
Dialogue: 5,0:19:05.63,0:19:07.12,Text_JP,,0,0,0,,シーナちゃんも含めて
Dialogue: 5,0:19:08.20,0:19:09.71,Text_JP,,0,0,0,,それでもいいってこと
Dialogue: 5,0:19:11.39,0:19:12.52,Text_JP,,0,0,0,,それは…
Dialogue: 5,0:19:18.27,0:19:21.10,Text_JP,,0,0,0,,なんで　なんで戦争なんか…
Dialogue: 5,0:19:21.47,0:19:24.31,Text_JP,,0,0,0,,全く　私も
Dialogue: 5,0:19:24.31,0:19:27.45,Text_JP,,0,0,0,,いや　多分一人残らずそう思っている
Dialogue: 5,0:19:27.89,0:19:29.47,Text_JP,,0,0,0,,けど　戦争は起きる
Dialogue: 5,0:19:29.90,0:19:31.14,Text_JP,,0,0,0,,そして　終わらない
Dialogue: 5,0:19:32.21,0:19:34.56,Text_JP,,0,0,0,,何十年　何百年と続けても
Dialogue: 5,0:19:34.99,0:19:37.24,Text_JP,,0,0,0,,たとえどちらかが勝ったとしても
Dialogue: 5,0:19:37.93,0:19:39.57,Text_JP,,0,0,0,,平和なんて　一時的
Dialogue: 5,0:19:39.99,0:19:43.90,Text_JP,,0,0,0,,戦いで生まれた憎悪の種は　いつか芽を出し
Dialogue: 5,0:19:44.12,0:19:45.91,Text_JP,,0,0,0,,新たな戦争を生む
Dialogue: 5,0:19:46.40,0:19:50.78,Text_JP,,0,0,0,,自分と自分が愛する者を守るためには　戦うしかないの
Dialogue: 5,0:19:51.56,0:19:54.09,Text_JP,,0,0,0,,それがどんなに間違っていると分かっていても
Dialogue: 5,0:19:55.13,0:19:58.24,Text_JP,,0,0,0,,ミミのことも　正しいなんて思っている人は誰もいない
Dialogue: 5,0:19:58.88,0:20:00.31,Text_JP,,0,0,0,,けど　そうするしかないの
Dialogue: 5,0:20:01.13,0:20:03.33,Text_JP,,0,0,0,,犠牲を減らすためには　それしかない
Dialogue: 5,0:20:03.87,0:20:05.13,Text_JP,,0,0,0,,それが現実
Dialogue: 5,0:20:06.59,0:20:09.36,Text_JP,,0,0,0,,その上で　もう一度考えてごらん
Dialogue: 5,0:20:09.73,0:20:11.78,Text_JP,,0,0,0,,シーナちゃんが何を望むか
Dialogue: 5,0:20:13.46,0:20:14.74,Text_JP,,0,0,0,,フラン先生…
Dialogue: 5,0:20:15.48,0:20:16.81,Text_JP,,0,0,0,,あったあ
Dialogue: 5,0:20:18.66,0:20:20.78,Text_JP,,0,0,0,,その薬の使い方だけど
Dialogue: 5,0:20:21.32,0:20:25.54,Text_JP,,0,0,0,,一滴垂らしたら　汚れに浸透するまでしっかり待つこと
Dialogue: 5,0:20:25.54,0:20:27.24,Text_JP,,0,0,0,,んで　拭き取る
Dialogue: 5,0:20:27.74,0:20:29.79,Text_JP,,0,0,0,,はい　ありがとうございます
Dialogue: 5,0:20:32.26,0:20:36.26,Text_JP,,0,0,0,,何事も焦らず　時間をかけてゆっくりやるのよ
Dialogue: 5,0:20:37.11,0:20:37.95,Text_JP,,0,0,0,,二人で
Dialogue: 5,0:20:41.54,0:20:43.21,Text_JP,,0,0,0,,ミミの願い？
Dialogue: 5,0:20:43.21,0:20:44.06,Text_JP,,0,0,0,,うん
Dialogue: 5,0:20:44.06,0:20:45.27,Text_JP,,0,0,0,,そうだなあ…
Dialogue: 5,0:20:45.78,0:20:48.62,Text_JP,,0,0,0,,シーナとクッキー作って　お絵描きして
Dialogue: 5,0:20:48.62,0:20:50.32,Text_JP,,0,0,0,,あと　いっぱい寝る
Dialogue: 5,0:20:50.32,0:20:51.36,Text_JP,,0,0,0,,そっか
Dialogue: 5,0:20:51.75,0:20:52.78,Text_JP,,0,0,0,,シーナは
Dialogue: 5,0:20:52.78,0:20:55.19,Text_JP,,0,0,0,,私？私は…
Dialogue: 5,0:20:55.76,0:20:57.40,Top_JP,,0,0,0,,召集令　召集令
Dialogue: 5,0:20:58.08,0:21:01.32,Top_JP,,0,0,0,,これより読み上げる者は　至急集まるように
Dialogue: 5,0:21:02.87,0:21:05.45,Text_JP,,0,0,0,,ええ　昨日も行ったのに
Dialogue: 5,0:21:05.95,0:21:07.88,Text_JP,,0,0,0,,お夜食　作っておくね
Dialogue: 5,0:21:07.88,0:21:08.72,Text_JP,,0,0,0,,ほんと
Dialogue: 5,0:21:08.72,0:21:10.46,Text_JP,,0,0,0,,じゃあ　おにぎりがいい
Dialogue: 5,0:21:15.87,0:21:18.39,Text_JP,,0,0,0,,ミミ　今日も絶対帰ってくるよ
Dialogue: 5,0:21:18.39,0:21:20.09,Text_JP,,0,0,0,,だから　シーナも待っててね
Dialogue: 5,0:21:20.62,0:21:22.31,Text_JP,,0,0,0,,じゃあ　行ってくる
Dialogue: 5,0:21:35.86,0:21:37.58,Text_JP,,0,0,0,,シーナはどうしたいの
Dialogue: 5,0:21:48.28,0:21:49.04,Text_JP,,0,0,0,,ミミ
Dialogue: 5,0:21:51.97,0:21:53.73,Text_JP,,0,0,0,,今の私の望みは…
Dialogue: 5,0:21:55.75,0:21:56.48,Text_JP,,0,0,0,,待ってる
Dialogue: 5,0:21:57.78,0:21:58.59,Text_JP,,0,0,0,,待ってる
Dialogue: 5,0:21:59.59,0:22:00.98,Text_JP,,0,0,0,,絶対　待ってるから
Dialogue: 5,0:22:01.65,0:22:03.42,Text_JP,,0,0,0,,怪我しないで帰ってきて
Dialogue: 5,0:22:08.41,0:22:09.34,Text_JP,,0,0,0,,らじゃ
Dialogue: 6,0:00:03.06,0:00:04.22,Text_CN,,0,0,0,,席娜
Dialogue: 6,0:00:04.22,0:00:04.90,Text_CN,,0,0,0,,什么
Dialogue: 6,0:00:11.89,0:00:13.62,Text_CN,,0,0,0,,席娜 你想做什么呢
Dialogue: 6,0:00:14.47,0:00:15.25,Text_CN,,0,0,0,,我？
Dialogue: 6,0:00:16.38,0:00:18.79,Text_CN,,0,0,0,,我的愿望是…
Dialogue: 6,0:00:28.26,0:00:31.04,Text_CN,,0,0,0,,我的愿望…
Dialogue: 6,0:02:03.65,0:02:04.88,Text_CN,,0,0,0,,喂 席娜
Dialogue: 6,0:02:05.33,0:02:07.97,Text_CN,,0,0,0,,真的笔和本子都不用带吗
Dialogue: 6,0:02:08.26,0:02:11.24,Text_CN,,0,0,0,,嗯 感谢日不是上课
Dialogue: 6,0:02:11.59,0:02:14.85,Text_CN,,0,0,0,,你看 校服不是也和平时不一样吗
Dialogue: 6,0:02:17.42,0:02:21.10,Text_CN,,0,0,0,,还有 书库已经好多年没有打扫过了
Dialogue: 6,0:02:21.10,0:02:23.37,Text_CN,,0,0,0,,请务必每个角落都打扫干净
Dialogue: 6,0:02:23.37,0:02:24.97,Text_CN,,0,0,0,,什么啊
Dialogue: 6,0:02:26.62,0:02:28.38,Top_CN,,0,0,0,,大家好像都很不情愿
Dialogue: 6,0:02:35.09,0:02:36.30,Text_CN,,0,0,0,,哪边来着
Dialogue: 6,0:02:36.30,0:02:37.93,Text_CN,,0,0,0,,美美知道哦
Dialogue: 6,0:02:37.93,0:02:39.37,Text_CN,,0,0,0,,是那个有很多书的地方吧
Dialogue: 6,0:02:39.37,0:02:41.88,Text_CN,,0,0,0,,那也不用跑啊…
Dialogue: 6,0:02:43.01,0:02:46.20,Text_CN,,0,0,0,,哇 这么多书啊
Dialogue: 6,0:02:48.07,0:02:49.73,Text_CN,,0,0,0,,哎呀 你们来了
Dialogue: 6,0:02:49.91,0:02:52.10,Text_CN,,0,0,0,,不好意思 迟了一点
Dialogue: 6,0:02:52.10,0:02:54.07,Text_CN,,0,0,0,,因为美美睡过头啦
Dialogue: 6,0:02:54.07,0:02:55.74,Text_CN,,0,0,0,,这话不该笑着说吧
Dialogue: 6,0:02:57.85,0:02:59.66,Text_CN,,0,0,0,,欧米老师在里面
Dialogue: 6,0:02:59.66,0:03:02.58,Text_CN,,0,0,0,,她应该会告诉你们要打扫哪里
Dialogue: 6,0:03:02.90,0:03:03.81,Text_CN,,0,0,0,,谢谢
Dialogue: 6,0:03:05.03,0:03:08.94,Text_CN,,0,0,0,,你们先整理好书架 然后去扫地
Dialogue: 6,0:03:08.94,0:03:11.50,Text_CN,,0,0,0,,欧米老师 不好意思来晚了
Dialogue: 6,0:03:11.82,0:03:12.76,Text_CN,,0,0,0,,杜滋琪同学
Dialogue: 6,0:03:13.28,0:03:16.74,Text_CN,,0,0,0,,好的 那麻烦二位清扫这一列
Dialogue: 6,0:03:16.74,0:03:17.47,Text_CN,,0,0,0,,好的
Dialogue: 6,0:03:17.89,0:03:19.16,Text_CN,,0,0,0,,走吧 美美
Dialogue: 6,0:03:19.16,0:03:19.97,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:03:24.65,0:03:26.04,Text_CN,,0,0,0,,好多灰
Dialogue: 6,0:03:28.73,0:03:31.59,Text_CN,,0,0,0,,席娜 这些都掉出来了
Dialogue: 6,0:03:33.11,0:03:35.17,Text_CN,,0,0,0,,不要啊 快捡起来
Dialogue: 6,0:03:35.17,0:03:38.42,Text_CN,,0,0,0,,欧米老师不是说了 坏了的书要单独拿出来吗
Dialogue: 6,0:03:38.42,0:03:39.49,Text_CN,,0,0,0,,这样吗
Dialogue: 6,0:03:39.68,0:03:43.15,Text_CN,,0,0,0,,我看看 这张是第51页 所以…
Dialogue: 6,0:03:45.13,0:03:46.01,Text_CN,,0,0,0,,「诅咒」？
Dialogue: 6,0:03:47.64,0:03:49.76,Text_CN,,0,0,0,,「魔法的代价」…
Dialogue: 6,0:03:52.08,0:03:57.17,Text_CN,,0,0,0,,对 美美是被复苏魔法复活的孩子
Dialogue: 6,0:03:57.70,0:03:59.68,Text_CN,,0,0,0,,她母亲打破了禁忌
Dialogue: 6,0:04:02.47,0:04:04.22,Text_CN,,0,0,0,,席娜 你想做什么呢
Dialogue: 6,0:04:05.32,0:04:08.04,Text_CN,,0,0,0,,不知道 有没有办法解除呢
Dialogue: 6,0:04:09.12,0:04:10.21,Text_CN,,0,0,0,,席娜
Dialogue: 6,0:04:10.77,0:04:12.69,Text_CN,,0,0,0,,这文字像蛇一样
Dialogue: 6,0:04:14.19,0:04:15.42,Text_CN,,0,0,0,,席娜 你也试试
Dialogue: 6,0:04:15.75,0:04:17.91,Text_CN,,0,0,0,,快停下 不可以这样啦
Dialogue: 6,0:04:18.73,0:04:21.45,Text_CN,,0,0,0,,况且 我也根本做不到
Dialogue: 6,0:04:21.45,0:04:22.87,Text_CN,,0,0,0,,为什么呢
Dialogue: 6,0:04:23.14,0:04:27.86,Text_CN,,0,0,0,,以我的魔力 要举起一本书都算用尽全力了
Dialogue: 6,0:04:33.81,0:04:34.51,Text_CN,,0,0,0,,你看吧
Dialogue: 6,0:04:36.52,0:04:39.02,Text_CN,,0,0,0,,这样的我 帮助不了任何人
Dialogue: 6,0:04:39.38,0:04:41.22,Text_CN,,0,0,0,,我真是太没用了
Dialogue: 6,0:04:41.75,0:04:43.59,Text_CN,,0,0,0,,可是 你很擅长打扫呀
Dialogue: 6,0:04:44.73,0:04:46.88,Text_CN,,0,0,0,,还会烤好吃的饼干
Dialogue: 6,0:04:49.22,0:04:50.08,Text_CN,,0,0,0,,谢谢你
Dialogue: 6,0:05:05.97,0:05:09.41,Text_CN,,0,0,0,,不好意思 我们在那边一直占着梯子
Dialogue: 6,0:05:12.55,0:05:13.41,Text_CN,,0,0,0,,哈尔
Dialogue: 6,0:05:14.01,0:05:16.03,Text_CN,,0,0,0,,老师说那边需要帮忙
Dialogue: 6,0:05:16.57,0:05:17.51,Text_CN,,0,0,0,,马上过去
Dialogue: 6,0:05:19.57,0:05:21.68,Text_CN,,0,0,0,,剩下的就交给我们吧
Dialogue: 6,0:05:22.06,0:05:22.75,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:05:28.09,0:05:28.94,Text_CN,,0,0,0,,谢谢你
Dialogue: 6,0:05:34.02,0:05:36.24,Text_CN,,0,0,0,,书满地都是了
Dialogue: 6,0:05:36.24,0:05:37.06,Text_CN,,0,0,0,,怎么回事
Dialogue: 6,0:05:37.63,0:05:40.25,Text_CN,,0,0,0,,你没事吧 有没有撞到什么地方
Dialogue: 6,0:05:40.57,0:05:42.02,Text_CN,,0,0,0,,有没有哪里痛
Dialogue: 6,0:05:42.56,0:05:43.33,Text_CN,,0,0,0,,这里
Dialogue: 6,0:05:45.59,0:05:46.73,Text_CN,,0,0,0,,很痛吧
Dialogue: 6,0:05:50.67,0:05:51.62,Text_CN,,0,0,0,,乖
Dialogue: 6,0:05:52.77,0:05:53.94,Text_CN,,0,0,0,,没事的
Dialogue: 6,0:05:57.83,0:05:59.44,Text_CN,,0,0,0,,还要…
Dialogue: 6,0:05:59.44,0:06:00.15,Text_CN,,0,0,0,,什么
Dialogue: 6,0:06:00.67,0:06:01.56,Text_CN,,0,0,0,,我还要…
Dialogue: 6,0:06:06.11,0:06:06.92,Text_CN,,0,0,0,,美美…
Dialogue: 6,0:06:10.71,0:06:12.92,Text_CN,,0,0,0,,我还要 还要
Dialogue: 6,0:06:15.42,0:06:16.40,Text_CN,,0,0,0,,席娜？
Dialogue: 6,0:06:16.66,0:06:18.25,Text_CN,,0,0,0,,刚刚听到这边有大动静
Dialogue: 6,0:06:19.65,0:06:21.49,Text_CN,,0,0,0,,还好 没事了
Dialogue: 6,0:06:39.10,0:06:40.91,Text_CN,,0,800,0,,结束啦
Dialogue: 6,0:06:39.10,0:06:40.91,Text_CN,,800,0,0,,结束啦
Dialogue: 6,0:06:42.18,0:06:44.22,Text_CN,,0,0,0,,身上搞得好脏啊
Dialogue: 6,0:06:44.48,0:06:46.22,Text_CN,,0,0,0,,感谢日好开心
Dialogue: 6,0:06:46.22,0:06:47.43,Text_CN,,0,0,0,,那就好
Dialogue: 6,0:06:47.65,0:06:50.49,Text_CN,,0,0,0,,不过 感谢日还不止这些哦
Dialogue: 6,0:06:50.49,0:06:51.46,Text_CN,,0,0,0,,是吗
Dialogue: 6,0:06:52.73,0:06:53.48,Text_CN,,0,0,0,,你看
Dialogue: 6,0:06:55.93,0:06:57.99,Text_CN,,0,0,0,,大家都聚在这里
Dialogue: 6,0:06:58.61,0:06:59.78,Text_CN,,0,0,0,,我们去看看吧
Dialogue: 6,0:06:59.78,0:07:00.53,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:07:01.41,0:07:02.35,Text_CN,,0,0,0,,哦 对了
Dialogue: 6,0:07:02.64,0:07:05.25,Text_CN,,0,0,0,,我还要先去拿些东西
Dialogue: 6,0:07:05.25,0:07:07.94,Text_CN,,0,0,0,,你在这等一下 我马上回来
Dialogue: 6,0:07:08.27,0:07:09.59,Text_CN,,0,0,0,,好
Dialogue: 6,0:07:21.03,0:07:22.93,Text_CN,,0,0,0,,亮晶晶的
Dialogue: 6,0:07:23.72,0:07:25.79,Text_CN,,0,0,0,,喂 难道说…
Dialogue: 6,0:07:26.25,0:07:27.48,Text_CN,,0,0,0,,你就是「美美」吗
Dialogue: 6,0:07:30.04,0:07:31.00,Text_CN,,0,0,0,,美美
Dialogue: 6,0:07:32.84,0:07:35.71,Text_CN,,0,0,0,,坏了 不该留她一个人的
Dialogue: 6,0:07:35.71,0:07:37.11,Top_CN,,0,0,0,,好可爱
Dialogue: 6,0:07:37.11,0:07:38.27,Top_CN,,0,0,0,,缎带很搭呀
Dialogue: 6,0:07:38.27,0:07:40.69,Top_CN,,0,0,0,,哇 很合身
Dialogue: 6,0:07:41.28,0:07:43.97,Text_CN,,0,0,0,,学姐们怎么这么兴奋
Dialogue: 6,0:07:45.57,0:07:47.81,Text_CN,,0,0,0,,简直像人偶一样
Dialogue: 6,0:07:47.81,0:07:49.33,Text_CN,,0,0,0,,很适合你
Dialogue: 6,0:07:50.29,0:07:51.60,Text_CN,,0,0,0,,看这边
Dialogue: 6,0:07:51.60,0:07:52.57,Text_CN,,0,0,0,,好啊
Dialogue: 6,0:07:52.57,0:07:53.30,Text_CN,,0,0,0,,美美
Dialogue: 6,0:07:54.14,0:07:56.68,Text_CN,,0,0,0,,哦 席娜
Dialogue: 6,0:07:57.86,0:07:58.88,Text_CN,,0,0,0,,对不起
Dialogue: 6,0:08:02.41,0:08:03.72,Text_CN,,0,0,0,,怎么回事
Dialogue: 6,0:08:03.72,0:08:06.84,Text_CN,,0,0,0,,哎呀 真是抱歉 让她当了换装人偶
Dialogue: 6,0:08:06.84,0:08:08.97,Text_CN,,0,0,0,,她真是穿什么都好看
Dialogue: 6,0:08:09.14,0:08:10.18,Text_CN,,0,0,0,,没…没事
Dialogue: 6,0:08:10.18,0:08:12.15,Text_CN,,0,0,0,,不过 反正她衬衫也脏了
Dialogue: 6,0:08:12.15,0:08:13.56,Text_CN,,0,0,0,,应该正好吧
Dialogue: 6,0:08:14.12,0:08:14.80,Text_CN,,0,0,0,,咦
Dialogue: 6,0:08:15.93,0:08:16.98,Text_CN,,0,0,0,,这个人…
Dialogue: 6,0:08:18.52,0:08:20.00,Text_CN,,0,0,0,,亲亲的那个人
Dialogue: 6,0:08:20.00,0:08:22.04,Text_CN,,0,0,0,,什么 你等等 美美
Dialogue: 6,0:08:22.57,0:08:24.79,Text_CN,,0,0,0,,对不起 对不起 对不起
Dialogue: 6,0:08:24.79,0:08:25.52,Text_CN,,0,0,0,,对不起…
Dialogue: 6,0:08:25.52,0:08:27.36,Text_CN,,0,0,0,,我是16班的艾丝妲
Dialogue: 6,0:08:27.80,0:08:30.14,Text_CN,,0,0,0,,喜欢的话 就把衣服拿走吧
Dialogue: 6,0:08:30.14,0:08:30.98,Text_CN,,0,0,0,,可以吗
Dialogue: 6,0:08:32.42,0:08:34.97,Text_CN,,0,0,0,,这就是感谢日的乐趣哦
Dialogue: 6,0:08:34.97,0:08:35.82,Text_CN,,0,0,0,,垃圾？
Dialogue: 6,0:08:36.61,0:08:39.35,Text_CN,,0,0,0,,你看走廊上不是摆了很多东西吗
Dialogue: 6,0:08:39.35,0:08:39.87,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:08:40.11,0:08:42.98,Text_CN,,0,0,0,,只要是摆着的东西 全都可以带走
Dialogue: 6,0:08:43.36,0:08:44.43,Text_CN,,0,0,0,,这也可以吗
Dialogue: 6,0:08:44.43,0:08:45.32,Text_CN,,0,0,0,,你喜欢吗
Dialogue: 6,0:08:46.97,0:08:47.70,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:08:48.29,0:08:50.71,Text_CN,,0,0,0,,谢…谢谢你
Dialogue: 6,0:08:51.11,0:08:53.80,Text_CN,,0,0,0,,正好 美美休息日也只有校服穿
Dialogue: 6,0:08:54.43,0:08:55.31,Text_CN,,0,0,0,,太好了
Dialogue: 6,0:08:55.47,0:08:56.21,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:08:56.21,0:08:57.17,Text_CN,,0,0,0,,很适合你
Dialogue: 6,0:08:57.17,0:08:58.31,Text_CN,,0,0,0,,真的吗
Dialogue: 6,0:08:58.87,0:08:59.96,Text_CN,,0,0,0,,你要不要呢
Dialogue: 6,0:09:00.25,0:09:01.06,Text_CN,,0,0,0,,什么
Dialogue: 6,0:09:01.06,0:09:02.40,Text_CN,,0,0,0,,一样的连衣裙
Dialogue: 6,0:09:09.25,0:09:11.43,Text_CN,,0,0,0,,不过 这件是我穿过的
Dialogue: 6,0:09:12.87,0:09:15.34,Text_CN,,0,0,0,,不用了 谢谢你的好意
Dialogue: 6,0:09:15.34,0:09:18.13,Text_CN,,0,0,0,,可是 这么可爱的衣服我…
Dialogue: 6,0:09:18.85,0:09:21.67,Text_CN,,0,0,0,,拜托了 可以请你收下它吗
Dialogue: 6,0:09:22.34,0:09:24.38,Text_CN,,0,0,0,,因为 我们已经没法一起穿了
Dialogue: 6,0:09:39.97,0:09:40.79,Text_CN,,0,0,0,,谢谢你
Dialogue: 6,0:09:44.54,0:09:45.52,Text_CN,,0,0,0,,一对的？
Dialogue: 6,0:09:47.37,0:09:48.10,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:09:49.49,0:09:51.51,Text_CN,,0,0,0,,那个 如果可以的话…
Dialogue: 6,0:09:55.48,0:09:57.46,Text_CN,,0,0,0,,原来是你呀
Dialogue: 6,0:09:57.95,0:10:00.60,Text_CN,,0,0,0,,每次都在感谢日放美味点心的人
Dialogue: 6,0:10:00.60,0:10:00.99,Text_CN,,0,0,0,,什么
Dialogue: 6,0:10:00.99,0:10:03.00,Text_CN,,0,0,0,,大家都在讨论这个呢
Dialogue: 6,0:10:03.55,0:10:06.21,Text_CN,,0,0,0,,对不起 只是一点小小的谢礼而已
Dialogue: 6,0:10:07.67,0:10:09.51,Text_CN,,0,0,0,,能收到传说中的饼干 好开心
Dialogue: 6,0:10:09.95,0:10:10.87,Text_CN,,0,0,0,,谢谢
Dialogue: 6,0:10:12.08,0:10:13.80,Text_CN,,0,0,0,,美美也要吃
Dialogue: 6,0:10:13.80,0:10:14.89,Text_CN,,0,0,0,,回去再吃哦
Dialogue: 6,0:10:20.07,0:10:21.18,Text_CN,,0,0,0,,好好吃
Dialogue: 6,0:10:22.59,0:10:24.94,Text_CN,,0,0,0,,你为什么拿了个枯掉的呢
Dialogue: 6,0:10:25.13,0:10:27.19,Text_CN,,0,0,0,,因为它还没有完全枯掉
Dialogue: 6,0:10:29.77,0:10:31.07,Text_CN,,0,0,0,,你真的要吗
Dialogue: 6,0:10:31.61,0:10:33.93,Text_CN,,0,0,0,,这个原本是打算处理掉的
Dialogue: 6,0:10:34.22,0:10:36.29,Text_CN,,0,0,0,,它看上去已经不会再开花了
Dialogue: 6,0:10:37.59,0:10:39.32,Text_CN,,0,0,0,,它还活着
Dialogue: 6,0:10:41.69,0:10:43.57,Text_CN,,0,0,0,,你还活着 对吧
Dialogue: 6,0:10:43.96,0:10:46.86,Text_CN,,0,0,0,,席娜 来一起吃吧
Dialogue: 6,0:10:47.53,0:10:48.15,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:11:33.85,0:11:34.72,Text_CN,,0,0,0,,我回来了
Dialogue: 6,0:11:35.09,0:11:35.98,Text_CN,,0,0,0,,欢迎回来
Dialogue: 6,0:11:37.31,0:11:38.35,Text_CN,,0,0,0,,这么快
Dialogue: 6,0:11:38.35,0:11:39.39,Text_CN,,0,0,0,,是吗
Dialogue: 6,0:11:39.75,0:11:41.71,Text_CN,,0,0,0,,怎么样 要不要吃点…
Dialogue: 6,0:11:43.11,0:11:45.05,Text_CN,,0,0,0,,美美 那个…
Dialogue: 6,0:11:46.58,0:11:50.69,Text_CN,,0,0,0,,啊 还以为今天没弄脏呢
Dialogue: 6,0:11:51.41,0:11:53.95,Text_CN,,0,0,0,,美美 你没有受伤吧
Dialogue: 6,0:11:54.65,0:11:57.57,Text_CN,,0,0,0,,嗯 美美没事
Dialogue: 6,0:12:00.71,0:12:03.76,Text_CN,,0,0,0,,澡堂应该还开着 一起去吧
Dialogue: 6,0:12:03.76,0:12:04.50,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:12:09.48,0:12:13.17,Text_CN,,0,0,0,,今天你不用去富朗老师那里换衣服吗
Dialogue: 6,0:12:13.17,0:12:15.28,Text_CN,,0,0,0,,我直接回来了
Dialogue: 6,0:12:15.28,0:12:17.93,Text_CN,,0,0,0,,可是 富朗老师不会生气吗
Dialogue: 6,0:12:18.10,0:12:21.39,Text_CN,,0,0,0,,因为我知道席娜还在等我
Dialogue: 6,0:12:22.35,0:12:23.31,Text_CN,,0,0,0,,而且…
Dialogue: 6,0:12:23.80,0:12:26.05,Text_CN,,0,0,0,,我洗澡也想和你一起
Dialogue: 6,0:12:28.52,0:12:29.33,Text_CN,,0,0,0,,嗯…
Dialogue: 6,0:12:30.02,0:12:31.50,Text_CN,,0,0,0,,快去吧
Dialogue: 6,0:12:31.90,0:12:34.56,Text_CN,,0,0,0,,等等 晚上小点声
Dialogue: 6,0:12:47.32,0:12:49.61,Text_CN,,0,0,0,,感谢日 好开心
Dialogue: 6,0:12:50.33,0:12:51.38,Text_CN,,0,0,0,,是啊
Dialogue: 6,0:12:51.54,0:12:53.38,Text_CN,,0,0,0,,还想和大家一起逛逛
Dialogue: 6,0:12:55.37,0:12:56.27,Text_CN,,0,0,0,,是啊
Dialogue: 6,0:12:56.70,0:12:58.54,Text_CN,,0,0,0,,下次是什么时候呢
Dialogue: 6,0:12:58.99,0:13:00.93,Text_CN,,0,0,0,,我来帮你冲头发 闭上眼睛
Dialogue: 6,0:13:01.40,0:13:02.13,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:13:03.57,0:13:06.41,Text_CN,,0,0,0,,美美的身上 有血的味道
Dialogue: 6,0:13:08.42,0:13:11.59,Text_CN,,0,0,0,,今天也有许多的敌人…
Dialogue: 6,0:13:12.01,0:13:14.44,Text_CN,,0,0,0,,也有许多的人 被美美杀死
Dialogue: 6,0:13:15.48,0:13:17.44,Text_CN,,0,0,0,,被她如此娇小的身躯
Dialogue: 6,0:13:18.27,0:13:22.05,Text_CN,,0,0,0,,她甚至从来没有意识到 自己在做什么
Dialogue: 6,0:13:31.94,0:13:33.79,Text_CN,,0,0,0,,美美可以自己冲哦
Dialogue: 6,0:13:42.00,0:13:43.38,Text_CN,,0,0,0,,我也来帮席娜洗
Dialogue: 6,0:13:43.38,0:13:44.72,Text_CN,,0,0,0,,什么 我…我就…
Dialogue: 6,0:13:48.69,0:13:50.69,Text_CN,,0,0,0,,痛痛痛痛痛…
Dialogue: 6,0:13:50.98,0:13:52.75,Text_CN,,0,0,0,,看 小兔子
Dialogue: 6,0:13:53.85,0:13:54.90,Text_CN,,0,0,0,,你看美美的
Dialogue: 6,0:13:56.41,0:13:57.16,Text_CN,,0,0,0,,亲
Dialogue: 6,0:14:03.24,0:14:04.94,Text_CN,,0,0,0,,我来帮你冲头发
Dialogue: 6,0:14:04.94,0:14:06.71,Text_CN,,0,0,0,,什么 等等…美美
Dialogue: 6,0:14:06.71,0:14:08.77,Text_CN,,0,0,0,,我也能自己冲的
Dialogue: 6,0:14:08.77,0:14:11.33,Text_CN,,0,0,0,,而且 不快点泡进去的话会着凉的…
Dialogue: 6,0:14:12.47,0:14:13.79,Text_CN,,0,0,0,,等等 美美 不要啊
Dialogue: 6,0:14:13.79,0:14:14.95,Text_CN,,0,0,0,,水太大啦
Dialogue: 6,0:14:14.32,0:14:15.54,Top_CN,,0,0,0,,看招 看招
Dialogue: 6,0:14:16.35,0:14:19.56,Text_CN,,0,0,0,,你看 浴池已经热好了 美美
Dialogue: 6,0:14:21.26,0:14:24.72,Text_CN,,0,0,0,,美美 从很久以前开始就在杀人了
Dialogue: 6,0:14:25.89,0:14:28.87,Text_CN,,0,0,0,,她不理解其中的悲伤和痛苦
Dialogue: 6,0:14:29.31,0:14:33.24,Text_CN,,0,0,0,,并且 这样的日子还会永远持续下去
Dialogue: 6,0:14:34.40,0:14:36.99,Text_CN,,0,0,0,,这样的事 我…
Dialogue: 6,0:14:37.70,0:14:39.08,Text_CN,,0,0,0,,我好讨厌啊
Dialogue: 6,0:14:39.97,0:14:40.73,Text_CN,,0,0,0,,美美…
Dialogue: 6,0:14:49.67,0:14:51.41,Text_CN,,0,0,0,,我们包场了
Dialogue: 6,0:14:51.41,0:14:53.31,Text_CN,,0,0,0,,就是呀
Dialogue: 6,0:14:54.77,0:14:56.63,Text_CN,,0,0,0,,好暖和呀
Dialogue: 6,0:14:56.63,0:14:58.22,Text_CN,,0,0,0,,好暖和呀…
Dialogue: 6,0:15:01.77,0:15:02.79,Text_CN,,0,0,0,,居然在打水…
Dialogue: 6,0:15:03.64,0:15:06.14,Text_CN,,0,0,0,,算了 反正也没有其他人
Dialogue: 6,0:15:18.52,0:15:20.69,Text_CN,,0,0,0,,你看 水冠
Dialogue: 6,0:15:20.69,0:15:21.89,Text_CN,,0,0,0,,好漂亮
Dialogue: 6,0:15:24.89,0:15:25.82,Text_CN,,0,0,0,,谢谢你
Dialogue: 6,0:15:29.56,0:15:31.41,Text_CN,,0,0,0,,这是什么魔法
Dialogue: 6,0:15:31.67,0:15:34.41,Text_CN,,0,0,0,,这是今天遇到的敌人用的
Dialogue: 6,0:15:35.94,0:15:38.42,Text_CN,,0,0,0,,就像这样 看上去有好多刺
Dialogue: 6,0:15:38.88,0:15:39.69,Text_CN,,0,0,0,,不过…
Dialogue: 6,0:15:41.69,0:15:44.29,Text_CN,,0,0,0,,美美 干掉了好多呢
Dialogue: 6,0:15:47.39,0:15:48.07,Text_CN,,0,0,0,,美美…
Dialogue: 6,0:15:48.07,0:15:48.74,Text_CN,,0,0,0,,嗯？
Dialogue: 6,0:15:49.22,0:15:54.18,Text_CN,,0,0,0,,假如说 美美去了战场 然后再也没能回来
Dialogue: 6,0:15:54.18,0:15:55.08,Text_CN,,0,0,0,,你会怎么想
Dialogue: 6,0:15:55.40,0:15:58.36,Text_CN,,0,0,0,,假如以后再也见不到富朗老师和我了
Dialogue: 6,0:15:58.36,0:15:59.92,Text_CN,,0,0,0,,我不要这样子
Dialogue: 6,0:15:59.92,0:16:02.90,Text_CN,,0,0,0,,可是 战争就是这样的
Dialogue: 6,0:16:03.89,0:16:06.21,Text_CN,,0,0,0,,今天美美干掉的那些人也是
Dialogue: 6,0:16:06.21,0:16:07.95,Text_CN,,0,0,0,,他们肯定也有自己的归宿
Dialogue: 6,0:16:08.34,0:16:10.90,Text_CN,,0,0,0,,也想对某个人说一声「我回来了」
Dialogue: 6,0:16:11.20,0:16:12.12,Text_CN,,0,0,0,,可是…
Dialogue: 6,0:16:12.54,0:16:16.30,Text_CN,,0,0,0,,要是死掉了 就再也不能和任何人相见
Dialogue: 6,0:16:16.30,0:16:17.64,Text_CN,,0,0,0,,也不能再回去了
Dialogue: 6,0:16:18.14,0:16:20.96,Text_CN,,0,0,0,,战争是一件很悲伤的事
Dialogue: 6,0:16:21.24,0:16:23.10,Text_CN,,0,0,0,,可是 美美不会死哦
Dialogue: 6,0:16:23.10,0:16:23.59,Text_CN,,0,0,0,,所以…
Dialogue: 6,0:16:24.26,0:16:25.69,Text_CN,,0,0,0,,我不是这个意思…
Dialogue: 6,0:16:26.61,0:16:28.61,Text_CN,,0,0,0,,我并不是想否定美美
Dialogue: 6,0:16:29.10,0:16:34.16,Text_CN,,0,0,0,,可是 任何人的生命都不应该像物品一样对待
Dialogue: 6,0:16:34.67,0:16:38.69,Text_CN,,0,0,0,,那个…不管是你还是敌人 谁的生命都很宝贵
Dialogue: 6,0:16:38.69,0:16:41.38,Text_CN,,0,0,0,,敌人吗 敌人也很宝贵吗
Dialogue: 6,0:16:41.38,0:16:42.61,Text_CN,,0,0,0,,这个…
Dialogue: 6,0:16:43.87,0:16:47.54,Text_CN,,0,0,0,,对啊 我自己都还不是很了解
Dialogue: 6,0:16:47.54,0:16:49.60,Text_CN,,0,0,0,,没有资格对美美说这些
Dialogue: 6,0:16:50.70,0:16:52.20,Text_CN,,0,0,0,,我没法告诉她该怎么做
Dialogue: 6,0:16:53.50,0:16:55.20,Text_CN,,0,0,0,,席娜 你想做什么呢
Dialogue: 6,0:16:56.33,0:16:58.90,Text_CN,,0,0,0,,对不起 说了些奇怪的话
Dialogue: 6,0:16:59.31,0:17:02.16,Text_CN,,0,0,0,,可是 我无论如何也想说给你听
Dialogue: 6,0:17:07.97,0:17:09.66,Text_CN,,0,0,0,,谢谢你 席娜
Dialogue: 6,0:17:09.97,0:17:10.97,Text_CN,,0,0,0,,什么
Dialogue: 6,0:17:10.97,0:17:12.46,Text_CN,,0,0,0,,一点都不奇怪哦
Dialogue: 6,0:17:12.46,0:17:14.93,Text_CN,,0,0,0,,美美会好好珍惜的
Dialogue: 6,0:17:20.98,0:17:21.86,Text_CN,,0,0,0,,席娜？
Dialogue: 6,0:17:22.31,0:17:23.59,Text_CN,,0,0,0,,你泡晕了吗
Dialogue: 6,0:17:26.78,0:17:28.07,Text_CN,,0,0,0,,请进
Dialogue: 6,0:17:29.54,0:17:30.92,Text_CN,,0,0,0,,打扰了
Dialogue: 6,0:17:33.92,0:17:35.51,Text_CN,,0,0,0,,原来如此
Dialogue: 6,0:17:35.51,0:17:37.66,Text_CN,,0,0,0,,难怪她昨晚没来
Dialogue: 6,0:17:37.89,0:17:42.47,Text_CN,,0,0,0,,所以 我想您这里可能有清除地面血迹的药剂等等
Dialogue: 6,0:17:43.31,0:17:46.42,Text_CN,,0,0,0,,美美 在医务室桌子的架子上
Dialogue: 6,0:17:46.42,0:17:48.63,Text_CN,,0,0,0,,绿色的小瓶子 你自己去拿过来
Dialogue: 6,0:17:48.86,0:17:51.62,Text_CN,,0,0,0,,什么 讨厌
Dialogue: 6,0:17:54.10,0:17:55.69,Text_CN,,0,0,0,,费了很大劲吧
Dialogue: 6,0:17:55.69,0:17:56.40,Text_CN,,0,0,0,,什么
Dialogue: 6,0:17:56.85,0:17:58.47,Text_CN,,0,0,0,,给那家伙洗澡
Dialogue: 6,0:17:58.85,0:18:01.14,Text_CN,,0,0,0,,一点也不老实 还会突然游起来
Dialogue: 6,0:18:03.34,0:18:05.09,Text_CN,,0,0,0,,但是 我很开心
Dialogue: 6,0:18:05.46,0:18:07.28,Text_CN,,0,0,0,,因为美美看起来很开心
Dialogue: 6,0:18:08.85,0:18:12.92,Text_CN,,0,0,0,,那以后她洗澡全都交给你来吧
Dialogue: 6,0:18:13.65,0:18:14.40,Text_CN,,0,0,0,,那个…
Dialogue: 6,0:18:15.49,0:18:17.34,Text_CN,,0,0,0,,这样下去真的好吗
Dialogue: 6,0:18:17.67,0:18:21.71,Text_CN,,0,0,0,,美美 完全不觉得打倒敌人有什么不对
Dialogue: 6,0:18:22.19,0:18:25.26,Text_CN,,0,0,0,,明明是在夺走他人的生命 却浑然不知
Dialogue: 6,0:18:25.26,0:18:26.44,Text_CN,,0,0,0,,是啊
Dialogue: 6,0:18:26.79,0:18:27.81,Text_CN,,0,0,0,,那要告诉她吗
Dialogue: 6,0:18:28.32,0:18:32.14,Text_CN,,0,0,0,,告诉她生命的宝贵 还有夺走它的罪恶
Dialogue: 6,0:18:32.14,0:18:33.17,Text_CN,,0,0,0,,这…
Dialogue: 6,0:18:33.84,0:18:37.52,Text_CN,,0,0,0,,至今为止 被那孩子杀死的人数不胜数
Dialogue: 6,0:18:37.52,0:18:41.89,Text_CN,,0,0,0,,就算她理解了这份罪恶 她真的能接受吗
Dialogue: 6,0:18:42.58,0:18:44.78,Text_CN,,0,0,0,,那孩子甚至连死都做不到
Dialogue: 6,0:18:45.83,0:18:46.36,Text_CN,,0,0,0,,但是…
Dialogue: 6,0:18:48.10,0:18:49.11,Text_CN,,0,0,0,,但是 我不要
Dialogue: 6,0:18:50.15,0:18:51.32,Text_CN,,0,0,0,,那你想怎么样
Dialogue: 6,0:18:51.83,0:18:55.40,Text_CN,,0,0,0,,能不能让美美的身体恢复正常呢
Dialogue: 6,0:18:55.40,0:18:57.09,Text_CN,,0,0,0,,恢复正常了 那又怎样
Dialogue: 6,0:18:57.47,0:19:00.37,Text_CN,,0,0,0,,那样的话 她是不是就不用去战场了
Dialogue: 6,0:19:00.37,0:19:05.08,Text_CN,,0,0,0,,但取而代之的 是这里的所有学生都会被送上战场
Dialogue: 6,0:19:05.63,0:19:07.12,Text_CN,,0,0,0,,包括你 席娜
Dialogue: 6,0:19:08.20,0:19:09.71,Text_CN,,0,0,0,,这样你也愿意吗
Dialogue: 6,0:19:11.39,0:19:12.52,Text_CN,,0,0,0,,这个…
Dialogue: 6,0:19:18.27,0:19:21.10,Text_CN,,0,0,0,,为什么 为什么会有战争…
Dialogue: 6,0:19:21.47,0:19:24.31,Text_CN,,0,0,0,,真是的 我也想知道
Dialogue: 6,0:19:24.31,0:19:27.45,Text_CN,,0,0,0,,不 大概所有人都想知道吧
Dialogue: 6,0:19:27.89,0:19:29.47,Text_CN,,0,0,0,,可是 战争就是存在
Dialogue: 6,0:19:29.90,0:19:31.14,Text_CN,,0,0,0,,而且不会停止
Dialogue: 6,0:19:32.21,0:19:34.56,Text_CN,,0,0,0,,不管打了几十年几百年
Dialogue: 6,0:19:34.99,0:19:37.24,Text_CN,,0,0,0,,即使哪一方打赢了战争
Dialogue: 6,0:19:37.93,0:19:39.57,Text_CN,,0,0,0,,和平也只是暂时的
Dialogue: 6,0:19:39.99,0:19:43.90,Text_CN,,0,0,0,,战争会播下憎恨的种子 而且终将发芽结果
Dialogue: 6,0:19:44.12,0:19:45.91,Text_CN,,0,0,0,,然后带来新的战争
Dialogue: 6,0:19:46.40,0:19:50.78,Text_CN,,0,0,0,,为了保护自己和所爱的人 只能战斗
Dialogue: 6,0:19:51.56,0:19:54.09,Text_CN,,0,0,0,,即使知道了那是多么大的错误
Dialogue: 6,0:19:55.13,0:19:58.24,Text_CN,,0,0,0,,没有人会觉得美美所做的事是正确的
Dialogue: 6,0:19:58.88,0:20:00.31,Text_CN,,0,0,0,,但是 没有别的办法
Dialogue: 6,0:20:01.13,0:20:03.33,Text_CN,,0,0,0,,为了减少牺牲 只能这样
Dialogue: 6,0:20:03.87,0:20:05.13,Text_CN,,0,0,0,,这就是现实
Dialogue: 6,0:20:06.59,0:20:09.36,Text_CN,,0,0,0,,记住这一点 然后你再想想吧
Dialogue: 6,0:20:09.73,0:20:11.78,Text_CN,,0,0,0,,你所希望的是什么
Dialogue: 6,0:20:13.46,0:20:14.74,Text_CN,,0,0,0,,富朗老师…
Dialogue: 6,0:20:15.48,0:20:16.81,Text_CN,,0,0,0,,找到了
Dialogue: 6,0:20:18.66,0:20:20.78,Text_CN,,0,0,0,,说一下这个药怎么用
Dialogue: 6,0:20:21.32,0:20:25.54,Text_CN,,0,0,0,,滴上一滴以后 要等到污渍被完全渗透
Dialogue: 6,0:20:25.54,0:20:27.24,Text_CN,,0,0,0,,然后擦掉
Dialogue: 6,0:20:27.74,0:20:29.79,Text_CN,,0,0,0,,好的 谢谢老师
Dialogue: 6,0:20:32.26,0:20:36.26,Text_CN,,0,0,0,,不要着急 花点时间慢慢地来
Dialogue: 6,0:20:37.11,0:20:37.95,Text_CN,,0,0,0,,两个人一起
Dialogue: 6,0:20:41.54,0:20:43.21,Text_CN,,0,0,0,,美美的愿望？
Dialogue: 6,0:20:43.21,0:20:44.06,Text_CN,,0,0,0,,嗯
Dialogue: 6,0:20:44.06,0:20:45.27,Text_CN,,0,0,0,,这个嘛…
Dialogue: 6,0:20:45.78,0:20:48.62,Text_CN,,0,0,0,,和你一起做饼干 画画
Dialogue: 6,0:20:48.62,0:20:50.32,Text_CN,,0,0,0,,然后饱饱地睡觉
Dialogue: 6,0:20:50.32,0:20:51.36,Text_CN,,0,0,0,,这样吗
Dialogue: 6,0:20:51.75,0:20:52.78,Text_CN,,0,0,0,,席娜呢
Dialogue: 6,0:20:52.78,0:20:55.19,Text_CN,,0,0,0,,我？我…
Dialogue: 6,0:20:55.76,0:20:57.40,Top_CN,,0,0,0,,紧急召集 紧急召集
Dialogue: 6,0:20:58.08,0:21:01.32,Top_CN,,0,0,0,,叫到学号的人 请火速集合
Dialogue: 6,0:21:01.78,0:21:02.87,Top_CN,,0,0,20,,14-07
Dialogue: 6,0:21:03.61,0:21:04.94,Top_CN,,0,0,20,,16-06
Dialogue: 6,0:21:05.45,0:21:10.46,Top_CN,,0,0,20,,16-11 16-12 16-24
Dialogue: 6,0:21:02.87,0:21:05.45,Text_CN,,0,0,0,,什么 昨天不是才去过
Dialogue: 6,0:21:05.95,0:21:07.88,Text_CN,,0,0,0,,我会做好夜宵等你的
Dialogue: 6,0:21:07.88,0:21:08.72,Text_CN,,0,0,0,,真的吗
Dialogue: 6,0:21:08.72,0:21:10.46,Text_CN,,0,0,0,,那我要吃饭团
Dialogue: 6,0:21:15.87,0:21:18.39,Text_CN,,0,0,0,,美美 今天也一定会回来的
Dialogue: 6,0:21:18.39,0:21:20.09,Text_CN,,0,0,0,,所以席娜要等着我哦
Dialogue: 6,0:21:20.62,0:21:22.31,Text_CN,,0,0,0,,那我出发啦
Dialogue: 6,0:21:35.86,0:21:37.58,Text_CN,,0,0,0,,席娜 你想做什么呢
Dialogue: 6,0:21:48.28,0:21:49.04,Text_CN,,0,0,0,,美美
Dialogue: 6,0:21:51.97,0:21:53.73,Text_CN,,0,0,0,,我现在最希望的是…
Dialogue: 6,0:21:55.75,0:21:56.48,Text_CN,,0,0,0,,我等着你
Dialogue: 6,0:21:57.78,0:21:58.59,Text_CN,,0,0,0,,我等着你
Dialogue: 6,0:21:59.59,0:22:00.98,Text_CN,,0,0,0,,我一定会等着你的
Dialogue: 6,0:22:01.65,0:22:03.42,Text_CN,,0,0,0,,你回来的时候千万别受伤
Dialogue: 6,0:22:08.41,0:22:09.34,Text_CN,,0,0,0,,收到
