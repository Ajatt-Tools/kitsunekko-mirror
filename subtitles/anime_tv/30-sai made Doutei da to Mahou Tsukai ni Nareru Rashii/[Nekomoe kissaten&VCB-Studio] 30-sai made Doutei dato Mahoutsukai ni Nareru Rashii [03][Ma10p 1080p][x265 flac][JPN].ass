Dialogue: 0,0:00:10.95,0:00:12.61,Dial_JP,,0,0,0,,だりぃ
Dialogue: 0,0:00:12.61,0:00:15.58,Dial_JP,,0,0,0,,なんで親睦会でカラオケなんだ
Dialogue: 0,0:00:16.06,0:00:18.27,Dial_JP,,0,0,0,,早く終わらねえかな
Dialogue: 0,0:00:23.30,0:00:25.46,Dial_JP,,0,0,0,,モテるってのも大変だな
Dialogue: 0,0:00:25.46,0:00:27.39,Dial_JP,,0,0,0,,あんれ　そこ
Dialogue: 0,0:00:28.30,0:00:30.62,Dial_JP,,0,0,0,,誰もいないじゃないっすか
Dialogue: 0,0:00:32.26,0:00:34.35,Dial_JP,,0,0,0,,新卒の六角
Dialogue: 0,0:02:06.65,0:02:09.41,Dial_JP,,0,0,0,,安達さん　こんな所にいたんすか
Dialogue: 0,0:02:09.41,0:02:10.30,Dial_JP,,0,0,0,,いたよ
Dialogue: 0,0:02:10.30,0:02:12.61,Dial_JP,,0,0,0,,オーラなさすぎて気付かなかったっす
Dialogue: 0,0:02:12.61,0:02:15.30,Dial_JP,,0,0,0,,コイツ　チャラくて苦手なんだよな
Dialogue: 0,0:02:15.30,0:02:17.12,Dial_JP,,0,0,0,,隣失礼しまーす
Dialogue: 0,0:02:18.00,0:02:19.91,Dial_JP,,0,0,0,,なんで座るんだ
Dialogue: 0,0:02:21.25,0:02:22.67,Dial_JP,,0,0,0,,もっと盛り上がりましょうよ
Dialogue: 0,0:02:22.67,0:02:26.19,Dial_JP,,0,0,0,,気持ちわる　ちょっと飲み過ぎたかな
Dialogue: 0,0:02:26.19,0:02:28.50,Dial_JP,,0,0,0,,でも俺が盛り上げていかないと
Dialogue: 0,0:02:28.96,0:02:30.21,Dial_JP,,0,0,0,,コイツ…
Dialogue: 0,0:02:33.68,0:02:35.33,Dial_JP,,0,0,0,,なんすか　安西さん
Dialogue: 0,0:02:35.33,0:02:36.84,Dial_JP,,0,0,0,,安達な
Dialogue: 0,0:02:37.57,0:02:39.77,Dial_JP,,0,0,0,,お前　ちょっと飲み過ぎだろ
Dialogue: 0,0:02:40.14,0:02:42.23,Dial_JP,,0,0,0,,無理して盛り上げなくていいから
Dialogue: 0,0:02:43.85,0:02:46.35,Dial_JP,,0,0,0,,なんで持ってんすか　こんなの
Dialogue: 0,0:02:46.54,0:02:49.03,Dial_JP,,0,0,0,,俺もそんなに酒強くないから
Dialogue: 0,0:02:49.51,0:02:51.69,Dial_JP,,0,0,0,,こういうときのために一応な
Dialogue: 0,0:02:53.14,0:02:54.10,Dial_JP,,0,0,0,,あざす
Dialogue: 0,0:02:54.51,0:02:57.13,Dial_JP,,0,0,0,,意外と気が利きますね　安藤さん
Dialogue: 0,0:02:57.13,0:02:58.16,Dial_JP,,0,0,0,,安達だ
Dialogue: 0,0:02:58.43,0:03:00.87,Dial_JP,,0,0,0,,じゃ　遠慮なく頂いて
Dialogue: 0,0:03:00.87,0:03:01.92,Dial_JP,,0,0,0,,待て
Dialogue: 0,0:03:02.40,0:03:03.89,Dial_JP,,0,0,0,,それ酒だろ
Dialogue: 0,0:03:05.07,0:03:06.93,Dial_JP,,0,0,0,,ちゃんと水で飲め
Dialogue: 0,0:03:07.50,0:03:09.67,Dial_JP,,0,0,0,,マジ優しいっすね
Dialogue: 0,0:03:11.31,0:03:13.25,Dial_JP,,0,0,0,,もう　こぼれてるぞ
Dialogue: 0,0:03:13.25,0:03:15.09,Dial_JP,,0,0,0,,ほら　こっち向け
Dialogue: 0,0:03:15.09,0:03:16.09,Dial_JP,,0,0,0,,ったく
Dialogue: 0,0:03:16.09,0:03:17.81,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:03:17.81,0:03:19.65,Dial_JP,,0,0,0,,あざっす　安野さん
Dialogue: 0,0:03:19.65,0:03:22.35,Dial_JP,,0,0,0,,安達　お前もうわざとだろ
Dialogue: 0,0:03:22.94,0:03:24.61,Dial_JP,,0,0,0,,何がっすかあ
Dialogue: 0,0:03:24.61,0:03:25.29,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:03:28.44,0:03:31.02,Dial_JP,,0,0,0,,黒沢さん　どうしたんすか
Dialogue: 0,0:03:31.82,0:03:33.51,Dial_JP,,0,0,0,,俺んときと態度違うぞ
Dialogue: 0,0:03:35.07,0:03:38.00,Dial_JP,,0,0,0,,隣の子が六角のこと気になってるぽくて
Dialogue: 0,0:03:38.63,0:03:39.74,Dial_JP,,0,0,0,,マジすか
Dialogue: 0,0:03:39.74,0:03:41.50,Dial_JP,,0,0,0,,よかったら行ってあげて
Dialogue: 0,0:03:41.50,0:03:42.33,Dial_JP,,0,0,0,,ぜひ
Dialogue: 0,0:03:42.33,0:03:43.69,Dial_JP,,0,0,0,,あざす
Dialogue: 0,0:03:47.93,0:03:49.33,Dial_JP,,0,0,0,,隣よろしく
Dialogue: 0,0:03:49.33,0:03:51.23,Dial_JP,,0,0,0,,いやいやいやいやいやいやいや
Dialogue: 0,0:03:51.23,0:03:54.21,Dial_JP,,0,0,0,,あの子たち六角のこと気になってるとかないだろ
Dialogue: 0,0:03:55.20,0:03:58.37,Dial_JP,,0,0,0,,いや　でも　コイツのことだから
Dialogue: 0,0:03:58.37,0:04:00.70,Dial_JP,,0,0,0,,マジで優しさでってことも…
Dialogue: 0,0:04:00.70,0:04:01.81,Dial_JP,,0,0,0,,どっちだ
Dialogue: 0,0:04:02.66,0:04:05.17,Dial_JP,,0,0,0,,そうだ　触ればわかる
Dialogue: 0,0:04:08.18,0:04:12.19,Dial_JP,,0,0,0,,いや　これ　どうやって自然に触ればいいんだよ
Dialogue: 0,0:04:12.43,0:04:14.15,Dial_JP,,0,0,0,,ええい　ままよ
Dialogue: 0,0:04:14.54,0:04:16.19,Dial_JP,,0,0,0,,そういえば　今日は…
Dialogue: 0,0:04:17.66,0:04:18.66,Dial_JP,,0,0,0,,なに
Dialogue: 0,0:04:18.82,0:04:19.68,Dial_JP,,0,0,0,,近っ
Dialogue: 0,0:04:20.89,0:04:23.27,Dial_JP,,0,0,0,,無理　不審者じゃん
Dialogue: 0,0:04:25.66,0:04:29.17,Dial_JP,,0,0,0,,ハッピーエンドの途中
Dialogue: 0,0:04:29.17,0:04:32.67,Dial_JP,,800,0,0,,焦る　I want you
Dialogue: 0,0:04:29.17,0:04:31.29,Dial_JP,,0,800,0,,黒沢くんは歌わないの
Dialogue: 0,0:04:31.29,0:04:32.67,Dial_JP,,0,800,0,,僕は　ちょっと
Dialogue: 0,0:04:32.67,0:04:35.07,Dial_JP,,0,0,0,,あれ　歌わねえの
Dialogue: 0,0:04:35.07,0:04:37.02,Dial_JP,,0,0,0,,なんでもできるヤツだし
Dialogue: 0,0:04:37.02,0:04:39.62,Dial_JP,,0,0,0,,カラオケもそつなくこなすと思ってたんだけど
Dialogue: 0,0:04:40.72,0:04:42.06,Dial_JP,,0,0,0,,もしや音痴
Dialogue: 0,0:04:43.50,0:04:46.02,Dial_JP,,0,0,0,,この顔で音痴とかメッチャおもしろいじゃん
Dialogue: 0,0:04:46.02,0:04:47.02,Dial_JP,,0,0,0,,聞きたすぎる
Dialogue: 0,0:04:47.35,0:04:50.33,Dial_JP,,0,0,0,,イェーイ　ありがとうございました
Dialogue: 0,0:04:51.03,0:04:52.98,Dial_JP,,0,0,0,,六角うまかったなあ
Dialogue: 0,0:04:54.41,0:04:55.40,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:04:56.17,0:04:57.65,Dial_JP,,0,0,0,,やっぱり僕もいいですか
Dialogue: 0,0:04:57.65,0:04:58.78,Dial_JP,,0,0,0,,ぜひぜひ
Dialogue: 0,0:05:06.34,0:05:09.91,Dial_JP,,0,0,0,,この曲　難易度高そうだけど　大丈夫か
Dialogue: 0,0:05:23.22,0:05:24.18,Dial_JP,,0,0,0,,ヤバい
Dialogue: 0,0:05:24.18,0:05:27.50,Dial_JP,,0,0,0,,イケボ営業黒沢先輩の伝説の歌声
Dialogue: 0,0:05:27.50,0:05:29.95,Dial_JP,,0,0,0,,聞けてマジ感激っす
Dialogue: 0,0:05:29.95,0:05:31.60,Dial_JP,,0,0,0,,完璧人間め
Dialogue: 0,0:05:36.09,0:05:37.49,Dial_JP,,0,0,0,,なんかムカつく
Dialogue: 0,0:05:41.34,0:05:43.53,Dial_JP,,0,0,0,,いつまで隣にいるんだろう
Dialogue: 0,0:05:44.06,0:05:46.71,Dial_JP,,0,0,0,,安達　このピザなかなかうまいぜ
Dialogue: 0,0:05:49.77,0:05:50.78,Dial_JP,,0,0,0,,ホントだ
Dialogue: 0,0:05:50.78,0:05:52.33,Dial_JP,,0,0,0,,黒沢さん
Dialogue: 0,0:05:52.33,0:05:54.27,Dial_JP,,0,0,0,,お隣いいですか
Dialogue: 0,0:05:55.60,0:05:56.78,Dial_JP,,0,0,0,,なんか来た
Dialogue: 0,0:05:59.45,0:06:00.47,Dial_JP,,0,0,0,,邪魔
Dialogue: 0,0:06:01.30,0:06:04.13,Dial_JP,,0,0,0,,なんでこんなヤツが黒沢さんの隣に
Dialogue: 0,0:06:04.13,0:06:05.01,Dial_JP,,0,0,0,,こわっ
Dialogue: 0,0:06:05.60,0:06:08.14,Dial_JP,,0,0,0,,俺　あっちで飲んでくるわ
Dialogue: 0,0:06:08.39,0:06:09.03,Dial_JP,,0,0,0,,安達
Dialogue: 0,0:06:09.03,0:06:11.41,Dial_JP,,0,0,0,,黒沢くん　飲んでるかね
Dialogue: 0,0:06:11.41,0:06:12.34,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:06:15.71,0:06:18.39,Dial_JP,,0,0,0,,なんでこんなヤツが　か
Dialogue: 0,0:06:18.87,0:06:20.96,Dial_JP,,0,0,0,,まあ　確かにそうだよな
Dialogue: 0,0:06:21.70,0:06:24.17,Dial_JP,,0,0,0,,なんであんなイケメンが俺なんかに…
Dialogue: 0,0:06:27.38,0:06:28.55,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:06:28.89,0:06:30.97,Dial_JP,,0,0,0,,いけない　ボーッとしてたかも
Dialogue: 0,0:06:31.15,0:06:33.08,Dial_JP,,0,0,0,,事務の藤崎さん
Dialogue: 0,0:06:33.08,0:06:34.75,Dial_JP,,0,0,0,,いえ　こちらこそ
Dialogue: 0,0:06:34.75,0:06:37.77,Dial_JP,,0,0,0,,皆さんに追加の注文を聞いてるんですけど
Dialogue: 0,0:06:38.09,0:06:39.94,Dial_JP,,0,0,0,,安達さんも何か要りますか
Dialogue: 0,0:06:40.64,0:06:43.05,Dial_JP,,0,0,0,,そんなのおのおのでやればいいのに
Dialogue: 0,0:06:45.01,0:06:46.69,Dial_JP,,0,0,0,,私も飲みたいから
Dialogue: 0,0:06:46.69,0:06:49.22,Dial_JP,,0,0,0,,ついでにみんなの分もってだけです
Dialogue: 0,0:06:49.22,0:06:50.90,Dial_JP,,0,0,0,,そうですか
Dialogue: 0,0:06:50.90,0:06:52.43,Dial_JP,,0,0,0,,じゃあ　ウーロン茶を
Dialogue: 0,0:06:52.77,0:06:55.14,Dial_JP,,0,0,0,,はい　ウーロン茶ですね
Dialogue: 0,0:06:55.71,0:06:58.58,Dial_JP,,0,0,0,,前からいい人だなって気になってたけど
Dialogue: 0,0:06:59.05,0:07:01.11,Dial_JP,,0,0,0,,やっぱり優しいな
Dialogue: 0,0:07:01.57,0:07:04.13,Dial_JP,,0,0,0,,私ちょっとお手洗いに行ってきます
Dialogue: 0,0:07:04.63,0:07:05.35,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:07:08.24,0:07:11.17,Dial_JP,,0,0,0,,あんな子が俺のこと好きだったら…
Dialogue: 0,0:07:11.17,0:07:15.02,Dial_JP,,0,0,0,,なんて　そんな都合のいいことあるわけないよな
Dialogue: 0,0:07:15.02,0:07:18.75,Dial_JP,,0,0,0,,安藤さん　俺最近サウナにハマってるんすよ
Dialogue: 0,0:07:18.75,0:07:20.78,Dial_JP,,0,0,0,,今度一緒にどうすか
Dialogue: 0,0:07:20.78,0:07:22.51,Dial_JP,,0,0,0,,だから　安達
Dialogue: 0,0:07:24.79,0:07:27.26,Dial_JP,,0,0,0,,やっぱ　こういう飲み会苦手だわ
Dialogue: 0,0:07:27.26,0:07:29.98,Dial_JP,,0,800,0,,ちょっとだけいいじゃんかよ
Dialogue: 0,0:07:27.91,0:07:29.93,Dial_JP,,800,0,0,,や…　やめてください
Dialogue: 0,0:07:30.48,0:07:33.05,Dial_JP,,0,0,0,,ぶつかってきたのそっちじゃん
Dialogue: 0,0:07:33.44,0:07:34.41,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:07:34.41,0:07:36.54,Dial_JP,,0,0,0,,一緒に歌おうぜ
Dialogue: 0,0:07:37.68,0:07:38.77,Dial_JP,,0,0,0,,安達さん
Dialogue: 0,0:07:42.21,0:07:43.28,Dial_JP,,0,0,0,,助けて
Dialogue: 0,0:07:44.53,0:07:46.11,Dial_JP,,0,0,0,,なんだあ　お前
Dialogue: 0,0:07:47.12,0:07:48.80,Dial_JP,,0,0,0,,見るからに酔っ払いじゃん
Dialogue: 0,0:07:50.08,0:07:51.46,Dial_JP,,0,0,0,,怖い　無理
Dialogue: 0,0:07:52.86,0:07:56.27,Dial_JP,,0,0,0,,でも　ここで逃げたら男じゃない
Dialogue: 0,0:07:57.11,0:07:59.61,Dial_JP,,0,0,0,,あの　彼女嫌がってるんで
Dialogue: 0,0:07:59.61,0:08:02.42,Dial_JP,,0,0,0,,や…　やめていただけないでしょうか
Dialogue: 0,0:08:04.64,0:08:05.92,Dial_JP,,0,0,0,,お前に関係ねえだろ
Dialogue: 0,0:08:05.92,0:08:09.39,Dial_JP,,0,0,0,,ででで…　でも無理やりはよくないと思います
Dialogue: 0,0:08:09.39,0:08:10.72,Dial_JP,,0,0,0,,うるせえ
Dialogue: 0,0:08:10.72,0:08:13.29,Dial_JP,,0,0,0,,陰キャが生意気にイキがってんじゃねえぞ
Dialogue: 0,0:08:14.58,0:08:17.46,Dial_JP,,0,0,0,,やっぱり慣れないことするんじゃなかった
Dialogue: 0,0:08:17.46,0:08:18.25,Dial_JP,,0,0,0,,失礼
Dialogue: 0,0:08:19.90,0:08:21.37,Dial_JP,,0,0,0,,安達に触るな
Dialogue: 0,0:08:23.49,0:08:24.70,Dial_JP,,0,0,0,,黒沢
Dialogue: 0,0:08:26.51,0:08:27.75,Dial_JP,,0,0,0,,なんだお前
Dialogue: 0,0:08:31.29,0:08:33.62,Dial_JP,,0,0,0,,楢崎コーポレーションの方ですか
Dialogue: 0,0:08:34.74,0:08:38.00,Dial_JP,,0,0,0,,お互いせっかく羽を伸ばしに来てるんですから
Dialogue: 0,0:08:39.28,0:08:42.17,Dial_JP,,0,0,0,,冗談はほどほどにしていただけませんか
Dialogue: 0,0:08:42.96,0:08:44.73,Dial_JP,,0,0,0,,失礼しました
Dialogue: 0,0:08:47.18,0:08:49.65,Dial_JP,,0,0,0,,すみません　助けていただいて
Dialogue: 0,0:08:49.65,0:08:52.00,Dial_JP,,0,0,0,,い…　いや　俺は何も
Dialogue: 0,0:08:52.83,0:08:54.32,Dial_JP,,0,0,0,,災難だったね
Dialogue: 0,0:08:54.53,0:08:55.44,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:08:56.57,0:08:57.65,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:08:59.85,0:09:01.52,Dial_JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:09:03.03,0:09:04.43,Dial_JP,,0,0,0,,複雑
Dialogue: 0,0:09:04.75,0:09:06.15,Dial_JP,,0,0,0,,助けてもらったけど
Dialogue: 0,0:09:07.13,0:09:09.24,Dial_JP,,0,0,0,,何もできなかった俺と
Dialogue: 0,0:09:10.02,0:09:12.64,Dial_JP,,0,0,0,,何をしても様になる黒沢
Dialogue: 0,0:09:14.27,0:09:17.37,Dial_JP,,0,0,0,,余裕ありすぎて　ムカついてきたな
Dialogue: 0,0:09:18.08,0:09:19.97,Dial_JP,,0,0,0,,なんでここにいるんだよ
Dialogue: 0,0:09:19.97,0:09:22.38,Dial_JP,,0,0,0,,安達　気分悪そうだったから
Dialogue: 0,0:09:22.63,0:09:24.17,Dial_JP,,0,0,0,,大丈夫かなって
Dialogue: 0,0:09:24.56,0:09:25.15,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:09:25.50,0:09:27.09,Dial_JP,,0,0,0,,安達　ケガしてる
Dialogue: 0,0:09:27.83,0:09:28.61,Dial_JP,,0,0,0,,どこ
Dialogue: 0,0:09:28.61,0:09:29.39,Dial_JP,,0,0,0,,ここ
Dialogue: 0,0:09:30.56,0:09:33.79,Dial_JP,,0,0,0,,ネクタイをつかまれたときに爪でもかすったかな
Dialogue: 0,0:09:34.08,0:09:35.17,Dial_JP,,0,0,0,,ちょっと待って
Dialogue: 0,0:09:35.17,0:09:36.54,Dial_JP,,0,0,0,,たしか財布に
Dialogue: 0,0:09:39.78,0:09:40.65,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:09:41.37,0:09:42.91,Dial_JP,,0,0,0,,お…　おう
Dialogue: 0,0:09:43.42,0:09:44.81,Dial_JP,,0,0,0,,用意いいな
Dialogue: 0,0:09:45.25,0:09:46.02,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:09:49.30,0:09:50.29,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:09:51.14,0:09:51.92,Dial_JP,,0,0,0,,貸して
Dialogue: 0,0:09:54.55,0:09:56.45,Dial_JP,,0,0,0,,失敗したな
Dialogue: 0,0:09:58.46,0:09:59.77,Dial_JP,,0,0,0,,いくらなんでも
Dialogue: 0,0:09:59.77,0:10:01.70,Dial_JP,,0,0,0,,こんなとこまで追っかけたり
Dialogue: 0,0:10:02.42,0:10:04.01,Dial_JP,,0,0,0,,席を交換したり
Dialogue: 0,0:10:04.30,0:10:05.90,Dial_JP,,0,0,0,,カラオケで張り合ったり
Dialogue: 0,0:10:07.04,0:10:08.59,Dial_JP,,0,0,0,,強引っていうか
Dialogue: 0,0:10:09.11,0:10:10.58,Dial_JP,,0,0,0,,安達も引いたよな
Dialogue: 0,0:10:11.13,0:10:13.05,Dial_JP,,0,0,0,,引いたっていうか…
Dialogue: 0,0:10:13.46,0:10:17.84,Dial_JP,,0,0,0,,ホント　安達のことになると余裕ないな　俺
Dialogue: 0,0:10:18.82,0:10:21.54,Dial_JP,,0,0,0,,六角や藤崎さんにも嫉妬するなんて
Dialogue: 0,0:10:25.30,0:10:29.07,Dial_JP,,0,0,0,,六角も藤崎さんも\N俺のことなんかなんとも思ってねえぞ
Dialogue: 0,0:10:30.25,0:10:35.24,Dial_JP,,0,0,0,,ホント　自分がこんなに心が狭いなんて知らなかった
Dialogue: 0,0:10:41.68,0:10:42.72,Dial_JP,,0,0,0,,これでよし
Dialogue: 0,0:10:47.75,0:10:49.92,Dial_JP,,0,0,0,,黒沢のこと　今まで
Dialogue: 0,0:10:50.43,0:10:53.84,Dial_JP,,0,0,0,,完璧でいつも余裕のあるヤツだって思ってた
Dialogue: 0,0:10:55.20,0:10:57.22,Dial_JP,,0,0,0,,けど本当はそうじゃなくて
Dialogue: 0,0:10:57.75,0:10:59.94,Dial_JP,,0,0,0,,悩んだり　焦ったりしてたんだ
Dialogue: 0,0:11:01.51,0:11:03.09,Dial_JP,,0,0,0,,俺と同じように
Dialogue: 0,0:11:04.05,0:11:05.03,Dial_JP,,0,0,0,,ヤバい
Dialogue: 0,0:11:06.25,0:11:07.74,Dial_JP,,0,0,0,,俺たちも戻るか
Dialogue: 0,0:11:10.49,0:11:13.84,Dial_JP,,0,0,0,,ちょっとかわいいかもとか思ったりして
Dialogue: 0,0:11:14.45,0:11:15.54,Dial_JP,,0,0,0,,黒沢
Dialogue: 0,0:11:17.68,0:11:18.63,Dial_JP,,0,0,0,,その
Dialogue: 0,0:11:19.87,0:11:21.79,Dial_JP,,0,0,0,,助けてくれてサンキュな
Dialogue: 0,0:11:25.74,0:11:27.05,Dial_JP,,0,0,0,,大げさだな
Dialogue: 0,0:11:29.21,0:11:31.41,Dial_JP,,0,0,0,,今のは触れなくてもわかる
Dialogue: 0,0:11:32.07,0:11:33.12,Dial_JP,,0,0,0,,うれしそうだ
Dialogue: 0,0:11:33.94,0:11:36.19,Dial_JP,,0,0,0,,なあ　アイスとか食べたくね
Dialogue: 0,0:11:37.41,0:11:38.86,Dial_JP,,0,0,0,,こっそり食いに行くか
Dialogue: 0,0:11:51.43,0:11:55.14,Dial_JP,,0,0,0,,いや　サウナホントに一緒に\N来てもらえてうれしいっす
Dialogue: 0,0:11:55.75,0:11:57.52,Dial_JP,,0,0,0,,休日出勤のところ
Dialogue: 0,0:11:57.52,0:11:59.85,Dial_JP,,0,0,0,,せっかく早上がりできたのにな
Dialogue: 0,0:11:59.85,0:12:02.33,Dial_JP,,0,0,0,,まあまあ　タダ券があったんで
Dialogue: 0,0:12:02.33,0:12:04.25,Dial_JP,,0,0,0,,癒やされていきましょうよ
Dialogue: 0,0:12:05.90,0:12:08.17,Dial_JP,,0,0,0,,黒沢さん　体すげえっすね
Dialogue: 0,0:12:08.17,0:12:09.65,Dial_JP,,0,0,0,,モデルみてえ
Dialogue: 0,0:12:09.65,0:12:10.48,Dial_JP,,0,0,0,,そう
Dialogue: 0,0:12:10.86,0:12:12.73,Dial_JP,,0,0,0,,なんかスポーツやってるんすか
Dialogue: 0,0:12:12.73,0:12:14.19,Dial_JP,,0,0,0,,一応ジムに
Dialogue: 0,0:12:14.63,0:12:15.98,Dial_JP,,0,0,0,,もう30だし
Dialogue: 0,0:12:15.98,0:12:17.25,Dial_JP,,0,0,0,,健康のためにね
Dialogue: 0,0:12:17.25,0:12:18.80,Dial_JP,,0,0,0,,マジすかあ
Dialogue: 0,0:12:18.80,0:12:20.25,Dial_JP,,0,800,0,,俺も行こうかな
Dialogue: 0,0:12:19.35,0:12:20.25,Dial_JP,,800,0,0,,なんて
Dialogue: 0,0:12:20.56,0:12:22.80,Dial_JP,,0,0,0,,こういう日がいつ来てもいいように
Dialogue: 0,0:12:22.80,0:12:25.69,Dial_JP,,0,0,0,,ふだんから筋トレ頑張ってたんだよな
Dialogue: 0,0:12:25.91,0:12:29.86,Dial_JP,,0,0,0,,だって　安達にだらしない体　見せたくないし
Dialogue: 0,0:12:33.31,0:12:38.65,Dial_JP,,0,0,0,,まあ　安達が俺の体なんか興味ないのは\Nわかってんだけど
Dialogue: 0,0:12:45.50,0:12:48.94,Dial_JP,,0,0,0,,こんな近くに無防備な姿の安達がいるなんて
Dialogue: 0,0:12:49.47,0:12:50.95,Dial_JP,,0,0,0,,わかってはいたけど
Dialogue: 0,0:12:51.76,0:12:54.51,Dial_JP,,0,0,0,,いざとなると安達のことを直視できない
Dialogue: 0,0:12:54.91,0:12:56.92,Dial_JP,,0,0,0,,正直　少し不安だ
Dialogue: 0,0:12:58.14,0:13:01.25,Dial_JP,,0,0,0,,このあともし安達のすべてが見えてしまったら
Dialogue: 0,0:13:01.76,0:13:05.29,Dial_JP,,0,0,0,,改めて安達は男なんだって現実を知ることになる
Dialogue: 0,0:13:07.42,0:13:09.20,Dial_JP,,0,0,0,,安達のことは好きだし
Dialogue: 0,0:13:09.61,0:13:12.02,Dial_JP,,0,0,0,,今まで妄想したりしたけど
Dialogue: 0,0:13:12.47,0:13:16.11,Dial_JP,,0,0,0,,俺は今まで女の人としかつきあったことなかったし
Dialogue: 0,0:13:17.10,0:13:19.95,Dial_JP,,0,0,0,,実際に見たら　どう思うのかな
Dialogue: 0,0:13:21.37,0:13:22.11,Dial_JP,,0,0,0,,もう無理
Dialogue: 0,0:13:22.11,0:13:23.11,Dial_JP,,0,0,0,,熱すぎる
Dialogue: 0,0:13:23.11,0:13:24.49,Dial_JP,,0,0,0,,俺は出る
Dialogue: 0,0:13:30.78,0:13:32.07,Dial_JP,,0,0,0,,ちょっとポヨってるおなか
Dialogue: 0,0:13:32.07,0:13:33.29,Dial_JP,,0,0,0,,メチャクチャかわいい
Dialogue: 0,0:13:33.29,0:13:35.51,Dial_JP,,0,0,0,,白くてスベスベだし　白玉か
Dialogue: 0,0:13:35.51,0:13:37.70,Dial_JP2,,0,0,0,,ポヨポヨですげえ気持ちよさそう
Dialogue: 0,0:13:37.70,0:13:39.22,Dial_JP2,,0,0,0,,いや　絶対気持ちいいじゃん
Dialogue: 0,0:13:41.34,0:13:42.93,Dial_JP,,0,0,0,,クッソォ
Dialogue: 0,0:13:48.39,0:13:50.47,Dial_JP,,0,0,0,,触りてえ
Dialogue: 0,0:13:54.27,0:13:55.50,Dial_JP,,0,0,0,,運動しよ
Dialogue: 0,0:13:59.12,0:14:01.18,Dial_JP,,0,0,0,,じゃあ俺　あっちなんで
Dialogue: 0,0:14:01.18,0:14:02.95,Dial_JP,,0,0,0,,おつかれっしたあ
Dialogue: 0,0:14:02.95,0:14:03.67,Dial_JP,,0,0,0,,おう
Dialogue: 0,0:14:06.13,0:14:07.95,Dial_JP,,0,0,0,,安達はこっちだったよな
Dialogue: 0,0:14:15.26,0:14:17.10,Dial_JP,,0,0,0,,風が気持ちいいな
Dialogue: 0,0:14:18.48,0:14:21.34,Dial_JP,,0,0,0,,サウナも意外と悪くなかったな
Dialogue: 0,0:14:27.30,0:14:29.23,Dial_JP,,0,0,0,,安達　こっちこっち
Dialogue: 0,0:14:31.82,0:14:33.97,Dial_JP,,0,0,0,,ちょっ　なんで撮ってんだよ
Dialogue: 0,0:14:34.90,0:14:35.63,Dial_JP,,0,0,0,,つい
Dialogue: 0,0:14:35.63,0:14:36.55,Dial_JP,,0,0,0,,消せ
Dialogue: 0,0:14:37.61,0:14:38.32,Dial_JP,,0,0,0,,ヤダ
Dialogue: 0,0:14:38.79,0:14:40.27,Dial_JP,,0,0,0,,恋人だったら
Dialogue: 0,0:14:40.27,0:14:42.27,Dial_JP,,0,0,0,,写真とかも許されるのに
Dialogue: 0,0:14:43.37,0:14:45.35,Dial_JP,,0,0,0,,やっぱり　同僚とはいえ
Dialogue: 0,0:14:45.62,0:14:46.83,Dial_JP,,0,0,0,,撮るの変かな
Dialogue: 0,0:14:47.78,0:14:51.91,Dial_JP,,0,0,0,,最初はただ　そばにいられたらって\N思っただけだったのに
Dialogue: 0,0:14:52.61,0:14:54.79,Dial_JP,,0,0,0,,どんどん欲張りになってくな
Dialogue: 0,0:14:55.65,0:14:58.25,Dial_JP,,0,0,0,,額へのキスは嫌じゃないって言ってくれたし
Dialogue: 0,0:14:59.34,0:15:01.71,Dial_JP,,0,0,0,,前より一緒にいる時間は増えたけど
Dialogue: 0,0:15:02.48,0:15:06.10,Dial_JP,,0,0,0,,安達の好きは　きっと友人としての好きで
Dialogue: 0,0:15:06.74,0:15:08.09,Dial_JP,,0,0,0,,俺とは違う
Dialogue: 0,0:15:08.94,0:15:10.05,Dial_JP,,0,0,0,,わかってるけど
Dialogue: 0,0:15:10.41,0:15:11.95,Dial_JP,,0,0,0,,やっぱりつらいな
Dialogue: 0,0:15:14.19,0:15:15.22,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:15:17.68,0:15:20.16,Dial_JP,,0,0,0,,安達って　優しいな
Dialogue: 0,0:15:22.49,0:15:23.47,Dial_JP,,0,0,0,,あのときも
Dialogue: 0,0:15:26.27,0:15:28.23,Dial_JP,,0,0,0,,黒沢くん　遊ぼ
Dialogue: 0,0:15:28.23,0:15:29.33,Dial_JP,,0,0,0,,私と遊ぶの
Dialogue: 0,0:15:29.87,0:15:32.57,Dial_JP,,800,0,0,,きみ　芸能界に興味ない
Dialogue: 0,0:15:29.33,0:15:33.21,Dial_JP,,0,800,0,,俺は昔からこの顔で得することが多かった
Dialogue: 0,0:15:33.21,0:15:34.22,Dial_JP,,0,0,0,,好きです
Dialogue: 0,0:15:34.77,0:15:37.58,Dial_JP,,0,800,0,,御社のお客様のような安定な感度の高い…
Dialogue: 0,0:15:35.89,0:15:36.72,Dial_JP,,800,0,0,,けれど…
Dialogue: 0,0:15:37.58,0:15:40.79,Dial_JP,,0,0,0,,社会に出たら反感を持たれることが増えた
Dialogue: 0,0:15:41.50,0:15:42.75,Dial_JP,,0,0,0,,チャラチャラしやがって
Dialogue: 0,0:15:42.75,0:15:44.19,Dial_JP,,0,0,0,,顔だけのくせに
Dialogue: 0,0:15:44.19,0:15:45.78,Dial_JP,,0,0,0,,男らしくねえんだよ
Dialogue: 0,0:15:47.87,0:15:49.78,Dial_JP,,0,0,0,,あらゆる努力を重ね
Dialogue: 0,0:15:50.63,0:15:52.13,Dial_JP,,0,0,0,,結果も出してきたが…
Dialogue: 0,0:15:55.92,0:15:59.11,Dial_JP,,0,0,0,,本日はお招きいただきありがとうございます
Dialogue: 0,0:15:59.78,0:16:03.26,Dial_JP,,0,0,0,,改めまして　営業部の黒沢と申します
Dialogue: 0,0:16:03.57,0:16:06.03,Dial_JP,,0,0,0,,あら　あなたがあの…
Dialogue: 0,0:16:06.30,0:16:08.20,Dial_JP,,0,0,0,,おうわさはかねがね
Dialogue: 0,0:16:08.58,0:16:09.75,Dial_JP,,0,0,0,,こちらこそ
Dialogue: 0,0:16:09.91,0:16:13.70,Dial_JP,,0,0,0,,まさか松浦社長と\Nこうしてじきじきにお会いできるとは
Dialogue: 0,0:16:13.97,0:16:16.54,Dial_JP,,0,0,0,,御社が先月出された新商品のコンセプトも…
Dialogue: 0,0:16:16.54,0:16:18.75,Dial_JP,,0,0,0,,あら　もうそのへんで
Dialogue: 0,0:16:19.02,0:16:20.18,Dial_JP,,0,0,0,,堅苦しいわよ
Dialogue: 0,0:16:20.18,0:16:21.22,Dial_JP,,0,0,0,,真面目ね
Dialogue: 0,0:16:21.90,0:16:23.63,Dial_JP,,0,0,0,,今日はオフなんだから
Dialogue: 0,0:16:23.87,0:16:25.84,Dial_JP,,0,0,0,,仕事の話はやめて
Dialogue: 0,0:16:26.94,0:16:27.93,Dial_JP,,0,0,0,,わかりました
Dialogue: 0,0:16:27.93,0:16:29.74,Dial_JP,,0,0,0,,それでは　由紀子様
Dialogue: 0,0:16:30.27,0:16:32.64,Dial_JP,,0,0,0,,まあ　ノリがいいわね
Dialogue: 0,0:16:32.64,0:16:35.33,Dial_JP,,0,0,0,,あなたこのままうちの秘書になっちゃわない
Dialogue: 0,0:16:35.33,0:16:37.14,Dial_JP,,0,0,0,,いえ　僕なんかでは
Dialogue: 0,0:16:37.57,0:16:39.35,Dial_JP,,0,0,0,,かわいい
Dialogue: 0,0:16:39.35,0:16:40.59,Dial_JP,,0,0,0,,気に入ったわ
Dialogue: 0,0:16:41.38,0:16:42.69,Dial_JP,,0,0,0,,それじゃあ
Dialogue: 0,0:16:43.18,0:16:44.65,Dial_JP,,0,0,0,,乾杯
Dialogue: 0,0:16:46.06,0:16:50.11,Dial_JP,,0,0,0,,ねえ　あなた　全然飲んでないじゃない
Dialogue: 0,0:16:51.25,0:16:52.62,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:16:52.62,0:16:54.81,Dial_JP,,0,0,0,,僕　あんまり強くなくて
Dialogue: 0,0:16:54.81,0:16:56.10,Dial_JP,,0,0,0,,何言ってんの
Dialogue: 0,0:16:56.10,0:16:59.58,Dial_JP,,800,0,0,,お酒は慣れよ\N飲んでいけば飲めるようになるだから
Dialogue: 0,0:16:57.83,0:16:58.67,Dial_JP,,0,800,0,,安達
Dialogue: 0,0:16:59.82,0:17:01.75,Dial_JP,,0,0,0,,アイツ要領悪くて
Dialogue: 0,0:17:01.75,0:17:03.47,Dial_JP,,0,0,0,,うまくかわせないんだよな
Dialogue: 0,0:17:04.50,0:17:05.20,Dial_JP,,0,0,0,,ちょっ
Dialogue: 0,0:17:05.58,0:17:06.65,Dial_JP,,0,0,0,,なあに
Dialogue: 0,0:17:06.65,0:17:08.79,Dial_JP,,0,0,0,,私のお酒が飲めないの
Dialogue: 0,0:17:08.79,0:17:10.03,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:17:10.03,0:17:11.80,Dial_JP,,0,0,0,,コイツ　ノリが悪くて
Dialogue: 0,0:17:12.30,0:17:14.09,Dial_JP,,0,0,0,,代わりに僕がいただきます
Dialogue: 0,0:17:19.61,0:17:21.41,Dial_JP,,0,0,0,,さすが黒沢くん
Dialogue: 0,0:17:21.74,0:17:24.17,Dial_JP,,0,0,0,,顔だけじゃなくて　いけるのね
Dialogue: 0,0:17:25.21,0:17:26.01,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:17:28.21,0:17:29.99,Dial_JP,,0,0,0,,ねえ　あなた
Dialogue: 0,0:17:30.97,0:17:33.05,Dial_JP,,0,0,0,,本当に気に入ったわ
Dialogue: 0,0:17:33.54,0:17:35.66,Dial_JP,,0,0,0,,このあとゆっくり私と…
Dialogue: 0,0:17:39.37,0:17:40.38,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:17:40.83,0:17:42.32,Dial_JP,,0,0,0,,ちょっと失礼します
Dialogue: 0,0:17:43.52,0:17:45.74,Dial_JP,,800,0,0,,なんなのよもう
Dialogue: 0,0:17:43.90,0:17:45.74,Dial_JP,,0,800,0,,失礼いたしました　社長
Dialogue: 0,0:17:45.74,0:17:47.30,Dial_JP,,0,800,0,,申し訳ございません
Dialogue: 0,0:17:54.61,0:17:57.60,Dial_JP,,0,0,0,,ったく　黒沢のヤツ　社長の不興を買いやがって
Dialogue: 0,0:17:59.09,0:18:02.00,Dial_JP,,0,0,0,,顔だけがとりえのくせに　いらんことするから
Dialogue: 0,0:18:02.51,0:18:06.69,Dial_JP,,0,0,0,,笑ってこび売ってりゃ営業が\N務まるヤツは根性がねえよな
Dialogue: 0,0:18:07.45,0:18:08.73,Dial_JP,,0,0,0,,そんな…
Dialogue: 0,0:18:11.20,0:18:13.24,Dial_JP,,0,0,0,,ふいに息苦しくなって
Dialogue: 0,0:18:14.04,0:18:16.15,Dial_JP,,0,0,0,,でも　そんなとき
Dialogue: 0,0:18:18.41,0:18:19.49,Dial_JP,,0,0,0,,大丈夫か
Dialogue: 0,0:18:20.71,0:18:22.01,Dial_JP,,0,0,0,,なんとか
Dialogue: 0,0:18:25.63,0:18:26.73,Dial_JP,,0,0,0,,みんなは
Dialogue: 0,0:18:26.73,0:18:28.01,Dial_JP,,0,0,0,,もう帰った
Dialogue: 0,0:18:28.35,0:18:29.48,Dial_JP,,0,0,0,,そうか
Dialogue: 0,0:18:29.48,0:18:31.00,Dial_JP,,0,0,0,,じゃあ俺らも…
Dialogue: 0,0:18:32.01,0:18:33.65,Dial_JP,,0,0,0,,ムチャすんなって
Dialogue: 0,0:18:33.65,0:18:35.52,Dial_JP,,0,0,0,,しばらく横になってろよ
Dialogue: 0,0:18:35.52,0:18:37.04,Dial_JP,,0,0,0,,いや　でも
Dialogue: 0,0:18:37.04,0:18:38.39,Dial_JP,,0,0,0,,いいから
Dialogue: 0,0:18:40.63,0:18:43.31,Dial_JP,,0,0,0,,何やってんだろうな　俺
Dialogue: 0,0:18:45.03,0:18:47.32,Dial_JP,,0,0,0,,俺なんか　顔要員なのに
Dialogue: 0,0:18:47.85,0:18:52.13,Dial_JP,,0,0,0,,社長怒らせて　ホント役立たずだわ
Dialogue: 0,0:18:55.45,0:18:58.20,Dial_JP,,0,0,0,,ただの同僚相手に　何を言ってんだろ
Dialogue: 0,0:18:58.77,0:19:00.24,Dial_JP,,0,0,0,,そんなことないよ
Dialogue: 0,0:19:01.63,0:19:05.21,Dial_JP,,0,0,0,,いつも営業先のこと　すごいリサーチして
Dialogue: 0,0:19:05.36,0:19:07.84,Dial_JP,,0,0,0,,製品のことも全部覚えてきて
Dialogue: 0,0:19:08.44,0:19:11.27,Dial_JP,,0,0,0,,今日だって　お酒俺が飲めないから
Dialogue: 0,0:19:11.27,0:19:12.69,Dial_JP,,0,0,0,,代わりに飲んでくれて
Dialogue: 0,0:19:21.73,0:19:23.18,Dial_JP,,0,0,0,,なんだよ
Dialogue: 0,0:19:23.18,0:19:25.44,Dial_JP,,0,0,0,,いや　黒沢って
Dialogue: 0,0:19:25.44,0:19:28.11,Dial_JP,,0,0,0,,いつも完璧ってイメージだからさ
Dialogue: 0,0:19:29.36,0:19:32.97,Dial_JP,,0,0,0,,弱ってるとこ見るの　新鮮だなって
Dialogue: 0,0:19:43.37,0:19:44.47,Dial_JP,,0,0,0,,なんだ
Dialogue: 0,0:19:44.84,0:19:46.29,Dial_JP,,0,0,0,,今のドキッて
Dialogue: 0,0:19:47.89,0:19:49.23,Dial_JP,,0,0,0,,おかしくないか
Dialogue: 0,0:19:49.23,0:19:50.32,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:19:50.32,0:19:52.04,Dial_JP,,0,0,0,,顔が赤くなったな
Dialogue: 0,0:19:52.04,0:19:53.13,Dial_JP,,0,0,0,,大丈夫か
Dialogue: 0,0:19:54.03,0:19:55.43,Dial_JP,,0,0,0,,大丈夫　大丈夫
Dialogue: 0,0:19:56.04,0:19:57.39,Dial_JP,,0,0,0,,ホントか
Dialogue: 0,0:19:57.39,0:19:58.67,Dial_JP,,0,0,0,,顔赤いぞ
Dialogue: 0,0:19:58.67,0:19:59.69,Dial_JP,,0,0,0,,きっと
Dialogue: 0,0:20:02.11,0:20:03.56,Dial_JP,,0,0,0,,酒のせいだ
Dialogue: 0,0:20:06.55,0:20:08.95,Dial_JP,,0,0,0,,こんなに心臓がうるさくて
Dialogue: 0,0:20:09.59,0:20:11.72,Dial_JP,,0,0,0,,涙が出そうになるのは
Dialogue: 0,0:20:17.47,0:20:19.35,Dial_JP,,0,0,0,,あれから数か月
Dialogue: 0,0:20:21.11,0:20:22.39,Dial_JP,,0,800,0,,気を付けろよ
Dialogue: 0,0:20:21.11,0:20:24.12,Dial_JP,,800,0,0,,気付けば安達のことを目で追うようになった
Dialogue: 0,0:20:25.01,0:20:27.15,Dial_JP,,800,0,0,,まさかこの年になって
Dialogue: 0,0:20:27.15,0:20:30.08,Dial_JP,,800,0,0,,こんな初恋みたいな気持ちになるなんて
Dialogue: 0,0:20:28.79,0:20:30.08,Dial_JP,,0,800,0,,すみません
Dialogue: 0,0:20:30.08,0:20:31.35,Dial_JP,,0,800,0,,ありがとうございました
Dialogue: 0,0:20:31.95,0:20:33.55,Dial_JP,,0,800,0,,いえいえ
Dialogue: 0,0:20:31.11,0:20:33.28,Dial_JP,,800,0,0,,何があるかわかんねえな
Dialogue: 0,0:20:34.47,0:20:36.45,Dial_JP,,0,0,0,,ほら　バイバイは
Dialogue: 0,0:20:37.01,0:20:38.49,Dial_JP,,0,0,0,,バイバーイ
Dialogue: 0,0:20:38.49,0:20:41.31,Dial_JP,,0,0,0,,安達って　ホント優しいよな
Dialogue: 0,0:20:41.93,0:20:43.67,Dial_JP,,0,0,0,,いつも周り見てるしさ
Dialogue: 0,0:20:43.67,0:20:45.61,Dial_JP,,0,0,0,,そういうとこすげえ好き
Dialogue: 0,0:20:46.01,0:20:47.28,Dial_JP,,0,0,0,,優しい？
Dialogue: 0,0:20:47.51,0:20:48.55,Dial_JP,,0,0,0,,そうかな
Dialogue: 0,0:20:50.55,0:20:53.60,Dial_JP,,0,0,0,,俺さ　ぶっちゃけ陰キャだし
Dialogue: 0,0:20:55.11,0:20:58.15,Dial_JP,,0,0,0,,こんなヤツに助けられても　迷惑かなって
Dialogue: 0,0:20:59.49,0:21:02.00,Dial_JP,,0,0,0,,前まで動けなかったこと多かったし
Dialogue: 0,0:21:03.77,0:21:05.65,Dial_JP,,0,0,0,,でも　そうだな
Dialogue: 0,0:21:05.65,0:21:07.64,Dial_JP,,0,0,0,,最近は黒沢が…
Dialogue: 0,0:21:07.64,0:21:08.63,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:21:09.45,0:21:11.57,Dial_JP,,0,0,0,,黒沢といること多いから
Dialogue: 0,0:21:11.57,0:21:13.11,Dial_JP,,0,0,0,,自信がついたのかも
Dialogue: 0,0:21:15.32,0:21:16.80,Dial_JP,,0,0,0,,もう　ずるい
Dialogue: 0,0:21:17.64,0:21:18.79,Dial_JP,,0,0,0,,サンキュな
Dialogue: 0,0:21:18.79,0:21:21.49,Dial_JP,,0,0,0,,そうやってまた俺に期待させて
Dialogue: 0,0:21:22.03,0:21:24.93,Dial_JP,,0,0,0,,これ以上　好きにさせてどうしようっていうんだよ
Dialogue: 0,0:21:25.07,0:21:27.95,Dial_JP,,0,0,0,,それ　俺と関係なくない
Dialogue: 0,0:21:28.99,0:21:30.40,Dial_JP,,0,0,0,,あるある
Dialogue: 0,0:21:30.69,0:21:31.92,Dial_JP,,0,0,0,,たぶんな
Dialogue: 0,0:21:31.92,0:21:35.86,Dial_JP,,0,0,0,,安達は　ちょっとしたことで俺を不安にさせたり
Dialogue: 0,0:21:36.44,0:21:38.60,Dial_JP,,0,0,0,,メチャクチャ幸せにしたりする
Dialogue: 0,0:21:39.59,0:21:41.95,Dial_JP,,0,0,0,,じゃあ　お礼はツーショット写真で
Dialogue: 0,0:21:43.53,0:21:44.37,Dial_JP,,1200,0,0,,ほら
Dialogue: 0,0:21:43.07,0:21:45.51,Dial_JP,,0,200,0,,まるで魔法みたいって言ったら
Dialogue: 0,0:21:49.43,0:21:51.28,Dial_JP,,0,0,0,,安達は笑うかな
Dialogue: 0,0:23:25.73,0:23:28.73,Dial_JP,,0,0,0,,イエーイ　カラオケもサウナも楽しかったすね
Dialogue: 0,0:23:28.73,0:23:29.48,Dial_JP,,0,0,0,,アダウチさん
Dialogue: 0,0:23:29.48,0:23:30.49,Dial_JP,,0,0,0,,仇討ち？
Dialogue: 0,0:23:30.49,0:23:31.92,Dial_JP,,0,0,0,,もはや苗字ですらねえ
Dialogue: 0,0:23:31.92,0:23:32.75,Dial_JP,,0,0,0,,あちこちさん？
Dialogue: 0,0:23:32.75,0:23:33.72,Dial_JP,,0,0,0,,あめとむちさん？
Dialogue: 0,0:23:33.72,0:23:34.80,Dial_JP,,0,0,0,,あべかわもちさん？
Dialogue: 0,0:23:34.80,0:23:36.31,Dial_JP,,0,0,0,,こいつ…
Dialogue: 0,0:23:36.31,0:23:37.81,Dial_JP,,0,0,0,,と苛立ちながら
Dialogue: 0,0:23:37.81,0:23:38.56,Dial_JP,,0,0,0,,次回
Dialogue: 0,0:23:38.56,0:23:39.63,Dial_JP,,0,0,0,,第４話
Dialogue: 0,0:00:35.60,0:00:36.93,OP_JP,,0,0,0,,{\fad(360,360)\blur3}拝啓
Dialogue: 0,0:00:37.48,0:00:40.52,OP_JP,,0,0,0,,{\fad(360,360)\blur3}ありきたりな日常
Dialogue: 0,0:00:40.52,0:00:46.11,OP_JP,,0,0,0,,{\fad(360,360)\blur3}ドラマのワンシーンに変わったあの日から
Dialogue: 0,0:00:46.61,0:00:50.15,OP_JP,,0,0,0,,{\fad(360,360)\blur3}揺れる心のときめきに
Dialogue: 0,0:00:50.15,0:00:54.12,OP_JP,,0,0,0,,{\fad(360,360)\blur3}気の利いた言葉が出てこないな
Dialogue: 0,0:00:55.33,0:00:58.04,OP_JP,,0,0,0,,{\fad(360,360)\blur3}考えたってわからない
Dialogue: 0,0:00:58.04,0:01:00.29,OP_JP,,0,0,0,,{\fad(360,360)\blur3}怖がったって進まない
Dialogue: 0,0:01:00.29,0:01:03.50,OP_JP,,0,0,0,,{\fad(360,360)\blur3}だけどはじめては全部
Dialogue: 0,0:01:03.50,0:01:06.67,OP_JP,,0,0,0,,{\fad(360,360)\blur3}君がいい
Dialogue: 0,0:01:07.92,0:01:13.18,OP_JP,,0,0,0,,{\fad(360,360)\blur3}逆らえない想いがここにあって
Dialogue: 0,0:01:13.18,0:01:17.97,OP_JP,,0,0,0,,{\fad(360,360)\blur3}絵空のような恋があって
Dialogue: 0,0:01:17.97,0:01:23.40,OP_JP,,0,0,0,,{\fad(360,360)\blur3}真っ直ぐで　不器用な　僕らのストーリー
Dialogue: 0,0:01:23.40,0:01:27.19,OP_JP,,0,0,0,,{\fad(360,360)\blur3}触れたい　聴きたい　もっと知りたい
Dialogue: 0,0:01:28.15,0:01:31.53,OP_JP,,0,0,0,,{\fad(360,360)\blur3}この想いはもう
Dialogue: 0,0:01:32.28,0:01:33.70,OP_JP,,0,0,0,,{\fad(360,360)\blur3}止まらないから
Dialogue: 0,0:05:11.61,0:05:17.25,Dial_JP2,,0,0,0,,{\fad(360,360)\blur3}逆らえない想いがここにあって
Dialogue: 0,0:05:17.25,0:05:22.18,Dial_JP2,,0,0,0,,{\fad(360,360)\blur3}絵空のような恋があって
Dialogue: 0,0:05:22.18,0:05:27.36,Dial_JP2,,0,0,0,,{\fad(360,360)\blur3}真っ直ぐで　不器用な　僕らのストーリー
Dialogue: 0,0:05:27.36,0:05:31.26,Dial_JP2,,0,0,0,,{\fad(360,360)\blur3}触れたい　聴きたい　もっと知りたい
