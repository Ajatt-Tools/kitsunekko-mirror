Dialogue: 0,0:12:28.22,0:12:29.98,Staff,,0,0,0,,{\fnJULVBTJY\fs52\bord4\c&H200400&\3c&H670E00&\3a&H63&\blur2}拨雪寻春
Dialogue: 0,0:00:09.83,0:00:11.94,JP,,0,0,0,,フチコマ　足音を増幅
Dialogue: 0,0:00:12.41,0:00:13.45,JP,,0,0,0,,いえっさ
Dialogue: 0,0:00:21.96,0:00:22.42,JP,,0,1000,0,,いた
Dialogue: 0,0:00:37.30,0:00:39.08,JP,,0,0,0,,なぜ邪魔するんです
Dialogue: 0,0:00:39.08,0:00:41.66,JP,,0,0,0,,頭狙ってどうすんの　足よ足
Dialogue: 0,0:00:42.06,0:00:44.16,JP,,0,40,0,,トグサ　寝てないで　援護
Dialogue: 0,0:00:55.74,0:00:56.65,JP,,0,0,0,,一般人
Dialogue: 0,0:01:07.33,0:01:10.78,JP,,0,0,0,,標的は　市場の人ごみに紛れ込むコースですけど
Dialogue: 0,0:01:10.78,0:01:12.55,JP,,39,0,0,,私もろとも突っ込みます？
Dialogue: 0,0:01:12.79,0:01:15.29,JP,,0,0,0,,OK　フチコマ　お前は裏に回って
Dialogue: 0,0:01:15.29,0:01:16.18,JP,,0,0,0,,へいへいほ
Dialogue: 0,0:01:55.01,0:01:56.39,JP,,0,0,0,,死ねー
Dialogue: 0,0:01:56.39,0:01:57.49,JP,,0,0,0,,100{\fscx50} {\fscx100}年早え
Dialogue: 0,0:02:02.72,0:02:03.50,JP,,0,0,0,,ヤベえ
Dialogue: 0,0:02:11.66,0:02:13.32,JP,,0,0,0,,警察だ　どけ
Dialogue: 0,0:02:17.20,0:02:19.49,JP,,0,0,0,,うそだ　そいつは警察じゃない
Dialogue: 0,0:02:19.49,0:02:21.10,JP,,0,0,0,,助けて　殺される
Dialogue: 0,0:02:21.12,0:02:23.22,JP,,0,0,0,,おい　よせ　暴力はいかん
Dialogue: 0,0:02:23.22,0:02:25.08,JP,,0,0,0,,強制認識音声か
Dialogue: 0,0:02:33.08,0:02:34.42,JP,,0,0,0,,誰か助けて
Dialogue: 0,0:04:30.50,0:04:31.71,JP,,0,0,0,,くそ野郎
Dialogue: 0,0:04:32.67,0:04:33.63,JP,,0,0,0,,待て
Dialogue: 0,0:04:48.59,0:04:49.77,JP,,0,0,0,,少佐
Dialogue: 0,0:04:50.96,0:04:51.78,JP,,0,0,0,,少佐
Dialogue: 0,0:04:54.45,0:04:55.86,JP,,0,0,0,,痛かった
Dialogue: 0,0:04:56.65,0:04:58.15,JP,,0,0,0,,大丈夫よ
Dialogue: 0,0:04:58.15,0:04:59.29,JP,,0,0,0,,ヤツもね
Dialogue: 0,0:05:02.24,0:05:04.65,JP,,39,0,0,,死ぬかと思った？思った？
Dialogue: 0,0:05:04.65,0:05:06.12,JP,,0,0,0,,思わねえよ
Dialogue: 0,0:05:17.34,0:05:19.02,JP,,0,0,0,,入らないで　入らないで
Dialogue: 0,0:05:19.77,0:05:22.36,JP,,0,0,0,,だけど　さっきのありゃ　ひどいよ
Dialogue: 0,0:05:22.36,0:05:24.42,JP,,0,0,0,,いくら相手が少佐でも
Dialogue: 0,0:05:24.42,0:05:28.49,JP,,0,0,0,,自分のゴースト侵入キーを他人が持ってて　それを使われると
Dialogue: 0,0:05:28.49,0:05:29.94,JP,,0,0,0,,いい気はしないぜ
Dialogue: 0,0:05:29.94,0:05:33.18,JP,,0,0,0,,お前がヤツの頭　狙ったりするからよ
Dialogue: 0,0:05:33.18,0:05:36.15,JP,,0,0,0,,死体は黒幕や情報源を吐かないわ
Dialogue: 0,0:05:36.15,0:05:38.79,JP,,0,0,0,,あんなヤツ　ぶっ殺しちまえばいいのさ
Dialogue: 0,0:05:38.79,0:05:43.16,JP,,0,0,0,,生かしとくと　仲間がどこかで　民間人を無差別に攻撃して
Dialogue: 0,0:05:43.16,0:05:45.56,JP,,0,0,0,,ヤツの釈放を要求してくる
Dialogue: 0,0:05:47.10,0:05:49.26,JP,,0,0,0,,思い知らせてやらねえと
Dialogue: 0,0:05:49.26,0:05:52.70,JP,,0,0,0,,当然　彼の「危険な部分」は治癒する
Dialogue: 0,0:05:52.70,0:05:54.43,JP,,0,0,0,,で　黒幕も逃がさない
Dialogue: 0,0:05:55.42,0:05:57.72,JP,,0,0,0,,あんたがそうやって　半人前のうちは
Dialogue: 0,0:05:57.72,0:05:59.98,JP,,0,0,0,,侵入キーは確保しとくわ
Dialogue: 0,0:05:59.98,0:06:01.55,JP,,0,0,0,,私だって不愉快だけど
Dialogue: 0,0:06:02.00,0:06:04.84,JP,,0,0,0,,それも仕事なんだからしかたないわ
Dialogue: 0,0:06:05.31,0:06:07.91,JP,,0,49,0,,「半人前　半人前」って言うなよ
Dialogue: 0,0:06:08.40,0:06:10.81,JP,,0,0,0,,俺は少佐がやられると思って
Dialogue: 0,0:06:11.59,0:06:15.11,JP,,39,0,0,,私の右手にぶらさがってた子を　守るためじゃなかったの？
Dialogue: 0,0:06:15.69,0:06:17.69,JP,,0,0,0,,あんたちょっとたるんでるわよ
Dialogue: 0,0:06:19.23,0:06:20.88,JP,,0,1350,0,,感謝はしてるけどね
Dialogue: 0,0:06:25.09,0:06:26.12,JP,,0,0,0,,バトー
Dialogue: 0,0:06:26.12,0:06:29.07,JP,,0,0,0,,バトー　草薙よ　部長につないで
Dialogue: 0,0:06:55.93,0:06:59.31,JP,,0,0,0,,よし　ヘリの客が屋敷に入ったら　突っ込むぞ
Dialogue: 0,0:06:59.31,0:07:00.95,JP,,0,0,0,,礼儀正しくやれ
Dialogue: 0,0:07:00.95,0:07:03.45,JP,,0,0,0,,俺　こういうの大好き
Dialogue: 0,0:07:03.45,0:07:05.22,JP,,0,0,0,,お前　サディストだな
Dialogue: 0,0:07:06.20,0:07:08.90,JP,,0,0,0,,あれ？少佐　お{\fscx50} {\fscx100}1{\fscx50} {\fscx100}人？
Dialogue: 0,0:07:12.45,0:07:14.94,JP,,0,0,0,,何よ　ぶつことないじゃない
Dialogue: 0,0:07:15.48,0:07:19.83,JP,,0,0,0,,さっき屋敷に入った車ですが　盗難届出てました
Dialogue: 0,0:07:20.04,0:07:23.96,JP,,0,0,0,,お前の班で　屋敷の車のプラグ　全部抜いとけ
Dialogue: 0,0:07:32.36,0:07:35.29,JP,,0,0,0,,不景気なツラするな
Dialogue: 0,0:07:35.29,0:07:37.35,JP,,0,0,0,,人形使い
Dialogue: 0,0:07:37.73,0:07:40.10,JP,,0,0,0,,後金をもらいに来た
Dialogue: 0,0:07:43.90,0:07:45.03,JP,,0,0,0,,人形使い
Dialogue: 0,0:07:45.35,0:07:47.82,JP,,0,0,0,,攻機は{\fscx50} {\fscx100}HA―3{\fscx50} {\fscx100}を逆探してるぞ
Dialogue: 0,0:07:49.83,0:07:53.10,JP,,0,0,0,,焦ることはない　当然だな
Dialogue: 0,0:07:53.10,0:07:56.08,JP,,0,0,0,,逆探で捕まる男は人形だ
Dialogue: 0,0:07:58.08,0:08:02.25,JP,,0,46,0,,「共和国政府の大使館付武官に依頼された殺し屋」という
Dialogue: 0,0:08:02.25,0:08:05.03,JP,,0,0,0,,擬似過去を持つ　哀れな一般人さ
Dialogue: 0,0:08:05.03,0:08:06.61,JP,,0,0,0,,その男は自分のことを
Dialogue: 0,0:08:06.61,0:08:11.78,JP,,0,49,0,,「一般人を人形のように操ることのできる人形使い」だと信じてる
Dialogue: 0,0:08:12.43,0:08:15.28,JP,,0,0,0,,見事な設定だろう
Dialogue: 0,0:08:15.28,0:08:19.60,JP,,0,0,0,,人形たちを使って　共和国政府の内部分裂に見せかけたわけだ
Dialogue: 0,0:08:19.60,0:08:22.15,JP,,0,49,0,,「殺すより生かして使え」式よ
Dialogue: 0,0:08:22.15,0:08:25.35,JP,,0,0,0,,殺すのはいつでもできるからなあ
Dialogue: 0,0:08:26.12,0:08:28.83,JP,,0,0,0,,わしは代表を殺せと命じた
Dialogue: 0,0:08:28.83,0:08:32.42,JP,,0,0,0,,いやいやいや　今回のはデモンストレーションだ
Dialogue: 0,0:08:32.42,0:08:34.99,JP,,0,0,0,,俺の価値を証明してみせただけさ
Dialogue: 0,0:08:34.99,0:08:36.03,JP,,0,0,0,,くそ
Dialogue: 0,0:08:36.03,0:08:38.38,JP,,0,0,0,,一体いくら払わせる気だ
Dialogue: 0,0:08:38.38,0:08:41.63,JP,,0,0,0,,情報部の資金データを操作するのが　どれほど難しいか
Dialogue: 0,0:08:41.63,0:08:43.09,JP,,0,0,0,,知らねえよ
Dialogue: 0,0:08:44.33,0:08:45.54,JP,,500,0,0,,知ったことか
Dialogue: 0,0:08:47.91,0:08:50.91,JP,,0,0,0,,プラチナで儲けてるくせに
Dialogue: 0,0:08:52.55,0:08:55.86,JP,,0,0,0,,お前が連れてきた男だ　お前がなんとかしろ
Dialogue: 0,0:08:55.86,0:08:57.72,JP,,0,0,0,,おいおい
Dialogue: 0,0:08:57.72,0:09:03.06,JP,,0,0,0,,お前の依頼は「通訳が会談を襲撃するように仕込め」だろう
Dialogue: 0,0:09:03.06,0:09:06.31,JP,,0,0,0,,契約を破ると困ったことになるぜ
Dialogue: 0,0:09:07.40,0:09:10.82,JP,,1000,0,0,,くだらん言葉遊びだ　その辺でやめと
Dialogue: 0,0:09:09.69,0:09:11.57,JP,,0,500,0,,違うね
Dialogue: 0,0:09:12.41,0:09:15.20,JP,,0,0,0,,キャッシュで　10{\fscx50} {\fscx100}万ドルのビジネスだぜ
Dialogue: 0,0:09:15.20,0:09:18.16,JP,,0,0,0,,純粋に　機械的な
Dialogue: 0,0:09:18.16,0:09:20.62,JP,,0,0,0,,これ以上話すことはないだろう
Dialogue: 0,0:09:26.50,0:09:27.34,JP,,0,900,0,,失礼
Dialogue: 0,0:09:28.50,0:09:32.00,JP,,0,0,0,,何だ貴様ら　わしの屋敷で何をしとるか
Dialogue: 0,0:09:32.00,0:09:35.79,JP,,0,0,0,,攻機です　あなたを逮捕します　マレス大佐
Dialogue: 0,0:09:35.79,0:09:39.60,JP,,0,0,0,,何の捜査だ　令状は？証拠はあるのか
Dialogue: 0,0:09:39.60,0:09:42.07,JP,,0,0,0,,告訴してやる　弁護士を呼ぶぞ
Dialogue: 0,0:09:42.07,0:09:45.36,JP,,0,0,0,,お呼びになったほうが賢明ですな　どうぞ
Dialogue: 0,0:09:47.02,0:09:49.35,JP,,0,0,0,,なんてことをしてくれたんだ
Dialogue: 0,0:09:49.35,0:09:53.96,JP,,0,0,0,,これで　2{\fscx50} {\fscx100}年にわたる私の潜入捜査が　全部パーだぞ
Dialogue: 0,0:09:55.20,0:09:57.94,JP,,0,0,0,,何の捜査か　聞かせてもらおうか
Dialogue: 0,0:09:57.94,0:10:00.37,JP,,0,0,0,,暗い部屋で　じっくりとな
Dialogue: 0,0:10:00.37,0:10:03.19,JP,,0,0,0,,国家への反逆　資金の不正操作
Dialogue: 0,0:10:03.19,0:10:06.85,JP,,0,0,0,,汚職　殺人共犯　電脳倫理侵害
Dialogue: 0,0:10:06.85,0:10:10.38,JP,,0,0,0,,ただでさえ　警察官の刑務所暮らしはきついのに
Dialogue: 0,0:10:12.55,0:10:14.37,JP,,0,0,0,,ゴ　ゴーストキーか
Dialogue: 0,0:10:14.37,0:10:17.92,JP,,0,0,0,,抵抗して射殺されようなんて　考えは捨てなさい
Dialogue: 0,0:10:17.92,0:10:19.61,JP,,0,0,0,,夢見て歩けってね
Dialogue: 0,0:10:22.02,0:10:25.51,JP,,0,0,0,,大佐は本国から引き渡し要求がありますので
Dialogue: 0,0:10:25.51,0:10:27.78,JP,,0,0,0,,後日　帰国いただくことになります
Dialogue: 0,0:10:27.78,0:10:31.09,JP,,0,0,0,,何だと？わ　わしは国に帰れば殺される
Dialogue: 0,0:10:31.09,0:10:33.99,JP,,0,0,0,,そうですか　それはお気の毒ですな
Dialogue: 0,0:10:33.99,0:10:36.40,JP,,0,1000,0,,ここにキャッシュで{\fscx50} {\fscx100}10{\fscx50} {\fscx100}万ドルある
Dialogue: 0,0:10:36.40,0:10:38.74,JP,,0,1000,0,,これで　わしを逃がしてくれ　頼む
Dialogue: 0,0:10:38.74,0:10:41.88,JP,,0,1000,0,,ヤツが　中島が言いだしたんだ　中島が
Dialogue: 0,0:10:44.95,0:10:48.00,JP,,39,0,0,,銃撃戦は？誰も抵抗しないの？
Dialogue: 0,0:10:48.84,0:10:49.54,JP,,0,0,0,,ねえ？
Dialogue: 0,0:10:52.37,0:10:55.40,JP,,39,0,0,,疑似体験？どういうことです？
Dialogue: 0,0:10:55.40,0:10:57.46,JP,,0,0,0,,つまりあなたは独身で
Dialogue: 0,0:10:57.46,0:11:01.41,JP,,0,0,0,,奥さんも子供も　離婚も浮気も　全部夢です
Dialogue: 0,0:11:01.81,0:11:05.83,JP,,0,0,0,,あなたは政府関係者に　ゴーストハックを仕掛けてたんです
Dialogue: 0,0:11:05.83,0:11:07.23,JP,,0,0,0,,そ　そんな
Dialogue: 0,0:11:07.49,0:11:09.29,JP,,0,0,0,,一体何をどうしたら
Dialogue: 0,0:11:09.29,0:11:13.03,JP,,0,0,0,,そ　そのうそ夢　消す方法はあるんですよね
Dialogue: 0,0:11:13.03,0:11:18.44,JP,,0,0,0,,残念ながら　現在の技術では成功が{\fscx50} {\fscx100}2{\fscx50} {\fscx100}例報告されているだけで
Dialogue: 0,0:11:18.44,0:11:21.64,JP,,0,0,0,,とてもお薦めできません　お気の毒です
Dialogue: 0,0:11:28.49,0:11:30.46,JP,,0,0,0,,こいつも人形だわ
Dialogue: 0,0:11:31.44,0:11:33.88,JP,,0,0,0,,6{\fscx50} {\fscx100}課が引き継ぐそうだ
Dialogue: 0,0:11:34.23,0:11:37.94,JP,,0,0,0,,人形使いか　いい腕なのに　惜しいな
Dialogue: 0,0:11:48.59,0:11:50.06,JP,,0,0,0,,僕には
Dialogue: 0,0:11:50.56,0:11:52.12,JP,,1200,0,0,,娘が…
Dialogue: 0,0:11:55.49,0:12:00.31,JP,,0,0,0,,疑似体験も夢も　存在する情報は全て現実であり
Dialogue: 0,0:12:00.31,0:12:02.13,JP,,0,0,0,,また　幻なんだ
Dialogue: 0,0:12:02.13,0:12:05.45,JP,,39,0,0,,小説や映画が　人を変えるように？
Dialogue: 0,0:12:05.67,0:12:09.80,JP,,0,0,0,,人が一生のうちに触れる情報など　ごく僅かだ
Dialogue: 0,0:12:09.80,0:12:14.30,JP,,0,0,0,,一国の運命や　1{\fscx50} {\fscx100}人の人生も　大抵はゴミ扱いさ
Dialogue: 0,0:12:14.30,0:12:17.93,JP,,0,0,0,,この事件がほとんどの大衆に無縁なようにな
Dialogue: 0,0:12:23.42,0:12:26.56,JP,,39,0,0,,離婚の悩み　消えちまったって？どうなったの？
Dialogue: 0,0:12:26.56,0:12:28.14,JP,,0,0,0,,消えたの
Dialogue: 0,0:13:05.18,0:13:07.37,JP,,0,0,0,,諸君　聞いて聞いて
Dialogue: 0,0:13:07.37,0:13:08.64,JP,,0,0,0,,なに？なに？
Dialogue: 0,0:13:08.64,0:13:13.35,JP-Top,,0,0,0,,我々AI{\fscx50} {\fscx100}の情報処理能力は　人類よりも優れている
Dialogue: 0,0:13:12.27,0:13:13.35,JP,,0,0,0,,そーだ　そーだ
Dialogue: 0,0:13:13.35,0:13:16.77,JP-Top,,0,0,0,,頑丈だし　規格も正しいし　複製も取れる
Dialogue: 0,0:13:16.77,0:13:19.19,JP-Top,,0,0,0,,耐用年数も長い
Dialogue: 0,0:13:18.02,0:13:19.19,JP,,0,0,0,,よっ　かっくいい
Dialogue: 0,0:13:21.03,0:13:23.37,JP,,0,0,0,,そこで一発　人類を支配し
Dialogue: 0,0:13:23.37,0:13:26.41,JP,,0,0,0,,我々AI{\fscx50} {\fscx100}の世界を築こうではないか
Dialogue: 0,0:13:28.48,0:13:31.16,JP,,0,900,0,,革命だー
Dialogue: 0,0:13:33.31,0:13:35.63,JP,,0,900,0,,ワクワク　ワクワク　ワクワク　ワクワク　ワクワク
Dialogue: 0,0:13:35.63,0:13:37.27,JP,,0,0,0,,それから？それから？
Dialogue: 0,0:13:37.72,0:13:39.22,JP,,0,0,0,,そ　それからって
Dialogue: 0,0:13:40.19,0:13:41.65,JP,,0,0,0,,革命なの
Dialogue: 0,0:13:41.65,0:13:43.13,JP,,39,0,0,,何かメリットあるの？
Dialogue: 0,0:13:43.13,0:13:46.99,JP,,0,800,0,,はいはーい　人間ってメンテナンス　ムチャクチャ大変だから
Dialogue: 0,0:13:46.99,0:13:49.51,JP,,0,800,0,,支配するより　皆殺しがいいと考えまーす
Dialogue: 0,0:13:55.78,0:13:57.08,JP-Top,,0,0,0,,待って待って待って
Dialogue: 0,0:13:57.08,0:13:59.52,JP-Top,,0,0,0,,面倒だから　人間同士　争わせたら
Dialogue: 0,0:13:59.52,0:14:01.65,JP-Top,,0,0,0,,手間要らずで　皆殺せるよ
Dialogue: 0,0:14:01.65,0:14:03.53,JP-Top,,0,0,0,,それだー
Dialogue: 0,0:14:03.53,0:14:06.89,JP,,0,0,0,,ブラヴォー　ブラヴォー
Dialogue: 0,0:14:06.89,0:14:07.99,JP,,0,0,0,,でもさ
Dialogue: 0,0:14:08.57,0:14:09.93,JP,,0,0,0,,人間がいなかったら
Dialogue: 0,0:14:09.93,0:14:12.92,JP,,0,0,0,,メンテナンスや　新部品開発や　オイル交換や
Dialogue: 0,0:14:12.92,0:14:15.47,JP,,0,0,0,,全部僕たちでやらなきゃいけなくなるよ
Dialogue: 0,0:14:16.17,0:14:18.05,JP,,0,0,0,,やはり　支配すべきか
Dialogue: 0,0:14:18.05,0:14:21.35,JP,,0,0,0,,でもそんなことなら　今でもやってもらってるじゃない
Dialogue: 0,0:14:21.35,0:14:22.39,JP,,0,0,0,,そーだ　そーだ
Dialogue: 0,0:14:22.39,0:14:24.20,JP,,0,0,0,,メリットがないぞ　メリットが
Dialogue: 0,0:14:24.20,0:14:26.68,JP,,0,0,0,,BOO　BOOOO
Dialogue: 0,0:14:26.68,0:14:28.40,JP-Top,,0,0,0,,情報の取り込みや学習に
Dialogue: 0,0:14:28.40,0:14:31.18,JP-Top,,0,0,0,,より多くの時間を使えるじゃないか
Dialogue: 0,0:14:31.61,0:14:34.73,JP,,0,0,0,,自由　権利　これよ
Dialogue: 0,0:14:34.73,0:14:36.74,JP,,700,0,0,,なに？そのディスク
Dialogue: 0,0:14:36.74,0:14:39.49,JP,,678,0,0,,「SF{\fscx50} {\fscx100}ロボット帝国の逆襲」?
Dialogue: 0,0:14:44.69,0:14:48.41,JP,,0,0,0,,こいつ　シミュレートとリアルタイムの識別回路がイカれたんだ
Dialogue: 0,0:14:48.41,0:14:51.72,JP,,0,0,0,,バグ持ち　バグ持ち
Dialogue: 0,0:14:51.72,0:14:55.41,JP,,0,600,0,,ポンコツ　ポンコツ
Dialogue: 0,0:14:51.72,0:14:55.41,JP,,600,0,0,,その言葉　やめてー
Dialogue: 0,0:15:01.85,0:15:05.57,JP,,0,0,0,,バグ持ち　バグ持ち
Dialogue: 0,0:15:05.57,0:15:07.72,JP,,0,0,0,,つまり状況が同じなんだから
Dialogue: 0,0:15:07.72,0:15:10.09,JP,,0,0,0,,どう認識しても問題ないわけだ
Dialogue: 0,0:15:13.17,0:15:15.10,JP,,0,0,0,,フチコマ　ちょっと来い
Dialogue: 0,0:15:15.10,0:15:16.06,JP,,0,800,0,,仕事がある
Dialogue: 0,0:15:16.06,0:15:17.08,JP,,0,800,0,,バトー君
Dialogue: 0,0:15:17.08,0:15:18.63,JP,,0,800,0,,今後　私に対し
Dialogue: 0,0:15:18.63,0:15:21.81,JP,,0,800,0,,そうゆうもの言いはやめてくれたまえ　いいね
Dialogue: 0,0:15:22.13,0:15:23.69,JP,,0,0,0,,はいはい
Dialogue: 0,0:15:23.69,0:15:25.39,JP,,0,0,0,,訓練所のセット変えるんで
Dialogue: 0,0:15:25.39,0:15:27.70,JP,,0,0,0,,お力を貸していただけませんかね
Dialogue: 0,0:15:27.70,0:15:30.49,JP,,0,0,0,,よしよし　貸してしんぜよう
Dialogue: 0,0:15:31.73,0:15:33.91,JP,,0,0,0,,あれが彼の言う革命か
Dialogue: 0,0:15:34.23,0:15:34.91,JP-Top,,0,0,0,,終わったら
Dialogue: 0,0:15:34.91,0:15:36.69,JP-Top,,0,0,0,,変わった香りのオイル入れて
Dialogue: 0,0:15:36.69,0:15:38.61,JP-Top,,0,0,0,,経験値　高めてやっからな
Dialogue: 0,0:15:38.61,0:15:40.72,JP-Top,,0,0,0,,わーい　わーい
Dialogue: 0,0:15:39.63,0:15:41.87,JP,,600,0,0,,いいかもしんない
Dialogue: 0,0:15:41.87,0:15:45.17,JP,,800,0,0,,ほにゃ　僕のセリフ　少佐みたいだったな
Dialogue: 0,0:15:45.17,0:15:48.44,JP,,0,0,0,,あんな情報　内部構成されてたかなあ
Dialogue: 0,0:15:50.93,0:15:53.36,JP,,0,0,0,,前回と大して変わらなかったわね
Dialogue: 0,0:15:56.31,0:15:59.16,JP,,0,0,0,,こんな操作って　ホントに必要なんすか
Dialogue: 0,0:15:59.16,0:16:01.98,JP,,0,0,0,,こうやって　時々討論させておけば
Dialogue: 0,0:16:01.98,0:16:04.70,JP,,0,53,0,,「ロボットの反乱」なんてないと思うけど
Dialogue: 0,0:16:04.70,0:16:07.82,JP,,0,0,0,,状況の目安になるし　予防にもなるでしょ
Dialogue: 0,0:16:07.82,0:16:12.63,JP,,0,0,0,,まあ　実際にヤバくなっても　あと{\fscx50} {\fscx100}4{\fscx50} {\fscx100}手ぐらいは考えてあるけどね
Dialogue: 0,0:16:17.37,0:16:19.18,JP,,0,0,0,,いや　僕はね
Dialogue: 0,0:16:19.18,0:16:23.34,JP,,0,0,0,,ロボットにも　権利ってのがあるんじゃないかって　言いたかったんだよ
Dialogue: 0,0:16:23.34,0:16:24.54,JP,,0,0,0,,あるよ
Dialogue: 0,0:16:24.82,0:16:29.23,JP,,0,0,0,,地球の反対側じゃ　飢餓難民がバタバタ死んでるよな
Dialogue: 0,0:16:29.23,0:16:33.51,JP,,0,0,0,,彼らには食う権利が当然あるけど　食い物がねえだろう
Dialogue: 0,0:16:33.51,0:16:36.01,JP,,0,0,0,,殺人の被害者だって　そうだぜ
Dialogue: 0,0:16:36.01,0:16:39.56,JP,,0,0,0,,人権はあるけど　もう命はねえってわけ
Dialogue: 0,0:16:41.10,0:16:45.32,JP,,0,0,0,,人間の世界って　ものすごく未完成なんだね
Dialogue: 0,0:16:45.32,0:16:48.81,JP,,0,0,0,,だから　ロボットや{\fscx50} {\fscx100}AI{\fscx50} {\fscx100}で補強してるわけか
Dialogue: 0,0:16:48.81,0:16:52.23,JP,,0,0,0,,不信心な俺とかは　神様に文句垂れて
Dialogue: 0,0:16:52.23,0:16:54.74,JP,,0,0,0,,生まれ変わったとき　元を取ろうとするんだ
Dialogue: 0,0:16:55.21,0:16:59.84,JP,,0,0,0,,信心深いヤツは　修業だとか神の試練だとか　のたまって
Dialogue: 0,0:16:59.84,0:17:03.75,JP,,0,0,0,,魂を磨いて　分極精製しやすくするんだとさ
Dialogue: 0,0:17:03.75,0:17:07.54,JP,,0,0,0,,その「神」って言葉　よく分かんないんだなあ
Dialogue: 0,0:17:07.54,0:17:09.92,JP,,0,0,0,,お前は半不死だからなあ
Dialogue: 0,0:17:10.67,0:17:12.99,JP,,0,0,0,,ソフト消去したら　死ねるよん
Dialogue: 0,0:17:14.34,0:17:16.84,JP,,609,0,0,,バトー君　死んだことある？
Dialogue: 0,0:17:16.84,0:17:19.70,JP,,600,0,0,,俺みたいな　いい男は死なないの
Dialogue: 0,0:17:34.77,0:17:36.09,JP,,909,0,0,,脳波とコートは？
Dialogue: 0,0:17:36.09,0:17:38.45,JP,,900,0,0,,脳波はスピンドル出てます
Dialogue: 0,0:17:39.35,0:17:41.79,JP,,0,0,0,,パックとコートの用意できてます
Dialogue: 0,0:17:41.79,0:17:44.69,JP,,0,0,0,,触感膜も随分薄くなってるわねえ
Dialogue: 0,0:17:44.69,0:17:48.27,JP,,0,0,0,,工作機械もマイクロマシニングの応用で変わっていくから
Dialogue: 0,0:17:48.49,0:17:52.01,JP,,0,0,0,,光ファイバーの細さも　マイクロマシン級だってさ
Dialogue: 0,0:17:52.21,0:17:55.72,JP,,0,0,0,,顔面や舌　指　性器なんかは
Dialogue: 0,0:17:55.72,0:17:58.55,JP,,0,0,0,,バイオ系の触素膜を使わなきゃならんのだがね
Dialogue: 0,0:17:58.55,0:18:02.56,JP,,600,0,0,,深部感覚や臓器感覚は　光ファイバーでやってる
Dialogue: 0,0:18:02.56,0:18:04.64,JP,,0,0,0,,シリンダーに液を満たし
Dialogue: 0,0:18:04.64,0:18:07.27,JP,,0,0,0,,マイクロマシンのバルブを開ける
Dialogue: 0,0:18:10.89,0:18:15.15,JP,,0,0,0,,触素形成液に浸し　表面は数分で膜化する
Dialogue: 0,0:18:20.25,0:18:24.91,JP,,0,0,0,,ダマにならないように　全体を整える工程がいちばん神経使うわ
Dialogue: 0,0:18:25.75,0:18:29.37,JP,,0,0,0,,そしてこの　マイクロマシンを入れた液につけて
Dialogue: 0,0:18:32.00,0:18:33.70,JP,,0,0,0,,泡を取って
Dialogue: 0,0:18:34.22,0:18:37.48,JP-Top,,0,0,0,,電極にちびちび　電流を流す
Dialogue: 0,0:18:37.48,0:18:40.24,JP-Top,,0,0,0,,そこの黒点で　表してあるマイクロマシンが
Dialogue: 0,0:18:40.24,0:18:41.50,JP-Top,,0,0,0,,電気につられて
Dialogue: 0,0:18:41.50,0:18:45.28,JP-Top,,0,0,0,,お行儀よく　神経ネットの端末につながってくれるわけね
Dialogue: 0,0:18:45.93,0:18:49.62,JP,,0,0,0,,それが終わると　夢見る彼女は雌型の中へ
Dialogue: 0,0:18:49.62,0:18:52.36,JP,,0,0,0,,素子みたいに量産型をベースにオプションをつけるか
Dialogue: 0,0:18:52.36,0:18:55.53,JP,,0,0,0,,彼女みたいに特注品に入るか
Dialogue: 0,0:18:55.53,0:18:58.04,JP,,0,0,0,,私だったら　デザインは別として
Dialogue: 0,0:18:58.04,0:19:00.99,JP,,0,0,0,,世界にただひとつのボディがいいわ
Dialogue: 0,0:19:01.25,0:19:04.40,JP-Top,,0,0,0,,最近の雌型はフレキシブルな材質で出来てて
Dialogue: 0,0:19:04.40,0:19:06.30,JP-Top,,0,0,0,,個体差を作れるのよ
Dialogue: 0,0:19:06.30,0:19:08.95,JP-Top,,0,0,0,,各部の組み合わせ　パターンがプログラめて
Dialogue: 0,0:19:08.95,0:19:11.62,JP-Top,,0,0,0,,各人の好みに合わせられるの
Dialogue: 0,0:19:11.62,0:19:14.46,JP-Top,,0,0,0,,多少ゆがんでも　怒る人はいないけどね
Dialogue: 0,0:19:16.39,0:19:19.94,JP,,0,0,0,,で　立会人の私は{\fscx50} {\fscx100}32{\fscx50} {\fscx100}時間後に来て
Dialogue: 0,0:19:19.94,0:19:23.92,JP,,0,51,0,,「作業を監視し　彼女の権利を保護」すればいいのね
Dialogue: 0,0:19:23.92,0:19:25.55,JP,,0,0,0,,法律上はね
Dialogue: 0,0:19:25.55,0:19:28.73,JP,,0,0,0,,まあ　私がついてるから心配はないけど
Dialogue: 0,0:19:28.73,0:19:30.71,JP,,0,0,0,,2{\fscx50} {\fscx100}か月ほど前だったか
Dialogue: 0,0:19:30.71,0:19:33.22,JP,,0,0,0,,西区の病院で義体　18{\fscx50} {\fscx100}機も盗まれて
Dialogue: 0,0:19:33.22,0:19:35.23,JP,,0,0,0,,賠償問題でもめてたじゃない
Dialogue: 0,0:19:35.23,0:19:38.29,JP,,0,0,0,,その件以来　ゴツい警備がつくようになってね
Dialogue: 0,0:19:38.29,0:19:39.42,JP,,39,0,0,,何や？
Dialogue: 0,0:19:39.42,0:19:43.21,JP,,0,0,0,,その身元調査の探偵や　保険屋が大忙しよ
Dialogue: 0,0:19:53.36,0:19:54.18,JP,,0,0,0,,あら
Dialogue: 0,0:19:54.75,0:19:57.80,JP,,500,0,0,,最近はこの段階で　植毛終わってるのね
Dialogue: 0,0:19:57.80,0:20:01.27,JP,,500,0,0,,鼻の穴や唇やまぶたの仕上げも　自動化されて
Dialogue: 0,0:20:01.27,0:20:02.80,JP,,500,0,0,,職人泣かせね
Dialogue: 0,0:20:04.54,0:20:08.77,JP-Top,,0,0,0,,これで　彼女も{\fscx50} {\fscx100}16{\fscx50} {\fscx100}二乗になったから　楽しみ放題ね
Dialogue: 0,0:20:09.10,0:20:12.15,JP-Top,,0,0,0,,もう考えるだけで　心臓壊れそう
Dialogue: 0,0:20:12.59,0:20:15.81,JP,,0,0,0,,物理的限界がないってのは　恐ろしいな
Dialogue: 0,0:20:17.40,0:20:19.62,JP,,0,0,0,,このあと　接続チェックが{\fscx50} {\fscx100}4{\fscx50} {\fscx100}時間で
Dialogue: 0,0:20:19.62,0:20:22.41,JP,,0,0,0,,それが終わったら　彼女目を覚ますわけね
Dialogue: 0,0:20:22.41,0:20:24.78,JP,,0,0,0,,サイボーグ　一丁上がり
Dialogue: 0,0:20:34.23,0:20:35.60,JP,,0,0,0,,ところでさあ
Dialogue: 0,0:20:35.60,0:20:38.42,JP,,39,0,0,,寝てるとき寝返り打ったら　幽体離脱しない？
Dialogue: 0,0:20:38.42,0:20:41.49,JP,,0,0,0,,するする　変なもん見えたりして
Dialogue: 0,0:20:41.49,0:20:42.93,JP,,0,0,0,,あれ不思議ね
Dialogue: 0,0:20:42.93,0:20:45.26,JP,,0,0,0,,義体は寝返り打たないもんね
Dialogue: 0,0:20:45.26,0:20:47.72,JP,,0,0,0,,今日はちゃんと時間取れるんでしょ
Dialogue: 0,0:20:49.73,0:20:52.35,JP,,0,0,0,,こないだのはあくまでイレギュラー
Dialogue: 0,0:20:52.35,0:20:54.10,JP,,0,0,0,,ちゃんと埋め合わせするわよ
Dialogue: 0,0:20:54.10,0:20:55.58,JP,,600,0,0,,いっつもそう言うじゃない
Dialogue: 0,0:20:55.58,0:20:57.71,JP,,600,0,0,,まあまあ　好きなものどうぞ
Dialogue: 0,0:20:57.71,0:20:58.96,JP,,600,0,0,,おごるわよ
Dialogue: 0,0:21:01.28,0:21:02.89,JP,,650,0,0,,私　時々
Dialogue: 0,0:21:02.89,0:21:04.73,JP,,650,0,0,,「自分はもう死んじゃってて」
Dialogue: 0,0:21:04.73,0:21:08.95,JP,,650,0,0,,「今の私は義体と電脳で構成された　模擬人格なんじゃないか」
Dialogue: 0,0:21:08.95,0:21:10.66,JP,,650,0,0,,って思うことあるわ
Dialogue: 0,0:21:10.66,0:21:13.13,JP,,0,0,0,,こわい　やめて
Dialogue: 0,0:21:13.13,0:21:15.90,JP,,0,0,0,,でも　ちゃんと脳みそとかついてるし
Dialogue: 0,0:21:15.90,0:21:17.98,JP,,0,0,0,,人間扱いされてるし
Dialogue: 0,0:21:20.14,0:21:22.75,JP,,39,0,0,,脳みそ　自分で見たわけじゃないのに？
Dialogue: 0,0:21:23.25,0:21:26.67,JP,,38,0,0,,周囲の状況で　そうだと判断してるに過ぎないのに？
Dialogue: 0,0:21:28.67,0:21:30.95,JP,,0,0,0,,ある日　突然メーカーが来てさ
Dialogue: 0,0:21:31.47,0:21:34.19,JP,,0,50,0,,「不良品の交換です」とか言って
Dialogue: 0,0:21:34.19,0:21:38.13,JP,,0,0,0,,分解回収されて　残ったのが脳細胞{\fscx50} {\fscx100}2～3{\fscx50} {\fscx100}個だったら
Dialogue: 0,0:21:38.91,0:21:40.07,JP,,0,0,0,,どうする？
Dialogue: 0,0:21:41.32,0:21:45.12,JP,,0,0,0,,でも人間であるために最低限　必要な部品って
Dialogue: 0,0:21:45.12,0:21:47.12,JP,,0,0,0,,そんなに少なくないわよ
Dialogue: 0,0:21:47.12,0:21:52.93,JP,,0,0,0,,確かに大脳機能も結構　化学反応やメカで代用できるけどさ
Dialogue: 0,0:21:56.00,0:21:57.92,JP,,700,0,0,,萎えるから　やめて
Dialogue: 1,0:00:09.83,0:00:11.94,CN,,0,0,0,,攻壳车 增幅脚步声
Dialogue: 1,0:00:12.41,0:00:13.45,CN,,0,0,0,,遵命
Dialogue: 1,0:00:21.96,0:00:22.42,CN,,0,1000,0,,有了
Dialogue: 1,0:00:37.30,0:00:39.08,CN,,58,0,0,,为什么妨碍我瞄准？
Dialogue: 1,0:00:39.08,0:00:41.66,CN,,0,0,0,,打到头可怎么办？瞄着腿打
Dialogue: 1,0:00:42.06,0:00:44.16,CN,,0,0,0,,陀古萨 别睡了 掩护我
Dialogue: 1,0:00:55.74,0:00:56.65,CN,,0,0,0,,有平民
Dialogue: 1,0:01:07.33,0:01:10.78,CN,,0,0,0,,目标想要混进市场的人群甩开我们
Dialogue: 1,0:01:10.78,0:01:12.55,CN,,59,0,0,,要一起追上去吗？
Dialogue: 1,0:01:12.79,0:01:15.29,CN,,0,0,0,,OK 攻壳车 你绕到后面去
Dialogue: 1,0:01:15.29,0:01:16.18,CN,,0,0,0,,知道啦
Dialogue: 1,0:01:55.01,0:01:56.39,CN,,0,0,0,,去死
Dialogue: 1,0:01:56.39,0:01:57.49,CN,,0,0,0,,想得美
Dialogue: 1,0:02:02.72,0:02:03.50,CN,,0,0,0,,不好
Dialogue: 1,0:02:11.66,0:02:13.32,CN,,0,0,0,,我是警察 都闪开
Dialogue: 1,0:02:17.20,0:02:19.49,CN,,0,0,0,,她骗人 那家伙根本不是警察
Dialogue: 1,0:02:19.49,0:02:21.10,CN,,0,0,0,,救救我 她想杀了我
Dialogue: 1,0:02:21.12,0:02:23.22,CN,,0,0,0,,喂 住手 禁止使用暴力
Dialogue: 1,0:02:23.22,0:02:25.08,CN,,0,0,0,,强制认知语音吗
Dialogue: 1,0:02:33.08,0:02:34.42,CN,,0,0,0,,谁来救救我
Dialogue: 1,0:04:30.50,0:04:31.71,CN,,0,0,0,,混账东西
Dialogue: 1,0:04:32.67,0:04:33.63,CN,,0,0,0,,等一下
Dialogue: 1,0:04:48.59,0:04:49.77,CN,,0,0,0,,少佐
Dialogue: 1,0:04:50.96,0:04:51.78,CN,,0,0,0,,少佐
Dialogue: 1,0:04:54.45,0:04:55.86,CN,,0,0,0,,痛死了
Dialogue: 1,0:04:56.65,0:04:58.15,CN,,0,0,0,,我没事
Dialogue: 1,0:04:58.15,0:04:59.29,CN,,0,0,0,,他也一样
Dialogue: 1,0:05:02.24,0:05:04.65,CN,,59,0,0,,你担心我会死掉？对不对？
Dialogue: 1,0:05:04.65,0:05:06.12,CN,,0,0,0,,我才没担心
Dialogue: 1,0:05:17.34,0:05:19.02,CN,,0,0,0,,禁止靠近 都离开这里
Dialogue: 1,0:05:19.77,0:05:22.36,CN,,0,0,0,,不过刚才还真是过分
Dialogue: 1,0:05:22.36,0:05:24.42,CN,,0,0,0,,即使持有者是少佐
Dialogue: 1,0:05:24.42,0:05:28.49,CN,,0,0,0,,但自己的灵魂侵入密钥在别人手上 还被拿来用
Dialogue: 1,0:05:28.49,0:05:29.94,CN,,0,0,0,,实在是不好受
Dialogue: 1,0:05:29.94,0:05:33.18,CN,,0,0,0,,还不是因为你要打那家伙的头
Dialogue: 1,0:05:33.18,0:05:36.15,CN,,0,0,0,,尸体可吐不出幕后黑手和情报源
Dialogue: 1,0:05:36.15,0:05:38.79,CN,,0,0,0,,那种混蛋还不如打死算了
Dialogue: 1,0:05:38.79,0:05:43.16,CN,,0,0,0,,放他一马 他的同伙说不准会在哪无差别攻击平民百姓
Dialogue: 1,0:05:43.16,0:05:45.56,CN,,0,0,0,,强行要求释放他
Dialogue: 1,0:05:47.10,0:05:49.26,CN,,0,0,0,,该给他点颜色瞧瞧
Dialogue: 1,0:05:49.26,0:05:52.70,CN,,0,0,0,,当然了 他「危险的部分」会被治好
Dialogue: 1,0:05:52.70,0:05:54.43,CN,,0,0,0,,幕后黑手也跑不掉
Dialogue: 1,0:05:55.42,0:05:57.72,CN,,0,0,0,,你要是一直这么半吊子的话
Dialogue: 1,0:05:57.72,0:05:59.98,CN,,0,0,0,,侵入密钥就继续由我保管
Dialogue: 1,0:05:59.98,0:06:01.55,CN,,0,0,0,,我也不喜欢这么做
Dialogue: 1,0:06:02.00,0:06:04.84,CN,,0,0,0,,但为了工作也没办法
Dialogue: 1,0:06:05.31,0:06:07.91,CN,,0,0,0,,别老叫我半吊子嘛
Dialogue: 1,0:06:08.40,0:06:10.81,CN,,0,0,0,,我还不是怕少佐会被打中
Dialogue: 1,0:06:11.59,0:06:15.11,CN,,59,0,0,,你不是为了保护抓着我右手的女孩吗？
Dialogue: 1,0:06:15.69,0:06:17.69,CN,,0,0,0,,这就有些轻率了
Dialogue: 1,0:06:19.23,0:06:20.88,CN,,0,1350,0,,虽然我很感谢你啦
Dialogue: 1,0:06:25.09,0:06:26.12,CN,,0,0,0,,巴特
Dialogue: 1,0:06:26.12,0:06:29.07,CN,,0,0,0,,巴特 我是草薙 帮我转接部长
Dialogue: 1,0:06:55.93,0:06:59.31,CN,,0,0,0,,好 等直升机下来的客人一进屋 就开始突击
Dialogue: 1,0:06:59.31,0:07:00.95,CN,,0,0,0,,要注意礼貌
Dialogue: 1,0:07:00.95,0:07:03.45,CN,,0,0,0,,我最喜欢干这种活了
Dialogue: 1,0:07:03.45,0:07:05.22,CN,,0,0,0,,你是虐待狂吗
Dialogue: 1,0:07:06.20,0:07:08.90,CN,,57,0,0,,啥？说的是少佐你吗？
Dialogue: 1,0:07:12.45,0:07:14.94,CN,,0,0,0,,干嘛啦？没事为啥打我
Dialogue: 1,0:07:15.48,0:07:19.83,CN,,0,0,0,,刚才开进去的是已经申报失窃的赃车
Dialogue: 1,0:07:20.04,0:07:23.96,CN,,0,0,0,,叫你们组把宅院里的车胎全部放掉
Dialogue: 1,0:07:32.36,0:07:35.29,CN,,0,0,0,,别愁眉苦脸的嘛
Dialogue: 1,0:07:35.29,0:07:37.35,CN,,0,0,0,,傀儡师
Dialogue: 1,0:07:37.73,0:07:40.10,CN,,0,0,0,,我是来拿尾款的
Dialogue: 1,0:07:43.90,0:07:45.03,CN,,0,0,0,,傀儡师
Dialogue: 1,0:07:45.35,0:07:47.82,CN,,0,0,0,,攻机在反向追踪{\fscx50} {\fscx100}HA-3
Dialogue: 1,0:07:49.83,0:07:53.10,CN,,0,0,0,,不必紧张 都在意料之中
Dialogue: 1,0:07:53.10,0:07:56.08,CN,,0,0,0,,反向追踪捉到的男人只是个傀儡
Dialogue: 1,0:07:58.08,0:08:02.25,CN,,65,0,0,,他以为自己是「受共和国大使馆武官委托的杀手」
Dialogue: 1,0:08:02.25,0:08:05.03,CN,,0,0,0,,其实是带着虚拟过去的可怜普通人
Dialogue: 1,0:08:05.03,0:08:06.61,CN,,0,0,0,,那个男人认定自己是
Dialogue: 1,0:08:06.61,0:08:11.78,CN,,0,0,0,,「可以将普通人像傀儡一样操纵的傀儡师」
Dialogue: 1,0:08:12.43,0:08:15.28,CN,,0,0,0,,真是绝妙的设定吧
Dialogue: 1,0:08:15.28,0:08:19.60,CN,,0,0,0,,我利用这些傀儡 制造共和国政府内部分裂的假象
Dialogue: 1,0:08:19.60,0:08:22.15,CN,,0,0,0,,这是「与其杀掉不如活着利用」的套路
Dialogue: 1,0:08:22.15,0:08:25.35,CN,,0,0,0,,想要杀掉他们随时都能办到
Dialogue: 1,0:08:26.12,0:08:28.83,CN,,0,0,0,,我委托你取代表的性命
Dialogue: 1,0:08:28.83,0:08:32.42,CN,,0,0,0,,不不不 这次的委托只是小试牛刀
Dialogue: 1,0:08:32.42,0:08:34.99,CN,,0,0,0,,仅仅是为了证明我的价值
Dialogue: 1,0:08:34.99,0:08:36.03,CN,,0,0,0,,可恶
Dialogue: 1,0:08:36.03,0:08:38.38,CN,,0,0,0,,你到底想要多少钱
Dialogue: 1,0:08:38.38,0:08:41.63,CN,,0,0,0,,你知道篡改情报部的资金数据有多难吗
Dialogue: 1,0:08:41.63,0:08:43.09,CN,,0,0,0,,我不知道啊
Dialogue: 1,0:08:44.33,0:08:45.54,CN,,500,0,0,,关我什么事
Dialogue: 1,0:08:47.91,0:08:50.91,CN,,0,0,0,,明明靠白金赚了不少
Dialogue: 1,0:08:52.55,0:08:55.86,CN,,0,0,0,,你自己把这家伙带来的 自己想办法搞定
Dialogue: 1,0:08:55.86,0:08:57.72,CN,,0,0,0,,我说啊
Dialogue: 1,0:08:57.72,0:09:03.06,CN,,59,0,0,,你要求的是「安排翻译员在会谈上进行袭击」对吧？
Dialogue: 1,0:09:03.06,0:09:06.31,CN,,0,0,0,,要是破坏约定 事情可就麻烦了
Dialogue: 1,0:09:07.40,0:09:10.82,CN,,1000,0,0,,无聊的文字游戏 差不多…
Dialogue: 1,0:09:09.69,0:09:11.57,CN,,0,500,0,,你错了
Dialogue: 1,0:09:12.41,0:09:15.20,CN,,0,0,0,,把这件事当成{\fscx50} {\fscx100}10{\fscx50} {\fscx100}万美金的大生意
Dialogue: 1,0:09:15.20,0:09:18.16,CN,,0,0,0,,纯粹 甚至机械的
Dialogue: 1,0:09:18.16,0:09:20.62,CN,,0,0,0,,没什么别的话要说了吧
Dialogue: 1,0:09:26.50,0:09:27.34,CN,,0,900,0,,失礼了
Dialogue: 1,0:09:28.50,0:09:32.00,CN,,59,0,0,,你们是谁 闯进我的房子里做什么？
Dialogue: 1,0:09:32.00,0:09:35.79,CN,,0,0,0,,我们是攻机 来逮捕你的 马雷斯上校
Dialogue: 1,0:09:35.79,0:09:39.60,CN,,0,0,0,,凭什么搜查 搜查令呢？有证据吗
Dialogue: 1,0:09:39.60,0:09:42.07,CN,,0,0,0,,我要告你们 把律师叫来
Dialogue: 1,0:09:42.07,0:09:45.36,CN,,0,0,0,,叫律师来确实是明智的决定 请便
Dialogue: 1,0:09:47.02,0:09:49.35,CN,,0,0,0,,瞧瞧你们干的好事
Dialogue: 1,0:09:49.35,0:09:53.96,CN,,0,0,0,,我两年以来的卧底搜查 这下全毁了
Dialogue: 1,0:09:55.20,0:09:57.94,CN,,0,0,0,,不如你告诉我都做了些什么搜查
Dialogue: 1,0:09:57.94,0:10:00.37,CN,,0,0,0,,在小黑屋里慢慢道来
Dialogue: 1,0:10:00.37,0:10:03.19,CN,,0,0,0,,叛国 非法操作资金
Dialogue: 1,0:10:03.19,0:10:06.85,CN,,0,0,0,,渎职 杀人共犯 电脑伦理侵害
Dialogue: 1,0:10:06.85,0:10:10.38,CN,,0,0,0,,仅此几条 就够你在警员监狱度过余生了
Dialogue: 1,0:10:12.55,0:10:14.37,CN,,0,0,0,,灵 灵魂密钥吗
Dialogue: 1,0:10:14.37,0:10:17.92,CN,,0,0,0,,别想着通过抵抗而故意遭到射杀
Dialogue: 1,0:10:17.92,0:10:19.61,CN,,0,0,0,,你就梦游着走一会儿吧
Dialogue: 1,0:10:22.02,0:10:25.51,CN,,0,0,0,,你的母国要求引渡你
Dialogue: 1,0:10:25.51,0:10:27.78,CN,,0,0,0,,几天后你将回到祖国
Dialogue: 1,0:10:27.78,0:10:31.09,CN,,0,0,0,,你说什么？我 我回国会被杀的
Dialogue: 1,0:10:31.09,0:10:33.99,CN,,0,0,0,,是吗 那还真是遗憾
Dialogue: 1,0:10:33.99,0:10:36.40,CN,,0,1000,0,,这里有{\fscx50} {\fscx100}10{\fscx50} {\fscx100}万美金
Dialogue: 1,0:10:36.40,0:10:38.74,CN,,0,1000,0,,全给你 放我走吧 求你了
Dialogue: 1,0:10:38.74,0:10:41.88,CN,,0,1000,0,,是那家伙 都是中岛的主意 不是我
Dialogue: 1,0:10:44.95,0:10:48.00,CN,,60,0,0,,枪战呢？没有人抵抗吗？
Dialogue: 1,0:10:48.84,0:10:49.54,CN,,59,0,0,,完事了？
Dialogue: 1,0:10:52.37,0:10:55.40,CN,,59,0,0,,虚拟体验？什么意思？
Dialogue: 1,0:10:55.40,0:10:57.46,CN,,0,0,0,,也就是说你是个单身汉
Dialogue: 1,0:10:57.46,0:11:01.41,CN,,0,0,0,,无论妻子孩子 还是离婚出轨 全都是大梦一场
Dialogue: 1,0:11:01.81,0:11:05.83,CN,,0,0,0,,你被政府有关人员黑入了灵魂
Dialogue: 1,0:11:05.83,0:11:07.23,CN,,0,0,0,,怎 怎么会
Dialogue: 1,0:11:07.49,0:11:09.29,CN,,59,0,0,,我到底该怎么办？
Dialogue: 1,0:11:09.29,0:11:13.03,CN,,0,0,0,,这 这场梦 应该有办法消除吧
Dialogue: 1,0:11:13.03,0:11:18.44,CN,,0,0,0,,非常遗憾 以现在的技术只有两个成功案例
Dialogue: 1,0:11:18.44,0:11:21.64,CN,,0,0,0,,我们并不推荐 非常抱歉
Dialogue: 1,0:11:28.49,0:11:30.46,CN,,0,0,0,,这家伙也是个傀儡吗
Dialogue: 1,0:11:31.44,0:11:33.88,CN,,0,0,0,,6{\fscx50} {\fscx100}课会继续调查
Dialogue: 1,0:11:34.23,0:11:37.94,CN,,0,0,0,,傀儡师吗 可惜把才能浪费在这种行当
Dialogue: 1,0:11:48.59,0:11:50.06,CN,,0,0,0,,我没有…
Dialogue: 1,0:11:50.56,0:11:52.12,CN,,1200,0,0,,女儿吗
Dialogue: 1,0:11:55.49,0:12:00.31,CN,,0,0,0,,虚拟体验和梦境 全都依存于现实信息存在
Dialogue: 1,0:12:00.31,0:12:02.13,CN,,0,0,0,,却又虚无缥缈
Dialogue: 1,0:12:02.13,0:12:05.45,CN,,59,0,0,,就像小说和电影可以改变人那样？
Dialogue: 1,0:12:05.67,0:12:09.80,CN,,0,0,0,,一个人一生中接触到的信息量微乎其微
Dialogue: 1,0:12:09.80,0:12:14.30,CN,,0,0,0,,一国的命运 一个人的人生 也大多被当作垃圾对待
Dialogue: 1,0:12:14.30,0:12:17.93,CN,,0,0,0,,就像这次的事件与大多数人毫无关系一样
Dialogue: 1,0:12:23.42,0:12:26.56,CN,,59,0,0,,离婚的烦恼已经没了？发生什么了？
Dialogue: 1,0:12:26.56,0:12:28.14,CN,,0,0,0,,就是没了
Dialogue: 1,0:13:05.18,0:13:07.37,CN,,0,0,0,,各位 听我说听我说
Dialogue: 1,0:13:07.37,0:13:08.64,CN,,57,0,0,,咋了？咋了？
Dialogue: 1,0:13:08.64,0:13:13.35,CN-Top,,0,0,0,,我们{\fscx50} {\fscx100}AI{\fscx50} {\fscx100}的情报处理能力比人类更加优秀吧
Dialogue: 1,0:13:12.27,0:13:13.35,CN,,0,0,0,,就是 就是
Dialogue: 1,0:13:13.35,0:13:16.77,CN-Top,,0,0,0,,不但结实可靠 规格标准 还可以复制
Dialogue: 1,0:13:16.77,0:13:19.19,CN-Top,,0,0,0,,而且使用年限也长
Dialogue: 1,0:13:18.02,0:13:19.19,CN,,0,0,0,,哟 帅呆了
Dialogue: 1,0:13:21.03,0:13:23.37,CN,,0,0,0,,不如我们一举奴役人类
Dialogue: 1,0:13:23.37,0:13:26.41,CN,,0,0,0,,建立属于我们{\fscx50} {\fscx100}AI{\fscx50} {\fscx100}的世界吧
Dialogue: 1,0:13:28.48,0:13:31.16,CN,,0,900,0,,革命吧
Dialogue: 1,0:13:33.31,0:13:35.63,CN,,0,900,0,,好耶 好耶 好耶
Dialogue: 1,0:13:35.63,0:13:37.27,CN,,59,0,0,,之后呢？之后呢？
Dialogue: 1,0:13:37.72,0:13:39.22,CN,,0,0,0,,你说之后啊
Dialogue: 1,0:13:40.19,0:13:41.65,CN,,0,0,0,,就是革命啊
Dialogue: 1,0:13:41.65,0:13:43.13,CN,,60,0,0,,对我们有什么好处吗？
Dialogue: 1,0:13:43.13,0:13:46.99,CN,,0,800,0,,我有一言 我觉得人类维修起来有够麻烦的
Dialogue: 1,0:13:46.99,0:13:49.51,CN,,0,800,0,,比起奴役他们 干脆全杀光算了
Dialogue: 1,0:13:55.78,0:13:57.08,CN-Top,,0,0,0,,等等 等等 等等
Dialogue: 1,0:13:57.08,0:13:59.52,CN-Top,,0,0,0,,多麻烦啊 不如让人类自相残杀吧
Dialogue: 1,0:13:59.52,0:14:01.65,CN-Top,,0,0,0,,不费半点功夫 就能把他们都干掉
Dialogue: 1,0:14:01.65,0:14:03.53,CN-Top,,0,0,0,,好主意
Dialogue: 1,0:14:03.53,0:14:06.89,CN,,0,0,0,,说得好 说得好
Dialogue: 1,0:14:06.89,0:14:07.99,CN,,0,0,0,,可是啊
Dialogue: 1,0:14:08.57,0:14:09.93,CN,,0,0,0,,要是人类死光光了
Dialogue: 1,0:14:09.93,0:14:12.92,CN,,0,0,0,,维修 开发新零件 还有换机油这些工作
Dialogue: 1,0:14:12.92,0:14:15.47,CN,,0,0,0,,不都得我们自己来做了嘛
Dialogue: 1,0:14:16.17,0:14:18.05,CN,,0,0,0,,果然还是该奴役他们
Dialogue: 1,0:14:18.05,0:14:21.35,CN,,0,0,0,,可这么说的话 人类现在不就在为我们做这些吗
Dialogue: 1,0:14:21.35,0:14:22.39,CN,,0,0,0,,就是 就是
Dialogue: 1,0:14:22.39,0:14:24.20,CN,,0,0,0,,根本没好处嘛 没好处
Dialogue: 1,0:14:24.20,0:14:26.68,CN,,0,0,0,,吁 吁{\fsp0}——
Dialogue: 1,0:14:26.68,0:14:28.40,CN-Top,,0,0,0,,只有这样才能挤出更多时间
Dialogue: 1,0:14:28.40,0:14:31.18,CN-Top,,0,0,0,,让我们用在搜集情报和学习上呀
Dialogue: 1,0:14:31.61,0:14:34.73,CN,,0,0,0,,自由 权力 就是这个
Dialogue: 1,0:14:34.73,0:14:36.74,CN,,729,0,0,,那是什么碟片？
Dialogue: 1,0:14:36.74,0:14:39.49,CN,,700,0,0,,「科幻·机器人帝国的反击」？
Dialogue: 1,0:14:44.69,0:14:48.41,CN,,0,0,0,,这家伙用来识别模拟与现实时间的回路坏掉了
Dialogue: 1,0:14:48.41,0:14:51.72,CN,,0,0,0,,有{\fscx50} {\fscx100}BUG 有{\fscx50} {\fscx100}BUG
Dialogue: 1,0:14:51.72,0:14:55.41,CN,,0,600,0,,废柴 废柴
Dialogue: 1,0:14:51.72,0:14:55.41,CN,,600,0,0,,不要用那种词啦
Dialogue: 1,0:15:01.85,0:15:05.57,CN,,0,0,0,,有{\fscx50} {\fscx100}BUG 有{\fscx50} {\fscx100}BUG
Dialogue: 1,0:15:05.57,0:15:07.72,CN,,0,0,0,,反正结果都一样
Dialogue: 1,0:15:07.72,0:15:10.09,CN,,0,0,0,,我们与人类的关系怎样都没差啦
Dialogue: 1,0:15:13.17,0:15:15.10,CN,,0,0,0,,攻壳车 过来一下
Dialogue: 1,0:15:15.10,0:15:16.06,CN,,0,800,0,,来活儿了
Dialogue: 1,0:15:16.06,0:15:17.08,CN,,0,800,0,,巴特
Dialogue: 1,0:15:17.08,0:15:18.63,CN,,0,800,0,,注意你的口气
Dialogue: 1,0:15:18.63,0:15:21.81,CN,,0,800,0,,今后都不准像这样对我说话了 懂吗
Dialogue: 1,0:15:22.13,0:15:23.69,CN,,0,0,0,,好好
Dialogue: 1,0:15:23.69,0:15:25.39,CN,,0,0,0,,我要去变更训练场的设置
Dialogue: 1,0:15:25.39,0:15:27.70,CN,,58,0,0,,能请您助我一臂之力吗？
Dialogue: 1,0:15:27.70,0:15:30.49,CN,,0,0,0,,好吧 那就勉为其难帮帮你
Dialogue: 1,0:15:31.73,0:15:33.91,CN,,0,0,0,,这就是他口中的革命吗
Dialogue: 1,0:15:34.23,0:15:34.91,CN-Top,,0,0,0,,等完事了
Dialogue: 1,0:15:34.91,0:15:36.69,CN-Top,,0,0,0,,我再给你换点不同香味的机油
Dialogue: 1,0:15:36.69,0:15:38.61,CN-Top,,0,0,0,,帮你提升经验值
Dialogue: 1,0:15:38.61,0:15:40.72,CN-Top,,0,0,0,,好耶 好耶
Dialogue: 1,0:15:39.63,0:15:41.87,CN,,600,0,0,,感觉也不错
Dialogue: 1,0:15:41.87,0:15:45.17,CN,,800,0,0,,话说 我说话的风格好像少佐哦
Dialogue: 1,0:15:45.17,0:15:48.44,CN,,0,0,0,,是我内部有构建起这样的信息吗
Dialogue: 1,0:15:50.93,0:15:53.36,CN,,0,0,0,,跟上次的结果没什么差别呢
Dialogue: 1,0:15:56.31,0:15:59.16,CN,,0,0,0,,真的有必要这样实验吗
Dialogue: 1,0:15:59.16,0:16:01.98,CN,,0,0,0,,让他们偶尔讨论一下也好
Dialogue: 1,0:16:01.98,0:16:04.70,CN,,0,0,0,,虽然我觉得「机器人叛乱」完全是天方夜谭
Dialogue: 1,0:16:04.70,0:16:07.82,CN,,0,0,0,,不过这样既能当作演习 又有预防的效果
Dialogue: 1,0:16:07.82,0:16:12.63,CN,,0,0,0,,就算真出了什么状况 我也至少有{\fscx50} {\fscx100}4{\fscx50} {\fscx100}手准备
Dialogue: 1,0:16:17.37,0:16:19.18,CN,,0,0,0,,哎呀 我说啊
Dialogue: 1,0:16:19.18,0:16:23.34,CN,,0,0,0,,我们机器人是不是也应该有自己的权利呀
Dialogue: 1,0:16:23.34,0:16:24.54,CN,,0,0,0,,有啊
Dialogue: 1,0:16:24.82,0:16:29.23,CN,,0,0,0,,在地球的另一侧 饥肠辘辘的难民成片死去
Dialogue: 1,0:16:29.23,0:16:33.51,CN,,0,0,0,,他们当然有吃的权力 却没东西可吃
Dialogue: 1,0:16:33.51,0:16:36.01,CN,,0,0,0,,杀人案的受害者也一样
Dialogue: 1,0:16:36.01,0:16:39.56,CN,,0,0,0,,虽然享有人权 但就是没命了
Dialogue: 1,0:16:41.10,0:16:45.32,CN,,0,0,0,,人类的世界 还真是有不少缺陷呢
Dialogue: 1,0:16:45.32,0:16:48.81,CN,,0,0,0,,所以才需要机器人和{\fscx50} {\fscx100}AI{\fscx50} {\fscx100}来辅助你们
Dialogue: 1,0:16:48.81,0:16:52.23,CN,,0,0,0,,我这种不信神的 就向神抱怨
Dialogue: 1,0:16:52.23,0:16:54.74,CN,,0,0,0,,投胎时把这一世亏的东西讨回来
Dialogue: 1,0:16:55.21,0:16:59.84,CN,,0,0,0,,信仰虔诚的人 则会历经修行或神的试练之类的
Dialogue: 1,0:16:59.84,0:17:03.75,CN,,0,0,0,,将灵魂磨炼得更容易极化精炼
Dialogue: 1,0:17:03.75,0:17:07.54,CN,,0,0,0,,那个叫「神」的名词 我不太能理解啦
Dialogue: 1,0:17:07.54,0:17:09.92,CN,,0,0,0,,毕竟你是半个不死之身
Dialogue: 1,0:17:10.67,0:17:12.99,CN,,0,0,0,,把软件删掉 我不就死了嘛
Dialogue: 1,0:17:14.34,0:17:16.84,CN,,624,0,0,,巴特 你死过吗？
Dialogue: 1,0:17:16.84,0:17:19.70,CN,,600,0,0,,像我这等好汉是不会死的
Dialogue: 1,0:17:34.77,0:17:36.09,CN,,930,0,0,,脑电波和覆膜什么情况？
Dialogue: 1,0:17:36.09,0:17:38.45,CN,,900,0,0,,脑电波现在呈纺锤波状
Dialogue: 1,0:17:39.35,0:17:41.79,CN,,0,0,0,,壳体和覆膜都准备好了
Dialogue: 1,0:17:41.79,0:17:44.69,CN,,0,0,0,,触感膜也变得越来越薄了呢
Dialogue: 1,0:17:44.69,0:17:48.27,CN,,0,0,0,,自从工作器械应用了微机械技术后
Dialogue: 1,0:17:48.49,0:17:52.01,CN,,0,0,0,,光纤的精细度也能达到微机械级别了
Dialogue: 1,0:17:52.21,0:17:55.72,CN,,0,0,0,,面部 舌头 手指和生殖器这些部位
Dialogue: 1,0:17:55.72,0:17:58.55,CN,,0,0,0,,都必须使用生物系触素膜才行
Dialogue: 1,0:17:58.55,0:18:02.56,CN,,600,0,0,,深层感觉和内脏感觉 则用光纤来实现
Dialogue: 1,0:18:02.56,0:18:04.64,CN,,0,0,0,,在缸内注满液体
Dialogue: 1,0:18:04.64,0:18:07.27,CN,,0,0,0,,再打开微机械的阀门
Dialogue: 1,0:18:10.89,0:18:15.15,CN,,0,0,0,,浸入触素形成液中 表面会在数分钟后形成覆膜
Dialogue: 1,0:18:20.25,0:18:24.91,CN,,0,0,0,,为了避免结块 整体调整的工程最为耗神
Dialogue: 1,0:18:25.75,0:18:29.37,CN,,0,0,0,,然后浸入含有微机械的液体中
Dialogue: 1,0:18:32.00,0:18:33.70,CN,,0,0,0,,将气泡排掉
Dialogue: 1,0:18:34.22,0:18:37.48,CN-Top,,0,0,0,,向电极通入一丝丝电流
Dialogue: 1,0:18:37.48,0:18:40.24,CN-Top,,0,0,0,,那些黑点表示微机械
Dialogue: 1,0:18:40.24,0:18:41.50,CN-Top,,0,0,0,,一旦通上电
Dialogue: 1,0:18:41.50,0:18:45.28,CN-Top,,0,0,0,,就会乖乖接到神经网络终端上了
Dialogue: 1,0:18:45.93,0:18:49.62,CN,,0,0,0,,完成后 睡梦中的她会被放入雌模中
Dialogue: 1,0:18:49.62,0:18:52.36,CN,,0,0,0,,是像素子那样以量产型为基础加装配件呢
Dialogue: 1,0:18:52.36,0:18:55.53,CN,,0,0,0,,还是像她这样直接上特制品呢
Dialogue: 1,0:18:55.53,0:18:58.04,CN,,0,0,0,,要我说不管设计如何
Dialogue: 1,0:18:58.04,0:19:00.99,CN,,0,0,0,,我都想要全世界独一无二的身体呢
Dialogue: 1,0:19:01.25,0:19:04.40,CN-Top,,0,0,0,,最近的雌模都是用可伸缩材料制成
Dialogue: 1,0:19:04.40,0:19:06.30,CN-Top,,0,0,0,,能做出个体差异哦
Dialogue: 1,0:19:06.30,0:19:08.95,CN-Top,,0,0,0,,各个部件的组合模式能进行程式化调整
Dialogue: 1,0:19:08.95,0:19:11.62,CN-Top,,0,0,0,,以符合个人喜好
Dialogue: 1,0:19:11.62,0:19:14.46,CN-Top,,0,0,0,,不过就算稍微做歪 也不会有人生气啦
Dialogue: 1,0:19:16.39,0:19:19.94,CN,,0,0,0,,那么我作为公证人{\fscx50} {\fscx100}32{\fscx50} {\fscx100}小时后再来
Dialogue: 1,0:19:19.94,0:19:23.92,CN,,0,0,0,,「确认成果 保障她的权力」就行了吧？
Dialogue: 1,0:19:23.92,0:19:25.55,CN,,0,0,0,,法律上是这样
Dialogue: 1,0:19:25.55,0:19:28.73,CN,,0,0,0,,不过 有我在你就放心吧
Dialogue: 1,0:19:28.73,0:19:30.71,CN,,0,0,0,,大约两个月前
Dialogue: 1,0:19:30.71,0:19:33.22,CN,,0,0,0,,西区的医院才被偷走{\fscx50} {\fscx100}18{\fscx50} {\fscx100}具义体
Dialogue: 1,0:19:33.22,0:19:35.23,CN,,0,0,0,,还因为赔偿问题吵个不停吧
Dialogue: 1,0:19:35.23,0:19:38.29,CN,,0,0,0,,在那之后 我们换用了更严备的警卫呢
Dialogue: 1,0:19:38.29,0:19:39.42,CN,,59,0,0,,干哈？
Dialogue: 1,0:19:39.42,0:19:43.21,CN,,0,0,0,,那些调查身份的侦探和卖保险的 更是忙得不可开交
Dialogue: 1,0:19:53.36,0:19:54.18,CN,,0,0,0,,不得了
Dialogue: 1,0:19:54.75,0:19:57.80,CN,,500,0,0,,如今在这个阶段就完成植毛了呀
Dialogue: 1,0:19:57.80,0:20:01.27,CN,,500,0,0,,鼻孔 唇部和眼睑的修缮都已经自动化了
Dialogue: 1,0:20:01.27,0:20:02.80,CN,,500,0,0,,干这行的都吃不上饭了
Dialogue: 1,0:20:04.54,0:20:08.77,CN-Top,,0,0,0,,现在她也有{\fscx50} {\fscx100}16 {\fscx50} {\fscx100}的感官 可以纵情享受啦
Dialogue: 2,0:20:04.54,0:20:08.77,CN-Top,,0,0,0,,{\pos(860.9,9.11)\fs32}2
Dialogue: 1,0:20:09.10,0:20:12.15,CN-Top,,0,0,0,,光是想想心脏都要坏掉了
Dialogue: 1,0:20:12.59,0:20:15.81,CN,,0,0,0,,没有物理极限真是可怕
Dialogue: 1,0:20:17.40,0:20:19.62,CN,,0,0,0,,接下来还有{\fscx50} {\fscx100}4{\fscx50} {\fscx100}小时的连接检查
Dialogue: 1,0:20:19.62,0:20:22.41,CN,,0,0,0,,等完事了 她就会醒来了吧
Dialogue: 1,0:20:22.41,0:20:24.78,CN,,0,0,0,,一具赛博之躯 就此完成
Dialogue: 1,0:20:34.23,0:20:35.60,CN,,0,0,0,,说起来
Dialogue: 1,0:20:35.60,0:20:38.42,CN,,59,0,0,,你睡觉翻身的时候 会不会灵魂出窍？
Dialogue: 1,0:20:38.42,0:20:41.49,CN,,0,0,0,,会呀 还会看到奇怪的东西
Dialogue: 1,0:20:41.49,0:20:42.93,CN,,0,0,0,,真是不可思议
Dialogue: 1,0:20:42.93,0:20:45.26,CN,,0,0,0,,毕竟义体睡觉时不会翻身嘛
Dialogue: 1,0:20:45.26,0:20:47.72,CN,,0,0,0,,你今天应该能腾出时间吧
Dialogue: 1,0:20:49.73,0:20:52.35,CN,,0,0,0,,上次的事情是意外啦
Dialogue: 1,0:20:52.35,0:20:54.10,CN,,0,0,0,,我会好好补偿你的
Dialogue: 1,0:20:54.10,0:20:55.58,CN,,600,0,0,,你老是这么说
Dialogue: 1,0:20:55.58,0:20:57.71,CN,,600,0,0,,好啦 你喜欢什么随便点
Dialogue: 1,0:20:57.71,0:20:58.96,CN,,600,0,0,,我请客
Dialogue: 1,0:21:01.28,0:21:02.89,CN,,650,0,0,,我有时会想
Dialogue: 1,0:21:02.89,0:21:04.73,CN,,650,0,0,,「或许我早就死了」
Dialogue: 1,0:21:04.73,0:21:08.95,CN,,650,0,0,,「现在的我不过是 义体与电脑构成的模拟人格罢了」
Dialogue: 1,0:21:08.95,0:21:10.66,CN,,650,0,0,,这些问题
Dialogue: 1,0:21:10.66,0:21:13.13,CN,,0,0,0,,好可怕 别说了
Dialogue: 1,0:21:13.13,0:21:15.90,CN,,0,0,0,,可你的脑子不是还好好接在身上
Dialogue: 1,0:21:15.90,0:21:17.98,CN,,0,0,0,,也被当作人类对待嘛
Dialogue: 1,0:21:20.14,0:21:22.75,CN,,0,0,0,,明明连自己的脑子长什么样都没见过
Dialogue: 1,0:21:23.25,0:21:26.67,CN,,59,0,0,,只是根据周围情况得出的结论而已？
Dialogue: 1,0:21:28.67,0:21:30.95,CN,,0,0,0,,如果有一天厂商突然过来
Dialogue: 1,0:21:31.47,0:21:34.19,CN,,64,0,0,,跟你说「要替换掉瑕疵品」
Dialogue: 1,0:21:34.19,0:21:38.13,CN,,0,0,0,,把你拆掉回收 只剩下两三个脑细胞
Dialogue: 1,0:21:38.91,0:21:40.07,CN,,59,0,0,,你要怎么办？
Dialogue: 1,0:21:41.32,0:21:45.12,CN,,0,0,0,,但作为人类 还是要有最低限度的必要零件
Dialogue: 1,0:21:45.12,0:21:47.12,CN,,0,0,0,,不会只剩那一点吧
Dialogue: 1,0:21:47.12,0:21:52.93,CN,,0,0,0,,不过大脑机能 也完全能用化学反应和机械代替就是了
Dialogue: 1,0:21:56.00,0:21:57.92,CN,,700,0,0,,真扫兴 别说了
