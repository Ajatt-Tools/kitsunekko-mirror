Dialogue: 0,0:00:02.65,0:00:04.73,TEXT-JP,,0,0,0,,おい　よしき
Dialogue: 0,0:00:05.19,0:00:08.45,TEXT-JP,,0,0,0,,漫画食いするからさ　見とってや
Dialogue: 0,0:00:10.70,0:00:12.41,TEXT-JP,,0,0,0,,ただいま
Dialogue: 0,0:00:12.41,0:00:13.41,TEXT-JP,,0,0,0,,きたなっ
Dialogue: 0,0:00:15.95,0:00:19.17,TEXT-JP,,0,0,0,,あれ　種のんでもうた
Dialogue: 0,0:00:21.21,0:00:23.59,TEXT-JP,,0,0,0,,おとやんの友達が種食って
Dialogue: 0,0:00:23.59,0:00:27.05,TEXT-JP,,0,0,0,,全身ストライプのスイカ人間になってまったんやて
Dialogue: 0,0:00:27.05,0:00:28.80,TEXT-JP,,0,0,0,,ほんで　どうなったん
Dialogue: 0,0:00:29.93,0:00:30.80,TEXT-JP,,0,0,0,,死んだ
Dialogue: 0,0:00:32.30,0:00:34.93,TEXT-JP,,0,0,0,,俺もさっきのんでもた
Dialogue: 0,0:00:42.23,0:00:46.53,TEXT-JP,,550,0,0,,なんで泣いとんさ　大丈夫やから
Dialogue: 0,0:00:42.48,0:00:43.94,TEXT-JP,,0,650,0,,ごしょうやから
Dialogue: 0,0:00:44.40,0:00:45.82,TEXT-JP,,0,650,0,,食っとかんと
Dialogue: 0,0:02:37.39,0:02:40.14,TEXT-JP,,0,0,0,,こんにちは　ヒカルおる？
Dialogue: 0,0:02:41.47,0:02:44.23,TEXT-JP,,0,0,0,,よう来たなあ　よしきちゃん
Dialogue: 0,0:02:44.23,0:02:45.02,TEXT-JP,,0,0,0,,これ
Dialogue: 0,0:02:45.02,0:02:48.73,TEXT-JP,,0,0,0,,あら　立派なスイカ　ありがとね
Dialogue: 0,0:03:10.96,0:03:11.71,TEXT-JP,,0,0,0,,痛っ
Dialogue: 0,0:03:11.71,0:03:14.59,TEXT-JP,,0,0,0,,じろじろ見とるわりに起こさんのかい
Dialogue: 0,0:03:14.59,0:03:19.93,TEXT-JP,,0,0,0,,古いゲームの主人公みたいな格好しよって　意気地なしが　この
Dialogue: 0,0:03:31.61,0:03:33.03,TEXT-JP,,0,0,0,,勝った
Dialogue: 0,0:03:33.03,0:03:35.07,TEXT-JP,,0,0,0,,さっきなんか持ってきとった？
Dialogue: 0,0:03:35.95,0:03:38.70,TEXT-JP,,0,0,0,,親戚からもらったスイカ
Dialogue: 0,0:03:38.70,0:03:41.58,TEXT-JP,,0,0,0,,スイカ？俺の好きなやつやん
Dialogue: 0,0:03:41.58,0:03:44.54,TEXT-JP,,0,0,0,,俺が世界一うまく食えるやつやん
Dialogue: 0,0:03:45.79,0:03:47.33,TEXT-JP,,0,0,0,,知っとるよ
Dialogue: 0,0:03:47.33,0:03:51.38,TEXT-JP,,0,0,0,,漫画食いしたろか　タネマシンガンも出せるで
Dialogue: 0,0:03:53.76,0:03:56.51,TEXT-JP,,0,0,0,,それも知っとるよ
Dialogue: 0,0:04:07.94,0:04:09.15,TEXT-JP,,0,0,0,,うめえ
Dialogue: 0,0:04:09.81,0:04:12.77,TEXT-JP,,0,0,0,,スイカの味はちゃんと知っとるんや
Dialogue: 0,0:04:12.77,0:04:15.78,TEXT-JP,,0,0,0,,うん　もう10回くらい食っとるに
Dialogue: 0,0:04:15.78,0:04:18.28,TEXT-JP,,0,0,0,,食べ方もアップグレードしてんで
Dialogue: 0,0:04:21.28,0:04:22.24,TEXT-JP,,0,0,0,,どうよ
Dialogue: 0,0:04:22.24,0:04:23.08,TEXT-JP,,0,0,0,,きたなっ
Dialogue: 0,0:04:23.08,0:04:25.91,TEXT-JP,,0,0,0,,いや　ちょっとすごいかもしれん
Dialogue: 0,0:04:28.71,0:04:32.42,TEXT-JP,,0,0,0,,種のんだ　スイカ人間になってまうわ
Dialogue: 0,0:04:36.84,0:04:40.30,TEXT-JP,,0,0,0,,暇やなあ　「スマボラ」する？
Dialogue: 0,0:04:40.30,0:04:42.89,TEXT-JP,,0,0,0,,いや　ええわ　気分乗らん
Dialogue: 0,0:04:44.18,0:04:46.47,TEXT-JP,,0,0,0,,そう　まあええけど
Dialogue: 0,0:04:53.61,0:04:56.73,TEXT-JP,,0,0,0,,沙都子　今電話大丈夫？
Dialogue: 0,0:04:56.73,0:04:59.24,TEXT-JP,,0,0,0,,よしきちゃんからスイカもろたで
Dialogue: 0,0:04:59.53,0:05:01.28,TEXT-JP,,0,0,0,,漫画食いするからさ
Dialogue: 0,0:05:01.49,0:05:03.28,TEXT-JP,,0,0,0,,種のんでもうた
Dialogue: 0,0:05:03.49,0:05:05.74,TEXT-JP,,0,0,0,,スイカ人間になってまう
Dialogue: 0,0:05:29.56,0:05:34.11,TEXT-JP,,0,0,0,,俺だけ　こんな普通にしてていいわけない
Dialogue: 0,0:05:36.27,0:05:40.78,TEXT-JP,,0,0,0,,俺さ　お前と一緒におるだけで楽しいし
Dialogue: 0,0:05:40.78,0:05:43.11,TEXT-JP,,0,0,0,,スイカもありがとうな
Dialogue: 0,0:05:45.62,0:05:47.37,TEXT-JP,,0,0,0,,なんや　急に
Dialogue: 0,0:05:47.79,0:05:50.25,TEXT-JP,,0,0,0,,俺はお前にウソはつかんし
Dialogue: 0,0:05:50.25,0:05:55.38,TEXT-JP,,0,0,0,,なんか　ちゃんとこういうの言いたいって気持ちがあるだけやし
Dialogue: 0,0:06:01.88,0:06:06.01,TEXT-JP,,0,0,0,,俺もそうすれば　よかったな
Dialogue: 0,0:06:19.40,0:06:22.03,TEXT-JP,,0,0,0,,結局　ガーガー寝よった
Dialogue: 0,0:06:22.49,0:06:23.53,TEXT-JP,,0,0,0,,白目やし
Dialogue: 0,0:06:27.66,0:06:32.54,TEXT-JP,,0,0,0,,このころやったな　光のおとやんが死んだん
Dialogue: 0,0:06:33.71,0:06:36.75,TEXT-JP,,0,0,0,,あれ　そういえばかなり前
Dialogue: 0,0:06:36.75,0:06:42.63,TEXT-JP,,0,0,0,,光のおとやんがあの山に行っとった日あったな　ふだん誰も入れんのに
Dialogue: 0,0:06:43.97,0:06:48.30,TEXT-JP,,0,0,0,,ちょうど光が山行ったのと同じくらいの季節
Dialogue: 0,0:06:51.14,0:06:55.06,TEXT-JP,,0,0,0,,なんや　あの顔　バカやなあ
Dialogue: 0,0:06:56.15,0:06:59.57,TEXT-JP,,0,0,0,,この村で俺と年が近いのは光だけや
Dialogue: 0,0:07:00.32,0:07:03.57,TEXT-JP,,0,0,0,,やから俺と光はずっと2人で生きてきた
Dialogue: 0,0:07:04.57,0:07:07.07,TEXT-JP,,0,600,0,,写真の光はもうおらんのに
Dialogue: 0,0:07:06.24,0:07:08.07,TEXT-JP,,600,0,0,,お前はもう死んだのに
Dialogue: 0,0:07:08.07,0:07:10.83,TEXT-JP,,0,0,0,,俺だけが…写真の光はもう…
Dialogue: 0,0:07:10.83,0:07:12.33,TEXT-JP,,0,0,0,,何のうのうとしとんねん
Dialogue: 0,0:07:31.60,0:07:35.18,TEXT-JP,,0,0,0,,スイカって皮まで食べられる
Dialogue: 0,0:07:42.78,0:07:45.19,TEXT-JP,,0,0,0,,よしきちゃん　ちょっとええ？
Dialogue: 0,0:07:45.82,0:07:46.90,TEXT-JP,,0,0,0,,はい
Dialogue: 0,0:07:49.53,0:07:53.70,TEXT-JP-U,,0,0,0,,これ　沙都子に渡して　スイカありがとうって
Dialogue: 0,0:07:53.70,0:07:55.04,TEXT-JP-U,,0,0,0,,ありがとうございます
Dialogue: 0,0:07:55.04,0:07:57.21,TEXT-JP-U,,0,0,0,,ぎょうさん食べたから持ってって
Dialogue: 0,0:07:57.21,0:07:58.37,TEXT-JP-U,,0,0,0,,すいません
Dialogue: 0,0:07:58.37,0:08:00.75,TEXT-JP-U,,0,0,0,,そのまま熟れても美味しいよ
Dialogue: 0,0:08:01.38,0:08:04.09,TEXT-JP-U,,0,0,0,,かおるちゃんも好きって言うんやし
Dialogue: 0,0:08:04.09,0:08:06.92,TEXT-JP-U,,0,0,0,,そういえばかおるちゃんは元気しとる？
Dialogue: 0,0:08:06.92,0:08:09.89,TEXT-JP-U,,0,0,0,,そうですね　ぼちぼちです
Dialogue: 0,0:08:02.50,0:08:05.26,TEXT-JP,,0,0,0,,くれ…ばやし？
Dialogue: 0,0:08:06.92,0:08:08.76,TEXT-JP,,0,0,0,,誰？これ
Dialogue: 0,0:08:15.43,0:08:16.77,TEXT-JP,,0,0,0,,いたいた
Dialogue: 0,0:08:19.31,0:08:21.52,TEXT-JP,,0,0,0,,いや　暑いなあ
Dialogue: 2,0:08:21.94,0:08:25.65,TEXT-JP,,0,0,0,,お店とか入ろか　「あめりか」でええ？
Dialogue: 0,0:08:26.57,0:08:27.53,TEXT-JP,,0,0,0,,はい
Dialogue: 0,0:08:30.03,0:08:31.78,TEXT-JP,,0,0,0,,いらっしゃいませ
Dialogue: 0,0:08:31.78,0:08:34.20,TEXT-JP,,0,0,0,,あらあらあらあらあら
Dialogue: 0,0:08:34.20,0:08:36.16,TEXT-JP,,0,0,0,,新しい巨大パフェ出とるね
Dialogue: 0,0:08:36.54,0:08:40.04,TEXT-JP-U,,0,0,0,,好きなの頼んでね　甘いもん好き？
Dialogue: 0,0:08:39.29,0:08:40.04,TEXT-JP,,0,0,0,,あの
Dialogue: 0,0:08:45.17,0:08:49.59,TEXT-JP,,0,0,0,,ほしたら　何が起きたか聞いてもええ？
Dialogue: 0,0:08:54.93,0:08:57.89,TEXT-JP,,0,0,0,,そっか　親友がね
Dialogue: 0,0:08:59.10,0:09:01.77,TEXT-JP,,0,0,0,,そやな　ありがとうね
Dialogue: 0,0:09:01.77,0:09:03.61,TEXT-JP,,0,0,0,,よう頑張ったな
Dialogue: 0,0:09:07.53,0:09:10.70,TEXT-JP,,0,0,0,,なんでほんなこと言うんですか
Dialogue: 0,0:09:11.32,0:09:14.83,TEXT-JP,,0,0,0,,あなたは罰されたがっとる場合やないの
Dialogue: 0,0:09:15.33,0:09:16.99,TEXT-JP,,0,0,0,,しっかりしなさい
Dialogue: 0,0:09:19.25,0:09:23.75,TEXT-JP,,0,0,0,,誰かに罰されたって自分が楽になるだけ
Dialogue: 0,0:09:23.75,0:09:25.88,TEXT-JP,,0,0,0,,死人はなんとも思わん
Dialogue: 0,0:09:26.50,0:09:33.97,TEXT-JP,,0,0,0,,ただ私たちが亡くなった人に汚く執着してる事実だけや　あるのは
Dialogue: 0,0:09:33.97,0:09:35.35,TEXT-JP,,0,0,0,,私たち？
Dialogue: 0,0:09:35.35,0:09:38.72,TEXT-JP,,0,0,0,,ってもう　嫌や　ごめんな
Dialogue: 0,0:09:38.72,0:09:41.10,TEXT-JP,,0,0,0,,やけに暗くなっちゃったわ
Dialogue: 0,0:09:41.10,0:09:45.36,TEXT-JP,,0,0,0,,というか　混ざってまうくらい　その…仲良しなんよね
Dialogue: 0,0:09:45.36,0:09:46.41,TEXT-JP,,0,0,0,,てっきりかの…
Dialogue: 0,0:09:46.41,0:09:48.32,TEXT-JP,,0,0,0,,ご注文はお決まりでしょうか
Dialogue: 0,0:09:48.32,0:09:50.49,TEXT-JP,,0,0,0,,この新しい巨大パフェ2つで
Dialogue: 0,0:09:52.03,0:09:53.99,TEXT-JP,,0,0,0,,本題なんやけどね
Dialogue: 0,0:09:53.99,0:09:58.74,TEXT-JP,,0,0,0,,町や村がおかしくなり始めとるの　気付いとる？
Dialogue: 0,0:09:58.74,0:10:02.92,TEXT-JP,,0,0,0,,ここら一帯にゆがみのようなもんが出来て
Dialogue: 0,0:10:02.92,0:10:05.38,TEXT-JP,,0,0,0,,不審な事件やケガレ
Dialogue: 0,0:10:05.67,0:10:07.38,TEXT-JP,,0,0,0,,って言っても分からんよね
Dialogue: 0,0:10:07.67,0:10:10.76,TEXT-JP,,0,0,0,,おるはずのないもんが増えてきてる
Dialogue: 0,0:10:10.76,0:10:14.26,TEXT-JP,,0,0,0,,町や村が徐々に狂いだしてるんよ
Dialogue: 0,0:10:14.26,0:10:19.85,TEXT-JP,,0,0,0,,これな　多分あんたの友達になっとるナニカの影響やと思う
Dialogue: 0,0:10:21.14,0:10:26.31,TEXT-JP,,0,0,0,,アレは　なんやろ　巨大な塊という感じ
Dialogue: 0,0:10:26.31,0:10:28.11,TEXT-JP,,0,0,0,,「地獄」みたいな
Dialogue: 0,0:10:28.69,0:10:32.70,TEXT-JP,,0,0,0,,その気配が山から消えたと思ったやさき
Dialogue: 0,0:10:32.70,0:10:35.57,TEXT-JP,,0,0,0,,急激にゆがみが大きなった
Dialogue: 0,0:10:35.95,0:10:40.12,TEXT-JP,,0,0,0,,アレが山におった分　ゆがみが抑えられていたんかも
Dialogue: 0,0:10:40.66,0:10:42.66,TEXT-JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:10:42.66,0:10:45.29,TEXT-JP,,0,0,0,,この前クビタチであった変死事件
Dialogue: 0,0:10:46.79,0:10:49.96,TEXT-JP,,0,0,0,,あれも関係しとる気がする
Dialogue: 0,0:10:49.96,0:10:54.72,TEXT-JP,,0,0,0,,正直　私もすぐにこの町から逃げたいくらい怖いんよ
Dialogue: 0,0:10:56.09,0:10:59.05,TEXT-JP,,0,0,0,,でも　お義母さんに娘もおるしね
Dialogue: 0,0:10:59.93,0:11:03.06,TEXT-JP,,0,0,0,,上の息子はとっくに出てったきりなんやけど
Dialogue: 0,0:11:04.35,0:11:08.77,TEXT-JP,,0,0,0,,あの…さっき「私たち」って
Dialogue: 0,0:11:09.98,0:11:14.78,TEXT-JP,,0,0,0,,死んだ夫がね　昔一回帰ってきたんよ
Dialogue: 0,0:11:14.78,0:11:16.41,TEXT-JP,,0,0,0,,でも　ダメやった
Dialogue: 0,0:11:17.07,0:11:22.20,TEXT-JP,,0,0,0,,結局　息子の体に一生治らん傷を残しただけやったの
Dialogue: 0,0:11:23.08,0:11:27.00,TEXT-JP,,0,0,0,,なんでもええから　また一緒にいたかった
Dialogue: 0,0:11:28.08,0:11:30.79,TEXT-JP,,0,0,0,,あんたもなんとなく分かるやろ
Dialogue: 0,0:11:30.79,0:11:33.51,TEXT-JP,,0,0,0,,このまま一緒におったらあかんって
Dialogue: 0,0:11:37.01,0:11:39.80,TEXT-JP,,0,0,0,,それを言われて　どうせえって…
Dialogue: 0,0:11:45.31,0:11:49.48,TEXT-JP,,0,0,0,,ごめんね　私みたいになってほしくないの
Dialogue: 0,0:11:49.48,0:11:54.65,TEXT-JP,,0,0,0,,それに　前に進むためには　知っておく必要があるんちゃうかな
Dialogue: 0,0:11:56.24,0:11:57.99,TEXT-JP,,0,0,0,,お待たせしました
Dialogue: 0,0:11:58.45,0:12:02.66,TEXT-JP,,0,0,0,,ご注文のあめりかメガDXマウンテン大統領になります
Dialogue: 0,0:12:15.71,0:12:18.59,TEXT-JP,,0,0,0,,雨やん　傘忘れた
Dialogue: 0,0:12:18.93,0:12:21.10,TEXT-JP,,0,0,0,,イッチ　ニ…
Dialogue: 0,0:12:41.12,0:12:44.16,TEXT-JP,,0,0,0,,あっ　光やん　どしたん
Dialogue: 0,0:12:44.16,0:12:45.66,TEXT-JP,,0,0,0,,よしき知らん？
Dialogue: 0,0:12:45.66,0:12:47.96,TEXT-JP,,0,0,0,,さあ　見とらんよ
Dialogue: 0,0:12:52.17,0:12:53.13,TEXT-JP,,0,0,0,,あれ
Dialogue: 0,0:12:53.42,0:12:54.92,TEXT-JP,,0,0,0,,まだいたん？
Dialogue: 0,0:12:56.01,0:12:57.97,TEXT-JP,,0,0,0,,ちょっと忘れ物してん
Dialogue: 0,0:13:00.51,0:13:02.59,TEXT-JP,,0,0,0,,光が捜しとったで
Dialogue: 0,0:13:02.59,0:13:05.39,TEXT-JP,,0,0,0,,見つけたら先帰れって言っといてや
Dialogue: 0,0:13:14.57,0:13:17.23,TEXT-JP,,0,0,0,,お前を…殺したない
Dialogue: 0,0:13:18.28,0:13:20.95,TEXT-JP,,0,0,0,,それって殺せるってことやんな
Dialogue: 0,0:13:22.36,0:13:23.99,TEXT-JP,,0,0,0,,ノウヌキ様
Dialogue: 0,0:13:24.53,0:13:27.12,TEXT-JP,,0,0,0,,山に閉じ込められとったナニカ
Dialogue: 0,0:13:28.58,0:13:30.79,TEXT-JP,,0,0,0,,松浦さんの変死事件
Dialogue: 0,0:13:31.33,0:13:32.96,TEXT-JP,,0,0,0,,村のゆがみ
Dialogue: 0,0:13:34.50,0:13:37.34,TEXT-JP,,0,0,0,,ヒカル　お前は一体…
Dialogue: 0,0:13:38.30,0:13:42.51,TEXT-JP,,0,0,0,,前に進むために　前に進むために…
Dialogue: 0,0:13:42.51,0:13:46.68,TEXT-JP,,0,0,0,,前に進むために　前に進むために…
Dialogue: 0,0:13:46.68,0:13:49.14,TEXT-JP,,0,0,0,,前に進むために！
Dialogue: 0,0:13:51.27,0:13:53.02,TEXT-JP,,0,0,0,,やっとおった
Dialogue: 0,0:13:55.98,0:13:57.27,TEXT-JP,,0,0,0,,はよ帰ろ
Dialogue: 0,0:13:59.86,0:14:02.11,TEXT-JP,,0,0,0,,今日は先帰ってくれへん？
Dialogue: 0,0:14:02.11,0:14:04.66,TEXT-JP,,0,0,0,,えっ　ご機嫌ななめやな
Dialogue: 0,0:14:17.80,0:14:20.76,TEXT-JP,,0,0,0,,俺の変顔によしきが笑わへん
Dialogue: 0,0:14:21.42,0:14:23.68,TEXT-JP,,0,0,0,,ねえ　ほんまにどしたん
Dialogue: 0,0:14:23.68,0:14:25.68,TEXT-JP,,0,1000,0,,顔色ドブみたいやで
Dialogue: 0,0:14:24.97,0:14:26.18,TEXT-JP,,800,0,0,,しつけえな
Dialogue: 0,0:14:26.64,0:14:28.68,TEXT-JP,,0,0,0,,ホント　一人にして
Dialogue: 0,0:14:28.68,0:14:30.56,TEXT-JP,,0,0,0,,ガ…ガーン
Dialogue: 0,0:14:32.10,0:14:33.48,TEXT-JP,,0,0,0,,マジか…
Dialogue: 0,0:14:44.11,0:14:45.70,TEXT-JP,,0,0,0,,俺のせいなん
Dialogue: 0,0:14:46.87,0:14:47.70,TEXT-JP,,0,0,0,,何が？
Dialogue: 0,0:14:47.70,0:14:50.95,TEXT-JP,,0,0,0,,やってさ　明らかに当たりきついやん
Dialogue: 0,0:14:50.95,0:14:53.46,TEXT-JP,,0,0,0,,何？俺にキレとんの
Dialogue: 0,0:14:53.96,0:14:55.33,TEXT-JP,,0,0,0,,別にキレとらん
Dialogue: 0,0:14:55.33,0:14:57.13,TEXT-JP,,0,0,0,,いや　キレとるやん
Dialogue: 0,0:14:57.13,0:14:58.42,TEXT-JP,,0,0,0,,最近なんなん？
Dialogue: 0,0:14:58.46,0:15:00.67,TEXT-JP,,0,0,0,,俺になんか隠しとらへん
Dialogue: 0,0:15:00.67,0:15:03.84,TEXT-JP,,0,0,0,,はあ　なんやそれ　詮索しとんのか
Dialogue: 0,0:15:03.84,0:15:05.47,TEXT-JP,,0,0,0,,キモいぞ　お前
Dialogue: 0,0:15:07.72,0:15:11.22,TEXT-JP,,0,0,0,,じゃあ　この前の週末　なんで町の方来とったん
Dialogue: 0,0:15:11.72,0:15:16.10,TEXT-JP,,0,0,0,,知らん人とメッセージ…やりとりしてるのはなんなん
Dialogue: 0,0:15:16.10,0:15:18.73,TEXT-JP,,0,0,0,,な…なんで…
Dialogue: 0,0:15:18.73,0:15:21.11,TEXT-JP,,0,0,0,,つうか　なんでも言わなあかんのか
Dialogue: 0,0:15:21.11,0:15:23.61,TEXT-JP,,0,0,0,,前は結構なんでも話しとったと思うけど
Dialogue: 0,0:15:23.61,0:15:24.57,TEXT-JP,,0,0,0,,前って！
Dialogue: 0,0:15:24.57,0:15:28.07,TEXT-JP,,0,0,0,,さも　自分のことのように言うけどな…
Dialogue: 0,0:15:31.95,0:15:33.79,TEXT-JP,,0,0,0,,やっぱそうなん？
Dialogue: 0,0:15:35.00,0:15:36.54,TEXT-JP,,0,0,0,,俺が本当の…
Dialogue: 0,0:15:38.54,0:15:40.38,TEXT-JP,,0,0,0,,光とちゃうから？
Dialogue: 0,0:15:48.39,0:15:51.97,TEXT-JP,,0,0,0,,なあ　やっぱり俺じゃダメなん？
Dialogue: 0,0:15:53.18,0:15:53.97,TEXT-JP,,0,0,0,,おい
Dialogue: 0,0:15:56.85,0:15:59.69,TEXT-JP,,0,0,0,,当たり前やろ　お前は…
Dialogue: 0,0:15:59.69,0:16:04.99,TEXT-JP,,0,0,0,,声も見た目もしゃべり方も　光そっくりやけどさあ
Dialogue: 0,0:16:05.36,0:16:06.90,TEXT-JP,,0,0,0,,光ちゃうやんか
Dialogue: 0,0:16:12.53,0:16:15.16,TEXT-JP,,0,0,0,,ごめん　そうよな
Dialogue: 0,0:16:16.41,0:16:20.42,TEXT-JP,,0,0,0,,普通に…それはそうや
Dialogue: 0,0:16:26.17,0:16:27.30,TEXT-JP,,0,0,0,,痛っ
Dialogue: 0,0:16:28.22,0:16:32.18,TEXT-JP,,0,0,0,,でも俺　よしきがおらんとダメなんよ
Dialogue: 0,0:16:32.18,0:16:33.18,TEXT-JP,,0,0,0,,消えろ
Dialogue: 0,0:16:33.18,0:16:34.22,TEXT-JP,,0,0,0,,だって俺の…
Dialogue: 0,0:16:34.22,0:16:36.73,TEXT-JP,,0,0,0,,正直　もうお前いらんねん
Dialogue: 0,0:16:36.73,0:16:37.81,TEXT-JP,,0,0,0,,初めての…
Dialogue: 0,0:16:37.81,0:16:40.44,TEXT-JP,,0,0,0,,お前みたいなニセモノは
Dialogue: 0,0:16:40.44,0:16:42.19,TEXT-JP,,0,0,0,,ニセモノは
Dialogue: 0,0:16:42.19,0:16:45.78,TEXT-JP,,0,0,0,,ニセモノは
Dialogue: 0,0:16:47.49,0:16:49.36,TEXT-JP,,0,0,0,,もうさあ
Dialogue: 0,0:16:49.36,0:16:53.16,TEXT-JP,,0,0,0,,どこまでが自分の感情なんか　分からん
Dialogue: 0,0:16:53.74,0:16:54.70,TEXT-JP,,0,0,0,,あかんて
Dialogue: 0,0:16:55.83,0:16:58.46,TEXT-JP,,0,0,0,,このまま一緒におったらあかんって
Dialogue: 0,0:17:00.54,0:17:01.92,TEXT-JP,,0,0,0,,分かってても
Dialogue: 0,0:17:01.92,0:17:04.34,TEXT-JP,,0,0,0,,お前を好きなんやめられへん
Dialogue: 0,0:17:27.61,0:17:31.61,TEXT-JP,,0,0,0,,気持ち悪い　気持ち悪い　気持ち悪い…
Dialogue: 0,0:17:32.11,0:17:34.83,TEXT-JP,,0,0,0,,気持ちいい　気持ちいい
Dialogue: 0,0:17:34.83,0:17:38.08,TEXT-JP,,0,0,0,,気持ちいい　気持ちいい…
Dialogue: 0,0:17:38.08,0:17:39.91,TEXT-JP,,0,0,0,,なんや　これ
Dialogue: 0,0:17:40.54,0:17:44.63,TEXT-JP,,0,0,0,,ナニカが流れ込んでくる…
Dialogue: 0,0:17:47.09,0:17:49.88,TEXT-JP,,0,0,0,,光　やない
Dialogue: 0,0:17:50.30,0:17:51.51,TEXT-JP,,0,0,0,,なんか持って
Dialogue: 0,0:17:56.31,0:17:57.85,TEXT-JP,,0,0,0,,ヒ…ヒカル
Dialogue: 0,0:17:57.85,0:18:01.10,TEXT-JP,,0,0,0,,あかん　あかんて
Dialogue: 0,0:18:01.10,0:18:02.94,TEXT-JP,,0,0,0,,こいつだけは…
Dialogue: 0,0:18:06.23,0:18:07.32,TEXT-JP,,0,0,0,,ごめん
Dialogue: 0,0:18:20.79,0:18:22.87,TEXT-JP,,0,0,0,,嫌いにならんで
Dialogue: 0,0:18:34.30,0:18:36.39,TEXT-JP,,0,0,0,,あいつは光の代わりや
Dialogue: 0,0:18:37.72,0:18:42.64,TEXT-JP,,0,0,0,,俺は最低やから　変なとこは見やんようにしてさ
Dialogue: 0,0:18:44.23,0:18:47.15,TEXT-JP,,0,0,0,,あいつが完全に光になれやんように
Dialogue: 0,0:18:48.61,0:18:51.94,TEXT-JP,,0,0,0,,俺もあいつを完全に光として扱えんのや
Dialogue: 0,0:18:53.70,0:18:57.53,TEXT-JP,,0,0,0,,やから　あんなこと　言って…
Dialogue: 0,0:18:59.83,0:19:01.08,TEXT-JP,,0,0,0,,バイバイ
Dialogue: 0,0:19:01.08,0:19:02.16,TEXT-JP,,0,0,0,,またね
Dialogue: 0,0:19:06.83,0:19:09.63,TEXT-JP,,0,0,0,,なあ　光となんかあった
Dialogue: 0,0:19:09.63,0:19:12.30,TEXT-JP,,0,0,0,,光が休むとか変やん
Dialogue: 0,0:19:12.30,0:19:14.88,TEXT-JP,,0,0,0,,よしきも闇のオーラ　ぶわあ出とるし
Dialogue: 0,0:19:14.88,0:19:17.89,TEXT-JP,,0,0,0,,昨日　あのあとケンカでもしたん
Dialogue: 0,0:19:19.64,0:19:22.02,TEXT-JP,,0,0,0,,何あったか知らんけどさ
Dialogue: 0,0:19:22.02,0:19:23.85,TEXT-JP,,0,0,0,,仲直りしてや
Dialogue: 0,0:19:23.85,0:19:27.19,TEXT-JP,,0,0,0,,最近の光　なんかよしき大好き感すごいし
Dialogue: 0,0:19:27.19,0:19:28.69,TEXT-JP,,0,0,0,,かわいそうやもん
Dialogue: 0,0:19:30.23,0:19:34.95,TEXT-JP,,0,0,0,,いやでもほんまに光は最近なついてるっていうか
Dialogue: 0,0:19:34.95,0:19:38.45,TEXT-JP,,0,0,0,,なっ　親についていく　ガキっちゅうか
Dialogue: 0,0:19:38.45,0:19:40.91,TEXT-JP,,0,0,0,,いや　急に口悪っ
Dialogue: 0,0:19:40.91,0:19:43.45,TEXT-JP,,0,0,0,,極道映画の見過ぎや
Dialogue: 0,0:19:43.45,0:19:46.04,TEXT-JP-U,,0,0,0,,いてこますぞ　ワレエ
Dialogue: 0,0:19:44.16,0:19:45.41,TEXT-JP,,0,0,0,,子供…
Dialogue: 0,0:19:46.04,0:19:47.42,TEXT-JP,,0,0,0,,よしき　よしき
Dialogue: 0,0:19:47.42,0:19:49.54,TEXT-JP,,0,0,0,,よしき　よしき
Dialogue: 0,0:19:49.54,0:19:51.67,TEXT-JP,,0,0,0,,嫌いにならんで
Dialogue: 0,0:19:53.59,0:19:54.59,TEXT-JP,,0,0,0,,俺…
Dialogue: 0,0:19:55.42,0:19:57.18,TEXT-JP,,0,0,0,,俺もう行くわ
Dialogue: 0,0:19:57.80,0:19:59.93,TEXT-JP,,0,0,0,,またあした
Dialogue: 0,0:20:23.83,0:20:25.25,TEXT-JP,,0,0,0,,ヒカルおる？
Dialogue: 0,0:20:36.84,0:20:38.59,TEXT-JP,,0,0,0,,昨日はごめん
Dialogue: 0,0:20:40.59,0:20:42.93,TEXT-JP,,0,0,0,,なんでよしきが謝んねん
Dialogue: 0,0:20:43.56,0:20:46.56,TEXT-JP,,0,0,0,,俺のほうこそ…俺…
Dialogue: 0,0:20:47.10,0:20:49.73,TEXT-JP,,0,0,0,,俺　お前に　あんな…
Dialogue: 0,0:20:50.35,0:20:51.73,TEXT-JP,,0,0,0,,もうええって
Dialogue: 0,0:20:54.98,0:20:58.49,TEXT-JP,,0,0,0,,ほらあ　ビック~なっとるやん
Dialogue: 0,0:20:58.74,0:21:00.41,TEXT-JP,,0,0,0,,おびえとるやんか
Dialogue: 0,0:21:00.86,0:21:03.62,TEXT-JP,,0,0,0,,お…おびえとらんし
Dialogue: 0,0:21:04.33,0:21:05.74,TEXT-JP,,0,0,0,,ウソやあ
Dialogue: 0,0:21:05.74,0:21:07.83,TEXT-JP,,0,0,0,,あんなん見せてもうたもん
Dialogue: 0,0:21:07.83,0:21:11.12,TEXT-JP,,0,0,0,,めっちゃグロいやん　恥ずかしい
Dialogue: 0,0:21:11.54,0:21:13.21,TEXT-JP,,0,0,0,,あ…そっち
Dialogue: 0,0:21:13.21,0:21:14.63,TEXT-JP,,0,0,0,,いや　なんか…
Dialogue: 0,0:21:16.21,0:21:19.38,TEXT-JP,,0,0,0,,ごめん　嫌いになった？
Dialogue: 0,0:21:23.26,0:21:25.72,TEXT-JP,,0,0,0,,よしき…俺　あのさ
Dialogue: 0,0:21:26.47,0:21:29.98,TEXT-JP,,0,0,0,,お前のそばにおれるだけでええから
Dialogue: 0,0:21:32.10,0:21:35.23,TEXT-JP,,0,0,0,,もう誰と会ってようがどうでもええ
Dialogue: 0,0:21:35.69,0:21:37.61,TEXT-JP,,0,0,0,,嫌われたないから
Dialogue: 0,0:21:38.28,0:21:40.11,TEXT-JP,,0,0,0,,もう　あんなことせん
Dialogue: 0,0:21:40.11,0:21:43.70,TEXT-JP,,0,0,0,,お前の友達の体　勝手に使っとるヤツが
Dialogue: 0,0:21:44.49,0:21:46.87,TEXT-JP,,0,0,0,,ずうずうしくてごめん
Dialogue: 0,0:21:48.33,0:21:49.87,TEXT-JP,,0,0,0,,こいつは…
Dialogue: 0,0:21:52.37,0:21:55.29,TEXT-JP,,0,0,0,,一緒におったら　あかん
Dialogue: 0,0:21:55.29,0:21:56.50,TEXT-JP,,0,0,0,,危険や
Dialogue: 0,0:21:57.05,0:21:58.38,TEXT-JP,,0,0,0,,けど…
Dialogue: 0,0:22:03.64,0:22:05.89,TEXT-JP,,0,0,0,,お前　やっぱり
Dialogue: 0,0:22:05.89,0:22:08.39,TEXT-JP,,0,0,0,,光よりガキくさいんやな
Dialogue: 0,0:22:09.68,0:22:11.02,TEXT-JP,,0,0,0,,ええの
Dialogue: 0,0:22:11.02,0:22:11.81,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:22:12.44,0:22:15.27,TEXT-JP,,0,0,0,,お前はガキくさくて寂しがりやな
Dialogue: 0,0:22:15.86,0:22:17.15,TEXT-JP,,0,0,0,,寂しい…
Dialogue: 0,0:22:17.61,0:22:20.07,TEXT-JP,,0,0,0,,こういうんが「寂しい」なんか
Dialogue: 0,0:22:23.61,0:22:24.41,TEXT-JP,,0,0,0,,さあ
Dialogue: 0,0:22:26.20,0:22:28.66,TEXT-JP,,0,0,0,,ヒカルはなんも知らんだけかも
Dialogue: 0,0:22:29.41,0:22:31.20,TEXT-JP,,0,0,0,,もしそうなんやったら
Dialogue: 0,0:22:33.25,0:22:34.25,TEXT-JP,,0,0,0,,俺が…
Dialogue: 0,0:22:36.50,0:22:37.59,TEXT-JP,,0,0,0,,俺が…
Dialogue: 0,0:22:39.30,0:22:41.17,TEXT-JP,,0,0,0,,俺が教えてやらんと
