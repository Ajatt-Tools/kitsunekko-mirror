Dialogue: 0,0:00:02.36,0:00:03.57,TEXT-JP,,0,0,0,,ただいま
Dialogue: 0,0:00:06.49,0:00:08.74,TEXT-JP,,0,0,0,,生きとるほうが大切なん？
Dialogue: 0,0:00:09.99,0:00:11.49,TEXT-JP,,0,0,0,,朝子
Dialogue: 0,0:00:13.79,0:00:15.83,TEXT-JP,,0,0,0,,俺が教えてやらんと
Dialogue: 0,0:00:30.93,0:00:32.01,TEXT-JP,,0,0,0,,ヒカル
Dialogue: 0,0:00:33.26,0:00:34.68,TEXT-JP,,0,0,0,,学校行くで
Dialogue: 0,0:00:43.77,0:00:46.86,TEXT-JP,,0,0,0,,おとついのこと　怒っとらんの
Dialogue: 0,0:00:51.24,0:00:54.91,TEXT-JP,,0,0,0,,今日　合唱コンクール大丈夫なんかな
Dialogue: 0,0:00:54.91,0:01:00.25,TEXT-JP,,0,0,0,,ハラセンも「結果はどうあれ　一生懸命な」って諦めて
Dialogue: 0,0:01:12.64,0:01:15.76,TEXT-JP,,0,0,0,,今日　学校サボろうか
Dialogue: 0,0:01:17.31,0:01:18.10,TEXT-JP,,0,0,0,,えっ
Dialogue: 0,0:02:49.48,0:02:51.82,TEXT-JP,,0,0,0,,今日の合唱コンな
Dialogue: 0,0:02:51.82,0:02:52.82,TEXT-JP,,0,0,0,,歌詞覚えたん？
Dialogue: 0,0:02:52.82,0:02:54.03,TEXT-JP,,0,0,0,,全然
Dialogue: 0,0:02:54.03,0:02:56.78,TEXT-JP,,0,0,0,,ヤッバ　もう緊張してきた
Dialogue: 0,0:02:56.78,0:02:58.45,TEXT-JP,,0,0,0,,A組大丈夫なん？
Dialogue: 0,0:02:58.45,0:03:00.28,TEXT-JP,,0,0,0,,D組優勝
Dialogue: 0,0:03:00.54,0:03:02.91,TEXT-JP,,0,0,0,,一生懸命やる　やらん？
Dialogue: 0,0:03:03.33,0:03:04.54,TEXT-JP,,0,0,0,,口パクやめえや
Dialogue: 0,0:03:06.00,0:03:08.29,TEXT-JP,,0,0,0,,あっつ
Dialogue: 0,0:03:08.29,0:03:10.63,TEXT-JP,,0,0,0,,あーちゃん　おはよう
Dialogue: 0,0:03:15.51,0:03:18.05,TEXT-JP,,0,0,0,,ユーちゃん　いつからおったん？
Dialogue: 0,0:03:18.05,0:03:19.64,TEXT-JP,,0,0,0,,もしや　アサシン
Dialogue: 0,0:03:19.64,0:03:23.31,TEXT-JP,,0,0,0,,アサシンちゃうわ　普通に声かけたで
Dialogue: 0,0:03:22.52,0:03:23.85,TEXT-JP-U,,0,0,0,,おはよう
Dialogue: 0,0:03:23.31,0:03:26.23,TEXT-JP,,0,0,0,,そうなん？聞こえんかった
Dialogue: 0,0:03:26.23,0:03:29.40,TEXT-JP,,0,0,0,,なんでやろ　あれ
Dialogue: 0,0:03:29.98,0:03:32.44,TEXT-JP,,0,0,0,,あんな　クラスの男子がな
Dialogue: 0,0:03:32.44,0:03:35.40,TEXT-JP,,0,0,0,,合唱コンで振り付け入れよう言うとるで
Dialogue: 0,0:03:35.40,0:03:37.49,TEXT-JP,,0,0,0,,ほんまにアホ
Dialogue: 0,0:03:39.07,0:03:41.49,TEXT-JP,,0,0,0,,あの振り付けは無理やろ
Dialogue: 0,0:03:41.49,0:03:43.54,TEXT-JP,,0,0,0,,直前に血迷いすぎ
Dialogue: 0,0:03:43.54,0:03:45.62,TEXT-JP,,0,0,0,,間奏でラップもって
Dialogue: 0,0:03:47.58,0:03:49.67,TEXT-JP,,0,0,0,,合唱コンで俺ら勝つぜ
Dialogue: 0,0:03:49.67,0:03:51.79,TEXT-JP,,0,0,0,,刺激するぜ　その感受性
Dialogue: 0,0:03:51.79,0:03:54.63,TEXT-JP,,0,0,0,,ここまで来たらやぶれかぶれ
Dialogue: 0,0:03:56.76,0:03:57.72,TEXT-JP,,0,0,0,,いけるか
Dialogue: 0,0:03:57.72,0:03:59.05,TEXT-JP,,0,0,0,,やろ
Dialogue: 0,0:03:59.05,0:04:00.89,TEXT-JP,,0,0,0,,巻　かっけえ
Dialogue: 0,0:04:00.89,0:04:01.93,TEXT-JP-U,,0,0,0,,ありがとう
Dialogue: 0,0:04:01.22,0:04:02.89,TEXT-JP,,0,0,0,,トリッキーすぎるって
Dialogue: 0,0:04:02.89,0:04:05.06,TEXT-JP,,0,0,0,,さすがに阻止したい
Dialogue: 0,0:04:05.06,0:04:07.69,TEXT-JP,,0,0,0,,よしきがおれば止めるやろ
Dialogue: 0,0:04:09.77,0:04:11.94,TEXT-JP,,0,0,0,,まだ来とらんみたいやね
Dialogue: 0,0:04:11.94,0:04:13.11,TEXT-JP,,0,0,0,,光も
Dialogue: 0,0:04:13.94,0:04:14.98,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:04:28.96,0:04:31.00,TEXT-JP,,0,0,0,,はよ行かな怒られんで
Dialogue: 0,0:04:31.00,0:04:33.75,TEXT-JP,,0,0,0,,こういうときに張り切るヤツ　ウザ
Dialogue: 0,0:04:34.21,0:04:37.63,TEXT-JP,,0,0,0,,なあ　学校サボってええの
Dialogue: 0,0:04:38.76,0:04:43.22,TEXT-JP,,0,0,0,,俺ら　ふだん出席率ええし　ハラセンも怒らんやろ
Dialogue: 0,0:04:44.14,0:04:48.52,TEXT-JP,,0,0,0,,よしきは怒っとらんの　おとついの…
Dialogue: 0,0:04:51.40,0:04:53.61,TEXT-JP,,0,0,0,,別に怒っとらんよ
Dialogue: 0,0:04:56.32,0:04:57.74,TEXT-JP,,0,0,0,,そうか
Dialogue: 0,0:04:58.11,0:04:59.03,TEXT-JP,,0,0,0,,見てみ
Dialogue: 0,0:05:00.20,0:05:04.95,TEXT-JP,,0,0,0,,こんなあっつい中　ケッタ全力疾走って難儀やな
Dialogue: 0,0:05:04.95,0:05:06.87,TEXT-JP,,0,0,0,,いつもの俺らやん
Dialogue: 0,0:05:08.20,0:05:09.16,TEXT-JP,,0,0,0,,そっか
Dialogue: 0,0:05:15.09,0:05:18.05,TEXT-JP,,0,0,0,,辻中さん　おはようございます
Dialogue: 0,0:05:18.05,0:05:20.05,TEXT-JP,,0,0,0,,おはよう　あっついな
Dialogue: 0,0:05:20.05,0:05:23.18,TEXT-JP,,0,0,0,,っすね　今日もよろしくお願いします
Dialogue: 0,0:05:23.18,0:05:25.22,TEXT-JP,,0,0,0,,そろそろ慣れた？
Dialogue: 0,0:05:25.22,0:05:26.89,TEXT-JP,,0,0,0,,はあ　だいぶ
Dialogue: 0,0:05:26.89,0:05:30.06,TEXT-JP,,0,0,0,,でも　真夏にヘルメットは地獄すね
Dialogue: 0,0:05:30.06,0:05:31.73,TEXT-JP,,0,0,0,,帽子じゃダメっすか
Dialogue: 0,0:05:31.73,0:05:34.90,TEXT-JP,,0,0,0,,安全第一やから横着はあかんよ
Dialogue: 0,0:05:35.86,0:05:36.82,TEXT-JP,,0,0,0,,はい
Dialogue: 0,0:05:41.40,0:05:43.87,TEXT-JP,,0,0,0,,なあ　今日もええの
Dialogue: 0,0:05:43.87,0:05:47.83,TEXT-JP,,0,0,0,,いいよ　学校は無理して行くもんじゃない
Dialogue: 0,0:06:00.01,0:06:02.26,TEXT-JP,,0,0,0,,なあ　どこ行くん？
Dialogue: 0,0:06:04.55,0:06:07.93,TEXT-JP,,0,0,0,,映画　お前好きやろ
Dialogue: 0,0:06:12.94,0:06:18.40,TEXT-JP-U,,0,0,0,,夜空はやがてまた朝日
Dialogue: 0,0:06:12.94,0:06:18.40,TEXT-JP-U,,0,0,0,,{\fs30\bord2.5\pos(1120,5)}あした
Dialogue: 0,0:06:18.40,0:06:21.82,TEXT-JP-U,,0,0,0,,願いを乗せた…
Dialogue: 0,0:06:20.74,0:06:21.82,TEXT-JP,,0,0,0,,ヤバッ
Dialogue: 0,0:06:22.11,0:06:24.24,TEXT-JP,,0,0,0,,めっちゃ気合い入っとるやん
Dialogue: 0,0:06:24.24,0:06:27.33,TEXT-JP,,0,0,0,,今からでも遅ない　ヲタ芸やめようや
Dialogue: 0,0:06:27.33,0:06:29.58,TEXT-JP,,0,0,0,,クソッ　練習したんに
Dialogue: 0,0:06:32.50,0:06:35.58,TEXT-JP,,0,0,0,,なあ　よしきと光　まだ来とらんよ
Dialogue: 0,0:06:36.08,0:06:38.09,TEXT-JP,,0,0,0,,今日は休みなんかな
Dialogue: 0,0:06:38.67,0:06:39.84,TEXT-JP,,0,0,0,,まだ腹イタか
Dialogue: 0,0:06:39.84,0:06:43.01,TEXT-JP,,0,0,0,,サボりやろ　ええなあ
Dialogue: 0,0:06:52.89,0:06:54.10,TEXT-JP,,0,0,0,,ただいま
Dialogue: 0,0:07:04.61,0:07:10.24,TEXT-JP,,0,0,0,,母さん　かおる　父さん
Dialogue: 0,0:07:11.41,0:07:12.54,TEXT-JP,,0,0,0,,ごめん
Dialogue: 0,0:07:20.92,0:07:22.51,TEXT-JP,,0,0,0,,リンシャン
Dialogue: 0,0:07:22.80,0:07:24.47,TEXT-JP,,0,0,0,,楽しないん？
Dialogue: 0,0:07:23.01,0:07:25.09,TEXT-JP-U,,0,0,0,,俺はリンシャンを救けに行くんだ
Dialogue: 0,0:07:24.47,0:07:25.42,TEXT-JP,,0,0,0,,いや
Dialogue: 0,0:07:25.09,0:07:27.89,TEXT-JP-U,,0,0,0,,待て　あいつらの力を見たか
Dialogue: 0,0:07:25.72,0:07:28.59,TEXT-JP,,0,0,0,,ホント　怒っとらんから見よに
Dialogue: 0,0:07:27.89,0:07:29.89,TEXT-JP-U,,0,0,0,,今の僕たちには無理だ
Dialogue: 0,0:07:28.59,0:07:30.51,TEXT-JP,,0,0,0,,この映画　見たがっとったやろ
Dialogue: 0,0:07:29.89,0:07:32.68,TEXT-JP-U,,0,0,0,,リンシャンを見捨てるわけにはいかないんだ
Dialogue: 0,0:07:31.51,0:07:32.68,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:07:32.68,0:07:36.27,TEXT-JP,,0,0,0,,嫌だ　ツモは僕にとって世界で一人のともだ…
Dialogue: 0,0:07:39.15,0:07:43.90,TEXT-JP,,0,0,0,,続いては2年A組による課題曲「日々の影」です
Dialogue: 0,0:08:15.64,0:08:21.98,TEXT-JP,,0,0,0,,いつしか冬枯れは春に
Dialogue: 0,0:08:21.98,0:08:27.57,TEXT-JP,,0,0,0,,夜空はやがてまた朝日
Dialogue: 2,0:08:21.98,0:08:27.57,TEXT-JP,,0,0,0,,{\fs30\bord2.5\pos(1142,990)}あした
Dialogue: 0,0:08:27.57,0:08:33.70,TEXT-JP,,0,0,0,,願いを乗せた雲の群れを
Dialogue: 0,0:08:33.70,0:08:40.92,TEXT-JP,,0,0,0,,走らせて知れない未来へと
Dialogue: 0,0:08:40.92,0:08:47.42,TEXT-JP,,0,0,0,,静かに夢を見てごらん
Dialogue: 0,0:08:47.42,0:08:52.93,TEXT-JP,,0,0,0,,密かに探し求めてごらん
Dialogue: 0,0:08:52.93,0:08:59.19,TEXT-JP,,0,0,0,,過ぎ去った明かりは戻らなくとも
Dialogue: 0,0:08:59.19,0:09:08.19,TEXT-JP,,0,0,0,,この胸を躍らせる未来こそ　今
Dialogue: 0,0:09:08.19,0:09:12.11,TEXT-JP,,0,0,0,,嬉しさよ　友よ
Dialogue: 0,0:09:12.11,0:09:17.08,TEXT-JP,,0,0,0,,赫うあの日々の影
Dialogue: 0,0:09:18.29,0:09:20.87,TEXT-JP,,0,0,0,,追いかけ　回る
Dialogue: 0,0:09:20.87,0:09:24.50,TEXT-JP,,0,0,0,,虚しさよ　友よ
Dialogue: 0,0:09:24.50,0:09:29.67,TEXT-JP,,0,0,0,,彷徨う心を描いて
Dialogue: 0,0:09:30.84,0:09:36.18,TEXT-JP,,0,0,0,,忘れず追い続けてゆく
Dialogue: 0,0:09:38.85,0:09:40.48,TEXT-JP,,0,0,0,,やっぱよしきスゲえ
Dialogue: 0,0:09:42.65,0:09:46.23,TEXT-JP,,0,0,0,,ありがとう　めっちゃ大事にするわ
Dialogue: 0,0:09:46.98,0:09:49.65,TEXT-JP,,0,0,0,,よしきはホント優しいな
Dialogue: 0,0:09:52.11,0:09:55.91,TEXT-JP,,0,0,0,,悲しさよ　友よ
Dialogue: 0,0:09:55.91,0:10:00.91,TEXT-JP,,0,0,0,,赫うこの日々の影
Dialogue: 0,0:10:02.33,0:10:04.67,TEXT-JP,,0,0,0,,追いかけ　回る
Dialogue: 0,0:10:04.67,0:10:08.55,TEXT-JP,,0,0,0,,幸せよ　友よ
Dialogue: 0,0:10:08.55,0:10:13.55,TEXT-JP,,0,0,0,,彷徨う心を開いて…
Dialogue: 0,0:10:14.43,0:10:15.59,TEXT-JP,,0,0,0,,母さん
Dialogue: 0,0:10:15.01,0:10:20.98,TEXT-JP-U,,0,0,0,,忘れず追い続けてゆく
Dialogue: 0,0:10:15.59,0:10:17.89,TEXT-JP,,0,0,0,,どうしたの　急に電話してきて
Dialogue: 0,0:10:17.89,0:10:20.68,TEXT-JP,,0,0,0,,いや　まあ　元気かな思て
Dialogue: 0,0:10:21.10,0:10:22.73,TEXT-JP,,0,0,0,,元気だよ
Dialogue: 0,0:10:22.73,0:10:26.86,TEXT-JP,,0,0,0,,うん　そうか　よかった
Dialogue: 0,0:10:27.57,0:10:29.28,TEXT-JP,,0,0,0,,ありがとう
Dialogue: 0,0:10:30.94,0:10:32.32,TEXT-JP,,0,0,0,,母さん
Dialogue: 0,0:10:42.00,0:10:43.50,TEXT-JP,,0,0,0,,そしたら
Dialogue: 0,0:10:43.50,0:10:45.50,TEXT-JP,,0,0,0,,よかったやん
Dialogue: 0,0:10:45.50,0:10:47.88,TEXT-JP,,0,0,0,,ヲタ芸はあえてやらんかったんよ
Dialogue: 0,0:10:50.25,0:10:51.55,TEXT-JP,,0,0,0,,父さんにも…
Dialogue: 0,0:10:52.13,0:10:53.63,TEXT-JP,,0,0,0,,スッゲえ
Dialogue: 0,0:10:55.30,0:10:56.51,TEXT-JP,,0,0,0,,よろしく
Dialogue: 0,0:11:09.06,0:11:11.94,TEXT-JP,,0,0,0,,結局　よしきたち来やんかったな
Dialogue: 0,0:11:12.36,0:11:15.78,TEXT-JP,,0,0,0,,あとでハラセンが撮った動画送りつけようや
Dialogue: 0,0:11:16.20,0:11:17.53,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:11:17.91,0:11:21.41,TEXT-JP,,0,0,0,,杉が倒れてるところ　迫力すごいっすね
Dialogue: 0,0:11:21.41,0:11:24.08,TEXT-JP,,0,0,0,,息子さんにも見せたら　喜ぶんやないっすか
Dialogue: 0,0:11:24.08,0:11:26.79,TEXT-JP,,0,0,0,,喜ぶって年でもないし
Dialogue: 0,0:11:26.79,0:11:29.04,TEXT-JP,,0,0,0,,息子とはほとんどしゃべっとらんよ
Dialogue: 0,0:11:29.04,0:11:30.71,TEXT-JP,,0,0,0,,そうなんすか
Dialogue: 0,0:11:31.50,0:11:35.42,TEXT-JP,,0,0,0,,いろいろとな　難しくて
Dialogue: 0,0:11:36.43,0:11:40.30,TEXT-JP,,0,0,0,,兄ちゃんいつにも増して声ちっさなかった？
Dialogue: 0,0:11:41.47,0:11:44.39,TEXT-JP,,0,0,0,,つうかあいつ　学校サボってない？
Dialogue: 0,0:11:53.94,0:11:58.66,TEXT-JP,,0,0,0,,この川って　海まで続いとるんかな
Dialogue: 0,0:11:59.99,0:12:01.08,TEXT-JP,,0,0,0,,そうやろ
Dialogue: 0,0:12:02.83,0:12:05.33,TEXT-JP,,0,0,0,,海行きたいんか
Dialogue: 0,0:12:05.33,0:12:08.87,TEXT-JP,,0,0,0,,海って　デッカいよな
Dialogue: 0,0:12:08.87,0:12:11.34,TEXT-JP,,0,0,0,,記憶の中にもぼんやりある
Dialogue: 0,0:12:12.00,0:12:15.13,TEXT-JP,,0,0,0,,光とは学校帰りに行ってたな
Dialogue: 0,0:12:15.13,0:12:16.22,TEXT-JP,,0,0,0,,真冬に
Dialogue: 0,0:12:18.97,0:12:23.10,TEXT-JP,,0,0,0,,ここは山ばっかやからさ　また行きたいな
Dialogue: 0,0:12:23.51,0:12:27.35,TEXT-JP,,0,0,0,,ほんで泳ぎまくって　サメ捕まえよ
Dialogue: 0,0:12:28.64,0:12:31.36,TEXT-JP,,0,0,0,,サメは簡単に捕まらんよ
Dialogue: 0,0:12:32.61,0:12:34.98,TEXT-JP,,0,0,0,,ほしたら　お前をおとりにして
Dialogue: 0,0:12:34.98,0:12:35.61,TEXT-JP,,0,0,0,,おい
Dialogue: 0,0:12:35.61,0:12:38.95,TEXT-JP,,0,0,0,,こう　サメが食うとる間に銛でグサッと
Dialogue: 0,0:12:38.95,0:12:39.95,TEXT-JP,,0,0,0,,死ぬやん
Dialogue: 0,0:12:49.67,0:12:52.21,TEXT-JP,,0,0,0,,今度行こに　海
Dialogue: 0,0:12:52.75,0:12:54.09,TEXT-JP,,0,0,0,,夏休みとか
Dialogue: 0,0:13:01.80,0:13:04.39,TEXT-JP,,0,0,0,,アイスやろ　映画やろ
Dialogue: 0,0:13:04.39,0:13:07.06,TEXT-JP,,0,0,0,,いろんなこと知るって楽しいわ
Dialogue: 0,0:13:10.02,0:13:12.35,TEXT-JP,,0,0,0,,よしきもおるし
Dialogue: 0,0:13:19.53,0:13:23.62,TEXT-JP,,0,0,0,,もちろん　お前が…よければ
Dialogue: 0,0:13:34.92,0:13:37.63,TEXT-JP,,0,0,0,,ええよ　海行こうな
Dialogue: 0,0:13:38.21,0:13:39.26,TEXT-JP,,0,0,0,,今度
Dialogue: 0,0:13:46.01,0:13:50.48,TEXT-JP,,0,0,0,,サボっても　結局いつもどおりよしきんちで遊ぶっつう
Dialogue: 0,0:13:50.48,0:13:53.40,TEXT-JP,,0,0,0,,ええやろ別に　外あっついし
Dialogue: 0,0:13:54.27,0:13:55.40,TEXT-JP,,0,0,0,,ただいま
Dialogue: 0,0:14:11.75,0:14:13.71,TEXT-JP,,0,0,0,,おじゃまします
Dialogue: 0,0:14:19.21,0:14:21.63,TEXT-JP,,0,0,0,,なあ　ロンとツモって
Dialogue: 0,0:14:21.63,0:14:23.97,TEXT-JP,,0,0,0,,なんであんなに仲ええんやろな
Dialogue: 0,0:14:24.47,0:14:28.47,TEXT-JP,,0,0,0,,ロンにとってツモは唯一の友達やからやろ
Dialogue: 0,0:14:29.06,0:14:30.56,TEXT-JP,,0,0,0,,そうかあ
Dialogue: 0,0:14:33.89,0:14:36.98,TEXT-JP,,0,0,0,,今日の合唱コンの動画　送られてきたに
Dialogue: 0,0:14:38.02,0:14:38.98,TEXT-JP,,0,0,0,,マジ？
Dialogue: 0,0:14:39.61,0:14:45.99,TEXT-JP-U,,0,0,0,,静かに夢を見てごらん
Dialogue: 0,0:14:45.99,0:14:51.54,TEXT-JP-U,,0,0,0,,密かに探し求めてごらん
Dialogue: 0,0:14:46.45,0:14:48.33,TEXT-JP,,0,0,0,,結構うまいやん
Dialogue: 0,0:14:49.24,0:14:50.49,TEXT-JP,,0,0,0,,そうやな
Dialogue: 0,0:14:50.87,0:14:53.37,TEXT-JP,,0,0,0,,俺も行けばよかったかもな
Dialogue: 0,0:14:51.54,0:14:54.87,TEXT-JP-U,,0,0,0,,過ぎ去った明かりは…
Dialogue: 0,0:14:54.87,0:14:57.92,TEXT-JP,,0,0,0,,…戻らなくとも
Dialogue: 0,0:14:57.92,0:15:04.01,TEXT-JP,,0,0,0,,この胸を躍らせる未来こそ
Dialogue: 0,0:15:04.01,0:15:06.89,TEXT-JP,,0,0,0,,今
Dialogue: 0,0:15:06.89,0:15:10.22,TEXT-JP,,0,0,0,,嬉しさよ　友よ
Dialogue: 0,0:15:10.60,0:15:15.48,TEXT-JP,,0,0,0,,赫うあの日々の影
Dialogue: 0,0:15:16.94,0:15:19.48,TEXT-JP,,0,0,0,,追いかけ　回る
Dialogue: 0,0:15:19.48,0:15:22.03,TEXT-JP,,0,0,0,,虚しさよ　友…
Dialogue: 0,0:15:26.41,0:15:28.32,TEXT-JP,,0,0,0,,…描いて
Dialogue: 0,0:15:29.53,0:15:34.62,TEXT-JP,,0,0,0,,忘れず追い続けてゆく
Dialogue: 0,0:15:55.06,0:15:58.23,TEXT-JP,,0,0,0,,やっぱ…死なんのな
Dialogue: 0,0:15:58.23,0:15:59.56,TEXT-JP,,0,0,0,,よしき？
Dialogue: 0,0:15:59.56,0:16:01.69,TEXT-JP,,0,0,0,,よかったやん
Dialogue: 0,0:16:05.99,0:16:08.45,TEXT-JP,,0,0,0,,俺が教えてやらんとって…
Dialogue: 0,0:16:09.07,0:16:10.49,TEXT-JP,,0,0,0,,思っとったんに
Dialogue: 0,0:16:11.41,0:16:14.41,TEXT-JP,,0,0,0,,ごめん…ごめん
Dialogue: 0,0:16:14.83,0:16:17.50,TEXT-JP,,0,0,0,,き…今日
Dialogue: 0,0:16:17.50,0:16:21.34,TEXT-JP,,0,0,0,,最初から　こうする気で…
Dialogue: 0,0:16:21.34,0:16:25.76,TEXT-JP,,0,0,0,,最後くらい楽しい思いさせたろって…
Dialogue: 0,0:16:27.09,0:16:28.84,TEXT-JP,,0,0,0,,死なんのやったら
Dialogue: 0,0:16:30.89,0:16:32.35,TEXT-JP,,0,0,0,,殺してくれ
Dialogue: 0,0:16:37.02,0:16:40.85,TEXT-JP,,0,0,0,,それはお願い…なんか
Dialogue: 0,0:16:41.40,0:16:45.03,TEXT-JP,,0,0,0,,お…俺にかなえてくれっつう
Dialogue: 0,0:16:45.61,0:16:47.40,TEXT-JP,,0,0,0,,どうしたらいい　どうしよう　どうしよう？
Dialogue: 0,0:16:47.40,0:16:49.66,TEXT-JP,,0,0,0,,よしきのお願いなら　しかたなくね？
Dialogue: 0,0:16:49.66,0:16:52.41,TEXT-JP,,0,0,0,,でも本当にお願いなんか　よしきのお願い？
Dialogue: 0,0:16:52.41,0:16:55.04,TEXT-JP,,0,0,0,,なんかせんと…殺す　殺す　殺す？
Dialogue: 0,0:16:55.04,0:16:57.66,TEXT-JP,,0,0,0,,殺す　殺す？
Dialogue: 0,0:16:57.66,0:16:58.58,TEXT-JP,,0,0,0,,殺す？
Dialogue: 0,0:17:05.05,0:17:07.09,TEXT-JP,,0,0,0,,泣いとる場合やない
Dialogue: 0,0:17:07.09,0:17:10.76,TEXT-JP,,0,0,0,,俺はきっとイノチの扱いが軽いんや
Dialogue: 0,0:17:11.22,0:17:14.85,TEXT-JP,,0,0,0,,俺にとっての当たり前は　人間にとっては
Dialogue: 0,0:17:15.51,0:17:17.10,TEXT-JP,,0,0,0,,多分怖い
Dialogue: 0,0:17:18.48,0:17:22.10,TEXT-JP,,0,0,0,,きっとそれがあかんのよな
Dialogue: 0,0:17:32.53,0:17:33.41,TEXT-JP,,0,0,0,,何しとん
Dialogue: 0,0:17:33.41,0:17:35.03,TEXT-JP,,0,0,0,,待っとって
Dialogue: 0,0:18:03.69,0:18:06.02,TEXT-JP,,0,0,0,,よしき　持っとって
Dialogue: 0,0:18:07.44,0:18:10.19,TEXT-JP,,0,0,0,,俺の中身の「半分」や
Dialogue: 0,0:18:11.03,0:18:12.61,TEXT-JP,,0,0,0,,今ちぎった
Dialogue: 0,0:18:14.87,0:18:19.29,TEXT-JP,,0,0,0,,イノチの重さ　俺にはやっぱりよう分からん
Dialogue: 0,0:18:19.95,0:18:24.92,TEXT-JP,,0,0,0,,でも　これで簡単に人殺せんくらい小さなったから
Dialogue: 0,0:18:26.38,0:18:31.09,TEXT-JP,,0,0,0,,お前　なんでそこまでして　俺に…
Dialogue: 0,0:18:33.38,0:18:37.47,TEXT-JP,,0,0,0,,俺は自分がなんなのか　よう知らん
Dialogue: 0,0:18:37.47,0:18:41.31,TEXT-JP,,0,0,0,,こうなる前は感情すらなかったと思うねん
Dialogue: 0,0:18:41.31,0:18:46.69,TEXT-JP,,0,0,0,,けど　漠然と「居場所がない」って感覚だけはあって…
Dialogue: 0,0:18:47.23,0:18:52.99,TEXT-JP,,0,0,0,,最初はさ　俺はお前にバレたら殺せばええって思っとった
Dialogue: 0,0:18:53.40,0:18:56.32,TEXT-JP,,0,0,0,,でも　なんでか殺したなくて
Dialogue: 0,0:18:56.53,0:18:57.53,TEXT-JP,,0,0,0,,分かった
Dialogue: 0,0:18:58.16,0:19:01.04,TEXT-JP,,0,0,0,,ヒカル　よろしくな
Dialogue: 0,0:19:02.08,0:19:06.38,TEXT-JP,,0,0,0,,結局　お前は俺を受け入れてくれたよな
Dialogue: 0,0:19:07.33,0:19:11.67,TEXT-JP,,0,0,0,,そのとき初めて　俺が必要なんやって
Dialogue: 0,0:19:11.67,0:19:14.09,TEXT-JP,,0,0,0,,ここにいてええんやって思った
Dialogue: 0,0:19:15.01,0:19:17.80,TEXT-JP,,0,0,0,,ずっとそれが足りんかったんやって
Dialogue: 0,0:19:19.05,0:19:20.76,TEXT-JP,,0,0,0,,理由はなんであれ
Dialogue: 0,0:19:20.76,0:19:23.52,TEXT-JP,,0,0,0,,お前は俺の居場所になってくれたやろ
Dialogue: 0,0:19:24.85,0:19:28.48,TEXT-JP,,0,0,0,,俺にとってはそれがすごく
Dialogue: 0,0:19:29.02,0:19:30.40,TEXT-JP,,0,0,0,,重要で
Dialogue: 0,0:19:31.65,0:19:34.78,TEXT-JP,,0,0,0,,ヒナの刷り込みやん　そんなん
Dialogue: 0,0:19:35.36,0:19:37.49,TEXT-JP,,0,0,0,,それでもええに
Dialogue: 0,0:19:37.49,0:19:40.87,TEXT-JP,,0,0,0,,俺にとっては　それでも
Dialogue: 0,0:19:43.54,0:19:47.58,TEXT-JP,,0,0,0,,こいつが命のこと　よう分からんのも当然や
Dialogue: 0,0:19:49.04,0:19:53.05,TEXT-JP,,0,0,0,,見えとる世界があまりにも違う
Dialogue: 0,0:19:54.67,0:19:56.51,TEXT-JP,,0,0,0,,それでも俺は…
Dialogue: 0,0:20:01.93,0:20:05.85,TEXT-JP,,0,0,0,,ほんまに俺は　何度も…
Dialogue: 0,0:20:17.74,0:20:19.57,TEXT-JP,,0,0,0,,アホやなあ
Dialogue: 0,0:20:21.78,0:20:26.29,TEXT-JP,,0,0,0,,俺はどこまでも　お前につきあうよ
Dialogue: 0,0:20:27.33,0:20:32.09,TEXT-JP,,0,0,0,,たとえ俺の何かが壊れても
Dialogue: 0,0:20:36.01,0:20:37.22,TEXT-JP,,0,0,0,,でもな
Dialogue: 0,0:20:38.26,0:20:43.60,TEXT-JP,,0,0,0,,おまえ　ここにおったらあかん存在なんやと思う
Dialogue: 0,0:20:45.47,0:20:50.35,TEXT-JP,,0,0,0,,せやけど　お前の望みがここにおることなんやったら…
Dialogue: 0,0:20:55.86,0:20:57.44,TEXT-JP,,0,0,0,,調べよう
Dialogue: 0,0:20:59.49,0:21:03.83,TEXT-JP,,0,0,0,,お前が一体　何者なんか
