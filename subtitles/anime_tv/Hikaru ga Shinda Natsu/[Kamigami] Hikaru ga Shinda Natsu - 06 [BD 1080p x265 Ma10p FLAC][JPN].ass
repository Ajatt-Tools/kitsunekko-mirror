Dialogue: 0,0:00:06.49,0:00:07.57,TEXT-JP,,0,0,0,,よしき
Dialogue: 0,0:00:08.24,0:00:09.49,TEXT-JP,,0,0,0,,端っこ
Dialogue: 0,0:00:09.49,0:00:11.28,TEXT-JP,,0,0,0,,折れてまってるよ
Dialogue: 0,0:00:11.28,0:00:13.49,TEXT-JP,,0,0,0,,ああ　これしおりやねん
Dialogue: 0,0:00:16.79,0:00:19.04,TEXT-JP,,0,0,0,,増田のプリントやん　それ
Dialogue: 0,0:00:19.04,0:00:21.54,TEXT-JP,,0,0,0,,謎趣味すぎるわ　好きなん？
Dialogue: 0,0:00:22.09,0:00:23.25,TEXT-JP,,0,0,0,,いや
Dialogue: 0,0:00:23.25,0:00:26.76,TEXT-JP,,0,0,0,,あたしは面白くて好きやけど　哲学？
Dialogue: 0,0:00:27.09,0:00:28.68,TEXT-JP,,0,0,0,,「スワンプマン」
Dialogue: 0,0:00:29.13,0:00:32.22,TEXT-JP,,0,0,0,,雷に打たれて別人に変身したんやっけ
Dialogue: 0,0:00:32.22,0:00:34.39,TEXT-JP,,0,0,0,,ちゃうよ　確か…
Dialogue: 0,0:00:34.39,0:00:35.39,TEXT-JP,,0,0,0,,死んだんや
Dialogue: 0,0:00:39.14,0:00:44.15,TEXT-JP,,0,0,0,,そしたら記憶も見た目も全く同じ男が別に生まれて
Dialogue: 0,0:00:44.15,0:00:48.11,TEXT-JP,,0,0,0,,そいつは自分が死んだ男と別人やって気付かんで
Dialogue: 0,0:00:48.11,0:00:50.20,TEXT-JP,,0,0,0,,家に帰ったって話
Dialogue: 0,0:00:51.16,0:00:52.87,TEXT-JP,,0,0,0,,お前らはどう思う
Dialogue: 0,0:00:52.87,0:00:53.87,TEXT-JP,,0,0,0,,何が？
Dialogue: 0,0:00:53.87,0:00:56.79,TEXT-JP,,0,0,0,,死んだ男と新しく生まれた男
Dialogue: 0,0:00:56.79,0:00:58.58,TEXT-JP,,0,0,0,,同一人物やと思うか
Dialogue: 0,0:00:59.25,0:01:01.42,TEXT-JP,,0,0,0,,どうでもええねんけど
Dialogue: 0,0:01:02.29,0:01:04.09,TEXT-JP,,0,0,0,,別モンやろ　そんなん
Dialogue: 0,0:01:04.09,0:01:04.59,TEXT-JP,,0,0,0,,なんで
Dialogue: 0,0:01:04.59,0:01:05.92,TEXT-JP,,0,0,0,,なんとなく
Dialogue: 0,0:01:06.63,0:01:08.92,TEXT-JP,,0,0,0,,別人とは言い切れやんな
Dialogue: 0,0:01:09.17,0:01:12.09,TEXT-JP,,0,0,0,,やって　人間って新陳代謝しとるし
Dialogue: 0,0:01:12.09,0:01:15.18,TEXT-JP,,0,0,0,,数年前と同じ細胞やないもんさ
Dialogue: 0,0:01:15.18,0:01:17.43,TEXT-JP,,0,0,0,,実質それと同じやない？
Dialogue: 0,0:01:17.43,0:01:22.65,TEXT-JP,,0,0,0,,確かにな　でも本当の男は沼の中で死んでいっとるんよ
Dialogue: 0,0:01:23.19,0:01:24.94,TEXT-JP,,0,0,0,,したらもう別人やろ
Dialogue: 0,0:01:24.94,0:01:27.73,TEXT-JP,,0,0,0,,やって一瞬でも2人存在しとるやん
Dialogue: 0,0:01:28.40,0:01:29.78,TEXT-JP,,0,0,0,,確かに
Dialogue: 0,0:01:29.78,0:01:32.57,TEXT-JP,,0,0,0,,巻んくせに鋭いこと言うな
Dialogue: 0,0:01:32.57,0:01:35.78,TEXT-JP,,0,0,0,,でも　はたから見たらずっと同じ一人やん
Dialogue: 0,0:01:36.24,0:01:40.62,TEXT-JP,,0,0,0,,結局他人なんて　外から見たもんでしか判断できやんし
Dialogue: 0,0:01:41.33,0:01:42.96,TEXT-JP,,0,0,0,,もう分かんね
Dialogue: 0,0:01:42.96,0:01:45.25,TEXT-JP,,0,0,0,,なんでもええんちゃう？どうでもええ
Dialogue: 0,0:01:45.25,0:01:47.59,TEXT-JP-U,,0,0,0,,それな　ムズい
Dialogue: 0,0:01:46.71,0:01:51.17,TEXT-JP,,0,0,0,,こいつらん中では光はまだ生きとるんやな
Dialogue: 0,0:01:55.09,0:01:58.60,TEXT-JP,,0,0,0,,何がその人をその人たらしめるんか
Dialogue: 0,0:01:55.09,0:02:01.56,TEXT-JP-U,,0,0,0,,静かに夢を見てごらん
Dialogue: 0,0:01:58.60,0:02:01.56,TEXT-JP,,0,0,0,,記憶　細胞　経験？
Dialogue: 0,0:02:01.56,0:02:07.11,TEXT-JP-U,,0,0,0,,ひそかに探し求めてごらん
Dialogue: 0,0:02:02.69,0:02:06.61,TEXT-JP,,0,0,0,,先生は今の合唱も個性的で好きやけどな
Dialogue: 0,0:02:07.11,0:02:10.61,TEXT-JP,,0,0,0,,月曜の本番までやれるだけ頑張ろうな
Dialogue: 0,0:02:11.15,0:02:15.37,TEXT-JP,,0,0,0,,人って何をもって本当に死ぬんやろな
Dialogue: 0,0:02:15.37,0:02:19.37,TEXT-JP,,0,0,0,,…躍らせる未来こそ
Dialogue: 0,0:02:19.37,0:02:22.00,TEXT-JP,,0,0,0,,今
Dialogue: 0,0:03:55.63,0:03:57.01,TEXT-JP,,0,0,0,,おはよう
Dialogue: 0,0:03:59.43,0:04:01.30,TEXT-JP,,0,0,0,,おはよう
Dialogue: 0,0:04:04.43,0:04:07.56,TEXT-JP,,0,0,0,,これ　洗っといたから　ありがとう
Dialogue: 0,0:04:08.56,0:04:10.86,TEXT-JP,,0,0,0,,お前　男子に体操着借りとんの
Dialogue: 0,0:04:10.86,0:04:13.98,TEXT-JP,,0,0,0,,うっさいな　女子んじゃ小さいの
Dialogue: 0,0:04:16.57,0:04:19.49,TEXT-JP,,0,0,0,,人から返されたもんすぐ嗅ぐか　普通
Dialogue: 0,0:04:20.11,0:04:23.12,TEXT-JP,,0,0,0,,むっちゃええ匂いする　女子っぽい
Dialogue: 0,0:04:23.12,0:04:27.50,TEXT-JP,,0,0,0,,いや　うちんママ　香りにこだわるタイプやからさ
Dialogue: 0,0:04:27.50,0:04:31.00,TEXT-JP,,0,0,0,,女子ってさ　むっちゃええ匂いするけどさ
Dialogue: 0,0:04:31.54,0:04:33.00,TEXT-JP,,0,0,0,,なんで男は臭いん？
Dialogue: 0,0:04:34.09,0:04:35.00,TEXT-JP,,0,0,0,,知らん
Dialogue: 0,0:04:35.00,0:04:38.05,TEXT-JP,,0,0,0,,なあ　今週末このメンツで遊ばん？
Dialogue: 0,0:04:38.05,0:04:39.76,TEXT-JP,,0,0,0,,合唱練の息抜きにさ
Dialogue: 0,0:04:39.76,0:04:41.14,TEXT-JP,,0,0,0,,おお　ええやん
Dialogue: 0,0:04:41.14,0:04:45.01,TEXT-JP,,0,0,0,,旅行とかしてみてえ　デデニーランドとかさ
Dialogue: 0,0:04:45.01,0:04:48.02,TEXT-JP,,0,0,0,,いや　さすがにそれは夢見過ぎ
Dialogue: 0,0:04:48.02,0:04:51.15,TEXT-JP,,0,0,0,,誰かん家に泊まるとかが関の山やろ
Dialogue: 0,0:04:51.15,0:04:52.90,TEXT-JP,,0,0,0,,やったら俺んち使う？
Dialogue: 0,0:04:52.90,0:04:54.15,TEXT-JP,,0,0,0,,え　ええの
Dialogue: 0,0:04:54.15,0:04:56.32,TEXT-JP,,0,0,0,,急やない　大丈夫？
Dialogue: 0,0:04:56.32,0:04:59.15,TEXT-JP,,0,0,0,,おお　多分　おかやんに言うとくわ
Dialogue: 0,0:04:59.15,0:05:01.49,TEXT-JP,,0,0,0,,え　あざす
Dialogue: 0,0:05:02.91,0:05:07.33,TEXT-JP,,0,0,0,,したら花火やろうや　見せたるわ　俺の舞を
Dialogue: 0,0:05:07.33,0:05:08.04,TEXT-JP,,0,0,0,,ダサそう
Dialogue: 0,0:05:08.04,0:05:09.83,TEXT-JP,,0,0,0,,あたしスイカ持ってくわ
Dialogue: 0,0:05:09.83,0:05:11.42,TEXT-JP,,0,0,0,,おお
Dialogue: 0,0:05:11.42,0:05:13.92,TEXT-JP,,0,0,0,,おい　何勝手に決めとんねん
Dialogue: 0,0:05:13.92,0:05:15.67,TEXT-JP,,0,0,0,,クビタチはなんもないで
Dialogue: 0,0:05:15.67,0:05:19.26,TEXT-JP,,0,0,0,,やったらよしきも一緒にやろうや　インフィニティ
Dialogue: 0,0:05:19.26,0:05:20.93,TEXT-JP,,0,0,0,,うるさ　何それ
Dialogue: 0,0:05:20.93,0:05:23.30,TEXT-JP,,0,0,0,,知らんの　インフィニティ
Dialogue: 0,0:05:23.30,0:05:28.93,TEXT-JP,,0,0,0,,いつしか冬枯れは春に
Dialogue: 0,0:05:28.93,0:05:34.44,TEXT-JP,,0,0,0,,夜空はやがてまた朝日
Dialogue: 2,0:05:28.93,0:05:34.44,TEXT-JP,,0,0,0,,{\fs32\bord2.5\pos(1124,1015)}あした
Dialogue: 0,0:05:34.44,0:05:37.44,TEXT-JP,,0,0,0,,願いを乗せた…
Dialogue: 0,0:05:46.20,0:05:49.00,TEXT-JP,,0,0,0,,おお　2人ともどうした
Dialogue: 0,0:05:49.00,0:05:50.45,TEXT-JP,,0,0,0,,三笠のおっちゃん
Dialogue: 0,0:05:50.45,0:05:53.46,TEXT-JP,,0,0,0,,なんかな　ケッタがパンクしてまってん
Dialogue: 0,0:05:54.46,0:05:57.17,TEXT-JP,,0,0,0,,じゃあ　後ろ乗せてったるに
Dialogue: 0,0:05:57.17,0:05:58.63,TEXT-JP,,0,0,0,,ケッタ　上げられるか
Dialogue: 0,0:05:58.63,0:05:59.30,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:05:59.30,0:06:01.22,TEXT-JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:06:12.10,0:06:13.35,TEXT-JP,,0,0,0,,あちい
Dialogue: 0,0:06:17.94,0:06:19.32,TEXT-JP,,0,0,0,,あっつ
Dialogue: 0,0:07:02.61,0:07:04.99,TEXT-JP,,0,0,0,,「極☆スパーク大魔王」
Dialogue: 0,0:07:04.99,0:07:07.87,TEXT-JP,,0,0,0,,「超たのスウィト」
Dialogue: 0,0:07:08.16,0:07:09.20,TEXT-JP,,0,0,0,,俺　これやるわ
Dialogue: 0,0:07:09.20,0:07:10.58,TEXT-JP,,0,0,0,,俺はこっち
Dialogue: 0,0:07:10.58,0:07:12.79,TEXT-JP,,0,0,0,,光んち　おっきいな
Dialogue: 0,0:07:12.79,0:07:13.87,TEXT-JP,,0,0,0,,な
Dialogue: 0,0:07:13.87,0:07:17.96,TEXT-JP,,0,0,0,,わざわざこんな所まで泊まりに来んの大変やったろ　みんな
Dialogue: 0,0:07:17.96,0:07:21.84,TEXT-JP,,0,0,0,,週末やし　親に車出してもらったから大丈夫やで
Dialogue: 0,0:07:21.84,0:07:25.72,TEXT-JP,,0,0,0,,よしきさ　俺ん部屋からなんかゲーム持ってきて
Dialogue: 0,0:07:25.72,0:07:27.01,TEXT-JP,,0,0,0,,「梨鉄」でええ？
Dialogue: 0,0:07:27.01,0:07:28.22,TEXT-JP,,0,0,0,,おお
Dialogue: 0,0:08:17.64,0:08:19.35,TEXT-JP,,0,0,0,,なんも変わらんな
Dialogue: 0,0:08:25.53,0:08:28.78,TEXT-JP,,0,0,0,,この帽子　どっかで…
Dialogue: 0,0:08:41.29,0:08:42.84,TEXT-JP,,0,0,0,,うまいか
Dialogue: 0,0:08:42.84,0:08:43.71,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:08:43.71,0:08:44.84,TEXT-JP,,0,0,0,,そうか
Dialogue: 0,0:08:46.67,0:08:52.05,TEXT-JP,,0,0,0,,この祭りはな　もともとあの山の神さんための祭りやねん
Dialogue: 0,0:08:52.05,0:08:55.68,TEXT-JP,,0,0,0,,やから　よしき　あの山には入らんように
Dialogue: 0,0:08:55.68,0:08:57.39,TEXT-JP,,0,0,0,,連れていかれんで
Dialogue: 0,0:08:58.48,0:09:01.94,TEXT-JP,,0,0,0,,おい　こんなとこおったんか
Dialogue: 0,0:09:05.19,0:09:07.57,TEXT-JP,,0,0,0,,よしき　モロコシうまいか
Dialogue: 0,0:09:07.57,0:09:08.44,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:09:08.44,0:09:09.99,TEXT-JP,,0,0,0,,よしき
Dialogue: 0,0:09:10.45,0:09:13.82,TEXT-JP,,0,0,0,,今日　花火もあるらしいで一緒に見よや
Dialogue: 0,0:09:13.82,0:09:14.58,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:09:14.58,0:09:18.58,TEXT-JP,,0,0,0,,トシ　向こうでみんな飲んどるに　お前も行くで
Dialogue: 0,0:09:19.54,0:09:21.00,TEXT-JP,,0,0,0,,今　行くわ
Dialogue: 0,0:09:23.96,0:09:27.21,TEXT-JP,,0,650,0,,父さんとはろくに話してこやんかったけど
Dialogue: 0,0:09:27.21,0:09:29.59,TEXT-JP,,0,650,0,,こんときのことはやけに覚えとる
Dialogue: 0,0:09:30.47,0:09:32.72,TEXT-JP,,0,650,0,,ああそうや　「梨鉄」
Dialogue: 0,0:09:39.39,0:09:40.81,TEXT-JP,,0,0,0,,なんやこれ
Dialogue: 0,0:09:41.69,0:09:44.06,TEXT-JP,,0,0,0,,なんかこぼしてカピカピになっとる
Dialogue: 0,0:09:46.44,0:09:47.73,TEXT-JP,,0,0,0,,光の字や
Dialogue: 0,0:09:48.36,0:09:49.49,TEXT-JP,,0,0,0,,「ヒチ」
Dialogue: 0,0:09:49.49,0:09:51.49,TEXT-JP,,0,0,0,,「忌堂の役目」
Dialogue: 0,0:09:57.24,0:09:58.54,TEXT-JP,,0,0,0,,きれいやな
Dialogue: 0,0:09:58.54,0:10:00.00,TEXT-JP,,0,0,0,,な
Dialogue: 0,0:10:04.25,0:10:06.25,TEXT-JP,,0,0,0,,Infinity
Dialogue: 0,0:10:07.29,0:10:08.55,TEXT-JP,,0,0,0,,スゲえ
Dialogue: 0,0:10:07.38,0:10:09.05,TEXT-JP-U,,0,0,0,,Infinity
Dialogue: 0,0:10:08.55,0:10:10.26,TEXT-JP,,0,0,0,,ムダに発音ええな
Dialogue: 0,0:10:09.05,0:10:11.13,TEXT-JP-U,,0,0,0,,It's beautiful!
Dialogue: 0,0:10:11.47,0:10:13.51,TEXT-JP,,0,0,0,,花火ってスゲえ
Dialogue: 0,0:10:13.51,0:10:15.76,TEXT-JP,,0,0,0,,すご
Dialogue: 0,0:10:18.93,0:10:21.56,TEXT-JP,,0,0,0,,みんな　こっち見て
Dialogue: 0,0:10:41.79,0:10:44.08,TEXT-JP,,0,0,0,,光　なんあれ　倉？
Dialogue: 0,0:10:45.25,0:10:47.33,TEXT-JP,,0,0,0,,あれお堂や　うちの
Dialogue: 0,0:10:47.33,0:10:49.84,TEXT-JP,,0,0,0,,なんか　じいちゃんが大事にしと…
Dialogue: 0,0:10:50.25,0:10:52.84,TEXT-JP,,0,0,0,,うちにもあんで　祠やけど
Dialogue: 0,0:10:52.84,0:10:55.84,TEXT-JP,,0,0,0,,つか　お堂と祠って何が違うん
Dialogue: 0,0:10:56.68,0:10:57.51,TEXT-JP,,0,0,0,,すまん
Dialogue: 0,0:10:58.26,0:10:59.22,TEXT-JP,,0,0,0,,落ちた
Dialogue: 0,0:10:59.22,0:11:00.22,TEXT-JP,,0,0,0,,え
Dialogue: 0,0:11:00.22,0:11:00.89,TEXT-JP,,0,0,0,,ふざけんな
Dialogue: 0,0:11:00.89,0:11:01.60,TEXT-JP,,0,0,0,,いてっ
Dialogue: 0,0:11:01.60,0:11:03.77,TEXT-JP,,0,0,0,,火つけたばっかやったんやけど
Dialogue: 0,0:11:03.77,0:11:04.98,TEXT-JP,,0,0,0,,はあ　知らんがな
Dialogue: 0,0:11:04.98,0:11:07.40,TEXT-JP,,0,0,0,,最後の一本やったんやけど
Dialogue: 0,0:11:07.40,0:11:09.06,TEXT-JP,,0,0,0,,はいはい　俺の使えば
Dialogue: 0,0:11:09.06,0:11:09.98,TEXT-JP,,0,0,0,,謝れ
Dialogue: 0,0:11:11.40,0:11:13.36,TEXT-JP,,0,0,0,,チャッカメン　つかんくなってもた
Dialogue: 0,0:11:13.78,0:11:15.99,TEXT-JP,,0,0,0,,これ　最後なんよな
Dialogue: 0,0:11:15.99,0:11:17.74,TEXT-JP,,0,0,0,,山久　行ってもらってくるわ
Dialogue: 0,0:11:17.74,0:11:18.53,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:11:18.53,0:11:19.49,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:11:20.62,0:11:22.16,TEXT-JP,,0,0,0,,あたしもついてく
Dialogue: 0,0:11:31.75,0:11:33.63,TEXT-JP,,0,0,0,,あっついなあ
Dialogue: 0,0:11:34.76,0:11:36.43,TEXT-JP,,0,0,0,,ついでにアイス買おや
Dialogue: 0,0:11:36.43,0:11:37.38,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:11:38.59,0:11:40.89,TEXT-JP,,0,0,0,,今のうちにちょっとほっとくか
Dialogue: 0,0:11:40.89,0:11:42.14,TEXT-JP,,0,0,0,,そやね
Dialogue: 0,0:11:42.14,0:11:43.43,TEXT-JP,,0,0,0,,そういやさ
Dialogue: 0,0:11:43.43,0:11:47.10,TEXT-JP,,0,0,0,,今年夏の終わりにデケえ花火大会あるらしいで
Dialogue: 0,0:11:47.10,0:11:49.94,TEXT-JP,,0,0,0,,らしいな　巻　行くん？
Dialogue: 0,0:11:50.36,0:11:51.48,TEXT-JP,,0,0,0,,悩み中
Dialogue: 0,0:11:55.61,0:11:59.49,TEXT-JP,,0,0,0,,ちょっと2人追いかけて　アイスも追加でって言うてくるわ
Dialogue: 0,0:11:59.78,0:12:01.24,TEXT-JP,,0,0,0,,あ…うん
Dialogue: 0,0:12:09.50,0:12:12.92,TEXT-JP,,0,0,0,,やっぱ行こかな　花火大会
Dialogue: 0,0:12:12.92,0:12:15.51,TEXT-JP,,0,0,0,,ふん…あそ
Dialogue: 0,0:12:20.18,0:12:21.18,TEXT-JP,,0,0,0,,なあ
Dialogue: 0,0:12:21.18,0:12:24.52,TEXT-JP,,0,0,0,,光が行方不明になったんって　あの山？
Dialogue: 0,0:12:24.52,0:12:28.27,TEXT-JP,,0,0,0,,うん　そやに　あんまり覚えとらんけど
Dialogue: 0,0:12:28.27,0:12:29.73,TEXT-JP,,0,0,0,,そっか
Dialogue: 0,0:12:29.73,0:12:33.07,TEXT-JP,,0,0,0,,なんか　すっかり日常に戻った感あるけどさ
Dialogue: 0,0:12:33.07,0:12:36.44,TEXT-JP,,0,0,0,,あんときお通夜みたいやったわ　ほんまに
Dialogue: 0,0:12:36.44,0:12:38.53,TEXT-JP,,0,0,0,,戻ってきてくれてよかった
Dialogue: 0,0:12:40.45,0:12:41.16,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:12:45.08,0:12:46.54,TEXT-JP,,0,0,0,,なんかさ
Dialogue: 0,0:12:47.29,0:12:50.87,TEXT-JP,,0,0,0,,意味分からんかったらスルーしてほしいんやけど
Dialogue: 0,0:12:59.80,0:13:02.72,TEXT-JP,,0,0,0,,あなたは一体誰ですか
Dialogue: 0,0:13:31.17,0:13:33.71,TEXT-JP,,0,0,0,,ばぁば　ほら　あっこ
Dialogue: 0,0:13:33.71,0:13:36.80,TEXT-JP,,0,0,0,,なんかガシャンガシャン言うとるの聞こえるやろ？
Dialogue: 0,0:13:37.25,0:13:42.01,TEXT-JP,,0,0,0,,そうか　朝子は聞こえる子なんやね
Dialogue: 0,0:13:44.76,0:13:48.85,TEXT-JP,,0,0,0,,ばぁばはな　聞こえやんけど　ちょっとだけ見える
Dialogue: 0,0:13:48.85,0:13:51.60,TEXT-JP,,0,0,0,,うちはそういう家系なんや
Dialogue: 0,0:13:51.98,0:13:53.35,TEXT-JP,,0,0,0,,朝子
Dialogue: 0,0:13:53.35,0:13:57.73,TEXT-JP,,0,0,0,,死んだ人の世界とばぁばたちの世界は重なり合ってて
Dialogue: 0,0:13:57.73,0:13:59.74,TEXT-JP,,0,0,0,,すぐそばにあるんよ
Dialogue: 0,0:14:00.78,0:14:04.57,TEXT-JP,,0,0,0,,死んだ人の魂が向こうの世界に行って
Dialogue: 0,0:14:04.57,0:14:08.83,TEXT-JP,,0,0,0,,そんでまた　こっちん世界に戻ってくんねん
Dialogue: 0,0:14:11.08,0:14:13.79,TEXT-JP,,0,0,0,,輪廻転生っていうんよ
Dialogue: 0,0:14:14.96,0:14:16.84,TEXT-JP,,0,0,0,,よう分からん
Dialogue: 0,0:14:23.97,0:14:25.47,TEXT-JP,,0,0,0,,あーちゃん
Dialogue: 0,0:14:26.60,0:14:28.10,TEXT-JP,,0,0,0,,来たで
Dialogue: 0,0:14:28.43,0:14:30.35,TEXT-JP,,0,0,0,,ユーちゃん
Dialogue: 0,0:14:47.74,0:14:50.62,TEXT-JP,,0,0,0,,あーちゃん　今そっち行くで
Dialogue: 0,0:15:04.97,0:15:06.30,TEXT-JP,,0,0,0,,アブナイ
Dialogue: 0,0:15:07.39,0:15:09.39,TEXT-JP,,0,0,0,,ユーちゃん　止まって！
Dialogue: 0,0:15:13.35,0:15:14.06,TEXT-JP,,0,0,0,,結希
Dialogue: 0,0:15:14.06,0:15:15.02,TEXT-JP,,0,0,0,,結希ちゃん
Dialogue: 0,0:15:15.02,0:15:16.40,TEXT-JP,,0,0,0,,やだやだ
Dialogue: 0,0:15:17.81,0:15:19.82,TEXT-JP,,0,0,0,,ええか　朝子
Dialogue: 0,0:15:19.82,0:15:24.57,TEXT-JP,,0,0,0,,あっちん世界にも　怖いんもそうやないんもおる
Dialogue: 0,0:15:24.57,0:15:28.78,TEXT-JP,,0,0,0,,決して向こうが悪でこちらが善とは限らんのよ
Dialogue: 0,0:15:28.78,0:15:29.83,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:15:29.83,0:15:32.45,TEXT-JP,,0,0,0,,でも　恐ろしいもんやから
Dialogue: 0,0:15:32.45,0:15:35.16,TEXT-JP,,0,0,0,,なるべく関わらんように
Dialogue: 0,0:15:37.83,0:15:40.46,TEXT-JP,,0,0,0,,ま…守ってくれようとしたん？
Dialogue: 0,0:15:40.46,0:15:44.13,TEXT-JP,,0,0,0,,大丈夫？もう　勝手に飛び出したらあかんやろ
Dialogue: 0,0:15:44.13,0:15:45.22,TEXT-JP,,0,0,0,,ケガしとらん？
Dialogue: 0,0:15:45.72,0:15:48.68,TEXT-JP,,0,0,0,,うん　大丈夫　こけただけや
Dialogue: 0,0:15:48.68,0:15:50.47,TEXT-JP,,0,0,0,,よかった
Dialogue: 0,0:15:51.39,0:15:54.27,TEXT-JP,,0,0,0,,あっちん世界の人たちは怖いけど
Dialogue: 0,0:15:55.14,0:15:57.77,TEXT-JP,,0,0,0,,ただ悪いもんばかりではないと思う
Dialogue: 0,0:15:59.27,0:16:02.07,TEXT-JP,,0,0,0,,あなたは一体誰ですか
Dialogue: 0,0:16:05.15,0:16:07.40,TEXT-JP,,0,0,0,,なんで　バレた？
Dialogue: 0,0:16:08.95,0:16:10.37,TEXT-JP,,0,0,0,,なんで　バレた？
Dialogue: 0,0:16:11.03,0:16:12.49,TEXT-JP,,0,0,0,,なんで　バレた？
Dialogue: 0,0:16:25.38,0:16:25.92,TEXT-JP,,0,0,0,,おい
Dialogue: 0,0:16:31.68,0:16:32.80,TEXT-JP,,0,0,0,,朝子
Dialogue: 0,0:16:32.80,0:16:34.68,TEXT-JP,,0,0,0,,おい　大丈夫か
Dialogue: 0,0:16:34.97,0:16:37.18,TEXT-JP,,0,0,0,,お前　何して…
Dialogue: 0,0:16:40.31,0:16:43.07,TEXT-JP,,0,0,0,,バレそうになったから　つい
Dialogue: 0,0:16:46.69,0:16:48.15,TEXT-JP,,0,0,0,,つい？
Dialogue: 0,0:16:48.70,0:16:50.74,TEXT-JP,,0,0,0,,つい何を？
Dialogue: 0,0:16:51.91,0:16:53.95,TEXT-JP,,0,0,0,,思えばあかんよな
Dialogue: 0,0:16:53.95,0:16:55.49,TEXT-JP,,0,0,0,,朝子はさすがに
Dialogue: 0,0:16:58.87,0:17:01.25,TEXT-JP,,0,0,0,,何が？え
Dialogue: 0,0:17:01.25,0:17:04.59,TEXT-JP,,0,0,0,,死んでまったら　悲しいよな
Dialogue: 0,0:17:05.21,0:17:07.67,TEXT-JP,,0,0,0,,お…お前…
Dialogue: 0,0:17:08.30,0:17:11.59,TEXT-JP,,0,0,0,,こ…殺そうと？
Dialogue: 0,0:17:12.09,0:17:13.76,TEXT-JP,,0,0,0,,こんな…えっ
Dialogue: 0,0:17:14.35,0:17:17.10,TEXT-JP,,0,0,0,,人の命やん　こんな…
Dialogue: 0,0:17:17.10,0:17:18.14,TEXT-JP,,0,0,0,,イノチ
Dialogue: 0,0:17:21.31,0:17:24.36,TEXT-JP,,0,0,0,,死んどるのと生きとるのでそんなに違うん？
Dialogue: 0,0:17:24.36,0:17:26.57,TEXT-JP,,0,0,0,,生きとるほうが大切なん？
Dialogue: 0,0:17:28.32,0:17:30.45,TEXT-JP,,0,0,0,,俺にはイノチないけど…
Dialogue: 0,0:17:31.24,0:17:34.99,TEXT-JP,,0,0,0,,死んどるんも生きとるんも　俺からしたらさほど変わらん
Dialogue: 0,0:17:34.99,0:17:37.49,TEXT-JP,,0,0,0,,死ぬのはそんな怖いことちゃうよ
Dialogue: 0,0:17:37.49,0:17:39.83,TEXT-JP,,0,0,0,,ただ形が変わるだけやろ
Dialogue: 0,0:17:42.37,0:17:45.25,TEXT-JP,,0,0,0,,俺のことは殺したないってウソか
Dialogue: 0,0:17:45.25,0:17:47.34,TEXT-JP,,0,0,0,,え　それはちゃうよ
Dialogue: 0,0:17:47.34,0:17:51.01,TEXT-JP,,0,0,0,,お前は…お前は特別やから
Dialogue: 0,0:17:51.72,0:17:55.18,TEXT-JP,,0,0,0,,お前が死んだら　一緒にアイス食えんくなるやん
Dialogue: 0,0:17:57.22,0:17:58.27,TEXT-JP,,0,0,0,,は？
Dialogue: 0,0:17:58.27,0:18:01.23,TEXT-JP,,0,0,0,,ほんな…ほんなことで
Dialogue: 0,0:18:01.23,0:18:03.27,TEXT-JP,,0,0,0,,ほんなん朝子も同じやろ
Dialogue: 0,0:18:03.27,0:18:05.15,TEXT-JP,,0,0,0,,お前矛盾しとんぞ
Dialogue: 0,0:18:05.15,0:18:08.78,TEXT-JP,,0,0,0,,命が何かも分からんくせに　何が特別や
Dialogue: 0,0:18:16.33,0:18:17.99,TEXT-JP,,0,0,0,,近所の婆さん
Dialogue: 0,0:18:19.16,0:18:22.54,TEXT-JP,,0,0,0,,松浦さん殺したんも　お前？
Dialogue: 0,0:18:46.65,0:18:48.44,TEXT-JP,,0,0,0,,おわっ　ゲロ…
Dialogue: 0,0:18:59.83,0:19:02.54,TEXT-JP,,0,0,0,,なん　寝てた？
Dialogue: 0,0:19:03.79,0:19:05.12,TEXT-JP,,0,0,0,,なんかゲロ臭っ
Dialogue: 0,0:19:07.42,0:19:10.21,TEXT-JP,,0,0,0,,あっ　光　大丈夫やった？
Dialogue: 0,0:19:12.17,0:19:14.17,TEXT-JP,,0,0,0,,えっと
Dialogue: 0,0:19:17.59,0:19:20.64,TEXT-JP,,0,0,0,,ゆ…幽霊に取りつかれとるから
Dialogue: 0,0:19:24.39,0:19:27.35,TEXT-JP,,0,0,0,,くう　ハズう
Dialogue: 0,0:19:36.53,0:19:39.49,TEXT-JP,,0,0,0,,光が帰ってきてから時々さ
Dialogue: 0,0:19:40.74,0:19:42.87,TEXT-JP,,0,0,0,,声がおかしかったんよ
Dialogue: 0,0:19:42.87,0:19:46.62,TEXT-JP,,0,0,0,,これ　ヤバいんに取りつかれてまったんやって思って
Dialogue: 0,0:19:47.12,0:19:51.75,TEXT-JP,,0,0,0,,でもそのヤバいヤツ　よしきを守っとる？みたいで
Dialogue: 0,0:19:52.25,0:19:56.47,TEXT-JP,,0,0,0,,むしろ一緒におったほうが安全かも　みたいなときもあってん
Dialogue: 0,0:19:57.01,0:20:00.68,TEXT-JP,,0,0,0,,やから　もしかしたら話通じるかもって
Dialogue: 0,0:20:00.68,0:20:02.51,TEXT-JP,,0,0,0,,話しかけてみてん
Dialogue: 0,0:20:02.51,0:20:04.52,TEXT-JP,,0,0,0,,光ん中のそいつに
Dialogue: 0,0:20:07.56,0:20:09.48,TEXT-JP,,0,0,0,,セーフ？
Dialogue: 0,0:20:12.44,0:20:16.49,TEXT-JP,,0,0,0,,頭おかしいヤツやん　こんなこと言うん
Dialogue: 0,0:20:16.49,0:20:19.32,TEXT-JP,,0,0,0,,2人ともごめん　忘れて
Dialogue: 0,0:20:21.74,0:20:22.78,TEXT-JP,,0,0,0,,いや
Dialogue: 0,0:20:23.20,0:20:24.79,TEXT-JP,,0,0,0,,信じるよ
Dialogue: 0,0:20:27.08,0:20:28.54,TEXT-JP,,0,0,0,,ありがとう
Dialogue: 0,0:20:30.42,0:20:32.92,TEXT-JP,,0,0,0,,貧血とかやったら怖いし
Dialogue: 0,0:20:32.92,0:20:34.30,TEXT-JP,,0,0,0,,先　戻って
Dialogue: 0,0:20:45.72,0:20:46.56,TEXT-JP,,0,0,0,,よしき…
Dialogue: 0,0:20:55.82,0:20:57.36,TEXT-JP,,0,0,0,,よしき大丈夫なん？
Dialogue: 0,0:20:57.36,0:20:59.32,TEXT-JP,,0,0,0,,昨日　急に帰ったけど
Dialogue: 0,0:20:59.32,0:21:01.57,TEXT-JP,,0,0,0,,よっぽどの腹イタやったんやな
Dialogue: 0,0:21:04.28,0:21:05.20,TEXT-JP,,0,0,0,,なあ　朝子…
Dialogue: 0,0:21:05.20,0:21:08.21,TEXT-JP,,0,0,0,,あっ　よしきに「お大事に」って
Dialogue: 0,0:21:10.58,0:21:12.29,TEXT-JP,,0,0,0,,言うとくわ
Dialogue: 0,0:21:19.30,0:21:21.72,TEXT-JP,,0,0,0,,イノチってなんやろ
Dialogue: 0,0:21:24.60,0:21:28.39,TEXT-JP,,0,0,0,,死んだって　この世から消えるわけやないし
Dialogue: 0,0:21:28.39,0:21:31.94,TEXT-JP,,0,0,0,,形が変わるだけで　魂はなくならん
Dialogue: 0,0:21:38.03,0:21:39.36,TEXT-JP,,0,0,0,,よしき
Dialogue: 0,0:21:54.38,0:21:58.17,TEXT-JP,,0,0,0,,よしきの魂　きれいなんよな
Dialogue: 0,0:22:04.22,0:22:07.06,TEXT-JP,,0,0,0,,あかん　よしきには死んでほしない
Dialogue: 0,0:22:08.43,0:22:11.73,TEXT-JP,,0,0,0,,でもなんでやろ　俺が思っとるのか
Dialogue: 0,0:22:12.35,0:22:15.15,TEXT-JP,,0,0,0,,それとも　光の記憶の…
Dialogue: 0,0:22:20.07,0:22:22.65,TEXT-JP,,0,0,0,,心がぐちゃぐちゃでまとまらん
Dialogue: 0,0:22:29.58,0:22:31.50,TEXT-JP,,0,0,0,,いってきます
Dialogue: 0,0:22:44.51,0:22:47.10,TEXT-JP,,0,0,0,,ヒカル　学校行くで
