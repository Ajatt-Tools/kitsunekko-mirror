Dialogue: 0,0:00:12.44,0:00:14.48,jp,,0,0,0,,その　チョコレート
Dialogue: 0,0:00:15.20,0:00:17.86,jp,,0,0,0,,い　一番うまく
Dialogue: 0,0:00:18.01,0:00:21.63,jp,,0,0,0,,で…できたも　ものです
Dialogue: 0,0:00:21.63,0:00:24.97,jp,,0,0,0,,そんなわざわざ　ありがとうございます
Dialogue: 0,0:00:27.56,0:00:28.84,jp,,0,0,0,,古見さん？
Dialogue: 0,0:00:36.62,0:00:37.76,jp,,0,0,0,,硝子
Dialogue: 0,0:00:38.00,0:00:40.31,jp,,0,0,0,,そろそろ出ないといけないんじゃない
Dialogue: 0,0:00:41.82,0:00:44.22,jp,,0,0,0,,どうしたの　体調悪い
Dialogue: 0,0:00:46.60,0:00:47.68,jp,,0,0,0,,寒いからイヤ？
Dialogue: 0,0:00:48.33,0:00:50.39,jp,,0,0,0,,昨日学校で何か
Dialogue: 0,0:00:55.72,0:00:59.27,jp,,0,0,0,,硝子　学校いってらっしゃい
Dialogue: 0,0:01:01.38,0:01:04.42,jp,,0,0,0,,今日休むと皆勤賞なくなっちゃうな
Dialogue: 0,0:01:04.42,0:01:05.94,jp,,0,0,0,,いいのかな
Dialogue: 0,0:01:10.97,0:01:11.67,jp,,0,0,0,,出てきた
Dialogue: 0,0:03:23.61,0:03:24.86,jp,,0,0,0,,よっ　おはよう
Dialogue: 0,0:03:26.41,0:03:29.05,jp,,0,0,0,,昨日チョコありがとな　うまかった
Dialogue: 0,0:03:33.27,0:03:33.86,jp,,0,0,0,,サンキュー
Dialogue: 0,0:03:34.34,0:03:35.62,jp,,0,0,0,,でも焼き菓子だし
Dialogue: 0,0:03:35.62,0:03:38.23,jp,,0,0,0,,無理してすぐ全部食べなくてもいいからな
Dialogue: 0,0:03:38.36,0:03:41.03,jp,,0,0,0,,古見さん結構な量のチョコもらってただろ
Dialogue: 0,0:03:41.72,0:03:42.28,jp,,0,0,0,,太るぞ
Dialogue: 0,0:03:44.65,0:03:46.10,jp,,0,0,0,,おっはろー
Dialogue: 0,0:03:47.33,0:03:48.88,jp,,0,0,0,,古見さんのチョコ　おいしかったよー
Dialogue: 0,0:03:48.88,0:03:51.48,jp,,0,0,0,,盟友の作りし甘美なる贄
Dialogue: 0,0:03:52.95,0:03:54.33,jp,,0,0,0,,悪くなかったぞ
Dialogue: 0,0:03:54.33,0:03:56.47,jp,,0,0,0,,ここここ古見ひゃん
Dialogue: 0,0:03:56.94,0:04:00.28,jp,,0,0,0,,チチチョコ　おおおいしかったでふ
Dialogue: 0,0:04:11.55,0:04:13.63,jp,,0,0,0,,ま　負けた
Dialogue: 0,0:04:13.84,0:04:15.00,jp,,0,0,0,,You　lose
Dialogue: 0,0:04:26.15,0:04:27.12,jp,,0,0,0,,どうしたの古見さん
Dialogue: 0,0:04:32.11,0:04:33.43,jp,,0,0,0,,おはようございます古見さ…
Dialogue: 0,0:04:38.07,0:04:38.63,jp,,0,0,0,,あの…
Dialogue: 0,0:04:40.48,0:04:41.21,jp,,0,0,0,,どうして
Dialogue: 0,0:04:43.35,0:04:45.12,jp,,0,0,0,,いや　なんでもないです
Dialogue: 0,0:04:45.96,0:04:50.00,jp,,0,0,0,,なんか久しぶりに古見さんのこういう顔見た気がする
Dialogue: 0,0:04:57.10,0:04:59.00,jp,,0,0,0,,でも　どうしたんだろ
Dialogue: 0,0:04:59.49,0:05:02.08,jp,,0,0,0,,怒ってる感じでもないし
Dialogue: 0,0:05:03.24,0:05:06.38,jp,,0,0,0,,でも昨日走って追いかけたから…とか
Dialogue: 0,0:05:07.34,0:05:10.52,jp,,0,0,0,,それとも　僕が何か変なこと言ったかな
Dialogue: 0,0:05:11.00,0:05:15.44,jp,,0,0,0,,いや　そもそも僕が何かしたわけじゃない可能性の方が高いし
Dialogue: 0,0:05:20.89,0:05:23.26,jp,,0,0,0,,そうだ　とりあえずチョコの感想を
Dialogue: 0,0:05:25.32,0:05:26.67,jp,,0,0,0,,そうだ　チョコ
Dialogue: 0,0:05:27.35,0:05:28.84,jp,,0,0,0,,すごくおいしかったです
Dialogue: 0,0:05:29.06,0:05:31.10,jp,,0,0,0,,昨日はわざわざありがとうございました
Dialogue: 0,0:05:32.41,0:05:33.15,jp,,0,0,0,,古見さん？
Dialogue: 0,0:05:42.11,0:05:44.02,jp,,0,0,0,,はい　じゃあ実験道具返却して
Dialogue: 0,0:05:44.26,0:05:45.10,jp,,0,0,0,,はーい
Dialogue: 0,0:05:47.99,0:05:50.88,jp,,0,0,0,,はーい　どうも山井恋でーす
Dialogue: 0,0:05:51.15,0:05:56.21,jp,,0,0,0,,今日も今日とて　古見さんのおみ足が一番美しく見える席に座ってまーす
Dialogue: 0,0:05:57.46,0:05:59.92,jp,,0,0,0,,今日も古見さんの美しさは神クラス
Dialogue: 0,0:06:00.17,0:06:01.69,jp,,0,0,0,,まぶしいわ　古見さん
Dialogue: 0,0:06:01.90,0:06:05.88,jp,,0,0,0,,その光から発せられるエネルギーによって　目の水分が蒸発
Dialogue: 0,0:06:05.88,0:06:08.84,jp,,0,0,0,,もしくはタンパク質が凝固するんじゃないかしら
Dialogue: 0,0:06:10.09,0:06:12.51,jp,,0,0,0,,で　伝線
Dialogue: 0,0:06:16.30,0:06:20.07,jp,,0,0,0,,ダ…ダメよ　古見さんのこんなみっともない姿
Dialogue: 0,0:06:20.51,0:06:22.35,jp,,0,0,0,,す　すぐ動画に
Dialogue: 0,0:06:23.03,0:06:24.99,jp,,0,0,0,,私だけの
Dialogue: 0,0:06:25.91,0:06:29.57,jp,,0,0,0,,ダメ　こんなのクラスのみんなには見せられない
Dialogue: 0,0:06:30.39,0:06:33.12,jp,,0,0,0,,とりあえず　私の陰に隠れて古見さん
Dialogue: 0,0:06:33.97,0:06:37.08,jp,,0,0,0,,みんなにバレないように自然に隠さないと
Dialogue: 0,0:06:37.23,0:06:38.29,jp,,0,0,0,,自然に
Dialogue: 0,0:06:41.80,0:06:42.51,jp,,0,0,0,,山井さん？
Dialogue: 0,0:06:43.28,0:06:45.13,jp,,0,0,0,,このことを正直に伝えたら
Dialogue: 0,0:06:45.13,0:06:47.27,jp,,0,0,0,,古見さんきっと恥ずかしがっちゃう
Dialogue: 0,0:06:47.49,0:06:50.52,jp,,0,0,0,,でも伝えなかったら帰ったあとで恥ずかしがっちゃう
Dialogue: 0,0:06:50.69,0:06:52.98,jp,,0,0,0,,もちろん帰宅までの道中は私が死守するわ
Dialogue: 0,0:06:53.40,0:06:56.15,jp,,0,0,0,,ど　どうしたら
Dialogue: 0,0:06:57.07,0:06:59.33,jp,,0,0,0,,ダ…ダメよ　山井恋
Dialogue: 0,0:06:59.51,0:07:01.99,jp,,0,0,0,,今古見さんの伝線に触ろうとしてた
Dialogue: 0,0:07:02.75,0:07:05.85,jp,,0,0,0,,無意識に伝線を広げようとしてた
Dialogue: 0,0:07:06.08,0:07:07.82,jp,,0,0,0,,破きたい
Dialogue: 0,0:07:08.10,0:07:11.12,jp,,0,0,0,,古見さんのタイツをビリビリに破きたい
Dialogue: 0,0:07:09.14,0:07:10.12,jpup,,0,0,0,,あのー
Dialogue: 0,0:07:11.44,0:07:13.77,jp,,0,0,0,,乱れた古見さんが見たい
Dialogue: 0,0:07:14.06,0:07:15.32,jp,,0,0,0,,でもダメ
Dialogue: 0,0:07:14.48,0:07:16.36,jpup,,0,0,0,,山井さん　あ…あの…
Dialogue: 0,0:07:15.94,0:07:18.08,jp,,0,0,0,,ダメよ　山井恋
Dialogue: 0,0:07:19.35,0:07:20.30,jp,,0,0,0,,整った
Dialogue: 0,0:07:23.94,0:07:24.70,jp,,0,0,0,,古見さん
Dialogue: 0,0:07:27.03,0:07:30.69,jp,,0,0,0,,古見さん　左足の太ももの所　伝線してるよ
Dialogue: 0,0:07:38.38,0:07:39.90,jp,,0,0,0,,大丈夫安心して
Dialogue: 0,0:07:40.43,0:07:43.41,jp,,0,0,0,,古見さんが使ってるメーカーの80デニールのタイツ
Dialogue: 0,0:07:43.91,0:07:45.85,jp,,0,0,0,,私いつも持ち歩いてるから
Dialogue: 0,0:07:48.54,0:07:50.65,jp,,0,0,0,,さっ　お手洗いで着替えましょ
Dialogue: 0,0:07:51.17,0:07:52.35,jp,,0,0,0,,そうしましょ
Dialogue: 0,0:07:52.49,0:07:53.12,jp,,0,0,0,,あれ
Dialogue: 0,0:07:56.06,0:07:58.49,jp,,0,0,0,,伝線広がっちゃってた　大丈夫
Dialogue: 0,0:07:59.94,0:08:00.72,jp,,0,0,0,,ごめんね
Dialogue: 0,0:08:03.96,0:08:06.35,jp,,0,0,0,,もっと早く伝えればよかったんだけど
Dialogue: 0,0:08:07.43,0:08:09.78,jp,,0,0,0,,古見さん恥ずかしがらせちゃうかなって
Dialogue: 0,0:08:10.91,0:08:13.84,jp,,0,0,0,,みんなに見られる方が恥ずかしいのに　ごめん
Dialogue: 0,0:08:25.71,0:08:26.78,jp,,0,0,0,,古見さん
Dialogue: 0,0:08:32.58,0:08:33.43,jp,,0,0,0,,じゃあこれ
Dialogue: 0,0:08:33.76,0:08:35.29,jp,,0,0,0,,古いのは持っててあげるね
Dialogue: 0,0:09:10.93,0:09:12.57,jp,,0,0,0,,どういう状況
Dialogue: 0,0:09:13.89,0:09:15.29,jp,,0,0,0,,捕まえた方がい
Dialogue: 0,0:09:35.05,0:09:36.33,jp,,0,0,0,,鬼ヶ島朱子
Dialogue: 0,0:09:37.43,0:09:39.69,jp,,0,0,0,,山井さんグループに属する彼女は
Dialogue: 0,0:09:39.82,0:09:41.46,jp,,0,0,0,,古見さんの友達である
Dialogue: 0,0:09:41.97,0:09:43.50,jp,,0,0,0,,いつも笑顔で元気
Dialogue: 0,0:09:43.62,0:09:46.37,jp,,0,0,0,,人柄もよく　誰からも好かれている
Dialogue: 0,0:09:47.04,0:09:49.57,jp,,0,0,0,,只野くんだ　おっはよー
Dialogue: 0,0:09:50.49,0:09:52.08,jp,,0,0,0,,鬼ヶ島さん　おはよう
Dialogue: 0,0:09:52.08,0:09:54.70,jp,,0,0,0,,ごめっ　私急いでんだ　じゃねー
Dialogue: 0,0:09:56.10,0:09:57.78,jp,,0,0,0,,今日も元気だなあ
Dialogue: 0,0:09:57.78,0:10:00.66,jp,,0,0,0,,只野くんにすらいつも笑顔で挨拶してくれる
Dialogue: 0,0:10:00.81,0:10:02.08,jp,,0,0,0,,めっちゃいい子である
Dialogue: 0,0:10:02.30,0:10:02.90,jp,,0,0,0,,好き
Dialogue: 0,0:10:03.28,0:10:04.02,jp,,0,0,0,,そんな
Dialogue: 0,0:10:04.16,0:10:07.62,jp,,0,0,0,,「こんな幼馴染が欲しかったランキング」１位の彼女も
Dialogue: 0,0:10:11.43,0:10:12.99,jp,,0,0,0,,キレることはあるのだ
Dialogue: 0,0:10:16.93,0:10:18.51,jp,,0,0,0,,いえ　何でもないです
Dialogue: 0,0:10:18.75,0:10:22.03,jp,,0,0,0,,あーもう　なんで信号全部赤なの
Dialogue: 0,0:10:24.22,0:10:24.97,jp,,0,0,0,,よし
Dialogue: 0,0:10:40.70,0:10:41.93,jp,,0,0,0,,また待ってる
Dialogue: 0,0:10:46.52,0:10:48.63,jp,,0,0,0,,しかもイヤホンが絡まってる
Dialogue: 0,0:11:14.38,0:11:15.37,jp,,0,0,0,,山井さんがいる
Dialogue: 0,0:11:16.42,0:11:17.27,jp,,0,0,0,,よかった
Dialogue: 0,0:11:17.57,0:11:20.59,jp,,0,0,0,,仲のいい山井さんなら　鬼ヶ島さんのイライラも
Dialogue: 0,0:11:23.80,0:11:26.10,jp,,0,0,0,,なんで今顔背けたんですか
Dialogue: 0,0:11:26.72,0:11:28.41,jp,,0,0,0,,何只野くん　いたの
Dialogue: 0,0:11:28.71,0:11:29.65,jp,,0,0,0,,背けた？
Dialogue: 0,0:11:32.11,0:11:34.05,jp,,0,0,0,,私も付き合い長いからね
Dialogue: 0,0:11:35.06,0:11:37.14,jp,,0,0,0,,小学校から一緒だし知ってるのよ
Dialogue: 0,0:11:37.69,0:11:39.98,jp,,0,0,0,,あの子はキレたら何するか分からない
Dialogue: 0,0:11:41.10,0:11:45.10,jp,,0,0,0,,ストレスの解消法はごはん　お風呂　睡眠　バッティングセンターだけよ
Dialogue: 0,0:11:45.26,0:11:49.37,jp,,0,0,0,,只野くんも気をつけることね　触らぬ神に祟りなしよ
Dialogue: 0,0:11:49.74,0:11:52.01,jp,,0,0,0,,山井さんがまともなこと言ってる
Dialogue: 0,0:11:55.38,0:11:57.34,jp,,0,0,0,,まだイヤホン絡まってる
Dialogue: 0,0:12:19.57,0:12:20.80,jp,,0,0,0,,パーン
Dialogue: 0,0:12:21.47,0:12:22.99,jp,,0,0,0,,ようやくお昼ね
Dialogue: 0,0:12:23.20,0:12:25.47,jp,,0,0,0,,ごはん食べればこの子も少し落ち着くわ
Dialogue: 0,0:12:50.43,0:12:53.16,jp,,0,0,0,,あ…ありがと　古見さん
Dialogue: 0,0:12:57.35,0:12:58.22,jp,,0,0,0,,古見さん？
Dialogue: 0,0:13:18.38,0:13:20.95,jp,,0,0,0,,古見さあああ～ん
Dialogue: 0,0:13:22.01,0:13:26.27,jp,,0,0,0,,古見さん　一緒にバッティングセンター行こぉ
Dialogue: 0,0:13:30.77,0:13:32.58,jp,,0,0,0,,バッセンだー
Dialogue: 0,0:13:35.29,0:13:36.53,jp,,0,0,0,,只野くん　只野くん
Dialogue: 0,0:13:36.53,0:13:38.05,jp,,0,0,0,,ホームラン打つから見てて
Dialogue: 0,0:13:43.76,0:13:44.63,jp,,0,0,0,,当たった
Dialogue: 0,0:13:46.14,0:13:47.50,jp,,0,0,0,,只野くん普通
Dialogue: 0,0:13:48.39,0:13:49.84,jp,,0,0,0,,鬼ヶ島さん　うまっ
Dialogue: 0,0:13:51.25,0:13:53.48,jp,,0,0,0,,古見さん見た見た　ホームラン
Dialogue: 0,0:13:55.78,0:13:56.60,jp,,0,0,0,,すごいでしょ
Dialogue: 0,0:13:56.60,0:13:59.69,jp,,0,0,0,,鬼ヶ島さんと古見さんは友達です
Dialogue: 0,0:14:16.50,0:14:18.38,jp,,0,0,0,,古見さんを正面から見て
Dialogue: 0,0:14:18.38,0:14:21.34,jp,,0,0,0,,左の席に座っているクラスメートである
Dialogue: 0,0:14:24.86,0:14:29.66,jp,,0,0,0,,よし　これで今日もみんなが気持ちよく授業を受けられるね
Dialogue: 0,0:14:33.28,0:14:34.49,jp,,0,0,0,,もうこんな時間
Dialogue: 0,0:14:39.91,0:14:43.18,jp,,0,0,0,,ちゃんと一番乗りの快感を味わわせてあげないとね
Dialogue: 0,0:14:43.18,0:14:44.96,jp,,0,0,0,,左藤さんは人に甘い
Dialogue: 0,0:14:46.77,0:14:49.21,jp,,0,0,0,,ごめん左藤さん　シャーペン取ってくれない
Dialogue: 0,0:14:49.21,0:14:50.95,jp,,0,0,0,,うん　いいよ
Dialogue: 0,0:14:50.95,0:14:52.41,jp,,0,0,0,,左藤さんは人に甘…
Dialogue: 0,0:14:52.70,0:14:53.56,jp,,0,0,0,,左藤ちゃん
Dialogue: 0,0:14:53.75,0:14:56.46,jp,,0,0,0,,購買で限定チキンカツパン買っておいて
Dialogue: 0,0:14:56.46,0:14:57.15,jp,,0,0,0,,いいよー
Dialogue: 0,0:14:57.15,0:14:58.21,jp,,0,0,0,,左藤さんは人に…
Dialogue: 0,0:14:58.21,0:14:59.98,jp,,0,0,0,,左藤すまん　背中かいてくれ
Dialogue: 0,0:14:59.98,0:15:00.78,jp,,0,0,0,,いいよー
Dialogue: 0,0:15:00.78,0:15:01.59,jp,,0,0,0,,左藤さんは…
Dialogue: 0,0:15:01.94,0:15:02.67,jp,,0,0,0,,いいよ
Dialogue: 0,0:15:03.53,0:15:04.62,jp,,0,0,0,,まだ何も
Dialogue: 0,0:15:06.51,0:15:07.38,jp,,0,0,0,,私
Dialogue: 0,0:15:07.79,0:15:09.75,jp,,0,0,0,,人の頼み事聞きすぎ？
Dialogue: 0,0:15:10.57,0:15:11.38,jp,,0,0,0,,今更？
Dialogue: 0,0:15:12.47,0:15:15.16,jp,,0,0,0,,確かに大抵なんでもしてくれるよな　左藤は
Dialogue: 0,0:15:15.66,0:15:17.27,jp,,0,0,0,,左藤　パンツくれないか
Dialogue: 0,0:15:17.27,0:15:18.34,jp,,0,0,0,,最低だよ
Dialogue: 0,0:15:18.34,0:15:19.15,jp,,0,0,0,,お母さんの
Dialogue: 0,0:15:19.15,0:15:20.23,jp,,0,0,0,,お母さんかよ
Dialogue: 0,0:15:20.23,0:15:21.54,jp,,0,0,0,,なんにせよ最低だよ
Dialogue: 0,0:15:22.86,0:15:23.47,jp,,0,0,0,,いいよ
Dialogue: 0,0:15:23.47,0:15:24.36,jp,,0,0,0,,いいのかよ
Dialogue: 0,0:15:24.46,0:15:26.42,jp,,0,0,0,,ダメだって言わなきゃダメだろ
Dialogue: 0,0:15:27.49,0:15:29.98,jp,,0,0,0,,でもパンツくらいなら　いいよ
Dialogue: 0,0:15:29.98,0:15:31.18,jp,,0,0,0,,ダメなの
Dialogue: 0,0:15:32.18,0:15:33.94,jp,,0,0,0,,じゃあダメって言う練習ね
Dialogue: 0,0:15:34.07,0:15:36.25,jp,,0,0,0,,適当にお願い事するから「ダメ」って言ってね
Dialogue: 0,0:15:36.78,0:15:37.60,jp,,0,0,0,,いいよ
Dialogue: 0,0:15:42.07,0:15:44.37,jp,,0,0,0,,あのさ　親が借金しちゃってさ
Dialogue: 0,0:15:44.50,0:15:45.85,jp,,0,0,0,,10万円貸してくれない
Dialogue: 0,0:15:46.67,0:15:48.08,jp,,0,0,0,,頑張ってみる
Dialogue: 0,0:15:48.25,0:15:49.62,jp,,0,0,0,,エーコちゃんのためだもん
Dialogue: 0,0:15:49.62,0:15:51.72,jp,,0,0,0,,だからダメって言えってうれしいけど
Dialogue: 0,0:15:51.94,0:15:54.12,jp,,0,0,0,,じゃあ　おばあちゃんのパンツとか
Dialogue: 0,0:15:54.12,0:15:56.86,jp,,0,0,0,,お前まだその話引きずってたのかよ　キモいよ
Dialogue: 0,0:15:56.86,0:15:57.26,jp,,0,0,0,,いい
Dialogue: 0,0:15:57.26,0:15:58.06,jp,,0,0,0,,ダメ
Dialogue: 0,0:16:03.15,0:16:06.46,jp,,0,0,0,,だって人に優しくすると自分も気分いいでしょ
Dialogue: 0,0:16:06.70,0:16:09.25,jp,,0,0,0,,だからなんか断れないんだよね
Dialogue: 0,0:16:09.55,0:16:11.35,jp,,0,0,0,,左藤のひいおばあちゃんって…
Dialogue: 0,0:16:13.39,0:16:15.65,jp,,0,0,0,,だからって他人の言うこと全部聞いてたら
Dialogue: 0,0:16:15.65,0:16:17.38,jp,,0,0,0,,あんたいつかだまされるよ
Dialogue: 0,0:16:17.54,0:16:19.01,jp,,0,0,0,,それに人を甘やかしすぎると
Dialogue: 0,0:16:19.01,0:16:21.34,jp,,0,0,0,,そいつだってダメ人間になっちゃうでしょうが
Dialogue: 0,0:16:20.55,0:16:21.52,jpup,,0,0,0,,左藤ごめん
Dialogue: 0,0:16:21.52,0:16:23.43,jp,,0,0,0,,そこに置いてあるボール取って
Dialogue: 0,0:16:23.43,0:16:24.09,jp,,0,0,0,,いいよー
Dialogue: 0,0:16:24.09,0:16:25.42,jp,,0,0,0,,話の途中
Dialogue: 0,0:16:30.28,0:16:32.18,jp,,0,0,0,,甘やかしすぎか
Dialogue: 0,0:16:32.82,0:16:34.09,jp,,0,0,0,,そこの子　ごめん
Dialogue: 0,0:16:34.09,0:16:36.28,jp,,0,0,0,,このポスターの端っこ押さえてて
Dialogue: 0,0:16:36.28,0:16:37.23,jp,,0,0,0,,いいですよ
Dialogue: 0,0:16:37.74,0:16:38.49,jp,,0,0,0,,いいよー
Dialogue: 0,0:16:39.49,0:16:40.26,jp,,0,0,0,,いいよー
Dialogue: 0,0:16:41.14,0:16:42.04,jp,,0,0,0,,いいよー
Dialogue: 0,0:16:43.03,0:16:44.42,jp,,0,0,0,,そもそも私
Dialogue: 0,0:16:44.71,0:16:48.32,jp,,0,0,0,,なんで人の言うこと聞きすぎとか疑問に思ったんだろう
Dialogue: 0,0:16:50.86,0:16:52.17,jp,,0,0,0,,ありがとう
Dialogue: 0,0:16:58.33,0:16:59.27,jp,,0,0,0,,大丈夫
Dialogue: 0,0:17:00.38,0:17:01.04,jp,,0,0,0,,ありがとう
Dialogue: 0,0:17:01.35,0:17:03.02,jp,,0,0,0,,職員室に持っていくの
Dialogue: 0,0:17:03.02,0:17:05.26,jp,,0,0,0,,いいよ　私が持っていってあげる
Dialogue: 0,0:17:05.62,0:17:08.47,jp,,0,0,0,,えいや　大丈夫ですよ　これ結構重いし
Dialogue: 0,0:17:08.64,0:17:09.81,jp,,0,0,0,,いいよいいよ
Dialogue: 0,0:17:09.81,0:17:11.05,jp,,0,0,0,,全然大丈夫
Dialogue: 0,0:17:11.87,0:17:12.40,jp,,0,0,0,,ちょっと
Dialogue: 0,0:17:13.48,0:17:15.98,jp,,0,0,0,,古見さんも頼みたいことあったら言ってね
Dialogue: 0,0:17:23.74,0:17:27.82,jp,,0,0,0,,さ　左藤さんも
Dialogue: 0,0:17:31.46,0:17:32.90,jp,,0,0,0,,全部はダメですよ
Dialogue: 0,0:17:33.11,0:17:36.33,jp,,0,0,0,,僕が半分持つんで　残りを２人で持っていただければ
Dialogue: 0,0:17:43.01,0:17:45.47,jp,,0,0,0,,しょうがないなあ　僕も持ってあげるよ
Dialogue: 0,0:17:45.47,0:17:46.88,jp,,0,0,0,,お前は初めから持て
Dialogue: 0,0:17:49.00,0:17:52.01,jp,,0,0,0,,ありがとう　左藤さん古見さん　助かりました
Dialogue: 0,0:17:53.09,0:17:54.19,jp,,0,0,0,,僕には
Dialogue: 0,0:17:54.38,0:17:56.33,jp,,0,0,0,,はいはい　ありがとな
Dialogue: 0,0:17:59.87,0:18:01.38,jp,,0,0,0,,そういえば私
Dialogue: 0,0:18:01.64,0:18:05.06,jp,,0,0,0,,誰かにものを頼んだことって今までなかった
Dialogue: 0,0:18:09.38,0:18:10.97,jp,,0,0,0,,あの　古見さん
Dialogue: 0,0:18:12.90,0:18:17.93,jp,,0,0,0,,あの…私毎朝教室掃除したりしてるんだけど
Dialogue: 0,0:18:18.35,0:18:25.12,jp,,0,0,0,,えっとその　机拭いたり整えたりとか
Dialogue: 0,0:18:26.16,0:18:26.84,jp,,0,0,0,,だから…
Dialogue: 0,0:18:27.38,0:18:30.06,jp,,0,0,0,,えっとその…
Dialogue: 0,0:18:31.27,0:18:35.30,jp,,0,0,0,,人にお願いするのってこんなに緊張するんだ
Dialogue: 0,0:18:38.65,0:18:40.63,jp,,0,0,0,,そのよかったら
Dialogue: 0,0:18:40.82,0:18:43.66,jp,,0,0,0,,手伝ってもらえない…かな
Dialogue: 0,0:18:46.52,0:18:48.46,jp,,0,0,0,,いやっ　私何言ってるのかな
Dialogue: 0,0:18:48.67,0:18:51.29,jp,,0,0,0,,手伝ってもらうくらいだったらやめろよって思うよね
Dialogue: 0,0:18:51.29,0:18:52.99,jp,,0,0,0,,ごめんねなんか急に変な
Dialogue: 0,0:18:56.84,0:18:58.02,jp,,0,0,0,,ありが…
Dialogue: 0,0:18:58.02,0:18:59.21,jp,,0,0,0,,僕もやるー
Dialogue: 0,0:19:00.14,0:19:02.06,jp,,0,0,0,,そんなことしてくれてたんですね
Dialogue: 0,0:19:02.27,0:19:04.05,jp,,0,0,0,,ぜひ僕も手伝わせてください
Dialogue: 0,0:19:09.63,0:19:14.06,jp,,0,0,0,,その後　１年１組では朝の掃除が日課となった
Dialogue: 0,0:19:33.30,0:19:34.62,jp,,0,0,0,,どうしたの古見さん
Dialogue: 0,0:19:36.44,0:19:37.34,jp,,0,0,0,,ああ　これ
Dialogue: 0,0:19:38.48,0:19:39.57,jp,,0,0,0,,詰将棋の本
Dialogue: 0,0:19:40.91,0:19:42.31,jp,,0,0,0,,古見さんもやってみる
Dialogue: 0,0:19:43.90,0:19:46.76,jp,,0,0,0,,詰将棋にこんなに興味を持ってくれるなんて
Dialogue: 0,0:19:47.15,0:19:48.10,jp,,0,0,0,,かわいい
Dialogue: 0,0:19:49.33,0:19:51.16,jp,,0,0,0,,只野くんもどう　詰将棋
Dialogue: 0,0:19:52.32,0:19:53.04,jp,,0,0,0,,なんですか
Dialogue: 0,0:19:55.39,0:19:58.19,jp,,0,0,0,,これ　私が作った詰将棋なんだけど
Dialogue: 0,0:19:58.47,0:20:00.55,jp,,0,0,0,,何手詰めなのかは教えないでおくね
Dialogue: 0,0:20:03.86,0:20:06.61,jp,,0,0,0,,１手目はそうですね　で　次は…
Dialogue: 0,0:20:06.74,0:20:09.43,jp,,0,0,0,,いいわ　将棋でつながるコミュニケーション
Dialogue: 0,0:20:09.43,0:20:12.27,jp,,0,0,0,,老若男女誰もがつながれる盤上の奇跡
Dialogue: 0,0:20:12.75,0:20:14.46,jp,,0,0,0,,将棋　最高
Dialogue: 0,0:20:17.71,0:20:20.06,jp,,0,0,0,,いやいや　なんで歩で取りに行くんですか
Dialogue: 0,0:20:20.23,0:20:21.83,jp,,0,0,0,,飛車で行けばいいじゃないですか
Dialogue: 0,0:20:24.26,0:20:26.70,jp,,0,0,0,,歩で行ったらどうせ戻ってくるんですよ
Dialogue: 0,0:20:26.94,0:20:28.23,jp,,0,0,0,,こう　こうして
Dialogue: 0,0:20:28.47,0:20:29.69,jp,,0,0,0,,意味なくないですか
Dialogue: 0,0:20:31.63,0:20:32.49,jp,,0,0,0,,あれ
Dialogue: 0,0:20:32.91,0:20:36.20,jp,,0,0,0,,だから　こうして飛車で詰めていけば　５手で
Dialogue: 0,0:20:35.28,0:20:36.12,jpup,,0,0,0,,いや　あの…
Dialogue: 0,0:20:37.39,0:20:40.36,jp,,0,0,0,,いやいやいや　ここはやっぱり動かさないと
Dialogue: 0,0:20:40.70,0:20:42.38,jp,,0,0,0,,いや違いますって
Dialogue: 0,0:20:43.38,0:20:44.30,jp,,0,0,0,,えーと…
Dialogue: 0,0:20:45.61,0:20:47.48,jp,,0,0,0,,授業始まっちゃうね
Dialogue: 0,0:21:12.90,0:21:14.34,jp,,0,0,0,,ねえねえ聞いてよ
Dialogue: 0,0:21:14.43,0:21:16.82,jp,,0,0,0,,この前近所の工事現場でおっちゃんが
Dialogue: 0,0:21:19.93,0:21:20.50,jp,,0,0,0,,どったの
Dialogue: 0,0:21:20.61,0:21:21.53,jp,,0,0,0,,別に
Dialogue: 0,0:21:24.26,0:21:27.97,jp,,0,0,0,,何２人とも　いつの間にケンカするほど仲良くなったの
Dialogue: 0,0:23:07.99,0:23:11.11,jp,,0,0,0,,只野くんが考えてたのはこうしてこうで
Dialogue: 0,0:23:11.27,0:23:13.25,jp,,0,0,0,,金に道を止められちゃうの
Dialogue: 0,0:23:14.09,0:23:15.16,jp,,0,0,0,,そうか
Dialogue: 0,0:23:15.34,0:23:17.93,jp,,0,0,0,,玉将を動かすことしか考えてませんでした
Dialogue: 0,0:23:19.37,0:23:21.00,jp,,0,0,0,,古見さんもすみません
Dialogue: 0,0:23:21.42,0:23:22.72,jp,,0,0,0,,僕の早とちり
Dialogue: 0,0:23:29.64,0:23:32.06,jp,,0,0,0,,古見さんと只野くん連れてきたよ
Dialogue: 0,0:23:32.30,0:23:33.60,jp,,0,0,0,,いらっしゃい
Dialogue: 0,0:23:33.72,0:23:36.35,jp,,0,0,0,,もう知ってると思うけど　牛路田ちゃん
Dialogue: 0,0:23:36.72,0:23:40.02,jp,,0,0,0,,後ろの席だったけど　あんまり話したことなかったね
Dialogue: 0,0:23:40.16,0:23:43.44,jp,,0,0,0,,こっちは前田くん　古見さんの前の席だったよね
Dialogue: 0,0:23:43.70,0:23:45.33,jp,,0,0,0,,古見さんのおばあさんってご存命…
Comment: 0,0:00:00.00,0:00:00.00,ch,,0,0,0,,-----------Dialogue-Chinese----------
Dialogue: 1,0:00:12.44,0:00:14.48,ch,,0,0,0,,那包 巧克力
Dialogue: 1,0:00:15.20,0:00:17.86,ch,,0,0,0,,是 是我
Dialogue: 1,0:00:18.01,0:00:21.63,ch,,0,0,0,,做得…最好的 一份
Dialogue: 1,0:00:21.63,0:00:24.97,ch,,0,0,0,,还让你这么费心 谢谢你
Dialogue: 1,0:00:27.56,0:00:28.84,ch,,0,0,0,,古见同学？
Dialogue: 1,0:00:36.62,0:00:37.76,ch,,0,0,0,,硝子
Dialogue: 1,0:00:38.00,0:00:40.31,ch,,0,0,0,,差不多该出门了吧
Dialogue: 1,0:00:41.82,0:00:44.22,ch,,0,0,0,,怎么了 身体不舒服吗
Dialogue: 1,0:00:46.60,0:00:47.68,ch,,0,0,0,,因为冷不想出来？
Dialogue: 1,0:00:48.33,0:00:50.39,ch,,0,0,0,,昨天学校里发生了什么
Dialogue: 1,0:00:55.72,0:00:59.27,ch,,0,0,0,,硝子 去学校吧
Dialogue: 1,0:01:01.38,0:01:04.42,ch,,0,0,0,,今天请假的话全勤奖就拿不到了呢
Dialogue: 1,0:01:04.42,0:01:05.94,ch,,0,0,0,,这样好吗
Dialogue: 1,0:01:10.97,0:01:11.67,ch,,0,0,0,,出来了
Dialogue: 1,0:03:23.61,0:03:24.86,ch,,0,0,0,,哟 早上好
Dialogue: 1,0:03:26.41,0:03:29.05,ch,,0,0,0,,昨天的巧克力多谢 很好吃
Dialogue: 1,0:03:33.27,0:03:33.86,ch,,0,0,0,,谢谢
Dialogue: 1,0:03:34.34,0:03:35.62,ch,,0,0,0,,但是因为是烤制的点心
Dialogue: 1,0:03:35.62,0:03:38.23,ch,,0,0,0,,不用勉强自己很快全部吃完的
Dialogue: 1,0:03:38.36,0:03:41.03,ch,,0,0,0,,古见同学收了挺多巧克力吧
Dialogue: 1,0:03:41.72,0:03:42.28,ch,,0,0,0,,会胖的哦
Dialogue: 1,0:03:44.65,0:03:46.10,ch,,0,0,0,,早哈喽
Dialogue: 1,0:03:47.33,0:03:48.88,ch,,0,0,0,,古见同学送的巧克力很好吃
Dialogue: 1,0:03:48.88,0:03:51.48,ch,,0,0,0,,盟友亲制的佳肴 可谓甜美
Dialogue: 1,0:03:52.95,0:03:54.33,ch,,0,0,0,,并不赖
Dialogue: 1,0:03:54.33,0:03:56.47,ch,,0,0,0,,古古古 古见同鞋
Dialogue: 1,0:03:56.94,0:04:00.28,ch,,0,0,0,,巧巧巧克力 很很很好吃
Dialogue: 1,0:04:11.55,0:04:13.63,ch,,0,0,0,,输 输了
Dialogue: 1,0:04:13.84,0:04:15.00,ch,,0,0,0,,You　lose
Dialogue: 1,0:04:26.15,0:04:27.12,ch,,0,0,0,,怎么了古见同学
Dialogue: 1,0:04:32.11,0:04:33.43,ch,,0,0,0,,早上好古见同…
Dialogue: 1,0:04:38.07,0:04:38.63,ch,,0,0,0,,那个…
Dialogue: 1,0:04:40.48,0:04:41.21,ch,,0,0,0,,为什么
Dialogue: 1,0:04:43.35,0:04:45.12,ch,,0,0,0,,不 没事
Dialogue: 1,0:04:45.96,0:04:50.00,ch,,0,0,0,,总觉得很久没看到过古见同学这幅表情了
Dialogue: 1,0:04:57.10,0:04:59.00,ch,,0,0,0,,不过她是怎么了
Dialogue: 1,0:04:59.49,0:05:02.08,ch,,0,0,0,,感觉也不是在生气
Dialogue: 1,0:05:03.24,0:05:06.38,ch,,0,0,0,,是因为我昨天跑着追她了…吗
Dialogue: 1,0:05:07.34,0:05:10.52,ch,,0,0,0,,还是说 我说了什么奇怪的话吗
Dialogue: 1,0:05:11.00,0:05:15.44,ch,,0,0,0,,不 说到底多半应该不是因为我吧
Dialogue: 1,0:05:20.89,0:05:23.26,ch,,0,0,0,,对了 总之先把巧克力的感想
Dialogue: 1,0:05:25.32,0:05:26.67,ch,,0,0,0,,对了 巧克力
Dialogue: 1,0:05:27.35,0:05:28.84,ch,,0,0,0,,非常好吃
Dialogue: 1,0:05:29.06,0:05:31.10,ch,,0,0,0,,谢谢你昨天还特意送过来
Dialogue: 1,0:05:32.41,0:05:33.15,ch,,0,0,0,,古见同学？
Dialogue: 1,0:05:42.11,0:05:44.02,ch,,0,0,0,,好 同学们归还实验道具吧
Dialogue: 1,0:05:44.26,0:05:45.10,ch,,0,0,0,,好的
Dialogue: 1,0:05:47.99,0:05:50.88,ch,,0,0,0,,大家好 我是山井恋
Dialogue: 1,0:05:51.15,0:05:56.21,ch,,0,0,0,,今天也坐在最方便看古见同学美腿的座位
Dialogue: 1,0:05:57.46,0:05:59.92,ch,,0,0,0,,今天的古见同学也是神级美丽
Dialogue: 1,0:06:00.17,0:06:01.69,ch,,0,0,0,,真耀眼啊 古见同学
Dialogue: 1,0:06:01.90,0:06:05.88,ch,,0,0,0,,那光芒所发散出来的能量 连眼里的水分都能蒸发
Dialogue: 1,0:06:05.88,0:06:08.84,ch,,0,0,0,,或许连蛋白质都会凝固吧
Dialogue: 1,0:06:10.09,0:06:12.51,ch,,0,0,0,,绽 绽线了
Dialogue: 1,0:06:16.30,0:06:20.07,ch,,0,0,0,,不…不行啊 古见同学怎么能这么下流
Dialogue: 1,0:06:20.51,0:06:22.35,ch,,0,0,0,,快 快录下来
Dialogue: 1,0:06:23.03,0:06:24.99,ch,,0,0,0,,我要独享
Dialogue: 1,0:06:25.91,0:06:29.57,ch,,0,0,0,,不行 绝不能让班上同学看见
Dialogue: 1,0:06:30.39,0:06:33.12,ch,,0,0,0,,总之古见同学 我帮你挡住
Dialogue: 1,0:06:33.97,0:06:37.08,ch,,0,0,0,,得自然一点 不能让大家发现
Dialogue: 1,0:06:37.23,0:06:38.29,ch,,0,0,0,,自然一点
Dialogue: 1,0:06:41.80,0:06:42.51,ch,,0,0,0,,山井同学？
Dialogue: 1,0:06:43.28,0:06:45.13,ch,,0,0,0,,直接告诉古见同学的话
Dialogue: 1,0:06:45.13,0:06:47.27,ch,,0,0,0,,她肯定会害羞的
Dialogue: 1,0:06:47.49,0:06:50.52,ch,,0,0,0,,要是不告诉她 她回家后也会害羞到死的
Dialogue: 1,0:06:50.69,0:06:52.98,ch,,0,0,0,,当然她回家之前我都会死守住
Dialogue: 1,0:06:53.40,0:06:56.15,ch,,0,0,0,,怎 怎么办
Dialogue: 1,0:06:57.07,0:06:59.33,ch,,0,0,0,,不…不可以 山井恋
Dialogue: 1,0:06:59.51,0:07:01.99,ch,,0,0,0,,你刚想去碰古见同学丝袜绽线的地方
Dialogue: 1,0:07:02.75,0:07:05.85,ch,,0,0,0,,你下意识想去抠开破洞
Dialogue: 1,0:07:06.08,0:07:07.82,ch,,0,0,0,,好想撕
Dialogue: 1,0:07:08.10,0:07:11.12,ch,,0,0,0,,好想一块一块地撕破古见同学的丝袜
Dialogue: 1,0:07:09.14,0:07:10.12,chup,,0,0,0,,那个
Dialogue: 1,0:07:11.44,0:07:13.77,ch,,0,0,0,,好想目睹古见同学衣冠不整的样子
Dialogue: 1,0:07:14.06,0:07:15.32,ch,,0,0,0,,但是不行
Dialogue: 1,0:07:14.48,0:07:16.36,chup,,0,0,0,,山井同学
Dialogue: 1,0:07:15.94,0:07:18.08,ch,,0,0,0,,不可以啊 山井恋
Dialogue: 1,0:07:19.35,0:07:20.30,ch,,0,0,0,,有了
Dialogue: 1,0:07:23.94,0:07:24.70,ch,,0,0,0,,古见同学
Dialogue: 1,0:07:27.03,0:07:30.69,ch,,0,0,0,,古见同学 你的丝袜 左大腿那里绽线了
Dialogue: 1,0:07:38.38,0:07:39.90,ch,,0,0,0,,没事别担心
Dialogue: 1,0:07:40.43,0:07:43.41,ch,,0,0,0,,古见同学穿的牌子的80D丝袜
Dialogue: 1,0:07:43.91,0:07:45.85,ch,,0,0,0,,我都随身带着呢
Dialogue: 1,0:07:48.54,0:07:50.65,ch,,0,0,0,,来 去洗手间换吧
Dialogue: 1,0:07:51.17,0:07:52.35,ch,,0,0,0,,走吧
Dialogue: 1,0:07:52.49,0:07:53.12,ch,,0,0,0,,啊
Dialogue: 1,0:07:56.06,0:07:58.49,ch,,0,0,0,,破洞变大了吗 还好吗
Dialogue: 1,0:07:59.94,0:08:00.72,ch,,0,0,0,,对不起
Dialogue: 1,0:08:03.96,0:08:06.35,ch,,0,0,0,,再早点告诉你就好了
Dialogue: 1,0:08:07.43,0:08:09.78,ch,,0,0,0,,又担心古见同学会难为情
Dialogue: 1,0:08:10.91,0:08:13.84,ch,,0,0,0,,但被大家看到会更难为情吧 对不起
Dialogue: 1,0:08:25.71,0:08:26.78,ch,,0,0,0,,古见同学
Dialogue: 1,0:08:32.58,0:08:33.43,ch,,0,0,0,,穿上吧
Dialogue: 1,0:08:33.76,0:08:35.29,ch,,0,0,0,,破了的那条我帮你拿着吧
Dialogue: 1,0:09:10.93,0:09:12.57,ch,,0,0,0,,什么情况
Dialogue: 1,0:09:13.89,0:09:15.29,ch,,0,0,0,,要抓住她吗
Dialogue: 1,0:09:35.05,0:09:36.33,ch,,0,0,0,,鬼岛朱子
Dialogue: 1,0:09:37.43,0:09:39.69,ch,,0,0,0,,她是山井小团体的一员
Dialogue: 1,0:09:39.82,0:09:41.46,ch,,0,0,0,,也是古见同学的朋友
Dialogue: 1,0:09:41.97,0:09:43.50,ch,,0,0,0,,她很阳光 总是以笑脸示人
Dialogue: 1,0:09:43.62,0:09:46.37,ch,,0,0,0,,人缘很好 大家都喜欢她
Dialogue: 1,0:09:47.04,0:09:49.57,ch,,0,0,0,,只野 早上好
Dialogue: 1,0:09:50.49,0:09:52.08,ch,,0,0,0,,早上好 鬼岛同学
Dialogue: 1,0:09:52.08,0:09:54.70,ch,,0,0,0,,对不起 我很急 一会见
Dialogue: 1,0:09:56.10,0:09:57.78,ch,,0,0,0,,她今天也很有精神啊
Dialogue: 1,0:09:57.78,0:10:00.66,ch,,0,0,0,,哪怕对方是只野 她也会笑着向对方打招呼
Dialogue: 1,0:10:00.81,0:10:02.08,ch,,0,0,0,,是个好女孩
Dialogue: 1,0:10:02.30,0:10:02.90,ch,,0,0,0,,喜欢
Dialogue: 1,0:10:03.28,0:10:04.02,ch,,0,0,0,,但即便
Dialogue: 1,0:10:04.16,0:10:07.62,ch,,0,0,0,,她在「理想中的青梅竹马」排第一
Dialogue: 1,0:10:11.43,0:10:12.99,ch,,0,0,0,,有时也会发火
Dialogue: 1,0:10:16.93,0:10:18.51,ch,,0,0,0,,不 当我没说…
Dialogue: 1,0:10:18.75,0:10:22.03,ch,,0,0,0,,烦死了 为啥又是红灯啊
Dialogue: 1,0:10:24.22,0:10:24.97,ch,,0,0,0,,好
Dialogue: 1,0:10:40.70,0:10:41.93,ch,,0,0,0,,又在等红灯
Dialogue: 1,0:10:46.52,0:10:48.63,ch,,0,0,0,,耳机线还缠在一起了
Dialogue: 1,0:11:14.38,0:11:15.37,ch,,0,0,0,,是山井同学
Dialogue: 1,0:11:16.42,0:11:17.27,ch,,0,0,0,,太好了
Dialogue: 1,0:11:17.57,0:11:20.59,ch,,0,0,0,,她和鬼岛同学关系很好 应该有办法处理
Dialogue: 1,0:11:23.80,0:11:26.10,ch,,0,0,0,,为啥无视了她
Dialogue: 1,0:11:26.72,0:11:28.41,ch,,0,0,0,,是你啊只野
Dialogue: 1,0:11:28.71,0:11:29.65,ch,,0,0,0,,无视？
Dialogue: 1,0:11:32.11,0:11:34.05,ch,,0,0,0,,我认识她也很久了
Dialogue: 1,0:11:35.06,0:11:37.14,ch,,0,0,0,,从小学到现在 所以很了解她
Dialogue: 1,0:11:37.69,0:11:39.98,ch,,0,0,0,,她一发火什么都干得出来
Dialogue: 1,0:11:41.10,0:11:45.10,ch,,0,0,0,,她缓解压力的方法也就只有吃饭 泡澡 睡觉 打棒球了
Dialogue: 1,0:11:45.26,0:11:49.37,ch,,0,0,0,,你也小心点 不要引火烧身哦
Dialogue: 1,0:11:49.74,0:11:52.01,ch,,0,0,0,,山井同学竟然说了这么正经的话
Dialogue: 1,0:11:55.38,0:11:57.34,ch,,0,0,0,,耳机线又缠住了
Dialogue: 1,0:12:19.57,0:12:20.80,ch,,0,0,0,,面包
Dialogue: 1,0:12:21.47,0:12:22.99,ch,,0,0,0,,终于到中午了
Dialogue: 1,0:12:23.20,0:12:25.47,ch,,0,0,0,,吃了午饭她多少能冷静一点
Dialogue: 1,0:12:50.43,0:12:53.16,ch,,0,0,0,,谢…谢谢你 古见同学
Dialogue: 1,0:12:57.35,0:12:58.22,ch,,0,0,0,,古见同学？
Dialogue: 1,0:13:18.38,0:13:20.95,ch,,0,0,0,,古见同学啊啊啊
Dialogue: 1,0:13:22.01,0:13:26.27,ch,,0,0,0,,古见同学 我们一起去棒球击球中心吧
Dialogue: 1,0:13:30.77,0:13:32.58,ch,,0,0,0,,击球中心
Dialogue: 1,0:13:35.29,0:13:36.53,ch,,0,0,0,,只野 只野
Dialogue: 1,0:13:36.53,0:13:38.05,ch,,0,0,0,,看好了我要打出本垒打
Dialogue: 1,0:13:43.76,0:13:44.63,ch,,0,0,0,,打中了
Dialogue: 1,0:13:46.14,0:13:47.50,ch,,0,0,0,,只野好普通
Dialogue: 1,0:13:48.39,0:13:49.84,ch,,0,0,0,,鬼之岛同学好强
Dialogue: 1,0:13:51.25,0:13:53.48,ch,,0,0,0,,古见同学看到了吗 本垒打
Dialogue: 1,0:13:55.78,0:13:56.60,ch,,0,0,0,,厉害吧
Dialogue: 1,0:13:56.60,0:13:59.69,ch,,0,0,0,,鬼之岛同学和古见同学是朋友
Dialogue: 1,0:14:16.50,0:14:18.38,ch,,0,0,0,,从古见同学正面来看
Dialogue: 1,0:14:18.38,0:14:21.34,ch,,0,0,0,,是坐在她左边的同班同学
Dialogue: 1,0:14:24.86,0:14:29.66,ch,,0,0,0,,好了 这样今天大家也能舒服地上课了
Dialogue: 1,0:14:33.28,0:14:34.49,ch,,0,0,0,,已经这个时间了
Dialogue: 1,0:14:39.91,0:14:43.18,ch,,0,0,0,,得让她享受到第一个到教室的快乐
Dialogue: 1,0:14:43.18,0:14:44.96,ch,,0,0,0,,左藤同学是个老好人
Dialogue: 1,0:14:46.77,0:14:49.21,ch,,0,0,0,,抱歉左藤同学 能帮我捡一下自动笔吗
Dialogue: 1,0:14:49.21,0:14:50.95,ch,,0,0,0,,嗯 好
Dialogue: 1,0:14:50.95,0:14:52.41,ch,,0,0,0,,左藤同学是个老好…
Dialogue: 1,0:14:52.70,0:14:53.56,ch,,0,0,0,,左藤
Dialogue: 1,0:14:53.75,0:14:56.46,ch,,0,0,0,,帮我到小卖部买一份限定的鸡排包吧
Dialogue: 1,0:14:56.46,0:14:57.15,ch,,0,0,0,,好呀
Dialogue: 1,0:14:57.15,0:14:58.21,ch,,0,0,0,,左藤同学是个…
Dialogue: 1,0:14:58.21,0:14:59.98,ch,,0,0,0,,左藤 抱歉 帮我挠一下后背吧
Dialogue: 1,0:14:59.98,0:15:00.78,ch,,0,0,0,,好呀
Dialogue: 1,0:15:00.78,0:15:01.59,ch,,0,0,0,,左藤同学…
Dialogue: 1,0:15:01.94,0:15:02.67,ch,,0,0,0,,好呀
Dialogue: 1,0:15:03.53,0:15:04.62,ch,,0,0,0,,我还什么都没说
Dialogue: 1,0:15:06.51,0:15:07.38,ch,,0,0,0,,我
Dialogue: 1,0:15:07.79,0:15:09.75,ch,,0,0,0,,是不是太轻易答应别人要求了？
Dialogue: 1,0:15:10.57,0:15:11.38,ch,,0,0,0,,才意识到？
Dialogue: 1,0:15:12.47,0:15:15.16,ch,,0,0,0,,左藤同学的确让做什么就做什么
Dialogue: 1,0:15:15.66,0:15:17.27,ch,,0,0,0,,左藤 给我你内裤
Dialogue: 1,0:15:17.27,0:15:18.34,ch,,0,0,0,,你太恶心了
Dialogue: 1,0:15:18.34,0:15:19.15,ch,,0,0,0,,你妈妈的
Dialogue: 1,0:15:19.15,0:15:20.23,ch,,0,0,0,,更恶心了
Dialogue: 1,0:15:20.23,0:15:21.54,ch,,0,0,0,,恶心他妈给恶心开门
Dialogue: 1,0:15:22.86,0:15:23.47,ch,,0,0,0,,好呀
Dialogue: 1,0:15:23.47,0:15:24.36,ch,,0,0,0,,好你个头
Dialogue: 1,0:15:24.46,0:15:26.42,ch,,0,0,0,,该拒绝时就要果断拒绝
Dialogue: 1,0:15:27.49,0:15:29.98,ch,,0,0,0,,但只是内裤而已 还好吧
Dialogue: 1,0:15:29.98,0:15:31.18,ch,,0,0,0,,不可以
Dialogue: 1,0:15:32.18,0:15:33.94,ch,,0,0,0,,来练习一下说「不」
Dialogue: 1,0:15:34.07,0:15:36.25,ch,,0,0,0,,我随便拜托你点事 记得说「不」
Dialogue: 1,0:15:36.78,0:15:37.60,ch,,0,0,0,,好呀
Dialogue: 1,0:15:42.07,0:15:44.37,ch,,0,0,0,,那个 我父母欠债了
Dialogue: 1,0:15:44.50,0:15:45.85,ch,,0,0,0,,能借我10万日元吗
Dialogue: 1,0:15:46.67,0:15:48.08,ch,,0,0,0,,我努力试试
Dialogue: 1,0:15:48.25,0:15:49.62,ch,,0,0,0,,毕竟是影子的请求
Dialogue: 1,0:15:49.62,0:15:51.72,ch,,0,0,0,,都说了要说「不」虽然你这么说我很开心
Dialogue: 1,0:15:51.94,0:15:54.12,ch,,0,0,0,,那给我你奶奶的内裤吧
Dialogue: 1,0:15:54.12,0:15:56.86,ch,,0,0,0,,你怎么还在继续那个话题 太恶心了
Dialogue: 1,0:15:56.86,0:15:57.26,ch,,0,0,0,,好呀
Dialogue: 1,0:15:57.26,0:15:58.06,ch,,0,0,0,,不行
Dialogue: 1,0:16:03.15,0:16:06.46,ch,,0,0,0,,因为温柔待人我自己也会很开心
Dialogue: 1,0:16:06.70,0:16:09.25,ch,,0,0,0,,所以总觉得没办法拒绝
Dialogue: 1,0:16:09.55,0:16:11.35,ch,,0,0,0,,给我你太奶奶的…
Dialogue: 1,0:16:13.39,0:16:15.65,ch,,0,0,0,,所以说别人什么要求你都答应的话
Dialogue: 1,0:16:15.65,0:16:17.38,ch,,0,0,0,,总有一天会被骗的
Dialogue: 1,0:16:17.54,0:16:19.01,ch,,0,0,0,,而且太惯着一个人的话
Dialogue: 1,0:16:19.01,0:16:21.34,ch,,0,0,0,,那个人肯定会越来越废的
Dialogue: 1,0:16:20.55,0:16:21.52,chup,,0,0,0,,左藤抱歉
Dialogue: 1,0:16:21.52,0:16:23.43,ch,,0,0,0,,帮我拿一下那边的球
Dialogue: 1,0:16:23.43,0:16:24.09,ch,,0,0,0,,好呀
Dialogue: 1,0:16:24.09,0:16:25.42,ch,,0,0,0,,我话还没说完
Dialogue: 1,0:16:30.28,0:16:32.18,ch,,0,0,0,,太惯着别人
Dialogue: 1,0:16:32.82,0:16:34.09,ch,,0,0,0,,那边那位 抱歉
Dialogue: 1,0:16:34.09,0:16:36.28,ch,,0,0,0,,帮我按住海报的这一角
Dialogue: 1,0:16:36.28,0:16:37.23,ch,,0,0,0,,好呀
Dialogue: 1,0:16:37.74,0:16:38.49,ch,,0,0,0,,好呀
Dialogue: 1,0:16:39.49,0:16:40.26,ch,,0,0,0,,好呀
Dialogue: 1,0:16:41.14,0:16:42.04,ch,,0,0,0,,好呀
Dialogue: 1,0:16:43.03,0:16:44.42,ch,,0,0,0,,说起来
Dialogue: 1,0:16:44.71,0:16:48.32,ch,,0,0,0,,为什么我会对答应太多别人的请求产生疑问来着
Dialogue: 1,0:16:50.86,0:16:52.17,ch,,0,0,0,,谢谢
Dialogue: 1,0:16:58.33,0:16:59.27,ch,,0,0,0,,没事吧
Dialogue: 1,0:17:00.38,0:17:01.04,ch,,0,0,0,,谢谢
Dialogue: 1,0:17:01.35,0:17:03.02,ch,,0,0,0,,要搬去教师办公室吗
Dialogue: 1,0:17:03.02,0:17:05.26,ch,,0,0,0,,好呀 我帮你搬过去吧
Dialogue: 1,0:17:05.62,0:17:08.47,ch,,0,0,0,,啊没事的 这一沓还是挺重的
Dialogue: 1,0:17:08.64,0:17:09.81,ch,,0,0,0,,没事没事
Dialogue: 1,0:17:09.81,0:17:11.05,ch,,0,0,0,,我拿得动
Dialogue: 1,0:17:11.87,0:17:12.40,ch,,0,0,0,,等下
Dialogue: 1,0:17:13.48,0:17:15.98,ch,,0,0,0,,古见同学有想让我帮忙的事也可以说哦
Dialogue: 1,0:17:23.74,0:17:27.82,ch,,0,0,0,,左 左藤同学也是
Dialogue: 1,0:17:31.46,0:17:32.90,ch,,0,0,0,,全让你拿可不行
Dialogue: 1,0:17:33.11,0:17:36.33,ch,,0,0,0,,我来搬一半 剩下的能麻烦你们帮我搬就够了
Dialogue: 1,0:17:43.01,0:17:45.47,ch,,0,0,0,,真没办法 我也来帮帮你吧
Dialogue: 1,0:17:45.47,0:17:46.88,ch,,0,0,0,,你一开始就该来
Dialogue: 1,0:17:49.00,0:17:52.01,ch,,0,0,0,,谢谢你们 左藤同学和古见同学 帮大忙了
Dialogue: 1,0:17:53.09,0:17:54.19,ch,,0,0,0,,那我呢
Dialogue: 1,0:17:54.38,0:17:56.33,ch,,0,0,0,,好好好 也谢谢你
Dialogue: 1,0:17:59.87,0:18:01.38,ch,,0,0,0,,话说起来
Dialogue: 1,0:18:01.64,0:18:05.06,ch,,0,0,0,,我从没主动请别人帮过忙
Dialogue: 1,0:18:09.38,0:18:10.97,ch,,0,0,0,,古见同学
Dialogue: 1,0:18:12.90,0:18:17.93,ch,,0,0,0,,我其实每天早上都会来打扫教室
Dialogue: 1,0:18:18.35,0:18:25.12,ch,,0,0,0,,比如像是擦桌子 摆放桌椅之类的
Dialogue: 1,0:18:26.16,0:18:26.84,ch,,0,0,0,,所以…
Dialogue: 1,0:18:27.38,0:18:30.06,ch,,0,0,0,,就是…
Dialogue: 1,0:18:31.27,0:18:35.30,ch,,0,0,0,,请别人帮忙原来会这么紧张啊
Dialogue: 1,0:18:38.65,0:18:40.63,ch,,0,0,0,,可以的话
Dialogue: 1,0:18:40.82,0:18:43.66,ch,,0,0,0,,能麻烦你帮帮我…吗
Dialogue: 1,0:18:46.52,0:18:48.46,ch,,0,0,0,,不是 我在说什么呢
Dialogue: 1,0:18:48.67,0:18:51.29,ch,,0,0,0,,与其请人帮忙还不如不干对吧
Dialogue: 1,0:18:51.29,0:18:52.99,ch,,0,0,0,,对不起突然说这种怪话
Dialogue: 1,0:18:56.84,0:18:58.02,ch,,0,0,0,,谢…
Dialogue: 1,0:18:58.02,0:18:59.21,ch,,0,0,0,,我也要来
Dialogue: 1,0:19:00.14,0:19:02.06,ch,,0,0,0,,原来你每天还做了这种事啊
Dialogue: 1,0:19:02.27,0:19:04.05,ch,,0,0,0,,请务必让我也参与进来
Dialogue: 1,0:19:09.63,0:19:14.06,ch,,0,0,0,,从此 清晨的打扫成为了1年1班的每日必修
Dialogue: 1,0:19:33.30,0:19:34.62,ch,,0,0,0,,怎么了古见同学
Dialogue: 1,0:19:36.44,0:19:37.34,ch,,0,0,0,,哦这个啊
Dialogue: 1,0:19:38.48,0:19:39.57,ch,,0,0,0,,这是将棋残局的书
Dialogue: 1,0:19:40.91,0:19:42.31,ch,,0,0,0,,你要试试吗
Dialogue: 1,0:19:43.90,0:19:46.76,ch,,0,0,0,,她居然对将棋残局这么感兴趣
Dialogue: 1,0:19:47.15,0:19:48.10,ch,,0,0,0,,好可爱
Dialogue: 1,0:19:49.33,0:19:51.16,ch,,0,0,0,,只野也来吧 解将棋残局
Dialogue: 1,0:19:52.32,0:19:53.04,ch,,0,0,0,,什么
Dialogue: 1,0:19:55.39,0:19:58.19,ch,,0,0,0,,这是我自己做出来的残局棋谱
Dialogue: 1,0:19:58.47,0:20:00.55,ch,,0,0,0,,我先不告诉你们要走几步将死
Dialogue: 1,0:20:03.86,0:20:06.61,ch,,0,0,0,,第一手确实该这样走呢 然后…
Dialogue: 1,0:20:06.74,0:20:09.43,ch,,0,0,0,,太棒了 由将棋牵起的交流
Dialogue: 1,0:20:09.43,0:20:12.27,ch,,0,0,0,,能将男女老少连结起来的棋盘奇迹
Dialogue: 1,0:20:12.75,0:20:14.46,ch,,0,0,0,,将棋 万岁
Dialogue: 1,0:20:17.71,0:20:20.06,ch,,0,0,0,,不不不 为什么要用「步」将呢
Dialogue: 1,0:20:20.23,0:20:21.83,ch,,0,0,0,,用「飞车」不就行了
Dialogue: 1,0:20:24.26,0:20:26.70,ch,,0,0,0,,走「步」马上又得走回来啊
Dialogue: 1,0:20:26.94,0:20:28.23,ch,,0,0,0,,这样 再这样
Dialogue: 1,0:20:28.47,0:20:29.69,ch,,0,0,0,,不就白用功了吗
Dialogue: 1,0:20:31.63,0:20:32.49,ch,,0,0,0,,咦
Dialogue: 1,0:20:32.91,0:20:36.20,ch,,0,0,0,,所以说用「飞车」将 就只用5手
Dialogue: 1,0:20:35.28,0:20:36.12,chup,,0,0,0,,不是 你们…
Dialogue: 1,0:20:37.39,0:20:40.36,ch,,0,0,0,,不不不 这一手不这么走的话
Dialogue: 1,0:20:40.70,0:20:42.38,ch,,0,0,0,,肯定是你错了
Dialogue: 1,0:20:43.38,0:20:44.30,ch,,0,0,0,,你们…
Dialogue: 1,0:20:45.61,0:20:47.48,ch,,0,0,0,,上课了
Dialogue: 1,0:21:12.90,0:21:14.34,ch,,0,0,0,,听我说听我说
Dialogue: 1,0:21:14.43,0:21:16.82,ch,,0,0,0,,之前在我家附近有个施工场地的大叔
Dialogue: 1,0:21:19.93,0:21:20.50,ch,,0,0,0,,怎么了
Dialogue: 1,0:21:20.61,0:21:21.53,ch,,0,0,0,,没什么
Dialogue: 1,0:21:24.26,0:21:27.97,ch,,0,0,0,,你们俩什么时候关系好到能吵架了
Dialogue: 1,0:23:07.99,0:23:11.11,ch,,0,0,0,,只野的设想是先这样再这样
Dialogue: 1,0:23:11.27,0:23:13.25,ch,,0,0,0,,但棋路会被「金」封死
Dialogue: 1,0:23:14.09,0:23:15.16,ch,,0,0,0,,这样啊
Dialogue: 1,0:23:15.34,0:23:17.93,ch,,0,0,0,,我光想着怎么让「玉将」移动了
Dialogue: 1,0:23:19.37,0:23:21.00,ch,,0,0,0,,古见同学 抱歉
Dialogue: 1,0:23:21.42,0:23:22.72,ch,,0,0,0,,是我急着下定论了
Dialogue: 1,0:23:29.64,0:23:32.06,ch,,0,0,0,,我把古见同学和只野叫来了哦
Dialogue: 1,0:23:32.30,0:23:33.60,ch,,0,0,0,,欢迎欢迎
Dialogue: 1,0:23:33.72,0:23:36.35,ch,,0,0,0,,虽然你们也都认识了 这位是牛路田
Dialogue: 1,0:23:36.72,0:23:40.02,ch,,0,0,0,,虽说坐在你们后桌 但还没怎么说过话呢
Dialogue: 1,0:23:40.16,0:23:43.44,ch,,0,0,0,,这位是前田 应该是坐在古见同学前面的吧
Dialogue: 1,0:23:43.70,0:23:45.33,ch,,0,0,0,,古见同学的奶奶还健在…
Comment: 0,0:00:30.01,0:00:30.01,OPJP,,0,0,0,,---------------OP------------
Comment: 0,0:01:53.38,0:02:01.23,OPJP,,0,0,0,,{\blur5\fad(200,200)}太陽に投げた言葉たち　砕けて　光ってる
Comment: 0,0:02:01.23,0:02:09.19,OPJP,,0,0,0,,{\blur5\fad(200,200)}君は手のひらにならべたね　痛くないふりしてさ
Comment: 0,0:02:09.19,0:02:17.37,OPJP,,0,0,0,,{\blur5\fad(200,200)}「わたしのままでいい」なんて未来　一緒に探してる
Comment: 0,0:02:17.37,0:02:25.08,OPJP,,0,0,0,,{\blur5\fad(200,200)}初めて越えた白線はもう　ここから見えないくらい
Comment: 0,0:02:25.08,0:02:33.55,OPJP,,0,0,0,,{\blur5\fad(200,200)}君と走れば　いつも風が生まれる
Comment: 0,0:02:33.55,0:02:37.47,OPJP,,0,0,0,,{\blur5\fad(200,200)}あの空、青100色
Comment: 0,0:02:37.47,0:02:41.27,OPJP,,0,0,0,,{\blur5\fad(200,200)}瞬きさえできない
Comment: 0,0:02:41.27,0:02:41.72,OPJP,,0,0,0,,{\blur5\fad(200,200)}君と今日もめぐり逢う
Comment: 0,0:02:41.72,0:02:48.98,OPJP2,,0,0,0,,{\blur5\fad(200,200)}君と今日もめぐり逢う　1cmずつ　恋に落ちる
Comment: 0,0:02:48.98,0:02:57.28,OPJP2,,0,0,0,,{\blur5\fad(200,200)}いつも肩が触れるたび　1cmずつ　恋が揺れる
Comment: 0,0:02:57.28,0:03:04.37,OPJP2,,0,0,0,,{\blur5\fad(200,200)}君の優しい鼓動ずっと聴いてたんだ
Comment: 0,0:03:04.37,0:03:07.83,OPJP2,,0,0,0,,{\blur5\fad(200,200)}大好きって気持ちを　ねぇ　
Comment: 0,0:03:07.83,0:03:12.55,OPJP2,,0,0,0,,{\blur5\fad(200,200)}もうこれ以上　どこにしまっておいたらいいの？
Comment: 0,0:00:00.00,0:00:00.00,OPCH,,0,0,0,,
Dialogue: 0,0:01:53.38,0:02:01.22,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1265,512)}我丢弃的话语像打碎的玻璃
Dialogue: 0,0:01:53.38,0:02:01.22,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1235,647)}在阳光下晶莹剔透
Dialogue: 0,0:02:01.22,0:02:09.19,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1265,485)}你却将其全部攥住握在手心
Dialogue: 0,0:02:01.22,0:02:09.19,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1235,623)}还装作一点也不痛
Dialogue: 0,0:02:09.19,0:02:17.37,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}你我一同 踏上寻找最真自我的路
Dialogue: 0,0:02:17.37,0:02:25.08,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}回首望去 早已不见出发时的踌躇
Dialogue: 0,0:02:25.08,0:02:33.55,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,595)}一同奔跑时 风儿总是如此喧嚣
Dialogue: 0,0:02:33.55,0:02:37.47,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}看啊那片天空 青１００色
Dialogue: 0,0:02:37.47,0:02:41.26,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,480)}连眨眼都眨不了
Dialogue: 0,0:02:41.26,0:02:41.72,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,508)}今天我也将与你邂逅
Dialogue: 1,0:02:41.72,0:02:48.98,OPCH2,,0,0,0,,今天我也将与你邂逅 一点一点 坠入爱河
Dialogue: 1,0:02:48.98,0:02:57.28,OPCH2,,0,0,0,,肩膀的距离逐渐靠近 一点一点 心在颤抖
Dialogue: 1,0:02:57.28,0:03:04.37,OPCH2,,0,0,0,,我早已听见了你那温柔的心跳
Dialogue: 1,0:03:04.37,0:03:07.83,OPCH2,,0,0,0,,那你说 我对你的爱意
Dialogue: 1,0:03:07.83,0:03:12.55,OPCH2,,0,0,0,,要再往哪里藏起来才好
Dialogue: 0,0:02:41.72,0:02:48.98,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}今天我也将与你邂逅 一点一点 坠入爱河
Dialogue: 0,0:02:48.98,0:02:57.28,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}肩膀的距离逐渐靠近 一点一点 心在颤抖
Dialogue: 0,0:02:57.28,0:03:04.37,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}我早已听见了你那温柔的心跳
Dialogue: 0,0:03:04.37,0:03:07.83,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}那你说 我对你的爱意
Dialogue: 0,0:03:07.83,0:03:12.54,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}要再往哪里藏起来才好
Comment: 0,0:02:07.57,0:02:09.57,EDJP,,0,0,0,,---------------ED------------
Dialogue: 0,0:21:44.95,0:21:46.62,EDJP,,0,0,0,,曲がり角はすぐそこに
Dialogue: 0,0:21:46.62,0:21:48.12,EDJP,,0,0,0,,もう見えているのに
Dialogue: 0,0:21:49.25,0:21:50.58,EDJP,,0,0,0,,気づかれないように
Dialogue: 0,0:21:50.58,0:21:53.46,EDJP,,0,0,0,,心の中でカウントしてる　(1　2　3)
Dialogue: 0,0:21:53.63,0:21:55.63,EDJP,,0,0,0,,響く靴音はひとつだけ
Dialogue: 0,0:21:55.63,0:21:57.38,EDJP,,0,0,0,,見えないパラメーターが
Dialogue: 0,0:21:57.46,0:21:59.55,EDJP,,0,0,0,,気になって仕方がないまま
Dialogue: 0,0:21:59.63,0:22:03.26,EDJP,,0,0,0,,いつだって客席から誰かを見てる　(Ah)
Dialogue: 0,0:22:03.34,0:22:07.35,EDJP,,0,0,0,,寂しがりの歌を耳に詰め込んで　(Ah)
Dialogue: 0,0:22:07.81,0:22:11.77,EDJP,,0,0,0,,くすぐったい考え事をして　(Ah)
Dialogue: 0,0:22:12.19,0:22:14.40,EDJP,,0,0,0,,何度だって手を取り合えそうだ
Dialogue: 0,0:22:14.40,0:22:16.65,EDJP,,0,0,0,,案外大丈夫　(案外大丈夫)
Dialogue: 0,0:22:16.65,0:22:19.03,EDJP,,0,0,0,,案外大丈夫　Ah
Dialogue: 0,0:22:19.73,0:22:21.36,EDJP,,0,0,0,,そっと踏み出すと
Dialogue: 0,0:22:21.36,0:22:23.91,EDJP,,0,0,0,,塗り変えられていく　(Ah)
Dialogue: 0,0:22:24.11,0:22:25.78,EDJP,,0,0,0,,知ってるはずの景色
Dialogue: 0,0:22:25.78,0:22:28.54,EDJP,,0,0,0,,いつもより静かで　(いつもより静かで)
Dialogue: 0,0:22:28.54,0:22:32.04,EDJP,,0,0,0,,それでも確かに　過ぎていく風の中で
Dialogue: 0,0:22:32.08,0:22:34.54,EDJP,,0,0,0,,君の声で顔上げた
Dialogue: 0,0:22:34.54,0:22:36.96,EDJP,,0,0,0,,噛み合わない部品
Dialogue: 0,0:22:37.00,0:22:38.13,EDJP,,0,0,0,,握りしめて
Dialogue: 0,0:22:38.13,0:22:39.75,EDJP,,0,0,0,,君の色は何色？
Dialogue: 0,0:22:39.75,0:22:42.17,EDJP,,0,0,0,,少し声に出してみたくなった
Dialogue: 0,0:22:42.17,0:22:45.30,EDJP,,0,0,0,,でも　ああ、やっぱり言わなくてもいいよ
Dialogue: 0,0:22:45.43,0:22:46.72,EDJP,,0,0,0,,混ざり合う
Dialogue: 0,0:22:46.72,0:22:50.35,EDJP,,0,0,0,,信号のない交差点みたいにじんわりと
Dialogue: 0,0:22:50.39,0:22:51.73,EDJP,,0,0,0,,広がる　溶ける
Dialogue: 0,0:22:51.77,0:22:54.64,EDJP,,0,0,0,,両手いっぱいに君の言葉抱えて
Dialogue: 0,0:22:54.64,0:22:57.11,EDJP,,0,0,0,,知りたい　見てみたい　触れたい
Dialogue: 0,0:22:57.19,0:22:59.65,EDJP,,0,0,0,,ぼやけたレンズの向こうから
Dialogue: 0,0:22:59.65,0:23:01.40,EDJP,,0,0,0,,こっちに手を振ってる
Dialogue: 0,0:23:01.40,0:23:04.70,EDJP,,0,0,0,,顔が見えない誰かが
Comment: 0,0:00:00.00,0:00:00.00,EDCH,,0,0,0,,
Dialogue: 0,0:21:44.95,0:21:46.62,EDCH,,0,0,0,,窗外便是路口的转角
Dialogue: 0,0:21:46.62,0:21:48.12,EDCH,,0,0,0,,明明早已捕捉到你的身影
Dialogue: 0,0:21:49.25,0:21:50.58,EDCH,,0,0,0,,却满心祈祷着别被你注意
Dialogue: 0,0:21:50.58,0:21:53.46,EDCH,,0,0,0,,内心里倒数 （1 2 3）
Dialogue: 0,0:21:53.63,0:21:55.63,EDCH,,0,0,0,,能听见的脚步声只有一个
Dialogue: 0,0:21:55.63,0:21:57.38,EDCH,,0,0,0,,没有实体的变量
Dialogue: 0,0:21:57.46,0:21:59.55,EDCH,,0,0,0,,令我无法不在意
Dialogue: 0,0:21:59.63,0:22:03.26,EDCH,,0,0,0,,总是坐在店里寻找着某人的身影 （Ah）
Dialogue: 0,0:22:03.34,0:22:07.35,EDCH,,0,0,0,,用伤感的音乐堵住我的双耳 （Ah）
Dialogue: 0,0:22:07.81,0:22:11.77,EDCH,,0,0,0,,想着那些让人悸动的心事 （Ah）
Dialogue: 0,0:22:12.19,0:22:14.40,EDCH,,0,0,0,,好几次差点直接牵起你的手
Dialogue: 0,0:22:14.40,0:22:16.65,EDCH,,0,0,0,,还好忍住了 （还好忍住了）
Dialogue: 0,0:22:16.65,0:22:19.03,EDCH,,0,0,0,,还好忍住了  Ah
Dialogue: 0,0:22:19.73,0:22:21.36,EDCH,,0,0,0,,轻轻踏出了一步后
Dialogue: 0,0:22:21.36,0:22:23.91,EDCH,,0,0,0,,眼前的世界变化了 （Ah）
Dialogue: 0,0:22:24.11,0:22:25.78,EDCH,,0,0,0,,本应熟悉的景色
Dialogue: 0,0:22:25.78,0:22:28.54,EDCH,,0,0,0,,却比以往更静谧 （却比以往更静谧）
Dialogue: 0,0:22:28.54,0:22:32.04,EDCH,,0,0,0,,即便如此 在这拂过的风中
Dialogue: 0,0:22:32.08,0:22:34.54,EDCH,,0,0,0,,我应你的声抬起了头
Dialogue: 0,0:22:34.54,0:22:36.96,EDCH,,0,0,0,,将不合适的零件
Dialogue: 0,0:22:37.00,0:22:38.13,EDCH,,0,0,0,,紧攥手中
Dialogue: 0,0:22:38.13,0:22:39.75,EDCH,,0,0,0,,你是什么颜色
Dialogue: 0,0:22:39.75,0:22:42.17,EDCH,,0,0,0,,有点想开口问问你
Dialogue: 0,0:22:42.17,0:22:45.30,EDCH,,0,0,0,,但是 啊 果然还是别问了吧
Dialogue: 0,0:22:45.43,0:22:46.72,EDCH,,0,0,0,,思绪乱成一团
Dialogue: 0,0:22:46.72,0:22:50.35,EDCH,,0,0,0,,像是没有红绿灯的十字路口一般
Dialogue: 0,0:22:50.39,0:22:51.73,EDCH,,0,0,0,,渐渐扩散 溶化
Dialogue: 0,0:22:51.77,0:22:54.64,EDCH,,0,0,0,,两只手都塞满了你的话语
Dialogue: 0,0:22:54.64,0:22:57.11,EDCH,,0,0,0,,好想了解你 注视你 触碰你
Dialogue: 0,0:22:57.19,0:22:59.65,EDCH,,0,0,0,,朦胧的镜头里映出的
Dialogue: 0,0:22:59.65,0:23:01.40,EDCH,,0,0,0,,向着我挥手的
Dialogue: 0,0:23:01.40,0:23:04.70,EDCH,,0,0,0,,看不见面容的某人
Comment: 0,0:00:00.00,0:00:00.00,EDCH,,0,0,0,,

