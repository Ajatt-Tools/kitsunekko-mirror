Dialogue: 0,0:00:10.48,0:00:13.76,jp,,0,0,0,,例えば　特殊な状況で仲良くなった人と
Dialogue: 0,0:00:13.92,0:00:16.46,jp,,0,0,0,,休みを挟んで次に会ったときには
Dialogue: 0,0:00:17.10,0:00:18.90,jp,,0,0,0,,テンション高く挨拶して
Dialogue: 0,0:00:19.06,0:00:22.93,jp,,0,0,0,,「あ　うん」みたいな感じで引かれちゃったらどうしよう
Dialogue: 0,0:00:23.22,0:00:25.52,jp,,0,0,0,,かといって避けるのは不自然だし
Dialogue: 0,0:00:26.54,0:00:28.38,jp,,0,0,0,,今目が合ったのにそらしちゃった
Dialogue: 0,0:00:29.11,0:00:30.24,jp,,0,0,0,,というように
Dialogue: 0,0:00:31.23,0:00:34.09,jp,,0,0,0,,どんな感じで声かければいいのか分からない
Dialogue: 0,0:00:34.22,0:00:35.41,jp,,0,0,0,,ものなのである
Dialogue: 0,0:00:38.45,0:00:39.42,jp,,0,0,0,,上理
Dialogue: 0,0:00:39.42,0:00:39.98,jp,,0,0,0,,ひゃい
Dialogue: 0,0:00:41.65,0:00:45.91,jp,,0,0,0,,その　修学旅行のとき話題に上がっていた小説だ
Dialogue: 0,0:00:48.04,0:00:50.29,jp,,0,0,0,,わざわざ持ってきてくれたんですね
Dialogue: 0,0:00:50.49,0:00:51.86,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:00:54.87,0:00:57.08,jp,,0,0,0,,うむ　感謝するがいい
Dialogue: 0,0:00:59.06,0:01:02.31,jp,,0,0,0,,ダークネス菊一文字（笑）は戻ってきたの
Dialogue: 0,0:01:02.31,0:01:04.04,jp,,0,0,0,,（笑）は余計だ
Dialogue: 0,0:01:04.45,0:01:06.38,jp,,0,0,0,,ちゃんと１人で電話できた
Dialogue: 0,0:01:06.38,0:01:08.38,jp,,0,0,0,,できるわ　そんくらい
Dialogue: 0,0:01:10.28,0:01:12.02,jp,,0,0,0,,すげえじゃん　井中
Dialogue: 0,0:01:12.39,0:01:13.89,jp,,0,0,0,,これ井中が作ったの
Dialogue: 0,0:01:13.89,0:01:16.00,jp,,0,0,0,,かわいいですね
Dialogue: 0,0:01:16.16,0:01:18.14,jp,,0,0,0,,迷惑じゃないべか
Dialogue: 0,0:01:18.85,0:01:19.60,jp,,0,0,0,,なんで
Dialogue: 0,0:01:19.84,0:01:21.18,jp,,0,0,0,,めっちゃうれしいよ
Dialogue: 0,0:01:21.18,0:01:23.62,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:01:21.46,0:01:22.80,jpup,,0,0,0,,おい　来たぞ
Dialogue: 0,0:01:28.54,0:01:31.70,jp,,0,0,0,,きょ　今日こそみんなに「おはよう」って言うぞ
Dialogue: 0,0:01:32.29,0:01:33.50,jp,,0,0,0,,おはよう　片居くん
Dialogue: 0,0:01:35.18,0:01:36.91,jp,,0,0,0,,只野くん優しい
Dialogue: 0,0:01:37.26,0:01:39.10,jp,,0,0,0,,片居さん　おはようございます
Dialogue: 0,0:01:40.69,0:01:41.35,jp,,0,0,0,,片居
Dialogue: 0,0:01:42.21,0:01:45.56,jp,,0,0,0,,この前のお前の体　なかなかよかったぞ
Dialogue: 0,0:01:47.28,0:01:48.90,jp,,0,0,0,,そうだ　写真をやろう
Dialogue: 0,0:01:49.09,0:01:51.79,jp,,0,0,0,,あのときの「芸術」　お前も配るがいい
Dialogue: 0,0:01:52.96,0:01:54.57,jp,,0,0,0,,じゃあまたあとでねー
Dialogue: 0,0:01:54.83,0:01:56.11,jp,,0,0,0,,うん　またね
Dialogue: 0,0:02:12.18,0:02:13.29,jp,,0,0,0,,行かない
Dialogue: 0,0:02:35.90,0:02:36.62,jp,,0,0,0,,古見さん？
Dialogue: 0,0:02:39.24,0:02:41.06,jp,,0,0,0,,えっと　おはよう
Dialogue: 0,0:02:48.10,0:02:51.54,jp,,0,0,0,,やっぱりなんか面白いね　ノートで会話って
Dialogue: 0,0:02:52.72,0:02:54.16,jp,,0,0,0,,おはよう　古見さん
Dialogue: 0,0:02:55.08,0:02:56.78,jp,,0,0,0,,なんかツボに入っちゃった
Dialogue: 0,0:02:58.15,0:02:59.01,jp,,0,0,0,,ちょっとごめん
Dialogue: 0,0:02:59.01,0:02:59.96,jp,,0,0,0,,あーい
Dialogue: 0,0:03:04.71,0:03:05.46,jp,,0,0,0,,おはよう
Dialogue: 0,0:03:06.79,0:03:08.06,jp,,0,0,0,,一方　そのころ
Dialogue: 0,0:04:42.78,0:04:44.91,jp,,600,0,0,,そういえば　古見さんはさ
Dialogue: 0,0:04:45.14,0:04:46.38,jp,,0,0,0,,バレンタインどうする
Dialogue: 0,0:04:53.54,0:04:55.15,jp,,0,0,0,,なんか間があったね
Dialogue: 0,0:04:56.02,0:04:58.82,jp,,0,0,0,,じゃあさ　今日うちで一緒に作らない
Dialogue: 0,0:04:59.10,0:05:02.03,jp,,0,0,0,,毎年家族に渡す用のやつ作ってるんだけどさ
Dialogue: 0,0:05:02.03,0:05:06.06,jp,,0,0,0,,せっかくだし　友達も誘って一緒に作った方が楽しいだろ
Dialogue: 0,0:05:07.07,0:05:08.78,jp,,0,0,0,,おし　じゃあ　決まりね
Dialogue: 0,0:05:08.92,0:05:10.50,jp,,0,0,0,,私も
Dialogue: 0,0:05:10.50,0:05:13.00,jp,,0,0,0,,行っていいですか
Dialogue: 0,0:05:13.00,0:05:14.35,jp,,0,0,0,,おう　来い来い
Dialogue: 0,0:05:16.18,0:05:17.54,jp,,0,0,0,,悪いな　只野
Dialogue: 0,0:05:17.74,0:05:19.20,jp,,0,0,0,,今日は女子会なんだ
Dialogue: 0,0:05:19.65,0:05:22.13,jp,,0,0,0,,別に行きたいと思ってませんよ
Dialogue: 0,0:05:27.77,0:05:29.10,jp,,0,0,0,,はーい　到着
Dialogue: 0,0:05:29.97,0:05:31.04,jp,,0,0,0,,ただいま
Dialogue: 0,0:05:32.02,0:05:34.81,jp,,0,0,0,,あいつら　また脱ぎ散らかして
Dialogue: 0,0:05:36.02,0:05:37.68,jp,,0,0,0,,ねえちゃんおかえり
Dialogue: 0,0:05:37.80,0:05:40.14,jp,,0,0,0,,かえで姉ちゃんもよく来たな
Dialogue: 0,0:05:40.14,0:05:43.10,jp,,0,700,0,,お邪魔します
Dialogue: 0,0:05:41.69,0:05:44.25,jp,,350,0,0,,ねえねえ　今日は何して遊…
Dialogue: 0,0:06:02.41,0:06:03.90,jp,,0,0,0,,あれ　弟たちな
Dialogue: 0,0:06:04.24,0:06:07.59,jp,,0,0,0,,４人いるから邪魔だと思うけど　仲良くしてやってくれ
Dialogue: 0,0:06:09.27,0:06:11.48,jp,,0,0,0,,よーし　じゃあ　作りますか
Dialogue: 0,0:06:13.94,0:06:16.90,jp,,0,0,0,,じゃあ　古見さんはチョコとバターを湯煎にかけて
Dialogue: 0,0:06:17.14,0:06:19.69,jp,,0,0,0,,かえでは小麦粉とココアパウダーを振るってくれ
Dialogue: 0,0:06:32.03,0:06:35.54,jp,,0,0,0,,いやまあまあ　そんな大したことじゃねえよ
Dialogue: 0,0:06:36.04,0:06:38.90,jp,,0,0,0,,じゃあ　これも湯煎しながら　砂糖混ぜて
Dialogue: 0,0:06:39.15,0:06:41.05,jp,,0,0,0,,あと生クリームとブランデーな
Dialogue: 0,0:06:41.49,0:06:43.67,jp,,0,0,0,,さっき溶かしておいたチョコも入れちゃう
Dialogue: 0,0:06:44.04,0:06:46.42,jp,,0,0,0,,よーし　メレンゲ作るぞ
Dialogue: 0,0:06:49.98,0:06:55.06,jp,,0,0,0,,おいしくなれ　おいしくなれ
Dialogue: 0,0:06:55.06,0:06:58.00,jp,,0,0,0,,それじゃ１週間かかってもできないな
Dialogue: 0,0:06:59.29,0:07:00.76,jp,,0,0,0,,俺たちもやるー
Dialogue: 0,0:07:00.76,0:07:01.78,jp,,0,0,0,,やるー
Dialogue: 0,0:07:02.02,0:07:04.14,jp,,0,0,0,,おーし　じゃ手洗ってこーい
Dialogue: 0,0:07:13.58,0:07:15.67,jp,,0,0,0,,古見さんもあっち手伝ってやって
Dialogue: 0,0:07:15.96,0:07:17.32,jp,,0,0,0,,こっちはやっとくからさ
Dialogue: 0,0:07:17.32,0:07:19.37,jp,,0,0,0,,ねえちゃん腕疲れた
Dialogue: 0,0:07:19.37,0:07:21.97,jp,,0,0,0,,まだ泡立ってないだろ　まだまだ
Dialogue: 0,0:07:34.07,0:07:35.76,jp,,0,600,0,,すごー
Dialogue: 0,0:07:35.12,0:07:37.02,jp,,600,0,0,,怖い姉ちゃんすげえ
Dialogue: 0,0:07:38.84,0:07:40.19,jp,,0,0,0,,がんばれ
Dialogue: 0,0:07:40.73,0:07:42.44,jpup,,0,0,0,,がんばれ
Dialogue: 0,0:07:40.73,0:07:42.44,jp,,0,0,0,,次あたし
Dialogue: 0,0:07:42.86,0:07:44.69,jp,,0,0,0,,がんばれ
Dialogue: 0,0:07:47.04,0:07:47.83,jp,,0,0,0,,完璧
Dialogue: 0,0:07:50.43,0:07:51.72,jp,,0,0,0,,じゃあ　次は
Dialogue: 0,0:07:51.95,0:07:54.31,jp,,0,0,0,,これにメレンゲをちょっと加えて混ぜる
Dialogue: 0,0:07:54.42,0:07:57.23,jp,,0,0,0,,振るっておいた小麦粉とココアパウダーも入れて
Dialogue: 0,0:07:57.46,0:08:00.46,jp,,0,0,0,,そんで３回くらいに分けてメレンゲを混ぜるぞ
Dialogue: 0,0:08:01.67,0:08:02.96,jp,,0,0,0,,よしっと
Dialogue: 0,0:08:03.16,0:08:05.75,jp,,0,0,0,,じゃあこれを50分焼くから
Dialogue: 0,0:08:06.82,0:08:09.22,jp,,0,0,0,,50分姉ちゃんたちに遊んでもらいな
Dialogue: 0,0:08:13.66,0:08:16.18,jp,,0,0,0,,むかしむかし
Dialogue: 0,0:08:16.77,0:08:18.90,jpup,,0,0,0,,ある所に
Dialogue: 0,0:08:19.44,0:08:24.82,jpup,,0,0,0,,おじいさんと　おばあさんが
Dialogue: 0,0:08:18.28,0:08:20.10,jp,,0,0,0,,怖い姉ちゃんさあ
Dialogue: 0,0:08:20.48,0:08:21.88,jp,,0,0,0,,なんでしゃべんないの
Dialogue: 0,0:08:23.36,0:08:25.52,jp,,0,0,0,,あたしもそれ気になってた
Dialogue: 0,0:08:26.24,0:08:30.48,jp,,0,0,0,,そのお姉ちゃんはシャイだからな　あんまりいじめるなよ
Dialogue: 0,0:08:30.61,0:08:31.74,jp,,0,0,0,,シャア？
Dialogue: 0,0:08:31.74,0:08:32.74,jp,,0,0,0,,シャアじゃない
Dialogue: 0,0:08:32.85,0:08:35.03,jp,,0,0,0,,じゃあ　「あー」って言って
Dialogue: 0,0:08:35.03,0:08:36.06,jp,,0,0,0,,「あー」って
Dialogue: 0,0:08:36.45,0:08:37.30,jp,,0,0,0,,あー
Dialogue: 0,0:08:38.14,0:08:40.40,jp,,0,0,0,,「あー」　「あー」って
Dialogue: 0,0:08:42.34,0:08:43.43,jp,,0,0,0,,あー
Dialogue: 0,0:08:47.34,0:08:48.59,jp,,0,0,0,,ケーキ膨らんだかな
Dialogue: 0,0:08:48.67,0:08:50.50,jp,,0,0,0,,見に行こ　シャアの姉ちゃん
Dialogue: 0,0:08:53.35,0:08:55.26,jp,,0,0,0,,膨らんでる膨らんでる
Dialogue: 0,0:08:56.40,0:08:57.82,jp,,0,0,0,,すげえ
Dialogue: 0,0:08:57.82,0:08:58.94,jp,,0,0,0,,ねえ
Dialogue: 0,0:08:59.30,0:09:00.98,jp,,0,0,0,,シャアの姉ちゃんさあ
Dialogue: 0,0:09:02.10,0:09:05.74,jp,,0,0,0,,キレイな声してるから　もっとしゃべった方がいいよ
Dialogue: 0,0:09:06.10,0:09:07.07,jp,,0,0,0,,うんうん
Dialogue: 0,0:09:10.91,0:09:14.81,jp,,0,0,0,,頑張り　ます
Dialogue: 0,0:09:20.98,0:09:22.82,jp,,0,0,0,,はい　みんな席に着け
Dialogue: 0,0:09:23.39,0:09:26.66,jp,,0,0,0,,熱々の焼きたてチョコレートケーキ　食べるぞ
Dialogue: 0,0:09:28.86,0:09:30.42,jp,,0,0,0,,めっちゃうまくできたな
Dialogue: 0,0:09:30.42,0:09:32.02,jp,,0,0,0,,ですね
Dialogue: 0,0:09:37.24,0:09:38.55,jp,,0,0,0,,はーい
Dialogue: 0,0:09:41.20,0:09:41.86,jp,,0,0,0,,古見さん
Dialogue: 0,0:09:43.03,0:09:44.53,jp,,0,0,0,,どう　おいしい
Dialogue: 0,0:09:46.31,0:09:47.14,jp,,0,0,0,,やったね
Dialogue: 0,0:09:47.14,0:09:49.00,jp,,0,0,0,,甘ーい
Dialogue: 0,0:09:48.34,0:09:50.98,jpup,,0,0,0,,おいしいですね
Dialogue: 0,0:09:51.60,0:09:52.49,jp,,0,0,0,,何それ
Dialogue: 0,0:09:53.91,0:09:54.81,jp,,0,0,0,,お前も食え食え
Dialogue: 0,0:09:54.81,0:09:55.74,jp,,0,0,0,,ラッキー
Dialogue: 0,0:09:56.47,0:09:58.14,jp,,0,0,0,,よかったね　兄ちゃん
Dialogue: 0,0:10:02.31,0:10:03.95,jp,,0,0,0,,全部食べちゃったな
Dialogue: 0,0:10:04.29,0:10:05.09,jp,,0,0,0,,ごめん
Dialogue: 0,0:10:10.75,0:10:13.37,jp,,0,0,0,,それは人生と切っても切り離せぬもの
Dialogue: 0,0:10:14.37,0:10:16.38,jp,,0,0,0,,ふだんは淑女然とした女性も
Dialogue: 0,0:10:16.38,0:10:20.22,jp,,0,0,0,,この日ばかりは好意を持つ者に声をかけることが許される日
Dialogue: 0,0:10:20.98,0:10:22.25,jp,,0,0,0,,女子は色めきたち
Dialogue: 0,0:10:22.37,0:10:23.68,jp,,0,0,0,,男子はソワソワする
Dialogue: 0,0:10:24.41,0:10:25.39,jp,,0,0,0,,そう　今日は
Dialogue: 0,0:10:26.13,0:10:27.88,jp,,0,0,0,,バレンタインデーなのだ
Dialogue: 0,0:11:08.19,0:11:09.60,jp,,0,0,0,,おはようございます　古見さん
Dialogue: 0,0:11:20.62,0:11:21.94,jp,,0,0,0,,おっはろー
Dialogue: 0,0:11:21.94,0:11:24.16,jp,,0,0,0,,ハッピーバレンタイン
Dialogue: 0,0:11:24.16,0:11:25.64,jp,,0,0,0,,はい古見さん　友チョコ
Dialogue: 0,0:11:29.34,0:11:30.96,jp,,0,0,0,,古見さんの手作り
Dialogue: 0,0:11:30.96,0:11:32.71,jp,,0,0,0,,やったー　ありがとう
Dialogue: 0,0:11:34.01,0:11:37.82,jp,,0,0,0,,チロリチョコ１個　渡すだけで大きくなって返ってくる
Dialogue: 0,0:11:37.82,0:11:41.54,jp,,0,0,0,,いい日ですな　ヴァレンタインってのはよう
Dialogue: 0,0:11:43.18,0:11:45.20,jp,,0,0,0,,古見さん　おっはよう
Dialogue: 0,0:11:47.62,0:11:51.86,jp,,0,0,0,,私ね　古見さんのためにチョコ作ってきたんだ
Dialogue: 0,0:11:52.14,0:11:53.18,jp,,0,0,0,,受け取って
Dialogue: 0,0:11:55.10,0:11:58.74,jp,,0,0,0,,さあ　食べて　私の顔を
Dialogue: 0,0:11:59.10,0:12:01.99,jp,,0,0,0,,舐ってしゃぶって私を食べて
Dialogue: 0,0:12:01.99,0:12:06.50,jp,,0,0,0,,そして私は　一生古見さんの一部になるの
Dialogue: 0,0:12:27.98,0:12:28.79,jp,,0,0,0,,山井さん？
Dialogue: 0,0:12:28.89,0:12:30.10,jp,,0,0,0,,ちょっ　山井さん
Dialogue: 0,0:12:30.10,0:12:30.89,jp,,0,0,0,,大丈夫ですか
Dialogue: 0,0:12:30.89,0:12:33.18,jp,,0,0,0,,バレンタインなんぞで浮かれおって
Dialogue: 0,0:12:31.56,0:12:32.23,jpup,,0,0,0,,山井さん
Dialogue: 0,0:12:32.55,0:12:33.27,jpup,,0,0,0,,山井さん
Dialogue: 0,0:12:33.56,0:12:37.55,jp,,0,0,0,,企業が裏工作した行事などに乗っかって踊らされるなど
Dialogue: 0,0:12:34.11,0:12:35.35,jpup,,0,0,0,,ほ　保健室
Dialogue: 0,0:12:35.68,0:12:36.99,jpup,,0,0,0,,保健室
Dialogue: 0,0:12:37.55,0:12:38.80,jp,,0,0,0,,所詮　愚民
Dialogue: 0,0:12:39.14,0:12:41.23,jp,,0,0,0,,その点我はふだんどおりだ
Dialogue: 0,0:12:41.70,0:12:44.11,jp,,0,0,0,,見ろ　このいつもと変わりなさを
Dialogue: 0,0:12:44.46,0:12:47.04,jp,,0,0,0,,その普遍性に感服し　屈するが…
Dialogue: 0,0:12:51.65,0:12:53.79,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:12:56.06,0:12:57.46,jp,,0,0,0,,昨日ごめんな
Dialogue: 0,0:12:57.71,0:12:58.71,jp,,0,0,0,,これわびチョコ
Dialogue: 0,0:12:59.00,0:13:01.94,jp,,0,0,0,,君ら　本命チョコはどうすんの
Dialogue: 0,0:13:11.11,0:13:14.82,jp,,0,0,0,,なんか最近では男同士でチョコを交換する
Dialogue: 0,0:13:15.02,0:13:17.13,jp,,0,0,0,,強敵チョコっていうのがあるらしい
Dialogue: 0,0:13:20.24,0:13:22.18,jp,,0,0,0,,一応チョコ持ってきたけど
Dialogue: 0,0:13:22.62,0:13:24.80,jp,,0,0,0,,自分から行くのは恥ずかしいな
Dialogue: 0,0:13:25.01,0:13:27.90,jp,,0,0,0,,只野くんから来てくれないかな
Dialogue: 0,0:13:29.79,0:13:31.03,jp,,0,0,0,,地洗井　これ
Dialogue: 0,0:13:31.95,0:13:33.90,jp,,0,0,0,,言っとくけど　義理よ義理
Dialogue: 0,0:13:34.10,0:13:36.13,jp,,0,0,0,,ホワイトデーには３倍返しだから
Dialogue: 0,0:13:36.79,0:13:37.53,jp,,0,0,0,,サンキュー
Dialogue: 0,0:13:37.53,0:13:39.88,jp,,0,0,0,,もっと喜びなさいよ
Dialogue: 0,0:13:40.90,0:13:41.60,jp,,0,0,0,,動くな
Dialogue: 0,0:13:42.65,0:13:44.71,jp,,0,0,0,,背中に当たっているのは本物だ
Dialogue: 0,0:13:45.20,0:13:46.50,jp,,0,0,0,,や　やめろ
Dialogue: 0,0:13:56.62,0:13:57.42,jp,,0,0,0,,本物だ
Dialogue: 0,0:13:59.26,0:14:00.68,jp,,0,0,0,,バレンタインデー？
Dialogue: 0,0:14:01.11,0:14:02.15,jp,,0,0,0,,ってなんだべ
Dialogue: 0,0:14:02.27,0:14:04.76,jp,,0,0,0,,いやっ　別に欲しいとか言ってるわけじゃなくて
Dialogue: 0,0:14:03.52,0:14:05.95,jpup,,0,0,0,,チョコを好きな人に
Dialogue: 0,0:14:08.45,0:14:11.32,jp,,0,0,0,,かりんとがあったべ　食うか
Dialogue: 0,0:14:16.20,0:14:17.36,jp,,0,0,0,,妄想である
Dialogue: 0,0:14:18.05,0:14:19.60,jp,,0,0,0,,かーたいくん
Dialogue: 0,0:14:20.53,0:14:23.14,jp,,0,0,0,,佐々木　お前死ぬ気か
Dialogue: 0,0:14:23.54,0:14:25.29,jp,,0,0,0,,ほら　行きなよー
Dialogue: 0,0:14:25.29,0:14:26.51,jp,,0,0,0,,イ　イヤよ
Dialogue: 0,0:14:26.68,0:14:28.26,jp,,0,0,0,,こんなみんな見てる前で
Dialogue: 0,0:14:28.78,0:14:30.56,jp,,0,0,0,,でももう呼んじゃったし
Dialogue: 0,0:14:32.42,0:14:34.21,jp,,0,0,0,,あの　これ
Dialogue: 0,0:14:34.21,0:14:36.90,jp,,0,0,0,,別にお返しとかはいいので
Dialogue: 0,0:14:37.86,0:14:39.57,jp,,0,0,0,,な　何ーっ
Dialogue: 0,0:14:41.87,0:14:42.28,jp,,0,0,0,,おう
Dialogue: 0,0:14:42.40,0:14:45.21,jp,,0,0,0,,チョコもらっておいてこの塩対応？
Dialogue: 0,0:14:46.08,0:14:48.55,jp,,0,0,0,,この包みなんだろ　怖い
Dialogue: 0,0:14:50.96,0:14:53.33,jp,,0,0,0,,師匠がチョコを　なぜ
Dialogue: 0,0:14:55.28,0:14:57.06,jp,,0,0,0,,一体どんな意味が
Dialogue: 0,0:14:58.86,0:14:59.48,jp,,0,0,0,,そうか
Dialogue: 0,0:14:59.63,0:15:01.08,jp,,0,0,0,,やっぱり待つんじゃなくて
Dialogue: 0,0:15:01.08,0:15:02.71,jp,,0,0,0,,積極的に行った方がいいんだ
Dialogue: 0,0:15:02.71,0:15:04.46,jp,,0,0,0,,そうですよね　師匠
Dialogue: 0,0:15:04.61,0:15:05.53,jp,,0,0,0,,頑張りなさい
Dialogue: 0,0:15:15.01,0:15:17.73,jp,,0,0,0,,チョコ　友達みんなに渡してるんですか
Dialogue: 0,0:15:19.83,0:15:20.69,jp,,0,0,0,,なるほど
Dialogue: 0,0:15:33.80,0:15:35.87,jp,,0,0,0,,と　友強敵チョコ
Dialogue: 0,0:15:38.66,0:15:39.98,jp,,0,0,0,,ありがとう　片居くん
Dialogue: 0,0:15:40.70,0:15:43.00,jp,,0,0,0,,でも　今お返しできるものがないや
Dialogue: 0,0:15:43.20,0:15:45.09,jp,,0,0,0,,ホワイトデーに何かお返しするね
Dialogue: 0,0:15:45.28,0:15:48.87,jp,,0,0,0,,ホワッ　それってまるで本命チョコ
Dialogue: 0,0:16:04.16,0:16:07.04,jp,,0,0,0,,その日　只野くんはタカをくくっていた
Dialogue: 0,0:16:15.58,0:16:15.94,jp,,0,0,0,,と
Dialogue: 0,0:16:16.30,0:16:19.55,jp,,0,0,0,,ふだん調子に乗らないように気をつけている只野くんですら
Dialogue: 0,0:16:19.55,0:16:20.62,jp,,0,0,0,,このザマである
Dialogue: 0,0:16:23.84,0:16:25.17,jp,,0,0,0,,しかし現実は
Dialogue: 0,0:16:30.11,0:16:32.21,jp,,0,0,0,,０個　チョコ０個である
Dialogue: 0,0:16:32.54,0:16:35.75,jp,,0,0,0,,男子からのチョコは今回の集計には含まれていない
Dialogue: 0,0:16:35.75,0:16:38.07,jp,,0,0,0,,片居くんには悪いがそういうものである
Dialogue: 0,0:16:38.27,0:16:39.23,jp,,0,0,0,,古見さんをはじめ
Dialogue: 0,0:16:39.23,0:16:40.69,jp,,0,0,0,,尾根峰さんや尾鶏さん
Dialogue: 0,0:16:40.69,0:16:43.50,jp,,0,0,0,,親交のある女性の友人からももらえなかった
Dialogue: 0,0:16:43.50,0:16:44.34,jp,,0,0,0,,人気なし
Dialogue: 0,0:16:44.34,0:16:46.29,jp,,0,0,0,,只野くん　人気なし
Dialogue: 0,0:16:47.43,0:16:48.82,jp,,0,0,0,,おかえり　お兄ちゃん
Dialogue: 0,0:16:48.96,0:16:50.09,jp,,0,0,0,,チョコもらえた
Dialogue: 0,0:16:50.64,0:16:51.28,jp,,0,0,0,,お兄ちゃん？
Dialogue: 0,0:16:53.11,0:16:57.73,jp,,0,0,0,,この事実は只野くんの膝を折るには十分な精神的ストレッサーだった
Dialogue: 0,0:16:57.73,0:16:59.59,jp,,0,0,0,,お兄ちゃん　そんなキャラだっけ
Dialogue: 0,0:16:59.75,0:17:01.53,jp,,0,0,0,,仁ちゃん　何やってんの
Dialogue: 0,0:17:02.30,0:17:03.00,jp,,0,0,0,,これチョコね
Dialogue: 0,0:17:11.79,0:17:14.05,jp,,0,0,0,,ねえー　元気出しなって
Dialogue: 0,0:17:14.05,0:17:16.73,jp,,0,0,0,,私もお母さんもチョコあげたんだしさ
Dialogue: 0,0:17:16.73,0:17:18.94,jp,,0,0,0,,友達からもチョコもらえたんでしょ
Dialogue: 0,0:17:21.78,0:17:22.98,jp,,0,0,0,,男の
Dialogue: 0,0:17:25.98,0:17:29.35,jp,,0,0,0,,お兄ちゃん　男の子からチョコもらったんだって
Dialogue: 0,0:17:30.49,0:17:33.30,jp,,0,0,0,,よく分からないけど　優しい子なのね
Dialogue: 0,0:17:38.31,0:17:40.42,jp,,0,0,0,,お兄ちゃん　アイス買ってきて
Dialogue: 0,0:17:41.74,0:17:43.34,jp,,0,0,0,,やだよ　めんどくさい
Dialogue: 0,0:17:43.48,0:17:45.26,jp,,0,0,0,,てか　こんな寒いのにアイス
Dialogue: 0,0:17:45.26,0:17:46.10,jp,,0,0,0,,いいから
Dialogue: 0,0:17:46.42,0:17:49.14,jp,,0,0,0,,あとアイスは冬が本番になりつつあるの
Dialogue: 0,0:17:49.29,0:17:52.12,jp,,0,0,0,,部屋の中が暖かいからアイスが食べたくなるってことね
Dialogue: 0,0:17:52.29,0:17:54.75,jp,,0,0,0,,実際に売り上げの数字も年々増加してるし
Dialogue: 0,0:17:54.92,0:17:56.76,jp,,550,0,0,,冬アイスはもはや定番化してるわ
Dialogue: 0,0:17:55.54,0:17:56.58,jp,,0,600,0,,なんなの
Dialogue: 0,0:18:03.04,0:18:04.28,jp,,0,0,0,,さっむ
Dialogue: 0,0:18:13.64,0:18:14.53,jp,,0,0,0,,古見さん？
Dialogue: 0,0:18:15.07,0:18:17.24,jp,,0,0,0,,ついでにダシも買ってきて仁ちゃん
Dialogue: 0,0:18:17.75,0:18:19.04,jp,,0,0,0,,ダシネ　分かった
Dialogue: 0,0:18:19.29,0:18:21.75,jp,,0,0,0,,とりあえず公園へ
Dialogue: 0,0:18:30.69,0:18:33.14,jp,,0,0,0,,さっきぶつけた所　大丈夫ですか
Dialogue: 0,0:18:36.25,0:18:38.43,jp,,0,0,0,,それならよかった　すみません
Dialogue: 0,0:18:39.57,0:18:42.65,jp,,0,0,0,,それでその　ど…どうしたんですか
Dialogue: 0,0:18:42.87,0:18:44.69,jp,,0,0,0,,その　今日は…
Dialogue: 0,0:18:46.00,0:18:48.44,jp,,0,0,0,,チョコか　チョコなのか
Dialogue: 0,0:18:56.01,0:18:57.82,jp,,0,0,0,,えっと　これは
Dialogue: 0,0:18:58.48,0:19:04.60,jp,,0,0,0,,今日　委員長会議があって　なじみちゃんが　「只野くん来てないかったから渡しおいて」と
Dialogue: 0,0:19:05.04,0:19:06.00,jp,,0,0,0,,あ　しまっ
Dialogue: 0,0:19:06.27,0:19:07.86,jp,,0,0,0,,すみません　わざわざ
Dialogue: 0,0:19:10.61,0:19:11.36,jp,,0,0,0,,帰るんですか
Dialogue: 0,0:19:12.39,0:19:13.41,jp,,0,0,0,,お気をつけて
Dialogue: 0,0:19:27.61,0:19:29.41,jp,,0,0,0,,何期待してんだ僕は
Dialogue: 0,0:19:30.02,0:19:32.23,jp,,0,0,0,,別にもらえなくても普通じゃないか
Dialogue: 0,0:19:35.98,0:19:39.02,jp,,0,0,0,,あげるかあげないかは古見さんが決めることだし
Dialogue: 0,0:19:39.56,0:19:42.13,jp,,0,0,0,,うん　僕が期待しすぎただけだ
Dialogue: 0,0:19:43.40,0:19:44.80,jp,,0,0,0,,何してんだ　僕は
Dialogue: 0,0:19:48.27,0:19:48.84,jp,,0,0,0,,でも
Dialogue: 0,0:19:55.70,0:19:59.30,jp,,0,0,0,,古見さんに嫌われてなかったらいいな
Dialogue: 0,0:20:15.20,0:20:15.61,jp,,0,0,0,,た
Dialogue: 0,0:20:16.15,0:20:17.08,jp,,0,0,0,,只野くん
Dialogue: 0,0:20:24.30,0:20:24.89,jp,,0,0,0,,はい
Dialogue: 0,0:20:32.47,0:20:32.97,jp,,0,0,0,,はい
Dialogue: 0,0:20:49.90,0:20:51.16,jp,,0,0,0,,こ　これ
Dialogue: 0,0:20:57.36,0:20:59.88,jp,,0,0,0,,と　友達チョコ　です
Dialogue: 0,0:21:00.73,0:21:03.78,jp,,0,0,0,,ああはい　もちろんね
Dialogue: 0,0:21:04.13,0:21:04.74,jp,,0,0,0,,ですね
Dialogue: 0,0:21:15.33,0:21:18.37,jp,,0,0,0,,その　恥ずかしい話なんですが
Dialogue: 0,0:21:18.90,0:21:23.29,jp,,0,0,0,,今日ずっと　チョコもらえないのかなって考えてたんです
Dialogue: 0,0:21:23.89,0:21:27.35,jp,,0,0,0,,古見さん　友達全員にチョコ渡してるみたいでしたし
Dialogue: 0,0:21:27.71,0:21:32.12,jp,,0,0,0,,その　でももらえなくて　１回諦めて
Dialogue: 0,0:21:33.71,0:21:34.63,jp,,0,0,0,,えっと
Dialogue: 0,0:21:35.37,0:21:37.14,jp,,0,0,0,,僕何が言いたいんでしょう
Dialogue: 0,0:21:38.97,0:21:39.68,jp,,0,0,0,,とにかく
Dialogue: 0,0:21:40.55,0:21:42.48,jp,,0,0,0,,古見さんからチョコがもらえて
Dialogue: 0,0:21:43.07,0:21:46.39,jp,,0,0,0,,その　想像してたよりも 何倍も
Dialogue: 0,0:21:50.30,0:21:51.29,jp,,0,0,0,,うれしかったです
Dialogue: 0,0:21:59.39,0:22:02.55,jp,,0,0,0,,その　チョコレート
Dialogue: 0,0:22:03.26,0:22:05.91,jp,,0,0,0,,い　一番うまく
Dialogue: 0,0:22:06.04,0:22:09.63,jp,,0,0,0,,で…できた…も…もの　です
Dialogue: 0,0:22:10.28,0:22:13.33,jp,,0,0,0,,そんなわざわざ　ありがとうございます
Dialogue: 0,0:22:19.87,0:22:21.03,jp,,0,0,0,,古見さん？
Dialogue: 0,0:22:21.99,0:22:23.34,jp,,0,0,0,,急に　古見さん
Dialogue: 0,0:22:23.95,0:22:26.57,jp,,0,0,0,,も…もう暗いですし　送っていきますよ
Dialogue: 0,0:22:26.81,0:22:28.10,jp,,0,0,0,,古見さーん
Comment: 0,0:00:00.00,0:00:00.00,ch,,0,0,0,,-----------Dialogue-Chinese----------
Dialogue: 1,0:00:10.48,0:00:13.76,ch,,0,0,0,,举例来说 在特殊情况下有了交情的人
Dialogue: 1,0:00:13.92,0:00:16.46,ch,,0,0,0,,隔了个假期见面再打招呼时
Dialogue: 1,0:00:17.10,0:00:18.90,ch,,0,0,0,,要是我兴奋地打招呼
Dialogue: 1,0:00:19.06,0:00:22.93,ch,,0,0,0,,结果人家「啊 嗯」这样敷衍了事的话该怎么办
Dialogue: 1,0:00:23.22,0:00:25.52,ch,,0,0,0,,但直接回避也很不自然
Dialogue: 1,0:00:26.54,0:00:28.38,ch,,0,0,0,,刚刚明明对上了视线却又无视了
Dialogue: 1,0:00:29.11,0:00:30.24,ch,,0,0,0,,如上
Dialogue: 1,0:00:31.23,0:00:34.09,ch,,0,0,0,,不知道该怎样打招呼才好
Dialogue: 1,0:00:34.22,0:00:35.41,ch,,0,0,0,,所述
Dialogue: 1,0:00:38.45,0:00:39.42,ch,,0,0,0,,上理
Dialogue: 1,0:00:39.42,0:00:39.98,ch,,0,0,0,,泥嚎
Dialogue: 1,0:00:41.65,0:00:45.91,ch,,0,0,0,,那个 修学旅行的时候聊到的小说
Dialogue: 1,0:00:48.04,0:00:50.29,ch,,0,0,0,,你特意帮我带过来了啊
Dialogue: 1,0:00:50.49,0:00:51.86,ch,,0,0,0,,谢谢你
Dialogue: 1,0:00:54.87,0:00:57.08,ch,,0,0,0,,唔呣 好好感谢我吧
Dialogue: 1,0:00:59.06,0:01:02.31,ch,,0,0,0,,暗黑菊一文字（笑）拿回来了吗
Dialogue: 1,0:01:02.31,0:01:04.04,ch,,0,0,0,,（笑）是多余的
Dialogue: 1,0:01:04.45,0:01:06.38,ch,,0,0,0,,你能一个人打电话了吗
Dialogue: 1,0:01:06.38,0:01:08.38,ch,,0,0,0,,这么点小事当然可以
Dialogue: 1,0:01:10.28,0:01:12.02,ch,,0,0,0,,厉害呀 井中
Dialogue: 1,0:01:12.39,0:01:13.89,ch,,0,0,0,,这是你做的吗
Dialogue: 1,0:01:13.89,0:01:16.00,ch,,0,0,0,,好可爱啊
Dialogue: 1,0:01:16.16,0:01:18.14,ch,,0,0,0,,不嫌弃吗
Dialogue: 1,0:01:18.85,0:01:19.60,ch,,0,0,0,,为什么
Dialogue: 1,0:01:19.84,0:01:21.18,ch,,0,0,0,,我超开心啊
Dialogue: 1,0:01:21.18,0:01:23.62,ch,,0,0,0,,谢谢你
Dialogue: 1,0:01:21.46,0:01:22.80,chup,,0,0,0,,喂 他来了
Dialogue: 1,0:01:28.54,0:01:31.70,ch,,0,0,0,,今 今天一定要和大家说「早上好」
Dialogue: 1,0:01:32.29,0:01:33.50,ch,,0,0,0,,早上好 片居
Dialogue: 1,0:01:35.18,0:01:36.91,ch,,0,0,0,,只野好温柔
Dialogue: 1,0:01:37.26,0:01:39.10,ch,,0,0,0,,片居哥 您早上好
Dialogue: 1,0:01:40.69,0:01:41.35,ch,,0,0,0,,片居
Dialogue: 1,0:01:42.21,0:01:45.56,ch,,0,0,0,,上次看过你的身材 我觉得相当不错
Dialogue: 1,0:01:47.28,0:01:48.90,ch,,0,0,0,,对了 我把照片发你吧
Dialogue: 1,0:01:49.09,0:01:51.79,ch,,0,0,0,,当时留下的「艺术」 你也应当拥有一份
Dialogue: 1,0:01:52.96,0:01:54.57,ch,,0,0,0,,那等会见
Dialogue: 1,0:01:54.83,0:01:56.11,ch,,0,0,0,,嗯 等会见
Dialogue: 1,0:02:12.18,0:02:13.29,ch,,0,0,0,,无法行动
Dialogue: 1,0:02:35.90,0:02:36.62,ch,,0,0,0,,古见同学？
Dialogue: 1,0:02:39.24,0:02:41.06,ch,,0,0,0,,那个 早安
Dialogue: 1,0:02:48.10,0:02:51.54,ch,,0,0,0,,还是觉得挺有意思的呢 用笔记本对话
Dialogue: 1,0:02:52.72,0:02:54.16,ch,,0,0,0,,早安 古见同学
Dialogue: 1,0:02:55.08,0:02:56.78,ch,,0,0,0,,莫名戳中笑点了
Dialogue: 1,0:02:58.15,0:02:59.01,ch,,0,0,0,,我离开一下
Dialogue: 1,0:02:59.01,0:02:59.96,ch,,0,0,0,,好
Dialogue: 1,0:03:04.71,0:03:05.46,ch,,0,0,0,,早安
Dialogue: 1,0:03:06.79,0:03:08.06,ch,,0,0,0,,另一边 此时
Dialogue: 1,0:04:42.78,0:04:44.91,ch,,600,0,0,,说起来 古见同学
Dialogue: 1,0:04:45.14,0:04:46.38,ch,,0,0,0,,情人节你什么打算
Dialogue: 1,0:04:53.54,0:04:55.15,ch,,0,0,0,,停顿了好一会
Dialogue: 1,0:04:56.02,0:04:58.82,ch,,0,0,0,,要不这样 今天来我家一起做吧
Dialogue: 1,0:04:59.10,0:05:02.03,ch,,0,0,0,,我每年都会给家人准备礼物
Dialogue: 1,0:05:02.03,0:05:06.06,ch,,0,0,0,,不过机会难得 肯定是和朋友一起做更开心啊
Dialogue: 1,0:05:07.07,0:05:08.78,ch,,0,0,0,,好 那就这么定了
Dialogue: 1,0:05:08.92,0:05:10.50,ch,,0,0,0,,我也
Dialogue: 1,0:05:10.50,0:05:13.00,ch,,0,0,0,,可以去吗
Dialogue: 1,0:05:13.00,0:05:14.35,ch,,0,0,0,,噢 来吧来吧
Dialogue: 1,0:05:16.18,0:05:17.54,ch,,0,0,0,,不好意思 只野
Dialogue: 1,0:05:17.74,0:05:19.20,ch,,0,0,0,,今天是女生聚会
Dialogue: 1,0:05:19.65,0:05:22.13,ch,,0,0,0,,我也没想着要去哦
Dialogue: 1,0:05:27.77,0:05:29.10,ch,,0,0,0,,好 到了
Dialogue: 1,0:05:29.97,0:05:31.04,ch,,0,0,0,,我回来了
Dialogue: 1,0:05:32.02,0:05:34.81,ch,,0,0,0,,这帮小鬼 脱了鞋又乱扔
Dialogue: 1,0:05:36.02,0:05:37.68,ch,,0,0,0,,姐姐 欢迎回来
Dialogue: 1,0:05:37.80,0:05:40.14,ch,,0,0,0,,枫姐姐也来啦
Dialogue: 1,0:05:40.14,0:05:43.10,ch,,0,700,0,,打扰了
Dialogue: 1,0:05:41.69,0:05:44.25,ch,,350,0,0,,我们今天玩什么…
Dialogue: 1,0:06:02.41,0:06:03.90,ch,,0,0,0,,都是我弟弟妹妹
Dialogue: 1,0:06:04.24,0:06:07.59,ch,,0,0,0,,他们4个可能会很吵 希望你多多包涵
Dialogue: 1,0:06:09.27,0:06:11.48,ch,,0,0,0,,那我们开始做吧
Dialogue: 1,0:06:13.94,0:06:16.90,ch,,0,0,0,,古见同学把巧克力和黄油隔水加热一下
Dialogue: 1,0:06:17.14,0:06:19.69,ch,,0,0,0,,枫把面粉跟可可粉混在一起拌匀
Dialogue: 1,0:06:32.03,0:06:35.54,ch,,0,0,0,,哪里 这没啥了不起的
Dialogue: 1,0:06:36.04,0:06:38.90,ch,,0,0,0,,把这个也隔水加热 再往里放糖
Dialogue: 1,0:06:39.15,0:06:41.05,ch,,0,0,0,,再倒入鲜奶油和白兰地
Dialogue: 1,0:06:41.49,0:06:43.67,ch,,0,0,0,,也别忘了把处理好的巧克力倒进去
Dialogue: 1,0:06:44.04,0:06:46.42,ch,,0,0,0,,好 开始做蛋白酥吧
Dialogue: 1,0:06:49.98,0:06:55.06,ch,,0,0,0,,变好吃吧 变好吃吧
Dialogue: 1,0:06:55.06,0:06:58.00,ch,,0,0,0,,你这样一周都做不完
Dialogue: 1,0:06:59.29,0:07:00.76,ch,,0,0,0,,我们也要帮忙
Dialogue: 1,0:07:00.76,0:07:01.78,ch,,0,0,0,,帮忙
Dialogue: 1,0:07:02.02,0:07:04.14,ch,,0,0,0,,行 那你们先去洗个手再来
Dialogue: 1,0:07:13.58,0:07:15.67,ch,,0,0,0,,古见同学去那边帮帮他们吧
Dialogue: 1,0:07:15.96,0:07:17.32,ch,,0,0,0,,这边有我就行
Dialogue: 1,0:07:17.32,0:07:19.37,ch,,0,0,0,,姐姐我手酸了
Dialogue: 1,0:07:19.37,0:07:21.97,ch,,0,0,0,,还没有发泡吧 再加把劲
Dialogue: 1,0:07:34.07,0:07:35.76,ch,,0,600,0,,好厉害
Dialogue: 1,0:07:35.12,0:07:37.02,ch,,600,0,0,,可怕姐姐好强
Dialogue: 1,0:07:38.84,0:07:40.19,ch,,0,0,0,,加油
Dialogue: 1,0:07:40.73,0:07:42.44,chup,,0,0,0,,加油
Dialogue: 1,0:07:40.73,0:07:42.44,ch,,0,0,0,,轮到我啦
Dialogue: 1,0:07:42.86,0:07:44.69,ch,,0,0,0,,加油
Dialogue: 1,0:07:47.04,0:07:47.83,ch,,0,0,0,,完美
Dialogue: 1,0:07:50.43,0:07:51.72,ch,,0,0,0,,然后
Dialogue: 1,0:07:51.95,0:07:54.31,ch,,0,0,0,,往盆里稍微加一点蛋白酥搅拌
Dialogue: 1,0:07:54.42,0:07:57.23,ch,,0,0,0,,还有混入刚拌好的面粉和可可粉
Dialogue: 1,0:07:57.46,0:08:00.46,ch,,0,0,0,,然后分三次加入剩下的蛋白酥
Dialogue: 1,0:08:01.67,0:08:02.96,ch,,0,0,0,,好了
Dialogue: 1,0:08:03.16,0:08:05.75,ch,,0,0,0,,把这个烤上50分钟
Dialogue: 1,0:08:06.82,0:08:09.22,ch,,0,0,0,,趁这50分钟和姐姐们玩吧
Dialogue: 1,0:08:13.66,0:08:16.18,ch,,0,0,0,,很久很久以前
Dialogue: 1,0:08:16.77,0:08:18.90,chup,,0,0,0,,在某个地方
Dialogue: 1,0:08:19.44,0:08:24.82,chup,,0,0,0,,有一对老夫妇
Dialogue: 1,0:08:18.28,0:08:20.10,ch,,0,0,0,,可怕姐姐
Dialogue: 1,0:08:20.48,0:08:21.88,ch,,0,0,0,,你为什么不说话
Dialogue: 1,0:08:23.36,0:08:25.52,ch,,0,0,0,,我也一直想问
Dialogue: 1,0:08:26.24,0:08:30.48,ch,,0,0,0,,那个姐姐比较内向 你们别太欺负她
Dialogue: 1,0:08:30.61,0:08:31.74,ch,,0,0,0,,内昂？
Dialogue: 1,0:08:31.74,0:08:32.74,ch,,0,0,0,,向
Dialogue: 1,0:08:32.85,0:08:35.03,ch,,0,0,0,,来姐姐 啊一声
Dialogue: 1,0:08:35.03,0:08:36.06,ch,,0,0,0,,啊
Dialogue: 1,0:08:36.45,0:08:37.30,ch,,0,0,0,,啊
Dialogue: 1,0:08:38.14,0:08:40.40,ch,,0,0,0,,啊一个 啊一个
Dialogue: 1,0:08:42.34,0:08:43.43,ch,,0,0,0,,啊
Dialogue: 1,0:08:47.34,0:08:48.59,ch,,0,0,0,,蛋糕应该膨起来了
Dialogue: 1,0:08:48.67,0:08:50.50,ch,,0,0,0,,我们去看看吧 内昂姐姐
Dialogue: 1,0:08:53.35,0:08:55.26,ch,,0,0,0,,胀起来了胀起来了
Dialogue: 1,0:08:56.40,0:08:57.82,ch,,0,0,0,,好厉害
Dialogue: 1,0:08:57.82,0:08:58.94,ch,,0,0,0,,是呀
Dialogue: 1,0:08:59.30,0:09:00.98,ch,,0,0,0,,内昂姐姐
Dialogue: 1,0:09:02.10,0:09:05.74,ch,,0,0,0,,声音这么好听 多说说话吧
Dialogue: 1,0:09:06.10,0:09:07.07,ch,,0,0,0,,没错没错
Dialogue: 1,0:09:10.91,0:09:14.81,ch,,0,0,0,,我 努力
Dialogue: 1,0:09:20.98,0:09:22.82,ch,,0,0,0,,大家坐好
Dialogue: 1,0:09:23.39,0:09:26.66,ch,,0,0,0,,尝尝新鲜出炉的巧克力蛋糕
Dialogue: 1,0:09:28.86,0:09:30.42,ch,,0,0,0,,看起来好好吃
Dialogue: 1,0:09:30.42,0:09:32.02,ch,,0,0,0,,是啊
Dialogue: 1,0:09:37.24,0:09:38.55,ch,,0,0,0,,来
Dialogue: 1,0:09:41.20,0:09:41.86,ch,,0,0,0,,古见同学
Dialogue: 1,0:09:43.03,0:09:44.53,ch,,0,0,0,,怎么样 好吃吗
Dialogue: 1,0:09:46.31,0:09:47.14,ch,,0,0,0,,太好了
Dialogue: 1,0:09:47.14,0:09:49.00,ch,,0,0,0,,好甜
Dialogue: 1,0:09:48.34,0:09:50.98,chup,,0,0,0,,真好吃啊
Dialogue: 1,0:09:51.60,0:09:52.49,ch,,0,0,0,,那是什么
Dialogue: 1,0:09:53.91,0:09:54.81,ch,,0,0,0,,你也来吃点吧
Dialogue: 1,0:09:54.81,0:09:55.74,ch,,0,0,0,,真走运
Dialogue: 1,0:09:56.47,0:09:58.14,ch,,0,0,0,,太好了呢 哥哥
Dialogue: 1,0:10:02.31,0:10:03.95,ch,,0,0,0,,全都吃完了啊
Dialogue: 1,0:10:04.29,0:10:05.09,ch,,0,0,0,,抱歉
Dialogue: 1,0:10:10.75,0:10:13.37,ch,,0,0,0,,总是与人生不可分割
Dialogue: 1,0:10:14.37,0:10:16.38,ch,,0,0,0,,女孩们平日里再怎么矜持
Dialogue: 1,0:10:16.38,0:10:20.22,ch,,0,0,0,,都有机会在这个日子里同意中人自然地说上两句话
Dialogue: 1,0:10:20.98,0:10:22.25,ch,,0,0,0,,女生面露紧张
Dialogue: 1,0:10:22.37,0:10:23.68,ch,,0,0,0,,男生坐立不安
Dialogue: 1,0:10:24.41,0:10:25.39,ch,,0,0,0,,没错 今天就是
Dialogue: 1,0:10:26.13,0:10:27.88,ch,,0,0,0,,情人节
Dialogue: 1,0:11:08.19,0:11:09.60,ch,,0,0,0,,早上好 古见同学
Dialogue: 1,0:11:20.62,0:11:21.94,ch,,0,0,0,,早哈喽
Dialogue: 1,0:11:21.94,0:11:24.16,ch,,0,0,0,,情人节快乐
Dialogue: 1,0:11:24.16,0:11:25.64,ch,,0,0,0,,古见同学 给你友情巧克力
Dialogue: 1,0:11:29.34,0:11:30.96,ch,,0,0,0,,古见同学自己做的吗
Dialogue: 1,0:11:30.96,0:11:32.71,ch,,0,0,0,,太好了 谢谢你
Dialogue: 1,0:11:34.01,0:11:37.82,ch,,0,0,0,,只是送了一小块友情巧克力就能换回一大份回礼
Dialogue: 1,0:11:37.82,0:11:41.54,ch,,0,0,0,,情人节可真是个好日子
Dialogue: 1,0:11:43.18,0:11:45.20,ch,,0,0,0,,早啊古见同学
Dialogue: 1,0:11:47.62,0:11:51.86,ch,,0,0,0,,我专门为古见同学做了巧克力哦
Dialogue: 1,0:11:52.14,0:11:53.18,ch,,0,0,0,,收下吧
Dialogue: 1,0:11:55.10,0:11:58.74,ch,,0,0,0,,来吧 吃我的脸吧
Dialogue: 1,0:11:59.10,0:12:01.99,ch,,0,0,0,,舔我含着我吃了我吧
Dialogue: 1,0:12:01.99,0:12:06.50,ch,,0,0,0,,然后我就能永远存在于古见同学体内了
Dialogue: 1,0:12:27.98,0:12:28.79,ch,,0,0,0,,山井同学？
Dialogue: 1,0:12:28.89,0:12:30.10,ch,,0,0,0,,喂 山井同学
Dialogue: 1,0:12:30.10,0:12:30.89,ch,,0,0,0,,你没事吧
Dialogue: 1,0:12:30.89,0:12:33.18,ch,,0,0,0,,区区一个情人节就让你们忘乎所以
Dialogue: 1,0:12:31.56,0:12:32.23,chup,,0,0,0,,山井同学
Dialogue: 1,0:12:32.55,0:12:33.27,chup,,0,0,0,,山井同学
Dialogue: 1,0:12:33.56,0:12:37.55,ch,,0,0,0,,不过是企业用来赚钱的手段而已 一群小丑
Dialogue: 1,0:12:34.11,0:12:35.35,chup,,0,0,0,,保 保健室
Dialogue: 1,0:12:35.68,0:12:36.99,chup,,0,0,0,,保健室
Dialogue: 1,0:12:37.55,0:12:38.80,ch,,0,0,0,,愚民罢了
Dialogue: 1,0:12:39.14,0:12:41.23,ch,,0,0,0,,此刻我无动于衷
Dialogue: 1,0:12:41.70,0:12:44.11,ch,,0,0,0,,看吧 我与往常并无不同
Dialogue: 1,0:12:44.46,0:12:47.04,ch,,0,0,0,,赞叹我的一视同仁 屈服于我…
Dialogue: 1,0:12:51.65,0:12:53.79,ch,,0,0,0,,谢谢你
Dialogue: 1,0:12:56.06,0:12:57.46,ch,,0,0,0,,昨天抱歉啦
Dialogue: 1,0:12:57.71,0:12:58.71,ch,,0,0,0,,这包巧克力当赔礼
Dialogue: 1,0:12:59.00,0:13:01.94,ch,,0,0,0,,你们的本命巧克力要送给谁呢
Dialogue: 1,0:13:11.11,0:13:14.82,ch,,0,0,0,,最近男性之间也会互送巧克力
Dialogue: 1,0:13:15.02,0:13:17.13,ch,,0,0,0,,好像叫做亦敌亦友巧克力
Dialogue: 1,0:13:20.24,0:13:22.18,ch,,0,0,0,,虽然巧克力是带过来了
Dialogue: 1,0:13:22.62,0:13:24.80,ch,,0,0,0,,不过主动送还是有些害羞啊
Dialogue: 1,0:13:25.01,0:13:27.90,ch,,0,0,0,,只野会主动送我吗
Dialogue: 1,0:13:29.79,0:13:31.03,ch,,0,0,0,,地洗井 给你
Dialogue: 1,0:13:31.95,0:13:33.90,ch,,0,0,0,,提醒你 这只是义理巧克力
Dialogue: 1,0:13:34.10,0:13:36.13,ch,,0,0,0,,白色情人节要三倍奉还
Dialogue: 1,0:13:36.79,0:13:37.53,ch,,0,0,0,,谢啦
Dialogue: 1,0:13:37.53,0:13:39.88,ch,,0,0,0,,再表现得高兴一点啊
Dialogue: 1,0:13:40.90,0:13:41.60,ch,,0,0,0,,不准动
Dialogue: 1,0:13:42.65,0:13:44.71,ch,,0,0,0,,抵着你背后的是真家伙
Dialogue: 1,0:13:45.20,0:13:46.50,ch,,0,0,0,,别 别这样
Dialogue: 1,0:13:56.62,0:13:57.42,ch,,0,0,0,,是真家伙
Dialogue: 1,0:13:59.26,0:14:00.68,ch,,0,0,0,,情人节？
Dialogue: 1,0:14:01.11,0:14:02.15,ch,,0,0,0,,是啥嘞
Dialogue: 1,0:14:02.27,0:14:04.76,ch,,0,0,0,,不 我也不是说我想要
Dialogue: 1,0:14:03.52,0:14:05.95,chup,,0,0,0,,给喜欢的人送巧克力
Dialogue: 1,0:14:08.45,0:14:11.32,ch,,0,0,0,,我这倒是有花林糖 吃吗
Dialogue: 1,0:14:16.20,0:14:17.36,ch,,0,0,0,,是妄想
Dialogue: 1,0:14:18.05,0:14:19.60,ch,,0,0,0,,片居
Dialogue: 1,0:14:20.53,0:14:23.14,ch,,0,0,0,,佐佐木 你找死吗
Dialogue: 1,0:14:23.54,0:14:25.29,ch,,0,0,0,,赶紧的 去吧
Dialogue: 1,0:14:25.29,0:14:26.51,ch,,0,0,0,,不 不要啦
Dialogue: 1,0:14:26.68,0:14:28.26,ch,,0,0,0,,当着这么多人的面
Dialogue: 1,0:14:28.78,0:14:30.56,ch,,0,0,0,,但我都叫了人家了
Dialogue: 1,0:14:32.42,0:14:34.21,ch,,0,0,0,,那个 给你
Dialogue: 1,0:14:34.21,0:14:36.90,ch,,0,0,0,,不必特意回礼了
Dialogue: 1,0:14:37.86,0:14:39.57,ch,,0,0,0,,什 什么
Dialogue: 1,0:14:41.87,0:14:42.28,ch,,0,0,0,,哦
Dialogue: 1,0:14:42.40,0:14:45.21,ch,,0,0,0,,都收到巧克力却这么冷淡？
Dialogue: 1,0:14:46.08,0:14:48.55,ch,,0,0,0,,这小盒子里装的什么 好吓人
Dialogue: 1,0:14:50.96,0:14:53.33,ch,,0,0,0,,师傅要给我巧克力 为什么
Dialogue: 1,0:14:55.28,0:14:57.06,ch,,0,0,0,,究竟是什么意思
Dialogue: 1,0:14:58.86,0:14:59.48,ch,,0,0,0,,我知道了
Dialogue: 1,0:14:59.63,0:15:01.08,ch,,0,0,0,,我不该守株待兔
Dialogue: 1,0:15:01.08,0:15:02.71,ch,,0,0,0,,而要积极行动
Dialogue: 1,0:15:02.71,0:15:04.46,ch,,0,0,0,,是这样吧 师父
Dialogue: 1,0:15:04.61,0:15:05.53,ch,,0,0,0,,加油吧
Dialogue: 1,0:15:15.01,0:15:17.73,ch,,0,0,0,,巧克力 给所有的朋友都送了吗
Dialogue: 1,0:15:19.83,0:15:20.69,ch,,0,0,0,,这样啊
Dialogue: 1,0:15:33.80,0:15:35.87,ch,,0,0,0,,亦敌亦友巧克力
Dialogue: 0,0:15:33.80,0:15:35.87,Comment,,0,0,0,,注：发音与友情巧克力相同
Dialogue: 1,0:15:38.66,0:15:39.98,ch,,0,0,0,,谢谢你 片居
Dialogue: 1,0:15:40.70,0:15:43.00,ch,,0,0,0,,不过我没办法马上回礼
Dialogue: 1,0:15:43.20,0:15:45.09,ch,,0,0,0,,白色情人节时再给你送点什么吧
Dialogue: 1,0:15:45.28,0:15:48.87,ch,,0,0,0,,白 那不就是本命巧克力吗
Dialogue: 1,0:16:04.16,0:16:07.04,ch,,0,0,0,,只野曾口出狂言 小瞧了这一天
Dialogue: 1,0:16:15.58,0:16:15.94,ch,,0,0,0,,结果
Dialogue: 1,0:16:16.30,0:16:19.55,ch,,0,0,0,,连平时一直克制自己不要太飘的只野
Dialogue: 1,0:16:19.55,0:16:20.62,ch,,0,0,0,,都成了这样
Dialogue: 1,0:16:23.84,0:16:25.17,ch,,0,0,0,,然而现实却
Dialogue: 1,0:16:30.11,0:16:32.21,ch,,0,0,0,,0个 巧克力0个
Dialogue: 1,0:16:32.54,0:16:35.75,ch,,0,0,0,,男生送的巧克力没有统计在内
Dialogue: 1,0:16:35.75,0:16:38.07,ch,,0,0,0,,虽然对不住片居 但不算数就是不算数
Dialogue: 1,0:16:38.27,0:16:39.23,ch,,0,0,0,,以古见同学为首
Dialogue: 1,0:16:39.23,0:16:40.69,ch,,0,0,0,,尾根峰同学 尾鸡同学
Dialogue: 1,0:16:40.69,0:16:43.50,ch,,0,0,0,,连关系不错的女生都没送
Dialogue: 1,0:16:43.50,0:16:44.34,ch,,0,0,0,,不受欢迎
Dialogue: 1,0:16:44.34,0:16:46.29,ch,,0,0,0,,只野 不受欢迎
Dialogue: 1,0:16:47.43,0:16:48.82,ch,,0,0,0,,欢迎回来 哥哥
Dialogue: 1,0:16:48.96,0:16:50.09,ch,,0,0,0,,收到巧克力了吗
Dialogue: 1,0:16:50.64,0:16:51.28,ch,,0,0,0,,哥哥？
Dialogue: 1,0:16:53.11,0:16:57.73,ch,,0,0,0,,这个事实给予的精神压力让只野站不起来
Dialogue: 1,0:16:57.73,0:16:59.59,ch,,0,0,0,,哥哥 你是那种角色来着吗
Dialogue: 1,0:16:59.75,0:17:01.53,ch,,0,0,0,,小仁 在干什么呢
Dialogue: 1,0:17:02.30,0:17:03.00,ch,,0,0,0,,这是给你的
Dialogue: 1,0:17:11.79,0:17:14.05,ch,,0,0,0,,打起精神来嘛
Dialogue: 1,0:17:14.05,0:17:16.73,ch,,0,0,0,,我和妈妈都给了你巧克力了呀
Dialogue: 1,0:17:16.73,0:17:18.94,ch,,0,0,0,,不也从朋友那里收到巧克力了吗
Dialogue: 1,0:17:21.78,0:17:22.98,ch,,0,0,0,,男生
Dialogue: 1,0:17:25.98,0:17:29.35,ch,,0,0,0,,哥哥说他收到男生送的巧克力了
Dialogue: 1,0:17:30.49,0:17:33.30,ch,,0,0,0,,虽然不知道是谁 但他一定是个好孩子吧
Dialogue: 1,0:17:38.31,0:17:40.42,ch,,0,0,0,,哥哥 去买点冰淇淋
Dialogue: 1,0:17:41.74,0:17:43.34,ch,,0,0,0,,才不要 太麻烦了
Dialogue: 1,0:17:43.48,0:17:45.26,ch,,0,0,0,,况且这么冷的天还吃冰淇淋
Dialogue: 1,0:17:45.26,0:17:46.10,ch,,0,0,0,,去就是了
Dialogue: 1,0:17:46.42,0:17:49.14,ch,,0,0,0,,而且冰淇淋越是冬天越好吃
Dialogue: 1,0:17:49.29,0:17:52.12,ch,,0,0,0,,室内很暖和所以才更想吃冰淇淋了
Dialogue: 1,0:17:52.29,0:17:54.75,ch,,0,0,0,,事实上冰激凌每年的销量都逐渐走高
Dialogue: 1,0:17:54.92,0:17:56.76,ch,,550,0,0,,冬季吃冰淇淋已经快成为一种习俗了
Dialogue: 1,0:17:55.54,0:17:56.58,ch,,0,600,0,,你在说啥
Dialogue: 1,0:18:03.04,0:18:04.28,ch,,0,0,0,,好冷
Dialogue: 1,0:18:13.64,0:18:14.53,ch,,0,0,0,,古见同学？
Dialogue: 1,0:18:15.07,0:18:17.24,ch,,0,0,0,,顺便买点高汤料回来哦小仁
Dialogue: 1,0:18:17.75,0:18:19.04,ch,,0,0,0,,汤料是吧 知道了
Dialogue: 1,0:18:19.29,0:18:21.75,ch,,0,0,0,,先去公园再说
Dialogue: 1,0:18:30.69,0:18:33.14,ch,,0,0,0,,刚才撞到的地方 没事吧
Dialogue: 1,0:18:36.25,0:18:38.43,ch,,0,0,0,,那就好 对不起
Dialogue: 1,0:18:39.57,0:18:42.65,ch,,0,0,0,,然后 有…有什么事吗
Dialogue: 1,0:18:42.87,0:18:44.69,ch,,0,0,0,,今晚特意过来…
Dialogue: 1,0:18:46.00,0:18:48.44,ch,,0,0,0,,巧克力吗 是巧克力吧
Dialogue: 1,0:18:56.01,0:18:57.82,ch,,0,0,0,,这是…
Dialogue: 1,0:18:58.48,0:19:04.60,ch,,0,0,0,,今天开了班委会奈津美说「把这个交给没来的只野」
Dialogue: 1,0:19:05.04,0:19:06.00,ch,,0,0,0,,啊 糟了
Dialogue: 1,0:19:06.27,0:19:07.86,ch,,0,0,0,,不好意思 特意让你跑一趟
Dialogue: 1,0:19:10.61,0:19:11.36,ch,,0,0,0,,这就回去了吗
Dialogue: 1,0:19:12.39,0:19:13.41,ch,,0,0,0,,路上小心
Dialogue: 1,0:19:27.61,0:19:29.41,ch,,0,0,0,,我在期待些什么
Dialogue: 1,0:19:30.02,0:19:32.23,ch,,0,0,0,,没收到才正常嘛
Dialogue: 1,0:19:35.98,0:19:39.02,ch,,0,0,0,,送不送也是古见同学决定的
Dialogue: 1,0:19:39.56,0:19:42.13,ch,,0,0,0,,嗯 只是我过度期待了而已
Dialogue: 1,0:19:43.40,0:19:44.80,ch,,0,0,0,,我在干什么呢
Dialogue: 1,0:19:48.27,0:19:48.84,ch,,0,0,0,,但是
Dialogue: 1,0:19:55.70,0:19:59.30,ch,,0,0,0,,真希望我不算是被她嫌弃了
Dialogue: 1,0:20:15.20,0:20:15.61,ch,,0,0,0,,只
Dialogue: 1,0:20:16.15,0:20:17.08,ch,,0,0,0,,只野
Dialogue: 1,0:20:24.30,0:20:24.89,ch,,0,0,0,,这就来
Dialogue: 1,0:20:32.47,0:20:32.97,ch,,0,0,0,,我在
Dialogue: 1,0:20:49.90,0:20:51.16,ch,,0,0,0,,这 这个
Dialogue: 1,0:20:57.36,0:20:59.88,ch,,0,0,0,,是 是友情 巧克力
Dialogue: 1,0:21:00.73,0:21:03.78,ch,,0,0,0,,嗯 当然了 当然
Dialogue: 1,0:21:04.13,0:21:04.74,ch,,0,0,0,,我懂
Dialogue: 1,0:21:15.33,0:21:18.37,ch,,0,0,0,,那个 这事说出来有些害羞
Dialogue: 1,0:21:18.90,0:21:23.29,ch,,0,0,0,,我今天一直在想 你会不会送我巧克力
Dialogue: 1,0:21:23.89,0:21:27.35,ch,,0,0,0,,古见同学似乎是给其他的所有朋友都送了
Dialogue: 1,0:21:27.71,0:21:32.12,ch,,0,0,0,,可一直没收到 我已经放弃了的
Dialogue: 1,0:21:33.71,0:21:34.63,ch,,0,0,0,,那个
Dialogue: 1,0:21:35.37,0:21:37.14,ch,,0,0,0,,我到底想说些什么来着
Dialogue: 1,0:21:38.97,0:21:39.68,ch,,0,0,0,,总之
Dialogue: 1,0:21:40.55,0:21:42.48,ch,,0,0,0,,收到了古见同学的巧克力
Dialogue: 1,0:21:43.07,0:21:46.39,ch,,0,0,0,,那个 比我想象的还要 高兴
Dialogue: 1,0:21:50.30,0:21:51.29,ch,,0,0,0,,好多倍
Dialogue: 1,0:21:59.39,0:22:02.55,ch,,0,0,0,,那包 巧克力
Dialogue: 1,0:22:03.26,0:22:05.91,ch,,0,0,0,,是 是我
Dialogue: 1,0:22:06.04,0:22:09.63,ch,,0,0,0,,做得…最好的 一份
Dialogue: 1,0:22:10.28,0:22:13.33,ch,,0,0,0,,还让你这么费心 谢谢你
Dialogue: 1,0:22:19.87,0:22:21.03,ch,,0,0,0,,古见同学？
Dialogue: 1,0:22:21.99,0:22:23.34,ch,,0,0,0,,古见同学 突然间怎么
Dialogue: 1,0:22:23.95,0:22:26.57,ch,,0,0,0,,天…天很黑了 我送你吧
Dialogue: 1,0:22:26.81,0:22:28.10,ch,,0,0,0,,古见同学
Comment: 0,0:00:30.01,0:00:30.01,OPJP,,0,0,0,,---------------OP------------
Comment: 0,0:03:19.35,0:03:27.19,OPJP,,0,0,0,,{\blur5\fad(200,200)}太陽に投げた言葉たち　砕けて　光ってる
Comment: 0,0:03:27.19,0:03:35.15,OPJP,,0,0,0,,{\blur5\fad(200,200)}君は手のひらにならべたね　痛くないふりしてさ
Comment: 0,0:03:35.15,0:03:43.33,OPJP,,0,0,0,,{\blur5\fad(200,200)}「わたしのままでいい」なんて未来　一緒に探してる
Comment: 0,0:03:43.33,0:03:51.04,OPJP,,0,0,0,,{\blur5\fad(200,200)}初めて越えた白線はもう　ここから見えないくらい
Comment: 0,0:03:51.04,0:03:59.51,OPJP,,0,0,0,,{\blur5\fad(200,200)}君と走れば　いつも風が生まれる
Comment: 0,0:03:59.51,0:04:03.43,OPJP,,0,0,0,,{\blur5\fad(200,200)}あの空、青100色
Comment: 0,0:04:03.43,0:04:07.23,OPJP,,0,0,0,,{\blur5\fad(200,200)}瞬きさえできない
Comment: 0,0:04:07.23,0:04:07.69,OPJP,,0,0,0,,{\blur5\fad(200,200)}君と今日もめぐり逢う
Comment: 0,0:04:07.69,0:04:14.94,OPJP2,,0,0,0,,{\blur5\fad(200,200)}君と今日もめぐり逢う　1cmずつ　恋に落ちる
Comment: 0,0:04:14.94,0:04:23.24,OPJP2,,0,0,0,,{\blur5\fad(200,200)}いつも肩が触れるたび　1cmずつ　恋が揺れる
Comment: 0,0:04:23.24,0:04:30.33,OPJP2,,0,0,0,,{\blur5\fad(200,200)}君の優しい鼓動ずっと聴いてたんだ
Comment: 0,0:04:30.33,0:04:33.80,OPJP2,,0,0,0,,{\blur5\fad(200,200)}大好きって気持ちを　ねぇ　
Comment: 0,0:04:33.80,0:04:38.51,OPJP2,,0,0,0,,{\blur5\fad(200,200)}もうこれ以上　どこにしまっておいたらいいの？
Comment: 0,0:00:00.00,0:00:00.00,OPCH,,0,0,0,,
Dialogue: 0,0:03:19.35,0:03:27.19,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1265,512)}我丢弃的话语像打碎的玻璃
Dialogue: 0,0:03:19.35,0:03:27.19,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1235,647)}在阳光下晶莹剔透
Dialogue: 0,0:03:27.19,0:03:35.16,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1265,485)}你却将其全部攥住握在手心
Dialogue: 0,0:03:27.19,0:03:35.16,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1235,623)}还装作一点也不痛
Dialogue: 0,0:03:35.16,0:03:43.34,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}你我一同 踏上寻找最真自我的路
Dialogue: 0,0:03:43.34,0:03:51.05,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}回首望去 早已不见出发时的踌躇
Dialogue: 0,0:03:51.05,0:03:59.52,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,595)}一同奔跑时 风儿总是如此喧嚣
Dialogue: 0,0:03:59.52,0:04:03.44,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,583)}看啊那片天空 青１００色
Dialogue: 0,0:04:03.44,0:04:07.23,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,480)}连眨眼都眨不了
Dialogue: 0,0:04:07.23,0:04:07.69,OPCH,,0,0,0,,{\fn@FOT-CinemaCN\fsp30\frz-90\pos(1250,508)}今天我也将与你邂逅
Dialogue: 1,0:04:07.69,0:04:14.95,OPCH2,,0,0,0,,今天我也将与你邂逅 一点一点 坠入爱河
Dialogue: 1,0:04:14.95,0:04:23.25,OPCH2,,0,0,0,,肩膀的距离逐渐靠近 一点一点 心在颤抖
Dialogue: 1,0:04:23.25,0:04:30.34,OPCH2,,0,0,0,,我早已听见了你那温柔的心跳
Dialogue: 1,0:04:30.34,0:04:33.80,OPCH2,,0,0,0,,那你说 我对你的爱意
Dialogue: 1,0:04:33.80,0:04:38.52,OPCH2,,0,0,0,,要再往哪里藏起来才好
Dialogue: 0,0:04:07.69,0:04:14.95,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}今天我也将与你邂逅 一点一点 坠入爱河
Dialogue: 0,0:04:14.95,0:04:23.25,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}肩膀的距离逐渐靠近 一点一点 心在颤抖
Dialogue: 0,0:04:23.25,0:04:30.34,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}我早已听见了你那温柔的心跳
Dialogue: 0,0:04:30.34,0:04:33.80,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}那你说 我对你的爱意
Dialogue: 0,0:04:33.80,0:04:38.51,OPCH2,,0,0,0,,{\bord1\blur3\3c&H000000&}要再往哪里藏起来才好
Comment: 0,0:02:07.57,0:02:09.57,EDJP,,0,0,0,,---------------ED------------
Dialogue: 0,0:22:30.00,0:22:31.66,EDJP,,0,0,0,,曲がり角はすぐそこに
Dialogue: 0,0:22:31.66,0:22:33.16,EDJP,,0,0,0,,もう見えているのに
Dialogue: 0,0:22:34.29,0:22:35.63,EDJP,,0,0,0,,気づかれないように
Dialogue: 0,0:22:35.63,0:22:38.50,EDJP,,0,0,0,,心の中でカウントしてる　(1　2　3)
Dialogue: 0,0:22:38.67,0:22:40.67,EDJP,,0,0,0,,響く靴音はひとつだけ
Dialogue: 0,0:22:40.67,0:22:42.42,EDJP,,0,0,0,,見えないパラメーターが
Dialogue: 0,0:22:42.51,0:22:44.59,EDJP,,0,0,0,,気になって仕方がないまま
Dialogue: 0,0:22:44.68,0:22:48.31,EDJP,,0,0,0,,いつだって客席から誰かを見てる　(Ah)
Dialogue: 0,0:22:48.39,0:22:52.39,EDJP,,0,0,0,,寂しがりの歌を耳に詰め込んで　(Ah)
Dialogue: 0,0:22:52.85,0:22:56.81,EDJP,,0,0,0,,くすぐったい考え事をして　(Ah)
Dialogue: 0,0:22:57.23,0:22:59.44,EDJP,,0,0,0,,何度だって手を取り合えそうだ
Dialogue: 0,0:22:59.44,0:23:01.69,EDJP,,0,0,0,,案外大丈夫　(案外大丈夫)
Dialogue: 0,0:23:01.69,0:23:04.07,EDJP,,0,0,0,,案外大丈夫　Ah
Dialogue: 0,0:23:04.78,0:23:06.41,EDJP,,0,0,0,,そっと踏み出すと
Dialogue: 0,0:23:06.41,0:23:08.95,EDJP,,0,0,0,,塗り変えられていく　(Ah)
Dialogue: 0,0:23:09.16,0:23:10.83,EDJP,,0,0,0,,知ってるはずの景色
Dialogue: 0,0:23:10.83,0:23:13.58,EDJP,,0,0,0,,いつもより静かで　(いつもより静かで)
Dialogue: 0,0:23:13.58,0:23:17.08,EDJP,,0,0,0,,それでも確かに　過ぎていく風の中で
Dialogue: 0,0:23:17.13,0:23:19.59,EDJP,,0,0,0,,君の声で顔上げた
Dialogue: 0,0:23:19.59,0:23:22.01,EDJP,,0,0,0,,噛み合わない部品
Dialogue: 0,0:23:22.05,0:23:23.17,EDJP,,0,0,0,,握りしめて
Dialogue: 0,0:23:23.17,0:23:24.80,EDJP,,0,0,0,,君の色は何色？
Dialogue: 0,0:23:24.80,0:23:27.22,EDJP,,0,0,0,,少し声に出してみたくなった
Dialogue: 0,0:23:27.22,0:23:30.35,EDJP,,0,0,0,,でも　ああ、やっぱり言わなくてもいいよ
Dialogue: 0,0:23:30.47,0:23:31.77,EDJP,,0,0,0,,混ざり合う
Dialogue: 0,0:23:31.77,0:23:35.39,EDJP,,0,0,0,,信号のない交差点みたいにじんわりと
Dialogue: 0,0:23:35.44,0:23:36.77,EDJP,,0,0,0,,広がる　溶ける
Dialogue: 0,0:23:36.81,0:23:39.69,EDJP,,0,0,0,,両手いっぱいに君の言葉抱えて
Dialogue: 0,0:23:39.69,0:23:42.15,EDJP,,0,0,0,,知りたい　見てみたい　触れたい
Dialogue: 0,0:23:42.23,0:23:44.69,EDJP,,0,0,0,,ぼやけたレンズの向こうから
Dialogue: 0,0:23:44.69,0:23:46.45,EDJP,,0,0,0,,こっちに手を振ってる
Dialogue: 0,0:23:46.45,0:23:49.74,EDJP,,0,0,0,,顔が見えない誰かが
Comment: 0,0:00:00.00,0:00:00.00,EDCH,,0,0,0,,
Dialogue: 0,0:22:30.00,0:22:31.66,EDCH,,0,0,0,,窗外便是路口的转角
Dialogue: 0,0:22:31.66,0:22:33.16,EDCH,,0,0,0,,明明早已捕捉到你的身影
Dialogue: 0,0:22:34.29,0:22:35.63,EDCH,,0,0,0,,却满心祈祷着别被你注意
Dialogue: 0,0:22:35.63,0:22:38.50,EDCH,,0,0,0,,内心里倒数 （1 2 3）
Dialogue: 0,0:22:38.67,0:22:40.67,EDCH,,0,0,0,,能听见的脚步声只有一个
Dialogue: 0,0:22:40.67,0:22:42.42,EDCH,,0,0,0,,没有实体的变量
Dialogue: 0,0:22:42.51,0:22:44.59,EDCH,,0,0,0,,令我无法不在意
Dialogue: 0,0:22:44.68,0:22:48.31,EDCH,,0,0,0,,总是坐在店里寻找着某人的身影 （Ah）
Dialogue: 0,0:22:48.39,0:22:52.39,EDCH,,0,0,0,,用伤感的音乐堵住我的双耳 （Ah）
Dialogue: 0,0:22:52.85,0:22:56.81,EDCH,,0,0,0,,想着那些让人悸动的心事 （Ah）
Dialogue: 0,0:22:57.23,0:22:59.44,EDCH,,0,0,0,,好几次差点直接牵起你的手
Dialogue: 0,0:22:59.44,0:23:01.69,EDCH,,0,0,0,,还好忍住了 （还好忍住了）
Dialogue: 0,0:23:01.69,0:23:04.07,EDCH,,0,0,0,,还好忍住了  Ah
Dialogue: 0,0:23:04.78,0:23:06.41,EDCH,,0,0,0,,轻轻踏出了一步后
Dialogue: 0,0:23:06.41,0:23:08.95,EDCH,,0,0,0,,眼前的世界变化了 （Ah）
Dialogue: 0,0:23:09.16,0:23:10.83,EDCH,,0,0,0,,本应熟悉的景色
Dialogue: 0,0:23:10.83,0:23:13.58,EDCH,,0,0,0,,却比以往更静谧 （却比以往更静谧）
Dialogue: 0,0:23:13.58,0:23:17.08,EDCH,,0,0,0,,即便如此 在这拂过的风中
Dialogue: 0,0:23:17.13,0:23:19.59,EDCH,,0,0,0,,我应你的声抬起了头
Dialogue: 0,0:23:19.59,0:23:22.01,EDCH,,0,0,0,,将不合适的零件
Dialogue: 0,0:23:22.05,0:23:23.17,EDCH,,0,0,0,,紧攥手中
Dialogue: 0,0:23:23.17,0:23:24.80,EDCH,,0,0,0,,你是什么颜色
Dialogue: 0,0:23:24.80,0:23:27.22,EDCH,,0,0,0,,有点想开口问问你
Dialogue: 0,0:23:27.22,0:23:30.35,EDCH,,0,0,0,,但是 啊 果然还是别问了吧
Dialogue: 0,0:23:30.47,0:23:31.77,EDCH,,0,0,0,,思绪乱成一团
Dialogue: 0,0:23:31.77,0:23:35.39,EDCH,,0,0,0,,像是没有红绿灯的十字路口一般
Dialogue: 0,0:23:35.44,0:23:36.77,EDCH,,0,0,0,,渐渐扩散 溶化
Dialogue: 0,0:23:36.81,0:23:39.69,EDCH,,0,0,0,,两只手都塞满了你的话语
Dialogue: 0,0:23:39.69,0:23:42.15,EDCH,,0,0,0,,好想了解你 注视你 触碰你
Dialogue: 0,0:23:42.23,0:23:44.69,EDCH,,0,0,0,,朦胧的镜头里映出的
Dialogue: 0,0:23:44.69,0:23:46.45,EDCH,,0,0,0,,向着我挥手的
Dialogue: 0,0:23:46.45,0:23:49.74,EDCH,,0,0,0,,看不见面容的某人
Comment: 0,0:00:00.00,0:00:00.00,EDCH,,0,0,0,,

