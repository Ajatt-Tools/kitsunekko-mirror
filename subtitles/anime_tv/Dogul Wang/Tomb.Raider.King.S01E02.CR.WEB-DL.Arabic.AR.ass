Dialogue: 0,0:01:30.61,0:01:31.99,Default,Kyungtae,0,0,0,,!مُت أيها الوغد
Dialogue: 0,0:01:45.20,0:01:46.23,Default,Thug 2,0,0,0,,!أيها الزعيم
Dialogue: 0,0:01:46.23,0:01:46.95,Default,Thug 1,0,0,0,,!أيها الزعيم
Dialogue: 0,0:01:49.75,0:01:52.04,Default,Jooheon,0,0,0,,.سأعتني بهذا جيدًا
Dialogue: 0,0:01:52.16,0:01:54.29,Default,Kyungtae,0,0,0,,.لكنه... لي
Dialogue: 0,0:01:55.30,0:01:56.59,Default,Jooheon,0,0,0,,...دعني أريك
Dialogue: 0,0:01:57.61,0:01:59.07,Default,Jooheon,0,0,0,,.طريقة استخدامه الصحيحة
Dialogue: 0,0:02:26.92,0:02:29.90,Default,Thug 2,0,0,0,,!لقد طعنني
Dialogue: 0,0:02:30.03,0:02:32.22,Default,Jooheon,0,0,0,,ما رأيكم؟ هل تريدون المواصلة؟
Dialogue: 0,0:02:40.70,0:02:42.70,Default,Kyungjoo,0,0,0,,ماذا قلت؟
Dialogue: 0,0:02:42.83,0:02:44.92,Default,Kyungjoo,0,0,0,,ضربك سو جوهيون؟
Dialogue: 0,0:02:45.04,0:02:49.20,Default,Kyungjoo,0,0,0,,ثم ماذا فعل؟\Nتتوقع أن أصدق هذا؟
Dialogue: 0,0:02:50.19,0:02:54.26,Default,Kyungtae,0,0,0,,!كما لو أنه مستحوذ\N!لقد هاجمنا بحركات لا تصدّق
Dialogue: 0,0:02:54.26,0:02:57.73,Default,Kyungtae,0,0,0,,!ليتك رأيتِ النظرة في عينيه
Dialogue: 0,0:02:57.85,0:03:00.06,Default,Kyungtae,0,0,0,,كم أخذ منك؟
Dialogue: 0,0:03:00.53,0:03:05.41,Default,Kyungtae,0,0,0,,...كل المال الذي في حسابي و\N.تمثال بوذا
Dialogue: 0,0:03:05.53,0:03:06.93,Default,Kyungjoo,0,0,0,,ماذا؟
Dialogue: 0,0:03:07.06,0:03:08.90,Default,Kyungjoo,0,0,0,,!يا لك من عديم الفائدة
Dialogue: 0,0:03:08.90,0:03:12.14,Default,Kyungjoo,0,0,0,,!استعده فورًا أيها الغبيّ
Dialogue: 0,0:03:17.26,0:03:18.72,Default,Jooheon,0,0,0,,.غريب
Dialogue: 0,0:03:19.19,0:03:22.93,Default,Pawnbroker,0,0,0,,.ذلك الشيء لا يساوي حتى 50 وون
Dialogue: 0,0:03:23.06,0:03:24.86,Default,Pawnbroker,0,0,0,,.لا بأس بالتخلص منه
Dialogue: 0,0:03:26.74,0:03:31.81,Default,Jooheon,0,0,0,,لا يمكن أن يكون قمامة\N.إن كان كيونغتي احتفظ به بعناية
Dialogue: 0,0:03:33.24,0:03:36.74,top,sign,0,0,0,,فُعلت مهارة الجاسوس\N.يحتوي التمثال على مادّة مريبة
Dialogue: 0,0:03:34.74,0:03:36.34,Default,Jooheon,0,0,0,,.مادّة مريبة
Dialogue: 0,0:03:37.06,0:03:38.74,Default,Jooheon,0,0,0,,...أيُعقل
Dialogue: 0,0:03:43.74,0:03:45.34,Default,Jooheon,0,0,0,,.بالطبع
Dialogue: 0,0:03:59.30,0:04:00.90,Default,Jooheon,0,0,0,,.انظر لهذا
Dialogue: 0,0:04:02.20,0:04:04.89,Default,Jooheon,0,0,0,,.هذا ليس شيئًا يسلمه المرء لمحلّ رهن
Dialogue: 0,0:04:07.08,0:04:07.94,Default,Geonwoo,0,0,0,,يا جوهيون؟
Dialogue: 0,0:04:07.94,0:04:09.65,Default,Jooheon,0,0,0,,.مرحبًا يا غيونوو
Dialogue: 0,0:04:10.32,0:04:12.39,Default,Kyungjoo,0,0,0,,.أنا في غاية الأسف
Dialogue: 0,0:04:12.39,0:04:15.34,Default,Kyungjoo,0,0,0,,.حاضر
Dialogue: 0,0:04:15.34,0:04:19.15,Default,Kyungjoo,0,0,0,,...بالطبع، أنا حقًا
Dialogue: 0,0:04:19.74,0:04:21.65,Default,Kyungjoo,0,0,0,,!من هناك؟ أنا أتحدث على الهاتف
Dialogue: 0,0:04:23.19,0:04:24.90,Default,Kyungtae,0,0,0,,.أختي
Dialogue: 0,0:04:24.90,0:04:28.15,Default,Geonwoo,0,0,0,,تلقينا معلومة بشأن عدة جرائم\N.تتعلق بالمخدرات
Dialogue: 0,0:04:28.43,0:04:32.48,Default,Kyungjoo,0,0,0,,!مخدرات؟ نحن مواطنون ملتزمون بالقانون
Dialogue: 0,0:04:32.48,0:04:34.15,Default,Kyungjoo,0,0,0,,.نبيع القطع الفنية فقط
Dialogue: 0,0:04:36.48,0:04:41.15,Default,Geonwoo,0,0,0,,.حصلنا على الدليل مسبقًا\Nأفترض أن الباقي في المستودع؟
Dialogue: 0,0:04:41.15,0:04:45.37,Default,Kyungjoo,0,0,0,,يعلمون بشأن المستودع في غيونغي-دو أيضًا؟
Dialogue: 0,0:04:45.37,0:04:49.07,Default,Kyungjoo,0,0,0,,.من الجيد أن جميع الحجرات محمية بكلمة مرور
Dialogue: 0,0:04:50.41,0:04:54.20,Default,Kyungjoo,0,0,0,,مستودع؟ وأيّ دليل؟\N...لا تستطيع حتى الشرطة
Dialogue: 0,0:04:54.48,0:04:56.70,Default,Policeman,0,0,0,,!تفقدنا جميع القطع الفنية الـ600
Dialogue: 0,0:04:57.74,0:05:00.12,Default,Policeman,0,0,0,,.تحتوي جميعها على مخدرات
Dialogue: 0,0:05:01.37,0:05:05.45,Default,Kyungjoo,0,0,0,,فتحتم... جميع الحجرات؟
Dialogue: 0,0:05:06.28,0:05:07.55,Default,Detective,0,0,0,,.التزمي الهدوء
Dialogue: 0,0:05:07.86,0:05:11.68,Default,Kyungjoo,0,0,0,,لكن لكل حجرة كلمة مرور مختلفة. كيف؟
Dialogue: 0,0:05:11.68,0:05:13.95,Default,Geonwoo,0,0,0,,.لحظة يا سيدتي
Dialogue: 0,0:05:14.81,0:05:15.90,Default,Geonwoo,0,0,0,,.هذا لك
Dialogue: 0,0:05:16.36,0:05:20.39,Default,Jooheon,0,0,0,,.ربما كان عليك العيش بطريقة لائقة
Dialogue: 0,0:05:19.61,0:05:22.11,top,Kyungjoo,0,0,0,,لا... سو جوهيون؟
Dialogue: 0,0:05:22.48,0:05:27.92,Default,Jooheon,0,0,0,,.عليك تغيير كلمات المرور بين الفينة والأخرى
Dialogue: 0,0:05:27.92,0:05:30.11,Default,Jooheon,0,0,0,,.استمتعي بوقتك في السجن
Dialogue: 0,0:05:31.20,0:05:34.46,Default,Kyungjoo,0,0,0,,!أيها الجرذ القذر
Dialogue: 0,0:05:34.59,0:05:36.49,Default,Kyungjoo,0,0,0,,!سأقتلك جزاءً لهذا
Dialogue: 0,0:05:44.77,0:05:49.39,Default,Geonwoo,0,0,0,,.ستحصل على مكافأة 100 مليون وون قريبًا\N!ادّخر المبلغ ولا تبدده كله
Dialogue: 0,0:05:49.52,0:05:51.90,Default,Jooheon,0,0,0,,.إنه كثير القلق
Dialogue: 0,0:05:52.14,0:05:54.68,Default,Jooheon,0,0,0,,.حُسم أمر رأس مالي
Dialogue: 0,0:05:54.68,0:05:56.86,Default,Jooheon,0,0,0,,.أولًا، سأنال قسطًا من النوم
Dialogue: 0,0:05:56.86,0:06:00.79,Default,Jooheon,0,0,0,,.ثم سيبدأ صيد المقابر غدًا
Dialogue: 0,0:06:06.77,0:06:09.74,Default,Jooheon,0,0,0,,ماذا؟ أين شقّتي؟
Dialogue: 0,0:06:09.74,0:06:12.34,Default,Jooheon,0,0,0,,هل ظهر... قبر هنا؟
Dialogue: 0,0:06:14.49,0:06:17.83,Default,Jooheon,0,0,0,,أهذا حظ جيّد أم سيئ؟
Dialogue: 0,0:06:24.06,0:06:25.90,top,Citizen 1,0,0,0,,.أجل، هذا لا يصدّق
Dialogue: 0,0:06:25.90,0:06:27.15,top,Citizen 2,0,0,0,,كيف يُعقل حدوث هذا؟
Dialogue: 0,0:06:28.52,0:06:30.94,Default,Linda,0,0,0,,.أجل، وصلتُ للتو
Dialogue: 0,0:06:31.06,0:06:33.06,Default,,0,0,0,,...حسنًا، على أيّ حال
Dialogue: 0,0:06:33.97,0:06:37.17,Default,Linda,0,0,0,,لا تعرف كوريا عن القبور بعد، صحيح؟
Dialogue: 0,0:06:38.01,0:06:40.14,Default,Linda,0,0,0,,.سنفجّر هذا قريبًا
Dialogue: 0,0:06:40.14,0:06:43.65,Default,Linda,0,0,0,,أجل. حتى الآن، يبدو أن لا أحد\N.يعرف أنه قبر
Dialogue: 0,0:06:44.12,0:06:45.17,Default,Linda,0,0,0,,.مفهوم
Dialogue: 0,0:06:46.17,0:06:47.15,Default,Kiyoshi,0,0,0,,.مرحبًا
Dialogue: 0,0:06:47.59,0:06:49.15,Default,Linda,0,0,0,,أنت؟
Dialogue: 0,0:06:50.12,0:06:53.43,Default,Kiyoshi,0,0,0,,لماذا أنت متفاجئة يا ليندا وولكر؟
Dialogue: 0,0:06:53.92,0:06:57.17,Default,Linda,0,0,0,,ما الذي يفعله فريق التنقيب الياباني هنا؟
Dialogue: 0,0:06:57.17,0:07:01.15,Default,Kiyoshi,0,0,0,,.ليس هذا سؤالًا ينبغي لشخصٍ من الولايات المتحدة أن يطرحه
Dialogue: 0,0:07:01.57,0:07:03.15,Default,Kiyoshi,0,0,0,,كيف حالك مع اضطراب فارق التوقيت؟
Dialogue: 0,0:07:03.57,0:07:07.15,Default,Linda,0,0,0,,صرنا لصوصًا حقًا إذًا يا آبي؟
Dialogue: 0,0:07:07.48,0:07:11.28,Default,Kiyoshi,0,0,0,,.يعلم كلانا ما نسعى إليه\Nلماذا النفاق؟
Dialogue: 0,0:07:11.28,0:07:14.90,Default,Kiyoshi,0,0,0,,.حافظي على طاقتك. الأثر من نصيبنا
Dialogue: 0,0:07:14.90,0:07:18.88,Default,Jooheon,0,0,0,,.وكالة الاستخبارات المركزية
Dialogue: 0,0:07:18.88,0:07:23.10,Default,Jooheon,0,0,0,,.والفريق الياباني قد وصلوا إلى هنا مسبقًا
Dialogue: 0,0:07:23.10,0:07:26.90,Default,Jooheon,0,0,0,,لكن أيّ نوع من المبتدئين يفجّر قبرًا؟
Dialogue: 0,0:07:27.54,0:07:30.90,Default,Jooheon,0,0,0,,.جيد. يبدو أنه لا يوجد خبراء
Dialogue: 0,0:07:33.94,0:07:35.46,Default,Jooheon,0,0,0,,...أليست هذه
Dialogue: 0,0:07:37.83,0:07:40.15,top,Jooheon,0,0,0,,.أجل، إنها نقوش القبر بلا شكّ
Dialogue: 0,0:07:42.03,0:07:45.79,Default,Jooheon,0,0,0,,.لغة تلك الآثار اللعينة
Dialogue: 0,0:07:45.79,0:07:48.10,Default,Jooheon,0,0,0,,...المضحك في الأمر هو
Dialogue: 0,0:07:48.10,0:07:51.81,Default,Jooheon,0,0,0,,.أن هذه الآثار تصف نفسها بالكثير من التفصيل
Dialogue: 0,0:07:52.68,0:07:57.74,Default,Jooheon,0,0,0,,،إن كان المرء قادرًا على قراءة الرموز\N.سيكتشف مكان المدخل والفخاخ
Dialogue: 0,0:08:01.10,0:08:03.74,Default,Jooheon,0,0,0,,.يسير هذا بشكل جيد
Dialogue: 0,0:08:06.52,0:08:08.88,Default,Jooheon,0,0,0,,.لنبدأ القراءة إذًا
Dialogue: 0,0:08:10.74,0:08:12.90,top,sign,0,0,0,,[خبير التشفير]\N.اكتسبت لقبًا جديدًا وفتحت إحدى المهارات
Dialogue: 0,0:08:12.90,0:08:15.49,top,sign,0,0,0,,مهارات مستكشف المقابر الأساسية\N.فُعلت اللسانيات من الرتبة إف
Dialogue: 0,0:08:13.59,0:08:16.66,Default,Jooheon,0,0,0,,.هذا كرم من ذلك الوغد المجنّح
Dialogue: 0,0:08:15.49,0:08:17.24,top,sign,0,0,0,,.الجاسوس (الرتبة إف): رصد كل شيء ضمن نطاق متر
Dialogue: 0,0:08:15.49,0:08:17.24,top,sign,0,0,0,,.اللسانيات (الرتبة إف): فهم مُحسّن لجميع اللغات
Dialogue: 0,0:08:18.23,0:08:22.61,Default,Jooheon,0,0,0,,.ممتاز. تبّقت مهارتان فقط
Dialogue: 0,0:08:25.67,0:08:27.74,Default,Jooheon,0,0,0,,.يفترض أن هذا هو المكان
Dialogue: 0,0:08:30.94,0:08:32.94,Default,Jooheon,0,0,0,,!حسنًا، هيّا بنا
Dialogue: 0,0:08:54.31,0:08:55.32,Default,Kiyoshi,0,0,0,,ما هذا؟
Dialogue: 0,0:08:56.97,0:08:59.34,Default,CIA Agent,0,0,0,,!يبدو أن مدخل القبر يُفتح
Dialogue: 0,0:08:59.34,0:09:02.06,Default,Linda,0,0,0,,ماذا؟ يُفتح؟
Dialogue: 0,0:09:09.52,0:09:11.86,Default,Kiyoshi,0,0,0,,!يا له من مشهد
Dialogue: 0,0:09:12.92,0:09:14.99,Default,Linda,0,0,0,,كيف حدث هذا؟
Dialogue: 0,0:09:25.83,0:09:29.01,Default,Jooheon,0,0,0,,.يُفترض أن يظهر شيء ما هنا قريبًا
Dialogue: 0,0:09:34.79,0:09:36.21,Default,Jooheon,0,0,0,,.ها هي ذي
Dialogue: 0,0:09:37.32,0:09:39.06,Default,Jooheon,0,0,0,,.هذا هو المكان الصحيح
Dialogue: 0,0:09:48.68,0:09:49.85,Default,Jooheon,0,0,0,,.عثرتُ عليه
Dialogue: 0,0:10:04.23,0:10:06.22,Default,Jooheon,0,0,0,,.سيفي هذا بالغرض
Dialogue: 0,0:10:15.08,0:10:16.97,Default,Snake,0,0,0,,.زائر
Dialogue: 0,0:10:27.54,0:10:31.90,Default,Snake,0,0,0,,.روح مسكينة أخرى أسقطت كنزها
Dialogue: 0,0:10:31.90,0:10:33.22,Default,Snake,0,0,0,,.تحدث
Dialogue: 0,0:10:33.81,0:10:36.22,Default,Jooheon,0,0,0,,!هنا، هنا
Dialogue: 0,0:10:36.97,0:10:38.66,Default,Jooheon,0,0,0,,ألا تستطيع رؤيتي؟
Dialogue: 0,0:10:40.08,0:10:42.46,Default,Snake,0,0,0,,!أيها الثعبان العجوز الأعمى
Dialogue: 0,0:10:46.03,0:10:47.41,Default,Snake,0,0,0,,...والآن
Dialogue: 0,0:10:48.21,0:10:52.70,Default,Snake,0,0,0,,.السكين الذهبيّ أو الفضيّ\Nأيهما لك؟
Dialogue: 0,0:10:53.52,0:10:56.57,Default,Jooheon,0,0,0,,هذا الأثر مستوحى من\N."الفأس الذهبية والفأس الفضية"
Dialogue: 0,0:10:57.63,0:10:59.59,Default,Jooheon,0,0,0,,قصة مشهورة
Dialogue: 0,0:10:59.59,0:11:02.19,Default,Jooheon,0,0,0,,،يعود أصلها إلى إحدى خرافات إيسوب
Dialogue: 0,0:11:02.19,0:11:05.03,Default,Jooheon,0,0,0,,.مع اختلافات في جميع أنحاء العالم
Dialogue: 0,0:11:05.61,0:11:09.21,Default,Jooheon,0,0,0,,.يستطيع حتى الأجانب اجتياز هذا القبر بسهولة
Dialogue: 0,0:11:09.21,0:11:12.10,Default,Jooheon,0,0,0,,.لكن هذه المرة، سأكون أول من يبدأ
Dialogue: 0,0:11:12.70,0:11:15.35,Default,Snake,0,0,0,,.أنتظر إجابتك
Dialogue: 0,0:11:15.74,0:11:19.35,Default,Jooheon,0,0,0,,.للأسف، ليس أيّ منهما لي
Dialogue: 0,0:11:21.97,0:11:23.85,Default,Snake,0,0,0,,.بشريّ صادق
Dialogue: 0,0:11:24.32,0:11:28.59,Default,Snake,0,0,0,,إذًا ربما هذا لك؟
Dialogue: 0,0:11:31.57,0:11:33.54,Default,Jooheon,0,0,0,,.هذا صحيح
Dialogue: 0,0:11:33.54,0:11:38.52,Default,Jooheon,0,0,0,,إن أجبت نعم، سأحصل على سكيني\N.وفأس ذهبية وأخرى فضية
Dialogue: 0,0:11:38.52,0:11:40.05,Default,Jooheon,0,0,0,,.وبذلك سأجتاز القبر
Dialogue: 0,0:11:40.37,0:11:41.39,Default,Jooheon,0,0,0,,...لكن
Dialogue: 0,0:11:42.06,0:11:45.80,Default,Jooheon,0,0,0,,هل لي أن ألقي نظرة فاحصة؟
Dialogue: 0,0:11:46.88,0:11:48.86,Default,Snake,0,0,0,,.بالطبع
Dialogue: 0,0:11:56.57,0:11:59.80,Default,Snake,0,0,0,,ما الذي تعتقد نفسك فاعلًا؟
Dialogue: 0,0:12:00.17,0:12:02.80,Default,Jooheon,0,0,0,,.اخرس. أنا لا أثق بكم
Dialogue: 0,0:12:03.81,0:12:08.32,Default,Jooheon,0,0,0,,ليس هناك ما يضمن لي\N.أن تكافئني بعدل
Dialogue: 0,0:12:08.80,0:12:11.21,Default,Jooheon,0,0,0,,قد تحولني هديتك بسهولة
Dialogue: 0,0:12:11.21,0:12:13.80,Default,Jooheon,0,0,0,,.إلى قاتل مجنون
Dialogue: 0,0:12:14.23,0:12:17.80,Default,Snake,0,0,0,,كيف تعرف هذا أيها البشريّ؟
Dialogue: 0,0:12:18.06,0:12:20.22,Default,Jooheon,0,0,0,,.أعتقد أن الأمر حدث في الولايات المتحدة آنذاك
Dialogue: 0,0:12:20.22,0:12:26.72,top,sign,0,0,0,,قاتل متسلسل في الولايات المتحدة
Dialogue: 0,0:12:20.22,0:12:26.72,top,sign,0,0,0,,يتسبب مستخدم أثر في مأساة أخرى
Dialogue: 0,0:12:20.81,0:12:24.54,Default,Jooheon,0,0,0,,آنذاك، أثر الفأس
Dialogue: 0,0:12:24.54,0:12:26.72,Default,Jooheon,0,0,0,,.حوّل مسخدمه إلى قاتل متسلسل
Dialogue: 0,0:12:32.59,0:12:35.68,Default,Jooheon,0,0,0,,...هذه نهايتك. لذا
Dialogue: 0,0:12:41.43,0:12:44.09,Default,Jooheon,0,0,0,,!استسلم بسرعة أيها الأثر
Dialogue: 0,0:12:45.52,0:12:50.43,Default,Snake,0,0,0,,هكذا تنوي الحصول عليّ إذًا؟
Dialogue: 0,0:12:50.43,0:12:52.10,Default,Jooheon,0,0,0,,.لنرَ ما مدى قوتك
Dialogue: 0,0:12:52.74,0:12:54.93,Default,Jooheon,0,0,0,,!سأستخدم "الهيمنة" لإخضاعك
Dialogue: 0,0:13:06.28,0:13:10.47,Default,Jooheon,0,0,0,,الألفة: القدرة على التحكم في الآثار\N.من خلال الثقة
Dialogue: 0,0:13:11.03,0:13:14.28,Default,Jooheon,0,0,0,,الهيمنة: القدرة على إجبار
Dialogue: 0,0:13:14.28,0:13:16.47,Default,Jooheon,0,0,0,,.الأثر على الطاعة
Dialogue: 0,0:13:17.01,0:13:18.39,Default,Jooheon,0,0,0,,.والتوافق
Dialogue: 0,0:13:18.39,0:13:21.10,Default,Jooheon,0,0,0,,.الرابط المثالي بين الأثر والسيد
Dialogue: 0,0:13:21.10,0:13:24.93,Default,Jooheon,0,0,0,,.كالموسيقيّ مع أداة موسيقية أثرية
Dialogue: 0,0:13:39.60,0:13:41.43,Default,Jooheon,0,0,0,,!أيتها... الدودة العنيدة
Dialogue: 0,0:13:47.94,0:13:50.14,Default,Snake,0,0,0,,!ارحل! ارحل
Dialogue: 0,0:13:51.14,0:13:54.01,Default,Jooheon,0,0,0,,!لن أتملقكم أنتم الآثار
Dialogue: 0,0:13:54.37,0:13:58.35,Default,Jooheon,0,0,0,,.لا أكترث للألفة هذه المرة
Dialogue: 0,0:13:58.55,0:14:00.89,Default,Jooheon,0,0,0,,!أطعني أيها الأثر
Dialogue: 0,0:14:00.89,0:14:04.84,Default,Jooheon,0,0,0,,.وإلا دمّرتك
Dialogue: 0,0:14:04.97,0:14:06.72,Default,Jooheon,0,0,0,,أتعتقد أنّي لن أفعل ذلك؟
Dialogue: 0,0:14:07.23,0:14:11.47,Default,Snake,0,0,0,,!يكفي أيها المجنون
Dialogue: 0,0:14:30.98,0:14:33.40,Default,Jooheon,0,0,0,,.يا له من حشرة
Dialogue: 0,0:14:33.40,0:14:35.56,Default,Jooheon,0,0,0,,.كان عليك أن تطيعني منذ البداية
Dialogue: 0,0:14:43.56,0:14:45.48,Default,Jooheon,0,0,0,,.يا لبريقه
Dialogue: 0,0:14:45.48,0:14:46.61,top,sign,0,0,0,,(الناجي من القبر)\N.اكتسبت لقبًا جديدًا وفتحت إحدى المهارات
Dialogue: 0,0:14:46.61,0:14:48.56,top,sign,0,0,0,,.فُعل تنقيب القبر من الرتبة إف
Dialogue: 0,0:14:48.56,0:14:50.98,top,sign,0,0,0,,تنقيب القبر (الرتبة إف): فهم مُحسّن للقبور
Dialogue: 0,0:14:51.23,0:14:53.83,Default,Jooheon,0,0,0,,.مهارة جديدة
Dialogue: 0,0:14:53.83,0:14:58.98,Default,Jooheon,0,0,0,,.تبقت مهارة أخيرة\Nكيف أفتحها؟
Dialogue: 0,0:15:02.48,0:15:05.48,top,sign,0,0,0,,[مستغلّ الآثار]
Dialogue: 0,0:15:02.48,0:15:05.48,top,sign,0,0,0,,.اكتسبت لقبًا جديدًا. زادت هيمنتك وانخفضت ألفتك
Dialogue: 0,0:15:02.89,0:15:05.48,Default,Jooheon,0,0,0,,مستغلّ الآثار؟
Dialogue: 0,0:15:05.76,0:15:08.03,Default,Jooheon,0,0,0,,.مستغلّ من بين كل الأمور
Dialogue: 0,0:15:08.03,0:15:10.25,Default,Jooheon,0,0,0,,،أيها الغراب الوغد
Dialogue: 0,0:15:10.25,0:15:13.40,Default,Jooheon,0,0,0,,تحاول العبث معي، صحيح؟
Dialogue: 0,0:15:13.40,0:15:15.03,Default,Kiyoshi,0,0,0,,...يفترض أنها أمامنا
Dialogue: 0,0:15:15.63,0:15:17.47,Default,Kiyoshi,0,0,0,,!ها هي البركة
Dialogue: 0,0:15:19.54,0:15:21.78,Default,Kiyoshi,0,0,0,,.كما جاء في النبوءة
Dialogue: 0,0:15:23.21,0:15:25.64,Default,Kiyoshi,0,0,0,,.اخرج أيها الأثر
Dialogue: 0,0:15:27.27,0:15:29.02,Default,Linda,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:15:29.32,0:15:32.34,Default,Jooheon,0,0,0,,.لقد تأخرتما أيها الأحمقين
Dialogue: 0,0:15:36.18,0:15:38.02,Default,Kiyoshi,0,0,0,,لماذا لم يحدث شيء؟
Dialogue: 0,0:15:38.40,0:15:42.96,Default,Kiyoshi,0,0,0,,جاء في النبوءة أن كل ما عليّ فعله\N!هو رمي أثر في البركة
Dialogue: 0,0:15:42.96,0:15:44.02,Default,Linda,0,0,0,,رسول؟
Dialogue: 0,0:15:44.32,0:15:48.02,Default,Linda,0,0,0,,.تملك اليابان أثر نبوءة إذًا
Dialogue: 0,0:15:48.02,0:15:52.27,Default,Kiyoshi,0,0,0,,!لا! توقفي عن محاولة استخراج المعلومات منّي
Dialogue: 0,0:15:53.00,0:15:54.27,Default,Kiyoshi,0,0,0,,ما الذي يحدث الآن؟
Dialogue: 0,0:15:54.85,0:15:56.74,Default,Linda,0,0,0,,.زلزال
Dialogue: 0,0:16:02.27,0:16:04.13,Default,Kiyoshi,0,0,0,,!تبًا، هناك خطب ما
Dialogue: 0,0:16:06.36,0:16:07.77,Default,Kiyoshi,0,0,0,,!علينا الخروج
Dialogue: 0,0:16:16.36,0:16:18.17,Default,Seungwoo,0,0,0,,!سحقًا
Dialogue: 0,0:16:18.54,0:16:21.67,Default,Seungwoo,0,0,0,,.أخذوا كل شيء حقًا
Dialogue: 0,0:16:22.09,0:16:26.60,Default,Thug 1,0,0,0,,...انتهت هذه التجارة بعد إلقاء القبض على زعيمينا
Dialogue: 0,0:16:26.60,0:16:28.12,Default,Seungwoo,0,0,0,,.أدرك ذلك أيها الأحمق
Dialogue: 0,0:16:28.25,0:16:32.38,Default,Seungwoo,0,0,0,,.وهي غلطة سو جوهيون
Dialogue: 0,0:16:32.54,0:16:34.42,Default,Seungwoo,0,0,0,,.لكن الأمر لم ينتهِ بعد
Dialogue: 0,0:16:35.20,0:16:40.05,Default,Thug 2,0,0,0,,!أجل، أحسنت\Nهل ستبرحه ضربًا؟
Dialogue: 0,0:16:40.18,0:16:44.60,Default,Seungwoo,0,0,0,,.أجل! لا يفلت أحد منّي
Dialogue: 0,0:16:44.74,0:16:46.63,Default,Seungwoo,0,0,0,,!وإلا لستُ أو سونغوو
Dialogue: 0,0:16:46.76,0:16:48.09,Default,Thug 1,0,0,0,,!مذهل
Dialogue: 0,0:16:49.13,0:16:51.13,top,sign,0,0,0,,فتى المهام سو جوهيون
Dialogue: 0,0:17:11.56,0:17:15.13,Default,Seungwoo,0,0,0,,نعم؟ مرحبًا؟
Dialogue: 0,0:17:15.45,0:17:19.13,Default,Jooheon,0,0,0,,لماذا تأخرت في الردّ؟\Nهل تتمنى الموت؟
Dialogue: 0,0:17:20.14,0:17:22.67,Default,Seungwoo,0,0,0,,لماذا تقلل من احترامي؟
Dialogue: 0,0:17:22.67,0:17:23.67,Default,Jooheon,0,0,0,,.اخرس
Dialogue: 0,0:17:24.01,0:17:27.49,Default,Jooheon,0,0,0,,.عليكم إنجاز مهمة بسيطة من أجلي
Dialogue: 0,0:17:30.69,0:17:33.26,Default,Kiyoshi,0,0,0,,.كان ذلك فاشلًا
Dialogue: 0,0:17:33.69,0:17:37.34,Default,Kiyoshi,0,0,0,,هناك نبوءة أخرى؟
Dialogue: 0,0:17:37.74,0:17:41.59,Default,Director of JSDF,0,0,0,,.سبقنا كوري إليه\N.اكتشفنا ذلك للتو
Dialogue: 0,0:17:41.98,0:17:45.63,Default,Kiyoshi,0,0,0,,وأخفيتم ذلك عنّي؟
Dialogue: 0,0:17:45.63,0:17:48.78,Default,Director of JSDF,0,0,0,,.تدرك طبيعة مستخدم الآثار ذاك
Dialogue: 0,0:17:49.54,0:17:50.59,Default,Kiyoshi,0,0,0,,لا تخبرني
Dialogue: 0,0:17:50.94,0:17:52.98,Default,Kiyoshi,0,0,0,,.أنها عجزت عن قراءة الكانجي مجددًا
Dialogue: 0,0:17:52.98,0:17:54.72,Default,Director of JSDF,0,0,0,,.أطفال هذه الأيام
Dialogue: 0,0:17:54.72,0:17:58.23,Default,Director of JSDF,0,0,0,,.نعمل على ذلك\N.لذا استمر في بذل جهدك أيضًا
Dialogue: 0,0:17:58.23,0:18:01.65,Default,Director of JSDF,0,0,0,,.وتوخّ الحذر من ذلك الكوري
Dialogue: 0,0:18:02.38,0:18:04.01,Default,Kiyoshi,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,0:18:04.83,0:18:06.80,Default,Director of JSDF,0,0,0,,.النبوءة مشؤومة
Dialogue: 0,0:18:10.23,0:18:12.63,Default,Director of JSDF,0,0,0,,."يُدعى "الشخص الذي سيلتهم العالم
Dialogue: 0,0:18:13.45,0:18:15.88,Default,Seungwoo,0,0,0,,ماذا؟ مايداس؟
Dialogue: 0,0:18:16.23,0:18:19.23,Default,Jooheon,0,0,0,,مايداس هي أكبر دار مزادات سرية في العالم
Dialogue: 0,0:18:19.23,0:18:21.65,Default,Jooheon,0,0,0,,.وتقع في لاس فيغاس
Dialogue: 0,0:18:22.74,0:18:27.13,Default,Jooheon,0,0,0,,،إن راقبت ما يحدث هناك\N.فقد أكتشف ما يخطط له كوون
Dialogue: 0,0:18:27.52,0:18:32.05,Default,Jooheon,0,0,0,,اذهبوا إلى مزاد هذا الشهر\N.للعثور على بضعة أغراض وشخص ما
Dialogue: 0,0:18:32.05,0:18:34.63,Default,Jooheon,0,0,0,,."ابحثوا عن جاك كايمان المعروف بـ"جي كي
Dialogue: 0,0:18:34.91,0:18:36.65,Default,Jooheon,0,0,0,,.ذلك لقبه
Dialogue: 0,0:18:36.94,0:18:40.54,Default,Seungwoo,0,0,0,,!كفاك سخافة\Nكيف سنذهب إلى هناك؟
Dialogue: 0,0:18:40.54,0:18:42.89,Default,Jooheon,0,0,0,,.فكروا في ذلك بأنفسكم
Dialogue: 0,0:18:42.89,0:18:46.36,Default,Jooheon,0,0,0,,.سأدفع لكم لذا لن تكون النفقات عائقًا
Dialogue: 0,0:18:46.36,0:18:48.29,Default,Jooheon,0,0,0,,.لن أجبركم بالطبع
Dialogue: 0,0:18:50.18,0:18:52.18,Default,Jooheon,0,0,0,,:أمامكم خياران
Dialogue: 0,0:18:52.98,0:18:56.26,Default,Jooheon,0,0,0,,.اذهبوا طواعية وإلا أبرحتكم ضربًا
Dialogue: 0,0:19:01.94,0:19:03.45,Default,Worker,0,0,0,,!شكرًا جزيلًا لك
Dialogue: 0,0:19:06.28,0:19:09.76,Default,Jooheon,0,0,0,,جيد. هكذا تكون قد انتهت التحضيرات\N.للوقت الراهن
Dialogue: 0,0:19:12.40,0:19:15.76,Default,Jooheon,0,0,0,,.حان وقت صيد الآثار -
Dialogue: 0,0:19:14.03,0:19:16.38,Default,Newscaster,0,0,0,,.أنباء عاجلة -
Dialogue: 0,0:19:16.38,0:19:19.76,Default,Newscaster,0,0,0,,هذه هي جريمة القتل الرابعة\N.التي يُبلّغ عنها هذا الشهر
Dialogue: 0,0:19:19.76,0:19:24.03,Default,Newscaster,0,0,0,,يُقال أن المشتبه به قد حاول\N.الانتحار بإضرام النار في نفسه
Dialogue: 0,0:19:19.76,0:19:25.76,top,sign,0,0,0,,"محاولة انتحار قرب محطة يونغدونغبو"
Dialogue: 0,0:19:24.03,0:19:25.76,Default,Newscaster,0,0,0,,...وفقًا للشهود
Dialogue: 0,0:19:26.05,0:19:31.32,Default,Jooheon,0,0,0,,.مثلما حدث آنذاك، قبل ظهور قبر جديد
Dialogue: 0,0:19:35.58,0:19:38.67,Default,Kiyoshi,0,0,0,,!انظر إلى أين تسير
Dialogue: 0,0:19:39.09,0:19:42.84,Default,Jooheon,0,0,0,,.إنه الرجل الذي حبسته في القبر
Dialogue: 0,0:19:44.84,0:19:46.84,Default,Jooheon,0,0,0,,...إن كان هنا فهذا يعني -
Dialogue: 0,0:19:44.84,0:19:46.84,Default,Kiyoshi,0,0,0,,ما رأيك بالاعتذار؟ -
Dialogue: 0,0:19:47.18,0:19:49.55,Default,Jooheon,0,0,0,,.أن القبر الجديد سيظهر قريبًا
Dialogue: 0,0:19:49.96,0:19:54.12,Default,Jooheon,0,0,0,,،في نفس الفترة تقريبًا\N.كان شخص في اليابان يملك أثر نبوءة
Dialogue: 0,0:19:52.58,0:19:54.63,top,Kiyoshi,0,0,0,,لماذا تحدق بي؟
Dialogue: 0,0:19:55.45,0:19:59.78,Default,Jooheon,0,0,0,,.ويبدو أن هذا الرجل أيضًا يحمل أثرًا
Dialogue: 0,0:19:59.78,0:20:04.00,Default,Jooheon,0,0,0,,.لا يُخفي هذا الغبيّ هالته
Dialogue: 0,0:20:01.00,0:20:04.00,Default,Kiyoshi,0,0,0,,أهناك خطب برأسك؟ -
Dialogue: 0,0:20:04.00,0:20:05.38,Default,Jooheon,0,0,0,,!أيًا كان، فأنا أريده -
Dialogue: 0,0:20:04.00,0:20:05.38,Default,Kiyoshi,0,0,0,,!انتظر -
Dialogue: 0,0:20:05.76,0:20:07.88,Default,Kiyoshi,0,0,0,,هل تصغي إليّ؟
Dialogue: 0,0:20:10.00,0:20:11.30,Default,Kiyoshi,0,0,0,,ما هذا؟
Dialogue: 0,0:20:11.94,0:20:14.80,Default,Jooheon,0,0,0,,.أنا في غاية الأسف
Dialogue: 0,0:20:15.18,0:20:17.80,Default,Kiyoshi,0,0,0,,!اتسخت ثيابي بالكامل
Dialogue: 0,0:20:17.93,0:20:21.13,Default,Kiyoshi,0,0,0,,!من الأفضل أن تدفع ثمن غسلها\N!هذه باهظة الثمن
Dialogue: 0,0:20:21.38,0:20:23.80,Default,Jooheon,0,0,0,,.للأسف، أنا مفلس
Dialogue: 0,0:20:25.89,0:20:28.03,Default,Jooheon,0,0,0,,.لا تبدو باهظة الثمن على أيّ حال
Dialogue: 0,0:20:28.03,0:20:29.18,Default,Kiyoshi,0,0,0,,ماذا قلت؟
Dialogue: 0,0:20:30.42,0:20:32.17,top,,0,0,0,,"فريق التنقيب الياباني"
Dialogue: 0,0:20:33.89,0:20:36.92,Default,Jooheon,0,0,0,,.سقطت بطاقة هويتك
Dialogue: 0,0:20:37.40,0:20:38.92,Default,Kiyoshi,0,0,0,,!أعطني تلك
Dialogue: 0,0:20:39.38,0:20:41.00,Default,Kiyoshi,0,0,0,,هل تعرّف عليّ؟
Dialogue: 0,0:20:41.00,0:20:43.92,Default,Kiyoshi,0,0,0,,لا يجب أن يعرف أحد\N.بوجود قوات الدفاع اليابانية في كوريا
Dialogue: 0,0:20:57.74,0:21:01.20,Default,Jooheon,0,0,0,,.ها هو ذا! تجسّد قبر
Dialogue: 0,0:21:01.20,0:21:03.34,Default,Jooheon,0,0,0,,.سيظهر أحدها الآن
Dialogue: 0,0:21:03.58,0:21:06.23,Default,Kiyoshi,0,0,0,,.جيد. مثلما جاء في النبوءة
Dialogue: 0,0:21:09.65,0:21:12.16,Default,Kiyoshi,0,0,0,,.مرحبًا؟ بدأت النبوءة للتو
Dialogue: 0,0:21:12.16,0:21:15.69,Default,Director of JSDF,0,0,0,,أعلم. وصلتنا أيضًا نبوءة أن الكوري
Dialogue: 0,0:21:15.69,0:21:17.94,Default,Director of JSDF,0,0,0,,.الذي يحمل أثر الفأس على مقربة منك
Dialogue: 0,0:21:17.94,0:21:20.80,Default,Director of JSDF,0,0,0,,،وأنك، ولسبب ما
Dialogue: 0,0:21:20.80,0:21:23.55,Default,Director of JSDF,0,0,0,,.يجب أن تتوخى الحذر من الكحول
Dialogue: 0,0:21:25.88,0:21:26.91,Default,Kiyoshi,0,0,0,,ذلك الحثالة
Dialogue: 0,0:21:27.18,0:21:29.83,Default,Kiyoshi,0,0,0,,كان الرجل الذي جاء في النبوءة؟
