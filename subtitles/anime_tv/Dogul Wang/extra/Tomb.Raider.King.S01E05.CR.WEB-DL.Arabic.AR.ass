Dialogue: 0,0:17:42.27,0:17:44.89,Default,Jinah,0,0,0,,.بالإضافة إلى تلقي راتب شهري
Dialogue: 0,0:17:45.09,0:17:47.66,Default,Jinah,0,0,0,,.ولن يتدخل أحد في حياتك الشخصية
Dialogue: 0,0:17:48.64,0:17:50.94,Default,Jinah,0,0,0,,...ستعمل كفرد في فريقنا
Dialogue: 0,0:17:51.71,0:17:54.06,Default,Jooheon,0,0,0,,.كنتُ أتساءل عمّا يدور هذا
Dialogue: 0,0:17:54.56,0:17:57.14,Default,Jooheon,0,0,0,,يودّ أن يقدّم لي عقد عبودية إذًا؟
Dialogue: 0,0:17:57.38,0:18:00.36,Default,Jinah,0,0,0,,.عليك مراقبة ألفاظك
Dialogue: 0,0:18:00.77,0:18:03.55,Default,Jinah,0,0,0,,ماذا برأيك سيحدث لو أن السيد كوون
Dialogue: 0,0:18:03.68,0:18:06.78,Default,Jinah,0,0,0,,طلب استعادة الأغراض المسروقة؟
Dialogue: 0,0:18:06.96,0:18:10.81,Default,Jinah,0,0,0,,يستطيع القضاء على جحر جرذان\N،كرواق شيانغ في رمشة عين
Dialogue: 0,0:18:10.94,0:18:15.03,Default,Jinah,0,0,0,,ويمكن أن يموت رجالك أيضًا\N.بأمراض مجهولة
Dialogue: 0,0:18:15.19,0:18:17.64,Default,Jinah,0,0,0,,.بطبيعة الحال، هذا ينطبق عليك أيضًا
Dialogue: 0,0:18:18.01,0:18:22.64,Default,Jooheon,0,0,0,,إذًا أردتُ العيش، عليّ الانصياع؟
Dialogue: 0,0:18:23.51,0:18:27.94,Default,Jooheon,0,0,0,,.يا سيدة لي، عليك اختيار أعدائك بحذر أكبر
Dialogue: 0,0:18:30.53,0:18:33.58,Default,Jooheon,0,0,0,,.وإلا ستكونين من يختفي دون أثر
Dialogue: 0,0:18:34.06,0:18:35.43,Default,Jinah,0,0,0,,مسحوق الزومبي؟
Dialogue: 0,0:18:35.56,0:18:37.76,Default,Jinah,0,0,0,,.كفاك سخافة
Dialogue: 0,0:18:37.88,0:18:41.29,Default,Jinah,0,0,0,,.لا تستطيع استخدام أثر أمام كل هؤلاء الناس
Dialogue: 0,0:18:41.67,0:18:44.85,Default,Jooheon,0,0,0,,.ألا أستطيع؟ لنكتشف ذلك
Dialogue: 0,0:18:45.84,0:18:47.22,Default,Jinah,0,0,0,,!...سحقًا
Dialogue: 0,0:18:49.97,0:18:51.33,Default,Jinah,0,0,0,,!إليك هذا
Dialogue: 0,0:18:59.15,0:19:01.44,Default,Jooheon,0,0,0,,.العين بالعين والسنّ بالسنّ
Dialogue: 0,0:19:02.08,0:19:03.42,Default,Jooheon,0,0,0,,...سأعيد لكِ
Dialogue: 0,0:19:03.93,0:19:05.34,Default,Jooheon,0,0,0,,!هذا مباشرة
Dialogue: 0,0:19:13.55,0:19:14.56,Default,Passenger 1,0,0,0,,ما كان ذلك؟
Dialogue: 0,0:19:14.69,0:19:15.69,Default,Passenger 2,0,0,0,,!لا يصدّق
Dialogue: 0,0:19:15.93,0:19:17.26,Default,Passenger 3,0,0,0,,هل يصورون فيلمًا؟
Dialogue: 0,0:19:23.08,0:19:25.49,Default,Jooheon,0,0,0,,.سيمنحنا هذا الكثير من الشهود
Dialogue: 0,0:19:27.25,0:19:28.96,Default,Jooheon,0,0,0,,.لننهِ الأمر
Dialogue: 0,0:19:34.71,0:19:37.00,Default,Security 1,0,0,0,,!نحتاج إلى الدعم\N!أكرّر، نحتاج إلى الدعم
Dialogue: 0,0:19:37.13,0:19:40.34,Default,Security 1,0,0,0,,!حدث هجوم في المقهى
Dialogue: 0,0:19:40.46,0:19:41.95,Default,Security 2,0,0,0,,!أرسلوا الجميع فورًا
Dialogue: 0,0:19:42.27,0:19:45.70,Default,Security 2,0,0,0,,بُلّغ عن امرأة عارية تضايق\N.الضيوف أمام المقهى
Dialogue: 0,0:19:46.40,0:19:47.96,Default,Taejoon,0,0,0,,.سحقًا
Dialogue: 0,0:19:52.01,0:19:54.34,TypePlaceholder,sign,0,0,0,,{\pos(320,73.6)}حبر الرسّام من حيّ مونتمارتر
Dialogue: 0,0:19:55.21,0:19:58.69,Default,Jooheon,0,0,0,,.يا له من اكتشاف غير متوقع
Dialogue: 0,0:19:58.81,0:20:02.34,Default,Crow,0,0,0,,.اتبع صوتي أيها البشريّ
Dialogue: 0,0:20:02.64,0:20:04.27,Default,Crow,0,0,0,,.الخطر يقترب
Dialogue: 0,0:20:04.39,0:20:05.87,Default,Jooheon,0,0,0,,الغراب...؟
Dialogue: 0,0:20:07.74,0:20:11.07,Default,Seungwoo,0,0,0,,أيّ غراب؟\N...ولماذا الجميع شاردون يا جيـ
Dialogue: 0,0:20:12.68,0:20:13.81,Default,Seungwoo,0,0,0,,.أيها الزعيم
Dialogue: 0,0:20:14.79,0:20:17.05,Default,Jooheon,0,0,0,,.لا يمكنهم سماع الغراب إذًا
Dialogue: 0,0:20:17.62,0:20:19.28,Default,Crow,0,0,0,,.هيّا. تعالَ
Dialogue: 0,0:20:19.94,0:20:22.65,Default,Jooheon,0,0,0,,!لا يحقّ لك أمري أيها الأثر
Dialogue: 0,0:20:22.78,0:20:25.64,Default,Jooheon,0,0,0,,،لقد أرسلتني إلى الماضي
Dialogue: 0,0:20:25.76,0:20:29.13,Default,Jooheon,0,0,0,,تجاهلت أسئلتي وتريدني الآن\Nأن أطيع أوامرك؟
Dialogue: 0,0:20:29.50,0:20:31.72,Default,Crow,0,0,0,,.ستندم على هذا
Dialogue: 0,0:20:32.35,0:20:34.83,Default,Jooheon,0,0,0,,!كأنّي سأثق بأثر
Dialogue: 0,0:20:39.07,0:20:41.57,Default,Taejoon,0,0,0,,.يا لها من فوضى
Dialogue: 0,0:20:47.57,0:20:49.27,Default,Taejoon,0,0,0,,سو جوهيون، صحيح؟
Dialogue: 0,0:20:49.75,0:20:51.57,Default,Jooheon,0,0,0,,...تايجون كوون
Dialogue: 0,0:20:57.37,0:21:01.62,Default,Seungwoo,0,0,0,,.أتى ذلك الرجل حقًا\Nما العمل الآن؟
Dialogue: 0,0:21:02.03,0:21:05.00,Default,Taejoon,0,0,0,,."أنا تايجون كوون، رئيس "تي كي بي إم
Dialogue: 0,0:21:05.13,0:21:07.31,Default,Seungwoo,0,0,0,,!مرحبًا
Dialogue: 0,0:21:07.44,0:21:09.13,Default,Seungwoo,0,0,0,,...يسرّني لقـ
Dialogue: 0,0:21:09.26,0:21:11.14,Default,Taejoon,0,0,0,,.اصمت
Dialogue: 0,0:21:14.22,0:21:15.92,Default,Rowdy 1,0,0,0,,ما خطبك؟
Dialogue: 0,0:21:16.09,0:21:17.94,Default,Rowdy 2,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:21:22.96,0:21:23.99,Default,Rowdy 1,0,0,0,,!سحقًا
