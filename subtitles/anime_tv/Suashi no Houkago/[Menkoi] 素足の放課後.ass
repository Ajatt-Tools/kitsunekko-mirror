Dialogue: 0,0:00:02.92,0:00:04.52,Default,,0,0,0,,お星様
Dialogue: 0,0:00:04.52,0:00:06.10,Default,,0,0,0,,私ミイコ
Dialogue: 0,0:00:07.73,0:00:09.57,Default,,0,0,0,,お願い聞いてください
Dialogue: 0,0:00:09.57,0:00:11.38,Default,,0,0,0,,明日試合があるんです
Dialogue: 0,0:00:13.88,0:00:16.45,Default,,0,0,0,,いや私のじゃありません
Dialogue: 0,0:00:16.45,0:00:18.92,Default,,0,0,0,,私の一番好きなあの人の
Dialogue: 0,0:00:20.02,0:00:22.68,Default,,0,0,0,,絶対勝たせてあげてほしいんです
Dialogue: 0,0:00:24.02,0:00:25.49,Default,,0,0,0,,あの人が勝てたなら
Dialogue: 0,0:00:27.02,0:00:29.98,Default,,0,0,0,,私どんなに苦しんでも構いません
Dialogue: 0,0:00:53.14,0:00:54.51,Default,,0,0,0,,いいぞ、ナミ!
Dialogue: 0,0:00:54.51,0:00:55.96,Default,,0,0,0,,このゲームもらった
Dialogue: 0,0:00:55.96,0:00:57.61,Default,,0,0,0,,Ok
Dialogue: 0,0:00:57.61,0:00:58.84,Default,,0,0,0,,- 頑張ろう\N- 頑張れ
Dialogue: 0,0:00:58.84,0:01:00.01,Default,,0,0,0,,あと一歩だぞ
Dialogue: 0,0:01:00.01,0:01:01.97,Default,,0,0,0,,アドバンテージ
Dialogue: 0,0:01:01.97,0:01:02.87,Default,,0,0,0,,サービス
Dialogue: 0,0:01:17.27,0:01:19.81,Default,,0,0,0,,ゲームセット
Dialogue: 0,0:01:22.78,0:01:24.17,Default,,0,0,0,,やった
Dialogue: 0,0:01:30.18,0:01:31.36,Default,,0,0,0,,ナミ
Dialogue: 0,0:01:42.24,0:01:43.71,Default,,0,0,0,,おめでとう
Dialogue: 0,0:01:44.28,0:01:46.08,Default,,0,0,0,,ありがとう、ミイコ
Dialogue: 0,0:01:46.67,0:01:48.63,Default,,0,0,0,,ナミ
Dialogue: 0,0:02:05.24,0:02:07.23,Default,,0,0,0,,- じゃあね、また明日 - バイバイ
Dialogue: 0,0:02:07.23,0:02:08.38,Default,,0,0,0,,- じゃあな - じゃあ
Dialogue: 0,0:02:26.72,0:02:27.85,Default,,0,0,0,,疲れちゃったわ
Dialogue: 0,0:02:27.85,0:02:29.90,Default,,0,0,0,,後、モデルなしでも描けるでしょ
Dialogue: 0,0:02:29.90,0:02:31.15,Default,,0,0,0,,ダメよ
Dialogue: 0,0:02:31.15,0:02:33.15,Default,,0,0,0,,ちゃんとポーズしてくれなきゃ
Dialogue: 0,0:02:34.34,0:02:35.43,Default,,0,0,0,,これが私？
Dialogue: 0,0:02:35.43,0:02:36.84,Default,,0,0,0,,いやよ!まだ見ちゃ!
Dialogue: 0,0:02:37.90,0:02:40.60,Default,,0,0,0,,ミイコの頭の中で作った私だわ？
Dialogue: 0,0:02:40.60,0:02:42.52,Default,,0,0,0,,嫌いなの？
Dialogue: 0,0:02:43.74,0:02:46.30,Default,,0,0,0,,あなた 本当の私知らないのよ
Dialogue: 0,0:02:46.30,0:02:47.90,Default,,0,0,0,,そうして？知っているわ
Dialogue: 0,0:02:47.90,0:02:48.87,Default,,0,0,0,,そうかしら？
Dialogue: 0,0:02:48.87,0:02:50.45,Default,,0,0,0,,知っているってば
Dialogue: 0,0:02:51.68,0:02:52.49,Default,,0,0,0,,描いて
Dialogue: 0,0:02:54.65,0:02:55.95,Default,,0,0,0,,ナミ
Dialogue: 0,0:02:56.51,0:02:58.01,Default,,0,0,0,,ヌード描いてちょうだい
Dialogue: 0,0:03:01.84,0:03:02.78,Default,,0,0,0,,ナミ 辞めて
Dialogue: 0,0:03:05.81,0:03:06.97,Default,,0,0,0,,さあ、ミイコ
Dialogue: 0,0:03:07.67,0:03:08.89,Default,,0,0,0,,嫌よ
Dialogue: 0,0:03:09.80,0:03:10.73,Default,,0,0,0,,なぜ？
Dialogue: 0,0:03:12.56,0:03:14.17,Default,,0,0,0,,可愛いのね、ミイコって
Dialogue: 0,0:03:14.17,0:03:16.01,Default,,0,0,0,,嫌よナミなりって
Dialogue: 0,0:03:20.42,0:03:21.24,Default,,0,0,0,,辞めて
Dialogue: 0,0:03:28.98,0:03:30.29,Default,,0,0,0,,辞めて、ナミ
Dialogue: 0,0:03:44.18,0:03:45.11,Default,,0,0,0,,ダメよ
Dialogue: 0,0:03:45.11,0:03:47.33,Default,,0,0,0,,辞めて、ミイコたら
Dialogue: 0,0:03:51.25,0:03:53.30,Default,,0,0,0,,ナミ、好き 大好き
Dialogue: 0,0:03:53.30,0:03:54.24,Default,,0,0,0,,ミイコ
Dialogue: 0,0:03:54.24,0:03:56.78,Default,,0,0,0,,あなたの事ばかり考えてるのよ
Dialogue: 0,0:03:56.78,0:03:58.77,Default,,0,0,0,,ナミが死んだら、私も死んじゃう
Dialogue: 0,0:03:58.77,0:04:00.45,Default,,0,0,0,,そんな事言わないで
Dialogue: 0,0:04:00.45,0:04:03.04,Default,,0,0,0,,本当に 本当なの
Dialogue: 0,0:04:03.04,0:04:04.05,Default,,0,0,0,,分かったわ
Dialogue: 0,0:04:04.05,0:04:05.19,Default,,0,0,0,,あたしも好きよ
Dialogue: 0,0:04:05.19,0:04:06.78,Default,,0,0,0,,猫みたいなミイコちゃん
Dialogue: 0,0:04:14.79,0:04:17.08,Default,,0,0,0,,ナミの体って暖かい
Dialogue: 0,0:04:17.08,0:04:18.33,Default,,0,0,0,,もうよそう
Dialogue: 0,0:04:18.33,0:04:19.84,Default,,0,0,0,,変な気持ちになって来たわ
Dialogue: 0,0:04:19.84,0:04:21.38,Default,,0,0,0,,このままでいたいの
Dialogue: 0,0:04:21.38,0:04:22.47,Default,,0,0,0,,もう終いよ
Dialogue: 0,0:04:22.47,0:04:23.38,Default,,0,0,0,,嫌
Dialogue: 0,0:04:23.38,0:04:24.62,Default,,0,0,0,,言う事聞きなさい
Dialogue: 0,0:04:28.36,0:04:29.40,Default,,0,0,0,,ごめんね
Dialogue: 0,0:04:29.40,0:04:31.09,Default,,0,0,0,,私達おかしいよ
Dialogue: 0,0:04:31.09,0:04:33.18,Default,,0,0,0,,おかしくなんかない
Dialogue: 0,0:04:33.18,0:04:34.71,Default,,0,0,0,,ナミがいけないのよ
Dialogue: 0,0:04:34.71,0:04:36.26,Default,,0,0,0,,謝ってるじゃない
Dialogue: 0,0:04:37.61,0:04:39.42,Default,,0,0,0,,もう一回キスして
Dialogue: 0,0:04:42.11,0:04:43.11,Default,,0,0,0,,ミイコ
Dialogue: 0,0:04:50.06,0:04:51.91,Default,,0,0,0,,二人とも綺麗ね
Dialogue: 0,0:05:13.96,0:05:15.68,Default,,0,0,0,,あら、一緒に帰らないの
Dialogue: 0,0:05:16.45,0:05:18.04,Default,,0,0,0,,ちょっと用事があるの
Dialogue: 0,0:05:18.04,0:05:19.47,Default,,0,0,0,,そんなら私も行く
Dialogue: 0,0:05:19.47,0:05:20.30,Default,,0,0,0,,ダメよ
Dialogue: 0,0:05:20.30,0:05:21.34,Default,,0,0,0,,さようなら
Dialogue: 0,0:05:42.17,0:05:44.45,Default,,0,0,0,,ナミが山口さんって？
Dialogue: 0,0:05:44.45,0:05:46.08,Default,,0,0,0,,嘘よね
Dialogue: 0,0:07:02.22,0:07:03.21,Default,,0,0,0,,辞めて
Dialogue: 0,0:07:47.15,0:07:48.51,Default,,0,0,0,,口でしてくれ
Dialogue: 0,0:08:00.92,0:08:02.80,Default,,0,0,0,,ナミ、辞めて
Dialogue: 0,0:08:02.80,0:08:04.50,Default,,0,0,0,,お願い、辞めて
Dialogue: 0,0:08:35.26,0:08:36.61,Default,,0,0,0,,ミイコ、見てる？
Dialogue: 0,0:08:36.61,0:08:38.24,Default,,0,0,0,,どこからみてる？
Dialogue: 0,0:08:44.98,0:08:46.52,Default,,0,0,0,,ナミのばか
Dialogue: 0,0:08:51.48,0:08:52.46,Default,,0,0,0,,いいわ
Dialogue: 0,0:12:30.24,0:12:31.50,Default,,0,0,0,,しずか先生
Dialogue: 0,0:12:31.98,0:12:33.96,Default,,0,0,0,,脅かしたごめんなさい
Dialogue: 0,0:12:33.96,0:12:35.42,Default,,0,0,0,,びっくりしちゃった
Dialogue: 0,0:12:35.42,0:12:36.80,Default,,0,0,0,,先生たら、ひどい
Dialogue: 0,0:12:39.31,0:12:41.13,Default,,0,0,0,,こんな遅くにどうしたの
Dialogue: 0,0:12:41.13,0:12:42.68,Default,,0,0,0,,何でも無いです
Dialogue: 0,0:12:42.68,0:12:44.76,Default,,0,0,0,,怖い人に襲われちゃう
Dialogue: 0,0:12:45.65,0:12:46.76,Default,,0,0,0,,いいんです
Dialogue: 0,0:12:46.76,0:12:49.02,Default,,0,0,0,,- あたしなんか何でも\N- 何言ってるのよ
Dialogue: 0,0:12:49.02,0:12:49.78,Default,,0,0,0,,乗りなさい
Dialogue: 0,0:12:49.78,0:12:51.10,Default,,0,0,0,,家まで送ってあげるわ
Dialogue: 0,0:12:52.22,0:12:53.72,Default,,0,0,0,,家なんか帰りたくない
Dialogue: 0,0:12:53.72,0:12:54.71,Default,,0,0,0,,だだ言って
Dialogue: 0,0:12:54.71,0:12:57.21,Default,,0,0,0,,うちの人が心配してるでしょ
Dialogue: 0,0:12:57.21,0:12:59.23,Default,,0,0,0,,心配なんてするはずないわ
Dialogue: 0,0:12:59.23,0:13:00.82,Default,,0,0,0,,冷たい家庭だもの
Dialogue: 0,0:13:00.82,0:13:03.11,Default,,0,0,0,,誰にも愛されてないんです 私
Dialogue: 0,0:13:03.79,0:13:04.56,Default,,0,0,0,,なぜ
Dialogue: 0,0:13:04.57,0:13:06.20,Default,,0,0,0,,こんなに可愛いのに
Dialogue: 0,0:13:50.92,0:13:51.77,Default,,0,0,0,,はい
Dialogue: 0,0:13:51.77,0:13:52.74,Default,,0,0,0,,美味しいわよ
Dialogue: 0,0:13:53.45,0:13:55.04,Default,,0,0,0,,飲めません お酒なんて
Dialogue: 0,0:13:55.50,0:13:56.62,Default,,0,0,0,,真面目なのね
Dialogue: 0,0:13:56.62,0:13:58.16,Default,,0,0,0,,先生がいいって言ってるのよ
Dialogue: 0,0:13:58.16,0:13:59.80,Default,,0,0,0,,匂いが素敵でしょ ほら
Dialogue: 0,0:14:00.47,0:14:01.50,Default,,0,0,0,,本当
Dialogue: 0,0:14:01.50,0:14:03.08,Default,,0,0,0,,一息に飲んでごらんなさい
Dialogue: 0,0:14:03.08,0:14:04.40,Default,,0,0,0,,気持ちが良くなるわ
Dialogue: 0,0:14:09.56,0:14:10.47,Default,,0,0,0,,ご立派
Dialogue: 0,0:14:10.47,0:14:11.93,Default,,0,0,0,,ごちそうさまでした
Dialogue: 0,0:15:43.94,0:15:45.40,Default,,0,0,0,,ミイコちゃん
Dialogue: 0,0:16:02.91,0:16:03.90,Default,,0,0,0,,ナミ
Dialogue: 0,0:16:03.90,0:16:05.25,Default,,0,0,0,,待って
Dialogue: 0,0:16:08.14,0:16:09.82,Default,,0,0,0,,- 早くいらっしゃい - 待って
Dialogue: 0,0:16:13.11,0:16:14.18,Default,,0,0,0,,辞めて
Dialogue: 0,0:16:18.16,0:16:19.65,Default,,0,0,0,,辞めて
Dialogue: 0,0:16:38.31,0:16:39.56,Default,,0,0,0,,辞めて
Dialogue: 0,0:17:07.99,0:17:09.98,Default,,0,0,0,,やめて下さいは、先生
Dialogue: 0,0:17:09.98,0:17:11.44,Default,,0,0,0,,平気よ、ミイコちゃん
Dialogue: 0,0:17:11.44,0:17:12.81,Default,,0,0,0,,こんな事嫌いで
Dialogue: 0,0:17:12.81,0:17:13.74,Default,,0,0,0,,辞めて
Dialogue: 0,0:17:13.74,0:17:15.75,Default,,0,0,0,,辞めて辞めてたら
Dialogue: 0,0:17:15.75,0:17:19.39,Default,,0,0,0,,行かないで \Nあたしを一人にしないで お願い
Dialogue: 0,0:17:19.39,0:17:21.44,Default,,0,0,0,,先生
Dialogue: 0,0:17:21.44,0:17:23.63,Default,,0,0,0,,もう少しこのままでいって
Dialogue: 0,0:18:08.66,0:18:09.94,Default,,0,0,0,,先...
Dialogue: 0,0:18:17.97,0:18:19.01,Default,,0,0,0,,辞めて
Dialogue: 0,0:19:04.69,0:19:06.18,Default,,0,0,0,,先生
Dialogue: 0,0:20:48.28,0:20:49.53,Default,,0,0,0,,ナミ
Dialogue: 0,0:20:49.53,0:20:50.80,Default,,0,0,0,,何のよ
Dialogue: 0,0:20:50.80,0:20:53.15,Default,,0,0,0,,あたし、浮気しちゃった
Dialogue: 0,0:20:53.15,0:20:55.66,Default,,0,0,0,,???大人の女の人とね
Dialogue: 0,0:20:55.66,0:20:58.52,Default,,0,0,0,,そんなことが言いたくてわざわざ呼び出したりしたの?
Dialogue: 0,0:20:58.52,0:20:59.45,Default,,0,0,0,,バカみたい
Dialogue: 0,0:20:59.45,0:21:00.87,Default,,0,0,0,,ジェラシー?
Dialogue: 0,0:21:01.63,0:21:02.66,Default,,0,0,0,,何言ってんのよ
Dialogue: 0,0:21:02.66,0:21:03.88,Default,,0,0,0,,いい加減にして
Dialogue: 0,0:21:03.88,0:21:06.32,Default,,0,0,0,,私のこと好きじゃないの?
Dialogue: 0,0:21:06.32,0:21:08.60,Default,,0,0,0,,もうまとわりつかないで欲しいわ
Dialogue: 0,0:21:09.85,0:21:11.00,Default,,0,0,0,,待ってよナミ
Dialogue: 0,0:21:11.00,0:21:12.15,Default,,0,0,0,,嘘なのよ
Dialogue: 0,0:21:30.24,0:21:32.61,Default,,0,0,0,,こっちだ!火事だぞ!
Dialogue: 0,0:21:36.74,0:21:38.78,Default,,0,0,0,,しずか先生の家の方向
Dialogue: 0,0:21:50.95,0:21:52.61,Default,,0,0,0,,燃えてしまえ
Dialogue: 0,0:21:52.61,0:21:54.61,Default,,0,0,0,,全て焼き尽くしてしまえ
Dialogue: 0,0:21:54.61,0:21:56.06,Default,,0,0,0,,私の肉体
Dialogue: 0,0:21:56.06,0:21:57.35,Default,,0,0,0,,私の精神
Dialogue: 0,0:21:57.35,0:21:58.96,Default,,0,0,0,,私の存在
Dialogue: 0,0:21:58.97,0:22:01.31,Default,,0,0,0,,全部焼き尽くして消し去って
Dialogue: 0,0:22:01.31,0:22:04.19,Default,,0,0,0,,私がこの世にいたということすら
Dialogue: 0,0:22:04.19,0:22:06.31,Default,,0,0,0,,しずか先生!
Dialogue: 0,0:22:08.16,0:22:09.48,Default,,0,0,0,,先生!
Dialogue: 0,0:22:09.48,0:22:11.23,Default,,0,0,0,,しずか先生
Dialogue: 0,0:22:38.52,0:22:39.74,Default,,0,0,0,,ミイコ!
Dialogue: 0,0:22:39.74,0:22:40.98,Default,,0,0,0,,何やってんだ?
Dialogue: 0,0:22:40.98,0:22:42.32,Default,,0,0,0,,脅かしなよ
Dialogue: 0,0:22:44.46,0:22:46.42,Default,,0,0,0,,私ナミと同じにして欲しいの
Dialogue: 0,0:22:48.08,0:22:49.78,Default,,0,0,0,,ナミと同じになりたいの
Dialogue: 0,0:22:49.78,0:22:51.26,Default,,0,0,0,,ナミが好きだから
Dialogue: 0,0:22:51.26,0:22:53.33,Default,,0,0,0,,あなたのことも好きになりたいの
Dialogue: 0,0:22:54.41,0:22:56.43,Default,,0,0,0,,俺モテてんのかな?
Dialogue: 0,0:22:56.43,0:22:57.57,Default,,0,0,0,,知らない
Dialogue: 0,0:22:57.57,0:22:58.88,Default,,0,0,0,,ナミと同じことして
Dialogue: 0,0:22:58.88,0:23:00.95,Default,,0,0,0,,ちょっと待てよ
Dialogue: 0,0:23:00.95,0:23:03.12,Default,,0,0,0,,準備ってものがあら
Dialogue: 0,0:23:05.71,0:23:06.59,Default,,0,0,0,,オーケー
Dialogue: 0,0:23:09.95,0:23:11.66,Default,,0,0,0,,まず気分は出そうぜ
Dialogue: 0,0:23:12.93,0:23:14.02,Default,,0,0,0,,どうして?
Dialogue: 0,0:23:14.02,0:23:16.02,Default,,0,0,0,,真やりたいんだろ、ミイコ
Dialogue: 0,0:23:16.71,0:23:18.60,Default,,0,0,0,,だったらAから行かなくちゃ
Dialogue: 0,0:23:19.48,0:23:20.48,Default,,0,0,0,,キスは嫌
Dialogue: 0,0:23:21.83,0:23:23.23,Default,,0,0,0,,変な奴だな
Dialogue: 0,0:23:56.58,0:23:57.65,Default,,0,0,0,,辞めて
Dialogue: 0,0:24:05.91,0:24:07.46,Default,,0,0,0,,辞めて
Dialogue: 0,0:24:23.48,0:24:24.93,Default,,0,0,0,,?????
Dialogue: 0,0:24:24.93,0:24:26.92,Default,,0,0,0,,やっぱり嫌 辞めて
Dialogue: 0,0:24:26.92,0:24:28.58,Default,,0,0,0,,何いってんだよ今更
Dialogue: 0,0:24:28.58,0:24:30.44,Default,,0,0,0,,嫌だったら嫌なのよ
Dialogue: 0,0:24:54.88,0:24:56.34,Default,,0,0,0,,聞いたわよ
Dialogue: 0,0:24:56.34,0:24:58.94,Default,,0,0,0,,殴る 恋人に手を出したから
Dialogue: 0,0:24:59.67,0:25:01.85,Default,,0,0,0,,ミイコの気持ちがよく分かったの
Dialogue: 0,0:25:07.82,0:25:08.93,Default,,0,0,0,,ナミ
Dialogue: 0,0:25:14.79,0:25:16.78,Default,,0,0,0,,ミイコ、あなたのこと愛してる
Dialogue: 0,0:25:16.78,0:25:18.16,Default,,0,0,0,,ナミ嬉しい
Dialogue: 0,0:25:48.43,0:25:49.34,Default,,0,0,0,,ナミ
