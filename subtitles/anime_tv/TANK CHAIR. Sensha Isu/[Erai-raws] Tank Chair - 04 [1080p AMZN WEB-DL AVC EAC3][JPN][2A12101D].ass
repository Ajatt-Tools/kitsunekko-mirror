Dialogue: 0,0:00:38.78,0:00:40.24,Default,,0,0,0,,（黒坂直墨くろさかなおずみ）どこ行った？
Dialogue: 0,0:00:44.33,0:00:46.21,Default,,0,0,0,,（黒坂騰子とうこ）しゅー
Dialogue: 0,0:00:46.79,0:00:47.54,Default,,0,0,0,,あ？
Dialogue: 0,0:00:51.05,0:00:54.88,Default,,0,0,0,,（平良たいら凪なぎ）戦車椅子タンクチェア第三號機マークスリー
Dialogue: 0,0:00:56.59,0:00:57.60,Default,,0,0,0,,鉄拳車椅子フィスト
Dialogue: 0,0:00:58.10,0:00:59.85,Default,,0,0,0,,（平良 静しずか）あ…
Dialogue: 0,0:01:01.43,0:01:05.48,Default,,0,0,0,,（直墨）ハッ… 上等だよ 凪
Dialogue: 0,0:01:06.90,0:01:09.40,Default,,0,0,0,,戦闘用の車椅子か
Dialogue: 0,0:01:09.48,0:01:11.65,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:01:12.15,0:01:15.70,Default,,0,0,0,,（直墨）ああ？\N“まず私にやらせて”って？
Dialogue: 0,0:01:15.78,0:01:17.74,Default,,0,0,0,,しかたねえな
Dialogue: 0,0:01:18.82,0:01:21.58,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:01:22.58,0:01:26.58,Default,,0,0,0,,（直墨）\N騰子 第弐にバルブまで開放だ
Dialogue: 0,0:01:26.67,0:01:28.50,Default,,0,0,0,,（凪が息を吐く音）
Dialogue: 0,0:01:30.75,0:01:32.67,Default,,0,0,0,,（静）ん…
Dialogue: 0,0:01:41.06,0:01:43.06,Default,,0,0,0,,♪～
Dialogue: 0,0:03:08.98,0:03:10.98,Default,,0,0,0,,～♪
Dialogue: 0,0:03:11.60,0:03:15.44,Default,,0,0,0,,（直墨）\N騰子 第弐バルブまで開放だ
Dialogue: 0,0:03:25.95,0:03:27.33,Default,,0,0,0,,（ガスを吸い込む音）
Dialogue: 0,0:03:33.83,0:03:34.71,Default,,0,0,0,,（凪）ハア…
Dialogue: 0,0:03:41.01,0:03:42.72,Default,,0,0,0,,（直墨）ん…
Dialogue: 0,0:03:43.43,0:03:48.85,Default,,0,0,0,,（騰子の呼吸音）
Dialogue: 0,0:03:50.06,0:03:50.89,Default,,0,0,0,,（静）あ…
Dialogue: 0,0:03:52.19,0:03:53.27,Default,,0,0,0,,（騰子）しゅー！
Dialogue: 0,0:03:59.36,0:04:00.53,Default,,0,0,0,,（凪）うっ…
Dialogue: 0,0:04:03.36,0:04:04.11,Default,,0,0,0,,うっ…
Dialogue: 0,0:04:06.41,0:04:07.41,Default,,0,0,0,,ううっ！
Dialogue: 0,0:04:12.67,0:04:13.75,Default,,0,0,0,,（騰子）しゅー！
Dialogue: 0,0:04:14.38,0:04:15.79,Default,,0,0,0,,（凪）ぐうっ…
Dialogue: 0,0:04:16.29,0:04:18.59,Default,,0,0,0,,うううっ… がっ…
Dialogue: 0,0:04:20.88,0:04:22.05,Default,,0,0,0,,（静）あ…
Dialogue: 0,0:04:22.63,0:04:23.68,Default,,0,0,0,,（凪）うっ！
Dialogue: 0,0:04:23.76,0:04:27.97,Default,,0,0,0,,ううっ… うううっ…
Dialogue: 0,0:04:30.64,0:04:33.89,Default,,0,0,0,,ダメ　もう これ以上は…
Dialogue: 0,0:04:38.36,0:04:39.36,Default,,0,0,0,,（凪）ううっ…
Dialogue: 0,0:04:39.44,0:04:46.45,Default,,0,0,0,,（凪の荒い息）
Dialogue: 0,0:04:48.95,0:04:51.04,Default,,0,0,0,,チッ… ああっ…
Dialogue: 0,0:04:51.54,0:04:54.29,Default,,0,0,0,,見かけ倒しかよ
Dialogue: 0,0:04:54.37,0:04:54.87,Default,,0,0,0,,だあっ！
Dialogue: 0,0:04:59.04,0:05:00.46,Default,,0,0,0,,騰子 殺やれ！
Dialogue: 0,0:05:00.55,0:05:02.51,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:05:02.59,0:05:03.92,Default,,0,0,0,,（凪）んっ…
Dialogue: 0,0:05:04.01,0:05:08.64,Default,,0,0,0,,（凪の荒い息とせきこみ）
Dialogue: 0,0:05:08.72,0:05:10.85,Default,,0,0,0,,（騰子）しゅー！
Dialogue: 0,0:05:15.10,0:05:15.81,Default,,0,0,0,,（凪）ハッ！
Dialogue: 0,0:05:17.94,0:05:19.31,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:05:23.74,0:05:24.61,Default,,0,0,0,,あっ…
Dialogue: 0,0:05:28.16,0:05:29.32,Default,,0,0,0,,（凪）ふん！
Dialogue: 0,0:05:31.20,0:05:31.95,Default,,0,0,0,,（直墨）あっ！
Dialogue: 0,0:05:32.54,0:05:33.91,Default,,0,0,0,,（凪）スゲえな
Dialogue: 0,0:05:34.96,0:05:37.25,Default,,0,0,0,,昔 こんなに強かったっけ？
Dialogue: 0,0:05:39.46,0:05:42.84,Default,,0,0,0,,（凪が息を吸う音）
Dialogue: 0,0:05:42.92,0:05:47.51,Default,,0,0,0,,（騰子の呼吸音）
Dialogue: 0,0:05:50.64,0:05:52.14,Default,,0,0,0,,（凪）いい“殺意”だ
Dialogue: 0,0:05:52.22,0:05:54.73,Default,,0,0,0,,だからダメって言ったのに
Dialogue: 0,0:05:54.81,0:05:55.89,Default,,0,0,0,,（直墨）騰子！
Dialogue: 0,0:05:56.39,0:05:56.89,Default,,0,0,0,,うっ…
Dialogue: 0,0:06:03.36,0:06:08.99,Default,,0,0,0,,（騰子の荒い息）
Dialogue: 0,0:06:16.50,0:06:21.71,Default,,0,0,0,,（騰子の荒い息）
Dialogue: 0,0:06:22.92,0:06:23.84,Default,,0,0,0,,（凪）ん？
Dialogue: 0,0:06:27.59,0:06:31.14,Default,,0,0,0,,（直墨）\Nあんな体でも圧倒されんのかよ！
Dialogue: 0,0:06:33.85,0:06:36.06,Default,,0,0,0,,チッ… ううっ…
Dialogue: 0,0:06:36.85,0:06:41.06,Default,,0,0,0,,マジでムカつくぜ
Dialogue: 0,0:06:42.69,0:06:47.44,Default,,0,0,0,,ぐっ… うううっ…
Dialogue: 0,0:06:47.95,0:06:50.03,Default,,0,0,0,,うっ ぐっ うっ…
Dialogue: 0,0:06:50.11,0:06:51.57,Default,,0,0,0,,ああっ…
Dialogue: 0,0:06:51.66,0:06:54.66,Default,,0,0,0,,うううっ…
Dialogue: 0,0:06:54.74,0:06:58.41,Default,,0,0,0,,ううっ… ぐううっ…
Dialogue: 0,0:06:58.50,0:06:59.54,Default,,0,0,0,,ああ～！
Dialogue: 0,0:06:59.62,0:07:03.46,Default,,0,0,0,,あっ… ああっ… ううっ！
Dialogue: 0,0:07:06.00,0:07:09.72,Default,,0,0,0,,ううっ… ああっ…
Dialogue: 0,0:07:11.18,0:07:14.93,Default,,0,0,0,,ううっ… あああっ…
Dialogue: 0,0:07:19.18,0:07:24.86,Default,,0,0,0,,ぐっ… うあああ…
Dialogue: 0,0:07:24.94,0:07:29.70,Default,,0,0,0,,（直墨の荒い息）
Dialogue: 0,0:07:30.20,0:07:34.24,Default,,0,0,0,,（直墨が息を吐く音）
Dialogue: 0,0:07:40.08,0:07:41.17,Default,,0,0,0,,（凪）スゲえ…
Dialogue: 0,0:07:41.25,0:07:42.96,Default,,0,0,0,,濃い“殺意”
Dialogue: 0,0:07:45.96,0:07:48.30,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:07:50.76,0:07:54.72,Default,,0,0,0,,（凪）おかげで 久しぶりに\Nめっちゃ目ぇ覚めたわ
Dialogue: 0,0:07:56.39,0:08:00.43,Default,,0,0,0,,まだ いけるだろ？　なあ
Dialogue: 0,0:08:00.98,0:08:03.56,Default,,0,0,0,,もっと くれよ
Dialogue: 0,0:08:06.77,0:08:08.32,Default,,0,0,0,,（静）あ…
Dialogue: 0,0:08:09.36,0:08:10.11,Default,,0,0,0,,（凪）うっ…
Dialogue: 0,0:08:12.53,0:08:17.49,Default,,0,0,0,,（直墨）ううっ… ああああっ！
Dialogue: 0,0:08:17.58,0:08:18.62,Default,,0,0,0,,（静）えっ…
Dialogue: 0,0:08:20.37,0:08:21.33,Default,,0,0,0,,（凪）うっ…
Dialogue: 0,0:08:21.41,0:08:24.88,Default,,0,0,0,,（直墨）騰子 もう休んでろ
Dialogue: 0,0:08:24.96,0:08:27.38,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:08:27.46,0:08:28.25,Default,,0,0,0,,（凪）あっ…
Dialogue: 0,0:08:28.34,0:08:32.34,Default,,0,0,0,,（直墨）その余裕かました態度…
Dialogue: 0,0:08:32.84,0:08:35.64,Default,,0,0,0,,相変わらずだな
Dialogue: 0,0:08:35.72,0:08:38.01,Default,,0,0,0,,どうせ俺たちには―
Dialogue: 0,0:08:38.10,0:08:41.77,Default,,0,0,0,,お前を殺せないとでも\N思ってんだろ？
Dialogue: 0,0:08:42.27,0:08:44.81,Default,,0,0,0,,俺らだってなあ―
Dialogue: 0,0:08:45.31,0:08:50.53,Default,,0,0,0,,お前が消えたあと\N遊んでたわけじゃねえんだぞ！
Dialogue: 0,0:08:50.61,0:08:51.44,Default,,0,0,0,,ううっ…
Dialogue: 0,0:08:51.53,0:08:55.82,Default,,0,0,0,,ううっ！　ああああ～！
Dialogue: 0,0:08:56.32,0:08:58.66,Default,,0,0,0,,何あれ 気持ち悪っ
Dialogue: 0,0:09:00.16,0:09:02.33,Default,,0,0,0,,（静）いや それより…
Dialogue: 0,0:09:02.96,0:09:06.63,s8,,0,0,0,,凪なら“殺意”を感知して\Nよけられたはず
Dialogue: 0,0:09:06.71,0:09:09.25,s8,,0,0,0,,あっ… まさか
Dialogue: 0,0:09:09.92,0:09:12.30,Default,,0,0,0,,（凪）“殺意”を消すマスクか
Dialogue: 0,0:09:12.80,0:09:17.18,Default,,0,0,0,,（直墨）ううっ… あああっ！
Dialogue: 0,0:09:17.68,0:09:20.43,Default,,0,0,0,,クッソがあ～！
Dialogue: 0,0:09:20.51,0:09:23.89,Default,,0,0,0,,ううっ… やっぱ このモードは―
Dialogue: 0,0:09:23.98,0:09:27.65,Default,,0,0,0,,頭いってえ～！
Dialogue: 0,0:09:27.73,0:09:29.56,Default,,0,0,0,,（ナレーション）頭痛蛸(ずつうだこ)
Dialogue: 0,0:09:30.07,0:09:32.53,s8,,0,0,0,,脳に寄生する半生物
Dialogue: 0,0:09:33.03,0:09:39.24,s8,,0,0,0,,環境に合わせた擬態や他者への変装\N脳波や気配の隠蔽など―
Dialogue: 0,0:09:39.32,0:09:41.91,s8,,0,0,0,,さまざまな用途に応用できる
Dialogue: 0,0:09:42.66,0:09:47.00,s8,,0,0,0,,一方 宿主は\N慢性的な頭痛に悩まされるため―
Dialogue: 0,0:09:47.08,0:09:51.38,s8,,0,0,0,,耐えきれず\N命を絶つ者も少なくない
Dialogue: 0,0:09:52.50,0:09:58.89,Default,,0,0,0,,（直墨）“学園”は\N力のない者の存在を許さない
Dialogue: 0,0:09:59.39,0:10:06.39,Default,,0,0,0,,俺たちは あそこで生き残るために\N相当のむちゃをしてきた
Dialogue: 0,0:10:07.23,0:10:11.65,Default,,0,0,0,,逃げ出したお前らとは違うんだよ！
Dialogue: 0,0:10:11.73,0:10:15.44,Default,,0,0,0,,な～ぎ～！
Dialogue: 0,0:10:23.70,0:10:28.42,Default,,0,0,0,,（直墨）\N逃げ出したお前らとは違うんだよ！
Dialogue: 0,0:10:28.50,0:10:31.46,Default,,0,0,0,,な～ぎ～！
Dialogue: 0,0:10:33.80,0:10:36.76,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:10:37.42,0:10:38.47,Default,,0,0,0,,（凪）あっ…
Dialogue: 0,0:10:42.10,0:10:42.60,Default,,0,0,0,,ぐはっ…
Dialogue: 0,0:10:42.68,0:10:43.39,Default,,0,0,0,,うっ！
Dialogue: 0,0:10:44.85,0:10:47.39,Default,,0,0,0,,（静）あっ… あ…
Dialogue: 0,0:10:48.48,0:10:48.98,Default,,0,0,0,,（凪）んっ！
Dialogue: 0,0:10:50.10,0:10:51.06,Default,,0,0,0,,うっ…
Dialogue: 0,0:10:51.15,0:10:52.31,Default,,0,0,0,,ごはっ！
Dialogue: 0,0:10:53.73,0:10:55.15,Default,,0,0,0,,（静）あっ…
Dialogue: 0,0:10:55.23,0:10:56.49,Default,,0,0,0,,（凪）ううっ…
Dialogue: 0,0:10:57.44,0:10:58.15,Default,,0,0,0,,ぐっ…
Dialogue: 0,0:11:01.41,0:11:02.74,Default,,0,0,0,,くっ… ああっ…
Dialogue: 0,0:11:07.37,0:11:11.17,Default,,0,0,0,,（直墨）どうした　動きが鈍いぞ
Dialogue: 0,0:11:11.25,0:11:14.13,Default,,0,0,0,,そろそろ“殺意”切れか？
Dialogue: 0,0:11:14.21,0:11:15.67,Default,,0,0,0,,ハハハ…
Dialogue: 0,0:11:15.75,0:11:17.01,Default,,0,0,0,,（凪）あっ…
Dialogue: 0,0:11:19.05,0:11:21.47,Default,,0,0,0,,うっ… ううっ…
Dialogue: 0,0:11:24.35,0:11:25.76,Default,,0,0,0,,（静）ハア ハア…
Dialogue: 0,0:11:26.52,0:11:27.39,Default,,0,0,0,,（凪）うっ…
Dialogue: 0,0:11:29.35,0:11:30.60,Default,,0,0,0,,（静）あっ…
Dialogue: 0,0:11:30.69,0:11:34.31,s8,,0,0,0,,こ… こいつ 気付いて…
Dialogue: 0,0:11:34.40,0:11:37.69,Default,,0,0,0,,（直墨）“向けられた殺意を\Nパワーに変える”
Dialogue: 0,0:11:38.44,0:11:41.28,s8,,0,0,0,,…という\Nお前の元の能力から考えるに―
Dialogue: 0,0:11:42.57,0:11:44.87,s8,,0,0,0,,今のお前は―
Dialogue: 0,0:11:44.95,0:11:47.49,s8,,0,0,0,,“殺されそうになったときだけ\N意識が戻る”
Dialogue: 0,0:11:47.58,0:11:49.66,Default,,0,0,0,,…っつう状況なんじゃねえのか？
Dialogue: 0,0:11:49.75,0:11:50.37,Default,,0,0,0,,（静）うっ…
Dialogue: 0,0:11:57.63,0:12:00.17,Default,,0,0,0,,（直墨）あの天才が…
Dialogue: 0,0:12:00.67,0:12:03.68,Default,,0,0,0,,こんなことに\Nなっちまうとはな
Dialogue: 0,0:12:04.93,0:12:09.60,Default,,0,0,0,,（直墨）\N昔から お前のことは嫌いだった
Dialogue: 0,0:12:11.77,0:12:12.77,Default,,0,0,0,,（直墨）うっ…
Dialogue: 0,0:12:13.56,0:12:14.94,Default,,0,0,0,,ああっ…
Dialogue: 0,0:12:15.44,0:12:16.52,Default,,0,0,0,,うっ…
Dialogue: 0,0:12:19.23,0:12:20.36,Default,,0,0,0,,ああっ！
Dialogue: 0,0:12:22.82,0:12:23.66,Default,,0,0,0,,え…
Dialogue: 0,0:12:33.92,0:12:34.42,Default,,0,0,0,,あ…
Dialogue: 0,0:12:34.50,0:12:35.42,Default,,0,0,0,,くっ…
Dialogue: 0,0:12:38.46,0:12:42.55,Default,,0,0,0,,うっ ううっ… ああっ…
Dialogue: 0,0:12:44.80,0:12:45.93,Default,,0,0,0,,くっ！
Dialogue: 0,0:12:46.01,0:12:47.05,Default,,0,0,0,,（直墨）でも…
Dialogue: 0,0:12:48.47,0:12:50.43,s8,,0,0,0,,いつも思っていた
Dialogue: 0,0:12:53.52,0:12:57.31,s8,,0,0,0,,いつか 追いつきたいと
Dialogue: 0,0:13:00.15,0:13:02.78,Default,,0,0,0,,（直墨）なのに～！
Dialogue: 0,0:13:03.28,0:13:09.24,Default,,0,0,0,,あんなカスのために\Nこんな体になっちまうとはなあ！
Dialogue: 0,0:13:10.87,0:13:13.50,Default,,0,0,0,,（静）ううっ… ううっ…
Dialogue: 0,0:13:16.54,0:13:18.71,Default,,0,0,0,,（凪）悪くない…
Dialogue: 0,0:13:21.42,0:13:22.59,Default,,0,0,0,,くっ…
Dialogue: 0,0:13:24.30,0:13:26.64,Default,,0,0,0,,この体も…
Dialogue: 0,0:13:28.55,0:13:31.14,Default,,0,0,0,,悪く… ない
Dialogue: 0,0:13:31.64,0:13:32.68,Default,,0,0,0,,（直墨）はあ？
Dialogue: 0,0:13:37.90,0:13:40.57,Default,,0,0,0,,（凪）前より…
Dialogue: 0,0:13:42.57,0:13:44.24,Default,,0,0,0,,強く…
Dialogue: 0,0:13:46.36,0:13:50.99,Default,,0,0,0,,“キズナ”を感じる… から
Dialogue: 0,0:13:51.08,0:13:56.87,Default,,0,0,0,,（静の泣き声）
Dialogue: 0,0:13:56.96,0:13:58.79,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:14:03.26,0:14:07.34,Default,,0,0,0,,（直墨）はあ？\N言ってて恥ずかしくないんか
Dialogue: 0,0:14:10.39,0:14:12.39,Default,,0,0,0,,（凪）確かに…
Dialogue: 0,0:14:14.93,0:14:18.44,Default,,0,0,0,,“お兄ちゃん キモい”って…
Dialogue: 0,0:14:20.73,0:14:23.69,Default,,0,0,0,,言われ… そう…
Dialogue: 0,0:14:30.03,0:14:34.37,Default,,0,0,0,,（直墨）やっと燃料切れか
Dialogue: 0,0:14:37.33,0:14:38.00,Default,,0,0,0,,あ…
Dialogue: 0,0:14:58.77,0:15:00.48,Default,,0,0,0,,凪…
Dialogue: 0,0:15:02.48,0:15:03.44,Default,,0,0,0,,うっ…
Dialogue: 0,0:15:04.82,0:15:08.61,Default,,0,0,0,,お前は せめて―
Dialogue: 0,0:15:09.32,0:15:11.82,Default,,0,0,0,,この俺の手で…
Dialogue: 0,0:15:13.20,0:15:15.54,Default,,0,0,0,,うっ… ああっ！
Dialogue: 0,0:15:16.24,0:15:19.04,Default,,0,0,0,,あばよ～！
Dialogue: 0,0:15:20.71,0:15:24.09,Default,,0,0,0,,（静）ううああああ～！
Dialogue: 0,0:15:29.34,0:15:30.18,Default,,0,0,0,,うっ…
Dialogue: 0,0:15:31.01,0:15:31.80,Default,,0,0,0,,あっ！
Dialogue: 0,0:15:32.76,0:15:33.26,Default,,0,0,0,,がっ…
Dialogue: 0,0:15:33.35,0:15:34.26,Default,,0,0,0,,ううっ！
Dialogue: 0,0:15:36.89,0:15:38.56,Default,,0,0,0,,（直墨）さっきから―
Dialogue: 0,0:15:38.64,0:15:42.85,Default,,0,0,0,,お前がチョロチョロしてるのに\N気付いてないとでも思ったか？
Dialogue: 0,0:15:42.94,0:15:45.44,Default,,0,0,0,,ううっ… ハア ハア ハア…
Dialogue: 0,0:15:45.52,0:15:47.73,Default,,0,0,0,,（直墨）よ～く見てろ
Dialogue: 0,0:15:48.49,0:15:51.82,Default,,0,0,0,,これから お前の兄貴は死ぬ
Dialogue: 0,0:15:52.32,0:15:55.20,Default,,0,0,0,,落ちこぼれの お前のせいでな！
Dialogue: 0,0:15:55.28,0:15:57.45,Default,,0,0,0,,ハア ハア…
Dialogue: 0,0:15:57.54,0:16:00.12,Default,,0,0,0,,（直墨）うう～！
Dialogue: 0,0:16:00.79,0:16:06.63,Default,,0,0,0,,（静）さっさと\N私を殺しとけば 助かったのに…
Dialogue: 0,0:16:06.71,0:16:08.05,Default,,0,0,0,,（直墨）あ～？
Dialogue: 0,0:16:09.13,0:16:11.34,Default,,0,0,0,,（静）うっ う…
Dialogue: 0,0:16:11.42,0:16:12.13,Default,,0,0,0,,フッ
Dialogue: 0,0:16:12.93,0:16:13.64,Default,,0,0,0,,（直墨）は？
Dialogue: 0,0:16:16.47,0:16:19.56,Default,,0,0,0,,ギリギリ届いたって\N言ってんだよ タコ！
Dialogue: 0,0:16:24.98,0:16:26.86,Default,,0,0,0,,（凪）言ったろ
Dialogue: 0,0:16:27.98,0:16:31.99,Default,,0,0,0,,前より “キズナ”を感じるって
Dialogue: 0,0:16:32.07,0:16:33.66,Default,,0,0,0,,（直墨）“キズナ”って…
Dialogue: 0,0:16:35.41,0:16:36.70,Default,,0,0,0,,まさか…
Dialogue: 0,0:16:47.25,0:16:53.26,Default,,0,0,0,,さっき 静が狙っていたのは\N俺じゃなく 凪のほう？
Dialogue: 0,0:16:53.93,0:16:55.05,Default,,0,0,0,,（静）べえ～
Dialogue: 0,0:16:55.14,0:16:56.01,Default,,0,0,0,,（直墨）あっ…
Dialogue: 0,0:16:56.09,0:16:58.68,Default,,0,0,0,,し… し… 死！
Dialogue: 0,0:16:59.26,0:17:00.14,Default,,0,0,0,,（凪）うらあっ！
Dialogue: 0,0:17:00.64,0:17:01.68,Default,,0,0,0,,（直墨）うわあっ！
Dialogue: 0,0:17:01.77,0:17:02.48,Default,,0,0,0,,（静）うっ！
Dialogue: 0,0:17:02.56,0:17:03.64,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:17:06.73,0:17:07.44,Default,,0,0,0,,（直墨）ぐあっ…
Dialogue: 0,0:17:09.23,0:17:10.44,Default,,0,0,0,,（凪）しまった
Dialogue: 0,0:17:24.62,0:17:30.09,Default,,0,0,0,,（直墨）あの落ちこぼれ\N本気で兄貴を殺そうとしやがった
Dialogue: 0,0:17:31.59,0:17:36.55,Default,,0,0,0,,“殺意”ってのは\N無意識の領域の脳波
Dialogue: 0,0:17:37.59,0:17:40.51,Default,,0,0,0,,殺すふりで出せるもんじゃない
Dialogue: 0,0:17:41.47,0:17:43.43,Default,,0,0,0,,ううっ…
Dialogue: 0,0:17:43.52,0:17:46.48,Default,,0,0,0,,イカれてんのか あの兄妹きょうだいは
Dialogue: 0,0:17:47.94,0:17:49.15,Default,,0,0,0,,（騰子）しゅー
Dialogue: 0,0:17:52.19,0:17:56.15,Default,,0,0,0,,（直墨）“それより先生には\Nどう報告するんだ”って？
Dialogue: 0,0:17:56.70,0:17:58.66,Default,,0,0,0,,くうっ…
Dialogue: 0,0:17:58.74,0:18:03.87,Default,,0,0,0,,場合によっちゃあ\N俺たちまで“卒業”だ
Dialogue: 0,0:18:04.91,0:18:06.04,Default,,0,0,0,,うっ…
Dialogue: 0,0:18:07.21,0:18:12.38,Default,,0,0,0,,あっ ああっ… あったま痛いてえ！
Dialogue: 0,0:18:30.73,0:18:31.86,Default,,0,0,0,,（凪）すまん
Dialogue: 0,0:18:36.24,0:18:39.16,Default,,0,0,0,,黒坂兄妹に逃げられたってことは―
Dialogue: 0,0:18:39.66,0:18:43.24,Default,,0,0,0,,俺たちの居場所は まもなく\N学園にバレる
Dialogue: 0,0:18:43.95,0:18:47.29,Default,,0,0,0,,（静）まあ… そうなるよね
Dialogue: 0,0:18:52.00,0:18:55.76,Default,,0,0,0,,フッ… フフフッ　ヒヒッ
Dialogue: 0,0:18:56.26,0:18:58.05,Default,,0,0,0,,フウ～！
Dialogue: 0,0:18:58.13,0:19:05.14,Default,,0,0,0,,（静の鼻歌）
Dialogue: 0,0:19:10.23,0:19:10.98,Default,,0,0,0,,（凪）静
Dialogue: 0,0:19:12.40,0:19:16.11,Default,,0,0,0,,１つ 約束してくれ
Dialogue: 0,0:19:18.24,0:19:21.78,Default,,0,0,0,,お前と俺 どちらかしか\N助からないときが来たら―
Dialogue: 0,0:19:23.03,0:19:26.62,Default,,0,0,0,,必ず 自分を優先すると
Dialogue: 0,0:19:30.25,0:19:31.75,Default,,0,0,0,,あ…
Dialogue: 0,0:19:34.75,0:19:35.67,Default,,0,0,0,,はあ？
Dialogue: 0,0:19:37.09,0:19:37.84,Default,,0,0,0,,はあ？
Dialogue: 0,0:19:37.92,0:19:39.22,Default,,0,0,0,,（凪）ううっ…
Dialogue: 0,0:19:39.92,0:19:42.26,Default,,0,0,0,,（静）んん～！
Dialogue: 0,0:19:42.34,0:19:43.60,Default,,0,0,0,,（殴る音）
Dialogue: 0,0:19:44.35,0:19:45.51,Default,,0,0,0,,（凪）いって！
Dialogue: 0,0:19:45.60,0:19:47.72,Default,,0,0,0,,何すんだ ケガ人に向かって
Dialogue: 0,0:19:47.81,0:19:49.02,Default,,0,0,0,,（静）むうっ…
Dialogue: 0,0:19:53.35,0:19:54.81,Default,,0,0,0,,（静）分かってた
Dialogue: 0,0:19:55.44,0:19:59.15,s8,,0,0,0,,凪を治せる\N“とびきりの殺意”の持ち主が―
Dialogue: 0,0:19:59.24,0:20:00.82,s8,,0,0,0,,誰なのかなんて
Dialogue: 0,0:20:02.53,0:20:04.37,s8,,0,0,0,,分かっていたけど…
Dialogue: 0,0:20:05.07,0:20:08.58,s8,,0,0,0,,恐ろしくて 目を背けてきたんだ
Dialogue: 0,0:20:15.92,0:20:18.50,Default,,0,0,0,,（鳥の鳴き声）
Dialogue: 0,0:20:18.59,0:20:20.17,Default,,0,0,0,,（先生）いい子
Dialogue: 0,0:20:21.76,0:20:24.22,Default,,0,0,0,,いい子
Dialogue: 0,0:20:24.30,0:20:25.55,Default,,0,0,0,,（鰐口理介わにぐちりすけ）先生
Dialogue: 0,0:20:26.30,0:20:30.39,Default,,0,0,0,,鬼城グイチェンの任務に出た黒坂から\N暗号電報です
Dialogue: 0,0:20:32.02,0:20:32.98,Default,,0,0,0,,（先生）うん
Dialogue: 0,0:20:33.60,0:20:35.40,Default,,0,0,0,,（鳥の鳴き声）
Dialogue: 0,0:20:35.48,0:20:39.11,Default,,0,0,0,,“侘平たひら 凪を発見した”と
Dialogue: 0,0:20:43.36,0:20:47.91,Default,,0,0,0,,（鳥のうめき声）
Dialogue: 0,0:20:47.99,0:20:50.75,Default,,0,0,0,,（先生）あ… いけない
Dialogue: 0,0:20:54.25,0:20:58.38,Default,,0,0,0,,つい 漏れ… ちゃった
Dialogue: 0,0:21:01.84,0:21:02.80,Default,,0,0,0,,（静）でも…
Dialogue: 0,0:21:03.93,0:21:06.76,s8,,0,0,0,,向き合わなきゃいけないときが\N来たんだ
Dialogue: 0,0:21:07.89,0:21:10.97,s8,,0,0,0,,一度は 命からがら逃げ出した―
Dialogue: 0,0:21:11.47,0:21:15.44,s8,,0,0,0,,あの“究極の殺し屋”と
Dialogue: 0,0:21:19.11,0:21:20.19,Default,,0,0,0,,行こ
Dialogue: 0,0:21:22.57,0:21:23.70,Default,,0,0,0,,あ…
Dialogue: 0,0:21:29.74,0:21:30.70,Default,,0,0,0,,ああ
Dialogue: 0,0:21:37.08,0:21:39.92,Default,,0,0,0,,（静）そういえば また片っぽだけ\Nなくなったんだよね
Dialogue: 0,0:21:40.00,0:21:41.59,Default,,0,0,0,,お気に入りの靴下
Dialogue: 0,0:21:41.67,0:21:43.51,Default,,0,0,0,,いつも どこに消えてるんだか…
Dialogue: 0,0:21:43.59,0:21:46.34,Default,,0,0,0,,（凪）部屋が汚いから\N物がなくなるんだよ
Dialogue: 0,0:21:46.43,0:21:47.80,Default,,0,0,0,,ふだんから整理整頓を…
Dialogue: 0,0:21:47.89,0:21:48.89,Default,,0,0,0,,（静）失礼な
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0,0,0,,私には どこに何があるか\N分かってるの！
Dialogue: 0,0:21:51.72,0:21:53.89,Default,,0,0,0,,（凪）\Nいや なくなってるじゃん　靴下
Dialogue: 0,0:21:53.98,0:21:54.81,Default,,0,0,0,,（静）うっ…
Dialogue: 0,0:22:00.77,0:22:01.52,Default,,0,0,0,,えい！
Dialogue: 0,0:22:01.61,0:22:02.86,Default,,0,0,0,,（凪）いった！
Dialogue: 0,0:22:08.57,0:22:09.78,Default,,0,0,0,,（先生）凪君…
Dialogue: 0,0:22:13.70,0:22:15.16,Default,,0,0,0,,（先生）また…
Dialogue: 0,0:22:17.08,0:22:19.83,Default,,0,0,0,,会い… たいな
Dialogue: 0,0:22:26.84,0:22:28.84,Default,,0,0,0,,♪～
Dialogue: 0,0:23:53.59,0:23:55.60,Default,,0,0,0,,～♪