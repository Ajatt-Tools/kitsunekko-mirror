Dialogue: 0,0:00:01.48,0:00:02.90,Dial_JP,,0,0,0,,いってきまーす
Dialogue: 0,0:00:06.57,0:00:08.70,Dial_JP,,0,0,0,,私　鈴木みゆ
Dialogue: 0,0:00:08.70,0:00:10.78,Dial_JP,,0,0,0,,高校２年生の16歳
Dialogue: 0,0:00:14.53,0:00:16.56,Dial_JP,,0,0,0,,悠介くん　おはよう
Dialogue: 0,0:00:17.24,0:00:19.04,Dial_JP,,0,0,0,,おはよう　みゆ
Dialogue: 0,0:00:21.14,0:00:25.92,Dial_JP,,0,0,0,,半年前　片思いしていた隣の席の谷くんに告白して
Dialogue: 0,0:00:25.92,0:00:27.92,Dial_JP,,0,0,0,,おつきあいすることになりました
Dialogue: 0,0:00:30.43,0:00:31.62,Dial_JP,,0,0,0,,はよ
Dialogue: 0,0:00:31.62,0:00:32.31,Dial_JP,,0,0,0,,おはよ
Dialogue: 0,0:00:32.84,0:00:34.18,Dial_JP,,0,0,0,,ナベサト　おはよう
Dialogue: 0,0:00:34.48,0:00:35.90,Dial_JP,,0,0,0,,タイラズマ　はよ
Dialogue: 0,0:00:36.57,0:00:38.22,Dial_JP,,0,0,0,,二人　朝から一緒
Dialogue: 0,0:00:40.63,0:00:41.73,Dial_JP,,0,0,0,,はよっす
Dialogue: 0,0:00:42.25,0:00:43.82,Dial_JP,,0,0,0,,よございます
Dialogue: 0,0:00:45.15,0:00:45.85,Dial_JP,,0,0,0,,おはよ
Dialogue: 0,0:00:47.19,0:00:51.76,Dial_JP,,0,0,0,,学校のみんなと騒がしくも楽しい日々を満喫中
Dialogue: 0,0:00:52.97,0:00:54.20,Dial_JP,,0,0,0,,でも　ちょっと…
Dialogue: 0,0:00:55.64,0:00:57.20,Dial_JP,,0,0,0,,ほんの少しだけ…
Dialogue: 0,0:00:57.85,0:00:59.71,Dial_JP,,0,0,0,,彼氏彼女っぽいイベントに
Dialogue: 0,0:01:00.87,0:01:02.79,Dial_JP,,0,0,0,,期待しちゃうお年頃
Dialogue: 0,0:02:34.51,0:02:38.76,Dial_JP,,0,0,0,,たいっくかん
Dialogue: 0,0:02:39.72,0:02:41.52,Dial_JP,,0,0,0,,なんか撮影してる
Dialogue: 0,0:02:41.52,0:02:42.70,Dial_JP,,0,0,0,,三年生？
Dialogue: 0,0:02:42.70,0:02:45.02,Dial_JP,,0,0,0,,思い出づくり的な感じかな
Dialogue: 0,0:02:45.02,0:02:47.99,Dial_JP,,0,0,0,,あれ　なんか私らも写っちゃいそうじゃない
Dialogue: 0,0:02:48.27,0:02:52.53,Dial_JP,,0,0,0,,私　知らない人のSNSに\N無加工写真載るのNGなんだけど
Dialogue: 0,0:02:54.28,0:02:57.03,Dial_JP,,0,0,0,,はーい　今後輩女子が歩いてまーす
Dialogue: 0,0:02:57.37,0:02:59.91,Dial_JP,,0,0,0,,バカ　悪いわ　お前
Dialogue: 0,0:03:00.13,0:03:01.74,Dial_JP,,0,0,0,,はい　イエイ
Dialogue: 0,0:03:01.74,0:03:02.50,Dial_JP,,0,0,0,,イエイ
Dialogue: 0,0:03:03.89,0:03:04.97,Dial_JP,,0,0,0,,ノリいいねえ
Dialogue: 0,0:03:04.97,0:03:06.83,Dial_JP,,0,0,0,,こら　東　行くよ
Dialogue: 0,0:03:07.17,0:03:09.86,Dial_JP,,0,0,0,,アズ　あの先輩たち　友達
Dialogue: 0,0:03:09.86,0:03:10.90,Dial_JP,,0,0,0,,いや　知らん
Dialogue: 0,0:03:10.90,0:03:11.84,Dial_JP,,0,0,0,,誰　あれ
Dialogue: 0,0:03:11.84,0:03:12.51,Dial_JP,,0,0,0,,おい
Dialogue: 0,0:03:13.42,0:03:15.87,Dial_JP,,0,0,0,,さっきみたいなノリと絡み方
Dialogue: 0,0:03:15.87,0:03:18.43,Dial_JP,,0,0,0,,兄ちゃんのツレを思い出すんだよなあ
Dialogue: 0,0:03:18.63,0:03:20.76,Dial_JP,,0,0,0,,けど　ああいうノリ　結構好き
Dialogue: 0,0:03:21.97,0:03:22.93,Dial_JP,,0,0,0,,マジか
Dialogue: 0,0:03:22.93,0:03:27.31,Dial_JP,,0,0,0,,アズ　あれは自分に\N話しかけられてるっぽく感じるけど
Dialogue: 0,0:03:27.31,0:03:31.07,Dial_JP,,0,0,0,,どちらかといえば\N仲間同士のウケ狙いでやってるやつだよ
Dialogue: 0,0:03:32.23,0:03:36.30,Dial_JP,,0,0,0,,なんか　バカやってて楽しそうで\Nいいなって思っちゃったけどなあ
Dialogue: 0,0:03:36.30,0:03:38.03,Dial_JP,,0,0,0,,懐でけえ
Dialogue: 0,0:03:45.57,0:03:47.87,Dial_JP,,0,0,0,,うわっ　すっごいサーブ
Dialogue: 0,0:03:47.87,0:03:49.32,Dial_JP,,0,0,0,,今のすごかったね
Dialogue: 0,0:03:53.15,0:03:54.00,Dial_JP,,0,0,0,,っと…
Dialogue: 0,0:03:54.00,0:03:55.00,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:03:55.00,0:03:56.19,Dial_JP,,0,0,0,,そうだね
Dialogue: 0,0:04:01.58,0:04:02.43,Dial_JP,,0,0,0,,あれれ
Dialogue: 0,0:04:03.70,0:04:04.58,Dial_JP,,0,0,0,,挟まった
Dialogue: 0,0:04:06.11,0:04:07.83,Dial_JP,,0,0,0,,ボール取り大臣
Dialogue: 0,0:04:07.83,0:04:08.56,Dial_JP,,0,0,0,,あいよ
Dialogue: 0,0:04:10.57,0:04:12.02,Dial_JP,,0,0,0,,あるあるだ
Dialogue: 0,0:04:12.92,0:04:15.40,Dial_JP,,0,0,0,,っていうか　今７組対７組じゃん
Dialogue: 0,0:04:15.40,0:04:17.41,Dial_JP,,0,0,0,,ねえ　これ今どっちが勝ってんの
Dialogue: 0,0:04:20.40,0:04:20.93,Dial_JP,,0,0,0,,どっち
Dialogue: 0,0:04:21.90,0:04:23.27,Dial_JP,,0,0,0,,お前　答えろよ
Dialogue: 0,0:04:23.27,0:04:24.32,Dial_JP,,0,0,0,,お前が答えろよ
Dialogue: 0,0:04:24.32,0:04:26.28,Dial_JP,,0,500,0,,いやいや　俺話したことないし
Dialogue: 0,0:04:25.33,0:04:26.28,Dial_JP,,800,0,0,,俺もないって
Dialogue: 0,0:04:28.32,0:04:29.53,Dial_JP,,0,0,0,,じれったい
Dialogue: 0,0:04:34.17,0:04:37.41,Dial_JP,,0,0,0,,体育のあとの食堂コロッケ　最高
Dialogue: 0,0:04:37.41,0:04:38.42,Dial_JP,,0,0,0,,うまあ
Dialogue: 0,0:04:38.87,0:04:41.76,Dial_JP,,0,0,0,,ねえ　アズなんか最近いいことあった
Dialogue: 0,0:04:41.76,0:04:42.68,Dial_JP,,0,0,0,,なんで
Dialogue: 0,0:04:42.68,0:04:44.80,Dial_JP,,0,0,0,,なんか　最近元気じゃん
Dialogue: 0,0:04:44.80,0:04:47.73,Dial_JP,,0,0,0,,今まで不健康だったみたいな言い方
Dialogue: 0,0:04:47.73,0:04:49.00,Dial_JP,,0,0,0,,彼氏か
Dialogue: 0,0:04:49.00,0:04:50.10,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:04:50.70,0:04:53.43,Dial_JP,,0,0,0,,夏休みあたりちょっと怪しかったけど
Dialogue: 0,0:04:53.43,0:04:55.97,Dial_JP,,0,0,0,,結局それはどうにもならなくて
Dialogue: 0,0:04:55.97,0:04:57.69,Dial_JP,,0,0,0,,それっきりなんもないかなあ
Dialogue: 0,0:04:58.07,0:05:00.62,Dial_JP,,0,0,0,,そのひと夏の恋知らんのやが
Dialogue: 0,0:05:00.62,0:05:01.99,Dial_JP,,0,0,0,,言う前に終わった
Dialogue: 0,0:05:02.65,0:05:05.16,Dial_JP,,0,0,0,,もう変な連絡返事したりしてない
Dialogue: 0,0:05:05.70,0:05:07.58,Dial_JP,,0,0,0,,「なんで一回許しちゃうの」
Dialogue: 0,0:05:08.10,0:05:10.08,Dial_JP,,0,0,0,,「東だけがすり減ってんじゃん」
Dialogue: 0,0:05:12.04,0:05:12.67,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:05:13.08,0:05:15.40,Dial_JP,,0,0,0,,雑な連絡はスルーしてる
Dialogue: 0,0:05:15.40,0:05:16.46,Dial_JP,,0,0,0,,うん　偉い
Dialogue: 0,0:05:16.46,0:05:19.34,Dial_JP,,0,0,0,,スルーよりもブロックだよ　ブロック　ブロック
Dialogue: 0,0:05:19.34,0:05:21.61,Dial_JP,,0,0,0,,ブロックでたたき割ろう
Dialogue: 0,0:05:21.61,0:05:22.57,Dial_JP,,0,0,0,,物理？
Dialogue: 0,0:05:22.84,0:05:26.34,Dial_JP,,0,0,0,,東　前にクズな男ばっか好きになるとか言ってたから
Dialogue: 0,0:05:26.34,0:05:28.10,Dial_JP,,0,0,0,,いろいろ心配だよ
Dialogue: 0,0:05:29.30,0:05:32.61,Dial_JP,,0,0,0,,ねっ　なんでだろうね　不思議
Dialogue: 0,0:05:32.61,0:05:34.50,Dial_JP,,0,0,0,,なんで若干ひと事なの
Dialogue: 0,0:05:34.50,0:05:36.44,Dial_JP,,0,0,0,,なーに食ってんの
Dialogue: 0,0:05:36.44,0:05:38.36,Dial_JP,,0,0,0,,おい　やめとけって
Dialogue: 0,0:05:38.70,0:05:40.30,Dial_JP,,0,0,0,,さっきの３年生だ
Dialogue: 0,0:05:40.30,0:05:41.44,Dial_JP,,0,0,0,,コロッケ
Dialogue: 0,0:05:41.44,0:05:42.61,Dial_JP,,0,0,0,,ちょっ　アズ
Dialogue: 0,0:05:42.61,0:05:43.95,Dial_JP,,0,0,0,,ちょうだい
Dialogue: 0,0:05:43.95,0:05:45.20,Dial_JP,,0,0,0,,あげない
Dialogue: 0,0:05:45.51,0:05:47.26,Dial_JP,,0,0,0,,バカだ　こいつ
Dialogue: 0,0:05:48.18,0:05:49.37,Dial_JP,,0,0,0,,いいじゃねえか
Dialogue: 0,0:05:49.37,0:05:51.92,Dial_JP,,0,0,0,,適当に乗って　流しときゃよくない
Dialogue: 0,0:05:51.92,0:05:53.98,Dial_JP,,0,0,0,,スルーした方がいいって
Dialogue: 0,0:05:53.98,0:05:55.88,Dial_JP,,0,0,0,,受験　落ちそう
Dialogue: 0,0:05:56.22,0:06:00.55,Dial_JP,,0,0,0,,けど　露骨に嫌な顔されるよりかは正直
Dialogue: 0,0:06:00.55,0:06:02.63,Dial_JP,,0,0,0,,ああいうノリの方が楽かもしれん
Dialogue: 0,0:06:03.34,0:06:05.39,Dial_JP,,0,0,0,,さっきの気にしてたんか
Dialogue: 0,0:06:05.78,0:06:09.81,Dial_JP,,0,0,0,,あれはまあ　急に\N話しかけられて戸惑ってたんだと思うよ
Dialogue: 0,0:06:09.81,0:06:12.02,Dial_JP,,0,0,0,,ほぼしゃべったことない子たちだったでしょ
Dialogue: 0,0:06:12.31,0:06:14.48,Dial_JP,,0,0,0,,みんながみんなこんな感じじゃないよ
Dialogue: 0,0:06:15.40,0:06:16.24,Dial_JP,,0,0,0,,分かった
Dialogue: 0,0:06:16.24,0:06:17.27,Dial_JP,,0,0,0,,何が
Dialogue: 0,0:06:17.84,0:06:20.49,Dial_JP,,0,0,0,,東がクズ男に引っ掛かる理由
Dialogue: 0,0:06:21.53,0:06:23.03,Dial_JP,,0,0,0,,「初速」だ
Dialogue: 0,0:06:24.28,0:06:28.56,Dial_JP,,0,0,0,,こう　慎重な人が\Nふだん人と仲よくなるまでの道のりを
Dialogue: 0,0:06:28.56,0:06:31.12,Dial_JP,,0,0,0,,じっくり　じっくり進むとしたら
Dialogue: 0,0:06:31.12,0:06:34.96,Dial_JP,,0,0,0,,さっきの先輩みたいに「ギャン」\Nと発進してくる人もいるじゃん
Dialogue: 0,0:06:34.96,0:06:36.04,Dial_JP,,0,0,0,,「ギャン」
Dialogue: 0,0:06:36.04,0:06:40.79,Dial_JP,,0,0,0,,東はその「ギャン」\Nてくる人がきても怒らずに受け入れてきたから
Dialogue: 0,0:06:40.79,0:06:42.55,Dial_JP,,0,0,0,,そっちが普通になっちゃってるんだよ
Dialogue: 0,0:06:43.00,0:06:45.34,Dial_JP,,0,0,0,,「雑に扱われてんだから　ちゃんと怒れよ」
Dialogue: 0,0:06:48.84,0:06:51.81,Dial_JP,,0,0,0,,つまり　なまじノリがよくて寛容なばかりに
Dialogue: 0,0:06:51.81,0:06:55.01,Dial_JP,,0,0,0,,慎重な速度の人がじれったく感じるのか
Dialogue: 0,0:06:55.01,0:06:56.69,Dial_JP,,0,0,0,,比喩の飲み込み　早っ
Dialogue: 0,0:06:57.13,0:06:58.30,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:06:59.21,0:07:01.19,Dial_JP,,0,0,0,,いや　そうなのかな
Dialogue: 0,0:07:02.16,0:07:05.41,Dial_JP,,0,0,0,,「第一印象『あっ』ってなる人　みんなクズ」
Dialogue: 0,0:07:06.18,0:07:09.60,Dial_JP,,0,0,0,,「誠実な男からうまみを感じられないんだよね」
Dialogue: 0,0:07:10.68,0:07:11.97,Dial_JP,,0,0,0,,そうなのかも
Dialogue: 0,0:07:12.45,0:07:13.93,Dial_JP,,0,0,0,,だから　つまり
Dialogue: 0,0:07:13.93,0:07:17.09,Dial_JP,,0,0,0,,ずっとローギアのままだと長距離は厳しいように
Dialogue: 0,0:07:17.09,0:07:20.91,Dial_JP,,0,0,0,,初速だけが異様に速い人とは\N長く続かないことが多いから
Dialogue: 0,0:07:20.91,0:07:22.09,Dial_JP,,0,0,0,,気をつけたいよね
Dialogue: 0,0:07:22.73,0:07:23.84,Dial_JP,,0,0,0,,蛇足
Dialogue: 0,0:07:23.84,0:07:25.17,Dial_JP,,0,0,0,,逆に分かりにくいわ
Dialogue: 0,0:07:25.80,0:07:26.83,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:07:26.83,0:07:30.26,Dial_JP,,0,0,0,,なんか「うまいこと言った\N感じにしたい欲」が出てしまった
Dialogue: 0,0:07:35.02,0:07:37.27,Dial_JP,,0,0,0,,みんな　ちゃんとしてるな
Dialogue: 0,0:07:39.44,0:07:43.57,Dial_JP,,0,0,0,,ちゃんと考えて　少しずつ人と歩み寄って
Dialogue: 0,0:07:43.57,0:07:45.40,Dial_JP,,0,0,0,,そうしてったら　私も…
Dialogue: 0,0:07:46.33,0:07:48.70,Dial_JP,,0,0,0,,鈴木みたいな恋愛できるかな
Dialogue: 0,0:07:53.82,0:07:55.33,Dial_JP,,0,0,0,,いやいやいや
Dialogue: 0,0:07:57.12,0:08:00.50,Dial_JP,,0,0,0,,こいつ　谷くんにフルスロットルで\Nだる絡みしてたから
Dialogue: 0,0:08:00.50,0:08:01.50,Dial_JP,,0,0,0,,はい？
Dialogue: 0,0:08:01.70,0:08:03.55,Dial_JP,,0,0,0,,いつ　つっこもうか迷ったわ
Dialogue: 0,0:08:03.55,0:08:04.67,Dial_JP,,0,0,0,,ダメじゃん
Dialogue: 0,0:08:04.67,0:08:07.87,Dial_JP,,0,0,0,,今は…今は丁寧に闊歩してるから
Dialogue: 0,0:08:07.87,0:08:08.87,Dial_JP,,0,0,0,,ほう
Dialogue: 0,0:08:08.87,0:08:10.33,Dial_JP,,0,0,0,,ほんとだって
Dialogue: 0,0:08:13.88,0:08:14.92,Dial_JP,,0,0,0,,じゃあ　いよいよ　気になる
Dialogue: 0,0:08:14.92,0:08:16.27,Dial_JP,,0,0,0,,なんか　ダベっとる
Dialogue: 0,0:08:16.27,0:08:19.02,Dial_JP,,0,0,0,,谷って　いつ鈴木のこと好きになったんだろうね
Dialogue: 0,0:08:22.01,0:08:23.64,Dial_JP,,0,0,0,,確かに気になる
Dialogue: 0,0:08:23.64,0:08:25.26,Dial_JP,,0,0,0,,おい　答えてやれよ
Dialogue: 0,0:08:25.26,0:08:26.22,Dial_JP,,0,0,0,,なんなの
Dialogue: 0,0:08:26.22,0:08:27.70,Dial_JP,,0,0,0,,やめなって
Dialogue: 0,0:08:28.15,0:08:30.01,Dial_JP,,0,0,0,,いつか　個人的に聞きたい
Dialogue: 0,0:08:31.76,0:08:33.55,Dial_JP,,0,0,0,,時は12月
Dialogue: 0,0:08:33.55,0:08:35.75,Dial_JP,,0,0,0,,街はにぎやか　お祭り騒ぎ
Dialogue: 0,0:08:36.31,0:08:39.04,Dial_JP,,0,0,0,,道を歩けばクリスマスソングとぶつかる
Dialogue: 0,0:08:39.04,0:08:41.36,Dial_JP,,0,0,0,,そんな世間が浮かれモードななか
Dialogue: 0,0:08:41.36,0:08:44.34,Dial_JP,,0,0,0,,学期末のあれこれと終業式を終え
Dialogue: 0,0:08:46.07,0:08:49.00,Dial_JP,,0,0,0,,冬休みには　あまり時間がありません
Dialogue: 0,0:08:49.00,0:08:53.22,Dial_JP,,0,0,0,,油断していると　あっという間に\N時間は過ぎてゆくものです
Dialogue: 0,0:08:53.22,0:08:55.06,Dial_JP,,0,0,0,,そもそも　冬休みという…
Dialogue: 0,0:08:55.06,0:08:56.43,Dial_JP,,0,0,0,,お疲れ
Dialogue: 0,0:08:58.30,0:09:01.76,Dial_JP,,0,0,0,,鈴木たちもまた　浮かれモードなのでした
Dialogue: 0,0:09:04.29,0:09:06.97,Dial_JP,,0,0,0,,７組　麦わらの一味みたいな宴してんじゃん
Dialogue: 0,0:09:06.97,0:09:07.57,Dial_JP,,0,0,0,,怖っ
Dialogue: 0,0:09:19.08,0:09:20.10,Dial_JP,,0,0,0,,チキン　食う
Dialogue: 0,0:09:20.10,0:09:21.25,Dial_JP,,0,0,0,,どんな勧誘よ
Dialogue: 0,0:09:22.21,0:09:25.84,Dial_JP,,0,0,0,,そんな　手ネチョネチョになる\Nものいきなり出されても無理だって
Dialogue: 0,0:09:25.84,0:09:28.05,Dial_JP,,0,0,0,,学期末の荷物量　なめんな
Dialogue: 0,0:09:30.37,0:09:31.66,Dial_JP,,0,0,0,,二人　もう帰んの
Dialogue: 0,0:09:31.66,0:09:32.43,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:09:32.43,0:09:34.98,Dial_JP,,0,0,0,,じゃあ　次会うときは来年か
Dialogue: 0,0:09:36.68,0:09:38.09,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:09:38.09,0:09:42.06,Dial_JP,,0,0,0,,そう聞くと　次学校来るときがすごく遠く感じる
Dialogue: 0,0:09:42.70,0:09:44.18,Dial_JP,,0,0,0,,じゃあ　また来年
Dialogue: 0,0:09:44.18,0:09:45.64,Dial_JP,,0,0,0,,よいお年を
Dialogue: 0,0:09:45.64,0:09:47.16,Dial_JP,,0,0,0,,よいお年を
Dialogue: 0,0:09:52.47,0:09:54.32,Dial_JP,,0,0,0,,これで　今年最後
Dialogue: 0,0:10:04.75,0:10:07.23,Dial_JP,,0,0,0,,みんな　冬休み何してんの
Dialogue: 0,0:10:07.23,0:10:09.71,Dial_JP,,0,0,0,,うちはいつも年末年始はばあちゃん家
Dialogue: 0,0:10:09.71,0:10:13.10,Dial_JP,,0,0,0,,じゃあ　正月初詣とか　一緒に行けないのかあ
Dialogue: 0,0:10:13.10,0:10:14.73,Dial_JP,,0,0,0,,ねえねえ　山田マン
Dialogue: 0,0:10:15.26,0:10:17.68,Dial_JP,,0,0,0,,24と25日って　ピザ頼んだら
Dialogue: 0,0:10:17.68,0:10:20.10,Dial_JP,,0,0,0,,山田サンタが届けてくれんの
Dialogue: 0,0:10:20.10,0:10:23.93,Dial_JP,,0,0,0,,まあ　シフト両方入ってっから\Nその可能性はあるけど
Dialogue: 0,0:10:23.93,0:10:25.72,Dial_JP,,0,0,0,,山田　バイト　ピザ屋なんだ
Dialogue: 0,0:10:25.72,0:10:26.52,Dial_JP,,0,0,0,,おうよ
Dialogue: 0,0:10:26.52,0:10:29.48,Dial_JP,,0,0,0,,っておま　もし頼んできたら　さすがに怒るぞ
Dialogue: 0,0:10:29.48,0:10:31.68,Dial_JP,,0,0,0,,クリスマスのえぐさ　やべえから
Dialogue: 0,0:10:33.28,0:10:36.44,Dial_JP,,0,0,0,,ってことは　クリスマスはデートじゃないのか
Dialogue: 0,0:10:36.44,0:10:38.59,Dial_JP,,0,0,0,,クリスマス　家で過ごすの
Dialogue: 0,0:10:38.59,0:10:41.04,Dial_JP,,0,0,0,,いや　別にそう決まったわけでは
Dialogue: 0,0:10:41.43,0:10:42.73,Dial_JP,,0,0,0,,けど　ありかも
Dialogue: 0,0:10:42.73,0:10:45.50,Dial_JP,,0,0,0,,川崎におすすめのケーキのレシピ聞いとこか
Dialogue: 0,0:10:45.50,0:10:47.00,Dial_JP,,0,0,0,,Cookカワサキ
Dialogue: 0,0:10:47.79,0:10:48.92,Dial_JP,,0,0,0,,バイバイ
Dialogue: 0,0:10:48.92,0:10:50.80,Dial_JP,,0,0,0,,よいお年を
Dialogue: 0,0:10:51.42,0:10:53.72,Dial_JP,,0,0,0,,クリスマス　なんかすんの
Dialogue: 0,0:10:57.12,0:10:58.65,Dial_JP,,0,0,0,,何がいいと思う
Dialogue: 0,0:10:58.65,0:10:59.93,Dial_JP,,0,0,0,,俺に聞くな
Dialogue: 0,0:11:00.27,0:11:04.98,Dial_JP,,0,0,0,,んな悩まんでも　ケーキ食って\Nプレゼント交換しときゃ十分だろ
Dialogue: 0,0:11:04.98,0:11:06.94,Dial_JP,,0,0,0,,いや　小学生すぎるか
Dialogue: 0,0:11:07.37,0:11:08.35,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:11:08.35,0:11:10.69,Dial_JP,,0,0,0,,そんなに俺を過信するな
Dialogue: 0,0:11:13.03,0:11:14.20,Dial_JP,,0,0,0,,っていうか　俺
Dialogue: 0,0:11:14.83,0:11:16.82,Dial_JP,,0,0,0,,冬休み　バイトしか予定ねえ
Dialogue: 0,0:11:17.45,0:11:20.51,Dial_JP,,0,0,0,,しかも　そんなシフト詰まってねえし
Dialogue: 0,0:11:20.51,0:11:22.37,Dial_JP,,0,0,0,,ゲームしかすることねえな
Dialogue: 0,0:11:23.04,0:11:24.96,Dial_JP,,0,0,0,,まっ　それはそれでいいか
Dialogue: 0,0:11:24.96,0:11:27.54,Dial_JP,,0,0,0,,つーかさ　冬休み暇なヤツ
Dialogue: 0,0:11:27.54,0:11:29.84,Dial_JP,,0,0,0,,予定合わせて　みんなで遊ぼうぜ
Dialogue: 0,0:11:32.59,0:11:36.09,Dial_JP,,0,0,0,,私は年末年始県外にいるというのに
Dialogue: 0,0:11:36.09,0:11:37.85,Dial_JP,,0,0,0,,それはもうしゃあねえだろ
Dialogue: 0,0:11:38.54,0:11:41.60,Dial_JP,,0,0,0,,よし　じゃあ　このあと帰宅部全員散歩しよう
Dialogue: 0,0:11:41.60,0:11:42.47,Dial_JP,,0,0,0,,急に
Dialogue: 0,0:11:42.47,0:11:43.26,Dial_JP,,0,0,0,,なんでだよ
Dialogue: 0,0:11:43.26,0:11:45.10,Dial_JP,,0,0,0,,まだ遊びたいから
Dialogue: 0,0:11:45.10,0:11:48.34,Dial_JP,,0,0,0,,山の上の高級住宅街　眺めに行くよ
Dialogue: 0,0:11:48.34,0:11:50.31,Dial_JP,,0,0,0,,なんだよ　その謎アクティビティー
Dialogue: 0,0:11:50.31,0:11:52.10,Dial_JP,,0,0,0,,俺　このあとバイトだわ
Dialogue: 0,0:11:52.10,0:11:53.64,Dial_JP,,0,0,0,,私らも部活
Dialogue: 0,0:12:03.12,0:12:04.75,Dial_JP,,0,0,0,,こっち　こっち
Dialogue: 0,0:12:04.75,0:12:07.83,Dial_JP,,0,0,0,,なんか集団下校みたいで　楽しい
Dialogue: 0,0:12:08.33,0:12:09.63,Dial_JP,,0,0,0,,若返る
Dialogue: 0,0:12:09.63,0:12:10.57,Dial_JP,,0,0,0,,若いだろ
Dialogue: 0,0:12:10.57,0:12:13.05,Dial_JP,,0,0,0,,遅れて来た学童期　東
Dialogue: 0,0:12:13.86,0:12:14.47,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:12:20.61,0:12:21.57,Dial_JP,,0,0,0,,すげえ
Dialogue: 0,0:12:21.57,0:12:23.80,Dial_JP,,0,0,0,,いや　普通にいいスポットなんかい
Dialogue: 0,0:12:23.80,0:12:25.22,Dial_JP,,0,0,0,,毎年　すごいんだよ
Dialogue: 0,0:12:25.22,0:12:26.77,Dial_JP,,0,0,0,,通称　家ナリエ
Dialogue: 0,0:12:35.14,0:12:36.58,Dial_JP,,0,0,0,,そういえば　俺
Dialogue: 0,0:12:36.58,0:12:40.16,Dial_JP,,0,0,0,,今年　こういうクリスマススポット的なん来たん　初めてだわ
Dialogue: 0,0:12:40.47,0:12:41.75,Dial_JP,,0,0,0,,私も
Dialogue: 0,0:12:41.75,0:12:43.66,Dial_JP,,0,0,0,,めっちゃ個人宅だけどね
Dialogue: 0,0:12:44.10,0:12:44.79,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:12:46.48,0:12:49.71,Dial_JP,,0,0,0,,中華街近くのクリスマスマーケットは行かなかったの
Dialogue: 0,0:12:52.05,0:12:54.40,Dial_JP,,0,0,0,,おま　見てし…
Dialogue: 0,0:12:54.40,0:12:56.97,Dial_JP,,0,0,0,,安心して　まだ私しか知らないから
Dialogue: 0,0:12:58.37,0:13:02.47,Dial_JP,,0,0,0,,てめえと違って　みんなの前で\N野暮な質問はしねえからよ
Dialogue: 0,0:13:02.47,0:13:03.97,Dial_JP,,0,0,0,,ごめんって
Dialogue: 0,0:13:04.33,0:13:05.92,Dial_JP,,0,0,0,,冗談　冗談
Dialogue: 0,0:13:05.92,0:13:07.45,Dial_JP,,0,0,0,,進展あったら教えてね
Dialogue: 0,0:13:07.45,0:13:09.53,Dial_JP,,0,0,0,,いや　まだそんなんじゃ
Dialogue: 0,0:13:09.53,0:13:12.54,Dial_JP,,0,0,0,,ダブルデート的なことできたら　楽しそうじゃない
Dialogue: 0,0:13:12.54,0:13:13.68,Dial_JP,,0,0,0,,やめろ
Dialogue: 0,0:13:13.98,0:13:17.18,Dial_JP,,0,0,0,,楽しそうすぎて　えぐいにやける
Dialogue: 0,0:13:21.24,0:13:22.57,Dial_JP,,0,0,0,,じゃあね
Dialogue: 0,0:13:22.99,0:13:24.70,Dial_JP,,0,0,0,,よいお年を
Dialogue: 0,0:13:26.85,0:13:28.50,Dial_JP,,0,0,0,,これはまた…
Dialogue: 0,0:13:28.91,0:13:30.77,Dial_JP,,0,0,0,,やっぱこうなるよな
Dialogue: 0,0:13:32.05,0:13:33.52,Dial_JP,,0,0,0,,楽しかった
Dialogue: 0,0:13:33.52,0:13:35.38,Dial_JP,,0,0,0,,こういうこともっとしたいな
Dialogue: 0,0:13:36.20,0:13:38.54,Dial_JP,,0,0,0,,いや　別にいいんだけど
Dialogue: 0,0:13:38.54,0:13:41.63,Dial_JP,,0,0,0,,こいつは俺と二人でいるとこ見られんの平気なんか
Dialogue: 0,0:13:41.97,0:13:44.84,Dial_JP,,0,0,0,,まっ　でも　周りの目とか悪意とか
Dialogue: 0,0:13:44.84,0:13:46.76,Dial_JP,,0,0,0,,いちいち気にしなそうだもんな
Dialogue: 0,0:13:47.35,0:13:48.87,Dial_JP,,0,0,0,,俺とは違って
Dialogue: 0,0:13:55.69,0:13:56.38,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:13:57.40,0:14:00.14,Dial_JP,,0,0,0,,俺　ちょっと　本屋寄ってから帰るわ
Dialogue: 0,0:14:00.95,0:14:01.65,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:14:06.33,0:14:07.62,Dial_JP,,0,0,0,,これって…
Dialogue: 0,0:14:10.76,0:14:11.86,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:14:14.42,0:14:17.25,Dial_JP,,0,0,0,,じゃあね　また来年かな
Dialogue: 0,0:14:20.42,0:14:24.09,Dial_JP,,0,0,0,,そういえば　今までもそういう節あったかも
Dialogue: 0,0:14:25.60,0:14:28.27,Dial_JP,,0,0,0,,たぶん　今バレてた
Dialogue: 0,0:14:29.15,0:14:32.81,Dial_JP,,0,0,0,,自分が拒絶される側だった\Nことは今までに何度もあるけど
Dialogue: 0,0:14:33.44,0:14:35.77,Dial_JP,,0,0,0,,なんで東がそっち側みたいな顔
Dialogue: 0,0:14:38.15,0:14:42.20,Dial_JP,,0,0,0,,結構　仲いい方だと思ってたんだけどなあ
Dialogue: 0,0:14:46.99,0:14:49.58,Dial_JP,,0,0,0,,なんで俺が拒絶した側になってんだ
Dialogue: 0,0:14:51.68,0:14:52.68,Dial_JP,,0,0,0,,やっぱ　なし
Dialogue: 0,0:14:55.48,0:14:57.59,Dial_JP,,0,0,0,,よく考えたら
Dialogue: 0,0:14:58.82,0:15:00.92,Dial_JP,,0,0,0,,別に今じゃなくていいし
Dialogue: 0,0:15:07.29,0:15:08.43,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:15:13.23,0:15:16.28,Dial_JP,,0,0,0,,一方　そのころ　鈴木と谷は…
Dialogue: 0,0:15:16.86,0:15:19.51,Dial_JP,,0,0,0,,どうする　もう帰る
Dialogue: 0,0:15:21.11,0:15:24.36,Dial_JP,,0,0,0,,あれ以降　妙にもじもじしていた
Dialogue: 0,0:15:27.10,0:15:29.26,Dial_JP,,600,0,0,,クリスマス　一緒に…
Dialogue: 0,0:15:28.68,0:15:30.87,Dial_JP,,0,600,0,,私　悠介くんと…
Dialogue: 0,0:15:30.87,0:15:33.19,Dial_JP,,600,0,0,,ケーキ　食べたい
Dialogue: 0,0:15:30.87,0:15:33.19,Dial_JP,,0,600,0,,ケーキ　作りたいです
Dialogue: 0,0:15:38.84,0:15:41.92,Dial_JP,,1200,0,0,,そんなこんなで\N冬休み突入です
Dialogue: 0,0:15:44.16,0:15:45.88,Dial_JP,,0,0,0,,お母さん
Dialogue: 0,0:15:46.12,0:15:49.39,Dial_JP,,0,0,0,,24日　谷くん　うちに上げていい
Dialogue: 0,0:15:49.39,0:15:53.28,Dial_JP,,0,0,0,,あら　私パートあるから\N夜ご飯ちゃんともてなせないよ
Dialogue: 0,0:15:53.28,0:15:56.06,Dial_JP,,0,0,0,,いや　昼に来て　夜までには帰るよ
Dialogue: 0,0:15:56.91,0:15:59.53,Dial_JP,,0,0,0,,みゆ　分かってると思うけど
Dialogue: 0,0:15:59.53,0:16:02.47,Dial_JP,,0,0,0,,誰もいないからって　はめを外すんじゃないよ
Dialogue: 0,0:16:03.74,0:16:07.55,Dial_JP,,0,0,0,,ほら　昔お兄ちゃんたちが\Nゲームのリモコン投げ飛ばして
Dialogue: 0,0:16:07.55,0:16:10.28,Dial_JP,,0,0,0,,陶器の猫ちゃん割ったときみたいな
Dialogue: 0,0:16:10.28,0:16:13.67,Dial_JP,,0,0,0,,ならないよ　一緒にケーキ作るだけだから
Dialogue: 0,0:16:13.67,0:16:16.06,Dial_JP,,0,0,0,,あら　すてき　楽しんで
Dialogue: 0,0:16:18.29,0:16:21.72,Dial_JP,,0,0,0,,クリスマス　家で二人きり
Dialogue: 0,0:16:21.72,0:16:23.99,Dial_JP,,0,0,0,,ときたら　これはもう…
Dialogue: 0,0:16:23.99,0:16:25.99,Dial_JP,,0,0,0,,これはさすがにもう…
Dialogue: 0,0:16:26.70,0:16:28.88,Dial_JP,,0,0,0,,ロマンティック展開　不可避
Dialogue: 0,0:16:33.04,0:16:35.90,Dial_JP,,0,0,0,,じゃあ　材料と道具　買ってこう
Dialogue: 0,0:16:38.31,0:16:40.83,Dial_JP,,0,0,0,,タルト型　いちばんでかいのにしちゃう
Dialogue: 0,0:16:40.83,0:16:42.48,Dial_JP,,0,0,0,,分量　変わっちゃうよ
Dialogue: 0,0:16:42.93,0:16:45.48,Dial_JP,,0,0,0,,せっかくだし　こういうの敷いて食べよう
Dialogue: 0,0:16:45.96,0:16:46.87,Dial_JP,,0,0,0,,これはどう
Dialogue: 0,0:16:47.76,0:16:48.36,Dial_JP,,0,0,0,,いい
Dialogue: 0,0:16:58.04,0:17:01.83,Dial_JP,,0,0,0,,なんか　一緒にスーパーで買い物してるのって
Dialogue: 0,0:17:01.83,0:17:03.72,Dial_JP,,0,0,0,,不思議な感じする
Dialogue: 0,0:17:03.72,0:17:04.46,Dial_JP,,0,0,0,,そう
Dialogue: 0,0:17:06.01,0:17:08.13,Dial_JP,,0,0,0,,一緒に暮らしてる人みたい
Dialogue: 0,0:17:10.10,0:17:12.35,Dial_JP,,0,0,0,,いいねえ　楽しい
Dialogue: 0,0:17:12.35,0:17:15.36,Dial_JP,,0,0,0,,いつか買い物袋から　ネギはみ出させたり
Dialogue: 0,0:17:15.36,0:17:18.85,Dial_JP,,0,0,0,,紙袋から　フランスパンはみ出させたりしてみたいなあ
Dialogue: 0,0:17:20.35,0:17:21.38,Dial_JP,,0,0,0,,なにそれ
Dialogue: 0,0:17:31.30,0:17:33.37,Dial_JP,,0,0,0,,冷蔵庫に入れるやつ
Dialogue: 0,0:17:34.40,0:17:35.86,Dial_JP,,0,0,0,,なんか　もう…
Dialogue: 0,0:17:36.37,0:17:39.50,Dial_JP,,0,0,0,,ビスケット潰してる谷くん　かわいい
Dialogue: 0,0:17:39.50,0:17:40.96,Dial_JP,,0,0,0,,冷やかさないで
Dialogue: 0,0:17:42.52,0:17:45.61,Dial_JP,,0,0,0,,じゃ　しばらくタルト生地固めまーす
Dialogue: 0,0:17:47.59,0:17:49.01,Dial_JP,,0,0,0,,どうしよう
Dialogue: 0,0:17:50.32,0:17:52.78,Dial_JP,,0,0,0,,幸せすぎる
Dialogue: 0,0:17:52.78,0:17:56.16,Dial_JP,,0,0,0,,もう　本当にこういうので十分かもしれない
Dialogue: 0,0:17:56.16,0:17:59.39,Dial_JP,,0,0,0,,変に意識し過ぎるから　邪念は一旦取り払おう
Dialogue: 0,0:18:00.20,0:18:01.70,Dial_JP,,0,0,0,,買ったご飯　温める
Dialogue: 0,0:18:07.78,0:18:09.41,Dial_JP,,0,0,0,,危なあ
Dialogue: 0,0:18:09.41,0:18:10.45,Dial_JP,,0,0,0,,ごめん　ごめん
Dialogue: 0,0:18:11.76,0:18:12.66,Dial_JP,,0,0,0,,なんか
Dialogue: 0,0:18:13.17,0:18:14.16,Dial_JP,,0,0,0,,なんか
Dialogue: 0,0:18:14.76,0:18:16.33,Dial_JP,,0,0,0,,前にも
Dialogue: 0,0:18:16.33,0:18:17.79,Dial_JP,,0,0,0,,こういうことあっ…
Dialogue: 0,0:18:33.89,0:18:36.14,Dial_JP,,0,0,0,,出来上がるまで２時間か
Dialogue: 0,0:18:36.66,0:18:39.14,Dial_JP,,0,0,0,,冷やす工程　時間かかるね
Dialogue: 0,0:18:41.15,0:18:44.69,Dial_JP,,0,0,0,,なんか　一瞬でよく分からなかったけど
Dialogue: 0,0:18:45.65,0:18:46.78,Dial_JP,,0,0,0,,キスした
Dialogue: 0,0:18:46.78,0:18:48.40,Dial_JP,,0,0,0,,してた　マジ
Dialogue: 0,0:18:49.21,0:18:50.27,Dial_JP,,0,0,0,,いやいや　待って
Dialogue: 0,0:18:50.27,0:18:54.22,Dial_JP,,0,0,0,,確かにプリンセス映画みたいなキスに\N憧れはあったけれども
Dialogue: 0,0:18:54.22,0:18:56.33,Dial_JP,,0,0,0,,まさか　こんな事故チューみたいな
Dialogue: 0,0:18:56.33,0:18:57.05,Dial_JP,,0,0,0,,みゆ
Dialogue: 0,0:18:57.05,0:19:00.04,Dial_JP,,0,0,0,,実は私の勘違いだったりして
Dialogue: 0,0:19:00.04,0:19:00.78,Dial_JP,,0,0,0,,みゆ
Dialogue: 0,0:19:01.87,0:19:02.42,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:19:06.50,0:19:08.24,Dial_JP,,0,0,0,,やり直そう
Dialogue: 0,0:19:08.24,0:19:10.17,Dial_JP,,0,0,0,,さっきのは…
Dialogue: 0,0:19:10.17,0:19:13.89,Dial_JP,,0,0,0,,違う　と思　から
Dialogue: 0,0:19:19.77,0:19:20.47,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:19:21.93,0:19:24.46,Dial_JP,,0,0,0,,けど　今　チキン食べたて
Dialogue: 0,0:19:24.46,0:19:26.26,Dial_JP,,0,0,0,,それは　僕も一緒だから
Dialogue: 0,0:19:27.51,0:19:28.44,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:19:44.21,0:19:45.27,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:19:45.27,0:19:47.13,Dial_JP,,0,0,0,,いや　こっちもごめん
Dialogue: 0,0:19:49.13,0:19:50.46,Dial_JP,,0,0,0,,ちょっと
Dialogue: 0,0:19:56.24,0:19:57.47,Dial_JP,,0,0,0,,なんの音
Dialogue: 0,0:19:57.47,0:20:01.22,Dial_JP,,0,0,0,,今日は夜まで誰も帰って来ないはずなのに
Dialogue: 0,0:20:03.98,0:20:06.00,Dial_JP,,0,0,0,,なんだ　兄ちゃんか
Dialogue: 0,0:20:06.00,0:20:07.48,Dial_JP,,0,0,0,,んだ　こら
Dialogue: 0,0:20:07.48,0:20:09.72,Dial_JP,,0,0,0,,何してんの　何帰宅
Dialogue: 0,0:20:09.72,0:20:11.48,Dial_JP,,0,0,0,,なんでもいいだろ　別に
Dialogue: 0,0:20:11.48,0:20:13.31,Dial_JP,,0,0,0,,今日　もうずっと家いるの
Dialogue: 0,0:20:14.19,0:20:16.53,Dial_JP,,0,0,0,,忘れ物取りに帰っただけだから　すぐ出っけど
Dialogue: 0,0:20:16.53,0:20:19.02,Dial_JP,,0,0,0,,あらら　気をつけなよ
Dialogue: 0,0:20:19.02,0:20:20.78,Dial_JP,,0,0,0,,お前　なんか今日うるせえな
Dialogue: 0,0:20:21.58,0:20:23.16,Dial_JP,,0,0,0,,んじゃ　元気に行ってら
Dialogue: 0,0:20:23.16,0:20:24.75,Dial_JP,,0,0,0,,テンション　キモっ
Dialogue: 0,0:20:25.77,0:20:27.05,Dial_JP,,0,0,0,,ビビった　ビビった
Dialogue: 0,0:20:27.05,0:20:27.91,Dial_JP,,0,0,0,,挨拶…
Dialogue: 0,0:20:27.91,0:20:29.25,Dial_JP,,0,0,0,,いらんよ
Dialogue: 0,0:20:30.20,0:20:31.25,Dial_JP,,0,0,0,,んだ　この靴
Dialogue: 0,0:20:36.72,0:20:37.84,Dial_JP,,0,0,0,,今度は何
Dialogue: 0,0:20:38.26,0:20:39.55,Dial_JP,,0,0,0,,財布あった
Dialogue: 0,0:20:40.40,0:20:42.10,Dial_JP,,0,0,0,,なんで　ちょっとキレてんだよ
Dialogue: 0,0:20:43.11,0:20:45.02,Dial_JP,,0,0,0,,仕切り直しまして
Dialogue: 0,0:20:45.30,0:20:47.62,Dial_JP,,0,0,0,,ケーキ　無事完成
Dialogue: 0,0:20:55.21,0:20:57.38,Dial_JP,,0,0,0,,買い物と調理の時間に対して
Dialogue: 0,0:20:57.38,0:20:59.34,Dial_JP,,0,0,0,,食べるの一瞬すぎる
Dialogue: 0,0:20:59.34,0:21:02.42,Dial_JP,,0,0,0,,料理って　過程を楽しむものなのかもね
Dialogue: 0,0:21:02.42,0:21:03.23,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:21:04.28,0:21:07.02,Dial_JP,,0,0,0,,ジャン　ここで　クリスマスプレゼントです
Dialogue: 0,0:21:08.24,0:21:08.97,Dial_JP,,0,0,0,,僕も
Dialogue: 0,0:21:09.70,0:21:10.79,Dial_JP,,0,0,0,,うそ
Dialogue: 0,0:21:16.75,0:21:17.73,Dial_JP,,0,0,0,,一緒じゃん
Dialogue: 0,0:21:17.73,0:21:18.59,Dial_JP,,0,0,0,,一緒だ
Dialogue: 0,0:21:19.28,0:21:21.40,Dial_JP,,0,0,0,,悠介さん　手冷たいから
Dialogue: 0,0:21:21.40,0:21:23.52,Dial_JP,,0,0,0,,「これだ」と思って選びました
Dialogue: 0,0:21:23.84,0:21:27.82,Dial_JP,,0,0,0,,ファッション　こだわりありそうだなって\N思って　迷ったんだけど
Dialogue: 0,0:21:27.82,0:21:29.56,Dial_JP,,0,0,0,,大丈夫　それ
Dialogue: 0,0:21:31.20,0:21:32.89,Dial_JP,,0,0,0,,見て　かわいくない
Dialogue: 0,0:21:37.11,0:21:37.90,Dial_JP,,0,0,0,,かわいい
Dialogue: 0,0:21:42.95,0:21:45.59,Dial_JP,,0,0,0,,初めて一緒に過ごしたクリスマスは
Dialogue: 0,0:21:45.59,0:21:48.45,Dial_JP,,0,0,0,,いろいろ　ちょっと変な感じになっちゃったけど
Dialogue: 0,0:21:50.47,0:21:52.78,Dial_JP,,0,0,0,,もうすぐ　街なかのクリスマスソングが
Dialogue: 0,0:21:52.78,0:21:57.46,Dial_JP,,0,0,0,,「ポン　ポポポポ\Nポポポン」ってお琴の音に変わっちゃう
Dialogue: 0,0:21:58.93,0:22:00.20,Dial_JP,,0,0,0,,おや　何ウケ
Dialogue: 0,0:22:00.20,0:22:00.94,Dial_JP,,0,0,0,,それでも…
Dialogue: 0,0:22:00.94,0:22:05.26,Dial_JP,,0,0,0,,いや　あんまりその曲口で\N歌ってるの聴くことないから
Dialogue: 0,0:22:05.26,0:22:06.38,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:22:10.00,0:22:12.27,Dial_JP,,0,0,0,,自分の好きな人が
Dialogue: 0,0:22:12.27,0:22:16.31,Dial_JP,,0,0,0,,この人私のことめっちゃ好きじゃんって思えちゃう
Dialogue: 0,0:22:16.31,0:22:19.24,Dial_JP,,0,0,0,,その瞬間が何よりも幸せなわけで
Dialogue: 0,0:22:19.87,0:22:21.49,Dial_JP,,0,0,0,,キスそのものなんて
Dialogue: 0,0:22:21.49,0:22:24.11,Dial_JP,,0,0,0,,別にそんな大したことじゃないんだわ
Dialogue: 0,0:22:26.53,0:22:28.84,Dial_JP,,0,0,0,,という若干の強がり
Dialogue: 0,0:22:29.65,0:22:32.98,Dial_JP,,0,0,0,,今日の　どれが初キスカウントになるんだろ
