Dialogue: 0,0:00:03.75,0:00:07.25,jp,,0,0,0,,すごく　久々な気がするな
Dialogue: 0,0:00:08.05,0:00:10.01,jp,,0,0,0,,３日会ってないだけなのに
Dialogue: 0,0:00:21.31,0:00:21.99,jp,,0,0,0,,こんばんは
Dialogue: 0,0:00:27.10,0:00:27.85,jp,,0,0,0,,先輩？
Dialogue: 0,0:00:28.53,0:00:29.58,jp,,0,0,0,,どうかしたんですか
Dialogue: 0,0:00:29.72,0:00:31.24,jp,,0,0,0,,な　何でもない
Dialogue: 0,0:00:31.74,0:00:32.64,jp,,0,0,0,,そうですか
Dialogue: 0,0:00:34.48,0:00:35.12,jp,,0,0,0,,先輩
Dialogue: 0,0:00:35.29,0:00:37.20,jp,,0,0,0,,ホントに何でもないから
Dialogue: 0,0:00:37.71,0:00:39.68,jp,,0,0,0,,月がキレイですね
Dialogue: 0,0:00:41.83,0:00:42.94,jp,,0,0,0,,え
Dialogue: 0,0:00:43.18,0:00:44.63,jp,,0,0,0,,いや　あの…
Dialogue: 0,0:00:46.04,0:00:47.68,jp,,0,0,0,,そっちは見えてないですか
Dialogue: 0,0:00:48.02,0:00:48.53,jp,,0,0,0,,月
Dialogue: 0,0:00:59.08,0:01:00.17,jp,,0,0,0,,見えてるぞ
Dialogue: 0,0:01:00.33,0:01:01.82,jp,,0,0,0,,そうだな　月が…
Dialogue: 0,0:01:05.94,0:01:07.01,jp,,0,0,0,,丸いな
Dialogue: 0,0:01:07.41,0:01:08.65,jp,,0,0,0,,満月ですので
Dialogue: 0,0:01:10.17,0:01:13.46,jp,,0,0,0,,また照れさせられた　何で
Dialogue: 0,0:01:14.93,0:01:17.13,jp,,0,0,0,,何で歩が相手だと
Dialogue: 0,0:02:50.43,0:02:51.39,jp,,0,0,0,,４五歩
Dialogue: 0,0:02:53.14,0:02:54.73,jp,,0,0,0,,３三銀引
Dialogue: 0,0:02:55.79,0:02:56.79,jp,,0,0,0,,２五桂
Dialogue: 0,0:03:02.27,0:03:02.91,jp,,0,0,0,,先輩
Dialogue: 0,0:03:03.20,0:03:03.60,jp,,0,0,0,,うん？
Dialogue: 0,0:03:04.15,0:03:05.81,jp,,0,0,0,,修学旅行はどうですか
Dialogue: 0,0:03:06.46,0:03:10.62,jp,,0,0,0,,楽しいぞ　帰ったらいっぱい話聞いてくれよ
Dialogue: 0,0:03:11.27,0:03:11.87,jp,,0,0,0,,ぜひ
Dialogue: 0,0:03:13.43,0:03:14.63,jp,,0,0,0,,８六歩
Dialogue: 0,0:03:16.52,0:03:19.12,jp,,0,0,0,,歩は特訓頑張ってるみたいだな
Dialogue: 0,0:03:19.46,0:03:21.34,jp,,0,0,0,,耀龍四間飛車とは
Dialogue: 0,0:03:21.95,0:03:24.06,jp,,0,0,0,,そうですか　嬉しいです
Dialogue: 0,0:03:25.37,0:03:27.19,jp,,0,0,0,,そういえば　すみませんでした
Dialogue: 0,0:03:27.37,0:03:27.84,jp,,0,0,0,,うん？
Dialogue: 0,0:03:28.16,0:03:31.28,jp,,0,0,0,,先輩が帰ってくるまでに強くなるって言っておいて
Dialogue: 0,0:03:31.54,0:03:33.74,jp,,0,0,0,,修学旅行中に誘ったりして
Dialogue: 0,0:03:33.94,0:03:37.19,jp,,0,0,0,,ああ　全然いいぞ　私も楽しいし
Dialogue: 0,0:03:37.64,0:03:39.41,jp,,0,0,0,,急でびっくりしたけどな
Dialogue: 0,0:03:39.87,0:03:41.52,jp,,0,0,0,,寂しくなってしまいまして
Dialogue: 0,0:03:43.99,0:03:46.43,jp,,0,0,0,,メールもしてこなかったくせに
Dialogue: 0,0:03:47.06,0:03:50.49,jp,,0,0,0,,修学旅行の邪魔になるかと思って　我慢してました
Dialogue: 0,0:03:51.62,0:03:52.20,jp,,0,0,0,,同歩
Dialogue: 0,0:03:53.10,0:03:55.13,jp,,0,0,0,,気にしなくていいのに
Dialogue: 0,0:03:57.45,0:03:59.69,jp,,0,0,0,,また何か照れさせられた
Dialogue: 0,0:04:00.55,0:04:01.23,jp,,0,0,0,,でも
Dialogue: 0,0:04:02.86,0:04:03.90,jp,,0,0,0,,心地いい
Dialogue: 0,0:04:06.42,0:04:07.47,jp,,0,0,0,,８八歩
Dialogue: 0,0:04:08.07,0:04:09.09,jp,,0,0,0,,そっか
Dialogue: 0,0:04:10.34,0:04:11.84,jp,,0,0,0,,３三桂成
Dialogue: 0,0:04:15.35,0:04:18.42,jp,,0,0,0,,思えば　修学旅行始まってから
Dialogue: 0,0:04:18.91,0:04:20.61,jp,,0,0,0,,私　ずっと
Dialogue: 0,0:04:24.86,0:04:28.11,jp,,0,0,0,,歩と　将棋指したかったんだな
Dialogue: 0,0:04:33.61,0:04:34.77,jp,,0,0,0,,同金寄
Dialogue: 0,0:04:46.37,0:04:49.21,jp,,0,0,0,,私も寂しかったぞ
Dialogue: 0,0:04:51.94,0:04:54.89,jp,,0,0,0,,よーし　修学旅行　最終日
Dialogue: 0,0:04:55.23,0:04:59.50,jp,,0,0,0,,なので　抱えきれないぐらいのお土産をゲットするぞ
Dialogue: 0,0:05:04.98,0:05:08.57,jp,,0,0,0,,お土産かあ　みんな何がいいかな
Dialogue: 0,0:05:16.17,0:05:16.96,jp,,0,0,0,,すみません
Dialogue: 0,0:05:16.96,0:05:17.92,jp,,0,0,0,,ごめんね
Dialogue: 0,0:05:20.07,0:05:21.38,jp,,0,0,0,,うるし
Dialogue: 0,0:05:21.99,0:05:23.03,jp,,0,0,0,,今行く
Dialogue: 0,0:05:42.93,0:05:44.30,jp,,0,0,0,,いけるんじゃないですかね
Dialogue: 0,0:05:44.96,0:05:45.71,jp,,0,0,0,,いけるか
Dialogue: 0,0:05:46.13,0:05:46.64,jp,,0,0,0,,ええ
Dialogue: 0,0:05:47.00,0:05:48.74,jp,,0,0,0,,やったじゃねえか　歩
Dialogue: 0,0:05:52.18,0:05:54.99,jp,,0,0,0,,もし１筋を受けてくれずに攻めてきたら
Dialogue: 0,0:05:55.73,0:05:57.13,jp,,0,0,0,,どうすればいいと思う
Dialogue: 0,0:05:57.89,0:06:00.75,jp,,0,0,0,,この局面で　そこは一度も指してませんし
Dialogue: 0,0:06:01.01,0:06:02.33,jp,,0,0,0,,考えなくていいでしょう
Dialogue: 0,0:06:02.87,0:06:03.65,jp,,0,0,0,,そうか
Dialogue: 0,0:06:05.27,0:06:06.39,jp,,0,0,0,,いよいよですね
Dialogue: 0,0:06:07.53,0:06:08.74,jp,,0,0,0,,いよいよだな
Dialogue: 0,0:06:09.51,0:06:12.65,jp,,0,0,0,,ああ　明日先輩が帰ってくる
Dialogue: 0,0:06:13.23,0:06:15.15,jp,,0,0,0,,そうしたら俺は…
Dialogue: 0,0:06:23.31,0:06:23.73,jp,,0,0,0,,凛
Dialogue: 0,0:06:24.07,0:06:24.81,jp,,0,0,0,,あはい
Dialogue: 0,0:06:25.51,0:06:27.48,jp,,0,0,0,,今日までの特訓のお礼がしたい
Dialogue: 0,0:06:31.50,0:06:34.18,jp,,0,0,0,,では　今日のお昼をおごってください
Dialogue: 0,0:06:34.39,0:06:35.17,jp,,0,0,0,,いいのか
Dialogue: 0,0:06:35.50,0:06:38.12,jp,,0,0,0,,何ならファミレスで肉の塊でも
Dialogue: 0,0:06:42.10,0:06:46.53,jp,,0,0,0,,いえ　明日部長に勝ったら　追加でお礼をいただきます
Dialogue: 0,0:06:47.89,0:06:49.91,jp,,0,0,0,,これ　面白くないか
Dialogue: 0,0:06:49.91,0:06:50.95,jp,,0,0,0,,ホントだ
Dialogue: 0,0:06:54.69,0:06:55.99,jp,,0,0,0,,うーるしー
Dialogue: 0,0:06:56.74,0:06:58.39,jp,,0,0,0,,昨日はどうだったのさ
Dialogue: 0,0:06:58.88,0:07:01.59,jp,,0,0,0,,歩　強くなってて嬉しかったぞ
Dialogue: 0,0:07:06.51,0:07:07.80,jp,,0,0,0,,あっちも見てみよう
Dialogue: 0,0:07:08.12,0:07:09.91,jp,,0,0,0,,何かスッキリしてんね
Dialogue: 0,0:07:09.91,0:07:10.46,jp,,0,0,0,,なっ
Dialogue: 0,0:07:11.05,0:07:13.69,jp,,0,0,0,,何もなかったってことじゃーん
Dialogue: 0,0:07:13.77,0:07:15.62,jp,,0,0,0,,マキ　つまんなそう
Dialogue: 0,0:07:16.47,0:07:17.35,jp,,0,0,0,,これだ
Dialogue: 0,0:07:21.20,0:07:23.13,jp,,0,0,0,,みんなへのお土産　これにする
Dialogue: 0,0:07:23.90,0:07:25.76,jp,,0,0,0,,どこにでも売ってそうじゃない
Dialogue: 0,0:07:26.34,0:07:27.88,jp,,0,0,0,,でも　ピンときたし
Dialogue: 0,0:07:28.99,0:07:30.62,jp,,0,0,0,,歩は歩だろー
Dialogue: 0,0:07:30.89,0:07:33.14,jp,,0,0,0,,凛ちゃんは香川だから香車で
Dialogue: 0,0:07:33.43,0:07:35.33,jp,,0,0,0,,タケルは角か竜
Dialogue: 0,0:07:35.71,0:07:38.14,jp,,0,0,0,,いいや　どっちも買って
Dialogue: 0,0:07:38.51,0:07:40.99,jp,,0,0,0,,片っぽ　桜子ちゃんのお土産だ
Dialogue: 0,0:07:41.55,0:07:42.92,jp,,0,0,0,,楽しそうだな
Dialogue: 0,0:07:43.35,0:07:45.67,jp,,0,0,0,,ホント　将棋好きだね
Dialogue: 0,0:07:46.48,0:07:49.02,jp,,0,0,0,,せっかくだし　自分のも買うか
Dialogue: 0,0:07:49.45,0:07:51.00,jp,,0,0,0,,どれにしよっかな
Dialogue: 0,0:07:51.63,0:07:54.81,jp,,0,0,0,,うるしと金好きって言ってたよね
Dialogue: 0,0:07:55.41,0:07:56.62,jp,,0,0,0,,そうだけど
Dialogue: 0,0:07:56.91,0:07:59.40,jp,,0,0,0,,いや　それだと歩と…
Dialogue: 0,0:07:59.40,0:08:01.45,jp,,0,0,0,,気にしなくていいって
Dialogue: 0,0:08:01.53,0:08:04.29,jp,,0,0,0,,好きな駒買った方が絶対いいよ
Dialogue: 0,0:08:05.55,0:08:08.54,jp,,0,0,0,,そ…そうだな　じゃあ
Dialogue: 0,0:08:16.70,0:08:19.45,jp,,0,0,0,,田中君とお揃いだなー　うるし
Dialogue: 0,0:08:19.61,0:08:22.68,jp,,0,0,0,,なっ　気にしなくていいって言ってたろ
Dialogue: 0,0:08:24.24,0:08:26.44,jp,,0,0,0,,マキ　元気になってる
Dialogue: 0,0:08:39.89,0:08:40.95,jp,,0,0,0,,食べないんですか
Dialogue: 0,0:08:41.62,0:08:42.99,jp,,0,0,0,,いや　食べる
Dialogue: 0,0:08:49.86,0:08:53.55,jp,,0,0,0,,凛　昼食のあと一局特訓してもらっていいか
Dialogue: 0,0:08:55.16,0:08:56.10,jp,,0,0,0,,田中さん
Dialogue: 0,0:08:56.21,0:08:56.68,jp,,0,0,0,,うん？
Dialogue: 0,0:08:57.97,0:09:00.47,jp,,0,0,0,,もし勝てなかったらどうするんです
Dialogue: 0,0:09:02.45,0:09:03.82,jp,,0,0,0,,告白しないんですか
Dialogue: 0,0:09:04.56,0:09:07.79,jp,,0,0,0,,そんなの…後悔しますよ
Dialogue: 0,0:09:08.49,0:09:11.92,jp,,0,0,0,,大丈夫だ　後悔しないように全力でやるさ
Dialogue: 0,0:09:12.87,0:09:15.56,jp,,0,0,0,,全力でやってもしますよ　後悔は
Dialogue: 0,0:09:17.23,0:09:17.89,jp,,0,0,0,,いや
Dialogue: 0,0:09:18.19,0:09:21.07,jp,,0,0,0,,友達も田中さんと似たようなことしてて
Dialogue: 0,0:09:21.99,0:09:24.04,jp,,0,0,0,,後悔してたなと
Dialogue: 0,0:09:24.55,0:09:27.91,jp,,0,0,0,,そんなに後悔してたのか　その友達は
Dialogue: 0,0:09:28.34,0:09:28.88,jp,,0,0,0,,ええ
Dialogue: 0,0:09:30.23,0:09:31.82,jp,,0,0,0,,こんな気持ちになるのなら
Dialogue: 0,0:09:32.25,0:09:33.97,jp,,0,0,0,,逃げだしてしまいたいくらいに
Dialogue: 0,0:09:38.31,0:09:40.32,jp,,0,0,0,,な　何笑ってるんですか
Dialogue: 0,0:09:40.61,0:09:44.99,jp,,0,0,0,,いや　相変わらず凛に弱音は似合わないと思ってな
Dialogue: 0,0:09:49.07,0:09:50.91,jp,,0,0,0,,全然強くなれません
Dialogue: 0,0:09:51.91,0:09:55.17,jp,,0,0,0,,私向いてないんでしょうか　剣道
Dialogue: 0,0:09:55.42,0:09:58.17,jp,,0,0,0,,大丈夫だ　香川は強くなるさ
Dialogue: 0,0:09:58.92,0:10:01.41,jp,,0,0,0,,本当ですか　田中先輩
Dialogue: 0,0:10:01.77,0:10:03.49,jp,,0,0,0,,ああ　それより
Dialogue: 0,0:10:04.28,0:10:07.28,jp,,0,0,0,,弱音を吐く姿が似合わないな　香川は
Dialogue: 0,0:10:11.08,0:10:13.42,jp,,0,0,0,,弱音を吐いていたのは過去の話です
Dialogue: 0,0:10:14.14,0:10:16.12,jp,,0,0,0,,というか　友達の話です
Dialogue: 0,0:10:16.61,0:10:20.57,jp,,0,0,0,,そ…その友達　今はスッキリしてるそうですよ
Dialogue: 0,0:10:21.11,0:10:21.83,jp,,0,0,0,,そうか
Dialogue: 0,0:10:22.32,0:10:22.91,jp,,0,0,0,,はい
Dialogue: 0,0:10:27.02,0:10:29.50,jp,,0,0,0,,とにかく　どうやっても失敗したときに
Dialogue: 0,0:10:29.50,0:10:31.56,jp,,0,0,0,,後悔は残るって話ですよ
Dialogue: 0,0:10:32.44,0:10:34.17,jp,,0,0,0,,一度決めたことだからな
Dialogue: 0,0:10:34.85,0:10:36.36,jp,,0,0,0,,諦めずにやってみるよ
Dialogue: 0,0:10:37.99,0:10:40.60,jp,,0,0,0,,田中さんならそう言うと思ってました
Dialogue: 0,0:10:41.13,0:10:42.69,jp,,0,0,0,,さっきのは忘れてください
Dialogue: 0,0:10:43.29,0:10:46.05,jp,,0,0,0,,いや　俺のために言ってくれたんだろう
Dialogue: 0,0:10:46.60,0:10:47.23,jp,,0,0,0,,ありがとう
Dialogue: 0,0:10:49.04,0:10:50.91,jp,,0,0,0,,違いますよ　田中さん
Dialogue: 0,0:10:52.25,0:10:53.55,jp,,0,0,0,,私のためです
Dialogue: 0,0:10:55.20,0:10:58.07,jp,,0,0,0,,私の気持ち何も知らないで
Dialogue: 0,0:11:02.39,0:11:04.74,jp,,0,0,0,,お前の気持ちは分かってるぞ　凛
Dialogue: 0,0:11:10.71,0:11:12.48,jp,,0,0,0,,飯足りないんだろ
Dialogue: 0,0:11:13.59,0:11:15.86,jp,,0,0,0,,遠慮するな　まだたくさん買ってある
Dialogue: 0,0:11:21.93,0:11:23.42,jp,,0,0,0,,カップ麺もあります
Dialogue: 0,0:11:24.47,0:11:26.01,jp,,0,0,0,,そんなに食えるのか
Dialogue: 0,0:11:26.40,0:11:27.01,jp,,0,0,0,,はい
Dialogue: 0,0:11:32.22,0:11:35.24,jp,,0,0,0,,修学旅行あっという間だったなー
Dialogue: 0,0:11:35.41,0:11:36.57,jp,,0,0,0,,なあ
Dialogue: 0,0:11:37.27,0:11:40.92,jp,,0,0,0,,楽しかったし　事故とか何もなくてよかった
Dialogue: 0,0:11:41.49,0:11:44.12,jp,,0,0,0,,歩のくれたお守りのおかげかもな
Dialogue: 0,0:11:58.74,0:12:00.01,jp,,0,0,0,,どうした？ うるし
Dialogue: 0,0:12:00.46,0:12:03.53,jp,,0,0,0,,お守り　歩にもらったやつ
Dialogue: 0,0:12:03.75,0:12:05.42,jp,,0,0,0,,どっかに落としちゃった
Dialogue: 0,0:12:06.79,0:12:07.78,jp,,0,0,0,,マジか
Dialogue: 0,0:12:08.58,0:12:10.01,jp,,0,0,0,,どこでだろう
Dialogue: 0,0:12:12.46,0:12:13.97,jp,,0,0,0,,私　捜してくる
Dialogue: 0,0:12:15.23,0:12:16.01,jp,,0,0,0,,うるし
Dialogue: 0,0:12:17.89,0:12:20.21,jp,,0,0,0,,ごめん　みんなは先に行ってて
Dialogue: 0,0:12:44.68,0:12:48.17,jp,,0,0,0,,そっか　朝人にぶつかったときに…
Dialogue: 0,0:12:58.47,0:12:59.82,jp,,0,0,0,,おい　待て
Dialogue: 0,0:13:08.29,0:13:09.63,jp,,0,0,0,,待って
Dialogue: 0,0:13:10.34,0:13:13.37,jp,,0,0,0,,クッソ　追っても追っても逃げられる
Dialogue: 0,0:13:13.70,0:13:17.08,jp,,0,0,0,,歩なら　あっという間に捕まえてくれるんだろうな
Dialogue: 0,0:13:18.13,0:13:19.27,jp,,0,0,0,,そういえば
Dialogue: 0,0:13:20.23,0:13:21.58,jp,,0,0,0,,王手は追う手だ
Dialogue: 0,0:13:22.35,0:13:25.98,jp,,0,0,0,,ガンガン王手をかけるだけじゃ相手の王は取れないぞ
Dialogue: 0,0:13:27.54,0:13:28.35,jp,,0,0,0,,よしっ
Dialogue: 0,0:13:29.94,0:13:31.63,jp,,0,0,0,,王手をかける前に
Dialogue: 0,0:13:31.81,0:13:33.91,jp,,0,0,0,,相手の王の逃げ道に指して
Dialogue: 0,0:13:54.46,0:13:55.77,jp,,0,0,0,,よかった
Dialogue: 0,0:13:59.61,0:14:03.41,jp,,0,0,0,,見て　こんな時期に咲くなんて珍しいわね
Dialogue: 0,0:14:03.69,0:14:04.68,jp,,0,0,0,,ねえ
Dialogue: 0,0:14:17.53,0:14:18.80,jp,,0,0,0,,キレイだな
Dialogue: 0,0:14:20.01,0:14:21.40,jp,,0,0,0,,なあ　歩
Dialogue: 0,0:14:46.38,0:14:48.52,jp,,0,0,0,,おっ　帰ってきたぞ
Dialogue: 0,0:14:49.00,0:14:50.36,jp,,0,0,0,,うるし
Dialogue: 0,0:14:53.99,0:14:56.78,jp,,0,0,0,,ご…ご迷惑をおかけしました
Dialogue: 0,0:14:56.83,0:14:58.58,jp,,0,0,0,,いいっていいって
Dialogue: 0,0:14:58.58,0:15:00.36,jp,,0,0,0,,見つかってよかったね
Dialogue: 0,0:15:01.18,0:15:03.62,jp,,0,0,0,,じゃあ　時間ないし　行くぞ
Dialogue: 0,0:15:08.39,0:15:10.05,jp,,0,0,0,,マキもごめんな
Dialogue: 0,0:15:10.41,0:15:13.53,jp,,0,0,0,,最高の修学旅行にしようって言ってたのに
Dialogue: 0,0:15:14.02,0:15:17.12,jp,,0,0,0,,何言ってんの　こういうのも含めて
Dialogue: 0,0:15:17.12,0:15:19.73,jp,,0,0,0,,最高の修学旅行なんだと思うよ
Dialogue: 0,0:15:20.45,0:15:23.75,jp,,0,0,0,,それより　見つかってよかったね
Dialogue: 0,0:15:24.24,0:15:28.19,jp,,0,0,0,,田中君にもらった　大切な大切なお守り
Dialogue: 0,0:15:28.88,0:15:29.37,jp,,0,0,0,,うん
Dialogue: 0,0:15:33.06,0:15:36.80,jp,,0,0,0,,あのさ　さっき分かったんだけど
Dialogue: 0,0:15:38.24,0:15:39.01,jp,,0,0,0,,私
Dialogue: 0,0:15:40.79,0:15:42.00,jp,,0,0,0,,歩のこと
Dialogue: 0,0:15:42.89,0:15:43.70,jp,,0,0,0,,好きだ
Dialogue: 0,0:15:50.01,0:15:53.17,jp,,0,0,0,,やっぱ最高の修学旅行だったじゃん
Dialogue: 0,0:15:55.13,0:15:55.67,jp,,0,0,0,,うん
Dialogue: 0,0:15:57.44,0:15:58.35,jp,,0,0,0,,ありがとう
Dialogue: 0,0:16:13.56,0:16:16.28,jp,,0,0,0,,そんな夜中まで将棋の特訓してたのか
Dialogue: 0,0:16:16.52,0:16:17.99,jp,,0,0,0,,ああ　そうだな
Dialogue: 0,0:16:18.61,0:16:20.66,jp,,0,0,0,,それでこんな朝早く
Dialogue: 0,0:16:21.13,0:16:22.67,jp,,0,0,0,,めちゃくちゃ眠いだろ
Dialogue: 0,0:16:23.01,0:16:23.90,jp,,0,0,0,,眠くはない
Dialogue: 0,0:16:25.33,0:16:26.70,jp,,0,0,0,,声だけなのに
Dialogue: 0,0:16:26.95,0:16:29.70,jp,,0,0,0,,歩のこと　意識しちゃう
Dialogue: 0,0:16:33.03,0:16:35.11,jp,,0,0,0,,帰ってきたぞ　将棋部
Dialogue: 0,0:16:35.36,0:16:36.66,jp,,0,0,0,,おかえりなさい
Dialogue: 0,0:16:37.14,0:16:37.88,jp,,0,0,0,,待ってました
Dialogue: 0,0:16:41.10,0:16:42.73,jp,,0,0,0,,おかえりなさい　先輩
Dialogue: 0,0:16:44.80,0:16:46.24,jp,,0,0,0,,た…ただいま
Dialogue: 0,0:16:47.65,0:16:49.95,jp,,0,0,0,,朝に集まってもらって　ごめんな
Dialogue: 0,0:16:50.25,0:16:52.47,jp,,0,0,0,,先にお土産渡したくてさ
Dialogue: 0,0:16:53.16,0:16:54.33,jp,,0,0,0,,まずは
Dialogue: 0,0:16:55.36,0:16:56.56,jp,,0,0,0,,大量のお菓子
Dialogue: 0,0:17:00.20,0:17:01.66,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:17:03.31,0:17:05.79,jp,,0,0,0,,こいつ　１人で全部食いそうだな
Dialogue: 0,0:17:05.79,0:17:09.62,jp,,0,0,0,,あとはみんなの名前にちなんだ　将棋の駒形キーホルダーだ
Dialogue: 0,0:17:10.25,0:17:14.04,jp,,0,0,0,,凛ちゃんは香車　タケルは角と竜を買ってきたから
Dialogue: 0,0:17:14.04,0:17:15.67,jp,,0,0,0,,桜子ちゃんにもあげてくれ
Dialogue: 0,0:17:15.82,0:17:17.05,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:17:17.37,0:17:18.34,jp,,0,0,0,,あざっす
Dialogue: 0,0:17:20.37,0:17:22.10,jp,,0,0,0,,そんで歩は
Dialogue: 0,0:17:24.90,0:17:25.83,jp,,0,0,0,,歩兵だ
Dialogue: 0,0:17:26.55,0:17:27.65,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:17:28.36,0:17:28.84,jp,,0,0,0,,うん
Dialogue: 0,0:17:30.39,0:17:31.55,jp,,0,0,0,,で　どうでした
Dialogue: 0,0:17:31.55,0:17:34.05,jp,,0,0,0,,修学旅行　一番よかったとことか
Dialogue: 0,0:17:34.20,0:17:38.58,jp,,0,0,0,,一番か　そうだな　全部よかったけど
Dialogue: 0,0:17:38.99,0:17:40.95,jp,,0,0,0,,一番はやっぱ桜かな
Dialogue: 0,0:17:41.48,0:17:44.36,jp,,0,0,0,,季節外れに咲いてた桜がキレイでさ
Dialogue: 0,0:17:44.48,0:17:45.62,jp,,0,0,0,,へえ
Dialogue: 0,0:17:46.45,0:17:47.90,jp,,0,0,0,,それはよかったですね
Dialogue: 0,0:17:49.15,0:17:51.30,jp,,0,0,0,,楽しかったみたいで　何よりです
Dialogue: 0,0:17:53.48,0:17:56.60,jp,,0,0,0,,うん　お守りありがとな
Dialogue: 0,0:17:57.11,0:18:01.42,jp,,0,0,0,,そういえば　このキーホルダー　部長も何か買ったんですか
Dialogue: 0,0:18:03.38,0:18:05.55,jp,,0,0,0,,名前にちなんだって言ってましたけど
Dialogue: 0,0:18:05.70,0:18:07.12,jp,,0,0,0,,部長のは何ですか
Dialogue: 0,0:18:09.24,0:18:10.30,jp,,0,0,0,,私は
Dialogue: 0,0:18:11.63,0:18:12.47,jp,,0,0,0,,これだ
Dialogue: 0,0:18:14.69,0:18:16.26,jp,,0,0,0,,へえ　歩ですか
Dialogue: 0,0:18:16.72,0:18:19.63,jp,,0,0,0,,ああ　と金が一番好きだからな
Dialogue: 0,0:18:19.74,0:18:22.50,jp,,0,0,0,,あ　歩といえば歩とお揃いだな
Dialogue: 0,0:18:22.61,0:18:24.72,jp,,0,0,0,,私とお揃いなんて　嬉しいだろ
Dialogue: 0,0:18:25.13,0:18:26.78,jp,,0,0,0,,はい　嬉しいです
Dialogue: 0,0:18:28.92,0:18:32.99,jp,,0,0,0,,じゃあ　私はそろそろ教室に行こうかな
Dialogue: 0,0:18:35.88,0:18:37.88,jp,,0,0,0,,集まってくれてありがとな
Dialogue: 0,0:18:38.48,0:18:40.23,jp,,0,0,0,,じゃあまた部活で
Dialogue: 0,0:18:50.24,0:18:52.89,jp,,0,0,0,,めちゃくちゃ緊張した
Dialogue: 0,0:18:59.58,0:19:00.51,jp,,0,0,0,,ありがとう
Dialogue: 0,0:19:00.71,0:19:01.15,jp,,0,0,0,,おう
Dialogue: 0,0:19:13.19,0:19:14.04,jp,,0,0,0,,どしたの
Dialogue: 0,0:19:16.97,0:19:19.28,jp,,0,0,0,,いや　今日は歩がな
Dialogue: 0,0:19:20.17,0:19:21.48,jp,,0,0,0,,勝負の日なんだ
Dialogue: 0,0:19:23.13,0:19:26.13,jp,,0,0,0,,そっか　うまくいくといいね
Dialogue: 0,0:19:28.99,0:19:29.69,jp,,0,0,0,,おう
Dialogue: 0,0:19:41.88,0:19:43.73,jp,,0,0,0,,２人揃って潜っちまったな
Dialogue: 0,0:19:51.61,0:19:52.58,jp,,0,0,0,,タケルくん
Dialogue: 0,0:20:10.66,0:20:12.74,jp,,0,0,0,,かなり特訓したみたいだな
Dialogue: 0,0:20:13.13,0:20:13.61,jp,,0,0,0,,はい
Dialogue: 0,0:20:16.79,0:20:17.61,jp,,0,0,0,,じゃあ
Dialogue: 0,0:20:18.62,0:20:19.84,jp,,0,0,0,,ここはどうだ
Dialogue: 0,0:20:43.69,0:20:44.89,jp,,0,0,0,,参りました
Dialogue: 0,0:20:50.02,0:20:51.50,jp,,0,0,0,,強くなったな
Dialogue: 0,0:20:51.84,0:20:52.95,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:20:59.23,0:21:00.94,jp,,0,0,0,,部長　田中さん
Dialogue: 0,0:21:01.44,0:21:01.85,jp,,0,0,0,,うん？
Dialogue: 0,0:21:02.69,0:21:04.38,jp,,0,0,0,,ここで私は失礼します
Dialogue: 0,0:21:07.07,0:21:07.73,jp,,0,0,0,,ちょっと
Dialogue: 0,0:21:24.50,0:21:27.14,jp,,0,0,0,,告白うまくいくといいですね
Dialogue: 0,0:21:27.80,0:21:29.38,jp,,0,0,0,,田中　先輩
Dialogue: 0,0:21:33.45,0:21:35.96,jp,,0,0,0,,凛ちゃんどうしたんだろうな
Dialogue: 0,0:21:36.40,0:21:37.17,jp,,0,0,0,,さあ
Dialogue: 0,0:21:38.07,0:21:39.55,jp,,0,0,0,,俺達も帰りましょうか
Dialogue: 0,0:21:40.05,0:21:41.36,jp,,0,0,0,,う…うん
Dialogue: 0,0:21:45.53,0:21:48.23,jp,,0,0,0,,とうとう４枚落ちでも負けちゃったな
Dialogue: 0,0:21:48.90,0:21:52.01,jp,,0,0,0,,このまますぐに私より強くなっちゃったりしてな
Dialogue: 0,0:21:53.59,0:21:54.68,jp,,0,0,0,,私より
Dialogue: 0,0:22:03.74,0:22:05.22,jp,,0,0,0,,何か考え事ですか
Dialogue: 0,0:22:06.80,0:22:08.84,jp,,0,0,0,,俺でよければ　話聞きますが
Dialogue: 0,0:22:11.74,0:22:13.41,jp,,0,0,0,,いや　あはは
Dialogue: 0,0:22:13.66,0:22:14.06,jp,,0,0,0,,うん？
Dialogue: 0,0:22:14.52,0:22:17.64,jp,,0,0,0,,歩　本当に強くなったなあって
Dialogue: 0,0:22:18.49,0:22:19.64,jp,,0,0,0,,ありがとうございます
Dialogue: 0,0:22:21.39,0:22:23.88,jp,,0,0,0,,このまま　先輩より強くなりたいです
Dialogue: 0,0:22:25.28,0:22:27.30,jp,,0,0,0,,な…なれるかな
Dialogue: 0,0:22:27.56,0:22:30.96,jp,,0,0,0,,自分が言うのもなんだけど　私結構強いぞ
Dialogue: 0,0:22:31.42,0:22:34.27,jp,,0,0,0,,知ってます　でもいつか勝ちたいです
Dialogue: 0,0:22:38.90,0:22:42.29,jp,,0,0,0,,もし　歩が私より強くなったら
Dialogue: 0,0:22:42.95,0:22:46.99,jp,,0,0,0,,将棋しかとりえのない私に　興味なくしたり
Dialogue: 0,0:22:50.62,0:22:54.69,jp,,0,0,0,,あの　もしかして俺が強くなるの嫌ですか
Dialogue: 0,0:22:55.18,0:22:56.15,jp,,0,0,0,,少し
Dialogue: 0,0:22:57.52,0:22:59.39,jp,,0,0,0,,いや　あの　違…
Dialogue: 0,0:22:59.71,0:23:01.49,jp,,0,0,0,,大丈夫ですよ　先輩
Dialogue: 0,0:23:03.40,0:23:04.70,jp,,0,0,0,,俺が強くなっても
Dialogue: 0,0:23:05.32,0:23:08.28,jp,,0,0,0,,毎日ずっと先輩と将棋指したいですから
Dialogue: 0,0:23:11.99,0:23:15.36,jp,,0,0,0,,勝ち逃げされたらどうしようとか考えてたんでしょう
Dialogue: 0,0:23:16.01,0:23:18.10,jp,,0,0,0,,先輩　負けず嫌いですもんね
Dialogue: 0,0:23:30.64,0:23:31.48,jp,,0,0,0,,歩
Dialogue: 0,0:23:37.25,0:23:38.43,jp,,0,0,0,,勝ってから言え
Dialogue: 0,0:23:41.21,0:23:42.08,jp,,0,0,0,,そうですね
Dialogue: 0,0:23:43.48,0:23:44.80,jp,,0,0,0,,勝ったあとで言います
Dialogue: 0,0:23:46.67,0:23:48.47,jp,,0,0,0,,言えるときが来るといいな
Dialogue: 0,0:23:50.63,0:23:51.12,jp,,0,0,0,,はい
Dialogue: 0,0:01:20.22,0:01:23.64,OPJP,,0,0,0,,{\fad(200,200)}さあ踏み出そう1歩前へ
Dialogue: 0,0:01:23.64,0:01:27.27,OPJP,,0,0,0,,{\fad(200,200)}キミの鼓動感じさせて
Dialogue: 0,0:01:27.27,0:01:30.39,OPJP,,0,0,0,,{\fad(200,200)}駆け引きはポーカーフェイス
Dialogue: 0,0:01:30.39,0:01:35.23,OPJP,,0,0,0,,{\fad(200,200)}気づかれたくはないから
Dialogue: 0,0:01:35.61,0:01:38.49,OPJP,,0,0,0,,{\fad(200,200)}距離にして数センチ
Dialogue: 0,0:01:38.99,0:01:41.74,OPJP,,0,0,0,,{\fad(200,200)}まわりみちして
Dialogue: 0,0:01:42.62,0:01:45.45,OPJP,,0,0,0,,{\fad(200,200)}笑顔ねらってる
Dialogue: 0,0:01:45.45,0:01:48.87,OPJP,,0,0,0,,{\fad(200,200)}ひそかなエストラテジア
Dialogue: 0,0:01:48.87,0:01:52.17,OPJP,,0,0,0,,{\fad(200,200)}隙がないディフェンス
Dialogue: 0,0:01:52.17,0:01:55.88,OPJP,,0,0,0,,{\fad(200,200)}もう少しだけ
Dialogue: 0,0:01:55.88,0:02:01.80,OPJP,,0,0,0,,{\fad(200,200)}歩み寄るから向こうをみていて
Dialogue: 0,0:02:01.80,0:02:05.60,OPJP,,0,0,0,,{\fad(200,200)}傷つくの怖くなる
Dialogue: 0,0:02:05.60,0:02:08.97,OPJP,,0,0,0,,{\fad(200,200)}そんな夜もある
Dialogue: 0,0:02:08.97,0:02:12.31,OPJP,,0,0,0,,{\fad(200,200)}すれ違いからのチャンス
Dialogue: 0,0:02:12.31,0:02:16.69,OPJP,,0,0,0,,{\fad(200,200)}逃さないよ大逆転
Dialogue: 0,0:02:18.61,0:02:22.36,OPJP,,0,0,0,,{\fad(200,200)}さあ踏み出そう1歩前へ
Dialogue: 0,0:02:22.36,0:02:25.74,OPJP,,0,0,0,,{\fad(200,200)}物語は自分で
Dialogue: 0,0:02:26.12,0:02:32.16,OPJP,,0,0,0,,{\fad(200,200)}書き出しはいつも「ほんとは」「ずっと」から
Dialogue: 0,0:02:32.16,0:02:35.63,OPJP,,0,0,0,,{\fad(200,200)}タクラミなら進行形
Dialogue: 0,0:02:35.63,0:02:39.13,OPJP,,0,0,0,,{\fad(200,200)}キミの鼓動感じさせて
Dialogue: 0,0:02:39.55,0:02:42.55,OPJP,,0,0,0,,{\fad(200,200)}駆け引きはポーカーフェイス
Dialogue: 0,0:02:42.55,0:02:47.68,OPJP,,0,0,0,,{\fad(200,200)}気づかれたくはないから
