Dialogue: 0,0:00:11.08,0:00:12.96,Default,,0,0,0,,‫أخرجوهم من هنا!
Dialogue: 0,0:00:13.34,0:00:16.05,Default,,0,0,0,,‫أليس هذا الفتى ممسوسًا؟
Dialogue: 0,0:00:16.50,0:00:18.76,Default,,0,0,0,,‫ماذا لو هاجمنا؟!
Dialogue: 0,0:00:18.92,0:00:19.80,Default,,0,0,0,,‫اسمعوا أنفسكم!
Dialogue: 0,0:00:20.13,0:00:21.72,Default,,0,0,0,,‫أتسمّون أنفسكم محقّقين؟
Dialogue: 0,0:00:21.80,0:00:25.35,Default,,0,0,0,,‫كفّوا عن التوتّر وتحرّكوا!
Dialogue: 0,0:02:02.74,0:02:04.82,Italics,,0,0,0,,‫أين أنا؟
Dialogue: 0,0:02:05.74,0:02:08.78,Italics,,0,0,0,,‫أذكر أنّني قابلت قطًّا غريبًا...
Dialogue: 0,0:02:09.08,0:02:12.08,Italics,,0,0,0,,‫ثمّ حاول غول مخيف قتلي...
Dialogue: 0,0:02:14.04,0:02:15.75,Italics,,0,0,0,,‫ماذا؟ غول؟
Dialogue: 0,0:02:16.08,0:02:16.96,Italics,,0,0,0,,‫جيرو.
Dialogue: 0,0:02:19.17,0:02:20.17,Italics,,0,0,0,,‫راغو؟
Dialogue: 0,0:02:21.05,0:02:21.96,Italics,,0,0,0,,‫ما خطبك؟
Dialogue: 0,0:02:22.09,0:02:25.13,Italics,,0,0,0,,‫إنّك تحلّق في الهواء، كروح دخانيّة.
Dialogue: 0,0:02:25.38,0:02:27.59,Italics,,0,0,0,,‫ماذا؟ انظر من يتحدّث.
Dialogue: 0,0:02:27.84,0:02:30.10,Italics,,0,0,0,,‫لست من يملك فجوة عملاقة في صدره.
Dialogue: 0,0:02:30.60,0:02:31.93,Italics,,0,0,0,,‫ماذا؟
Dialogue: 0,0:02:39.56,0:02:41.61,Default,,0,0,0,,
Dialogue: 0,0:02:41.73,0:02:43.19,Default,,0,0,0,,‫يؤلمني رأسي بشدّة.
Dialogue: 0,0:02:43.78,0:02:44.65,Default,,0,0,0,,‫تبًّا...
Dialogue: 0,0:02:44.74,0:02:46.65,Default,,0,0,0,,‫كان كابوسًا مروّعًا.
Dialogue: 0,0:02:47.74,0:02:49.57,Default,,0,0,0,,‫أو ربّما، بطريقةٍ ما، لم يكن مجرّد حلم...
Dialogue: 0,0:02:49.91,0:02:51.12,Default,,0,0,0,,‫قرّرت الاستيقاظ أخيرًا.
Dialogue: 0,0:02:52.62,0:02:55.08,Default,,0,0,0,,‫غططت في النّوم ليوم ونصف تقريبًا.
Dialogue: 0,0:02:55.96,0:02:57.33,Default,,0,0,0,,‫من أنت؟
Dialogue: 0,0:02:57.62,0:02:58.92,Default,,0,0,0,,‫وما هذا المكان؟
Dialogue: 0,0:02:59.46,0:03:00.71,Default,,0,0,0,,‫مرحبًا أيّها الرّئيس؟
Dialogue: 0,0:03:00.84,0:03:02.25,Default,,0,0,0,,‫فتح عينيه.
Dialogue: 0,0:03:03.09,0:03:05.01,Default,,0,0,0,,‫يبدو بكامل وعيه.
Dialogue: 0,0:03:05.05,0:03:05.88,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:03:06.17,0:03:08.13,Default,,0,0,0,,‫ماذا؟ كعك؟
Dialogue: 0,0:03:08.43,0:03:10.80,Default,,0,0,0,,‫أحضر ما تشاء. فقط عُد إلى هنا!
Dialogue: 0,0:03:10.97,0:03:12.39,Default,,0,0,0,,‫من هذه الفتاة؟
Dialogue: 0,0:03:13.43,0:03:15.89,Default,,0,0,0,,‫تملك أسلوبًا فظًّا في رعاية المرضى.
Dialogue: 0,0:03:16.23,0:03:17.77,Default,,0,0,0,,‫هذا وصف دقيق.
Dialogue: 0,0:03:18.27,0:03:19.81,Italics,,0,0,0,,‫حسنًا، سأحضر كليهما...
Dialogue: 0,0:03:19.85,0:03:21.61,Italics,,0,0,0,,‫الفطر وعيدان الخيزران الصّغيرة.
Dialogue: 0,0:03:23.86,0:03:26.19,Italics,,0,0,0,,‫مرحبًا؟ هل تستمعين يا إيتشيكا؟
Dialogue: 0,0:03:26.57,0:03:27.40,Italics,,0,0,0,,‫مهلًا!
Dialogue: 0,0:03:27.49,0:03:28.57,Default,,0,0,0,,‫راغو!
Dialogue: 0,0:03:31.91,0:03:33.33,Default,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:03:33.70,0:03:36.20,Default,,0,0,0,,‫تُغلقين الخطّ في وجه رئيسك...
Dialogue: 0,0:03:36.50,0:03:37.83,Default,,0,0,0,,‫هذا جارح حقًّا.
Dialogue: 0,0:03:38.00,0:03:40.67,Default,,0,0,0,,‫ظننت أنّك تركتني، وكلّ ما تقوله هو،
Dialogue: 0,0:03:40.71,0:03:42.04,Default,,0,0,0,,‫"كنت نائمًا؟!"
Dialogue: 0,0:03:42.21,0:03:44.21,Default,,0,0,0,,‫أيّها الوغد! اذهب واكذب على غيري!
Dialogue: 0,0:03:44.30,0:03:45.84,Default,,0,0,0,,‫ لا تصمت أبدًا!
Dialogue: 0,0:03:45.88,0:03:48.63,Default,,0,0,0,,‫لم أستيقظ لتزعجني\N‫بصراخك مجدّدًا أيّها الوغد!
Dialogue: 0,0:03:48.72,0:03:51.64,Default,,0,0,0,,‫مهلًا، نحن في مستشفى! أخفضا صوتيكما!
Dialogue: 0,0:03:51.72,0:03:52.85,Italics,,0,0,0,,‫أخفضي أنتِ صوتك!
Dialogue: 0,0:03:52.89,0:03:54.93,Default,,0,0,0,,‫هل أنتِ مستعدّة لإخباري بهويّتك؟
Dialogue: 0,0:03:55.15,0:03:57.03,On Top,SIGN,0,0,0,,‫مستشفى فوكوكوشي
Dialogue: 0,0:03:55.64,0:03:56.89,Default,,0,0,0,,‫لنهدأ قليلًا.
Dialogue: 0,0:03:56.98,0:03:59.35,Default,,0,0,0,,‫أوّلًا وقبل كلّ شيء، يُسعدني أنّك بخير.
Dialogue: 0,0:03:59.64,0:04:02.81,Default,,0,0,0,,‫من حسن حظّك أنّك قويّ البنية يا أزوما جيرو-كن.
Dialogue: 0,0:04:04.11,0:04:05.19,Default,,0,0,0,,‫و...
Dialogue: 0,0:04:05.28,0:04:07.15,Default,,0,0,0,,‫كيف نشعر الآن يا راغو؟
Dialogue: 0,0:04:07.99,0:04:10.45,Default,,0,0,0,,‫عُد واطرح أسئلتك...
Dialogue: 0,0:04:10.86,0:04:12.91,Default,,0,0,0,,‫بعد أن تتعلّم بعض الأدب أيّها الحثالة!
Dialogue: 0,0:04:13.58,0:04:15.08,Italics,,0,0,0,,‫إنّه حذر منّي بلا شكّ،
Dialogue: 0,0:04:15.12,0:04:17.62,Italics,,0,0,0,,‫لكن لا يبدو أنّه ينوي أذيّتنا.
Dialogue: 0,0:04:18.04,0:04:20.33,Italics,,0,0,0,,‫ليس الأمر سيّئًا كما ظننت.
Dialogue: 0,0:04:21.75,0:04:22.79,Default,,0,0,0,,‫أعتذر.
Dialogue: 0,0:04:22.83,0:04:25.21,Default,,0,0,0,,‫ينبغي أن نبدأ بالتّعارف دائمًا.
Dialogue: 0,0:04:26.05,0:04:27.59,Default,,0,0,0,,‫أنا شيا ريوسكي.
Dialogue: 0,0:04:27.80,0:04:30.51,Default,,0,0,0,,‫وهذه مرؤوستي، كيشيموجين إيتشيكا.
Dialogue: 0,0:04:30.97,0:04:31.80,Default,,0,0,0,,‫نحن من—
Dialogue: 0,0:04:31.80,0:04:34.68,Default,,0,0,0,,‫مكتب التّجسّس، أليس كذلك؟
Dialogue: 0,0:04:35.01,0:04:37.02,Default,,0,0,0,,‫آمل أن تفي بوعودك.
Dialogue: 0,0:04:37.10,0:04:39.02,Default,,0,0,0,,‫أنت مدين لي بتفسير.
Dialogue: 0,0:04:39.48,0:04:42.31,Default,,0,0,0,,‫تبدو ذاكرته حادّة كالمعتاد.
Dialogue: 0,0:04:42.73,0:04:44.81,Default,,0,0,0,,‫لا تنظر إليّ هكذا!
Dialogue: 0,0:04:45.86,0:04:46.77,Default,,0,0,0,,‫من أين أبدأ...
Dialogue: 0,0:04:47.36,0:04:49.74,Default,,0,0,0,,‫هل تعرف الأونيوابان؟
Dialogue: 0,0:04:49.82,0:04:51.20,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:04:51.53,0:04:53.99,Default,,0,0,0,,‫أجل، سمعت عنهم...
Dialogue: 0,0:04:54.41,0:04:58.24,Default,,0,0,0,,‫أُولئك العملاء السّرّيّون الّذين\N‫عملوا لصالح شوغونيّة إيدو.
Dialogue: 0,0:04:58.75,0:05:00.16,Default,,0,0,0,,‫أجل، هم بالضبط!
Dialogue: 0,0:05:00.58,0:05:02.33,Default,,0,0,0,,‫من كان ليظنّ أنّك تعرف...
Dialogue: 0,0:05:02.50,0:05:03.42,Default,,0,0,0,,‫أبهرتني!
Dialogue: 0,0:05:03.46,0:05:04.88,Default,,0,0,0,,‫أتظنّني أبله؟!
Dialogue: 0,0:05:05.29,0:05:08.13,Default,,0,0,0,,‫مع إصلاح ميجي، تحوّل ولاء الأونيوابان
Dialogue: 0,0:05:08.30,0:05:11.26,Default,,0,0,0,,‫من الشّوغونيّة إلى الحكومة الجديدة.
Dialogue: 0,0:05:11.76,0:05:15.05,Default,,0,0,0,,‫كانوا نخبة من العملاء\N‫الحكوميّين السّرّيّين،
Dialogue: 0,0:05:15.26,0:05:18.35,Default,,0,0,0,,‫منظّمة لا تزال قائمة حتّى\N‫اليوم باسم مكتب التّجسّس.
Dialogue: 0,0:05:19.27,0:05:22.23,Default,,0,0,0,,‫الاستخبارات السّرّيّة ومكافحة التّجسّس،
Dialogue: 0,0:05:22.27,0:05:25.06,Default,,0,0,0,,‫في الدّاخل والخارج، هي صميم عملنا.
Dialogue: 0,0:05:25.48,0:05:29.28,Default,,0,0,0,,‫ذلك، إلى جانب العثور\N‫على المونونوكي وإبادتهم.
Dialogue: 0,0:05:29.78,0:05:33.24,Default,,0,0,0,,‫ومع ذلك، نادرًا ما يتسبّب\N‫المونونوكي في حوادث كبرى.
Dialogue: 0,0:05:33.66,0:05:34.49,Default,,0,0,0,,‫مؤخّرًا،
Dialogue: 0,0:05:34.53,0:05:36.41,Default,,0,0,0,,‫تعاملنا في الغالب مع البشر.
Dialogue: 0,0:05:36.82,0:05:37.95,Default,,0,0,0,,‫بعبارة أُخرى،
Dialogue: 0,0:05:38.03,0:05:40.83,Default,,0,0,0,,‫حراسة الشّخصيّات المهمّة\N‫والتّحقيق في المنظّمات الخطيرة.
Dialogue: 0,0:05:40.91,0:05:43.08,Default,,0,0,0,,‫لكنّك فهمت الفكرة.
Dialogue: 0,0:05:43.33,0:05:46.33,Default,,0,0,0,,‫وبما أنّ قسمي متخصّص في المونونوكي،
Dialogue: 0,0:05:46.42,0:05:48.04,Default,,0,0,0,,‫كانت أُمورنا يسيرة.
Dialogue: 0,0:05:48.75,0:05:50.21,Default,,0,0,0,,‫على الأقلّ، حتّى وقت قريب.
Dialogue: 0,0:05:50.38,0:05:51.38,Default,,0,0,0,,‫قبل أيّام قليلة،
Dialogue: 0,0:05:51.51,0:05:54.76,Default,,0,0,0,,‫تعرّضت إحدى منشآتنا\N‫لهجوم من عصابة مونونوكي.
Dialogue: 0,0:05:55.51,0:05:56.68,Default,,0,0,0,,‫بصراحة،
Dialogue: 0,0:05:56.76,0:05:59.31,Default,,0,0,0,,‫ما ختمناه في تلك المنشأة...
Dialogue: 0,0:05:59.81,0:06:02.52,Default,,0,0,0,,‫كان راغو نفسه الّذي يسكن داخلك الآن.
Dialogue: 0,0:06:02.93,0:06:04.64,Italics,,0,0,0,,‫إذًا هذا ما قصده...
Dialogue: 0,0:06:04.94,0:06:06.98,Italics,,0,0,0,,‫ذلك السّبات الطّويل.
Dialogue: 0,0:06:07.65,0:06:11.19,Default,,0,0,0,,‫حسنًا، أظنّ أنّه دوري لطرح بعض الأسئلة.
Dialogue: 0,0:06:12.19,0:06:15.45,Default,,0,0,0,,‫كيف انتهى بك المطاف هكذا تحديدًا؟
Dialogue: 0,0:06:16.82,0:06:18.62,Default,,0,0,0,,‫لنرَ... حسنًا، كيف؟
Dialogue: 0,0:06:19.95,0:06:21.58,Default,,0,0,0,,‫ما مقدار غبائك؟
Dialogue: 0,0:06:22.16,0:06:23.16,Default,,0,0,0,,‫أوّلًا تحشر أنفك
Dialogue: 0,0:06:23.20,0:06:24.71,Default,,0,0,0,,‫في أمر لا تفقه عنه شيئًا،
Dialogue: 0,0:06:24.75,0:06:26.71,Default,,0,0,0,,‫ثمّ تقرّر إنقاذ مونونوكي!
Dialogue: 0,0:06:26.79,0:06:28.29,Default,,0,0,0,,‫ما خطبك؟!
Dialogue: 0,0:06:28.63,0:06:29.50,Default,,0,0,0,,‫اخرسي!
Dialogue: 0,0:06:29.54,0:06:32.01,Default,,0,0,0,,‫لم تكوني هناك حتّى، لا يحقّ لك التّحدّث!
Dialogue: 0,0:06:32.09,0:06:33.46,Default,,0,0,0,,‫ليس الأمر سهلًا أبدًا...
Dialogue: 0,0:06:33.51,0:06:35.17,Default,,0,0,0,,‫ماذا سأكتب في التّقرير الآن؟
Dialogue: 0,0:06:35.26,0:06:37.18,Default,,0,0,0,,‫هذا أقلّ ما يقلقنا!
Dialogue: 0,0:06:37.55,0:06:39.60,Default,,0,0,0,,‫حسنًا، بعيدًا عن التّفاصيل،
Dialogue: 0,0:06:39.76,0:06:42.52,Default,,0,0,0,,‫الحقيقة هي أنّ هذا\N‫الشّابّ قد اندمج مع راغو.
Dialogue: 0,0:06:42.81,0:06:45.35,Default,,0,0,0,,‫ربّما خطر هذا ببالك بالفعل،
Dialogue: 0,0:06:45.60,0:06:46.94,Default,,0,0,0,,‫لكنّني سأقولها.
Dialogue: 0,0:06:47.44,0:06:48.40,Default,,0,0,0,,‫ما لم نفعل شيئًا،
Dialogue: 0,0:06:48.44,0:06:51.40,Default,,0,0,0,,‫ستبقيان مندمجين للأبد.
Dialogue: 0,0:06:51.77,0:06:53.86,Italics,,0,0,0,,‫للأبد...
Dialogue: 0,0:06:53.99,0:06:58.32,Default,,0,0,0,,‫ورغم ذلك، لا نملك أدنى\N‫فكرة عن كيفيّة إبطال هذا.
Dialogue: 0,0:06:58.36,0:06:59.20,Default,,0,0,0,,‫ما—
Dialogue: 0,0:06:59.24,0:07:02.08,Default,,0,0,0,,‫لكنّنا نعرف كيف نبحث عن طريقة.
Dialogue: 0,0:07:02.83,0:07:03.95,Default,,0,0,0,,‫وبما أنّنا نجهل
Dialogue: 0,0:07:04.04,0:07:06.16,Default,,0,0,0,,‫ما يخطّط له أُولئك المونونوكي الآخرون،
Dialogue: 0,0:07:06.25,0:07:09.58,Default,,0,0,0,,‫سنأخذك لحمايتك.
Dialogue: 0,0:07:09.96,0:07:12.30,Default,,0,0,0,,‫لا يمكنكم فعل ذلك ببساطة!
Dialogue: 0,0:07:12.38,0:07:14.51,Default,,0,0,0,,‫أعتذر، لكن لا خيار أمامك.
Dialogue: 0,0:07:15.38,0:07:18.22,Default,,0,0,0,,‫قدّمت الشّرطة بالفعل بلاغًا عن شخص مفقود.
Dialogue: 0,0:07:18.26,0:07:20.01,Default,,0,0,0,,‫وقد اتّخذنا كافّة التّرتيبات.
Dialogue: 0,0:07:20.39,0:07:21.22,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:07:21.35,0:07:24.18,Default,,0,0,0,,‫اسمع، لسنا أُولئك الأبطال\N‫الّذين تراهم على التّلفاز.
Dialogue: 0,0:07:24.52,0:07:26.77,Default,,0,0,0,,‫لسنا ملزمين بالحفاظ\N‫على حقوقك الشّخصيّة...
Dialogue: 0,0:07:27.23,0:07:28.27,Default,,0,0,0,,‫فضلًا عن ذلك،
Dialogue: 0,0:07:28.90,0:07:31.56,Default,,0,0,0,,‫لست طفلًا صغيرًا.
Dialogue: 0,0:07:31.86,0:07:34.69,Default,,0,0,0,,‫ستتحمّل المسؤوليّة.
Dialogue: 0,0:07:36.61,0:07:37.61,Default,,0,0,0,,‫في الغد باكرًا،
Dialogue: 0,0:07:37.65,0:07:39.57,Default,,0,0,0,,‫ستُنقل إلى منشأة أُخرى.
Dialogue: 0,0:07:39.82,0:07:41.87,Default,,0,0,0,,‫هذا المستشفى تحت سلطتنا.
Dialogue: 0,0:07:42.16,0:07:45.54,Default,,0,0,0,,‫وضعنا حرّاسًا خارج هذه\N‫الأبواب للحفاظ على سلامتك.
Dialogue: 0,0:07:45.70,0:07:46.54,Default,,0,0,0,,
Dialogue: 0,0:07:46.54,0:07:48.29,Default,,0,0,0,,‫المناشف وبعض الملابس في الخزانة.
Dialogue: 0,0:07:48.29,0:07:49.17,Default,,0,0,0,,‫تصرّف كأنّك في بيتك.
Dialogue: 0,0:07:49.25,0:07:50.50,Default,,0,0,0,,‫أراك غدًا.
Dialogue: 0,0:07:50.79,0:07:51.96,Default,,0,0,0,,‫انتظر... مهلًا!
Dialogue: 0,0:07:59.55,0:08:00.39,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:08:01.76,0:08:03.01,Default,,0,0,0,,‫قلتُ ماذا؟!
Dialogue: 0,0:08:05.61,0:08:09.53,On Top,SIGN,0,0,0,,‫مملكة عيدان الخيزران
Dialogue: 0,0:08:06.31,0:08:09.39,Default,,0,0,0,,‫ما خطبها؟ تبًّا...
Dialogue: 0,0:08:13.15,0:08:15.23,Default,,0,0,0,,‫حرّاس؟ لا تهزأ بي.
Dialogue: 0,0:08:15.40,0:08:17.11,Default,,0,0,0,,‫أقرب إلى سجّانين.
Dialogue: 0,0:08:17.19,0:08:19.61,Default,,0,0,0,,‫هذا حبس انفراديّ عمليًّا.
Dialogue: 0,0:08:19.95,0:08:22.62,Default,,0,0,0,,‫وأنا "شخص مفقود" الآن؟
Dialogue: 0,0:08:22.87,0:08:24.83,Default,,0,0,0,,‫هذا هراء.
Dialogue: 0,0:08:26.74,0:08:29.87,Italics,,0,0,0,,‫ماذا لو علقت هكذا للأبد؟
Dialogue: 0,0:08:30.42,0:08:31.96,Default,,0,0,0,,‫أخبرتك، أنسيت؟
Dialogue: 0,0:08:32.13,0:08:33.88,Default,,0,0,0,,‫لكن كان عليك التّورّط معي.
Dialogue: 0,0:08:34.34,0:08:37.34,Default,,0,0,0,,‫ماذا يا راغو؟ أستلقي\N‫عليّ محاضرة أنت أيضًا؟
Dialogue: 0,0:08:37.67,0:08:39.26,Default,,0,0,0,,‫لا، أحاول إخبارك.
Dialogue: 0,0:08:39.51,0:08:41.88,Default,,0,0,0,,‫لا فائدة من البكاء على\N‫اللّبن المسكوب الآن.
Dialogue: 0,0:08:42.51,0:08:44.97,Default,,0,0,0,,‫وعدك ذلك الوغد بأنّ هذا لحمايتك،
Dialogue: 0,0:08:45.01,0:08:46.31,Default,,0,0,0,,‫لكن فكّر في الأمر.
Dialogue: 0,0:08:46.60,0:08:49.60,Default,,0,0,0,,‫هو وطاقمه هم الأوغاد الّذين ختموني.
Dialogue: 0,0:08:49.73,0:08:53.06,Default,,0,0,0,,‫أتظنّ حقًّا أنّهم سيعاملونك برفق...؟
Dialogue: 0,0:08:53.27,0:08:56.65,Default,,0,0,0,,‫خاصّة الآن وقد اندمجت مع مونونوكي مثلي؟
Dialogue: 0,0:08:56.90,0:08:59.69,Default,,0,0,0,,‫ثمّ لديك أُولئك المونونوكي\N‫الّذين جاؤوا من أجلي.
Dialogue: 0,0:09:00.03,0:09:01.49,Default,,0,0,0,,‫أيقظوني،
Dialogue: 0,0:09:01.53,0:09:04.49,Default,,0,0,0,,‫وهم يعلمون جيّدًا أنّهم سيواجهون المكتب.
Dialogue: 0,0:09:04.70,0:09:07.16,Default,,0,0,0,,‫لن يستسلموا ويولّوا الأدبار.
Dialogue: 0,0:09:08.29,0:09:10.66,Default,,0,0,0,,‫مهما نظرت للأمر، أنت وحدك يا فتى.
Dialogue: 0,0:09:10.71,0:09:13.25,Default,,0,0,0,,‫الجميع إمّا غاضبون أو يرغبون في استغلالك.
Dialogue: 0,0:09:13.37,0:09:14.42,Default,,0,0,0,,‫أو—
Dialogue: 0,0:09:14.64,0:09:17.06,On Top,SIGN,0,0,0,,‫آآآآآآآآآآآآآآآ
Dialogue: 0,0:09:16.04,0:09:18.96,Default,,0,0,0,,‫-لا أُصدّق هذا!\N‫-مـ-مهلًا، هل أنت بخير؟
Dialogue: 0,0:09:19.26,0:09:22.13,Default,,0,0,0,,‫يظنّ الجميع أنّهم يفهمون كلّ شيء!
Dialogue: 0,0:09:22.51,0:09:23.84,Default,,0,0,0,,‫حسنًا، طفح الكيل، سئمت!
Dialogue: 0,0:09:23.93,0:09:25.97,Default,,0,0,0,,‫سأفعل ما أُريد!
Dialogue: 0,0:09:26.76,0:09:28.22,Default,,0,0,0,,‫سنشقّ طريقنا للخارج بقوّة يا راغو!
Dialogue: 0,0:09:28.43,0:09:31.73,Default,,0,0,0,,‫ماذا؟! سنغادر؟ إلى أين؟
Dialogue: 0,0:09:32.14,0:09:33.90,Default,,0,0,0,,‫ لن أهرب...
Dialogue: 0,0:09:34.02,0:09:34.85,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:35.90,0:09:38.23,Default,,0,0,0,,‫سأُوسّعهم ضربًا.
Dialogue: 0,0:09:39.32,0:09:41.99,Default,,0,0,0,,‫وبعد ذلك، ليحدث ما يحدث!
Dialogue: 0,0:09:42.36,0:09:44.74,Default,,0,0,0,,‫لا أعرف بمَ تحلم،
Dialogue: 0,0:09:44.86,0:09:46.99,Default,,0,0,0,,‫لكن لا تتوقّع منّي إنقاذ الموقف.
Dialogue: 0,0:09:47.49,0:09:48.74,Default,,0,0,0,,‫أعلم.
Dialogue: 0,0:09:49.37,0:09:51.45,Default,,0,0,0,,‫سأتدبّر أمري بنفسي، بطريقةٍ ما.
Dialogue: 0,0:09:54.46,0:09:56.75,Default,,0,0,0,,‫أنت، ابقَ يقظًا. نحن في مهمّة!
Dialogue: 0,0:09:56.96,0:09:58.34,Default,,0,0,0,,‫عذرًا، أظنّ أنّني فقط...
Dialogue: 0,0:09:59.59,0:10:00.96,Default,,0,0,0,,‫مـ-ما الّذي—؟
Dialogue: 0,0:10:01.51,0:10:02.47,Default,,0,0,0,,‫ما الخطب؟!
Dialogue: 0,0:10:05.55,0:10:07.39,Default,,0,0,0,,‫من دواعي سروري دائمًا أيّها السّادة!
Dialogue: 0,0:10:08.10,0:10:09.81,Default,,0,0,0,,‫تبًّا، جُنّت هذه الغربان!
Dialogue: 0,0:10:10.10,0:10:11.97,Default,,0,0,0,,‫فقدت صوابك حقًّا الآن.
Dialogue: 0,0:10:12.06,0:10:14.31,Default,,0,0,0,,‫لحسن الحظّ، لا يحتاج\N‫أصدقائي للكثير من الإقناع!
Dialogue: 0,0:10:14.64,0:10:15.56,Default,,0,0,0,,‫إنّه يهرب!
Dialogue: 0,0:10:15.65,0:10:16.60,Default,,0,0,0,,‫اهدأ!
Dialogue: 0,0:10:16.65,0:10:18.06,Default,,0,0,0,,‫علينا الاتّصال بالرّؤساء أوّلًا!
Dialogue: 0,0:10:19.11,0:10:20.86,Default,,0,0,0,,‫أنقذتموني حقًّا!
Dialogue: 0,0:10:21.15,0:10:22.57,Default,,0,0,0,,‫أُقدّر لكم هذا يا رفاق!
Dialogue: 0,0:10:22.86,0:10:24.49,Default,,0,0,0,,‫العفو!
Dialogue: 0,0:10:24.78,0:10:26.78,Default,,0,0,0,,‫كان هذا أمتع ما فعلناه منذ عصور.
Dialogue: 0,0:10:27.28,0:10:29.91,Default,,0,0,0,,‫إليكم الوجبات الخفيفة الّتي وعدتكم بها.
Dialogue: 0,0:10:30.37,0:10:31.58,Default,,0,0,0,,‫أنت الأفضل!
Dialogue: 0,0:10:34.87,0:10:37.21,Default,,0,0,0,,‫إذًا... ما الخطّة الآن؟
Dialogue: 0,0:10:37.54,0:10:39.38,Default,,0,0,0,,‫سيلحقون بنا سريعًا.
Dialogue: 0,0:10:39.59,0:10:41.59,Default,,0,0,0,,‫لست قلقًا حيال ذلك كثيرًا.
Dialogue: 0,0:10:42.30,0:10:43.34,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:10:43.76,0:10:46.55,Default,,0,0,0,,‫أملك شيئًا ينبغي عليّ فعله الآن.
Dialogue: 0,0:10:48.59,0:10:50.18,Default,,0,0,0,,‫كنت أتساءل إلى أين أنت ذاهب.
Dialogue: 0,0:10:50.30,0:10:51.51,Default,,0,0,0,,‫أكان عليك العودة للبيت؟
Dialogue: 0,0:10:51.64,0:10:52.60,Default,,0,0,0,,‫حسنًا، أجل.
Dialogue: 0,0:10:52.82,0:10:57.24,On Top,SIGN,0,0,0,,‫أزوما
Dialogue: 0,0:10:53.39,0:10:54.81,Default,,0,0,0,,‫إن وصل بلاغ الشّخص المفقود
Dialogue: 0,0:10:54.85,0:10:57.10,Default,,0,0,0,,‫إلى من-تعرفه قبل أن أصل...
Dialogue: 0,0:10:58.02,0:10:59.61,Default,,0,0,0,,‫أنت فتى صالح، سأعترف لك بهذا.
Dialogue: 0,0:10:59.73,0:11:02.44,Default,,0,0,0,,‫لكن ماذا ستقول؟
Dialogue: 0,0:11:02.65,0:11:05.61,Default,,0,0,0,,‫يمكنك محاولة قول\N‫الحقيقة، لكن من سيُصدّقك؟
Dialogue: 0,0:11:06.24,0:11:07.57,Default,,0,0,0,,‫عن ماذا تتحدّث؟
Dialogue: 0,0:11:07.91,0:11:09.12,Default,,0,0,0,,‫إنّه جدّي!
Dialogue: 0,0:11:09.41,0:11:10.62,Default,,0,0,0,,‫بالطّبع سيُصدّقني!
Dialogue: 0,0:11:11.33,0:11:14.54,Default,,0,0,0,,‫لكن سأحتاج للتّصرّف بهدوء.
Dialogue: 0,0:11:15.08,0:11:17.12,Default,,0,0,0,,‫لا تخرج حتّى أسمح لك، أفهمت؟
Dialogue: 0,0:11:21.92,0:11:23.17,Default,,0,0,0,,‫حسنًا، لنجرّب حظّنا.
Dialogue: 0,0:11:23.34,0:11:25.38,Default,,0,0,0,,‫قف مكانك أيّها المتسلّل!
Dialogue: 0,0:11:26.17,0:11:28.05,Default,,0,0,0,,‫جـ-جدّي!
Dialogue: 0,0:11:28.18,0:11:29.47,Default,,0,0,0,,‫من أين ظهرت...؟
Dialogue: 0,0:11:30.43,0:11:32.26,Default,,0,0,0,,‫تغادر دون إخباري،
Dialogue: 0,0:11:32.35,0:11:33.60,Default,,0,0,0,,‫وهذا كلّ ما تقوله؟
Dialogue: 0,0:11:34.06,0:11:37.35,Default,,0,0,0,,‫حسنًا، في الواقع...
Dialogue: 0,0:11:37.89,0:11:40.73,Default,,0,0,0,,‫طرأت بعض الأُمور، بعض الأُمور المعقّدة...
Dialogue: 0,0:11:40.81,0:11:42.86,Default,,0,0,0,,‫لذا أردت العودة والشّرح، لذا...
Dialogue: 0,0:11:43.98,0:11:45.74,Default,,0,0,0,,‫مهلًا، إلى أين أنت ذاهب؟
Dialogue: 0,0:11:47.49,0:11:49.45,Default,,0,0,0,,‫تعال معي. ولا تنطق بكلمة.
Dialogue: 0,0:11:50.82,0:11:51.95,Default,,0,0,0,,‫حاضر.
Dialogue: 0,0:11:55.29,0:11:57.96,Default,,0,0,0,,‫يا إلهي، كم تبقّى لنا لنصل؟
Dialogue: 0,0:11:58.16,0:12:00.25,Default,,0,0,0,,‫آسف، أنا كذلك حقًّا. لكن\N‫لا أملك الكثير من الوقت،
Dialogue: 0,0:12:00.58,0:12:03.38,Default,,0,0,0,,‫وأملك الكثير لأشرحه قبل أن أضطرّ للذّهاب.
Dialogue: 0,0:12:05.21,0:12:07.38,Default,,0,0,0,,‫إذًا، لمَ أحضرتني إلى هنا؟
Dialogue: 0,0:12:08.17,0:12:09.97,Default,,0,0,0,,‫أليس هذا واضحًا؟
Dialogue: 0,0:12:10.55,0:12:13.72,Default,,0,0,0,,‫هنا، لا يمكن لأحد التّدخّل.
Dialogue: 0,0:12:14.06,0:12:14.97,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:17.56,0:12:19.06,Default,,0,0,0,,‫مؤلم! ما هذا—
Dialogue: 0,0:12:19.10,0:12:20.48,Default,,0,0,0,,‫رأسك يابس كالحجر!
Dialogue: 0,0:12:20.81,0:12:23.11,Default,,0,0,0,,‫هل تملك أدنى فكرة عمّا فعلته؟
Dialogue: 0,0:12:23.48,0:12:24.86,Default,,0,0,0,,‫ماذا...
Dialogue: 0,0:12:25.23,0:12:28.24,Default,,0,0,0,,‫آسف لمغادرتي،
Dialogue: 0,0:12:28.40,0:12:29.45,Default,,0,0,0,,‫لكن لم يكن عليك—
Dialogue: 0,0:12:29.49,0:12:31.61,Default,,0,0,0,,‫الأمر يتجاوز تصرّفك المتسلّل هذا!
Dialogue: 0,0:12:31.99,0:12:34.62,Default,,0,0,0,,‫أخبرني شيبا بكلّ شيء!
Dialogue: 0,0:12:34.91,0:12:37.37,Default,,0,0,0,,‫عن كيفيّة استحواذ مونونوكي عليك.
Dialogue: 0,0:12:37.45,0:12:40.87,Default,,0,0,0,,‫وكيف يلاحقك مكتب التّجسّس.
Dialogue: 0,0:12:41.58,0:12:42.83,Default,,0,0,0,,‫عـ-عن ماذا تتحدّث؟
Dialogue: 0,0:12:42.88,0:12:44.50,Default,,0,0,0,,‫جدّي، كيف عرفت—
Dialogue: 0,0:12:44.71,0:12:47.13,Default,,0,0,0,,‫غبيّ كالصّخر...
Dialogue: 0,0:12:47.67,0:12:52.26,Default,,0,0,0,,‫أعرف لأنّني عضو سابق في مكتب التّجسّس.
Dialogue: 0,0:12:53.18,0:12:54.76,Default,,0,0,0,,‫لا بدّ أنّك تمزح...
Dialogue: 0,0:12:55.26,0:12:56.72,Default,,0,0,0,,‫كلّ شيء يبدو منطقيًّا الآن.
Dialogue: 0,0:12:56.97,0:12:58.27,Default,,0,0,0,,‫ظننت الأمر غريبًا...
Dialogue: 0,0:12:59.14,0:13:01.60,Default,,0,0,0,,‫رجل عجوز مستعدّ للقتل بهذه السّهولة.
Dialogue: 0,0:13:01.77,0:13:02.77,Default,,0,0,0,,‫راغو!
Dialogue: 0,0:13:03.35,0:13:04.94,Default,,0,0,0,,‫إذًا أنت راغو...
Dialogue: 0,0:13:05.15,0:13:07.53,Default,,0,0,0,,‫كيف تجرؤ، وبحفيدي من لحمي ودمي...
Dialogue: 0,0:13:07.86,0:13:09.19,Default,,0,0,0,,‫لم أكن لأُصدّق هذا أبدًا،
Dialogue: 0,0:13:09.24,0:13:10.90,Default,,0,0,0,,‫لو لم أشهده بأُمّ عيني.
Dialogue: 0,0:13:10.99,0:13:13.95,Default,,0,0,0,,‫لكن الآن، أعرف ما ينبغي عليّ فعله.
Dialogue: 0,0:13:15.28,0:13:17.95,Default,,0,0,0,,‫لا مفرّ من هذا.
Dialogue: 0,0:13:18.20,0:13:21.29,Default,,0,0,0,,‫عليّ أن أتحمّل مسؤوليّة\N‫خطيئة حفيدي الفادحة!
Dialogue: 0,0:13:23.25,0:13:27.13,Default,,0,0,0,,‫لن أسمح للمكتب أو للمونونوكي باستغلالك.
Dialogue: 0,0:13:27.21,0:13:28.13,Default,,0,0,0,,‫جيرو...
Dialogue: 0,0:13:28.17,0:13:30.51,Default,,0,0,0,,‫سأقضي عليك وعلى راغو معًا.
Dialogue: 0,0:13:30.88,0:13:34.93,Default,,0,0,0,,‫وحين أنتهي، سأُنهي حياتي أيضًا!
Dialogue: 0,0:13:40.93,0:13:43.89,Default,,0,0,0,,‫أصبحت الأُمور مثيرة للاهتمام!
Dialogue: 0,0:13:44.40,0:13:46.40,Default,,0,0,0,,‫ماذا تقول يا جدّي؟
Dialogue: 0,0:13:46.73,0:13:47.90,Default,,0,0,0,,‫قلت...
Dialogue: 0,0:13:48.32,0:13:49.15,Default,,0,0,0,,‫ما يكفي!
Dialogue: 0,0:13:49.23,0:13:51.15,Default,,0,0,0,,‫-عجبًا، هذا الرّجل مذهل!\N‫-تبًّا!
Dialogue: 0,0:13:56.03,0:13:58.41,Default,,0,0,0,,‫عجبًا، عجوزك لا يرحم.
Dialogue: 0,0:13:59.74,0:14:01.00,Default,,0,0,0,,‫لا تخبرني بهذا!
Dialogue: 0,0:14:01.08,0:14:02.66,Default,,0,0,0,,‫هذا هو جدّي.
Dialogue: 0,0:14:03.58,0:14:07.42,Default,,0,0,0,,‫ومع ذلك، لا أظنّ أنّني\N‫رأيته بهذا الغضب قطّ.
Dialogue: 0,0:14:09.13,0:14:10.67,Default,,0,0,0,,‫-أين—؟\N‫-بطيء جدًّا!
Dialogue: 0,0:14:18.64,0:14:21.68,Default,,0,0,0,,‫أتقنت عائلة أزوما فنونها\N‫القتاليّة عبر الأجيال.
Dialogue: 0,0:14:21.89,0:14:25.10,Default,,0,0,0,,‫إنّه فنّ، مميت للبشر\N‫والمونونوكي على حدّ سواء.
Dialogue: 0,0:14:25.69,0:14:26.85,Default,,0,0,0,,‫يا فتى!
Dialogue: 0,0:14:27.52,0:14:30.11,Default,,0,0,0,,‫لم تسنح لي الفرصة\N‫سوى لتعليمك الأساسيّات.
Dialogue: 0,0:14:30.52,0:14:33.11,Default,,0,0,0,,‫وكوسيلة للدّفاع عن النّفس، كان ذلك كافيًا.
Dialogue: 0,0:14:33.57,0:14:36.11,Default,,0,0,0,,‫-احترس، مهلًا!\N‫-لكن الآن، كلّ شيء...
Dialogue: 0,0:14:36.36,0:14:39.53,Default,,0,0,0,,‫أنا من سيُدمّر كلّ شيء.
Dialogue: 0,0:14:39.66,0:14:40.99,Default,,0,0,0,,‫بهذا المعدّل، سأضطرّ إلى—
Dialogue: 0,0:14:41.08,0:14:42.50,Default,,0,0,0,,‫يا لها من خسارة.
Dialogue: 0,0:14:43.75,0:14:46.00,Default,,0,0,0,,‫على الأقلّ لن تعاني بعد الآن...
Dialogue: 0,0:14:46.29,0:14:47.88,Default,,0,0,0,,‫ستكون نهاية سريعة!
Dialogue: 0,0:14:51.80,0:14:53.09,Default,,0,0,0,,‫ر-راغو!
Dialogue: 0,0:14:57.13,0:14:58.89,Italics,,0,0,0,,‫فيمَ تفكّر يا فتى؟
Dialogue: 0,0:14:59.26,0:15:00.68,Italics,,0,0,0,,‫أتريد الموت؟
Dialogue: 0,0:15:00.93,0:15:03.39,Italics,,0,0,0,,‫جدّك يحاول قتلك بجدّيّة!
Dialogue: 0,0:15:03.60,0:15:05.89,Italics,,0,0,0,,‫سأُساعدك، لكي—
Dialogue: 0,0:15:06.98,0:15:08.90,Default,,0,0,0,,‫ابتعد عن طريقي.
Dialogue: 0,0:15:11.27,0:15:13.65,Default,,0,0,0,,‫أخبرتك ألّا تخرج حتّى أسمح لك.
Dialogue: 0,0:15:14.74,0:15:16.40,Default,,0,0,0,,لا تتدخّل، مفهوم؟
Dialogue: 0,0:15:17.36,0:15:18.74,Italics,,0,0,0,,‫أهكذا إذًا؟
Dialogue: 0,0:15:18.82,0:15:20.70,Italics,,0,0,0,,‫حسنًا، افعل ما تشاء!
Dialogue: 0,0:15:20.87,0:15:22.28,Italics,,0,0,0,,‫يا لك من غبيّ أحمق!
Dialogue: 0,0:15:22.91,0:15:25.29,Default,,0,0,0,,‫توشيماسا، توشيماسا!
Dialogue: 0,0:15:25.54,0:15:26.37,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:15:26.96,0:15:28.21,Default,,0,0,0,,‫ماذا هناك يا ناتشي؟
Dialogue: 0,0:15:28.29,0:15:31.54,Default,,0,0,0,,‫لا أظنّ أنّ هذا وقت الاسترخاء مع الصّحيفة!
Dialogue: 0,0:15:31.63,0:15:32.88,Default,,0,0,0,,‫إنّه جيرو...
Dialogue: 0,0:15:34.26,0:15:36.63,Default,,0,0,0,,‫أ-أنا بخير، أنا بخير.
Dialogue: 0,0:15:36.88,0:15:39.64,Default,,0,0,0,,‫بهدوء وثبات...
Dialogue: 0,0:15:39.97,0:15:42.64,Default,,0,0,0,,‫عليّ فقط العودة من حيث—
Dialogue: 0,0:15:48.27,0:15:49.69,Default,,0,0,0,,‫عـ-عُذرًا...
Dialogue: 0,0:15:50.06,0:15:52.31,Default,,0,0,0,,‫ا-التقاطة جيّدة؟
Dialogue: 0,0:15:54.07,0:15:55.94,Default,,0,0,0,,‫أيّها الأبله الأخرق!
Dialogue: 0,0:15:56.49,0:15:59.99,Default,,0,0,0,,‫تعلم أنّه لا ينبغي تسلّق\N‫شجرة لا يمكنك النّزول منها!
Dialogue: 0,0:16:00.32,0:16:03.20,Default,,0,0,0,,‫سينتهي بك المطاف بقتل نفسك، أتعلم ذلك؟
Dialogue: 0,0:16:04.08,0:16:05.45,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:16:05.79,0:16:07.62,Default,,0,0,0,,‫لم يستطع النّزول...
Dialogue: 0,0:16:07.79,0:16:09.96,Default,,0,0,0,,‫كان يبكي!
Dialogue: 0,0:16:10.04,0:16:11.13,Default,,0,0,0,,‫لهذا السّبب أنا...
Dialogue: 0,0:16:12.59,0:16:15.67,Default,,0,0,0,,‫اسمع يا جيرو، مساعدة\N‫الآخرين أمر نبيل حقًّا.
Dialogue: 0,0:16:16.21,0:16:19.47,Default,,0,0,0,,‫لكن عليك أن تملك\N‫القوّة والعزيمة لفعل ذلك.
Dialogue: 0,0:16:19.76,0:16:21.51,Default,,0,0,0,,‫إنّه تهوّر دون الصّلابة المناسبة.
Dialogue: 0,0:16:21.59,0:16:23.47,Default,,0,0,0,,‫وإنّه انعدام للمسؤوليّة\N‫دون العزيمة الكافية.
Dialogue: 0,0:16:23.60,0:16:25.31,Default,,0,0,0,,‫حاليًا، لا يزال ‫أمامك طريق طويل في كليهما.
Dialogue: 0,0:16:25.35,0:16:26.72,Default,,0,0,0,,‫لا تزال نصف رجل.
Dialogue: 0,0:16:27.02,0:16:28.35,Default,,0,0,0,,‫وما دمت لا تزال نصف رجل،
Dialogue: 0,0:16:28.39,0:16:31.23,Default,,0,0,0,,‫عليك أن تطلب المساعدة ممّن حولك.
Dialogue: 0,0:16:31.98,0:16:34.86,Default,,0,0,0,,‫لكن ماذا لو لم يكن حولي أحد ليُساعدني؟
Dialogue: 0,0:16:34.98,0:16:36.48,Default,,0,0,0,,‫شقيّ مجادل...
Dialogue: 0,0:16:36.78,0:16:38.99,Default,,0,0,0,,‫إذًا أظنّ أنّه لا خيار أمامك...
Dialogue: 0,0:16:39.15,0:16:39.99,Default,,0,0,0,,‫استسلم!
Dialogue: 0,0:16:40.07,0:16:41.07,Default,,0,0,0,,‫مستحيل!
Dialogue: 0,0:16:41.11,0:16:41.95,Default,,0,0,0,,
Dialogue: 0,0:16:41.99,0:16:42.99,Default,,0,0,0,,‫أنت عنيد.
Dialogue: 0,0:16:43.70,0:16:44.99,Default,,0,0,0,,‫لذا...
Dialogue: 0,0:16:46.83,0:16:48.16,Default,,0,0,0,,‫كُن قويًّا يا جيرو.
Dialogue: 0,0:16:48.58,0:16:50.92,Default,,0,0,0,,‫عقلًا وجسدًا.
Dialogue: 0,0:16:51.58,0:16:56.00,Default,,0,0,0,,‫إن تمكّنت من ذلك، فلن تصعب عليك أيّ شجرة.
Dialogue: 0,0:16:56.42,0:16:59.13,Default,,0,0,0,,‫حتّى ذلك الحين، لا تبالغ.
Dialogue: 0,0:16:59.38,0:17:00.22,Default,,0,0,0,,‫أفهمت؟
Dialogue: 0,0:17:01.55,0:17:02.76,Default,,0,0,0,,‫أجل!
Dialogue: 0,0:17:02.97,0:17:04.35,Default,,0,0,0,,‫حسنًا يا جدّي!
Dialogue: 0,0:17:04.43,0:17:06.35,Default,,0,0,0,,‫لنبدأ تدريب اليوم!
Dialogue: 0,0:17:06.51,0:17:07.35,Default,,0,0,0,,
Dialogue: 0,0:17:07.39,0:17:09.77,Default,,0,0,0,,‫حسنًا، انظروا من يفيض بالطّاقة اليوم.
Dialogue: 0,0:17:10.56,0:17:12.52,Default,,0,0,0,,‫اسمع، واسمع جيّدًا يا جيرو.
Dialogue: 0,0:17:12.65,0:17:15.77,Default,,0,0,0,,‫هذه ليست جلسة تدريب، أو شجارًا تافهًا.
Dialogue: 0,0:17:16.32,0:17:18.69,Default,,0,0,0,,‫هذا صراع حياة أو موت لتحقيق غاياتنا.
Dialogue: 0,0:17:18.73,0:17:20.15,Default,,0,0,0,,‫طريق من الدّماء والموت.
Dialogue: 0,0:17:20.32,0:17:24.03,Default,,0,0,0,,‫هذا هو مسار العالم الّذي دخلته الآن.
Dialogue: 0,0:17:26.20,0:17:29.50,Default,,0,0,0,,‫ستذبح بني جنسك، والمونونوكي،
Dialogue: 0,0:17:29.58,0:17:31.16,Default,,0,0,0,,‫وفي خضمّ ذلك، ستذبح ذاتك السّابقة.
Dialogue: 0,0:17:32.08,0:17:34.21,Default,,0,0,0,,‫دماء كلّ من قتلتهم،
Dialogue: 0,0:17:34.38,0:17:37.04,Default,,0,0,0,,‫ستلطّخ جسدك وروحك.
Dialogue: 0,0:17:37.29,0:17:40.17,Default,,0,0,0,,‫إنّه عالم من الظّلال،\N‫مملكة تفتقر للنّور...
Dialogue: 0,0:17:40.34,0:17:42.68,Default,,0,0,0,,‫هذا هو العالم الّذي عشت فيه.
Dialogue: 0,0:17:44.47,0:17:47.68,Default,,0,0,0,,‫قاتلت لأحميك يا حفيدي...
Dialogue: 0,0:17:49.89,0:17:53.44,Default,,0,0,0,,‫كي لا تضطرّ أبدًا لوضع\N‫قدمك في تلك الجحيم.
Dialogue: 0,0:17:56.73,0:17:58.61,Default,,0,0,0,,‫آسف.
Dialogue: 0,0:17:58.86,0:18:00.90,Default,,0,0,0,,‫لم أكن أُفكّر، كنت غبيًّا.
Dialogue: 0,0:18:02.19,0:18:05.20,Default,,0,0,0,,‫لكنّني لا أملك أيّ ندم!
Dialogue: 0,0:18:05.66,0:18:07.70,Default,,0,0,0,,‫تدخّلت فيما لا يعنيني.
Dialogue: 0,0:18:08.53,0:18:09.45,Default,,0,0,0,,‫لهذا السّبب...
Dialogue: 0,0:18:09.95,0:18:12.16,Default,,0,0,0,,‫سأكتشف كيف أُصلح فوضاي بنفسي!
Dialogue: 0,0:18:12.29,0:18:14.33,Default,,0,0,0,,‫هذه هي عزيمتي!
Dialogue: 0,0:18:17.00,0:18:17.84,Default,,0,0,0,,‫أنت...
Dialogue: 0,0:18:18.29,0:18:19.84,Default,,0,0,0,,‫أحمق جاهل!
Dialogue: 0,0:18:21.01,0:18:21.88,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:18:21.92,0:18:23.67,Default,,0,0,0,,‫آسف يا راغو.
Dialogue: 0,0:18:23.76,0:18:25.18,Default,,0,0,0,,‫تماسك فقط...
Dialogue: 0,0:18:26.34,0:18:27.18,Default,,0,0,0,,‫لفترة أطول قليلًا.
Dialogue: 0,0:18:45.61,0:18:47.41,Default,,0,0,0,,‫طفل غبيّ.
Dialogue: 0,0:18:47.57,0:18:49.58,Default,,0,0,0,,‫فيمَ كنت تفكّر؟
Dialogue: 0,0:18:50.08,0:18:52.16,Default,,0,0,0,,‫هذا ما أُفكّر فيه بالضبط!
Dialogue: 0,0:18:52.62,0:18:54.54,Default,,0,0,0,,‫فيمَ كنت تفكّر يا جيرو؟
Dialogue: 0,0:18:54.71,0:18:58.92,Default,,0,0,0,,‫أكان هذا مجرّد استعراض لقوّتك وعزيمتك؟
Dialogue: 0,0:18:59.50,0:19:01.92,Default,,0,0,0,,‫انتبه لنفسك، لا أزال أرى نصف رجل أمامي.
Dialogue: 0,0:19:04.92,0:19:07.18,Default,,0,0,0,,‫لا يزال هذا غير كافٍ لك إذًا؟
Dialogue: 0,0:19:08.09,0:19:09.34,Default,,0,0,0,,‫أتعلم يا جدّي...
Dialogue: 0,0:19:09.76,0:19:12.81,Default,,0,0,0,,‫في السّرّاء والضّرّاء،\N‫لم أعد وحيدًا بعد الآن.
Dialogue: 0,0:19:13.27,0:19:15.06,Default,,0,0,0,,‫الأمر كما قلت.
Dialogue: 0,0:19:15.60,0:19:16.81,Default,,0,0,0,,‫ما دمت لا أزال نصف رجل،
Dialogue: 0,0:19:16.89,0:19:18.81,Default,,0,0,0,,‫ينبغي أن أحصل على المساعدة ممّن حولي.
Dialogue: 0,0:19:19.48,0:19:20.31,Default,,0,0,0,,‫لذا...
Dialogue: 0,0:19:20.94,0:19:22.78,Default,,0,0,0,,‫سأحصل على القليل من\N‫المساعدة من هذا الرّفيق!
Dialogue: 0,0:19:23.44,0:19:25.32,Default,,0,0,0,,‫لا يمكنني الجدال في هذا...
Dialogue: 0,0:19:27.03,0:19:28.07,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:19:29.24,0:19:30.07,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:19:30.28,0:19:32.45,Default,,0,0,0,,‫لا تسألني "ماذا"! أنت تعلم عمّا أتحدّث!
Dialogue: 0,0:19:32.53,0:19:33.74,Default,,0,0,0,,‫تعلم، حركة الاندماج!
Dialogue: 0,0:19:33.79,0:19:35.08,Default,,0,0,0,,‫وكيف لي أن أعرف ذلك أيّها الأبله؟!
Dialogue: 0,0:19:37.29,0:19:39.54,Flashback,,0,0,0,,{\fad(200,0)}‫ما دمت لا تزال نصف رجل،
Dialogue: 0,0:19:39.96,0:19:42.67,Flashback,,0,0,0,,‫عليك أن تطلب المساعدة ممّن حولك.
Dialogue: 0,0:19:43.63,0:19:44.67,Italics,,0,0,0,,‫فهمت.
Dialogue: 0,0:19:45.34,0:19:48.51,Italics,,0,0,0,,‫بالنّسبة لجيرو، تصنيف البشر،\N‫أو الحيوانات، أو حتّى المونونوكي،
Dialogue: 0,0:19:48.59,0:19:49.68,Italics,,0,0,0,,‫لا يهمّ...
Dialogue: 0,0:19:50.05,0:19:52.43,Italics,,0,0,0,,‫إنّه يعاملهم جميعًا بالمثل.
Dialogue: 0,0:19:55.35,0:19:56.68,Default,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:19:56.77,0:20:00.06,Default,,0,0,0,,‫لا يزال ذلك الفتى العنيد والمجادل.
Dialogue: 0,0:20:00.60,0:20:01.44,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:20:01.65,0:20:04.61,Default,,0,0,0,,‫مهما أخبرتك أو مهما تأذّيت بشدّة،
Dialogue: 0,0:20:04.69,0:20:07.19,Default,,0,0,0,,‫لا أظنّ أنّك ستتغيّر أبدًا.
Dialogue: 0,0:20:08.40,0:20:10.07,Default,,0,0,0,,‫حسنًا، فزت.
Dialogue: 0,0:20:10.28,0:20:11.78,Default,,0,0,0,,‫ أستسلم.
Dialogue: 0,0:20:11.99,0:20:14.45,Default,,0,0,0,,‫يبدو أنّ من يفتقر للعزيمة...
Dialogue: 0,0:20:14.54,0:20:16.08,Default,,0,0,0,,‫هو أنا.
Dialogue: 0,0:20:16.83,0:20:19.04,Default,,0,0,0,,‫افعل ما تشاء.
Dialogue: 0,0:20:19.33,0:20:20.71,Default,,0,0,0,,‫لا تزال أحمق...
Dialogue: 0,0:20:23.21,0:20:24.21,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:20:27.17,0:20:28.76,Default,,0,0,0,,‫مؤلم، مؤلم...
Dialogue: 0,0:20:31.22,0:20:33.76,Default,,0,0,0,,‫إنّه يلسع، لكن لا شيء\N‫يضاهي حمّامًا ساخنًا جيّدًا.
Dialogue: 0,0:20:34.10,0:20:37.10,Default,,0,0,0,,‫كُفّ عن التّحدّث كالعجائز أيّها الحثالة.
Dialogue: 0,0:20:37.18,0:20:38.73,Default,,0,0,0,,‫أخرس.
Dialogue: 0,0:20:38.81,0:20:40.89,Default,,0,0,0,,‫فقط ابقَ خارج حوض الاستحمام\N‫ما دمت فيه أيّها القطّ القذر.
Dialogue: 0,0:20:41.77,0:20:42.60,Default,,0,0,0,,‫أجل.
Dialogue: 0,0:20:43.19,0:20:44.73,Default,,0,0,0,,‫آسف بشأن ما حدث سابقًا.
Dialogue: 0,0:20:44.98,0:20:46.73,Default,,0,0,0,,‫جررتك معي، مفكّرًا في نفسي فقط.
Dialogue: 0,0:20:48.07,0:20:50.70,Default,,0,0,0,,‫لا يزعجني الأمر. فعلت ذلك بنفسك.
Dialogue: 0,0:20:50.90,0:20:53.99,Default,,0,0,0,,‫لكن لكلّ شخص حدوده.
Dialogue: 0,0:20:54.53,0:20:58.00,Default,,0,0,0,,‫من الأفضل ألّا تتسرّع،\N‫وتطرق باب الموت وحدك.
Dialogue: 0,0:20:58.54,0:21:00.21,Default,,0,0,0,,‫أعني، لا تذهب وتمت مجدّدًا.
Dialogue: 0,0:21:00.29,0:21:02.75,Default,,0,0,0,,‫وإلّا سأكون قد أنقذتك هباءً.
Dialogue: 0,0:21:03.08,0:21:05.96,Default,,0,0,0,,‫لذا، حسنًا... أظنّ...
Dialogue: 0,0:21:06.75,0:21:09.59,Default,,0,0,0,,‫إن لزم الأمر، سأُعيرك قواي.
Dialogue: 0,0:21:09.84,0:21:11.76,Default,,0,0,0,,‫لكن من الأفضل أن تُقدّر ذلك.
Dialogue: 0,0:21:12.55,0:21:14.43,Default,,0,0,0,,‫هذا كلّ ما سأقوله.
Dialogue: 0,0:21:16.01,0:21:19.39,Default,,0,0,0,,‫حسنًا، لا أملك أدنى\N‫فكرة عمّا ينتظرنا تاليًا،
Dialogue: 0,0:21:19.85,0:21:22.52,Default,,0,0,0,,‫لكنّنا معًا في هذا.
Dialogue: 0,0:21:22.77,0:21:24.94,Default,,0,0,0,,‫لذا لنحاول التّوافق.
Dialogue: 0,0:21:25.31,0:21:26.27,Default,,0,0,0,,‫أيبدو هذا جيّدًا؟
Dialogue: 0,0:21:26.40,0:21:27.69,Default,,0,0,0,,‫يا شريكي؟
Dialogue: 0,0:21:29.82,0:21:32.65,Italics,,0,0,0,,‫سنُرسل مركبة إلى بيتك صباح الغد.
Dialogue: 0,0:21:32.86,0:21:34.78,Italics,,0,0,0,,‫يُرجى أن تكون مستعدًّا.
Dialogue: 0,0:21:35.12,0:21:37.53,Default,,0,0,0,,‫يا لك من كريم على غير العادة يا شيبا.
Dialogue: 0,0:21:37.78,0:21:39.20,Italics,,0,0,0,,‫حسنًا، بالطّبع.
Dialogue: 0,0:21:39.41,0:21:41.79,Italics,,0,0,0,,‫ نثق بك تمامًا يا أزوما-سان.
Dialogue: 0,0:21:42.21,0:21:43.21,Default,,0,0,0,,‫عليك أن أعترف،
Dialogue: 0,0:21:43.25,0:21:45.75,Default,,0,0,0,,‫حين سمعت أنّه هرب من\N‫المستشفى ووصل للبيت،
Dialogue: 0,0:21:45.83,0:21:47.29,Default,,0,0,0,,‫شعرت بالرّاحة.
Dialogue: 0,0:21:47.96,0:21:50.05,Italics,,0,0,0,,‫وماذا تقصد بذلك؟
Dialogue: 0,0:21:51.13,0:21:52.55,Default,,0,0,0,,‫هل أحتاج حقًّا للشّرح؟
Dialogue: 0,0:21:52.76,0:21:54.68,Italics,,0,0,0,,‫- يا جدّي!\N‫-سيكون واحدًا منّا.
Dialogue: 0,0:21:54.80,0:21:56.80,Italics,,0,0,0,,‫-نفد الصّابون.\N‫-شخص طموح، ورائد...
Dialogue: 0,0:21:56.85,0:21:59.43,Italics,,0,0,0,,‫إنّه بالضبط نوع الأشخاص الّذي نحتاجه.
Dialogue: 0,0:22:00.14,0:22:02.77,Italics,,0,0,0,,‫أملك الكثير لأُجهّزه...
Dialogue: 0,0:22:02.81,0:22:04.69,Italics,,0,0,0,,‫أراك لاحقًا.
Dialogue: 0,0:22:05.65,0:22:08.36,Italics,,0,0,0,,‫جدّي! يا جدّي!
