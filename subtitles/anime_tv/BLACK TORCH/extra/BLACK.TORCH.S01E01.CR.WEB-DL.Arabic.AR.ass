Dialogue: 0,0:00:08.63,0:00:10.18,Italics,,0,0,0,,‫ما الخطبُ يا جيرو؟
Dialogue: 0,0:00:10.26,0:00:11.85,Italics,,0,0,0,,هل تشاجرت مجددًا؟
Dialogue: 0,0:00:12.43,0:00:13.43,Italics,,0,0,0,,‫حسنًا...
Dialogue: 0,0:00:13.64,0:00:15.56,Italics,,0,0,0,,‫سخرَ الفتيةُ منّي مجددًا.
Dialogue: 0,0:00:15.81,0:00:22.48,Default,SIGN,0,0,0,,{\an8}‫ناتشي
Dialogue: 0,0:00:16.27,0:00:18.56,Italics,,0,0,0,,‫زعموا أنّي غريبُ أطوارٍ يكلّمُ الحيوانات.
Dialogue: 0,0:00:18.64,0:00:19.98,Italics,,0,0,0,,‫وبأنّي "مختلف".
Dialogue: 0,0:00:20.06,0:00:21.27,Italics,,0,0,0,,‫عزيزي...
Dialogue: 0,0:00:21.31,0:00:23.33,Italics,,0,0,0,,‫أعلمُ أنّ الأمر ليس سهلًا.
Dialogue: 0,0:00:23.86,0:00:25.19,Italics,,0,0,0,,‫ولكن أتعلم يا جيرو...
Dialogue: 0,0:00:25.32,0:00:28.82,Italics,,0,0,0,,‫أن تكون مختلفًا هو أمرٌ جميلٌ حقًا.
Dialogue: 0,0:00:30.32,0:00:36.74,Default,SIGN,0,0,0,,{\an8}‫ناتشي
Dialogue: 0,0:00:30.49,0:00:31.32,Italics,,0,0,0,,لماذا؟
Dialogue: 0,0:00:31.41,0:00:36.37,Italics,,0,0,0,,‫لأنك تملكُ مواهبَ فريدةً تخصّك وحدك.
Dialogue: 0,0:00:39.00,0:00:41.00,Italics,,0,0,0,,‫حسنًا، لا أفهمُ هذا.
Dialogue: 0,0:00:42.29,0:00:45.09,Italics,,0,0,0,,‫ستفهمُ يومًا ما، أعِدك!
Dialogue: 0,0:02:18.80,0:02:23.35,Default,SIGN,0,0,0,,{\an8}‫#1 المستقبل بين أيدينا
Dialogue: 0,0:02:20.10,0:02:23.81,Default,,0,0,0,,‫أنت، أتملكُ أدنى فكرةٍ عمّن تعبثُ معه؟
Dialogue: 0,0:02:23.89,0:02:26.23,Default,,0,0,0,,‫السينباي خاصتنا هو زعيمُ عصبة الشياطين!
Dialogue: 0,0:02:26.31,0:02:28.31,Default,,0,0,0,,‫نُحكمُ قبضتنا على كلّ شبرٍ في هذا المكان!
Dialogue: 0,0:02:29.11,0:02:30.57,Default,,0,0,0,,‫ولِمَ قد أهتم؟
Dialogue: 0,0:02:31.36,0:02:33.61,Default,,0,0,0,,‫لستَ سوى حثالةٍ يختبئ خلف حثالةٍ أكبر منه،
Dialogue: 0,0:02:33.65,0:02:34.74,Default,,0,0,0,,‫متصنّعٌ عديمُ النفع.
Dialogue: 0,0:02:34.78,0:02:36.07,Default,,0,0,0,,‫ماذا قُلـ—؟!
Dialogue: 0,0:02:36.57,0:02:38.24,Default,,0,0,0,,‫أيها الـ...! سحقًا!
Dialogue: 0,0:02:38.32,0:02:41.04,Default,,0,0,0,,‫أيها الوغدُ السليط!
Dialogue: 0,0:02:41.12,0:02:42.33,Default,,0,0,0,,‫مـ—؟ لقد...
Dialogue: 0,0:02:42.41,0:02:43.41,Default,,0,0,0,,‫انطلتْ عليك!
Dialogue: 0,0:02:46.17,0:02:48.25,Default,,0,0,0,,‫تُسمّى أوتسوسيمي، أفهمتَ أيها المغفل؟
Dialogue: 0,0:02:48.42,0:02:50.67,Default,,0,0,0,,‫والآن اهدأ قليلًا.
Dialogue: 0,0:02:50.96,0:02:52.84,Default,,0,0,0,,‫مـ-من هذا المعتوه؟
Dialogue: 0,0:02:53.01,0:02:54.17,Default,,0,0,0,,‫يبدو كنينجا!
Dialogue: 0,0:02:54.38,0:02:55.88,Default,,0,0,0,,‫ما الخطبُ الآن؟
Dialogue: 0,0:02:56.05,0:02:58.43,Default,,0,0,0,,‫يمكنُ لكليكما أن تتذوّقا\N‫من قبضتي، إن أردتما ذلك بشدة.
Dialogue: 0,0:02:59.89,0:03:03.06,Default,,0,0,0,,‫حثالةٌ مثيرون للشفقة!
Dialogue: 0,0:03:04.68,0:03:06.44,Default,,0,0,0,,‫من تظنّ نفسك؟
Dialogue: 0,0:03:12.07,0:03:12.90,Default,,0,0,0,,
Dialogue: 0,0:03:12.98,0:03:14.57,Default,,0,0,0,,‫حمقى يضيّعون وقتي.
Dialogue: 0,0:03:14.82,0:03:17.57,Default,,0,0,0,,‫ أنقذتنا حقًا!
Dialogue: 0,0:03:19.41,0:03:21.08,Default,,0,0,0,,‫نحنُ مدينون لك يا جيرو!
Dialogue: 0,0:03:21.53,0:03:24.37,Default,,0,0,0,,‫أرعبونا كثيرًا في الآونة الأخيرة!
Dialogue: 0,0:03:24.83,0:03:27.33,Default,,0,0,0,,‫على الأقل سيتركوننا وشأننا الآن.
Dialogue: 0,0:03:27.75,0:03:29.63,Default,,0,0,0,,‫لكنّي قلقٌ عليك يا جيرو.
Dialogue: 0,0:03:29.83,0:03:32.50,Default,,0,0,0,,‫سيستشيطون غضبًا منك الآن.
Dialogue: 0,0:03:32.92,0:03:34.09,Default,,0,0,0,,‫ لا تقلق!
Dialogue: 0,0:03:34.51,0:03:36.30,Default,,0,0,0,,‫اعتدتُ على الأمر تمامًا.
Dialogue: 0,0:03:36.59,0:03:37.88,Default,,0,0,0,,‫إنها تلك النظرةُ التي ترمقهم بها...
Dialogue: 0,0:03:37.97,0:03:40.60,Default,,0,0,0,,‫أنتَ تستفزّ الناس حقًا يا جيرو!
Dialogue: 0,0:03:40.89,0:03:41.89,Default,,0,0,0,,‫اخرس!
Dialogue: 0,0:03:41.93,0:03:43.10,Default,,0,0,0,,‫أتريدُ أن تصير ياكيتوري؟
Dialogue: 0,0:03:44.85,0:03:46.48,Default,,0,0,0,,‫حسنًا، أراك لاحقًا!
Dialogue: 0,0:03:46.56,0:03:49.60,Default,,0,0,0,,‫وحاولا إبقاء أنفيكما\N‫بعيدًا عن القمامة، حسنًا؟
Dialogue: 0,0:03:50.02,0:03:52.11,Default,,0,0,0,,‫-إلى اللقاء!\N‫-إلى اللقاء!
Dialogue: 0,0:03:53.07,0:03:54.11,Default,,0,0,0,,‫سحقًا!
Dialogue: 0,0:03:54.15,0:03:55.61,Default,,0,0,0,,‫عقلك فارغ!
Dialogue: 0,0:03:55.86,0:03:56.74,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:03:56.86,0:03:59.11,Default,,0,0,0,,‫خُضتَ شجارًا آخر، أليس كذلك؟
Dialogue: 0,0:03:59.57,0:04:02.24,Default,,0,0,0,,‫كم مرةً عليّ إخبارك؟!
Dialogue: 0,0:04:02.45,0:04:04.91,Default,,0,0,0,,‫لم أعلّمك فنون الشينوبي
Dialogue: 0,0:04:05.04,0:04:07.12,Default,,0,0,0,,‫لتتصرّف كالمتسكعين!
Dialogue: 0,0:04:07.29,0:04:08.16,Default,,0,0,0,,‫اخرس!
Dialogue: 0,0:04:08.21,0:04:09.71,Default,,0,0,0,,‫وما النفعُ من الشينوبي أصلًا؟
Dialogue: 0,0:04:09.75,0:04:11.46,Default,,0,0,0,,‫-لستَ سوى ديناصور—\N‫-انتبه للفظك!
Dialogue: 0,0:04:13.46,0:04:14.67,Default,,0,0,0,,‫حسنًا يا جيرو...
Dialogue: 0,0:04:15.76,0:04:17.80,Default,,0,0,0,,‫هذا إرثُ عائلة أزوما.
Dialogue: 0,0:04:17.84,0:04:19.43,Default,,0,0,0,,‫سيفُ الشينوبيغاتانا المُبجّل خاصتنا!
Dialogue: 0,0:04:19.51,0:04:22.76,Default,,0,0,0,,‫كان ذلك في حقبة إيدو حين\N‫تلقّى أسلافك، من الشوغون شخصيًّا،
Dialogue: 0,0:04:22.80,0:04:24.93,Default,,0,0,0,,‫هذا النصلَ العريق والمشرّف.
Dialogue: 0,0:04:25.22,0:04:28.14,Default,,0,0,0,,‫لذا احترم جذورك وتصرّف\N‫كفردٍ حقيقيّ من أزوما!
Dialogue: 0,0:04:28.31,0:04:29.69,Default,,0,0,0,,‫أيها الأحمقُ الجاحد!
Dialogue: 0,0:04:31.23,0:04:33.31,Default,,0,0,0,,‫أجل صحيح... أراهنُ أنه مزيّفٌ وغير مؤذٍ.
Dialogue: 0,0:04:34.57,0:04:35.69,Default,,0,0,0,,‫حسنًا إذًا.
Dialogue: 0,0:04:36.19,0:04:38.65,Default,,0,0,0,,‫أتظنّه مزيّفًا...
Dialogue: 0,0:04:40.78,0:04:43.12,Default,,0,0,0,,‫انظر كم يبدو ثلمًا على جسدك!
Dialogue: 0,0:04:44.66,0:04:47.12,Default,,0,0,0,,‫دعني وشأني!
Dialogue: 0,0:04:48.58,0:04:49.46,Default,,0,0,0,,‫يا إلهي.
Dialogue: 0,0:04:49.54,0:04:50.96,Default,,0,0,0,,‫جُنّ العجوز حقًا.
Dialogue: 0,0:04:51.21,0:04:52.46,Default,,0,0,0,,‫أحفورةٌ مجنونة.
Dialogue: 0,0:04:52.54,0:04:54.21,Default,,0,0,0,,‫يا جيرو!
Dialogue: 0,0:04:54.38,0:04:55.21,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:04:55.55,0:04:57.59,Default,,0,0,0,,‫اجتماعُ جمعية البلدة الليلة.
Dialogue: 0,0:04:57.63,0:04:59.97,Default,,0,0,0,,‫لن أعودَ حتى وقتٍ متأخر.
Dialogue: 0,0:05:00.22,0:05:02.14,Default,,0,0,0,,‫لا تنسَ إقفال الباب.
Dialogue: 0,0:05:02.26,0:05:03.97,Default,,0,0,0,,‫اصمت أيها العجوز!
Dialogue: 0,0:05:04.51,0:05:05.35,Default,,0,0,0,,
Dialogue: 0,0:05:05.39,0:05:07.14,Default,,0,0,0,,‫لا تنسَ إقفال الباب، هراء.
Dialogue: 0,0:05:07.22,0:05:09.18,Default,,0,0,0,,‫من يظنّني، طفلًا في الابتدائية؟
Dialogue: 0,0:05:09.23,0:05:10.48,Default,,0,0,0,,‫يا جيرو!
Dialogue: 0,0:05:11.10,0:05:12.48,Default,,0,0,0,,‫من الآن؟
Dialogue: 0,0:05:13.15,0:05:14.65,Default,,0,0,0,,‫مهلًا، أتذكّرك.
Dialogue: 0,0:05:14.94,0:05:15.77,Default,,0,0,0,,‫ما الخطب؟
Dialogue: 0,0:05:15.86,0:05:17.48,Default,,0,0,0,,‫قطٌّ في ورطة، في الغابة!
Dialogue: 0,0:05:18.32,0:05:19.49,Default,,0,0,0,,‫قط؟
Dialogue: 0,0:05:22.07,0:05:24.24,Default,,0,0,0,,‫مهلًا، إلى أين تأخذني؟
Dialogue: 0,0:05:25.07,0:05:25.91,Default,,0,0,0,,‫هناك!
Dialogue: 0,0:05:25.95,0:05:27.24,Default,,0,0,0,,‫إنه هناك!
Dialogue: 0,0:05:29.50,0:05:30.79,Default,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:05:31.00,0:05:32.00,Default,,0,0,0,,‫ما الذي حدث؟
Dialogue: 0,0:05:32.58,0:05:33.83,Default,,0,0,0,,‫أتعرفه؟
Dialogue: 0,0:05:33.96,0:05:35.75,Default,,0,0,0,,‫كلا، لم أرهُ قط.
Dialogue: 0,0:05:36.25,0:05:38.63,Default,,0,0,0,,‫أظنّه لا يزال حيًّا،
Dialogue: 0,0:05:38.71,0:05:41.26,Default,,0,0,0,,‫لكنّ صياحي لا يلقى أيّ استجابة!
Dialogue: 0,0:05:41.51,0:05:42.51,Italics,,0,0,0,,‫تبًّا...
Dialogue: 0,0:05:42.59,0:05:44.26,Italics,,0,0,0,,‫هذا الصغيرُ متأذٍ حقًا.
Dialogue: 0,0:05:44.76,0:05:46.55,Italics,,0,0,0,,‫عليّ فعلُ شيءٍ ما!
Dialogue: 0,0:05:46.89,0:05:47.72,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:05:47.76,0:05:48.68,Default,,0,0,0,,‫أتسمعني؟
Dialogue: 0,0:05:48.85,0:05:50.81,Italics,,0,0,0,,‫-مهلًا! مهلًا!\N‫-من هناك؟
Dialogue: 0,0:05:51.56,0:05:53.31,Italics,,0,0,0,,‫من يجرؤ على مناداتي؟
Dialogue: 0,0:05:55.56,0:05:56.90,Italics,,0,0,0,,‫راغو...
Dialogue: 0,0:05:57.11,0:06:00.03,Italics,,0,0,0,,‫يا نجمَ الهلاك الأسود، يا مبتلعَ الشمس...
Dialogue: 0,0:06:00.65,0:06:04.28,Italics,,0,0,0,,‫استيقظ من سُباتك، وأعِرنا قوّتك.
Dialogue: 0,0:06:04.78,0:06:06.32,Italics,,0,0,0,,‫اغرب عن وجهي!
Dialogue: 0,0:06:06.53,0:06:08.87,Italics,,0,0,0,,‫ستندم على مقاطعتك لقيلولتي.
Dialogue: 0,0:06:08.95,0:06:11.96,Italics,,0,0,0,,‫لا أتلقّى أوامرَ من أحد، مفهوم؟
Dialogue: 0,0:06:12.12,0:06:13.50,Italics,,0,0,0,,‫فهمت...
Dialogue: 0,0:06:13.71,0:06:16.96,Italics,,0,0,0,,‫إنه لأمرٌ مؤسفٌ حقًا...
Dialogue: 0,0:06:17.42,0:06:20.13,Italics,,0,0,0,,‫إذًا هنا ستلفظُ أنفاسك الأخيرة!
Dialogue: 0,0:06:33.27,0:06:35.31,Default,,0,0,0,,‫ فتحتَ عينيك!
Dialogue: 0,0:06:35.94,0:06:37.77,Default,,0,0,0,,‫لا بدّ أنك عطش!
Dialogue: 0,0:06:38.19,0:06:39.57,Default,,0,0,0,,‫كنتَ في حالةٍ يُرثى لها،
Dialogue: 0,0:06:39.65,0:06:41.69,Default,,0,0,0,,‫لم أظنّ أنك ستنجو.
Dialogue: 0,0:06:41.99,0:06:44.57,Default,,0,0,0,,‫لكنك صغيرٌ صلب!
Dialogue: 0,0:06:45.07,0:06:46.28,Default,,0,0,0,,‫أنا جيرو.
Dialogue: 0,0:06:46.36,0:06:48.28,Default,,0,0,0,,‫ومن أنت؟
Dialogue: 0,0:06:49.53,0:06:50.66,Default,,0,0,0,,‫هيّا!
Dialogue: 0,0:06:50.79,0:06:52.83,Default,,0,0,0,,‫حتى المشرّدون يملكون أسماء.
Dialogue: 0,0:06:53.87,0:06:55.29,Default,,0,0,0,,‫أتعاملُ مع أبله.
Dialogue: 0,0:06:55.75,0:06:57.71,Default,,0,0,0,,‫وكأنك ستفهمُ إن أخبرتك!
Dialogue: 0,0:06:58.25,0:06:59.34,Default,,0,0,0,,‫أنا أبله إذًا؟
Dialogue: 0,0:06:59.38,0:07:01.84,Default,,0,0,0,,‫سأركلُ مؤخرتك المكسوّة بالفرو!
Dialogue: 0,0:07:03.59,0:07:04.42,Default,,0,0,0,,‫أنت...
Dialogue: 0,0:07:04.59,0:07:06.68,Default,,0,0,0,,‫لا تكن قطًّا جبانًا!
Dialogue: 0,0:07:09.10,0:07:11.76,Default,,0,0,0,,‫اسمع، هذه محادثتك الأولى مع بشريّ.
Dialogue: 0,0:07:11.85,0:07:14.06,Default,,0,0,0,,‫أعلمُ أنه أمرٌ يصعبُ استيعابه.
Dialogue: 0,0:07:14.39,0:07:15.85,Default,,0,0,0,,‫لن آكلك على أيّ حال!
Dialogue: 0,0:07:15.89,0:07:16.85,Default,,0,0,0,,‫اخرج!
Dialogue: 0,0:07:17.19,0:07:19.11,Italics,,0,0,0,,‫لا أستشعرُ أيّ طاقةٍ طيفية.
Dialogue: 0,0:07:19.15,0:07:20.94,Italics,,0,0,0,,‫إنه بشريّ، لا شكّ في ذلك.
Dialogue: 0,0:07:21.15,0:07:22.23,Italics,,0,0,0,,‫إذًا لا بدّ أنه...
Dialogue: 0,0:07:22.28,0:07:23.11,Italics,,0,0,0,,‫لا.
Dialogue: 0,0:07:23.40,0:07:24.24,Default,,0,0,0,,‫تبًا...
Dialogue: 0,0:07:24.28,0:07:25.95,Default,,0,0,0,,‫هذا مؤسف.
Dialogue: 0,0:07:26.32,0:07:27.61,Default,,0,0,0,,‫حان وقتُ سلاحي السرّي.
Dialogue: 0,0:07:28.53,0:07:31.12,Italics,,0,0,0,,‫لن تُخرجني من هنا ولو بعتلة.
Dialogue: 0,0:07:35.54,0:07:36.83,Default,,0,0,0,,‫حسنًا، كان هذا سهلًا!
Dialogue: 0,0:07:40.59,0:07:41.92,Default,,0,0,0,,‫أتعلمُ ما يقولون...
Dialogue: 0,0:07:41.96,0:07:44.01,Default,,0,0,0,,‫أقربُ طريقٍ لقلب الرجل هو معدته.
Dialogue: 0,0:07:44.26,0:07:45.13,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:07:45.63,0:07:48.38,Default,,0,0,0,,‫مضحك، قطٌّ يظنّ نفسه رجلًا.
Dialogue: 0,0:07:48.63,0:07:50.14,Default,,0,0,0,,‫لستُ قطًّا!
Dialogue: 0,0:07:50.30,0:07:51.89,Default,,0,0,0,,‫ماذا تقصد؟
Dialogue: 0,0:07:54.47,0:07:56.18,Default,,0,0,0,,‫اسمي راغو.
Dialogue: 0,0:07:56.56,0:07:58.39,Default,,0,0,0,,‫أنا خالد...
Dialogue: 0,0:07:58.56,0:07:59.90,Default,,0,0,0,,‫مونونوكي.
Dialogue: 0,0:08:00.27,0:08:02.65,Default,,0,0,0,,‫مونونوكي؟
Dialogue: 0,0:08:02.98,0:08:04.90,Default,,0,0,0,,‫يملكُ الناس أسماءً كثيرةً لهم.
Dialogue: 0,0:08:05.07,0:08:07.65,Default,,0,0,0,,‫كلّ ما عليك معرفته هو أنهم موجودون.
Dialogue: 0,0:08:07.99,0:08:09.28,Italics,,0,0,0,,‫ممتاز...
Dialogue: 0,0:08:09.45,0:08:11.66,Italics,,0,0,0,,‫أظنّني قادرًا على جعله يعترف.
Dialogue: 0,0:08:12.66,0:08:15.54,Default,,0,0,0,,‫نتّخذُ هيئةَ بشرٍ أو\N‫حيواناتٍ في أغلب الأحيان،
Dialogue: 0,0:08:15.70,0:08:18.29,Default,,0,0,0,,‫ولا يدركُ العالمُ شيئًا.
Dialogue: 0,0:08:18.58,0:08:19.83,Default,,0,0,0,,‫والبعضُ منّا...
Dialogue: 0,0:08:19.92,0:08:22.92,Default,,0,0,0,,‫يعيشُ في الجبال أو في\N‫أعماق الغابات بعزلة.
Dialogue: 0,0:08:23.17,0:08:24.17,Default,,0,0,0,,
Dialogue: 0,0:08:24.63,0:08:25.46,Default,,0,0,0,,‫وماذا أيضًا؟
Dialogue: 0,0:08:25.67,0:08:29.43,Default,,0,0,0,,‫كيف انتهى المطافُ بمونونوكي مثلك هكذا؟
Dialogue: 0,0:08:29.68,0:08:32.10,Italics,,0,0,0,,‫إذًا لا يخادع...
Dialogue: 0,0:08:32.51,0:08:35.18,Italics,,0,0,0,,‫لا يملكُ أدنى فكرةٍ حقًا.
Dialogue: 0,0:08:35.43,0:08:36.35,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:08:36.64,0:08:38.02,Default,,0,0,0,,‫أهذا من المحرّمات؟
Dialogue: 0,0:08:38.52,0:08:39.94,Default,,0,0,0,,‫تعرّضتُ لهجوم...
Dialogue: 0,0:08:40.02,0:08:41.35,Default,,0,0,0,,‫من مونونوكي آخر.
Dialogue: 0,0:08:41.60,0:08:42.56,Default,,0,0,0,,‫ما الذي حدث؟
Dialogue: 0,0:08:42.98,0:08:44.27,Default,,0,0,0,,‫خلافٌ ما؟
Dialogue: 0,0:08:44.32,0:08:46.86,Default,,0,0,0,,‫لا أتذكّرُ الكثير عنه.
Dialogue: 0,0:08:47.19,0:08:49.82,Default,,0,0,0,,‫كنتُ غارقًا في سُباتٍ عميق، ولوقتٍ طويل.
Dialogue: 0,0:08:50.15,0:08:53.03,Default,,0,0,0,,‫وما أدركته تاليًا هو إيقاظي.
Dialogue: 0,0:08:53.24,0:08:56.20,Default,,0,0,0,,‫حاصرني أولئك الأوغادُ الماكرون.
Dialogue: 0,0:08:57.12,0:09:01.04,Default,,0,0,0,,‫وطالبوا بمساعدتي.
Dialogue: 0,0:09:01.58,0:09:04.09,Default,,0,0,0,,‫أخبرتهم أنّي غير مهتم،\N‫وبأن يغربوا عن وجهي...
Dialogue: 0,0:09:04.17,0:09:05.80,Default,,0,0,0,,‫فهمتُ الآن...
Dialogue: 0,0:09:06.05,0:09:07.96,Default,,0,0,0,,‫لذا تكالبوا عليك.
Dialogue: 0,0:09:08.80,0:09:10.55,Default,,0,0,0,,‫لكن لِمَ رفضتَ طلبهم؟
Dialogue: 0,0:09:10.93,0:09:12.68,Default,,0,0,0,,‫إنهم مونونوكي مثلك، أليس كذلك؟
Dialogue: 0,0:09:13.18,0:09:15.22,Default,,0,0,0,,‫لأنّي أمقتُ أمثالهم بشدة...
Dialogue: 0,0:09:15.60,0:09:17.52,Default,,0,0,0,,‫طفيلياتٌ يتظاهرون بالعظمة،
Dialogue: 0,0:09:17.56,0:09:19.60,Default,,0,0,0,,‫ويخفون ضعفهم خلف قوّة الآخرين.
Dialogue: 0,0:09:21.39,0:09:23.90,Default,,0,0,0,,‫وما يهمّ في الأمر على أيّ حال؟
Dialogue: 0,0:09:24.19,0:09:27.86,Default,,0,0,0,,‫أنتَ بشريّ، ولن تصدّق كلمةً ممّا أقوله.
Dialogue: 0,0:09:28.61,0:09:30.15,Default,,0,0,0,,‫حسنًا، لأكون صادقًا...
Dialogue: 0,0:09:30.53,0:09:33.16,Default,,0,0,0,,‫لا يبدو أيٌّ من هذا منطقيًّا لي.
Dialogue: 0,0:09:33.78,0:09:36.74,Default,,0,0,0,,‫لكنّ هذا لا يعني أنّي لا أصدّقك!
Dialogue: 0,0:09:37.95,0:09:40.46,Default,,0,0,0,,‫أظنّك نسيتَ أنّي أستطيعُ التحدّث للحيوانات!
Dialogue: 0,0:09:41.46,0:09:43.88,Default,,0,0,0,,‫لِمَ قد أُذعرُ من بعض المونونوكي؟
Dialogue: 0,0:09:45.92,0:09:48.17,Default,,0,0,0,,‫أنتَ غريبُ أطوارٍ بحق.
Dialogue: 0,0:09:48.25,0:09:49.76,Default,,0,0,0,,‫مهلًا، انتبه للفظك!
Dialogue: 0,0:09:51.76,0:09:53.34,Default,,0,0,0,,‫كيشيموجين تُبلّغُ المقرّ الرئيسي...
Dialogue: 0,0:09:53.59,0:09:54.76,Default,,0,0,0,,‫أيها الزعيم، أتسمعني؟
Dialogue: 0,0:09:55.14,0:09:56.05,Italics,,0,0,0,,‫شيبا يتحدّث.
Dialogue: 0,0:09:56.10,0:09:57.26,Italics,,0,0,0,,‫هل وجدتِ شيئًا؟
Dialogue: 0,0:09:57.56,0:09:58.51,Default,,0,0,0,,‫نعم...
Dialogue: 0,0:09:58.97,0:10:01.10,Default,,0,0,0,,‫أنا في الإحداثيات إي-16، في الغابة.
Dialogue: 0,0:10:01.18,0:10:02.56,Default,,0,0,0,,‫وجدتُ دماءً.
Dialogue: 0,0:10:02.89,0:10:03.90,Default,,0,0,0,,‫أنا متأكدةٌ تمامًا.
Dialogue: 0,0:10:03.98,0:10:05.15,Default,,0,0,0,,‫إنها لراغو.
Dialogue: 0,0:10:05.31,0:10:07.06,Default,,0,0,0,,‫أستشعرُ نوعًا واحدًا من الطاقة الطيفية،
Dialogue: 0,0:10:07.15,0:10:08.40,Default,,0,0,0,,‫وتتوقّفُ هنا تمامًا.
Dialogue: 0,0:10:08.90,0:10:11.11,Default,,0,0,0,,‫قد يكونُ بالجوار.
Dialogue: 0,0:10:11.53,0:10:12.36,Italics,,0,0,0,,‫حسنًا.
Dialogue: 0,0:10:12.40,0:10:14.57,Italics,,0,0,0,,‫سأعيدُ تجميع فريق البحث.
Dialogue: 0,0:10:14.82,0:10:16.03,Italics,,0,0,0,,‫تراجعي الآن.
Dialogue: 0,0:10:16.32,0:10:17.33,Default,,0,0,0,,‫عُلم.
Dialogue: 0,0:10:19.08,0:10:21.75,Default,,0,0,0,,‫ليس وكأنّي عاجزةٌ عن تولّي الأمر بمفردي...
Dialogue: 0,0:10:29.05,0:10:30.67,Default,,0,0,0,,‫عجبًا، هذا جنون!
Dialogue: 0,0:10:30.76,0:10:33.05,Default,,0,0,0,,‫شُفيتَ بالفعل!
Dialogue: 0,0:10:33.59,0:10:36.55,Default,,0,0,0,,‫لستَ قطًّا عاديًّا حقًا، أليس كذلك؟
Dialogue: 0,0:10:36.84,0:10:37.80,Default,,0,0,0,,‫كنتُ أعلم...
Dialogue: 0,0:10:37.93,0:10:40.06,Default,,0,0,0,,‫لم تصدّق كلمةً ممّا قلته.
Dialogue: 0,0:10:40.47,0:10:42.68,Default,,0,0,0,,‫حسنًا، صدّقتُ نصفه.
Dialogue: 0,0:10:42.85,0:10:45.44,Default,,0,0,0,,‫وظننتُ الباقي مجرّدَ هراءٍ\N‫من قطٍّ على حافة الموت.
Dialogue: 0,0:10:45.56,0:10:46.56,Default,,0,0,0,,‫أيها الـ—!
Dialogue: 0,0:10:46.94,0:10:48.77,Default,,0,0,0,,‫أتعلم...
Dialogue: 0,0:10:49.15,0:10:51.40,Default,,0,0,0,,‫يذكّرني هذا حقًا بتلك الأوقات مع ناتشي.
Dialogue: 0,0:10:51.57,0:10:52.57,Default,,0,0,0,,‫ناتشي؟
Dialogue: 0,0:10:53.44,0:10:55.45,Default,,0,0,0,,‫أجل، كلبتي القديمة.
Dialogue: 0,0:10:53.78,0:10:57.74,Default,SIGN,0,0,0,,{\an8}‫ناتشي
Dialogue: 0,0:10:56.16,0:10:57.57,Default,,0,0,0,,‫كانت الأضخم، والأكثر فروًا،
Dialogue: 0,0:10:57.70,0:11:00.16,Default,,0,0,0,,‫وأحنّ كلبةٍ قد يتمناها المرء.
Dialogue: 0,0:11:00.70,0:11:03.25,Default,,0,0,0,,‫وبالتفكير في الأمر، إنها نقيضك تمامًا.
Dialogue: 0,0:11:03.37,0:11:05.16,Default,,0,0,0,,‫سأقتلك أيها الشقي!
Dialogue: 0,0:11:06.08,0:11:08.96,Default,,0,0,0,,‫في ذلك الوقت، كنتُ\N‫أتعرّض للتنمّر طوال الوقت.
Dialogue: 0,0:11:09.38,0:11:12.34,Default,,0,0,0,,‫كنتُ أعودُ للبيت مغطًّى\N‫بالطين والجروح والخدوش.
Dialogue: 0,0:11:13.01,0:11:16.72,Default,,0,0,0,,‫كانت ناتشي ترمقني\N‫بنظرةٍ وتطلبُ منّي تحميمها.
Dialogue: 0,0:11:17.26,0:11:19.14,Default,,0,0,0,,‫كانت تقول: "افرك فروي، وسأحرصُ
Dialogue: 0,0:11:19.18,0:11:22.93,Default,,0,0,0,,‫على أن تزول كلّ بشاعة\N‫يومك مع الماء أيضًا."
Dialogue: 0,0:11:23.14,0:11:24.60,Default,,0,0,0,,‫ثم كانت تقولُ دائمًا:
Dialogue: 0,0:11:24.89,0:11:26.94,Default,,0,0,0,,‫"أنا محظوظةٌ جدًا بوجودك يا جيرو."
Dialogue: 0,0:11:27.19,0:11:30.19,Default,,0,0,0,,‫"من غيري يحظى بمالكٍ يحمّمه متى شاء؟"
Dialogue: 0,0:11:30.98,0:11:32.61,Default,,0,0,0,,‫"أنتَ تملكُ موهبة المساعدة."
Dialogue: 0,0:11:33.65,0:11:36.45,Default,,0,0,0,,‫"احرص على مشاركة هذه\N‫الموهبة مع الآخرين أيضًا."
Dialogue: 0,0:11:37.57,0:11:42.95,Default,,0,0,0,,‫كانت تقول: "إنها موهبتك الفريدة."
Dialogue: 0,0:11:45.08,0:11:46.75,Default,,0,0,0,,‫-مهلًا...\N‫-حسنًا، حان وقتُ الشطف!
Dialogue: 0,0:11:54.88,0:11:56.84,Default,,0,0,0,,‫آسفٌ أيها الفتى.
Dialogue: 0,0:11:57.01,0:11:58.84,Default,,0,0,0,,‫أنا مدينٌ لك حقًا.
Dialogue: 0,0:11:58.97,0:12:00.47,Default,,0,0,0,,‫لكن عليّ الذهاب.
Dialogue: 0,0:12:01.97,0:12:03.10,Default,,0,0,0,,‫وداعًا.
Dialogue: 0,0:12:06.10,0:12:08.39,Default,,0,0,0,,‫سحقًا... شُفيت جروحي،
Dialogue: 0,0:12:08.52,0:12:10.77,Default,,0,0,0,,‫لكنّ قوّتي ليست كما كانت.
Dialogue: 0,0:12:10.94,0:12:12.94,Default,,0,0,0,,‫عليّ الابتعادُ عن هذا المكان.
Dialogue: 0,0:12:13.44,0:12:15.90,Default,,0,0,0,,‫مهلًا، تبدو مترنّحًا قليلًا.
Dialogue: 0,0:12:17.40,0:12:18.95,Default,,0,0,0,,‫مهلًا، متى قمتَ بـ...؟
Dialogue: 0,0:12:19.07,0:12:20.91,Default,,0,0,0,,‫أيمكنك خفضُ صوتك؟
Dialogue: 0,0:12:20.99,0:12:23.12,Default,,0,0,0,,‫إننا في منتصف الليل.
Dialogue: 0,0:12:23.70,0:12:25.70,Default,,0,0,0,,‫لكنك كنتَ غارقًا في النوم!
Dialogue: 0,0:12:26.12,0:12:27.37,Default,,0,0,0,,‫كانت تلك تقنية "كاواريمي" خاصتي.
Dialogue: 0,0:12:27.46,0:12:29.96,Default,,0,0,0,,‫ماذا؟ من بين كلّ الحيل الرخيصة...
Dialogue: 0,0:12:30.17,0:12:31.71,Default,,0,0,0,,‫انسَ الأمر...
Dialogue: 0,0:12:32.13,0:12:34.34,Default,,0,0,0,,‫إلى أين تظنّ نفسك ذاهبًا بهذه الحالة؟
Dialogue: 0,0:12:36.76,0:12:38.97,Default,,0,0,0,,‫وجهتي لا تخصّك.
Dialogue: 0,0:12:39.22,0:12:41.26,Default,,0,0,0,,‫لا تخصّني؟
Dialogue: 0,0:12:41.55,0:12:43.64,Default,,0,0,0,,‫تذكّر، أنا من أنقذَ حياتك!
Dialogue: 0,0:12:44.89,0:12:47.98,Default,,0,0,0,,‫لا أتذكّرُ أنّي طلبتُ مساعدتك.
Dialogue: 0,0:12:48.52,0:12:50.10,Default,,0,0,0,,‫ماذا قلتَ للتو؟
Dialogue: 0,0:12:50.19,0:12:52.19,Default,,0,0,0,,‫ساعدتني لأنك أردتَ ذلك،
Dialogue: 0,0:12:52.23,0:12:54.11,Default,,0,0,0,,‫لذا توقّف عن لعب دور المنقذ.
Dialogue: 0,0:12:54.61,0:12:59.15,Default,,0,0,0,,‫فضلًا عن ذلك، لم أكن لأمانع الموت هناك.
Dialogue: 0,0:12:59.53,0:13:00.36,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:00.57,0:13:01.70,Default,,0,0,0,,‫ما الذي يعنيه هذا؟
Dialogue: 0,0:13:02.53,0:13:06.62,Default,,0,0,0,,‫كما قلت، هذا لا يخصّك.
Dialogue: 0,0:13:06.99,0:13:09.37,Default,,0,0,0,,‫حسنًا، يمكنك التوقّف عن هذا الآن!
Dialogue: 0,0:13:10.00,0:13:12.12,Default,,0,0,0,,‫لا أعرفُ ما هي قصّتك،
Dialogue: 0,0:13:12.21,0:13:13.88,Default,,0,0,0,,‫لكن لا تتحدّث أبدًا عن الموت هكـ—
Dialogue: 0,0:13:15.59,0:13:17.88,Default,,0,0,0,,‫أنتَ لا تعرفُ متى تصمت.
Dialogue: 0,0:13:18.26,0:13:19.88,Default,,0,0,0,,‫واصل ثرثرتك،
Dialogue: 0,0:13:19.92,0:13:21.63,Default,,0,0,0,,‫وسأحوّلُ قصباتك الهوائية
Dialogue: 0,0:13:21.80,0:13:25.01,Default,,0,0,0,,‫إلى عمود خدشٍ شخصيّ لي أيها الفتى.
Dialogue: 0,0:13:26.14,0:13:28.64,Default,,0,0,0,,‫أعلمُ أنّ ذاكرتك ليست ضعيفةً هكذا.
Dialogue: 0,0:13:28.93,0:13:30.52,Default,,0,0,0,,‫أنا مونونوكي!
Dialogue: 0,0:13:30.89,0:13:33.06,Default,,0,0,0,,‫طيفٌ آكلٌ للبشر!
Dialogue: 0,0:13:33.40,0:13:36.77,Default,,0,0,0,,‫أنا وأنتَ نأتي من عالمين مختلفين تمامًا!
Dialogue: 0,0:13:37.23,0:13:40.03,Default,,0,0,0,,‫أسدِ لي معروفًا، ودعني وشأني!
Dialogue: 0,0:13:41.40,0:13:43.91,Default,,0,0,0,,‫يبدو أنكما تستمتعان بوقتكما.
Dialogue: 0,0:13:44.28,0:13:46.20,Default,,0,0,0,,‫أتمانعان انضمامي؟
Dialogue: 0,0:13:46.62,0:13:47.66,Default,,0,0,0,,‫لا تمانع...
Dialogue: 0,0:13:47.74,0:13:50.41,Default,,0,0,0,,‫أليس كذلك يا راغو؟
Dialogue: 0,0:13:50.79,0:13:51.79,Default,,0,0,0,,‫تبًّا...
Dialogue: 0,0:13:52.04,0:13:53.92,Default,,0,0,0,,‫إنهم يلاحقونني بالفعل.
Dialogue: 0,0:13:54.42,0:13:55.79,Default,,0,0,0,,‫أيها الوغد!
Dialogue: 0,0:13:56.25,0:13:58.92,Default,,0,0,0,,‫أتقتحمُ بيوت الناس دائمًا دون دعوة؟
Dialogue: 0,0:13:59.59,0:14:01.38,Default,,0,0,0,,‫اسمع، لا أعرفُ من تكون،
Dialogue: 0,0:14:01.47,0:14:03.18,Default,,0,0,0,,‫لكنّي غاضبٌ جدًا الآن.
Dialogue: 0,0:14:04.22,0:14:05.30,Default,,0,0,0,,‫وهذا يعني أن تغرب عن وجهي.
Dialogue: 0,0:14:06.97,0:14:09.14,Default,,0,0,0,,‫ اهدأ أيها البشري.
Dialogue: 0,0:14:10.02,0:14:11.77,Default,,0,0,0,,‫سألتهمك في لمح البصر!
Dialogue: 0,0:14:17.77,0:14:18.82,Default,,0,0,0,,‫ليس بهذه السرعة!
Dialogue: 0,0:14:24.41,0:14:29.33,Italics,,0,0,0,,‫أنا وأنتَ نأتي من عالمين مختلفين تمامًا!
Dialogue: 0,0:14:29.66,0:14:32.08,Italics,,0,0,0,,‫أسدِ لي معروفًا، ودعني وشأني!
Dialogue: 0,0:14:43.30,0:14:44.59,Default,,0,0,0,,‫ما الخطب؟
Dialogue: 0,0:14:44.97,0:14:47.34,Default,,0,0,0,,‫يبدو وكأنك تريدني أن أمسك بك!
Dialogue: 0,0:14:47.60,0:14:49.10,Italics,,0,0,0,,‫أيها الوغد!
Dialogue: 0,0:14:49.43,0:14:50.97,Italics,,0,0,0,,‫لستُ مضطرًا للهرب كليًّا.
Dialogue: 0,0:14:51.14,0:14:53.85,Italics,,0,0,0,,‫كلّ ما أحتاجه هو مسافةٌ بسيطة بيننا!
Dialogue: 0,0:14:54.89,0:14:56.35,Default,,0,0,0,,‫لا بدّ لي من القول...
Dialogue: 0,0:14:56.48,0:14:59.06,Default,,0,0,0,,‫سمعتُ أنك كنتَ في حالةٍ سيئة...
Dialogue: 0,0:14:59.15,0:15:01.03,Default,,0,0,0,,‫لكنّي لم أتوقّع هذا أبدًا.
Dialogue: 0,0:15:04.36,0:15:06.32,Default,,0,0,0,,‫أمسكتُ بك.
Dialogue: 0,0:15:08.74,0:15:10.16,Default,,0,0,0,,‫مثيرٌ للشفقة تمامًا!
Dialogue: 0,0:15:12.75,0:15:16.08,Default,,0,0,0,,‫إذًا هذا هو المونونوكي "الأسطوري"...
Dialogue: 0,0:15:16.29,0:15:19.21,Default,,0,0,0,,‫راغو، نجمُ الهلاك الأسود.
Dialogue: 0,0:15:21.13,0:15:23.38,Default,,0,0,0,,‫حسنًا، كفانا حديثًا.
Dialogue: 0,0:15:23.42,0:15:24.72,Default,,0,0,0,,‫ستأتي معي.
Dialogue: 0,0:15:24.76,0:15:27.13,Default,,0,0,0,,‫ينبغي أن تعلم أننا\N‫بذلنا جهدًا جهيدًا لكسر
Dialogue: 0,0:15:27.22,0:15:29.18,Default,,0,0,0,,‫الختم الذي سجنك.
Dialogue: 0,0:15:29.43,0:15:32.72,Default,,0,0,0,,‫وأفضّلُ ألّا أضطرّ لقتل رفيقٍ لي.
Dialogue: 0,0:15:33.02,0:15:34.48,Default,,0,0,0,,‫رفيق؟
Dialogue: 0,0:15:34.60,0:15:36.14,Default,,0,0,0,,‫لا تضحكني!
Dialogue: 0,0:15:36.39,0:15:39.48,Default,,0,0,0,,‫كلّ ما يهمّكم أيها الحمقى\N‫هو الحصول على قوّتي.
Dialogue: 0,0:15:39.65,0:15:43.23,Default,,0,0,0,,‫إن أردتموها بشدة، فتعالوا وخذوها!
Dialogue: 0,0:15:43.65,0:15:47.24,Default,,0,0,0,,‫ولكن فقط إن كنتم مستعدين لمواجهة حتفكم!
Dialogue: 0,0:15:48.49,0:15:49.74,Default,,0,0,0,,‫أهذا صحيح؟
Dialogue: 0,0:15:49.99,0:15:51.99,Default,,0,0,0,,‫الوحيدُ الذي سيواجه حتفه هو أنت!
Dialogue: 0,0:16:09.47,0:16:11.05,Default,,0,0,0,,‫أيها الـ... فتى؟!
Dialogue: 0,0:16:12.22,0:16:14.22,Default,,0,0,0,,‫أيها الأحمق! لِمَ—؟!
Dialogue: 0,0:16:14.31,0:16:16.35,Default,,0,0,0,,‫أنتَ الأحمقُ أيها الغبي!
Dialogue: 0,0:16:17.06,0:16:18.56,Default,,0,0,0,,‫إن متّ الآن،
Dialogue: 0,0:16:18.77,0:16:21.11,Default,,0,0,0,,‫فسيكونُ إنقاذي لك بلا جدوى أيها الوغد!
Dialogue: 0,0:16:21.65,0:16:22.48,Default,,0,0,0,,‫ماذا...؟
Dialogue: 0,0:16:22.82,0:16:26.24,Default,,0,0,0,,‫أيها الأبله، ورّطتَ نفسك\N‫في ما لا طاقة لك به!
Dialogue: 0,0:16:26.57,0:16:28.61,Default,,0,0,0,,‫هذا ليس شجارَ شوارعٍ بسيط!
Dialogue: 0,0:16:29.95,0:16:32.12,Default,,0,0,0,,‫أنتَ تعرفُ حقًا كيف تثيرُ غضب المرء!
Dialogue: 0,0:16:34.45,0:16:36.33,Default,,0,0,0,,‫إنقاذُ شخصٍ ما...
Dialogue: 0,0:16:37.04,0:16:38.75,Default,,0,0,0,,‫ليس غباءً أبدًا، مفهوم؟
Dialogue: 0,0:16:39.42,0:16:41.46,Default,,0,0,0,,‫وحين أساعدُ أحدهم، فأنا أساعده للنهاية!
Dialogue: 0,0:16:41.96,0:16:44.25,Default,,0,0,0,,‫لا أقومُ بالأمر بفتور، مفهوم؟
Dialogue: 0,0:16:44.55,0:16:46.01,Default,,0,0,0,,‫فضلًا عن ذلك...
Dialogue: 0,0:16:46.51,0:16:48.09,Default,,0,0,0,,‫حتى لو هربت،
Dialogue: 0,0:16:48.17,0:16:50.22,Default,,0,0,0,,‫فسيلاحقني بعد أن ينال منك.
Dialogue: 0,0:16:50.72,0:16:53.51,Default,,0,0,0,,‫أنتَ أذكى ممّا تبدو عليه أيها البشري!
Dialogue: 0,0:16:55.76,0:16:57.93,Default,,0,0,0,,‫لكنك غريبُ الأطوار.
Dialogue: 0,0:16:58.14,0:17:01.27,Default,,0,0,0,,‫لا يبدو أنّ هيئتي تخيفك على الإطلاق.
Dialogue: 0,0:17:01.85,0:17:04.98,Default,,0,0,0,,‫وتلك المهارةُ في استخدام\N‫السيف، والتخفّي...
Dialogue: 0,0:17:05.44,0:17:08.90,Default,,0,0,0,,‫هل أستشعرُ فتًى من سلالة الشينوبي؟
Dialogue: 0,0:17:10.82,0:17:12.41,Default,,0,0,0,,‫سأستمتعُ...
Dialogue: 0,0:17:12.49,0:17:13.87,Default,,0,0,0,,‫بالتهامك!
Dialogue: 0,0:17:13.95,0:17:14.78,Default,,0,0,0,,‫يا فتى!
Dialogue: 0,0:17:16.45,0:17:17.75,Default,,0,0,0,,‫هـ... هذا...!
Dialogue: 0,0:17:17.83,0:17:18.91,Default,,0,0,0,,‫أوتسوسيمي!
Dialogue: 0,0:17:20.54,0:17:21.37,Default,,0,0,0,,‫إنه...
Dialogue: 0,0:17:23.08,0:17:24.63,Default,,0,0,0,,‫عفوًا!
Dialogue: 0,0:17:24.96,0:17:27.38,Default,,0,0,0,,‫يبدو أنّ أحدهم تحمّسَ أكثر من اللازم
Dialogue: 0,0:17:27.46,0:17:29.17,Default,,0,0,0,,‫بحركات النينجا الاستعراضية خاصته.
Dialogue: 0,0:17:30.72,0:17:32.26,Default,,0,0,0,,‫استسلم فحسب.
Dialogue: 0,0:17:32.38,0:17:35.64,Default,,0,0,0,,‫المقاومةُ ستزيدُ الأمر سوءًا.
Dialogue: 0,0:17:37.10,0:17:38.22,Default,,0,0,0,,‫عجبًا!
Dialogue: 0,0:17:38.60,0:17:40.85,Default,,0,0,0,,‫كان هذا وشيكًا!
Dialogue: 0,0:17:41.14,0:17:44.90,Default,,0,0,0,,‫هجومٌ مضادٌّ ممتاز من شينوبي حقيقي!
Dialogue: 0,0:17:45.11,0:17:46.36,Default,,0,0,0,,‫أحيّيك.
Dialogue: 0,0:17:47.11,0:17:49.82,Default,,0,0,0,,‫ماذا؟ هل بدأ الظلامُ يخيّمُ بالفعل؟
Dialogue: 0,0:17:50.28,0:17:51.11,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:17:55.70,0:17:57.33,Default,,0,0,0,,‫بالطبع يا راغو!
Dialogue: 0,0:17:57.41,0:17:59.20,Default,,0,0,0,,‫سأقدّمه لك فحسب!
Dialogue: 0,0:17:59.50,0:18:02.00,Default,,0,0,0,,لم تأكل منذ مُدّة، صحيح؟
Dialogue: 0,0:18:02.62,0:18:04.92,Default,,0,0,0,,‫أنا واثقٌ أنّ معدةً ممتلئة...
Dialogue: 0,0:18:05.13,0:18:06.63,Default,,0,0,0,,‫-ستغيّرُ من—\N‫-يكفي!
Dialogue: 0,0:18:07.46,0:18:08.38,Default,,0,0,0,,‫أخرس فمك!
Dialogue: 0,0:18:08.75,0:18:10.13,Default,,0,0,0,,‫أنتَ في عداد الموتى.
Dialogue: 0,0:18:13.84,0:18:15.43,Default,,0,0,0,,‫شقيٌّ أناني.
Dialogue: 0,0:18:15.76,0:18:19.35,Default,,0,0,0,,‫لم يخطر ببالك حتى أنّي غادرتُ لمصلحتك.
Dialogue: 0,0:18:19.85,0:18:24.14,Default,,0,0,0,,‫ثم تتجاهلني حين حذّرتك\N‫من التدخّل في الأمر.
Dialogue: 0,0:18:24.60,0:18:26.77,Default,,0,0,0,,‫وإن متّ،
Dialogue: 0,0:18:26.98,0:18:30.65,Default,,0,0,0,,‫فكلّ هذا سيذهبُ سُدًى حقًا أيها الأبله.
Dialogue: 0,0:18:31.53,0:18:35.24,Default,,0,0,0,,‫يمكنني التهامك والعودة لِما كنتُ عليه.
Dialogue: 0,0:18:35.53,0:18:36.95,Default,,0,0,0,,‫لكن، لا، لن أفعل.
Dialogue: 0,0:18:37.16,0:18:39.91,Default,,0,0,0,,‫أرفضُ تلقّي الأوامر من ذلك\N‫الشيطان المزعج والمعتوه.
Dialogue: 0,0:18:41.16,0:18:42.58,Default,,0,0,0,,‫ولهذا بدلًا من ذلك...
Dialogue: 0,0:18:42.87,0:18:44.79,Default,,0,0,0,,‫أنتَ من سيلتهمني.
Dialogue: 0,0:18:45.87,0:18:48.00,Default,,0,0,0,,‫أنا مدينٌ لك.
Dialogue: 0,0:18:48.13,0:18:50.67,Default,,0,0,0,,‫وسأردّ لك الجميل الآن.
Dialogue: 0,0:18:50.75,0:18:53.17,Default,,0,0,0,,‫توقّف يا راغو! أيها\N‫الـ—! ماذا تفعل...؟!
Dialogue: 0,0:18:54.84,0:18:57.80,Default,,0,0,0,,‫آخذُ هذه الحياة، وأهبها لك!
Dialogue: 0,0:18:58.80,0:19:00.47,Default,,0,0,0,,‫افتح عينيك،
Dialogue: 0,0:19:00.81,0:19:02.43,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:19:05.06,0:19:05.98,Default,,0,0,0,,‫أيها الزعيم؟!
Dialogue: 0,0:19:06.06,0:19:07.44,Italics,,0,0,0,,‫إنه هنا أيضًا.
Dialogue: 0,0:19:07.90,0:19:10.19,Default,,0,0,0,,‫يبدو أنّ الأمور أصبحت فوضويةً قليلًا.
Dialogue: 0,0:19:10.57,0:19:12.94,Italics,,0,0,0,,‫على الجميع التوجّه إلى الموقع!
Dialogue: 0,0:19:13.03,0:19:15.74,Default,,0,0,0,,‫سـ-سحقًا لك يا راغو!
Dialogue: 0,0:19:16.03,0:19:19.16,Default,,0,0,0,,‫أتدركُ ما الذي فعلته؟!
Dialogue: 0,0:19:19.83,0:19:23.70,Default,,0,0,0,,‫تسليمُ قوّتك لبشريّ، لشينوبي...!
Dialogue: 0,0:19:24.00,0:19:29.04,Default,,0,0,0,,‫تخلّيتَ عن رفاقك المونونوكي من أجل بشريّ؟!
Dialogue: 0,0:19:30.42,0:19:32.21,Default,,0,0,0,,‫يا إلهي، صوتك مزعج.
Dialogue: 0,0:19:34.30,0:19:36.47,Default,,0,0,0,,‫ما الذي يحدث، تبًّا...
Dialogue: 0,0:19:37.18,0:19:40.10,Default,,0,0,0,,‫مهلًا، ما هذا؟!
Dialogue: 0,0:19:40.18,0:19:42.77,Italics,,0,0,0,,‫حسنًا، يمكنك إغلاق فمك\N‫المفتوح الآن يا فتى!
Dialogue: 0,0:19:42.81,0:19:43.64,Default,,0,0,0,,‫راغو؟!
Dialogue: 0,0:19:44.06,0:19:45.56,Default,,0,0,0,,‫مهلًا، ما الذي يحدث؟
Dialogue: 0,0:19:45.64,0:19:46.60,Italics,,0,0,0,,‫سأشرحُ لك لاحقًا!
Dialogue: 0,0:19:46.69,0:19:47.52,Italics,,0,0,0,,‫احترس!
Dialogue: 0,0:19:47.56,0:19:49.44,Default,,0,0,0,,‫كلاكما يعيشُ وقتًا ضائعًا!
Dialogue: 0,0:19:49.52,0:19:51.61,Default,,0,0,0,,‫أنتم لي أيها الحمقى المندمجون!
Dialogue: 0,0:19:51.98,0:19:53.94,Default,,0,0,0,,‫مهلًا... ماذا يقصدُ بمندمجين؟!
Dialogue: 0,0:19:54.03,0:19:55.32,Italics,,0,0,0,,‫الأولويات يا فتى!
Dialogue: 0,0:19:55.40,0:19:58.07,Italics,,0,0,0,,‫علينا قتلُ هذا الوغد أولًا!
Dialogue: 0,0:20:00.66,0:20:01.83,Default,,0,0,0,,‫قتله؟
Dialogue: 0,0:20:02.20,0:20:03.95,Default,,0,0,0,,‫كيف تتوقّعُ منّي فعل ذلك؟
Dialogue: 0,0:20:04.37,0:20:05.58,Italics,,0,0,0,,‫لا تقلق.
Dialogue: 0,0:20:05.75,0:20:07.33,Italics,,0,0,0,,‫سأمدّ لك يد العون!
Dialogue: 0,0:20:15.13,0:20:18.22,Italics,,0,0,0,,‫كلّ ما عليك فعله هو إحكام قبضتك...
Dialogue: 0,0:20:19.84,0:20:21.72,Italics,,0,0,0,,‫وإرسال هذه الحثالة إلى الجحيم!
Dialogue: 0,0:20:28.27,0:20:30.23,Italics,,0,0,0,,‫ستمدّ لي يد العون...
Dialogue: 0,0:20:33.52,0:20:35.15,Italics,,0,0,0,,‫أهذا ما قصدته؟
Dialogue: 0,0:20:39.61,0:20:40.57,Default,,0,0,0,,‫تبًّا...
Dialogue: 0,0:20:40.74,0:20:42.53,Default,,0,0,0,,‫ما الذي يحدث؟
Dialogue: 0,0:20:42.95,0:20:45.41,Default,,0,0,0,,‫مهلًا، أخبرني ما الذي يحدث!
Dialogue: 0,0:20:45.66,0:20:47.08,Default,,0,0,0,,‫راغو؟
Dialogue: 0,0:20:47.58,0:20:48.41,Default,,0,0,0,,‫ابقَ مكانك.
Dialogue: 0,0:20:48.62,0:20:49.75,Default,,0,0,0,,‫ولا كلمة.
Dialogue: 0,0:20:50.08,0:20:51.00,Italics,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:20:51.29,0:20:52.46,Italics,,0,0,0,,‫من هذه الفتاة؟
Dialogue: 0,0:20:52.58,0:20:53.50,Italics,,0,0,0,,‫متى قـ—؟!
Dialogue: 0,0:20:53.96,0:20:58.51,Default,,0,0,0,,‫حسنًا، يا إلهي... هذا مأزقٌ حقيقي.
Dialogue: 0,0:21:01.93,0:21:04.85,Default,,0,0,0,,‫لم أتوقّع حدوث هذا أبدًا.
Dialogue: 0,0:21:04.93,0:21:08.35,Default,,0,0,0,,‫تبًّا... لستِ مع ذلك العملاق، أليس كذلك؟
Dialogue: 0,0:21:10.48,0:21:12.86,Default,,0,0,0,,‫مهلًا، لا داعي للفظاظة...
Dialogue: 0,0:21:13.44,0:21:15.44,Default,,0,0,0,,‫ لسنا مونونوكي.
Dialogue: 0,0:21:16.53,0:21:18.78,Default,,0,0,0,,‫نحنُ من مكتب التجسس...
Dialogue: 0,0:21:18.90,0:21:21.61,Default,,0,0,0,,‫مجرّدُ موظفين حكوميين عاديين.
Dialogue: 0,0:21:21.99,0:21:24.28,Default,,0,0,0,,‫مكتب... التجسس؟
Dialogue: 0,0:21:24.53,0:21:27.12,Default,,0,0,0,,‫سأطلعك على التفاصيل لاحقًا.
Dialogue: 0,0:21:27.87,0:21:31.79,Default,,0,0,0,,‫وكما خمّنتَ بالفعل أيها الشاب،
Dialogue: 0,0:21:32.00,0:21:34.50,Default,,0,0,0,,‫نحنُ نضعك قيد الاحتجاز.
Dialogue: 0,0:21:34.84,0:21:35.67,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:21:35.71,0:21:37.13,Default,,0,0,0,,‫أتمزح معي؟
Dialogue: 0,0:21:37.25,0:21:39.26,Default,,0,0,0,,‫لا يمكنك المجيء فجأةً هكذا و—
Dialogue: 0,0:21:40.26,0:21:41.55,Default,,0,0,0,,‫أخبرتك...
Dialogue: 0,0:21:42.09,0:21:43.55,Default,,0,0,0,,‫ولا كلمة.
Dialogue: 0,0:21:43.97,0:21:47.22,Default,,0,0,0,,‫مهلًا يا إيتشيكا، تمهّلي.
Dialogue: 0,0:21:47.47,0:21:49.52,Default,,0,0,0,,‫إنه إجراءٌ مؤقت فحسب.
Dialogue: 0,0:21:49.85,0:21:52.31,Default,,0,0,0,,‫لا نريده مرتبكًا وعدوانيًّا.
Dialogue: 0,0:21:52.69,0:21:55.81,Default,,0,0,0,,‫عميلةٌ مطيعةٌ دائمًا، لا بدّ لي من القول.
Dialogue: 0,0:21:56.69,0:21:59.32,Default,,0,0,0,,‫إذًا ما الذي سنفعله بشأنه؟
Dialogue: 0,0:21:59.82,0:22:03.11,Default,,0,0,0,,‫خذوه الآن إلى المستشفى التابع\N‫لنا للعلاج وإجراء الفحوصات.
Dialogue: 0,0:22:03.66,0:22:05.57,Default,,0,0,0,,‫لا يمكننا تحمّل موته بين أيدينا.
Dialogue: 0,0:22:06.20,0:22:09.24,Default,,0,0,0,,‫إنه في غاية الأهمية.
Dialogue: 0,0:22:09.49,0:22:10.91,Default,,0,0,0,,‫بالنسبة لنا...
Dialogue: 0,0:22:11.00,0:22:12.66,Default,,0,0,0,,‫وللمونونوكي.
