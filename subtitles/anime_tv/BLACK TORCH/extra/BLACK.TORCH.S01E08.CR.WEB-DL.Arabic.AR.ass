Dialogue: 0,0:00:05.63,0:00:07.76,Italics,,0,0,0,,‫عُذرًا...
Dialogue: 0,0:00:07.97,0:00:09.34,Italics,,0,0,0,,‫هذا جيرو!
Dialogue: 0,0:00:09.47,0:00:11.09,Italics,,0,0,0,,‫هل يعمل هذا الشيء حقًا؟
Dialogue: 0,0:00:11.30,0:00:12.97,Default,,0,0,0,,‫أجل، أسمعك بوضوحٍ تام.
Dialogue: 0,0:00:13.30,0:00:14.14,Default,,0,0,0,,‫هل أنت بخير؟
Dialogue: 0,0:00:14.18,0:00:16.56,Italics,,0,0,0,,‫حسنًا... نوعًا ما، على ما أظنّ.
Dialogue: 0,0:00:16.77,0:00:18.31,Default,,0,0,0,,‫نوعًا ما؟ تُثير قلقي.
Dialogue: 0,0:00:18.77,0:00:19.98,Italics,,0,0,0,,‫عذرًا.
Dialogue: 0,0:00:20.40,0:00:23.11,Italics,,0,0,0,,‫تماديتُ قليلًا وسحقتُ الرجل.
Dialogue: 0,0:00:23.44,0:00:24.32,Default,,0,0,0,,‫فهمت...
Dialogue: 0,0:00:24.98,0:00:26.32,Default,,0,0,0,,‫ابقَ ثابتًا! حسنًا، لا تقلق حيال الأمر.
Dialogue: 0,0:00:26.86,0:00:29.45,Default,,0,0,0,,‫لحسن الحظ، يبدو أنّ\N‫إيتشيكا أسرت هدفها حيًا.
Dialogue: 0,0:00:29.53,0:00:30.32,Default,,0,0,0,,تبًا! حقًا؟
Dialogue: 0,0:00:30.61,0:00:31.49,Default,,0,0,0,,‫وماذا عن ريجي؟
Dialogue: 0,0:00:31.53,0:00:32.70,Italics,,0,0,0,,‫لم تصلنا أخباره بعد.
Dialogue: 0,0:00:33.28,0:00:34.12,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:00:34.16,0:00:36.70,Default,,0,0,0,,‫سنذهب لتفقّده الآن.
Dialogue: 0,0:00:37.04,0:00:38.41,Italics,,0,0,0,,‫جيّد، شكرًا.
Dialogue: 0,0:00:38.71,0:00:40.17,Italics,,0,0,0,,‫لا تفعل شيئًا متهوّرًا.
Dialogue: 0,0:00:40.42,0:00:42.08,Italics,,0,0,0,,‫إن ساءت الأمور، أُريدك أن تنسحب.
Dialogue: 0,0:00:42.21,0:00:43.04,Default,,0,0,0,,‫عُلم.
Dialogue: 0,0:00:43.46,0:00:45.96,Italics,,0,0,0,,‫كيف لم أُلاحظ؟
Dialogue: 0,0:00:46.71,0:00:49.05,Italics,,0,0,0,,‫إن واصلتُ الاستحواذ على جيرو...
Dialogue: 0,0:00:49.42,0:00:53.05,Italics,,0,0,0,,‫أو أسوأ، إن واصلتُ استنزاف\N‫الطاقة الطيفيّة في القتالات...
Dialogue: 0,0:00:53.72,0:00:54.55,Default,,0,0,0,,‫مهلًا!
Dialogue: 0,0:00:54.85,0:00:56.06,Default,,0,0,0,,‫يا إلهي!
Dialogue: 0,0:00:56.10,0:00:57.77,Default,,0,0,0,,‫ما خطبك أيّها المعتوه!
Dialogue: 0,0:00:57.81,0:00:59.56,Default,,0,0,0,,‫كان لا بُدّ أن ألفت انتباهك!
Dialogue: 0,0:01:00.31,0:01:02.02,Default,,0,0,0,,‫يمكننا الاسترخاء بعد أن\N‫نُبرح ذي النظارات ضربًا
Dialogue: 0,0:01:02.06,0:01:03.31,Default,,0,0,0,,‫لجعله إيّانا نلعب دور جليسات الأطفال.
Dialogue: 0,0:01:03.52,0:01:04.48,Default,,0,0,0,,‫فلنذهب الآن.
Dialogue: 0,0:01:04.73,0:01:06.07,Default,,0,0,0,,‫أجل...
Dialogue: 0,0:01:07.07,0:01:08.32,Default,,0,0,0,,‫عجبًا...
Dialogue: 0,0:01:08.86,0:01:10.45,Default,,0,0,0,,‫لطالما امتلكتَ موهبةً في المراوغة
Dialogue: 0,0:01:10.49,0:01:12.07,Default,,0,0,0,,‫في اللحظة الأخيرة تمامًا...
Dialogue: 0,0:01:12.32,0:01:15.33,Default,,0,0,0,,‫لكن يبدو أنّك تفوّقتَ على نفسك يا ريجي.
Dialogue: 0,0:01:16.20,0:01:17.33,Default,,0,0,0,,‫شونجين...
Dialogue: 0,0:01:18.08,0:01:20.33,Default,,0,0,0,,‫يتذكّر الجسد بطريقته الخاصّة...
Dialogue: 0,0:01:21.00,0:01:22.50,Default,,0,0,0,,‫نلتَ منّي بها مرّاتٍ لا تُحصى.
Dialogue: 0,0:01:22.54,0:01:24.46,Default,,0,0,0,,‫إنّها حركتك المميّزة.
Dialogue: 0,0:01:25.92,0:01:27.80,Default,,0,0,0,,‫شينجي...
Dialogue: 0,0:02:58.51,0:03:01.10,Default,,0,0,0,,‫أصبحتُ مجرّد "شينجي" الآن إذًا؟
Dialogue: 0,0:03:01.60,0:03:03.02,Default,,0,0,0,,‫جرحتني!
Dialogue: 0,0:03:03.31,0:03:05.52,Default,,0,0,0,,‫ولّت الأيّام التي أُدعى\N‫فيها "أخي"، كما أرى.
Dialogue: 0,0:03:06.02,0:03:07.10,Default,,0,0,0,,‫ولّت منذ زمنٍ بعيد.
Dialogue: 0,0:03:07.77,0:03:10.11,Default,,0,0,0,,‫فقدتُ أخي في ذلك اليوم المشؤوم.
Dialogue: 0,0:03:10.19,0:03:12.11,Default,,0,0,0,,‫يوم فشل في طقس السيف.
Dialogue: 0,0:03:12.19,0:03:13.90,Default,,0,0,0,,‫يوم ابتلعت عاصفة الجحيم روحه.
Dialogue: 0,0:03:13.94,0:03:15.36,Default,,0,0,0,,‫مات أخي.
Dialogue: 0,0:03:16.28,0:03:18.36,Default,,0,0,0,,‫لا يجب أن تفرّ من الحقيقة يل ريجي.
Dialogue: 0,0:03:18.87,0:03:20.87,Default,,0,0,0,,‫لستُ وهمًا.
Dialogue: 0,0:03:21.49,0:03:23.87,Default,,0,0,0,,‫لم تبتلع عاصفة الجحيم روحي قط،
Dialogue: 0,0:03:23.91,0:03:25.79,Default,,0,0,0,,‫ولم تنتهِ حياتي.
Dialogue: 0,0:03:26.08,0:03:29.38,Default,,0,0,0,,‫كنتُ شينجي حينها، وما\N‫زلتُ شينجي ذاته الآن.
Dialogue: 0,0:03:30.08,0:03:32.13,Default,,0,0,0,,‫لكن بما أنّ إيمانك بي ضعيف،
Dialogue: 0,0:03:32.46,0:03:34.17,Default,,0,0,0,,‫أظنّني سأُضطر لإثبات ذلك لك!
Dialogue: 0,0:03:36.13,0:03:37.59,Italics,,0,0,0,,‫أعرف الحقيقة بالفعل!
Dialogue: 0,0:03:39.09,0:03:41.14,Italics,,0,0,0,,‫منذ التلويحة الأُولى!
Dialogue: 0,0:03:41.47,0:03:43.68,Italics,,0,0,0,,‫مع كلّ تصادمٍ لنصلينا...
Dialogue: 0,0:03:44.31,0:03:45.73,Italics,,0,0,0,,‫تتردّد الحقيقة...
Dialogue: 0,0:03:45.77,0:03:47.06,Italics,,0,0,0,,‫...وتلدغ!
Dialogue: 0,0:03:52.40,0:03:54.36,Default,,0,0,0,,‫شينجي ذاته إذًا؟
Dialogue: 0,0:03:54.82,0:03:56.11,Default,,0,0,0,,‫إذًا لِمَ...
Dialogue: 0,0:03:56.44,0:03:58.49,Default,,0,0,0,,‫لِمَ انحزتَ إلى المونونوكي؟
Dialogue: 0,0:04:00.74,0:04:03.28,Default,,0,0,0,,‫مجرّد مسألة راحة.
Dialogue: 0,0:04:03.99,0:04:05.29,Default,,0,0,0,,‫استطعتُ البقاء متخفّيًا،
Dialogue: 0,0:04:05.33,0:04:08.00,Default,,0,0,0,,‫بينما أتصدّى للمكتب.
Dialogue: 0,0:04:08.29,0:04:09.87,Default,,0,0,0,,‫كلّ شيء...
Dialogue: 0,0:04:10.17,0:04:12.46,Default,,0,0,0,,‫كلّه خطؤك يا ريجي.
Dialogue: 0,0:04:13.00,0:04:15.34,Default,,0,0,0,,‫وبدأ كلّ شيءٍ حينها.
Dialogue: 0,0:04:26.22,0:04:27.68,Default,,0,0,0,,‫أخيرًا!
Dialogue: 0,0:04:28.18,0:04:30.44,Default,,0,0,0,,‫أتقنتُ هذه، أليس كذلك يا أخي؟
Dialogue: 0,0:04:30.94,0:04:32.61,Default,,0,0,0,,‫مذهل يا ريجي.
Dialogue: 0,0:04:33.56,0:04:34.52,Default,,0,0,0,,‫شينجي!
Dialogue: 0,0:04:34.82,0:04:36.11,Default,,0,0,0,,‫حسنًا... أ-أجل...
Dialogue: 0,0:04:36.19,0:04:37.11,Default,,0,0,0,,‫أبـ—
Dialogue: 0,0:04:37.61,0:04:39.57,Default,,0,0,0,,‫كم عدد هزائمك الآن؟
Dialogue: 0,0:04:39.90,0:04:43.70,Default,,0,0,0,,‫أنت التوأم الأكبر، ألا تخجل؟
Dialogue: 0,0:04:44.03,0:04:47.37,Default,,0,0,0,,‫أنت الأكبر، وريث عائلة كيريهارا!
Dialogue: 0,0:04:49.71,0:04:50.96,Default,,0,0,0,,‫عجبًا!
Dialogue: 0,0:04:51.54,0:04:53.63,Default,,0,0,0,,‫لا تُسئ فهمي الآن يا ريجي!
Dialogue: 0,0:04:54.00,0:04:54.84,Default,,0,0,0,,‫أنت ذكيّ...
Dialogue: 0,0:04:54.88,0:04:57.21,Default,,0,0,0,,‫لا أُضطر لشرح ألم الخسارة لك.
Dialogue: 0,0:04:57.63,0:05:00.26,Default,,0,0,0,,‫أو رعب تلقّي الضرب والتوبيخ من والدنا!
Dialogue: 0,0:05:00.59,0:05:01.55,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:05:05.35,0:05:07.22,Default,,0,0,0,,‫لم يكن ذلك الأسوأ.
Dialogue: 0,0:05:07.52,0:05:12.48,Default,,0,0,0,,‫أتريد معرفة ما كان أشدّ ألمًا يا ريجي؟
Dialogue: 0,0:05:12.77,0:05:14.44,Default,,0,0,0,,‫كان إدراكي أنّك...
Dialogue: 0,0:05:14.48,0:05:16.98,Default,,0,0,0,,‫منذ ذلك اليوم فصاعدًا،\N‫تعمّدتَ الخسارة أمامي.
Dialogue: 0,0:05:17.40,0:05:18.99,Default,,0,0,0,,‫لا تكن سخيفًا!
Dialogue: 0,0:05:19.15,0:05:20.49,Default,,0,0,0,,‫لم أفعل شيئًا كهذا!
Dialogue: 0,0:05:20.53,0:05:23.11,Default,,0,0,0,,‫لكنّه يُسمّى بالتعمّد اللاواعي!
Dialogue: 0,0:05:23.82,0:05:26.87,Default,,0,0,0,,‫وإلّا لاكتشف والدنا الأمر.
Dialogue: 0,0:05:27.54,0:05:28.41,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:05:28.45,0:05:31.54,Default,,0,0,0,,‫أخبرتني تلويحاتك وضرباتك بكلّ شيء.
Dialogue: 0,0:05:32.46,0:05:35.63,Default,,0,0,0,,‫في النهاية، انتقلتُ من\N‫الخسارة إلى التكافؤ تقريبًا...
Dialogue: 0,0:05:36.25,0:05:38.76,Default,,0,0,0,,‫ثمّ أصبحتُ من يفوز دائمًا...
Dialogue: 0,0:05:39.09,0:05:42.63,Default,,0,0,0,,‫فجأة، كدتُ أنسى شعور الخسارة.
Dialogue: 0,0:05:43.47,0:05:44.39,Default,,0,0,0,,‫وعلاوةً على ذلك...
Dialogue: 0,0:05:45.14,0:05:48.64,Default,,0,0,0,,‫كنتَ تخسر، لكنّك تُظهر\N‫تلك الابتسامة الخبيثة.
Dialogue: 0,0:05:49.27,0:05:52.19,Default,,0,0,0,,‫في البداية، ظننتُها\N‫مجرّد طريقتك في اللطف.
Dialogue: 0,0:05:52.81,0:05:55.15,Default,,0,0,0,,‫لذا حاولتُ بجهدٍ أكبر.
Dialogue: 0,0:05:55.44,0:05:57.40,Default,,0,0,0,,‫لوّحتُ وتصدّيتُ حتّى تقرّحت يداي.
Dialogue: 0,0:05:57.48,0:05:59.90,Default,,0,0,0,,‫حتّى تصبّب عرقي كالأنهار\N‫ولطّختُ الأرض بدمي.
Dialogue: 0,0:05:59.94,0:06:02.07,Default,,0,0,0,,‫تدرّبتُ على وقفتي عشرات الآلاف من المرّات.
Dialogue: 0,0:06:02.99,0:06:03.91,Default,,0,0,0,,‫ومع ذلك...
Dialogue: 0,0:06:03.95,0:06:05.95,Default,,0,0,0,,‫رغم كلّ شيء...
Dialogue: 0,0:06:06.32,0:06:09.16,Default,,0,0,0,,‫بقيتَ خلفي بخطوةٍ واحدةٍ تمامًا.
Dialogue: 0,0:06:09.66,0:06:11.45,Default,,0,0,0,,‫لا أكثر...
Dialogue: 0,0:06:11.50,0:06:13.66,Default,,0,0,0,,‫ولا أقل.
Dialogue: 0,0:06:14.12,0:06:15.96,Default,,0,0,0,,‫كنتُ ألتفتُ لأجدك هناك.
Dialogue: 0,0:06:16.17,0:06:17.92,Default,,0,0,0,,‫وبتلك الابتسامة كنتَ تقول دائمًا...
Dialogue: 0,0:06:18.54,0:06:21.17,Italics,,0,0,0,,‫أنت بارعٌ جدًا يا أخي!
Dialogue: 0,0:06:22.84,0:06:24.18,Default,,0,0,0,,‫ألا تفهم؟
Dialogue: 0,0:06:24.80,0:06:27.35,Default,,0,0,0,,‫لم أكن متقدّمًا بخطوةٍ قط.
Dialogue: 0,0:06:28.22,0:06:31.18,Default,,0,0,0,,‫كنتَ تتعالى عليّ!
Dialogue: 0,0:06:31.77,0:06:33.94,Default,,0,0,0,,‫قد أكون التوأم الأكبر،
Dialogue: 0,0:06:34.06,0:06:36.94,Default,,0,0,0,,‫لكنّك من ورث روح كيريهارا القتاليّة.
Dialogue: 0,0:06:38.73,0:06:40.82,Default,,0,0,0,,‫لكنّك لن تفهم...
Dialogue: 0,0:06:41.15,0:06:43.03,Default,,0,0,0,,‫ألم تلك الحقيقة المبرحة!
Dialogue: 0,0:06:43.11,0:06:44.82,Default,,0,0,0,,‫ألم فركها في وجهك كلّ يوم!
Dialogue: 0,0:06:45.20,0:06:46.78,Default,,0,0,0,,‫اليأس!
Dialogue: 0,0:06:50.99,0:06:53.37,Default,,0,0,0,,‫لهذا السبب يا ريجي...
Dialogue: 0,0:06:54.12,0:06:56.87,Default,,0,0,0,,‫أردتُ أن أُصبح قويًا.
Dialogue: 0,0:06:57.21,0:06:59.04,Default,,0,0,0,,‫لأكون وريثًا مستحقًا...
Dialogue: 0,0:06:59.25,0:07:01.13,Default,,0,0,0,,‫لأكون أخًا مستحقًا...
Dialogue: 0,0:07:01.25,0:07:02.59,Default,,0,0,0,,‫وفوق كلّ شيء...
Dialogue: 0,0:07:02.67,0:07:04.38,Default,,0,0,0,,‫لأجد قيمةً في نفسي...
Dialogue: 0,0:07:04.97,0:07:06.47,Default,,0,0,0,,‫كنتُ مستعدًا لاستخدام أيّ شيء...
Dialogue: 0,0:07:06.55,0:07:07.76,Default,,0,0,0,,‫لفعل أيّ شيء.
Dialogue: 0,0:07:09.39,0:07:11.01,Default,,0,0,0,,‫كفاك هراءً!
Dialogue: 0,0:07:11.31,0:07:13.02,Default,,0,0,0,,‫ألهذا السبب؟
Dialogue: 0,0:07:13.56,0:07:15.27,Default,,0,0,0,,‫لهذا السبب قتلتَ والدنا؟
Dialogue: 0,0:07:16.98,0:07:18.52,Default,,0,0,0,,‫أسلوب كيريهارا...
Dialogue: 0,0:07:18.90,0:07:20.44,Default,,0,0,0,,‫أونيكوبي-أوتوشي!
Dialogue: 0,0:07:24.49,0:07:25.40,Default,,0,0,0,,‫هذا هو...
Dialogue: 0,0:07:25.70,0:07:27.66,Default,,0,0,0,,‫فتًى مطيع يا ريجي.
Dialogue: 0,0:07:27.82,0:07:30.95,Default,,0,0,0,,‫امقتني، اكرهني، أظهر لي احتقارك!
Dialogue: 0,0:07:31.03,0:07:32.49,Default,,0,0,0,,‫انسَ الشفقة!
Dialogue: 0,0:07:33.04,0:07:36.12,Default,,0,0,0,,‫أُريد رؤية ريجي الحقيقيّ!
Dialogue: 0,0:07:37.21,0:07:38.46,Default,,0,0,0,,‫لا، هذا لا يكفي...
Dialogue: 0,0:07:38.67,0:07:40.00,Default,,0,0,0,,‫ولا حتّى قريب...
Dialogue: 0,0:07:40.59,0:07:42.09,Default,,0,0,0,,‫أُريد المزيد... المزيد...
Dialogue: 0,0:07:42.59,0:07:47.63,Default,,0,0,0,,‫المزيد... المزيد...\N‫المزيد... المزيد... المزيد!
Dialogue: 0,0:07:47.72,0:07:49.14,Default,,0,0,0,,‫أعطني المزيد!
Dialogue: 0,0:07:49.22,0:07:50.60,Default,,0,0,0,,‫تُريد قتلي...
Dialogue: 0,0:07:50.64,0:07:51.76,Default,,0,0,0,,‫افعلها فحسب!
Dialogue: 0,0:07:59.65,0:08:00.69,Italics,,0,0,0,,‫لماذا...؟
Dialogue: 0,0:08:00.90,0:08:02.61,Italics,,0,0,0,,‫لِمَ آل الأمر إلى هذا؟
Dialogue: 0,0:08:03.23,0:08:04.53,Italics,,0,0,0,,‫أكان بسببي؟
Dialogue: 0,0:08:04.73,0:08:07.11,Italics,,0,0,0,,‫هل غيّرته حقًا؟
Dialogue: 0,0:08:07.40,0:08:08.78,Italics,,0,0,0,,‫أكان كلّه خطئي؟
Dialogue: 0,0:08:09.57,0:08:11.62,Italics,,0,0,0,,‫هل حوّلته حقًا إلى وحش؟
Dialogue: 0,0:08:11.91,0:08:13.95,Default,,0,0,0,,‫يا إلهي، كان هذا وشيكًا!
Dialogue: 0,0:08:14.20,0:08:15.75,Default,,0,0,0,,‫سامحني يا ريجي.
Dialogue: 0,0:08:15.91,0:08:18.37,Default,,0,0,0,,‫كدتُ أُنهي حياتك.
Dialogue: 0,0:08:18.79,0:08:21.88,Default,,0,0,0,,‫لكنّني لن أقتلك أبدًا وأنت\N‫مهزوزٌ ومضطربٌ هكذا.
Dialogue: 0,0:08:22.46,0:08:25.67,Default,,0,0,0,,‫حسنًا، قلتُ كلّ ما احتجتُ لقوله.
Dialogue: 0,0:08:26.42,0:08:28.63,Default,,0,0,0,,‫هذا يكفي لليوم!
Dialogue: 0,0:08:29.13,0:08:30.84,Default,,0,0,0,,‫وداعًا يا ريجي.
Dialogue: 0,0:08:31.47,0:08:33.89,Default,,0,0,0,,‫مرّ وقتٌ طويل، سُررتُ برؤيتك!
Dialogue: 0,0:08:34.47,0:08:35.97,Default,,0,0,0,,‫لكن في المرّة القادمة...
Dialogue: 0,0:08:36.10,0:08:38.14,Default,,0,0,0,,‫لنجعلها مبارزةً حتّى الموت، اتّفقنا!
Dialogue: 0,0:08:39.56,0:08:40.90,Italics,,0,0,0,,‫مجدّدًا...
Dialogue: 0,0:08:41.40,0:08:42.90,Italics,,0,0,0,,‫تمامًا كتلك الليلة...
Dialogue: 0,0:08:44.15,0:08:46.65,Italics,,0,0,0,,‫تُركتُ ورائهم، وحيدًا!
Dialogue: 0,0:09:04.13,0:09:05.92,Default,,0,0,0,,‫تبًا، أشعر بالإنهاك!
Dialogue: 0,0:09:06.13,0:09:07.76,Default,,0,0,0,,‫ذلك الثور الضخم الغبيّ...
Dialogue: 0,0:09:07.80,0:09:11.43,Default,,0,0,0,,‫كان الأمر أشبه بلعبة ضربٍ جنونيّة.
Dialogue: 0,0:09:11.68,0:09:13.64,Italics,,0,0,0,,‫ذلك الإرهاق...
Dialogue: 0,0:09:13.89,0:09:16.43,Italics,,0,0,0,,‫هذا أكثر من مجرّد إصابةٍ جسديّةٍ عاديّة.
Dialogue: 0,0:09:17.31,0:09:20.02,Italics,,0,0,0,,‫لا يوجد تفسيرٌ آخر...
Dialogue: 0,0:09:20.52,0:09:22.69,Default,,0,0,0,,‫اسمع، أيمكننا التحدّث؟
Dialogue: 0,0:09:22.77,0:09:24.27,Default,,0,0,0,,‫ماذا؟ عمّاذا؟
Dialogue: 0,0:09:24.73,0:09:25.73,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:09:25.82,0:09:28.69,Default,,0,0,0,,‫هناك أمرٌ أُفكّر فيه—
Dialogue: 0,0:09:28.73,0:09:30.28,Default,,0,0,0,,‫توقّف، سيُضطر للانتظار.
Dialogue: 0,0:09:30.36,0:09:31.74,Default,,0,0,0,,‫مهلًا أيّها المتحذلق!
Dialogue: 0,0:09:31.86,0:09:33.07,Default,,0,0,0,,‫بالكاد تفوّهتُ بكلمة—
Dialogue: 0,0:09:36.20,0:09:38.54,Default,,0,0,0,,‫حسنًا، أهذا راغو...
Dialogue: 0,0:09:38.95,0:09:41.79,Default,,0,0,0,,‫مرّ وقتٌ طويلٌ جدًا.
Dialogue: 0,0:09:42.33,0:09:44.79,Default,,0,0,0,,‫يبدو أنّ الحياة تُعاملك جيّدًا...
Dialogue: 0,0:09:45.25,0:09:46.79,Default,,0,0,0,,‫يا صديقي القديم.
Dialogue: 0,0:09:47.42,0:09:48.30,Default,,0,0,0,,‫أماغي؟!
Dialogue: 0,0:09:48.75,0:09:50.72,Default,,0,0,0,,‫هذا مثيرٌ للاهتمام...
Dialogue: 0,0:09:51.22,0:09:53.30,Default,,0,0,0,,‫أنت تعرف كلّ شيءٍ عنّي إذًا.
Dialogue: 0,0:09:53.55,0:09:57.05,Default,,0,0,0,,‫يبدو أنّ ماضي راغو قد شُورك معك بالفعل.
Dialogue: 0,0:09:57.51,0:10:01.31,Default,,0,0,0,,‫من كان ليعلم أنّك روحٌ\N‫صريحةٌ وحسّاسةٌ هكذا يا راغو.
Dialogue: 0,0:10:01.60,0:10:03.69,Default,,0,0,0,,‫ممّا يجعل الأمر أكثر سخرية...
Dialogue: 0,0:10:03.98,0:10:06.15,Default,,0,0,0,,‫البشريّ ذاته الذي تفتح له قلبك
Dialogue: 0,0:10:06.19,0:10:07.90,Default,,0,0,0,,‫هو من يجب أن تفترسه.
Dialogue: 0,0:10:08.40,0:10:09.23,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:10:09.32,0:10:10.32,Default,,0,0,0,,
Dialogue: 0,0:10:10.36,0:10:12.57,Default,,0,0,0,,‫هل أغفلتَ هذه التفصيلة الصغيرة؟
Dialogue: 0,0:10:12.95,0:10:15.16,Default,,0,0,0,,‫لكن مجدّدًا، إنّه أمرٌ واضحٌ\N‫بطريقةٍ ما، أليس كذلك؟
Dialogue: 0,0:10:15.36,0:10:17.70,Default,,0,0,0,,‫كيانان يسكنان وعاءً واحدًا...
Dialogue: 0,0:10:17.78,0:10:20.58,Default,,0,0,0,,‫يصعب تخيّل حالةٍ ينجح فيها ذلك.
Dialogue: 0,0:10:21.08,0:10:23.16,Default,,0,0,0,,‫حتّى مع أصدق النوايا،
Dialogue: 0,0:10:23.33,0:10:27.08,Default,,0,0,0,,‫البشر والمونونوكي كالزيت والماء.
Dialogue: 0,0:10:27.34,0:10:28.59,Default,,0,0,0,,‫في الواقع...
Dialogue: 0,0:10:28.92,0:10:32.21,Default,,0,0,0,,‫أيّ محاولةٍ لاستخدام قواك الطيفيّة
Dialogue: 0,0:10:32.38,0:10:36.09,Default,,0,0,0,,‫ستتغذّى على طاقته الحيويّة فحسب.
Dialogue: 0,0:10:37.05,0:10:39.60,Default,,0,0,0,,‫حتّى تُزهق حياته بالكامل.
Dialogue: 0,0:10:41.06,0:10:42.10,Default,,0,0,0,,‫مهلًا، راغو...
Dialogue: 0,0:10:42.89,0:10:45.10,Default,,0,0,0,,‫أتتذكّر ما فعلناه بذلك الثور الغبيّ؟
Dialogue: 0,0:10:45.31,0:10:46.35,Default,,0,0,0,,‫سنفعله مجدّدًا.
Dialogue: 0,0:10:46.60,0:10:47.48,Default,,0,0,0,,‫ما—؟
Dialogue: 0,0:10:47.56,0:10:50.44,Default,,0,0,0,,‫هل كنتَ تستمع لأيٍّ من هذا؟!
Dialogue: 0,0:10:50.48,0:10:51.78,Default,,0,0,0,,‫سمعتُه كلّه!
Dialogue: 0,0:10:51.86,0:10:52.69,Default,,0,0,0,,‫وماذا إذًا؟
Dialogue: 0,0:10:53.32,0:10:54.40,Default,,0,0,0,,‫وماذا إذًا؟!
Dialogue: 0,0:10:54.45,0:10:55.99,Default,,0,0,0,,‫كلّما استخدمتَ قوّتي أكثر،
Dialogue: 0,0:10:56.03,0:10:57.03,Default,,0,0,0,,‫كلّما استنزفتُ طاقةً حيويّة—
Dialogue: 0,0:10:57.07,0:10:58.66,Default,,0,0,0,,‫أجل، فهمت.
Dialogue: 0,0:10:59.53,0:11:01.54,Default,,0,0,0,,‫لكن إن تركنا الخوف يتملّكنا،
Dialogue: 0,0:11:01.62,0:11:03.37,Default,,0,0,0,,‫فما الذي سيحلّه ذلك؟
Dialogue: 0,0:11:03.79,0:11:06.12,Default,,0,0,0,,‫أعني، لا تُعجبني فكرة أن أكون غداءك...
Dialogue: 0,0:11:06.29,0:11:09.13,Default,,0,0,0,,‫لكنّني حتمًا لا أُريد أن\N‫أهلك على يد هذا الرجل.
Dialogue: 0,0:11:09.54,0:11:13.88,Default,,0,0,0,,‫إن كان عليّ خسارة القليل\N‫من حياتي لقتاله، فليكن!
Dialogue: 0,0:11:15.63,0:11:16.51,Default,,0,0,0,,‫لو لم تكن
Dialogue: 0,0:11:16.55,0:11:18.59,Default,,0,0,0,,‫أحمقَ قصير النظر، لقلتُ إنّك محقّ...
Dialogue: 0,0:11:18.68,0:11:20.89,Default,,0,0,0,,‫أنت تتحدّى المنطق يا فتى.
Dialogue: 0,0:11:21.01,0:11:22.06,Default,,0,0,0,,‫كفاك إهانات!
Dialogue: 0,0:11:22.47,0:11:23.31,Default,,0,0,0,,‫ومع ذلك...
Dialogue: 0,0:11:24.93,0:11:26.44,Default,,0,0,0,,‫سذاجتك صارخة.
Dialogue: 0,0:11:27.31,0:11:29.11,Default,,0,0,0,,‫للأسف، في حالتك الراهنة،
Dialogue: 0,0:11:29.15,0:11:31.69,Default,,0,0,0,,‫القتال هو أقلّ مخاوفك.
Dialogue: 0,0:11:32.48,0:11:33.36,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:11:33.44,0:11:35.57,Default,,0,0,0,,‫تذكّر، إنّه مستضيفك.
Dialogue: 0,0:11:35.78,0:11:37.70,Default,,0,0,0,,‫لا يجب أن أُنهي حياته بعد.
Dialogue: 0,0:11:37.91,0:11:41.08,Default,,0,0,0,,‫على الأقل، ليس قبل\N‫أن أُمزّقكما عن بعضكما.
Dialogue: 0,0:11:41.41,0:11:43.24,Default,,0,0,0,,‫أيّها الوغد القذر... أُقسم لك يا أماغي،
Dialogue: 0,0:11:43.29,0:11:45.58,Default,,0,0,0,,‫إن تجرّأتَ ولمستَه بإصبعٍ واحد...
Dialogue: 0,0:11:46.29,0:11:49.58,Default,,0,0,0,,‫ستفقد أكثر بكثيرٍ من ذراعٍ هزيلةٍ واحدة!
Dialogue: 0,0:11:50.00,0:11:51.46,Default,,0,0,0,,‫يا لها من ثقة...
Dialogue: 0,0:11:51.96,0:11:56.34,Default,,0,0,0,,‫لا تُشكّل أيّ تهديدٍ لي\N‫في ذلك الجسد البشريّ...
Dialogue: 0,0:11:56.51,0:12:00.14,Default,,0,0,0,,‫لكن سيكون من المزعج\N‫جدًا إن عجّل بموتكما معًا
Dialogue: 0,0:12:00.18,0:12:02.72,Default,,0,0,0,,‫بسبب استخدامه المتهوّر\N‫لطاقتك الطيفيّة الثمينة.
Dialogue: 0,0:12:03.01,0:12:04.22,Default,,0,0,0,,‫لذا...
Dialogue: 0,0:12:04.39,0:12:06.10,Default,,0,0,0,,‫أنا مستعدٌّ لعقد صفقة.
Dialogue: 0,0:12:06.56,0:12:10.31,Default,,0,0,0,,‫أقسم لي بالولاء المطلق.
Dialogue: 0,0:12:10.60,0:12:12.27,Default,,0,0,0,,‫أعطني كلمتك بأنّك ستتبعني،
Dialogue: 0,0:12:12.31,0:12:14.36,Default,,0,0,0,,‫أقسم أنّك ستفعل ما أقوله بالحرف.
Dialogue: 0,0:12:14.78,0:12:18.86,Default,,0,0,0,,‫حينها، وحينها فقط، سأدع الفتى يعيش.
Dialogue: 0,0:12:19.49,0:12:21.87,Default,,0,0,0,,‫إذًا، ما قرارك...
Dialogue: 0,0:12:22.16,0:12:23.87,Default,,0,0,0,,‫راغو؟
Dialogue: 0,0:12:29.87,0:12:31.33,Default,,0,0,0,,‫للمرّة الأخيرة...
Dialogue: 0,0:12:31.54,0:12:34.38,Default,,0,0,0,,‫أُطالب، هنا والآن، بولائك التامّ والمطلق.
Dialogue: 0,0:12:36.21,0:12:38.38,Default,,0,0,0,,‫وصلنا أخيرًا!
Dialogue: 0,0:12:38.84,0:12:40.01,Default,,0,0,0,,‫أنت...!
Dialogue: 0,0:12:40.09,0:12:41.51,Default,,0,0,0,,‫أهلًا يا راغو.
Dialogue: 0,0:12:42.18,0:12:44.39,Default,,0,0,0,,‫سُررتُ برؤيتك!
Dialogue: 0,0:12:44.68,0:12:47.02,Default,,0,0,0,,‫أرى أنّك تأخّرتَ كعادتك يا كوغا.
Dialogue: 0,0:12:47.18,0:12:48.52,Default,,0,0,0,,‫أجل، حسنًا...
Dialogue: 0,0:12:48.68,0:12:50.31,Default,,0,0,0,,‫امتلكتُ بعض الأمتعة الإضافيّة.
Dialogue: 0,0:12:50.52,0:12:52.77,Default,,0,0,0,,‫ناروكو، بدّدي الحقل الطيفي،
Dialogue: 0,0:12:52.81,0:12:55.23,Default,,0,0,0,,‫ثمّ امتصّي الطاقة مجدّدًا على الفور.
Dialogue: 0,0:12:55.44,0:12:56.28,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:12:56.32,0:12:57.28,Default,,0,0,0,,‫ممتاز...
Dialogue: 0,0:12:57.36,0:12:59.65,Default,,0,0,0,,‫كلّ شيءٍ جاهز.
Dialogue: 0,0:12:59.74,0:13:00.65,Default,,0,0,0,,‫راغو...
Dialogue: 0,0:13:00.70,0:13:04.16,Default,,0,0,0,,‫استعدّ لتُنتزع من قوقعتك الفانية تلك.
Dialogue: 0,0:13:04.41,0:13:05.70,Default,,0,0,0,,‫أتقصد في هذه اللحظة؟
Dialogue: 0,0:13:06.04,0:13:08.00,Default,,0,0,0,,‫استخراج المونونوكي من مجرّد بشرٍ فانون
Dialogue: 0,0:13:08.04,0:13:10.41,Default,,0,0,0,,‫هو أمرٌ بسيطٌ للغاية في الواقع.
Dialogue: 0,0:13:10.50,0:13:12.88,Default,,0,0,0,,‫بمجرّد أن أُطبّق حقل قوّةٍ\N‫مركّزٍ من الطاقة الطيفيّة،
Dialogue: 0,0:13:12.92,0:13:14.75,Default,,0,0,0,,‫ستظهر بوّابةٌ ما،
Dialogue: 0,0:13:14.79,0:13:16.71,Default,,0,0,0,,‫لتسمح لك بعبورٍ آمنٍ خارج الفتى.
Dialogue: 0,0:13:17.00,0:13:19.80,Default,,0,0,0,,‫لكنّ صُنع بوّابةٍ سوف—
Dialogue: 0,0:13:20.01,0:13:21.55,Default,,0,0,0,,‫كم أنت لمّاح!
Dialogue: 0,0:13:21.88,0:13:23.59,Default,,0,0,0,,‫نعم، كلّما قاومتَ أكثر،
Dialogue: 0,0:13:23.64,0:13:25.93,Default,,0,0,0,,‫زاد الخطر الجسديّ على الوعاء.
Dialogue: 0,0:13:26.31,0:13:28.18,Default,,0,0,0,,‫في حالته الراهنة،
Dialogue: 0,0:13:28.39,0:13:32.06,Default,,0,0,0,,‫سيعني أقلّ إجهادٍ جسديٍّ موتًا محقّقًا تقريبًا.
Dialogue: 0,0:13:32.85,0:13:34.40,Default,,0,0,0,,‫أتعني حقًا ما تقوله؟
Dialogue: 0,0:13:34.48,0:13:35.31,Default,,0,0,0,,
Dialogue: 0,0:13:35.56,0:13:37.61,Default,,0,0,0,,‫إن نفّذتُ أوامرك حقًا،
Dialogue: 0,0:13:37.65,0:13:40.07,Default,,0,0,0,,‫أتقسم أنّك ستدعه يذهب؟
Dialogue: 0,0:13:42.53,0:13:44.91,Default,,0,0,0,,‫سنُدخله غرفة الجراحة فور وصولنا.
Dialogue: 0,0:13:45.03,0:13:47.08,Default,,0,0,0,,‫يسرّني سماع ذلك. اعتنوا به جيّدًا.
Dialogue: 0,0:13:48.33,0:13:49.50,Default,,0,0,0,,‫إيتشيكا.
Dialogue: 0,0:13:49.58,0:13:52.16,Default,,0,0,0,,‫اذهبي معهم، وتواصلي مع أوسامي.
Dialogue: 0,0:13:52.50,0:13:53.83,Default,,0,0,0,,‫عُلم!
Dialogue: 0,0:13:57.71,0:13:58.75,Default,,0,0,0,,‫كوسومي؟
Dialogue: 0,0:13:58.84,0:13:59.84,Default,,0,0,0,,‫أين أنتِ الآن؟
Dialogue: 0,0:14:00.13,0:14:03.09,Default,,0,0,0,,‫وصلتُ للتوّ إلى المحيط الغربيّ.
Dialogue: 0,0:14:03.18,0:14:05.51,Default,,0,0,0,,‫أمّنّا الموقع، لذا لا داعي\N‫للقلق من وصول الصحافة،
Dialogue: 0,0:14:05.59,0:14:07.76,Default,,0,0,0,,‫وأُبلغت جميع الأطراف المعنيّة.
Dialogue: 0,0:14:08.01,0:14:10.35,Default,,0,0,0,,‫حظيتُ أخيرًا بفرصةٍ لالتقاط أنفاسي...
Dialogue: 0,0:14:10.68,0:14:13.14,Default,,0,0,0,,‫والآن، أتلقّى طلبًا منك للدعم.
Dialogue: 0,0:14:13.39,0:14:14.60,Default,,0,0,0,,‫بدأ صبري ينفد.
Dialogue: 0,0:14:15.02,0:14:16.73,Default,,0,0,0,,‫أظنّ أنّني نفدت من الأعذار.
Dialogue: 0,0:14:16.90,0:14:19.69,Default,,0,0,0,,‫تأكّدنا من تبدّد الحاجز.
Dialogue: 0,0:14:20.15,0:14:22.36,Default,,0,0,0,,‫سندخل.
Dialogue: 0,0:14:22.82,0:14:24.32,Default,,0,0,0,,‫بالجنود العاديّين فقط؟
Dialogue: 0,0:14:24.61,0:14:27.37,Italics,,0,0,0,,‫لا، سأقود الفريق شخصيًا.
Dialogue: 0,0:14:27.83,0:14:30.62,Default,,0,0,0,,‫ولهذا سأُحضر معي هيميزوكا وإينوي.
Dialogue: 0,0:14:30.83,0:14:32.29,Default,,0,0,0,,‫نخبة الرداء الأسود؟
Dialogue: 0,0:14:32.45,0:14:34.58,Default,,0,0,0,,‫الأفضل والألمع في القسم الأوّل؟
Dialogue: 0,0:14:34.87,0:14:36.83,Italics,,0,0,0,,‫يمكنك شكر توكيدا على تحقيق المستحيل
Dialogue: 0,0:14:36.88,0:14:38.88,Italics,,0,0,0,,‫وإقناع القيادة بالسماح لهم بالمساعدة.
Dialogue: 0,0:14:39.34,0:14:41.30,Default,,0,0,0,,‫رغم أنّه في هذه الحالة،\N‫لا نملك خيارًا آخر.
Dialogue: 0,0:14:41.59,0:14:43.51,Default,,0,0,0,,‫من الآن فصاعدًا، سنُدير الأمور بطريقتي.
Dialogue: 0,0:14:44.34,0:14:48.14,Default,,0,0,0,,‫جِدوا موقع أزوما جيرو،\N‫وأبلغوني في أسرع وقت.
Dialogue: 0,0:14:48.22,0:14:49.56,Italics,,0,0,0,,‫مفهوم.
Dialogue: 0,0:14:49.60,0:14:50.89,Italics,,0,0,0,,‫كوسومي...
Dialogue: 0,0:14:51.27,0:14:53.06,Italics,,0,0,0,,‫أتحمّل المسؤوليّة الكاملة.
Dialogue: 0,0:14:53.56,0:14:54.64,Italics,,0,0,0,,‫فقط أخرجوهم من هناك.
Dialogue: 0,0:14:58.19,0:15:00.11,Default,,0,0,0,,‫هيميتسوكا، إينوي... فلننطلق.
Dialogue: 0,0:15:00.15,0:15:01.40,Default,,0,0,0,,‫-عُلم!\N‫-أجل!
Dialogue: 0,0:15:08.70,0:15:10.41,Italics,,0,0,0,,‫تبًا!
Dialogue: 0,0:15:10.62,0:15:15.16,Italics,,0,0,0,,‫قاتلنا وصمدنا، لكن في\N‫النهاية، انتصر أُولئك الأوغاد!
Dialogue: 0,0:15:15.66,0:15:19.13,Italics,,0,0,0,,‫أُورّط جيرو في كلّ هذا، وأهكذا أُكافئه؟
Dialogue: 0,0:15:19.38,0:15:20.50,Italics,,0,0,0,,‫في هذه المرحلة...
Dialogue: 0,0:15:20.59,0:15:22.17,Italics,,0,0,0,,‫يستحيل أن أستطيع...
Dialogue: 0,0:15:23.26,0:15:26.43,Default,,0,0,0,,‫ما الذي يجري؟
Dialogue: 0,0:15:26.51,0:15:28.05,Default,,0,0,0,,‫جـ-جيرو؟
Dialogue: 0,0:15:28.55,0:15:29.93,Default,,0,0,0,,‫تبًا لك أيّها الفرويّ...
Dialogue: 0,0:15:29.97,0:15:33.43,Default,,0,0,0,,‫أتظنّ أنّه يمكنك مساعدتي؟
Dialogue: 0,0:15:33.52,0:15:35.23,Default,,0,0,0,,‫هذا القتال...
Dialogue: 0,0:15:35.27,0:15:38.44,Default,,0,0,0,,‫لطالما كان جهدًا جماعيًا—أنا وأنت.
Dialogue: 0,0:15:38.85,0:15:40.94,Default,,0,0,0,,‫جُننت...
Dialogue: 0,0:15:41.27,0:15:44.44,Default,,0,0,0,,‫إن ظننتَ أنّني سأدعك تفعل هذا وحدك!
Dialogue: 0,0:15:45.99,0:15:47.99,Default,,0,0,0,,‫إلامَ تنتظر يا راغو؟
Dialogue: 0,0:15:48.24,0:15:50.74,Default,,0,0,0,,‫البوّابة جاهزةٌ لرحيلك.
Dialogue: 0,0:15:51.12,0:15:53.24,Default,,0,0,0,,‫كفاك تباطؤًا واقفز عبرها.
Dialogue: 0,0:15:53.33,0:15:58.00,Default,,0,0,0,,‫أم... أتُفضّل الهلاك بجانب وعائك؟
Dialogue: 0,0:15:58.29,0:16:01.21,Italics,,0,0,0,,‫مهلًا، مهلًا... رويدك، حسنًا؟
Dialogue: 0,0:16:01.50,0:16:03.50,Italics,,0,0,0,,‫راغو هنا سيكون رفيقي، أليس كذلك؟
Dialogue: 0,0:16:07.42,0:16:08.38,Default,,0,0,0,,‫ماذا...؟
Dialogue: 0,0:16:08.80,0:16:10.14,Default,,0,0,0,,‫ما هذا؟!
Dialogue: 0,0:16:10.39,0:16:11.51,Default,,0,0,0,,‫أمستعدٌّ يا فتى الكلب؟
Dialogue: 0,0:16:11.60,0:16:13.01,Default,,0,0,0,,‫هيمي، أظنّه مستعدًا لـ...
Dialogue: 0,0:16:14.47,0:16:16.52,Default,,0,0,0,,‫الكلب الأكبر الضخم...
Dialogue: 0,0:16:16.60,0:16:18.39,Default,,0,0,0,,‫ركلة الفأس!
Dialogue: 0,0:16:21.27,0:16:22.36,Default,,0,0,0,,‫بطيءٌ جدًا!
Dialogue: 0,0:16:26.28,0:16:27.32,Default,,0,0,0,,‫توقيتٌ مثاليّ!
Dialogue: 0,0:16:27.90,0:16:29.45,Default,,0,0,0,,‫عملٌ جماعيٌّ رائع يا هيمي!
Dialogue: 0,0:16:30.32,0:16:32.45,Default,,0,0,0,,‫كان هذا لا بأس به، على ما أظنّ، لكن...
Dialogue: 0,0:16:32.66,0:16:34.95,Default,,0,0,0,,‫كم مرّةً عليّ إخبارك أن تتوقّف
Dialogue: 0,0:16:34.99,0:16:36.83,Default,,0,0,0,,‫عن صيحات القتال المحرجة\N‫تلك أيّها الكلب الأكبر الضخم!
Dialogue: 0,0:16:36.87,0:16:38.33,Default,,0,0,0,,‫شكرًا على الإطراء!
Dialogue: 0,0:16:38.41,0:16:39.62,Italics,,0,0,0,,‫مـ-ما...
Dialogue: 0,0:16:40.33,0:16:42.21,Italics,,0,0,0,,‫من هؤلاء؟
Dialogue: 0,0:16:49.59,0:16:51.47,Default,,0,0,0,,‫مزعجون...
Dialogue: 0,0:16:51.93,0:16:56.18,Default,,0,0,0,,‫مغروران جدًا بالنسبة لبشريّين غبيّين!
Dialogue: 0,0:16:58.64,0:17:00.31,Default,,0,0,0,,‫في الواقع...
Dialogue: 0,0:17:00.60,0:17:03.69,Default,,0,0,0,,‫لا أملك وقتًا لتسلية فاشلين أمثالكم!
Dialogue: 0,0:17:07.03,0:17:08.32,Default,,0,0,0,,‫متأخّرون كالعادة.
Dialogue: 0,0:17:08.44,0:17:09.78,Default,,0,0,0,,‫مهرّجو المكتب الحمقى.
Dialogue: 0,0:17:10.32,0:17:13.45,Default,,0,0,0,,‫سآخذ هذا الآن، شكرًا جزيلًا لكم.
Dialogue: 0,0:17:13.95,0:17:15.70,Default,,0,0,0,,‫أُودّعكم...
Dialogue: 0,0:17:16.08,0:17:17.45,Default,,0,0,0,,‫-إينو!\N‫-أجل!
Dialogue: 0,0:17:36.14,0:17:38.47,Default,,0,0,0,,‫-مؤلم...\N‫-مهلًا، مهلًا...
Dialogue: 0,0:17:38.81,0:17:40.73,Default,,0,0,0,,‫ليس بهذه السرعة أيّها الفتى الضخم!
Dialogue: 0,0:17:41.10,0:17:43.90,Default,,0,0,0,,‫يا إلهي، ستُمزّق تلك الغرز!
Dialogue: 0,0:17:43.98,0:17:45.56,Default,,0,0,0,,‫حمدًا لهذا!
Dialogue: 0,0:17:45.61,0:17:46.48,Default,,0,0,0,,‫هل أنت بخير؟
Dialogue: 0,0:17:48.11,0:17:49.23,Default,,0,0,0,,‫هل أنا في...
Dialogue: 0,0:17:50.36,0:17:51.49,Default,,0,0,0,,‫الجنّة؟
Dialogue: 0,0:17:51.57,0:17:53.24,Default,,0,0,0,,‫أنت في المستشفى!
Dialogue: 0,0:17:53.74,0:17:56.33,Default,,0,0,0,,‫سأذهب لإخبار الرئيسة باستيقاظك!
Dialogue: 0,0:17:56.37,0:17:57.49,Default,,0,0,0,,‫سيكون هذا مفيدًا.
Dialogue: 0,0:17:57.99,0:17:59.29,Default,,0,0,0,,‫فهمت...
Dialogue: 0,0:17:59.54,0:18:01.33,Default,,0,0,0,,‫مرّ يومٌ بالفعل إذًا...
Dialogue: 0,0:18:01.54,0:18:05.21,Default,,0,0,0,,‫أجل، وبقيتُ أنا وأوسامي\N‫معك هنا طوال الوقت.
Dialogue: 0,0:18:05.25,0:18:07.25,Default,,0,0,0,,‫يمكنك إظهار القليل من التقدير!
Dialogue: 0,0:18:07.54,0:18:12.30,Default,,0,0,0,,‫وللتفكير أنّني كنتُ الوحيدة\N‫القادرة على أسر هدفي...
Dialogue: 0,0:18:12.47,0:18:14.76,Default,,0,0,0,,‫يا للشفقة.
Dialogue: 0,0:18:15.59,0:18:17.51,Default,,0,0,0,,‫أنتِ محقّة.
Dialogue: 0,0:18:17.76,0:18:20.10,Default,,0,0,0,,‫إنّه أمرٌ مثيرٌ للشفقة.
Dialogue: 0,0:18:21.10,0:18:22.31,Default,,0,0,0,,‫كلّ ما يمكنني قوله هو آسف.
Dialogue: 0,0:18:22.43,0:18:25.65,Default,,0,0,0,,‫حسنًا، لم أقصد الأمر هكذا.
Dialogue: 0,0:18:26.23,0:18:28.65,Default,,0,0,0,,‫إذًا، ماذا عن جيرو وراغو...؟
Dialogue: 0,0:18:43.29,0:18:45.29,Default,,0,0,0,,‫كيف تشعر يا راغو؟
Dialogue: 0,0:18:45.92,0:18:47.33,Default,,0,0,0,,‫أتريد معرفة كيف أشعر؟
Dialogue: 0,0:18:48.42,0:18:51.30,Default,,0,0,0,,‫تحبسونني هنا، وتسألونني؟
Dialogue: 0,0:18:51.63,0:18:53.55,Default,,0,0,0,,‫كفاك.
Dialogue: 0,0:18:54.17,0:18:56.76,Italics,,0,0,0,,‫وفّرتُ لك سريرًا مريحًا وطعامًا شهيًا.
Dialogue: 0,0:18:57.01,0:18:58.14,Default,,0,0,0,,‫ألن تأكل؟
Dialogue: 0,0:18:58.30,0:18:59.56,Default,,0,0,0,,‫لا شكرًا.
Dialogue: 0,0:19:00.10,0:19:01.18,Default,,0,0,0,,‫فهمت.
Dialogue: 0,0:19:01.52,0:19:03.73,Default,,0,0,0,,‫إذًا لن نحتاج إليها.
Dialogue: 0,0:19:03.77,0:19:04.98,Default,,0,0,0,,‫انتظر—!
Dialogue: 0,0:19:06.77,0:19:09.44,Default,,0,0,0,,‫يا لها من هشاشة.
Dialogue: 0,0:19:09.77,0:19:13.15,Default,,0,0,0,,‫ومع ذلك، يقتنع هذا الجنس\N‫الدنيء بأنّه الحاكم المطلق.
Dialogue: 0,0:19:13.69,0:19:17.70,Default,,0,0,0,,‫هل سمعتَ بشيءٍ أكثر حماقةً أو سخفًا؟
Dialogue: 0,0:19:18.03,0:19:21.08,Default,,0,0,0,,‫ألهذا تظنّ أنّ المونونوكي\N‫ينبغي أن يأخذوا مكانهم؟
Dialogue: 0,0:19:21.62,0:19:23.45,Default,,0,0,0,,‫ليس أخذ مكانهم.
Dialogue: 0,0:19:23.62,0:19:25.79,Default,,0,0,0,,‫بل مجرّد إعادة هذا\N‫العالم إلى حالته الصحيحة.
Dialogue: 0,0:19:26.00,0:19:28.04,Default,,0,0,0,,‫عالمٌ يُبجّل فيه القويّ ويُحترم.
Dialogue: 0,0:19:28.13,0:19:30.63,Default,,0,0,0,,‫حيث تتجلّى قوانين الطبيعة كما ينبغي.
Dialogue: 0,0:19:30.96,0:19:32.09,Default,,0,0,0,,‫ لا أفهم فحسب.
Dialogue: 0,0:19:32.71,0:19:35.38,Default,,0,0,0,,‫لِمَ تتكبّد كلّ هذا العناء\N‫لتوريطي في كلّ هذا؟
Dialogue: 0,0:19:35.80,0:19:38.05,Default,,0,0,0,,‫إن أردتَ خوض حربٍ مع البشر،
Dialogue: 0,0:19:38.09,0:19:39.85,Default,,0,0,0,,‫فلِمَ لا تذهب وتفعلها وحسب؟
Dialogue: 0,0:19:40.80,0:19:42.35,Default,,0,0,0,,‫فعلتُ ذلك منذ عصور.
Dialogue: 0,0:19:44.73,0:19:46.98,Default,,0,0,0,,‫بعد أن قرّرتَ ختم نفسك في ذلك الحجر،
Dialogue: 0,0:19:47.06,0:19:49.10,Default,,0,0,0,,‫جمعتُ رفاقي مجدّدًا،
Dialogue: 0,0:19:49.15,0:19:50.23,Default,,0,0,0,,‫وتمرّدنا.
Dialogue: 0,0:19:50.27,0:19:52.36,Default,,0,0,0,,‫لكنّنا خسرنا.
Dialogue: 0,0:19:52.69,0:19:55.28,Default,,0,0,0,,‫كان الأمر مهينًا،
Dialogue: 0,0:19:55.32,0:19:59.36,Default,,0,0,0,,‫لكنّ الفشل فتّح عينيّ.
Dialogue: 0,0:19:59.70,0:20:01.70,Default,,0,0,0,,‫البشر ضعفاءٌ بمفردهم.
Dialogue: 0,0:20:01.95,0:20:03.04,Default,,0,0,0,,‫لكن معًا،
Dialogue: 0,0:20:03.08,0:20:04.87,Default,,0,0,0,,‫حينها يُظهرون قوّتهم الحقيقيّة.
Dialogue: 0,0:20:05.37,0:20:07.46,Default,,0,0,0,,‫غنيٌّ عن القول، يتفوّق البشر علينا عددًا.
Dialogue: 0,0:20:07.54,0:20:09.92,Default,,0,0,0,,‫علينا أن نستخدم وسائل\N‫أُخرى لاستعادة النصر.
Dialogue: 0,0:20:10.50,0:20:13.46,Default,,0,0,0,,‫لكي تقف قلّتنا في وجه كثرتهم،
Dialogue: 0,0:20:13.50,0:20:16.80,Default,,0,0,0,,‫فقوّةٌ واحدةٌ هائلةٌ وساحقةٌ هي المفتاح.
Dialogue: 0,0:20:17.67,0:20:22.14,Default,,0,0,0,,‫وتلك القوّة يا صديقي، هي أنت يا راغو...
Dialogue: 0,0:20:22.68,0:20:25.43,Default,,0,0,0,,‫بعد كلّ هذه السنوات، ضلّ المكتب طريقه
Dialogue: 0,0:20:25.52,0:20:27.73,Default,,0,0,0,,‫ونسوا سبب اتّحادهم.
Dialogue: 0,0:20:28.02,0:20:31.65,Default,,0,0,0,,‫بتعافيك الكامل، لن يحظوا بأيّ فرصة.
Dialogue: 0,0:20:33.65,0:20:35.15,Default,,0,0,0,,‫أيمكنني سؤالك عمّا يُضحكك؟
Dialogue: 0,0:20:35.23,0:20:36.90,Default,,0,0,0,,‫ماذا؟ لا، لا شيء...
Dialogue: 0,0:20:37.24,0:20:38.53,Default,,0,0,0,,‫لا بُدّ أنّك يائسٌ جدًا
Dialogue: 0,0:20:38.57,0:20:41.24,Default,,0,0,0,,‫إن كنتَ تطلب المساعدة من قطّةٍ صغيرة.
Dialogue: 0,0:20:42.03,0:20:43.03,Default,,0,0,0,,‫لكن، حسنًا...
Dialogue: 0,0:20:43.12,0:20:45.54,Default,,0,0,0,,‫إن ظننتَ أنّني أستطيع\N‫المساعدة، بالتأكيد، لِمَ لا؟
Dialogue: 0,0:20:46.12,0:20:48.04,Default,,0,0,0,,‫كم أنت متعاون.
Dialogue: 0,0:20:48.12,0:20:49.71,Default,,0,0,0,,‫ليس وكأنّني أملك خيارًا آخر.
Dialogue: 0,0:20:49.83,0:20:52.42,Default,,0,0,0,,‫لا يُعجبني الأمر، لكنّ\N‫الاتّفاق اتّفاق، أليس كذلك؟
Dialogue: 0,0:20:56.55,0:20:57.92,Default,,0,0,0,,‫مـ-ماذا...؟!
Dialogue: 0,0:20:58.67,0:21:00.68,Default,,0,0,0,,‫مؤلم...
Dialogue: 0,0:21:00.88,0:21:03.18,Default,,0,0,0,,‫لِمَ كان عليك فعل ذلك؟
Dialogue: 0,0:21:03.60,0:21:07.68,Default,,0,0,0,,‫لو كان تصويبك أفضل،\N‫لتمكّنتَ من قتلي أيّها الأحمق...
Dialogue: 0,0:21:07.81,0:21:08.64,Default,,0,0,0,,‫مؤلم...!
Dialogue: 0,0:21:08.68,0:21:09.69,Default,,0,0,0,,‫أيّها الوغد، مهلًا!
Dialogue: 0,0:21:09.73,0:21:11.77,Default,,0,0,0,,‫ترفّق قليلًا، وإلّا ستقتلني لـ—
Dialogue: 0,0:21:11.81,0:21:12.69,Default,,0,0,0,,‫اصمت.
Dialogue: 0,0:21:13.81,0:21:14.82,Default,,0,0,0,,‫راغو...
Dialogue: 0,0:21:15.36,0:21:17.86,Default,,0,0,0,,‫أين ذيلك الآن؟
Dialogue: 0,0:21:18.65,0:21:19.57,Default,,0,0,0,,
Dialogue: 0,0:21:19.82,0:21:22.07,Default,,0,0,0,,‫حسنًا، كنتَ قاسيًا جدًا معي هناك
Dialogue: 0,0:21:22.11,0:21:23.91,Default,,0,0,0,,‫عندما سحبتني من الفتى.
Dialogue: 0,0:21:24.12,0:21:26.58,Default,,0,0,0,,‫مزّقته تمامًا!
Dialogue: 0,0:21:27.08,0:21:29.79,Default,,0,0,0,,‫تُرك خلفي مع جيرو...
Dialogue: 0,0:21:29.83,0:21:31.58,Default,,0,0,0,,‫إلى جانب كلّ طاقتي الطيفيّة!
Dialogue: 0,0:21:32.29,0:21:35.34,Default,,0,0,0,,‫أنا مجرّد كتلةِ فروٍ ظريفةٍ الآن.
Dialogue: 0,0:21:35.38,0:21:38.17,Default,,0,0,0,,‫أنت تنظر إلى هِرٍّ عاديّ.
Dialogue: 0,0:21:39.13,0:21:40.67,Default,,0,0,0,,‫ ماذا؟
Dialogue: 0,0:21:40.92,0:21:43.34,Default,,0,0,0,,‫أستشعر بتحسّنٍ إن تصرّفتُ كقطٍّ أكثر؟
Dialogue: 0,0:21:43.43,0:21:45.05,Default,,0,0,0,,‫مياو ميا—
Dialogue: 0,0:21:45.10,0:21:46.10,Default,,0,0,0,,
Dialogue: 0,0:21:46.64,0:21:49.60,Default,,0,0,0,,‫لستُ من النوع المازح.
Dialogue: 0,0:21:49.89,0:21:53.35,Default,,0,0,0,,‫إذًا ما رأيك أن تُصوّب\N‫بشكلٍ أفضل هذه المرّة...
