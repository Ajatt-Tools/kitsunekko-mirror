Dialogue: 0,0:00:06.46,0:00:09.51,Italics,,0,0,0,,‫عُثِرَ في وقت مبكر من صباح اليوم\N‫على بقايا جثث بشرية مقطوعة الرأس
Dialogue: 0,0:00:09.59,0:00:12.18,Italics,,0,0,0,,‫في حيّ سكنيّ هادئ.
Dialogue: 0,0:00:12.60,0:00:14.85,Italics,,0,0,0,,‫يُعَدُّ هذا الاكتشاف المروّع\N‫اليوم مجرد حلقة أخيرة
Dialogue: 0,0:00:14.89,0:00:16.10,Italics,,0,0,0,,‫في سلسلة من جرائم القتل المروّعة.
Dialogue: 0,0:00:16.85,0:00:17.98,Italics,,0,0,0,,تُحقّق الشرطة الآن
Dialogue: 0,0:00:18.02,0:00:21.81,Italics,,0,0,0,,‫في إمكانية ربط هذه\N‫الجرائم بمشتبه به واحد.
Dialogue: 0,0:00:23.19,0:00:25.36,Default,,0,0,0,,‫أيُمكِنُنا القول بثقة إنّ\N‫المونونوكي يقفون خلف هذا؟
Dialogue: 0,0:00:25.65,0:00:27.11,Default,,0,0,0,,‫أنا شبه متأكّد.
Dialogue: 0,0:00:27.19,0:00:28.19,Default,,0,0,0,,‫تمهّل، انتظر لحظة.
Dialogue: 0,0:00:28.45,0:00:30.36,Default,,0,0,0,,‫ما الذي يجعلك تتسكّع هنا معنا؟
Dialogue: 0,0:00:30.45,0:00:32.45,Default,,0,0,0,,‫انتهى عملك، فلتَعُد إلى بيتك!
Dialogue: 0,0:00:33.66,0:00:36.49,Default,,0,0,0,,‫لعلمك، أنا من يقرّر أين أذهب!
Dialogue: 0,0:00:36.58,0:00:38.12,Default,,0,0,0,,‫أتعلمين...
Dialogue: 0,0:00:38.58,0:00:39.75,Default,,0,0,0,,‫في حال نسيتِ،
Dialogue: 0,0:00:39.79,0:00:41.62,Default,,0,0,0,,‫كادت زهرة اللوتس السحرية خاصتكِ تقتلني!
Dialogue: 0,0:00:41.88,0:00:44.63,Default,,0,0,0,,‫أخبرتُكَ ألّا شأن لي بذلك!
Dialogue: 0,0:00:44.71,0:00:47.80,Default,,0,0,0,,‫ومن سمح لك بأكل مقرمشات الجمبري خاصتي؟
Dialogue: 0,0:00:47.88,0:00:49.97,Default,,0,0,0,,‫إذًا اكتُب اسمك أو شيئًا عليها!
Dialogue: 0,0:00:50.01,0:00:51.93,Default,,0,0,0,,‫إنّه مكتوبٌ هناك!
Dialogue: 0,0:00:56.06,0:00:57.89,Default,,0,0,0,,‫في الواقع، كنتُ أتساءل...
Dialogue: 0,0:00:58.31,0:01:00.52,Default,,0,0,0,,‫لِمَ يأكل المونونوكي البشر؟
Dialogue: 0,0:01:01.73,0:01:03.19,Default,,0,0,0,,‫أتسألُ الآن؟
Dialogue: 0,0:01:03.35,0:01:04.40,Default,,0,0,0,,‫أجل، حسنًا، انظر.
Dialogue: 0,0:01:04.81,0:01:06.57,Default,,0,0,0,,‫يأكل هذا المعتوه طعام البشر.
Dialogue: 0,0:01:07.28,0:01:10.65,Default,,0,0,0,,‫يُسمَحُ للمونونوكي بأكل أشياء أخرى أيضًا.
Dialogue: 0,0:01:11.36,0:01:13.57,Default,,0,0,0,,‫يتمحور الأمر كُلّه حول\N‫طاقة البشر الحيوية.
Dialogue: 0,0:01:13.66,0:01:16.66,Default,,0,0,0,,‫إنّها الشيء الوحيد\N‫الذي يزيد من قِوانا حقًا.
Dialogue: 0,0:01:17.08,0:01:20.04,Default,,0,0,0,,‫ أجل، ذلك المدعو أماغي في ذاكرة راغو
Dialogue: 0,0:01:20.21,0:01:22.04,Default,,0,0,0,,‫قال شيئًا مشابهًا.
Dialogue: 0,0:01:22.83,0:01:27.75,Default,,0,0,0,,‫بعبارة أخرى، يجمع\N‫المونونوكي طاقتهم مجددًا.
Dialogue: 0,0:01:28.84,0:01:30.01,Italics,,0,0,0,,‫وردنا للتو.
Dialogue: 0,0:01:30.30,0:01:34.05,Italics,,0,0,0,,‫أُغلِقَت جميع الطرق المؤدية\N‫من وإلى هيراساكا بالكامل.
Dialogue: 0,0:01:34.05,0:01:35.85,Default,Sign,0,0,0,,‫ضباب غامض يلف هيراساكا
Dialogue: 0,0:03:07.35,0:03:09.40,Default,,0,0,0,,‫إذًا؟ أفصِح عمّا لديك.
Dialogue: 0,0:03:09.81,0:03:12.69,Default,,0,0,0,,‫تشغلنا حالات الوفاة\N‫الغامضة هذه بما يكفي.
Dialogue: 0,0:03:13.36,0:03:15.78,Default,,0,0,0,,‫لم تستدعني إلى هنا لمجرد إطلاعي
Dialogue: 0,0:03:15.82,0:03:18.07,Default,,0,0,0,,‫على هذا التقرير التافه، أليس كذلك؟
Dialogue: 0,0:03:18.62,0:03:20.03,Default,,0,0,0,,‫تافه؟
Dialogue: 0,0:03:20.07,0:03:22.04,Italics,,0,0,0,,‫هيّا، أنتَ من أمر بالتدريب.
Dialogue: 0,0:03:22.08,0:03:24.20,Default,,0,0,0,,‫أرجوك ادخل في صلب الموضوع.
Dialogue: 0,0:03:27.12,0:03:28.58,Default,,0,0,0,,‫مثير للاهتمام.
Dialogue: 0,0:03:28.96,0:03:31.79,Default,,0,0,0,,‫إذًا أماغي، المونونوكي من ماضي راغو...
Dialogue: 0,0:03:32.13,0:03:34.34,Default,,0,0,0,,‫جذبتُ انتباهك الآن.
Dialogue: 0,0:03:34.71,0:03:35.84,Default,,0,0,0,,‫ما رأيك...
Dialogue: 0,0:03:36.26,0:03:39.22,Default,,0,0,0,,‫أن ننسى تلك الحادثة\N‫البسيطة في الضريح؟
Dialogue: 0,0:03:39.59,0:03:41.51,Default,,0,0,0,,‫ إذًا هذا هو المغزى من كل هذا...
Dialogue: 0,0:03:43.10,0:03:44.85,Default,,0,0,0,,‫حسنًا، ثمة أمر آخر.
Dialogue: 0,0:03:45.14,0:03:47.14,Default,,0,0,0,,‫التحقيق الذي تُجريه بشأن جرائم القتل...
Dialogue: 0,0:03:47.23,0:03:48.85,Default,,0,0,0,,‫اسمح لفريقي بالمشاركة فيه أيضًا.
Dialogue: 0,0:03:49.19,0:03:50.19,Default,,0,0,0,,‫عذرًا، لا.
Dialogue: 0,0:03:50.36,0:03:51.86,Default,,0,0,0,,‫استمع إليّ فحسب.
Dialogue: 0,0:03:52.48,0:03:54.32,Default,,0,0,0,,‫اكتسبوا خبرة لا بأس بها،
Dialogue: 0,0:03:54.36,0:03:56.11,Default,,0,0,0,,‫وحقّقوا نتائج ملموسة.
Dialogue: 0,0:03:56.57,0:03:59.45,Default,,0,0,0,,‫فضلًا عن ذلك، يُفتَرَضُ أن\N‫تندرج القضايا المتعلقة بالمونونوكي
Dialogue: 0,0:03:59.53,0:04:01.12,Default,,0,0,0,,‫ضمن اختصاصنا.
Dialogue: 0,0:04:01.49,0:04:02.83,Default,,0,0,0,,‫يبدو الأمر منطقيًا تمامًا.
Dialogue: 0,0:04:03.16,0:04:05.12,Default,,0,0,0,,‫إنّهم على أتمّ الاستعداد.
Dialogue: 0,0:04:05.45,0:04:07.08,Default,,0,0,0,,‫في اللحظة التي يخذلونك فيها،
Dialogue: 0,0:04:07.21,0:04:09.04,Default,,0,0,0,,‫أسمح لك بطردي فورًا.
Dialogue: 0,0:04:11.21,0:04:12.63,Default,Sign,0,0,0,,‫توكيدا
Dialogue: 0,0:04:15.17,0:04:16.09,Default,,0,0,0,,‫إذًا، توكيدا...
Dialogue: 0,0:04:16.17,0:04:17.26,Default,,0,0,0,,‫ما الأمر؟
Dialogue: 0,0:04:18.34,0:04:19.34,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:04:20.09,0:04:23.26,Default,,0,0,0,,‫حسنًا، سأعود أدراجي الآن.
Dialogue: 0,0:04:24.26,0:04:25.47,Default,,0,0,0,,‫إذًا عمّ كان ذلك؟
Dialogue: 0,0:04:26.56,0:04:27.64,Default,,0,0,0,,‫لعلمك...
Dialogue: 0,0:04:28.06,0:04:30.02,Default,,0,0,0,,‫لا يزال عرضي قائمًا.
Dialogue: 0,0:04:33.61,0:04:35.40,Default,,0,0,0,,‫نحن في بث حيّ هنا من هيراساكا.
Dialogue: 0,0:04:36.03,0:04:38.53,Default,,0,0,0,,‫كما ترون، على الجانب\N‫الآخر من ذلك الجسر،
Dialogue: 0,0:04:38.61,0:04:41.16,Default,,0,0,0,,‫حجبت مادة كثيفة تشبه\N‫الضباب البلدة بالكامل.
Dialogue: 0,0:04:41.53,0:04:43.24,Default,,0,0,0,,‫تبحث الشرطة في احتمالية
Dialogue: 0,0:04:43.28,0:04:44.74,Default,,0,0,0,,‫وقوع هجوم كيميائي.
Dialogue: 0,0:04:44.91,0:04:46.74,Default,,0,0,0,,‫في غضون ذلك، طُوِّقَ المحيط الآن
Dialogue: 0,0:04:46.87,0:04:49.04,Default,,0,0,0,,‫وأُغلِقَ أمام العامة.
Dialogue: 0,0:04:49.12,0:04:51.17,Default,,0,0,0,,‫امسحوا جميع الأجهزة،\N‫وتأكّدوا من محو ذاكرة الجميع...
Dialogue: 0,0:04:51.21,0:04:53.04,Default,,0,0,0,,‫مروهم بالإبلاغ عن كون الغاز غير ضار.
Dialogue: 0,0:04:53.33,0:04:54.54,Default,,0,0,0,,‫عجبًا...
Dialogue: 0,0:04:54.71,0:04:56.34,Default,,0,0,0,,‫أجميعهم من مكتب التجسس؟
Dialogue: 0,0:04:56.42,0:04:59.55,Default,,0,0,0,,‫نعم، إن كانوا يرتدون بذلات\N‫ويضعون سماعات أذن.
Dialogue: 0,0:05:00.26,0:05:02.55,Default,,0,0,0,,‫ومع ذلك، تبدأ مسؤولياتهم وتنتهي
Dialogue: 0,0:05:02.72,0:05:04.55,Default,,0,0,0,,‫عند حدود البشر.
Dialogue: 0,0:05:04.85,0:05:07.02,Default,,0,0,0,,‫لا عجب في ذلك.
Dialogue: 0,0:05:07.52,0:05:09.56,Default,,0,0,0,,‫أضحت الحوادث الكبرى\N‫المتعلقة بالمونونوكي
Dialogue: 0,0:05:09.60,0:05:12.31,Default,,0,0,0,,‫نادرة الحدوث منذ عقود.
Dialogue: 0,0:05:13.02,0:05:15.15,Default,,0,0,0,,‫ممّا يعني أنّه لم يتبقَّ تقريبًا من
Dialogue: 0,0:05:15.19,0:05:17.19,Default,,0,0,0,,‫يَقدِرُ على التعامل معها عند وقوعها.
Dialogue: 0,0:05:17.44,0:05:18.94,Default,,0,0,0,,‫إنّه يوم حظكم أيها الفريق!
Dialogue: 0,0:05:19.11,0:05:21.36,Default,,0,0,0,,‫حان وقت تدخّل الشعلة السوداء!
Dialogue: 0,0:05:21.95,0:05:23.45,Default,,0,0,0,,‫ما الذي يعنيه هذا؟
Dialogue: 0,0:05:24.03,0:05:26.08,Default,,0,0,0,,‫إليكم الخلاصة.
Dialogue: 0,0:05:26.87,0:05:28.91,Default,,0,0,0,,‫تأثّرت بلدة هيراساكا بأكملها.
Dialogue: 0,0:05:29.37,0:05:31.46,Default,,0,0,0,,‫أُغلِقَت الطرق المؤدية منها وإليها.
Dialogue: 0,0:05:31.58,0:05:33.96,Default,,0,0,0,,‫لا نملك سوى القليل من\N‫المعلومات عمّا يحدث داخل الضباب.
Dialogue: 0,0:05:34.04,0:05:36.13,Default,,0,0,0,,‫كُلّ ما نعرفه هو وقوف المونونوكي خلف هذا،
Dialogue: 0,0:05:36.17,0:05:38.46,Default,,0,0,0,,‫واحتجاز العديد من\N‫المدنيين بالداخل الآن.
Dialogue: 0,0:05:38.76,0:05:41.26,Default,,0,0,0,,‫الضباب كثيف، لكنّ
Dialogue: 0,0:05:41.34,0:05:45.09,Default,,0,0,0,,‫محيّد الطاقة الطيفية في عتاد\N‫تجسسكم سيساعدكم على اختراقه.
Dialogue: 0,0:05:45.43,0:05:47.10,Default,,0,0,0,,‫نملك ثلاثة أهداف.
Dialogue: 0,0:05:47.64,0:05:50.22,Default,,0,0,0,,‫الأول: إنقاذ الناجين.\N‫الثاني: تبديد الضباب.
Dialogue: 0,0:05:50.31,0:05:53.85,Default,,0,0,0,,‫الثالث: تجريد العدو من سلاحه وأسره.
Dialogue: 0,0:05:54.60,0:05:55.65,Default,,0,0,0,,‫أسره؟
Dialogue: 0,0:05:55.77,0:05:57.27,Default,,0,0,0,,‫وأشتبه في وجود من يحرّك
Dialogue: 0,0:05:57.32,0:05:58.82,Default,,0,0,0,,‫الخيوط من خلف الكواليس.
Dialogue: 0,0:05:58.98,0:06:01.99,Default,,0,0,0,,‫أُريدُ استغلال أي فرصة نملكها\N‫للحصول على خيوط تقودنا إليهم.
Dialogue: 0,0:06:02.45,0:06:04.78,Default,,0,0,0,,‫سأتولّى السلطة الكاملة\N‫على كُلّ ما يحدث هنا.
Dialogue: 0,0:06:05.03,0:06:07.49,Default,,0,0,0,,‫أمّا بالنسبة لاختراق ذلك الضباب،\N‫فأنا أُعوّلُ عليكم أنتم الثلاثة.
Dialogue: 0,0:06:08.24,0:06:12.37,Default,,0,0,0,,‫تُعَدُّ وسائل الاتصال\N‫العادية عديمة الفائدة بالداخل.
Dialogue: 0,0:06:12.91,0:06:15.75,Default,,0,0,0,,‫إذًا كيف يُفتَرَضُ بنا البقاء\N‫على تواصل أيها الرئيس؟
Dialogue: 0,0:06:17.54,0:06:19.75,Default,,0,0,0,,‫لحسن حظكم، أنا هنا!
Dialogue: 0,0:06:20.09,0:06:21.17,Default,,0,0,0,,‫ماذا، أنتِ؟
Dialogue: 0,0:06:21.26,0:06:22.26,Default,,0,0,0,,‫أما زلتِ هنا؟
Dialogue: 0,0:06:22.47,0:06:23.76,Default,,0,0,0,,‫أيها الـ...
Dialogue: 0,0:06:24.13,0:06:26.09,Default,,0,0,0,,‫حسنًا إذًا، كيف سيسير الأمر؟
Dialogue: 0,0:06:28.14,0:06:29.14,Default,,0,0,0,,‫سيأخذ كُلّ منكم واحدة.
Dialogue: 0,0:06:29.22,0:06:30.43,Default,,0,0,0,,‫ابتلعوها كاملة!
Dialogue: 0,0:06:31.72,0:06:35.48,Default,,0,0,0,,‫تنقل كُلّ بتلة المعلومات\N‫مباشرة إلى زهرة اللوتس هذه.
Dialogue: 0,0:06:36.15,0:06:38.15,Default,,0,0,0,,‫يتمّ الأمر كُلّه دون صوت.
Dialogue: 0,0:06:38.44,0:06:39.52,Default,,0,0,0,,‫أينبغي عليّ ابتلاع هذه؟
Dialogue: 0,0:06:39.61,0:06:40.48,Default,,0,0,0,,‫كاملة؟
Dialogue: 0,0:06:40.57,0:06:42.28,Default,,0,0,0,,‫لا أعرف إن كنتُ أملك الجرأة لـ...
Dialogue: 0,0:06:42.40,0:06:43.78,Default,,0,0,0,,‫لا يبدو أنّ لها أي رائحة.
Dialogue: 0,0:06:43.90,0:06:45.91,Default,,0,0,0,,‫حسنًا، تجرّعوها دفعة\N‫واحدة أيّها الصغار الجاحدون!
Dialogue: 0,0:06:46.41,0:06:48.66,Default,,0,0,0,,‫حسنًا، هذا كُلّ شيء حاليًا.
Dialogue: 0,0:06:49.12,0:06:52.16,Default,,0,0,0,,‫ادخلوا الآن وافعلوا ما تجيدونه.
Dialogue: 0,0:06:52.66,0:06:55.42,Default,,0,0,0,,‫فلتبدأ المعركة!
Dialogue: 0,0:06:59.50,0:07:01.92,Default,,0,0,0,,‫دخلوا الضباب.
Dialogue: 0,0:07:03.30,0:07:04.42,Default,,0,0,0,,‫ثلاثة منهم.
Dialogue: 0,0:07:05.17,0:07:06.68,Default,,0,0,0,,‫أقلت ثلاثة؟
Dialogue: 0,0:07:07.34,0:07:09.10,Default,,0,0,0,,‫أقلّ ممّا ظننت.
Dialogue: 0,0:07:09.72,0:07:13.98,Default,,0,0,0,,‫يبدو أنّ التعاون كان مبالغًا فيه.
Dialogue: 0,0:07:15.48,0:07:18.56,Default,,0,0,0,,‫رورين! كيف يبدو غداؤنا؟
Dialogue: 0,0:07:19.11,0:07:22.57,Default,,0,0,0,,‫حسنًا، جمعتُ نحو مئتين حتى الآن.
Dialogue: 0,0:07:23.36,0:07:26.07,Default,,0,0,0,,‫من كان ليعلم أنّ حشدهم أحياء...
Dialogue: 0,0:07:26.65,0:07:28.70,Default,,0,0,0,,‫سيستغرق كُلّ هذا الوقت.
Dialogue: 0,0:07:29.16,0:07:31.45,Default,,0,0,0,,‫مع البشر، يتمحور الأمر كُلّه حول الطزاجة!
Dialogue: 0,0:07:31.74,0:07:33.83,Default,,0,0,0,,‫يبدؤون بفقدان تلك الطاقة الحيوية العذبة
Dialogue: 0,0:07:33.87,0:07:35.20,Default,,0,0,0,,‫فور نفوقهم!
Dialogue: 0,0:07:35.37,0:07:37.87,Default,,0,0,0,,‫لا يُهمّ، كُفّ عن كونك انتقائيًا في طعامك
Dialogue: 0,0:07:37.92,0:07:40.71,Default,,0,0,0,,‫وكُل كُلّ ما يُوضَعُ أمامك يا كاناوا.
Dialogue: 0,0:07:40.75,0:07:41.84,Default,,0,0,0,,‫اخرس!
Dialogue: 0,0:07:41.92,0:07:44.42,Default,,0,0,0,,‫الرؤوس كُلّها عظام بلا لحم!
Dialogue: 0,0:07:44.80,0:07:45.84,Default,,0,0,0,,‫كاناوا.
Dialogue: 0,0:07:45.88,0:07:46.72,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:07:46.80,0:07:48.43,Default,,0,0,0,,‫ماذا يا ناروكو؟
Dialogue: 0,0:07:48.68,0:07:50.47,Default,,0,0,0,,‫أخطأت.
Dialogue: 0,0:07:51.55,0:07:53.26,Default,,0,0,0,,‫ليسوا ثلاثة أشخاص فحسب.
Dialogue: 0,0:07:55.43,0:07:57.98,Default,,0,0,0,,‫هناك ثلاثة...
Dialogue: 0,0:07:58.23,0:07:59.40,Default,,0,0,0,,‫وقط.
Dialogue: 0,0:08:06.49,0:08:08.45,Default,,0,0,0,,‫إذًا وصل الوغد أخيرًا!
Dialogue: 0,0:08:08.61,0:08:12.74,Default,,0,0,0,,‫الآن يُمكِنُني إحداث فوضى عارمة حقًا!
Dialogue: 0,0:08:13.03,0:08:14.87,Default,,0,0,0,,‫أَحدِث فوضى كما يحلو لقلبك الصغير.
Dialogue: 0,0:08:14.91,0:08:17.29,Default,,0,0,0,,‫فقط لا تنسَ ما قاله الزعيم.
Dialogue: 0,0:08:17.37,0:08:18.83,Default,,0,0,0,,‫فهمت!
Dialogue: 0,0:08:19.12,0:08:22.25,Default,,0,0,0,,‫مهلًا يا ناروكو، من أين يأتي راغو؟
Dialogue: 0,0:08:23.84,0:08:24.67,Default,,0,0,0,,‫ناروكو؟
Dialogue: 0,0:08:25.84,0:08:27.17,Default,,0,0,0,,‫أظنّها نائمة.
Dialogue: 0,0:08:27.34,0:08:28.59,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:08:29.38,0:08:30.84,Default,,0,0,0,,‫ إنّه جزء من طبيعة عملها.
Dialogue: 0,0:08:30.93,0:08:33.60,Default,,0,0,0,,‫إنّها تحافظ على هذا الحاجز بمفردها.
Dialogue: 0,0:08:33.76,0:08:37.10,Default,,0,0,0,,‫ماذا لو قرّر راغو مهاجمة ناروكو؟
Dialogue: 0,0:08:37.43,0:08:38.60,Default,,0,0,0,,‫سيكون الأمر بخير.
Dialogue: 0,0:08:38.89,0:08:41.10,Default,,0,0,0,,‫حرصنا على توفير حارس شخصي خاص بها.
Dialogue: 0,0:08:41.19,0:08:43.56,Default,,0,0,0,,‫لا أهتمّ لأمرها!
Dialogue: 0,0:08:43.77,0:08:45.86,Default,,0,0,0,,‫ يكفي هذا!
Dialogue: 0,0:08:46.11,0:08:49.65,Default,,0,0,0,,‫رورين، ابقَ هنا وحافظ\N‫على وفرة إمدادات طعامنا!
Dialogue: 0,0:08:49.99,0:08:51.36,Default,,0,0,0,,‫ماذا؟ وماذا عنك؟
Dialogue: 0,0:08:51.70,0:08:53.24,Default,,0,0,0,,‫سأخرج إلى هناك،
Dialogue: 0,0:08:53.32,0:08:55.41,Default,,0,0,0,,‫وأجعل روح راغو مِلكي!
Dialogue: 0,0:08:55.79,0:08:58.12,Default,,0,0,0,,‫تذكّر أنّ الزعيم قال ألّا تقتله!
Dialogue: 0,0:09:02.67,0:09:03.63,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:09:04.09,0:09:06.88,Default,,0,0,0,,‫هذا أسوأ بكثير ممّا ظننت.
Dialogue: 0,0:09:08.01,0:09:10.26,Default,,0,0,0,,‫كُلّ هؤلاء الأشخاص على الأرض...
Dialogue: 0,0:09:10.34,0:09:10.88,Default,,0,0,0,,‫استيقظوا!
Dialogue: 0,0:09:10.88,0:09:14.01,Default,,0,0,0,,‫حاولتُ هزّهم، لكن دون جدوى.
Dialogue: 0,0:09:14.35,0:09:17.43,Default,,0,0,0,,‫لعلّهم تحت تأثير تعويذة ما.
Dialogue: 0,0:09:18.31,0:09:21.35,Default,,0,0,0,,‫حسنًا، فلنبحث إذًا عمّن يفعل هذا.
Dialogue: 0,0:09:21.56,0:09:23.85,Default,,0,0,0,,‫أنتَ تعلم أنّ هذا الحاجز\N‫يحيط ببلدة بأكملها!
Dialogue: 0,0:09:24.11,0:09:25.73,Default,,0,0,0,,‫أظنّ أنّ الانقسام و
Dialogue: 0,0:09:25.77,0:09:28.03,Default,,0,0,0,,‫البحث في ثلاثة اتجاهات\N‫هو خيارنا الأفضل.
Dialogue: 0,0:09:29.44,0:09:31.03,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:09:31.20,0:09:34.32,Default,,0,0,0,,‫تفوح رائحة الطاقة الطيفية في الأرجاء!
Dialogue: 0,0:09:34.53,0:09:37.16,Default,,0,0,0,,‫إذًا يتفضّل القط أخيرًا بحضوره.
Dialogue: 0,0:09:38.24,0:09:39.91,Default,,0,0,0,,‫بالطبع، راغو!
Dialogue: 0,0:09:40.00,0:09:42.58,Default,,0,0,0,,‫ يُمكِنُكَ أن تكون رادار المونونوكي خاصتنا!
Dialogue: 0,0:09:42.58,0:09:43.00,Default,,0,0,0,,‫هذه هي!
Dialogue: 0,0:09:43.00,0:09:43.92,Default,,0,0,0,,‫هذه هي!\N‫- ماذا؟
Dialogue: 0,0:09:44.71,0:09:46.67,Default,,0,0,0,,
Dialogue: 0,0:09:46.92,0:09:47.88,Default,,0,0,0,,‫ثلاثة...
Dialogue: 0,0:09:48.46,0:09:50.55,Default,,0,0,0,,‫لا، أربعة كيانات طيفية.
Dialogue: 0,0:09:50.59,0:09:51.84,Default,,0,0,0,,‫أربعة؟!
Dialogue: 0,0:09:51.88,0:09:53.68,Default,,0,0,0,,‫أتملك أي فكرة عن أماكنهم؟
Dialogue: 0,0:09:55.89,0:09:59.68,Default,,0,0,0,,‫يُصعّب الضباب والتعويذة تحديد المواقع...
Dialogue: 0,0:10:00.02,0:10:02.18,Default,,0,0,0,,‫هناك من ينشر الضباب.
Dialogue: 0,0:10:02.64,0:10:05.19,Default,,0,0,0,,‫ومن يُلقي التعويذة على البشر.
Dialogue: 0,0:10:05.35,0:10:08.02,Default,,0,0,0,,‫ثم هناك من يملكون أكبر قدر\N‫من الطاقة الطيفية في المجموعة...
Dialogue: 0,0:10:08.07,0:10:09.57,Default,,0,0,0,,‫اثنان منهم.
Dialogue: 0,0:10:10.15,0:10:13.03,Default,,0,0,0,,‫سبب أدعى لحاجتنا إلى\N‫الانقسام والبحث عنهم.
Dialogue: 0,0:10:14.32,0:10:15.53,Default,,0,0,0,,‫عجبًا!
Dialogue: 0,0:10:15.78,0:10:17.16,Default,,0,0,0,,‫يا إلهي، كم نحن محظوظون!
Dialogue: 0,0:10:17.20,0:10:19.66,Default,,0,0,0,,‫لا أعرف السبب، لكنّ البشر\N‫جميعهم يأخذون قيلولة.
Dialogue: 0,0:10:19.83,0:10:22.12,Default,,0,0,0,,‫حان وقت ملء مناقيرنا\N‫ما دامت الفرصة سانحة!
Dialogue: 0,0:10:24.62,0:10:28.79,Default,,0,0,0,,‫سمعتُ الآخرين يتحدثون عن\N‫الأمر، لكن الآن بعد أن رأيته حقًا...
Dialogue: 0,0:10:28.88,0:10:30.34,Default,,0,0,0,,‫إنّه... كيف أصيغها...؟
Dialogue: 0,0:10:30.84,0:10:33.05,Default,,0,0,0,,‫كأنّه شيء مقتبس من لوحة فنية.
Dialogue: 0,0:10:33.34,0:10:35.26,Default,,0,0,0,,‫عجبًا، شكرًا أيها البشري!
Dialogue: 0,0:10:35.43,0:10:38.01,Default,,0,0,0,,‫لم يسبق لي أن أكلتُ طعامًا معلبًا من قبل!
Dialogue: 0,0:10:38.14,0:10:41.06,Default,,0,0,0,,‫كلا، بل ينبغي عليّ شكركم يا رفاق!
Dialogue: 0,0:10:42.81,0:10:44.56,Default,,0,0,0,,‫حسنًا، وفقًا للغربان،
Dialogue: 0,0:10:44.69,0:10:48.52,Default,,0,0,0,,‫اثنان منهم مع حشد من\N‫الناس عند تقاطع في الشمال،
Dialogue: 0,0:10:48.56,0:10:50.23,Default,,0,0,0,,‫والآخران يتسكعان حول المتنزه
Dialogue: 0,0:10:50.27,0:10:51.82,Default,,0,0,0,,‫في وسط البلدة.
Dialogue: 0,0:10:52.15,0:10:55.82,Default,,0,0,0,,‫إن أردنا إنجاز هذا بسرعة،\N‫فعلينا الانقسام إلى مجموعتين.
Dialogue: 0,0:10:56.11,0:10:57.20,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:10:57.70,0:10:59.49,Default,,0,0,0,,‫سأتوجّه وإيتشيكا إلى التقاطع.
Dialogue: 0,0:10:59.58,0:11:01.16,Default,,0,0,0,,‫أنتما الاثنان، إلى المتنزه.
Dialogue: 0,0:11:01.24,0:11:03.58,Default,,0,0,0,,‫كيف عرفتُ أنّكَ ستقول ذلك؟
Dialogue: 0,0:11:04.12,0:11:07.04,Default,,0,0,0,,‫بمجرد انتهائنا، سنتوجّه\N‫إليكم لتقديم الدعم.
Dialogue: 0,0:11:07.29,0:11:08.33,Default,,0,0,0,,‫حسنًا.
Dialogue: 0,0:11:08.63,0:11:10.34,Default,,0,0,0,,‫حسنًا إذًا. فلنذهب من هذا الطريق.
Dialogue: 0,0:11:28.48,0:11:29.77,Default,,0,0,0,,‫تغيير في الخطة.
Dialogue: 0,0:11:30.27,0:11:32.53,Default,,0,0,0,,‫انقسموا وتولّوا أمر التقاطع والمتنزه.
Dialogue: 0,0:11:32.78,0:11:33.61,Default,,0,0,0,,‫نحن...
Dialogue: 0,0:11:34.57,0:11:35.90,Default,,0,0,0,,‫سنتولّى أمر هذا الرجل.
Dialogue: 0,0:11:36.28,0:11:38.16,Default,,0,0,0,,‫مهلًا، يُمكِنُنا جميعًا...
Dialogue: 0,0:11:38.24,0:11:39.74,Default,,0,0,0,,‫إنّه يريدنا نحن!
Dialogue: 0,0:11:40.78,0:11:41.62,Default,,0,0,0,,‫اذهبوا.
Dialogue: 0,0:11:46.50,0:11:49.79,Default,,0,0,0,,‫يُفاجئني تخلّيكَ عن أصدقائك!
Dialogue: 0,0:11:50.04,0:11:54.05,Default,,0,0,0,,‫ظننتُ أنّ البشر لا يقاتلون إلّا في جماعات.
Dialogue: 0,0:11:54.38,0:11:56.80,Default,,0,0,0,,‫اخرس أيّها العملاق ذو القرون القبيح.
Dialogue: 0,0:11:56.97,0:11:58.80,Default,,0,0,0,,‫لستُ هنا للثرثرة.
Dialogue: 0,0:11:59.34,0:12:01.05,Default,,0,0,0,,‫هيّا تقدّم!
Dialogue: 0,0:12:09.73,0:12:10.56,Default,,0,0,0,,
Dialogue: 0,0:12:11.27,0:12:13.57,Default,,0,0,0,,‫يبدو أنّني وجدتُ المكان الصحيح.
Dialogue: 0,0:12:13.90,0:12:17.11,Default,,0,0,0,,‫مهلًا أيها الفاشل، أسدِ لنفسك\N‫معروفًا وأبطِل هذه التعويذة!
Dialogue: 0,0:12:17.40,0:12:18.32,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:18.61,0:12:20.32,Default,,0,0,0,,‫ولِمَ قد أُريدُ فعل ذلك؟
Dialogue: 0,0:12:21.12,0:12:23.08,Default,,0,0,0,,‫إذًا تختار الموت.
Dialogue: 0,0:12:24.12,0:12:25.33,Default,,0,0,0,,‫على ما يبدو،
Dialogue: 0,0:12:25.58,0:12:28.33,Default,,0,0,0,,‫من يقف على العمود ليس بكامل وعيه.
Dialogue: 0,0:12:28.62,0:12:30.12,Default,,0,0,0,,‫يا لها من مفاجأة سارة.
Dialogue: 0,0:12:30.46,0:12:32.84,Default,,0,0,0,,‫إن تصرّفتَ بتهذيب، سأعتقلك، ويُمكِنُكَ العيش.
Dialogue: 0,0:12:33.17,0:12:34.84,Default,,0,0,0,,‫لكن إن قاومت...
Dialogue: 0,0:12:35.38,0:12:36.59,Default,,0,0,0,,‫فستذوق نصل سيفي.
Dialogue: 0,0:12:36.80,0:12:39.59,Default,,0,0,0,,أتقول أن أتقدّم؟
Dialogue: 0,0:12:39.93,0:12:41.43,Default,,0,0,0,,‫لولا أنّني أعرف الحقيقة،
Dialogue: 0,0:12:41.47,0:12:44.05,Default,,0,0,0,,‫لقلتُ إنّكَ تُلمّحُ إلى كونك أقوى منّي حقًا!
Dialogue: 0,0:12:44.35,0:12:46.60,Default,,0,0,0,,‫أتريد أن تكتشف ذلك؟
Dialogue: 0,0:13:08.20,0:13:09.50,Italics,,0,0,0,,‫تمامًا كما ظننت.
Dialogue: 0,0:13:09.75,0:13:11.75,Italics,,0,0,0,,‫لا يُميّزه سوى العضلات.
Dialogue: 0,0:13:13.17,0:13:14.63,Italics,,0,0,0,,‫هجماته...
Dialogue: 0,0:13:16.05,0:13:17.88,Italics,,0,0,0,,‫قوية، لكنّها بسيطة!
Dialogue: 0,0:13:19.01,0:13:20.76,Italics,,0,0,0,,‫إن تفاديتها في اللحظة الأخيرة...
Dialogue: 0,0:13:21.09,0:13:22.01,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:22.22,0:13:24.76,Italics,,0,0,0,,‫فسيكون هذا الأحمق مكشوفًا تمامًا!
Dialogue: 0,0:13:26.10,0:13:28.10,Default,,0,0,0,,‫عذرًا أيّها العملاق ذو القرون المرح!
Dialogue: 0,0:13:28.31,0:13:31.27,Default,,0,0,0,,‫ليست هذه معركتي الأولى!
Dialogue: 0,0:13:31.60,0:13:33.15,Default,,0,0,0,,‫لن أتساهل!
Dialogue: 0,0:13:33.48,0:13:34.90,Default,,0,0,0,,‫سنُنهي هذا بضربة واحدة!
Dialogue: 0,0:13:35.15,0:13:36.15,Default,,0,0,0,,‫راغو!
Dialogue: 0,0:13:47.03,0:13:49.16,Default,,0,0,0,,‫آمل أن تتمكّن من الطيران!
Dialogue: 0,0:13:53.87,0:13:56.13,Italics,,0,0,0,,‫لا فائدة! لا يُمكِنُني فعلها!
Dialogue: 0,0:14:03.13,0:14:05.09,Italics,,0,0,0,,‫امتصّها للتو!
Dialogue: 0,0:14:05.55,0:14:06.68,Default,,0,0,0,,‫سحقًا!
Dialogue: 0,0:14:08.47,0:14:11.60,Default,,0,0,0,,‫لم يكن ذلك سيئًا للغاية.
Dialogue: 0,0:14:12.64,0:14:13.60,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:14:14.40,0:14:17.02,Default,,0,0,0,,‫لستَ مونونوكي في\N‫النهاية. ولستَ بشريًا حتى.
Dialogue: 0,0:14:17.06,0:14:20.11,Default,,0,0,0,,‫أنتَ مجرد فشل حيّ،\N‫طلقة طائشة لا فائدة منها.
Dialogue: 0,0:14:20.53,0:14:21.49,Italics,,0,0,0,,‫تحوّلت ذراعاه؟!
Dialogue: 0,0:14:25.24,0:14:26.32,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:14:28.78,0:14:31.33,Default,,0,0,0,,‫لستُ أكثر المونونوكي رشاقة.
Dialogue: 0,0:14:31.83,0:14:35.12,Default,,0,0,0,,‫لكن يُمكِنُني إلقاء ثقلي كالثور!
Dialogue: 0,0:14:36.04,0:14:37.67,Default,,0,0,0,,‫أيؤلمك هذا؟
Dialogue: 0,0:14:37.71,0:14:40.84,Default,,0,0,0,,‫أتشعر ببعض الإهانة\N‫لتمريغ وجهك في التراب؟
Dialogue: 0,0:14:41.09,0:14:45.59,Default,,0,0,0,,‫الآن تعرف كيف شعرنا\N‫طوال مئات السنين الماضية!
Dialogue: 0,0:14:45.84,0:14:48.72,Default,,0,0,0,,‫كُلّ هذا بفضلكم أيها\N‫العملاء السريون المزعومون.
Dialogue: 0,0:14:49.97,0:14:51.81,Default,,0,0,0,,‫كنتُ إلهًا شيطانيًا،
Dialogue: 0,0:14:51.85,0:14:55.98,Default,,0,0,0,,‫حاكمًا لغابات الجبال ومُبجّلًا كليّ القدرة!
Dialogue: 0,0:14:56.60,0:14:59.98,Default,,0,0,0,,‫قدّم البشر القرابين والدعوات.
Dialogue: 0,0:15:00.11,0:15:04.49,Default,,0,0,0,,‫وفي المقابل، حميتُ أرضهم.
Dialogue: 0,0:15:04.74,0:15:07.74,Default,,0,0,0,,‫أيام المجد!
Dialogue: 0,0:15:07.91,0:15:09.24,Default,,0,0,0,,‫لكن!
Dialogue: 0,0:15:09.53,0:15:11.41,Default,,0,0,0,,‫ثم جاء الأونيوابان!
Dialogue: 0,0:15:11.45,0:15:13.41,Default,,0,0,0,,‫توقّفت الصلوات،
Dialogue: 0,0:15:13.50,0:15:15.79,Default,,0,0,0,,‫وبدأ قرويّي بالتآمر مع\N‫أولئك الجواسيس القذرين،
Dialogue: 0,0:15:15.83,0:15:18.25,Default,,0,0,0,,‫يُخطّطون لاغتيالي!
Dialogue: 0,0:15:18.54,0:15:20.75,Default,,0,0,0,,‫لذا قتلتهم!
Dialogue: 0,0:15:21.13,0:15:23.26,Default,,0,0,0,,‫أتفهم الآن يا فتى؟
Dialogue: 0,0:15:23.51,0:15:26.22,Default,,0,0,0,,‫في يوم من الأيام، لا تجد\N‫سوى الابتسامات والصلوات،
Dialogue: 0,0:15:26.26,0:15:28.22,Default,,0,0,0,,‫وفي اليوم التالي، تجد عصابات\N‫من الجزارين المتعطشين للدماء
Dialogue: 0,0:15:28.26,0:15:29.26,Default,,0,0,0,,‫يتوقون لإعلان موتي!
Dialogue: 0,0:15:29.51,0:15:31.76,Default,,0,0,0,,‫هذا ما تفعله الحثالة البشرية!
Dialogue: 0,0:15:32.81,0:15:35.27,Default,,0,0,0,,‫لذا، انتظرنا نحن المونونوكي...
Dialogue: 0,0:15:35.56,0:15:38.23,Default,,0,0,0,,‫حتى نسي البشر أمر المونونوكي،
Dialogue: 0,0:15:38.27,0:15:41.77,Default,,0,0,0,,‫وأصبح الأونيوابان مجرد ظلّ لما كان عليه.
Dialogue: 0,0:15:42.15,0:15:44.61,Default,,0,0,0,,‫والآن، حان الوقت\N‫أخيرًا لنا نحن المونونوكي
Dialogue: 0,0:15:44.65,0:15:47.03,Default,,0,0,0,,‫لاستعادة أسلوب حياتنا المسلوب.
Dialogue: 0,0:15:47.36,0:15:50.82,Default,,0,0,0,,‫إن كان هذا هو المدى الكامل لقوة راغو،
Dialogue: 0,0:15:50.95,0:15:53.04,Default,,0,0,0,,‫فلا حاجة لنا به!
Dialogue: 0,0:15:53.62,0:15:55.54,Default,,0,0,0,,‫أنتَ قربان تضحية،
Dialogue: 0,0:15:55.62,0:15:59.17,Default,,0,0,0,,‫وسيلة لجلب مجد عصرنا الجديد!
Dialogue: 0,0:16:02.38,0:16:03.50,Default,,0,0,0,,‫حقًا...
Dialogue: 0,0:16:03.96,0:16:06.34,Default,,0,0,0,,‫أنتم البشر هكذا دائمًا.
Dialogue: 0,0:16:06.67,0:16:10.51,Default,,0,0,0,,‫تتظاهرون بأنّكم تحكمون العالم.
Dialogue: 0,0:16:11.05,0:16:13.76,Default,,0,0,0,,‫بصراحة، تُثيرون جميعكم اشمئزازي.
Dialogue: 0,0:16:13.85,0:16:16.27,Default,,0,0,0,,‫إن كنتِ تُفضّلين أن أتوقّف،
Dialogue: 0,0:16:16.35,0:16:18.85,Default,,0,0,0,,‫فربما يجدر بكِ الاقتداء بأسلافكِ
Dialogue: 0,0:16:18.89,0:16:21.02,Default,,0,0,0,,‫بالزحف على يديكِ وركبتيك.
Dialogue: 0,0:16:26.07,0:16:26.94,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:16:27.74,0:16:29.53,Default,,0,0,0,,‫إذًا الفتاة تملك حركات بارعة.
Dialogue: 0,0:16:30.03,0:16:31.03,Default,,0,0,0,,‫حسنًا، إذًا...
Dialogue: 0,0:16:31.74,0:16:33.87,Default,,0,0,0,,‫ما رأيكِ بشيء كهذا؟!
Dialogue: 0,0:16:45.75,0:16:48.05,Default,,0,0,0,,‫لعلمك، السقوط سيعني نهايتكِ حقًا.
Dialogue: 0,0:16:48.30,0:16:52.30,Default,,0,0,0,,‫تتغلغل تعويذتي في عقلكِ وروحك.
Dialogue: 0,0:16:52.64,0:16:56.27,Default,,0,0,0,,‫أريتُ جميع أطياف\N‫البشر شتى أنواع الأوهام.
Dialogue: 0,0:16:56.85,0:17:01.81,Default,,0,0,0,,‫من أكثرها جاذبية قاتلة\N‫إلى أكثرها رعبًا جحيميًا.
Dialogue: 0,0:17:02.56,0:17:03.65,Default,,0,0,0,,‫وفي المقابل، أظهروا لي
Dialogue: 0,0:17:03.69,0:17:06.11,Default,,0,0,0,,‫أروع الضحكات،\N‫والدموع، والتعابير المشوّهة،
Dialogue: 0,0:17:06.15,0:17:09.45,Default,,0,0,0,,‫كُلّ ذلك قبل أن يعجزوا عن النطق تمامًا.
Dialogue: 0,0:17:09.70,0:17:11.61,Default,,0,0,0,,‫مذهل، أليس كذلك؟
Dialogue: 0,0:17:12.03,0:17:13.95,Default,,0,0,0,,‫أنتَ مختل.
Dialogue: 0,0:17:14.41,0:17:17.08,Default,,0,0,0,,‫والبشر ليسوا ألعابك!
Dialogue: 0,0:17:17.29,0:17:20.96,Default,,0,0,0,,‫ومع ذلك تملكون أنتم\N‫البشر قططكم وكلابكم.
Dialogue: 0,0:17:21.79,0:17:22.96,Default,,0,0,0,,‫قرّرت.
Dialogue: 0,0:17:23.50,0:17:26.96,Default,,0,0,0,,‫ستلعبين معي شئتِ أم أبيت.
Dialogue: 0,0:17:27.17,0:17:28.13,Default,,0,0,0,,‫مرحبًا بك...
Dialogue: 0,0:17:28.59,0:17:30.22,Default,,0,0,0,,‫في الحياة ضمن مجموعة ألعابي!
Dialogue: 0,0:17:33.55,0:17:34.60,Default,,0,0,0,,‫هكذا!
Dialogue: 0,0:17:35.01,0:17:37.56,Default,,0,0,0,,‫ارقصي لي، ارقصي!
Dialogue: 0,0:17:37.81,0:17:40.56,Default,,0,0,0,,‫إذًا ماذا سيكون؟ فجوة في معدتكِ؟!
Dialogue: 0,0:17:40.64,0:17:43.56,Default,,0,0,0,,‫أم قفزة مظلية مباشرة إلى الهاوية؟!
Dialogue: 0,0:17:48.61,0:17:51.57,Default,,0,0,0,,‫الوحيد الذي سيحترق في الجحيم هو أنت!
Dialogue: 0,0:17:52.03,0:17:55.07,Default,,0,0,0,,‫نسيتِ أنّ هذا وهمي.
Dialogue: 0,0:17:55.53,0:17:57.70,Italics,,0,0,0,,‫بالطبع لن أسقط.
Dialogue: 0,0:17:57.87,0:17:58.87,Default,,0,0,0,,‫مهلًا...
Dialogue: 0,0:17:59.12,0:18:02.00,Default,,0,0,0,,‫هذا ليس عدلًا! انزل إلى هنا وقاتل!
Dialogue: 0,0:18:02.12,0:18:04.88,Default,,0,0,0,,‫أنتِ معتادة حقًا على\N‫إلقاء الأوامر، أليس كذلك؟
Dialogue: 0,0:18:05.21,0:18:08.25,Default,,0,0,0,,‫في الواقع، أظنّ أنّ هدية ستُغيّرُ مزاجك.
Dialogue: 0,0:18:12.34,0:18:14.01,Default,,0,0,0,,‫ما...؟!
Dialogue: 0,0:18:14.26,0:18:15.51,Default,,0,0,0,,‫ما هذا؟!
Dialogue: 0,0:18:15.80,0:18:17.51,Default,,0,0,0,,‫ظريفة للغاية!
Dialogue: 0,0:18:18.14,0:18:21.52,Default,,0,0,0,,‫ما نفع مجموعة الألعاب\N‫دون دمية أزياء، أليس كذلك؟
Dialogue: 0,0:18:21.98,0:18:23.52,Default,,0,0,0,,‫أنتَ...
Dialogue: 0,0:18:23.85,0:18:26.98,Italics,,0,0,0,,‫لا يُمكِنُني فقدان أعصابي، سأقع في فخه.
Dialogue: 0,0:18:27.56,0:18:29.40,Italics,,0,0,0,,‫إنّه مجرد وهم.
Dialogue: 0,0:18:29.78,0:18:32.32,Italics,,0,0,0,,‫يظنّ أنّه قادر على\N‫الاستمرار في اللعب معي.
Dialogue: 0,0:18:32.49,0:18:33.90,Italics,,0,0,0,,‫لكنّها فرصتي.
Dialogue: 0,0:18:34.49,0:18:36.28,Italics,,0,0,0,,‫لكنّني لن أحظى سوى بواحدة.
Dialogue: 0,0:18:36.66,0:18:37.83,Default,,0,0,0,,‫إذًا ماذا سيكون؟
Dialogue: 0,0:18:37.91,0:18:40.58,Default,,0,0,0,,‫زيّ خادمة؟ أم ربما زيّ ممرضة—
Dialogue: 0,0:18:40.62,0:18:42.54,Default,,0,0,0,,‫عذرًا، الإجابة هي لا لكليهما.
Dialogue: 0,0:18:43.16,0:18:47.54,Default,,0,0,0,,‫سئمتُ من لعب ألعابك المنحرفة!
Dialogue: 0,0:18:48.59,0:18:49.55,Default,,0,0,0,,‫أهكذا إذًا؟
Dialogue: 0,0:18:50.25,0:18:52.55,Default,,0,0,0,,‫حسنًا، لا رأي لكِ في هذا الأمر!
Dialogue: 0,0:18:52.63,0:18:53.55,Default,,0,0,0,,‫ أين ذهـ—
Dialogue: 0,0:18:54.97,0:18:55.84,Italics,,0,0,0,,‫ما هذا على...؟!
Dialogue: 0,0:18:55.93,0:18:57.43,Default,,0,0,0,,‫إلغاء قفل وضع التخفي.
Dialogue: 0,0:18:58.68,0:19:01.18,Default,,0,0,0,,‫انـ-انـ-انتظري...
Dialogue: 0,0:19:04.18,0:19:06.44,Default,,0,0,0,,‫قرني!
Dialogue: 0,0:19:07.65,0:19:10.07,Default,,0,0,0,,‫القرن هو مركز التحكم الطيفي للمونونوكي.
Dialogue: 0,0:19:10.15,0:19:13.07,Default,,0,0,0,,‫افقد واحدًا، وتفقد القدرة\N‫على التحكم في تعويذتك.
Dialogue: 0,0:19:13.40,0:19:15.45,Default,,0,0,0,,‫قد يكون هذا مجرد لهو ولعب بالنسبة لك،
Dialogue: 0,0:19:15.57,0:19:17.45,Default,,0,0,0,,‫لكنّنا نحن البشر جادون للغاية.
Dialogue: 0,0:19:17.99,0:19:19.45,Default,,0,0,0,,‫لا تعبث معنا!
Dialogue: 0,0:19:24.08,0:19:27.33,Default,,0,0,0,,‫أوتسوسيمي... خدعة أونيوابان قديمة.
Dialogue: 0,0:19:27.54,0:19:29.33,Default,,0,0,0,,‫قردة صغيرة رشيقة.
Dialogue: 0,0:19:30.00,0:19:30.96,Default,,0,0,0,,‫ومع ذلك...
Dialogue: 0,0:19:31.71,0:19:33.51,Default,,0,0,0,,‫أنا متفاجئ...
Dialogue: 0,0:19:34.05,0:19:37.97,Default,,0,0,0,,‫لم أظنّ أنّكَ لا تزال تملك مثل هذه القوة.
Dialogue: 0,0:19:38.64,0:19:39.97,Default,,0,0,0,,‫كـ-كلا، هذا...
Dialogue: 0,0:19:40.68,0:19:42.93,Default,,0,0,0,,‫مهلًا يا راغو، ما الذي يحدث؟!
Dialogue: 0,0:19:43.22,0:19:45.98,Default,,0,0,0,,‫لا تسألني. لستُ متأكّدًا بنفسي!
Dialogue: 0,0:19:46.06,0:19:49.69,Default,,0,0,0,,‫بمجرد أن مزّقتُ تلك\N‫السترة، شعرتُ بقوة تتفجّر.
Dialogue: 0,0:19:50.11,0:19:52.07,Default,,0,0,0,,‫ماذا؟ ماذا تقصد بتتفجر...؟
Dialogue: 0,0:19:53.44,0:19:55.07,Italics,,0,0,0,,‫ أجل، قال شيبا شيئًا...
Dialogue: 0,0:19:55.32,0:19:58.57,Italics,,0,0,0,,‫عن نوع من محيّد الطاقة الطيفية.
Dialogue: 0,0:19:59.20,0:20:02.08,Italics,,0,0,0,,‫أيُمكِنُ أن يؤثّر على\N‫طاقة راغو بداخلي أيضًا؟
Dialogue: 0,0:20:02.91,0:20:04.08,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:20:06.04,0:20:07.08,Default,,0,0,0,,‫احترس!
Dialogue: 0,0:20:07.25,0:20:08.08,Default,,0,0,0,,‫لا وقت!
Dialogue: 0,0:20:08.33,0:20:09.21,Default,,0,0,0,,‫سحقًا!
Dialogue: 0,0:20:09.25,0:20:10.29,Default,,0,0,0,,‫إذًا سنمسك بها!
Dialogue: 0,0:20:18.38,0:20:19.97,Default,,0,0,0,,‫أ-أنتَ...
Dialogue: 0,0:20:20.59,0:20:22.47,Default,,0,0,0,,‫وحش.
Dialogue: 0,0:20:28.19,0:20:29.06,Default,,0,0,0,,‫راغو...
Dialogue: 0,0:20:29.10,0:20:29.98,Default,,0,0,0,,‫أنتَ...
Dialogue: 0,0:20:30.31,0:20:31.86,Default,,0,0,0,,‫كان ذلك مذهلًا!
Dialogue: 0,0:20:32.02,0:20:35.23,Default,,0,0,0,,‫كلا... كنتُ أحاول صدّ ضربته فحسب.
Dialogue: 0,0:20:35.53,0:20:37.74,Default,,0,0,0,,‫ليست هذه مجرد قوة صدّ.
Dialogue: 0,0:20:37.99,0:20:40.32,Italics,,0,0,0,,‫لِمَ أصبحتُ أقوى بكثير فجأة...؟
Dialogue: 0,0:20:40.53,0:20:42.78,Italics,,0,0,0,,‫ألهذا علاقة حقًا بتلك السترة؟
Dialogue: 0,0:20:43.03,0:20:45.74,Italics,,0,0,0,,‫كلا، حتى لو كان كذلك،\N‫فلن يُفسّر هذا الأمر.
Dialogue: 0,0:20:46.16,0:20:47.96,Italics,,0,0,0,,‫وخلعها كان مجرد محفّز.
Dialogue: 0,0:20:48.41,0:20:50.96,Italics,,0,0,0,,‫كأنّ شيئًا أفلت قبضته عنّي.
Dialogue: 0,0:20:51.75,0:20:52.75,Italics,,0,0,0,,‫انتظر لحظة!
Dialogue: 0,0:20:53.00,0:20:55.30,Italics,,0,0,0,,‫أيُمكِنُ أن تكون قوتي في ازدياد؟
Dialogue: 0,0:20:55.75,0:20:59.55,Italics,,0,0,0,,‫كُلّ تلك الطاقة التي امتصّها سبج الموت...
Dialogue: 0,0:20:59.68,0:21:03.01,Italics,,0,0,0,,‫لم تَعُد فحسب، بل أصبحتُ\N‫أقوى من أي وقت مضى.
Dialogue: 0,0:21:03.47,0:21:04.39,Italics,,0,0,0,,‫لا...
Dialogue: 0,0:21:04.68,0:21:06.06,Italics,,0,0,0,,‫لم تمضِ سوى بضعة أسابيع...
Dialogue: 0,0:21:06.60,0:21:08.85,Italics,,0,0,0,,‫مرّ وقت طويل منذ وجبتك\N‫الأخيرة، أليس كذلك؟
Dialogue: 0,0:21:08.89,0:21:11.27,Italics,,0,0,0,,‫أنا واثق أنّ بطنًا ممتلئًا سيُغيّرُ رأيك...
Dialogue: 0,0:21:11.40,0:21:13.06,Italics,,0,0,0,,‫يتمحور الأمر كُلّه حول\N‫طاقة البشر الحيوية.
Dialogue: 0,0:21:13.15,0:21:15.77,Italics,,0,0,0,,‫إنّها الشيء الوحيد\N‫الذي يزيد من قِوانا حقًا.
Dialogue: 0,0:21:17.94,0:21:19.78,Italics,,0,0,0,,‫فهمت.
Dialogue: 0,0:21:20.03,0:21:23.41,Default,,0,0,0,,‫في الواقع، ثمة خطب ما.
Dialogue: 0,0:21:23.78,0:21:27.08,Italics,,0,0,0,,‫كيانان، مونونوكي وبشري،
Dialogue: 0,0:21:27.12,0:21:28.54,Italics,,0,0,0,,‫يتشاركان جسدًا واحدًا...
Dialogue: 0,0:21:28.75,0:21:31.83,Italics,,0,0,0,,‫سواء أدركتُ ذلك أم لا،\N‫يبدو الأمر منطقيًا تمامًا!
Dialogue: 0,0:21:32.46,0:21:34.29,Italics,,0,0,0,,‫فعلتُها ولم أكن أملك أدنى فكرة.
Dialogue: 0,0:21:34.71,0:21:36.30,Italics,,0,0,0,,‫لا، ما زلتُ أفعلها!
Dialogue: 0,0:21:37.17,0:21:39.80,Italics,,0,0,0,,‫طوال هذا الوقت لم أُدرِك حتى...
Dialogue: 0,0:21:40.38,0:21:42.43,Italics,,0,0,0,,‫كنتُ أتغذّى على طاقة جيرو الحيوية!
Dialogue: 0,0:21:46.31,0:21:47.35,Default,,0,0,0,,‫توقّف مكانك!
Dialogue: 0,0:21:47.68,0:21:49.56,Default,,0,0,0,,‫ألقِ سلاحك واستسلم!
Dialogue: 0,0:21:50.02,0:21:52.56,Default,,0,0,0,,‫إن رفضت، فلن أملك\N‫خيارًا سوى استخدام القوة.
Dialogue: 0,0:21:52.81,0:21:55.56,Default,,0,0,0,,‫اعتبر هذا تحذيرك الأخير.
Dialogue: 0,0:22:00.61,0:22:02.20,Italics,,0,0,0,,‫لا يُمكِنُني أن أنسى أبدًا...
Dialogue: 0,0:22:02.86,0:22:04.74,Italics,,0,0,0,,‫لا شكّ في ذلك.
Dialogue: 0,0:22:05.82,0:22:07.58,Italics,,0,0,0,,‫ذلك السيف...
Dialogue: 0,0:22:08.29,0:22:10.08,Default,,0,0,0,,‫استعد لأسلوب كيريهارا...
Dialogue: 0,0:22:10.33,0:22:11.33,Italics,,0,0,0,,‫ذلك الصوت!
Dialogue: 0,0:22:11.87,0:22:12.96,Default,,0,0,0,,‫شونجين!
