Dialogue: 0,0:00:08.42,0:00:10.43,Default,,0,0,0,,‫أكره توضيب الأمتعة!
Dialogue: 0,0:00:10.76,0:00:12.43,Default,,0,0,0,,‫هذا يكفي.
Dialogue: 0,0:00:12.72,0:00:15.31,Default,,0,0,0,,‫طالما أملك بعض الملابس الداخلية وغيارًا.
Dialogue: 0,0:00:15.85,0:00:17.31,Default,,0,0,0,,‫أمُتأكّد؟
Dialogue: 0,0:00:17.56,0:00:18.39,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:00:18.48,0:00:21.94,Default,,0,0,0,,‫من يدري ما يُخطّطون له لأجلنا.
Dialogue: 0,0:00:22.35,0:00:25.82,Default,,0,0,0,,‫قد تكون هذه آخر مرّة\N‫ترى فيها هذا المكان.
Dialogue: 0,0:00:27.53,0:00:28.57,Default,,0,0,0,,
Dialogue: 0,0:00:28.74,0:00:30.32,Default,,0,0,0,,‫أيقلق أحدهم عليّ؟
Dialogue: 0,0:00:30.49,0:00:33.57,Default,,0,0,0,,‫لـ... لم أقصد هذا!
Dialogue: 0,0:00:35.20,0:00:36.03,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:00:36.79,0:00:38.45,Default,,0,0,0,,‫لن ينفعنا الخوف بشيء.
Dialogue: 0,0:00:45.96,0:00:47.55,Default,,0,0,0,,‫مُمتاز، أنتِ مُجدّدًا.
Dialogue: 0,0:00:47.88,0:00:49.09,Default,,0,0,0,,‫أنا حارستك ومُرافقتك.
Dialogue: 0,0:00:49.51,0:00:52.47,Default,,0,0,0,,‫ينبغي أن أحرص على ألّا\N‫يهرب شخص مُعيّن مُجدّدًا.
Dialogue: 0,0:00:53.05,0:00:55.43,Default,,0,0,0,,‫تنتظرنا سيارة الفرقة هناك.
Dialogue: 0,0:00:55.89,0:00:58.56,Default,,0,0,0,,‫ستركب في الخلف معي.
Dialogue: 0,0:00:59.56,0:01:01.60,Default,,0,0,0,,‫إن كنت لا تملك أسئلة، فلننطلق.
Dialogue: 0,0:01:02.02,0:01:03.90,Default,,0,0,0,,‫أُفضّل ألّا نُضيّع المزيد من الوقت.
Dialogue: 0,0:01:04.69,0:01:06.90,Default,,0,0,0,,‫أجل، أجل أيّتها المتسلّطة الـ—
Dialogue: 0,0:01:07.48,0:01:09.65,Default,,0,0,0,,‫حسنًا، عليّ الذهاب.
Dialogue: 0,0:01:11.15,0:01:13.95,Default,,0,0,0,,‫إيّاك أن تموت أيّها الشقيّ المزعج!
Dialogue: 0,0:01:14.20,0:01:15.66,Default,,0,0,0,,‫لا تقلق عليّ.
Dialogue: 0,0:01:15.82,0:01:18.62,Default,,0,0,0,,‫احرص أنت على ألّا تموت\N‫في غيابي أيّها العجوز الخرف.
Dialogue: 0,0:01:21.71,0:01:23.54,Default,,0,0,0,,‫حسنًا، أراك لاحقًا يا جدّي.
Dialogue: 0,0:03:01.18,0:03:02.10,Default,,0,0,0,,‫مهلًا...
Dialogue: 0,0:03:02.68,0:03:03.93,Default,,0,0,0,,‫ما خطب هذه الأشياء؟
Dialogue: 0,0:03:04.14,0:03:05.02,Default,,0,0,0,,‫صدقًا...
Dialogue: 0,0:03:05.06,0:03:07.77,Default,,0,0,0,,‫كيف انتهى بي المطاف مُرافقةً لهذا الفتى؟
Dialogue: 0,0:03:07.98,0:03:08.81,Default,,0,0,0,,‫يا إلهي!
Dialogue: 0,0:03:09.40,0:03:10.65,Default,,0,0,0,,‫هذا سُخف!
Dialogue: 0,0:03:10.81,0:03:12.69,Default,,0,0,0,,‫قيّدتموني كالسجناء!
Dialogue: 0,0:03:12.82,0:03:14.07,Default,,0,0,0,,‫عليك أن تصمت.
Dialogue: 0,0:03:14.69,0:03:16.49,Default,,0,0,0,,‫أنت سجيننا بالفعل.
Dialogue: 0,0:03:16.61,0:03:18.28,Default,,0,0,0,,‫وماذا تقصدين بهذا؟
Dialogue: 0,0:03:18.82,0:03:20.82,Default,,0,0,0,,‫لم تَعُد بشريًّا.
Dialogue: 0,0:03:21.16,0:03:23.58,Default,,0,0,0,,‫أنت مسخٌ نصفه بشريّ ونصفه مونونوكي!
Dialogue: 0,0:03:23.87,0:03:25.20,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:03:25.50,0:03:29.96,Default,,0,0,0,,‫المونونوكي هم أهداف المكتب الرئيسية.
Dialogue: 0,0:03:30.33,0:03:33.71,Default,,0,0,0,,‫وأنت لست استثناءً.
Dialogue: 0,0:03:34.50,0:03:37.30,Default,,0,0,0,,‫لا أفهم حقًّا فيمَ يُفكّر الرئيس والمسؤولون،
Dialogue: 0,0:03:37.67,0:03:38.72,Default,,0,0,0,,‫لكنّني مُحترفة.
Dialogue: 0,0:03:38.80,0:03:40.80,Default,,0,0,0,,‫آخذ عملي على مَحمَل الجدّ.
Dialogue: 0,0:03:41.80,0:03:43.76,Default,,0,0,0,,‫إن كُلّفتُ بمهمة الحراسة،
Dialogue: 0,0:03:43.85,0:03:45.68,Default,,0,0,0,,‫فسأُنجز واجباتي،
Dialogue: 0,0:03:45.81,0:03:47.35,Default,,0,0,0,,‫بغضّ النظر عمّا طُلِب منّي حمايته.
Dialogue: 0,0:03:47.60,0:03:51.98,Default,,0,0,0,,‫عجبًا، تدعينني بالمسخ الآن.
Dialogue: 0,0:03:52.23,0:03:54.73,Default,,0,0,0,,‫أتعلمين، عاملتكِ بلطفٍ لأنّكِ فتاة!
Dialogue: 0,0:03:57.94,0:03:58.86,Default,,0,0,0,,‫مهلًا...
Dialogue: 0,0:03:58.90,0:04:01.49,Default,,0,0,0,,‫أسمعت ذلك؟
Dialogue: 0,0:04:01.70,0:04:02.95,Default,,0,0,0,,‫أنت تتخيّل.
Dialogue: 0,0:04:04.83,0:04:05.91,Default,,0,0,0,,‫أملك شيئين.
Dialogue: 0,0:04:06.16,0:04:09.12,Default,,0,0,0,,‫شيئين يثيران غضبي بشدّة.
Dialogue: 0,0:04:09.46,0:04:13.13,Default,,0,0,0,,‫المونونوكي، والمُتحيّزون جنسيًّا أمثالك!
Dialogue: 0,0:04:13.42,0:04:15.00,Default,,0,0,0,,‫أكلامي واضح؟
Dialogue: 0,0:04:15.50,0:04:16.50,Default,,0,0,0,,‫هذا يعني...
Dialogue: 0,0:04:16.96,0:04:19.84,Default,,0,0,0,,‫أنّك لا وجود لك بالنسبة لي.
Dialogue: 0,0:04:21.05,0:04:22.68,Default,,0,0,0,,‫والآن أطبق فمك و—
Dialogue: 0,0:04:22.72,0:04:25.39,Default,,0,0,0,,‫أستتوقّفان عن هذا!
Dialogue: 0,0:04:25.89,0:04:29.39,Default,,0,0,0,,‫لا يستطيع المرء أن يغفو قليلًا هنا!
Dialogue: 0,0:04:30.89,0:04:32.90,Default,,0,0,0,,‫وتتساءلون لِمَ أمقت الصغار.
Dialogue: 0,0:04:33.06,0:04:34.52,Default,,0,0,0,,‫راغو...
Dialogue: 0,0:04:34.73,0:04:36.82,Default,,0,0,0,,‫تساءلتُ عن سبب هدوئك!
Dialogue: 0,0:04:36.98,0:04:38.94,Default,,0,0,0,,‫أردتَ النوم أكثر فحسب إذًا؟
Dialogue: 0,0:04:39.07,0:04:42.20,Default,,0,0,0,,‫حاولتُ، إلى أن بدأتما بالثرثرة.
Dialogue: 0,0:04:43.03,0:04:44.03,Default,,0,0,0,,‫لكن دَعنا من هذا...
Dialogue: 0,0:04:44.78,0:04:48.16,Default,,0,0,0,,‫يُفاجئني أن تحرسنا فتاة صغيرة...
Dialogue: 0,0:04:48.37,0:04:51.75,Default,,0,0,0,,‫يبدو أنّ المكتب يُعاني نقصًا في الأفراد.
Dialogue: 0,0:04:51.96,0:04:53.08,Default,,0,0,0,,‫أيها المونونوكي القذر...
Dialogue: 0,0:04:53.12,0:04:54.54,Default,,0,0,0,,‫لا ينبغي لك التحدّث إليّ أصلًا!
Dialogue: 0,0:04:55.88,0:04:58.17,Default,,0,0,0,,‫إنّها شرسة على الأقل.
Dialogue: 0,0:04:58.59,0:05:01.80,Default,,0,0,0,,‫ألا يُفترض بك القلق بشأن أمرٍ آخر؟
Dialogue: 0,0:05:02.22,0:05:03.80,Default,,0,0,0,,‫إلامَ ترمي؟
Dialogue: 0,0:05:05.26,0:05:07.72,Default,,0,0,0,,‫إنّه... ضبابيّ بشكلٍ غريب.
Dialogue: 0,0:05:08.68,0:05:11.18,Default,,0,0,0,,‫حسنًا، نحن نتّجه نحو الجبال.
Dialogue: 0,0:05:11.48,0:05:13.44,Default,,0,0,0,,‫أظنّ أنّه عليّ إضاءة المصابيح.
Dialogue: 0,0:05:14.81,0:05:15.94,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:05:17.69,0:05:19.69,Default,,0,0,0,,‫مهلًا، أيًّا كان هذا، إنّه ضخم!
Dialogue: 0,0:05:19.78,0:05:20.90,Default,,0,0,0,,‫يا أهلًا!
Dialogue: 0,0:05:24.95,0:05:28.37,Default,,0,0,0,,‫عجبًا، هذه الشاحنة تهتزّ!
Dialogue: 0,0:05:30.41,0:05:31.87,Default,,0,0,0,,‫تبًّا!
Dialogue: 0,0:05:32.54,0:05:34.62,Default,,0,0,0,,‫ما الذي يحدث الآن؟
Dialogue: 0,0:05:35.12,0:05:36.38,Default,,0,0,0,,‫يُراودني شعور سيّئ.
Dialogue: 0,0:05:36.79,0:05:38.34,Default,,0,0,0,,‫سأذهب للتحقّق!
Dialogue: 0,0:05:38.46,0:05:39.71,Default,,0,0,0,,‫ابقَ مكانك!
Dialogue: 0,0:05:39.84,0:05:41.63,Default,,0,0,0,,‫ماذا؟! ما الّذي—؟
Dialogue: 0,0:05:42.80,0:05:43.63,Default,,0,0,0,,‫هذا الضباب...
Dialogue: 0,0:05:44.72,0:05:45.89,Italics,,0,0,0,,‫لا شكّ في هذا.
Dialogue: 0,0:05:46.47,0:05:48.26,Italics,,0,0,0,,‫دخلنا منطقة طيفية.
Dialogue: 0,0:05:48.51,0:05:50.81,Italics,,0,0,0,,‫تبًّا... كيف غفلتُ عن هذا؟!
Dialogue: 0,0:05:52.77,0:05:55.52,Default,,0,0,0,,‫ها هي قادمة، ها هي قادمة!
Dialogue: 0,0:05:56.48,0:05:58.40,Default,,0,0,0,,‫مهلًا، ما هذا!
Dialogue: 0,0:05:58.52,0:05:59.65,Italics,,0,0,0,,‫مونونوكي.
Dialogue: 0,0:05:59.73,0:06:02.65,Default,,0,0,0,,‫أمِلتُ ببعض اللحم الطريّ.
Dialogue: 0,0:06:04.61,0:06:06.91,Default,,0,0,0,,‫يا لها من خيبة أمل!
Dialogue: 0,0:06:07.28,0:06:11.66,Default,,0,0,0,,‫تحمّستُ كثيرًا لتلقّي مهمة كهذه مُجدّدًا!
Dialogue: 0,0:06:12.25,0:06:16.17,Default,,0,0,0,,‫ثم اكتشفتُ أنّ السائقين\N‫لا يصلحان كمُقبّلاتٍ حتى!
Dialogue: 0,0:06:16.50,0:06:18.29,Default,,0,0,0,,‫ظننتُ أنّ الحارسة ستكون وجبة شهيّة،
Dialogue: 0,0:06:18.33,0:06:19.92,Default,,0,0,0,,‫لكنّها مُجرّد قزمة!
Dialogue: 0,0:06:20.25,0:06:23.80,Default,,0,0,0,,‫هذا المكتب مُثير للشفقة!
Dialogue: 0,0:06:24.63,0:06:26.30,Default,,0,0,0,,‫أوغاد...
Dialogue: 0,0:06:26.43,0:06:27.26,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:06:27.47,0:06:30.14,Default,,0,0,0,,‫جميعكم حُثالة مُتحيّزون...
Dialogue: 0,0:06:30.43,0:06:31.93,Default,,0,0,0,,‫حسنًا، طفح الكيل!
Dialogue: 0,0:06:32.56,0:06:34.06,Default,,0,0,0,,‫قد تدفعون ملاكًا لفقدان صوابه...
Dialogue: 0,0:06:34.14,0:06:35.06,Default,,0,0,0,,‫وأنا لستُ ملاكًا!
Dialogue: 0,0:06:40.40,0:06:41.94,Default,,0,0,0,,‫أجل!
Dialogue: 0,0:06:42.15,0:06:43.94,Default,,0,0,0,,‫كان هذا رائعًا!
Dialogue: 0,0:06:44.53,0:06:45.65,Default,,0,0,0,,‫مُذهل!
Dialogue: 0,0:06:45.74,0:06:47.20,Default,,0,0,0,,‫يبدو أنّنا سنمرح قليلًا!
Dialogue: 0,0:06:47.99,0:06:50.45,Default,,0,0,0,,‫مهلًا! إلامَ ستظلّ تمضغ\N‫تلك اليد أيّها البدين!
Dialogue: 0,0:06:50.74,0:06:53.24,Default,,0,0,0,,‫سأُريك وضع القتال الآن.
Dialogue: 0,0:07:02.17,0:07:03.46,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:07:03.63,0:07:06.72,Default,,0,0,0,,‫حان وقت التحلية!
Dialogue: 0,0:07:24.90,0:07:27.61,Italics,,0,0,0,,‫تبًّا، وغدان، وكُلٌّ منهما فريد.
Dialogue: 0,0:07:28.07,0:07:30.57,Italics,,0,0,0,,‫الضخم غبيّ، وبطيء الحركة،
Dialogue: 0,0:07:30.82,0:07:33.24,Italics,,0,0,0,,‫لكنّه صلب كالصخر.
Dialogue: 0,0:07:34.20,0:07:36.45,Italics,,0,0,0,,‫سأبدأ بالنحيل أوّلًا...
Dialogue: 0,0:07:36.50,0:07:38.25,Default,,0,0,0,,‫مهلًا، أنتِ تُسهّلين الأمر!
Dialogue: 0,0:07:41.96,0:07:42.96,Default,,0,0,0,,‫مهلًا، مهلًا!
Dialogue: 0,0:07:43.25,0:07:44.84,Default,,0,0,0,,‫ما الذي يجري في الخارج؟
Dialogue: 0,0:07:45.09,0:07:46.17,Default,,0,0,0,,‫إنّهم مونونوكي.
Dialogue: 0,0:07:46.34,0:07:47.17,Default,,0,0,0,,‫أتعلم؟
Dialogue: 0,0:07:47.22,0:07:48.47,Default,,0,0,0,,‫أنسيتَ من تُحادث؟
Dialogue: 0,0:07:48.80,0:07:51.68,Default,,0,0,0,,‫بينما كنتما تتغازلان كعصفورَي حُبّ—
Dialogue: 0,0:07:51.72,0:07:54.35,Default,,0,0,0,,‫لم يكن غزلًا! أترغب في الموت؟
Dialogue: 0,0:07:54.56,0:07:57.56,Default,,0,0,0,,‫أخبرتني حاسّة شمّي بدخولنا المنطقة.
Dialogue: 0,0:07:57.89,0:07:59.60,Default,,0,0,0,,‫المنطقة؟
Dialogue: 0,0:07:59.89,0:08:01.48,Default,,0,0,0,,‫منطقة طيفية.
Dialogue: 0,0:08:01.60,0:08:04.82,Default,,0,0,0,,‫تُصبح المنطقة الضبابية\N‫أشبه بعالم أمنتي مُؤقّت،
Dialogue: 0,0:08:04.98,0:08:07.32,Default,,0,0,0,,‫عالمٌ معزول عن هذا الواقع الماديّ.
Dialogue: 0,0:08:07.78,0:08:08.61,Default,,0,0,0,,‫أمنتي؟
Dialogue: 0,0:08:08.69,0:08:12.32,Default,,0,0,0,,‫إنّه بُعدٌ مُنفصل عن\N‫عالم الفانين الخاص بكم...
Dialogue: 0,0:08:12.74,0:08:15.33,Default,,0,0,0,,‫إنّه عالم المونونوكي.
Dialogue: 0,0:08:16.66,0:08:17.91,Default,,0,0,0,,‫لم أفهم شيئًا،
Dialogue: 0,0:08:17.95,0:08:19.41,Default,,0,0,0,,‫لكنّني أُخمّن أنّه أمرٌ سيّئ!
Dialogue: 0,0:08:19.71,0:08:21.87,Default,,0,0,0,,‫لذا أسرع وساعدني في خلع هذه الأشياء!
Dialogue: 0,0:08:22.08,0:08:22.92,Default,,0,0,0,,‫لا أستطيع.
Dialogue: 0,0:08:22.96,0:08:23.79,Default,,0,0,0,,‫لِمَ لا؟!
Dialogue: 0,0:08:23.92,0:08:26.00,Default,,0,0,0,,‫إنّها ليست أصفادًا عادية.
Dialogue: 0,0:08:26.21,0:08:28.76,Default,,0,0,0,,‫صُمّمت لكبح الطاقة الطيفية.
Dialogue: 0,0:08:29.22,0:08:31.97,Default,,0,0,0,,‫لا أملك القوة لخلعها الآن.
Dialogue: 0,0:08:32.18,0:08:35.30,Default,,0,0,0,,‫ لا أُصدّق هذا!
Dialogue: 0,0:08:35.39,0:08:38.64,Default,,0,0,0,,‫حسنًا! سأخرج لأجعلها تخلعها!
Dialogue: 0,0:08:38.98,0:08:40.10,Default,,0,0,0,,‫سأدعهم وشأنهم.
Dialogue: 0,0:08:40.27,0:08:41.14,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:08:41.23,0:08:44.48,Default,,0,0,0,,‫ألم تكن تلك الأصفاد واضحة بما يكفي؟
Dialogue: 0,0:08:45.15,0:08:48.40,Default,,0,0,0,,‫المكتب والمونونوكي وجهان لعملة واحدة.
Dialogue: 0,0:08:48.69,0:08:51.70,Default,,0,0,0,,‫يُريدون استغلالنا فحسب.
Dialogue: 0,0:08:52.78,0:08:56.49,Default,,0,0,0,,‫نحن مُجرّد مُمتلكات بالنسبة لهم.
Dialogue: 0,0:08:56.70,0:09:00.66,Default,,0,0,0,,‫لا نملك سببًا للتورّط مع أمثالهم.
Dialogue: 0,0:09:01.08,0:09:03.08,Default,,0,0,0,,‫دَعهم يتقاتلون...
Dialogue: 0,0:09:03.37,0:09:05.84,Default,,0,0,0,,‫دَعهم يقتلون بعضهم، وسنهرب نحن.
Dialogue: 0,0:09:06.88,0:09:08.42,Default,,0,0,0,,‫مهلًا يا راغو.
Dialogue: 0,0:09:08.50,0:09:09.34,Default,,0,0,0,,
Dialogue: 0,0:09:09.80,0:09:11.59,Default,,0,0,0,,‫أيُفترض بهذا أن يعني لي شيئًا؟
Dialogue: 0,0:09:11.72,0:09:12.84,Default,,0,0,0,,‫لم أفهمك مُجدّدًا.
Dialogue: 0,0:09:13.05,0:09:15.39,Default,,0,0,0,,‫ماذا؟ أكنتَ تُصغي أصلًا؟!
Dialogue: 0,0:09:15.64,0:09:18.89,Default,,0,0,0,,‫لا يتعلّق الأمر بالمكتب أو المونونوكي.
Dialogue: 0,0:09:19.39,0:09:21.14,Default,,0,0,0,,‫شيءٌ واحد يهمّ الآن...
Dialogue: 0,0:09:21.98,0:09:23.64,Default,,0,0,0,,‫هُناك شخصٌ في الخارج،
Dialogue: 0,0:09:23.85,0:09:25.65,Default,,0,0,0,,‫ويُقاتل لأجلنا!
Dialogue: 0,0:09:26.40,0:09:28.15,Default,,0,0,0,,‫لا أعرف بشأنك...
Dialogue: 0,0:09:28.36,0:09:29.65,Default,,0,0,0,,‫لكن بصفتي رجلًا،
Dialogue: 0,0:09:30.28,0:09:32.40,Default,,0,0,0,,‫لا يُمكِنني الجلوس هنا مكتوف الأيدي!
Dialogue: 0,0:09:43.08,0:09:46.17,Default,,0,0,0,,‫تتحدّث عن الرجولة، وأنت ترتعد كالورقة.
Dialogue: 0,0:09:46.75,0:09:47.92,Default,,0,0,0,,‫اصمت فحسب!
Dialogue: 0,0:09:49.00,0:09:51.59,Default,,0,0,0,,‫انظروا من لدينا هنا!
Dialogue: 0,0:09:52.17,0:09:54.68,Default,,0,0,0,,‫إنّه أنت، الحُثالة الذي تلبّسه راغو.
Dialogue: 0,0:09:55.13,0:09:57.89,Default,,0,0,0,,‫أُمِرنا بإحضارك حيًّا.
Dialogue: 0,0:09:58.18,0:10:01.18,Default,,0,0,0,,‫لكن بصراحة، لا يكترث بالي. لك الخيار!
Dialogue: 0,0:10:01.39,0:10:03.06,Default,,0,0,0,,‫تملك عشر ثوانٍ!
Dialogue: 0,0:10:03.35,0:10:06.19,Default,,0,0,0,,‫استسلم أو كُن طبقي الأخير.
Dialogue: 0,0:10:06.85,0:10:08.06,Default,,0,0,0,,‫وواحد...
Dialogue: 0,0:10:08.19,0:10:10.27,Italics,,0,0,0,,‫إذًا هم يسعون خلف راغو...
Dialogue: 0,0:10:10.90,0:10:13.15,Default,,0,0,0,,‫لكن كيف علموا بأمر النقل؟
Dialogue: 0,0:10:13.61,0:10:14.82,Default,,0,0,0,,‫ أنتِ!
Dialogue: 0,0:10:14.90,0:10:15.95,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:10:16.03,0:10:17.49,Default,,0,0,0,,‫ماذا تقصدين بماذا؟
Dialogue: 0,0:10:17.87,0:10:20.58,Default,,0,0,0,,‫اخلعي هذه لنتمكّن من المساعدة!
Dialogue: 0,0:10:20.91,0:10:23.91,Default,,0,0,0,,‫أنت تتقوّل عليّ الآن.
Dialogue: 0,0:10:24.00,0:10:24.87,Default,,0,0,0,,‫راغو!
Dialogue: 0,0:10:24.91,0:10:25.83,Default,,0,0,0,,‫مُستحيل.
Dialogue: 0,0:10:25.87,0:10:26.71,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:10:26.87,0:10:28.54,Default,,0,0,0,,‫بتلك الأيدي المُقزّزة للمونونوكي؟
Dialogue: 0,0:10:28.67,0:10:30.13,Default,,0,0,0,,‫لا بُدّ أنّك تمزح!
Dialogue: 0,0:10:30.21,0:10:32.26,Default,,0,0,0,,‫هل جننتِ؟ ليس هذا وقت—
Dialogue: 0,0:10:33.26,0:10:35.05,Default,,0,0,0,,‫انتهى الوقت!
Dialogue: 0,0:10:35.26,0:10:37.72,Default,,0,0,0,,‫ستُؤكلان!
Dialogue: 0,0:10:39.05,0:10:40.64,Default,,0,0,0,,‫أيها الوغد الضخم!
Dialogue: 0,0:10:40.93,0:10:42.60,Default,,0,0,0,,‫حسنًا، كفى هُراءً!
Dialogue: 0,0:10:42.85,0:10:43.98,Default,,0,0,0,,‫تغلّبي على غضبك،
Dialogue: 0,0:10:44.06,0:10:45.64,Default,,0,0,0,,‫وإلّا سينتهي بنا المطاف\N‫في جوف هذا الوغد!
Dialogue: 0,0:10:45.94,0:10:47.65,Default,,0,0,0,,‫أنت، أتُصغين؟!
Dialogue: 0,0:10:48.85,0:10:50.90,Italics,,0,0,0,,‫تبًّا.
Dialogue: 0,0:11:00.53,0:11:02.91,Italics,,0,0,0,,‫سمعتُ أنّه حدث أثناء تأدية الواجب.
Dialogue: 0,0:11:03.12,0:11:06.58,Italics,,0,0,0,,‫أن تنتهي حياتها على يد مونونوكي!
Dialogue: 0,0:11:06.71,0:11:10.67,Italics,,0,0,0,,‫والسيّدة إيتشيكا بلغت الخامسة لتوّها.
Dialogue: 0,0:11:10.84,0:11:11.92,Italics,,0,0,0,,‫يا للأسف.
Dialogue: 0,0:11:12.34,0:11:15.42,Italics,,0,0,0,,‫أتساءل عمّا سيفعله\N‫السيّد بشأن سلالة العائلة؟
Dialogue: 0,0:11:15.51,0:11:19.68,Italics,,0,0,0,,‫لا يُمكِن لفتاة أن تُصبح وريثة أبدًا.
Dialogue: 0,0:11:21.51,0:11:22.64,Italics,,0,0,0,,‫أبي...
Dialogue: 0,0:11:23.39,0:11:26.39,Italics,,0,0,0,,‫سأكون أنا من يخلف عشيرة كيشيموجين.
Dialogue: 0,0:11:27.39,0:11:31.36,Italics,,0,0,0,,‫سأدرس، وسأتدرّب.
Dialogue: 0,0:11:32.77,0:11:36.61,Italics,,0,0,0,,‫أنا، إيتشيكا، أَعِدُك،
Dialogue: 0,0:11:36.82,0:11:39.99,On Top,Sign,0,0,0,,‫عشيرة كيشيموجين
Dialogue: 0,0:11:37.61,0:11:39.86,Italics,,0,0,0,,‫سأجعلكما فخورَين بي يومًا ما...
Dialogue: 0,0:11:40.41,0:11:42.58,Italics,,0,0,0,,‫سأُصبح مُحقّقة ذات شرف ومهارة!
Dialogue: 0,0:11:42.66,0:11:43.62,Default,,0,0,0,,‫أنت!
Dialogue: 0,0:11:44.33,0:11:45.16,Default,,0,0,0,,‫أنت!
Dialogue: 0,0:11:46.37,0:11:47.66,Default,,0,0,0,,‫قُلتِ هذا سلفًا.
Dialogue: 0,0:11:48.16,0:11:50.37,Default,,0,0,0,,‫أنّكِ تأخذين عملكِ على مَحمَل الجدّ.
Dialogue: 0,0:11:50.58,0:11:52.88,Default,,0,0,0,,‫تُنجزين واجباتكِ، مهما حدث.
Dialogue: 0,0:11:53.34,0:11:55.76,Default,,0,0,0,,‫لذا افعلي ما يلزم لإتمام هذه المهمة!
Dialogue: 0,0:11:58.34,0:11:59.38,Default,,0,0,0,,‫أنتِ مُحترفة...
Dialogue: 0,0:11:59.88,0:12:01.14,Default,,0,0,0,,‫أليس كذلك؟
Dialogue: 0,0:12:05.72,0:12:07.06,Default,,0,0,0,,‫حسنًا يا راغو!
Dialogue: 0,0:12:08.35,0:12:10.31,Default,,0,0,0,,‫فلنُنهِ هذا الأمر!
Dialogue: 0,0:12:12.02,0:12:13.02,Default,,0,0,0,,‫حسنًا!
Dialogue: 0,0:12:19.07,0:12:20.86,Default,,0,0,0,,‫مـ... ماذا؟! مـ... مُستحيل...!!
Dialogue: 0,0:12:21.36,0:12:23.20,Default,,0,0,0,,‫مهلًا، أنت تُسهّل الأمر...
Dialogue: 0,0:12:23.49,0:12:24.33,Default,,0,0,0,,‫تبًّا!
Dialogue: 0,0:12:40.05,0:12:41.84,Default,,0,0,0,,‫أنت لا تُجيد إنهاء الأمور حقًّا.
Dialogue: 0,0:12:42.01,0:12:46.81,Default,,0,0,0,,‫اخرس. لم أملك الوقت لإتقان الهبوط.
Dialogue: 0,0:12:47.39,0:12:52.77,Default,,0,0,0,,‫مؤلم... تبًّا، كم مرّة حدث هذا اليوم؟
Dialogue: 0,0:12:52.94,0:12:54.02,Default,,0,0,0,,‫لِعلمك فحسب...
Dialogue: 0,0:12:54.19,0:12:55.06,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:12:55.94,0:12:58.15,Default,,0,0,0,,‫لن تتلقّى "شُكرًا" منّي.
Dialogue: 0,0:12:58.78,0:13:01.61,Default,,0,0,0,,‫أيتها المُتعجرفة الصغيرة الجاحدة!
Dialogue: 0,0:13:01.90,0:13:03.16,Default,,0,0,0,,‫أبعدي مُؤخّرتكِ عن رأسي!
Dialogue: 0,0:13:03.32,0:13:05.83,Default,,0,0,0,,‫أخبَرتُك، كان علينا تركها تموت.
Dialogue: 0,0:13:06.95,0:13:08.99,Default,,0,0,0,,‫وكأنّني توقّعتُ هذا.
Dialogue: 0,0:13:09.25,0:13:10.83,Default,,0,0,0,,‫ولن تتلقّي واحدة منّي أيضًا.
Dialogue: 0,0:13:11.08,0:13:13.50,Default,,0,0,0,,‫اسمعي، قاتلتِ لحمايتنا،
Dialogue: 0,0:13:13.58,0:13:16.17,Default,,0,0,0,,‫وقاتلنا لمُساعدتك.
Dialogue: 0,0:13:17.09,0:13:19.71,Default,,0,0,0,,‫هذا يعني أنّنا مُتعادلان.
Dialogue: 0,0:13:20.42,0:13:21.47,Default,,0,0,0,,‫إذًا، أأنتِ بخير؟
Dialogue: 0,0:13:24.39,0:13:25.47,Default,,0,0,0,,‫لديّ اسم!
Dialogue: 0,0:13:25.51,0:13:26.35,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:27.30,0:13:28.39,Default,,0,0,0,,‫ إيتشيكا.
Dialogue: 0,0:13:28.85,0:13:30.60,Default,,0,0,0,,‫كيشيموجين إيتشيكا.
Dialogue: 0,0:13:31.02,0:13:32.85,Default,,0,0,0,,‫حاوِل تذكّره، مفهوم؟
Dialogue: 0,0:13:33.19,0:13:35.73,Default,,0,0,0,,‫يُمكِنك التوقّف عن قول "مهلًا" و"أنتِ".
Dialogue: 0,0:13:36.23,0:13:37.36,Default,,0,0,0,,‫حسنًا، حسنًا.
Dialogue: 0,0:13:38.07,0:13:40.15,Default,,0,0,0,,‫إذًا، أيُمكِنني سؤالكِ عن شيء يا إيتشيكا؟
Dialogue: 0,0:13:40.69,0:13:41.53,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:43.32,0:13:45.24,Default,,0,0,0,,‫ما الذي نفعله الآن؟
Dialogue: 0,0:13:47.20,0:13:48.41,Default,,0,0,0,,‫نمشي.
Dialogue: 0,0:13:48.53,0:13:49.87,Default,,0,0,0,,‫صدقًا؟
Dialogue: 0,0:13:51.83,0:13:56.04,Default,,0,0,0,,‫هذا كُلّ ما نملكه عن راغو وأزوما جيرو.
Dialogue: 0,0:13:56.63,0:14:00.88,Default,,0,0,0,,‫ومع ذلك، أملك اقتراحًا.
Dialogue: 0,0:14:01.63,0:14:02.88,Italics,,0,0,0,,‫جيّد.
Dialogue: 0,0:14:03.42,0:14:04.93,Italics,,0,0,0,,‫يُمكِنك المُضيّ قُدمًا.
Dialogue: 0,0:14:06.47,0:14:08.01,Default,,0,0,0,,‫سأُوجز في حديثي.
Dialogue: 0,0:14:08.18,0:14:12.27,Default,,0,0,0,,‫أنا، شيبا ريوسكي، بصفتي رئيس\N‫شعبة العمليات الخاصة الثانية،
Dialogue: 0,0:14:12.64,0:14:15.02,Default,,0,0,0,,‫أطلب الإذن لتأسيس فرقة جديدة،
Dialogue: 0,0:14:15.19,0:14:18.02,Default,,0,0,0,,‫وأُريد أزوما جيرو كأحد مُحقّقيّ.
Dialogue: 0,0:14:18.86,0:14:20.15,Italics,,0,0,0,,‫أمختلّ أنت؟
Dialogue: 0,0:14:20.23,0:14:21.82,Italics,,0,0,0,,‫أترغب في جعل فتى نصفه مونونوكي
Dialogue: 0,0:14:21.90,0:14:23.65,Italics,,0,0,0,,‫عميلًا سرّيًّا؟
Dialogue: 0,0:14:23.78,0:14:27.03,Default,,0,0,0,,‫لم يُظهر راغو أيّ عداء مُباشر تُجاهنا بعد.
Dialogue: 0,0:14:27.45,0:14:30.99,Default,,0,0,0,,‫ويبدو أنّه يتعاون مع أزوما جيرو أيضًا.
Dialogue: 0,0:14:31.74,0:14:34.71,Default,,0,0,0,,‫على أيّ حال، العدوّ يسعى خلف راغو بوضوح.
Dialogue: 0,0:14:35.16,0:14:37.04,Default,,0,0,0,,‫بدلًا من الحُكم عليه بالتعفّن في الأسر،
Dialogue: 0,0:14:37.12,0:14:39.96,Default,,0,0,0,,‫يُمكِنه، إن جاز التعبير،\N‫أن يكون الطُعم المِثاليّ.
Dialogue: 0,0:14:40.29,0:14:44.17,Italics,,0,0,0,,‫لكنّ الطُعم لا يسبق الصيد إلّا بوجود خُطّاف.
Dialogue: 0,0:14:46.51,0:14:48.84,Default,,0,0,0,,‫إذًا، هل تتحوّلان عند القتال؟
Dialogue: 0,0:14:49.35,0:14:51.35,Default,,0,0,0,,‫ لا "نتحوّل".
Dialogue: 0,0:14:51.64,0:14:54.31,Default,,0,0,0,,‫نُغيّر مظهرنا بالوهم.
Dialogue: 0,0:14:54.85,0:14:57.73,Default,,0,0,0,,‫لا يُمكِننا التجوّل في البلدة\N‫بهذا المظهر، أليس كذلك؟
Dialogue: 0,0:14:58.10,0:15:00.82,Default,,0,0,0,,‫أجل، أظنّك مُحقًّا.
Dialogue: 0,0:15:01.19,0:15:04.44,Italics,,0,0,0,,‫إذًا وعاء المونونوكي الشابّ\N‫خاصّتنا من سلالة نينجا، صحيح؟
Dialogue: 0,0:15:04.61,0:15:05.82,Italics,,0,0,0,,‫أسيكون مُفيدًا؟
Dialogue: 0,0:15:06.32,0:15:09.57,Default,,0,0,0,,‫حسنًا، تدرّب عُملائنا مُؤخّرًا ضدّ بشرٍ ضُعفاء،
Dialogue: 0,0:15:09.62,0:15:11.58,Default,,0,0,0,,‫لذا أقول إنّه يملك الأفضلية.
Dialogue: 0,0:15:11.83,0:15:13.16,Default,,0,0,0,,‫أملك ثقةً تامّة
Dialogue: 0,0:15:13.24,0:15:16.08,Default,,0,0,0,,‫بأنّ المعركة ستصقل مهاراته أكثر.
Dialogue: 0,0:15:16.29,0:15:20.42,Default,,0,0,0,,‫وسأتحمّل المسؤولية الكاملة\N‫عن سلاحنا المصقول حديثًا.
Dialogue: 0,0:15:20.88,0:15:24.09,Default,,0,0,0,,‫خُطّتي هي وحدة تجريبية صغيرة.
Dialogue: 0,0:15:24.38,0:15:28.09,Default,,0,0,0,,‫تتكوّن من خمسة عُملاء، بمن فيهم أنا.
Dialogue: 0,0:15:28.51,0:15:30.09,Default,,0,0,0,,‫ستتضمّن أوسامي كمُساعدتي،
Dialogue: 0,0:15:30.43,0:15:32.35,Default,,0,0,0,,‫ومُبتدئًا آخر.
Dialogue: 0,0:15:32.89,0:15:35.77,Default,,0,0,0,,‫ستكون قوة ضاربة مُتنقّلة\N‫وسرّيّة لمُكافحة المونونوكي،
Dialogue: 0,0:15:36.10,0:15:39.35,Default,,0,0,0,,‫تحمل الاسم الرمزيّ "الشعلة السوداء".
Dialogue: 0,0:15:39.90,0:15:41.02,Default,,0,0,0,,‫إذًا؟
Dialogue: 0,0:15:41.44,0:15:43.86,Default,,0,0,0,,‫أأثرتُ اهتمامكم؟
Dialogue: 0,0:15:53.87,0:15:55.62,Italics,,0,0,0,,‫في غضون أسبوع واحد فحسب...
Dialogue: 0,0:15:55.91,0:15:57.33,Italics,,0,0,0,,‫التقيتُ بأغرب قطّ أسود،
Dialogue: 0,0:15:58.12,0:15:59.92,Italics,,0,0,0,,‫والذي تبيّن أنّه مونونوكي.
Dialogue: 0,0:16:00.12,0:16:02.04,Italics,,0,0,0,,‫ثم يتركني غول مونونوكي ضخم
Dialogue: 0,0:16:02.08,0:16:03.88,Italics,,0,0,0,,‫على حافّة الموت،
Dialogue: 0,0:16:04.04,0:16:05.92,Italics,,0,0,0,,‫ويُنقذني القطّ بالاندماج مع جسدي.
Dialogue: 0,0:16:06.55,0:16:09.26,Italics,,0,0,0,,‫ثم يظهر هؤلاء العُملاء\N‫الحكوميّون السرّيّون من العدم...
Dialogue: 0,0:16:10.18,0:16:11.64,Italics,,0,0,0,,‫أخوض أسوأ شجار مع جدّي،
Dialogue: 0,0:16:11.76,0:16:13.64,Italics,,0,0,0,,‫ثم أتعرّض لهجوم من المزيد من المونونوكي.
Dialogue: 0,0:16:14.35,0:16:15.68,Italics,,0,0,0,,‫وها أنا ذا.
Dialogue: 0,0:16:16.18,0:16:19.18,Italics,,0,0,0,,‫إن سألني شخصٌ غريب يومًا، كيف كان أسبوعك،
Dialogue: 0,0:16:19.23,0:16:21.15,Italics,,0,0,0,,‫فلا أعرف حقًّا كيف سأجيب.
Dialogue: 0,0:16:22.52,0:16:24.52,Default,,0,0,0,,‫أاعتدتَ على حياتك الجديدة بعد؟
Dialogue: 0,0:16:24.73,0:16:25.57,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:16:25.86,0:16:27.74,Default,,0,0,0,,‫لا داعي لمُراقبتي منذ بزوغ الفجر.
Dialogue: 0,0:16:27.78,0:16:29.07,Default,,0,0,0,,‫لن أذهب إلى أيّ مكان.
Dialogue: 0,0:16:29.19,0:16:31.86,Default,,0,0,0,,‫تقول هذا بعد أن هربت من مشفانا.
Dialogue: 0,0:16:32.36,0:16:34.16,Default,,0,0,0,,‫حياة جديدة؟ لا تهزأ بي...
Dialogue: 0,0:16:34.83,0:16:37.83,Default,,0,0,0,,‫أظنّني خضعتُ لكُلّ فحصٍ طبّيّ مُمكِن.
Dialogue: 0,0:16:38.00,0:16:40.08,Default,,0,0,0,,‫لم أحظَ بدقيقة واحدة لنفسي!
Dialogue: 0,0:16:40.79,0:16:42.79,Default,,0,0,0,,‫حسنًا، فهمتُ الفكرة.
Dialogue: 0,0:16:43.21,0:16:44.25,Default,,0,0,0,,‫كانت أولويّتي القُصوى...
Dialogue: 0,0:16:44.59,0:16:48.34,Default,,0,0,0,,‫هي التأكّد من عدم وجود أيّ تهديدات.
Dialogue: 0,0:16:49.05,0:16:52.05,Default,,0,0,0,,‫على المكتب... وعليك.
Dialogue: 0,0:16:53.55,0:16:56.72,Default,,0,0,0,,‫على أيّ حال، لا أزال\N‫عاجزًا عن استيعاب الأمر.
Dialogue: 0,0:16:57.60,0:16:58.93,Default,,0,0,0,,‫استيعاب ماذا؟
Dialogue: 0,0:16:59.39,0:17:01.27,Default,,0,0,0,,‫أهذا هو مقرّكم الرئيسيّ بجدّية؟
Dialogue: 0,0:17:01.69,0:17:03.06,Default,,0,0,0,,‫ماذا، هذا المكان؟
Dialogue: 0,0:17:03.27,0:17:07.15,Default,,0,0,0,,‫لِسوء الحظّ، هذا هو المقرّ الرئيسيّ\N‫لشعبة العمليات الخاصة الثانية.
Dialogue: 0,0:17:07.98,0:17:11.78,Default,,0,0,0,,‫تملك كُلّ شعبة قاعدة عمليات خاصّة بها.
Dialogue: 0,0:17:12.15,0:17:13.16,Default,,0,0,0,,‫في الظاهر،
Dialogue: 0,0:17:13.24,0:17:15.95,Default,,0,0,0,,‫تعمل كأيّ شركة أو مُنظّمة أُخرى.
Dialogue: 0,0:17:16.20,0:17:18.70,Default,,0,0,0,,‫هُناك مباني مكاتب ومصانع ومُستشفيات.
Dialogue: 0,0:17:18.91,0:17:21.50,Default,,0,0,0,,‫حتى مكتبات وأضرحة.
Dialogue: 0,0:17:22.12,0:17:25.96,Default,,0,0,0,,‫جميعها أجمل بكثير ممّا نملكه.
Dialogue: 0,0:17:26.25,0:17:28.42,Default,,0,0,0,,‫ليس سهلًا أن تكون في القاع.
Dialogue: 0,0:17:30.05,0:17:32.01,Default,,0,0,0,,‫إذًا شهدتم أيّامًا أفضل.
Dialogue: 0,0:17:32.26,0:17:33.80,Default,,0,0,0,,‫ليس "أنتم".
Dialogue: 0,0:17:33.93,0:17:34.76,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:17:34.76,0:17:37.93,Default,,0,0,0,,‫في هذه المرحلة، ألا\N‫يُفترض أن تكون "نحن"؟
Dialogue: 0,0:17:38.56,0:17:42.43,Default,,0,0,0,,‫أنت واحدٌ منّا الآن يا أزوما جيرو.
Dialogue: 0,0:17:43.81,0:17:45.19,Default,,0,0,0,,‫واحدٌ منكم؟
Dialogue: 0,0:17:45.65,0:17:46.56,Default,,0,0,0,,‫هذا، صحيح؟
Dialogue: 0,0:17:46.61,0:17:49.44,Default,,0,0,0,,‫الفرقة التي تُدعى الشُّعبة السّوداء أو ما شابه.
Dialogue: 0,0:17:49.69,0:17:51.19,Default,,0,0,0,,‫بل الشعلة السوداء.
Dialogue: 0,0:17:51.40,0:17:52.44,Default,,0,0,0,,‫رائعة، أليس كذلك؟
Dialogue: 0,0:17:52.57,0:17:54.86,Default,,0,0,0,,‫شعلة، بُعلة، أيًّا كان.
Dialogue: 0,0:17:55.41,0:17:57.95,Default,,0,0,0,,‫أنا هنا لحماية نفسي.
Dialogue: 0,0:17:58.49,0:18:01.37,Default,,0,0,0,,‫لا أتذكّر مُوافقتي على\N‫أن أكون أحد أتباعكم.
Dialogue: 0,0:18:02.25,0:18:05.96,Default,,0,0,0,,‫هدفنا هو أن يعيش كُلٌّ منّا حُرًّا.
Dialogue: 0,0:18:06.54,0:18:09.00,Default,,0,0,0,,‫سنُقاتل من يتوجّب علينا\N‫قتاله، حتى المونونوكي.
Dialogue: 0,0:18:09.38,0:18:10.96,Default,,0,0,0,,‫ببساطة.
Dialogue: 0,0:18:11.21,0:18:12.88,Italics,,0,0,0,,‫"نحن" إذًا؟
Dialogue: 0,0:18:13.17,0:18:16.97,Italics,,0,0,0,,‫أظنّ أنّه سيستغرق بعض\N‫الوقت ليستوعب الأمر كُلّه.
Dialogue: 0,0:18:17.47,0:18:21.22,Italics,,0,0,0,,‫لن يُجدي المنطق العاديّ معه نفعًا.
Dialogue: 0,0:18:21.47,0:18:23.23,Italics,,0,0,0,,‫شيئًا فشيئًا، على ما أظنّ.
Dialogue: 0,0:18:24.73,0:18:27.86,Default,,0,0,0,,‫ لم يتغيّر المُستودع\N‫القديم بتاتًا!
Dialogue: 0,0:18:28.36,0:18:30.65,Default,,0,0,0,,‫صباح الخير أيها الرئيس!
Dialogue: 0,0:18:30.90,0:18:32.48,Default,,0,0,0,,‫صباح الخير.
Dialogue: 0,0:18:32.57,0:18:36.86,Default,,0,0,0,,‫ماذا؟ أهذا هو أزوما جيرو\N‫الذي سمعتُ عنه الكثير؟
Dialogue: 0,0:18:37.36,0:18:38.24,Default,,0,0,0,,‫من؟
Dialogue: 0,0:18:38.32,0:18:40.58,Default,,0,0,0,,‫إنّها إحدى مرؤوساتي القلائل.
Dialogue: 0,0:18:41.04,0:18:43.62,Default,,0,0,0,,‫تعرّف على مُساعدة رئيس شعبة\N‫العمليات الخاصة الثانية، أوسامي هانا.
Dialogue: 0,0:18:44.16,0:18:47.08,Default,,0,0,0,,‫كانت مشغولة بمهمة أُخرى.
Dialogue: 0,0:18:47.96,0:18:48.83,Default,,0,0,0,,‫مهمة أُخرى؟
Dialogue: 0,0:18:49.13,0:18:51.50,Default,,0,0,0,,‫أوصلنا بالفعل؟
Dialogue: 0,0:18:51.67,0:18:52.84,Default,,0,0,0,,‫يا للأسف.
Dialogue: 0,0:18:53.46,0:18:57.34,Default,,0,0,0,,‫أمِلتُ بقضاء المزيد من الوقت\N‫المُمتع معكِ يا أوسامي-سان.
Dialogue: 0,0:18:57.63,0:19:00.01,Default,,0,0,0,,‫اسمحي لي بمُساعدتكِ في أمتعتك.
Dialogue: 0,0:19:00.51,0:19:03.10,Default,,0,0,0,,‫تكرّمتِ بإيصالي طوال هذا الطريق.
Dialogue: 0,0:19:03.64,0:19:06.14,Default,,0,0,0,,‫فضلًا عن أنّني لا أحتمل رؤية شابة مِثلكِ
Dialogue: 0,0:19:06.31,0:19:08.77,Default,,0,0,0,,‫مُثقلةً بأعمالٍ شاقّة.
Dialogue: 0,0:19:09.15,0:19:10.23,Default,,0,0,0,,‫أرجوك توقّف!
Dialogue: 0,0:19:10.31,0:19:11.86,Default,,0,0,0,,‫أنت تُخجلني. توقّف عن المُمازحة!
Dialogue: 0,0:19:11.90,0:19:15.11,Default,,0,0,0,,‫حسنًا، هذا يجعلنا مُكتملين.
Dialogue: 0,0:19:15.32,0:19:17.49,Default,,0,0,0,,‫إذًا من هذا السيّد اليائس؟
Dialogue: 0,0:19:17.65,0:19:19.36,Default,,0,0,0,,‫صديقك الجديد.
Dialogue: 0,0:19:19.74,0:19:21.12,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:19:21.62,0:19:22.62,Default,,0,0,0,,‫إذًا...
Dialogue: 0,0:19:22.70,0:19:25.79,Default,,0,0,0,,‫سينضمّ مُبتدئ آخر إلى\N‫الشعبة الثانية، بدءًا من الآن.
Dialogue: 0,0:19:25.91,0:19:27.62,Default,,0,0,0,,‫هذا كيريهارا ريجي.
Dialogue: 0,0:19:27.71,0:19:30.00,Default,,0,0,0,,‫إنّه في السابعة عشرة مِثلكم جميعًا...
Dialogue: 0,0:19:30.21,0:19:31.34,Default,,0,0,0,,‫ومِثل إيتشيكا،
Dialogue: 0,0:19:31.54,0:19:34.38,Default,,0,0,0,,‫ينحدر من عائلة جواسيس\N‫مرموقة، عشيرة كيريهارا.
Dialogue: 0,0:19:34.80,0:19:36.88,Default,,0,0,0,,‫أنا مُتأكّد من أنّكم ستستمتعون\N‫بالتعرّف على بعضكم.
Dialogue: 0,0:19:37.67,0:19:38.88,Default,,0,0,0,,‫شقيّ مُتغطرس.
Dialogue: 0,0:19:39.18,0:19:41.35,Default,,0,0,0,,‫سأُنفّذ الأوامر،
Dialogue: 0,0:19:41.55,0:19:44.52,Default,,0,0,0,,‫لكنّني أُخبرك بأنّني لا أحتمل\N‫المزيد من مُثيري المتاعب.
Dialogue: 0,0:19:44.89,0:19:47.39,Default,,0,0,0,,‫مهلًا، ماذا تقصدين بـ "المزيد"؟
Dialogue: 0,0:19:47.85,0:19:50.15,Default,,0,0,0,,‫وأنتِ كيشيموجين إيتشيكا على ما أظنّ؟
Dialogue: 0,0:19:50.85,0:19:51.86,Default,,0,0,0,,‫حسنًا، نعم، أنا هي.
Dialogue: 0,0:19:52.44,0:19:55.65,Default,,0,0,0,,‫سُمعتكِ تسبقك.
Dialogue: 0,0:19:56.03,0:19:58.40,Default,,0,0,0,,‫سمعتُ عن امرأة شابة\N‫وطموحة وشُجاعة بما يكفي
Dialogue: 0,0:19:58.53,0:20:01.24,Default,,0,0,0,,‫لكسر التقاليد والسعي لتُصبح\N‫الزعيمة الجديدة لعائلتها.
Dialogue: 0,0:20:01.28,0:20:04.24,Default,,0,0,0,,‫أثار هذا فضولي حقًّا.
Dialogue: 0,0:20:04.74,0:20:08.25,Default,,0,0,0,,‫لم أتخيّل قطّ أنّها ستكون بهذا الجمال!
Dialogue: 0,0:20:08.50,0:20:09.54,Default,,0,0,0,,‫مـ-ماذا—؟
Dialogue: 0,0:20:10.12,0:20:13.34,Default,,0,0,0,,‫حسنًا، التقينا لتوّنا و—
Dialogue: 0,0:20:13.50,0:20:15.05,Default,,0,0,0,,‫استيقظي، إنّه يُحاول التملّق لك.
Dialogue: 0,0:20:15.67,0:20:18.17,Default,,0,0,0,,‫وذاك هناك لا بُدّ أنّه...
Dialogue: 0,0:20:19.13,0:20:20.05,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:20:20.22,0:20:22.97,Default,,0,0,0,,‫قرأتُ عنك...
Dialogue: 0,0:20:23.64,0:20:24.89,Default,,0,0,0,,‫فهمت الآن.
Dialogue: 0,0:20:25.18,0:20:27.31,Default,,0,0,0,,‫أنت أسوأ شخصيًّا.
Dialogue: 0,0:20:28.02,0:20:31.15,Default,,0,0,0,,‫لأكُن صادقًا، لا أزال غير مُصدّق قليلًا.
Dialogue: 0,0:20:31.77,0:20:35.07,Default,,0,0,0,,‫أنّ مُغفّلًا مِثلك شقّ طريقه إلى وحدتي.
Dialogue: 0,0:20:35.90,0:20:37.19,Default,,0,0,0,,‫ما رأيك أن تُغادر فحسب؟
Dialogue: 0,0:20:37.32,0:20:39.57,Default,,0,0,0,,‫عُد إلى زنزانتك في المُستشفى\N‫حيث يُمكِنك أن تكون آمنًا؟
Dialogue: 0,0:20:40.07,0:20:42.32,Default,,0,0,0,,‫أرى كيف تسير الأمور.
Dialogue: 0,0:20:43.53,0:20:46.41,Default,,0,0,0,,‫لِمَ لا تبُح بما في خاطرك حقًّا...
Dialogue: 0,0:20:46.83,0:20:48.08,Default,,0,0,0,,‫أيها اللعوب.
Dialogue: 0,0:20:48.37,0:20:49.50,Default,,0,0,0,,‫أعتذر.
Dialogue: 0,0:20:49.79,0:20:52.29,Default,,0,0,0,,‫الصدق هو الدواء الأفضل\N‫دائمًا، ألا تظنّ هذا؟
Dialogue: 0,0:20:53.00,0:20:55.84,Default,,0,0,0,,‫أتقول إنّك ترغب في القتال\N‫أيها الوغد ذو النظّارات؟
Dialogue: 0,0:20:56.13,0:20:57.92,Default,,0,0,0,,‫وماذا إن كنتُ كذلك؟
Dialogue: 0,0:20:58.26,0:20:59.42,Default,,0,0,0,,‫أيها الأبله نصف الوحش؟
Dialogue: 0,0:20:59.51,0:21:00.34,Default,,0,0,0,,‫نصف—
Dialogue: 0,0:21:00.38,0:21:04.22,Default,,0,0,0,,‫مهلًا، مهلًا! تماديتما كثيرًا!
Dialogue: 0,0:21:04.64,0:21:06.22,Default,,0,0,0,,‫هذا سيّئ أيها الرئيس!
Dialogue: 0,0:21:06.35,0:21:07.56,Default,,0,0,0,,‫علينا إيقافهما!
Dialogue: 0,0:21:07.64,0:21:09.14,Default,,0,0,0,,‫يا له من توقيت.
Dialogue: 0,0:21:09.35,0:21:10.23,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:21:10.31,0:21:12.73,Default,,0,0,0,,‫مهلًا أيّها الوغد ذو النظّارات،\N‫والأبله نصف الوحش...
Dialogue: 0,0:21:12.77,0:21:13.60,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:21:13.98,0:21:16.65,Default,,0,0,0,,‫بادرا وتقاتلا. الآن.
Dialogue: 0,0:21:17.36,0:21:19.40,Default,,0,0,0,,‫ولا تتساهلا أبدًا.
Dialogue: 0,0:21:20.99,0:21:24.41,Default,,0,0,0,,‫حسنًا... سجّلي... بدقّة عالية...
Dialogue: 0,0:21:24.57,0:21:26.20,Default,,0,0,0,,‫ما هذا، مُبارزة؟
Dialogue: 0,0:21:26.45,0:21:28.08,Default,,0,0,0,,‫نوعًا ما...
Dialogue: 0,0:21:28.49,0:21:31.12,Default,,0,0,0,,‫إنّه لتأسيس الفرقة بنجاح أيضًا.
Dialogue: 0,0:21:31.54,0:21:32.66,Default,,0,0,0,,‫ماذا تقصد؟
Dialogue: 0,0:21:32.79,0:21:34.63,Default,,0,0,0,,‫عندما اقترحتُ فكرتي للفرقة الجديدة،
Dialogue: 0,0:21:34.71,0:21:37.59,Default,,0,0,0,,‫فرض المسؤولون بعض المُتطلّبات.
Dialogue: 0,0:21:37.96,0:21:40.26,Default,,0,0,0,,‫أحدها كان إثبات ما إن كان أزوما جيرو
Dialogue: 0,0:21:40.38,0:21:42.63,Default,,0,0,0,,‫يُمثّل مكسبًا للمكتب.
Dialogue: 0,0:21:42.88,0:21:45.84,Default,,0,0,0,,‫يعرف المكتب نوع الاحتمالات
Dialogue: 0,0:21:45.89,0:21:48.01,Default,,0,0,0,,‫التي تحملها قوة راغو الكامنة سابقًا.
Dialogue: 0,0:21:48.72,0:21:49.85,Default,,0,0,0,,‫لكنّ هذا كُلّه بلا معنى
Dialogue: 0,0:21:49.93,0:21:52.39,Default,,0,0,0,,‫إن لم يستطع جيرو وراغو التعاون معنا.
Dialogue: 0,0:21:52.64,0:21:55.77,Default,,0,0,0,,‫إذًا أنت تختبر قُدراتهما كعُملاء؟
Dialogue: 0,0:21:56.73,0:21:59.15,Default,,0,0,0,,‫خضعتُ لشهرٍ من الاختبارات!
Dialogue: 0,0:21:59.65,0:22:01.53,Default,,0,0,0,,‫مهلًا، كُلّ موقفٍ مُختلف.
Dialogue: 0,0:22:02.03,0:22:04.86,Default,,0,0,0,,‫معرفة مدى قوة الفتى بداية جيّدة.
Dialogue: 0,0:22:05.11,0:22:06.62,Default,,0,0,0,,‫لا يبدو هذا...
Dialogue: 0,0:22:06.70,0:22:10.04,Default,,0,0,0,,‫حسنًا، ابتسما للكاميرا يا رفاق!
