Dialogue: 0,0:00:05.92,0:00:08.84,Default,,0,0,0,,‫أظنّ أنّه يجدر بي التعريف عن نفسي.
Dialogue: 0,0:00:09.18,0:00:10.89,Default,,0,0,0,,‫أنا كوغا.
Dialogue: 0,0:00:11.26,0:00:14.47,Default,,0,0,0,,‫الحاكم المستقبليّ للمونونوكي!
Dialogue: 0,0:00:14.56,0:00:15.39,Default,,0,0,0,,
Dialogue: 0,0:00:15.56,0:00:17.43,Default,,0,0,0,,‫الحاكم المستقبليّ... للمونونوكي؟
Dialogue: 0,0:00:17.60,0:00:19.73,Default,,0,0,0,,‫من هذا المعتوه؟
Dialogue: 0,0:00:20.02,0:00:23.02,Default,,0,0,0,,‫لكنّي أحتاج إلى جرعة طاقة إضافيّة أوّلًا.
Dialogue: 0,0:00:23.73,0:00:25.86,Default,,0,0,0,,‫ولهذا، يا راغو العزيز...
Dialogue: 0,0:00:26.57,0:00:28.36,Default,,0,0,0,,‫ستكون ملكي!
Dialogue: 0,0:00:29.99,0:00:32.91,Default,,0,0,0,,‫مهلًا، يبدو أنّه واقع في الحبّ!
Dialogue: 0,0:00:32.99,0:00:33.83,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:00:33.83,0:00:34.87,Default,,0,0,0,,‫ليس مضحكًا!
Dialogue: 0,0:00:34.91,0:00:37.50,Italics,,0,0,0,,‫من الغريب أنّي لا\N‫أشعر بأنّه يحاول خداعنا.
Dialogue: 0,0:00:38.20,0:00:41.00,Italics,,0,0,0,,‫هل يُعقل أنّه مجرّد أحمق آخر؟
Dialogue: 0,0:00:41.75,0:00:43.25,Italics,,0,0,0,,‫سيسهّل هذا الأمور حتمًا...
Dialogue: 0,0:00:43.75,0:00:44.59,Default,,0,0,0,,‫كوغا...
Dialogue: 0,0:00:44.63,0:00:46.00,Default,,0,0,0,,‫إن سمحت لي.
Dialogue: 0,0:00:46.05,0:00:47.09,Default,,0,0,0,,‫أجل؟
Dialogue: 0,0:00:47.17,0:00:49.38,Default,,0,0,0,,‫ومن أذن لك بالحديث؟
Dialogue: 0,0:00:49.80,0:00:51.72,Default,,0,0,0,,‫ما سرّ اهتمامك الشديد براغو؟
Dialogue: 0,0:00:52.22,0:00:54.89,Default,,0,0,0,,‫ماذا يملك لتسعى خلفه بهذا الجنون؟
Dialogue: 0,0:00:54.97,0:00:58.43,Default,,0,0,0,,‫ البشر أغبياء حقًّا كما يبدون.
Dialogue: 0,0:00:58.64,0:01:00.64,Default,,0,0,0,,‫هل أُضطرّ للشرح؟
Dialogue: 0,0:01:00.73,0:01:02.77,Default,,0,0,0,,‫هذا الرجل فريد من نوعه...
Dialogue: 0,0:01:03.31,0:01:04.77,Default,,0,0,0,,‫إنّه مذهل!
Dialogue: 0,0:01:05.44,0:01:08.82,Default,,0,0,0,,‫مذهل، إنّه متأخّر عقليًّا مثلك يا جيرو.
Dialogue: 0,0:01:08.90,0:01:10.15,Default,,0,0,0,,‫أنت وغد، أتعلم هذا!
Dialogue: 0,0:01:10.24,0:01:14.03,Default,,0,0,0,,‫في الواقع، لسنا كائنات\N‫هشّة مثلكم أيّها البشر.
Dialogue: 0,0:01:15.91,0:01:18.08,Default,,0,0,0,,‫بل نحن خالدون نوعًا ما!
Dialogue: 0,0:01:18.45,0:01:22.17,Default,,0,0,0,,‫نعم، سنموت إن قطّعتمونا إربًا.
Dialogue: 0,0:01:23.21,0:01:26.17,Default,,0,0,0,,‫وتخبو أرواحنا الطيفيّة بلا غذاء.
Dialogue: 0,0:01:26.42,0:01:28.09,Default,,0,0,0,,‫لكنّ راغو مختلف.
Dialogue: 0,0:01:28.30,0:01:30.47,Default,,0,0,0,,‫إنّه بمثابة مولّد طاقة روحيّة،
Dialogue: 0,0:01:30.51,0:01:32.01,Default,,0,0,0,,‫سواء أكل أم لم يأكل...
Dialogue: 0,0:01:32.09,0:01:33.55,Default,,0,0,0,,‫لذا وبكلّ بساطة...
Dialogue: 0,0:01:33.84,0:01:36.64,Default,,0,0,0,,‫طاقة كهذه ستجعلني الأقوى، خالدًا بحقّ!
Dialogue: 0,0:01:36.89,0:01:37.81,Default,,0,0,0,,‫وحينها...
Dialogue: 0,0:01:37.89,0:01:40.81,Default,,0,0,0,,‫لن يقف أحد في طريقي.
Dialogue: 0,0:01:40.98,0:01:43.94,Default,,0,0,0,,‫سأتربّع على عرش المونونوكي!
Dialogue: 0,0:01:44.65,0:01:45.48,Default,,0,0,0,,‫هذا الوغد سوف...
Dialogue: 0,0:01:45.52,0:01:46.40,Default,,0,0,0,,‫انتظر يا جيرو!
Dialogue: 0,0:01:46.44,0:01:48.32,Default,,0,0,0,,‫لا نعلم من يقف خلفه!
Dialogue: 0,0:01:51.90,0:01:53.74,Default,,0,0,0,,‫في الواقع، لا قيمة لك عندي.
Dialogue: 0,0:01:53.95,0:01:54.95,Default,,0,0,0,,‫مُت.
Dialogue: 0,0:01:55.66,0:01:56.53,Default,,0,0,0,,‫ريـ—
Dialogue: 0,0:01:58.41,0:02:00.04,Default,,0,0,0,,‫وأنت مزعج بالقدر ذاته!
Dialogue: 0,0:02:00.75,0:02:03.92,Default,,0,0,0,,‫لكنّك مجرّد وعاء لراغو،
Dialogue: 0,0:02:03.96,0:02:06.54,Default,,0,0,0,,‫سلّة مهملات عليها أن تخرس وتبقى مكانها!
Dialogue: 0,0:02:07.34,0:02:08.25,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:02:08.34,0:02:10.55,Default,,0,0,0,,‫ما خطبك يا راغو؟
Dialogue: 0,0:02:10.80,0:02:14.68,Default,,0,0,0,,‫يمكننا أخيرًا التحدّث بهدوء!
Dialogue: 0,0:02:15.18,0:02:17.55,Default,,0,0,0,,‫سنكون أنا وأنت يا راغو!
Dialogue: 0,0:02:17.80,0:02:21.81,Default,,0,0,0,,‫لا تقلق، سأحرّرك من\N‫هذا الأحمق في لمح البصر!
Dialogue: 0,0:02:21.89,0:02:24.23,Default,,0,0,0,,‫ثمّ سنغدو قوّة واحدة!
Dialogue: 0,0:02:24.44,0:02:27.52,Default,,0,0,0,,‫لن يُقهر أحدنا!
Dialogue: 0,0:02:28.15,0:02:29.57,Default,,0,0,0,,‫لن نُدمّر...
Dialogue: 0,0:02:29.65,0:02:31.82,Default,,0,0,0,,‫حاكم المونونوكي!
Dialogue: 0,0:02:31.86,0:02:33.19,Default,,0,0,0,,‫هذا مضحك.
Dialogue: 0,0:02:34.57,0:02:37.87,Default,,0,0,0,,‫لست ملكًا لأحد أيّها المعتوه.
Dialogue: 0,0:02:38.07,0:02:39.58,Default,,0,0,0,,‫حاكم المونونوكي؟
Dialogue: 0,0:02:39.78,0:02:42.54,Default,,0,0,0,,‫عذرًا، لا أبالي بهراء كهذا.
Dialogue: 0,0:02:42.83,0:02:46.04,Default,,0,0,0,,‫إن أردت بشدّة أن تصبح\N‫ملكًا، فلتصبح كذلك، لا يهمّني.
Dialogue: 0,0:02:49.38,0:02:51.50,Default,,0,0,0,,‫لِمَ يا راغو؟
Dialogue: 0,0:02:52.13,0:02:54.72,Default,,0,0,0,,‫كيف تقول هذا؟!
Dialogue: 0,0:02:54.76,0:02:56.30,Default,,0,0,0,,‫لِمَ لا تفهم؟!
Dialogue: 0,0:02:56.97,0:02:59.43,Default,,0,0,0,,‫أحاول تحريرك من—
Dialogue: 0,0:03:00.89,0:03:03.31,Default,,0,0,0,,‫يا لك من مزعج.
Dialogue: 0,0:03:03.73,0:03:07.56,Default,,0,0,0,,‫لا تكفّ عن التذمّر والشكوى.
Dialogue: 0,0:03:07.85,0:03:09.19,Default,,0,0,0,,‫أيّها الـ...
Dialogue: 0,0:03:09.27,0:03:10.11,Default,,0,0,0,,‫الآن!
Dialogue: 0,0:03:10.15,0:03:11.11,Default,,0,0,0,,‫افعلها يا ريجي!
Dialogue: 0,0:03:11.52,0:03:13.61,Default,,0,0,0,,‫لنخفّض أصواتنا الآن.
Dialogue: 0,0:03:13.94,0:03:15.36,Default,,0,0,0,,‫أسبقك بعشر خطوات!
Dialogue: 0,0:03:15.78,0:03:17.41,Default,,0,0,0,,‫استعدّ لأسلوب كيريهارا...
Dialogue: 0,0:03:19.57,0:03:20.62,Default,,0,0,0,,‫كاراجيكي!
Dialogue: 0,0:03:23.70,0:03:24.62,Default,,0,0,0,,‫مؤلم.
Dialogue: 0,0:03:24.66,0:03:25.79,Default,,0,0,0,,‫هل أنت بخير يا جيرو؟
Dialogue: 0,0:03:25.96,0:03:27.17,Default,,0,0,0,,‫نوعًا ما، على ما أظنّ.
Dialogue: 0,0:03:27.42,0:03:28.92,Default,,0,0,0,,‫لكن صدقًا، كان هذا مذهلًا.
Dialogue: 0,0:03:28.96,0:03:30.29,Default,,0,0,0,,‫ما الذي كان ذلك؟
Dialogue: 0,0:03:30.38,0:03:32.17,Default,,0,0,0,,‫نوع من القطع المتفجّر.
Dialogue: 0,0:03:32.59,0:03:33.46,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:03:33.96,0:03:36.26,Default,,0,0,0,,‫كان يُفترض أن يشطرَه نصفين!
Dialogue: 0,0:03:36.80,0:03:38.55,Default,,0,0,0,,‫إنّه خصم عنيد.
Dialogue: 0,0:03:39.09,0:03:41.80,Default,,0,0,0,,‫عاجلًا أم آجلًا، سيدرك الجميع\N‫في الخارج أنّنا في ورطة.
Dialogue: 0,0:03:42.43,0:03:44.52,Default,,0,0,0,,‫لكنّنا لا نملك رفاهيّة الانتظار.
Dialogue: 0,0:03:45.27,0:03:47.31,Default,,0,0,0,,‫أعتمد عليكما يا جيرو وراغو!
Dialogue: 0,0:03:47.73,0:03:49.19,Default,,0,0,0,,
Dialogue: 0,0:03:49.27,0:03:50.44,Default,,0,0,0,,‫اخرسوا جميعًا!
Dialogue: 0,0:03:50.90,0:03:54.07,Default,,0,0,0,,‫اخرسوا، اخرسوا، اخرسوا، اخرسوا، اخرسوا!
Dialogue: 0,0:03:54.40,0:03:56.28,Default,,0,0,0,,‫تبًّا، اخرسوا!
Dialogue: 0,0:03:56.40,0:03:58.95,Default,,0,0,0,,‫لهذا أمقتكم أيّها البشر.
Dialogue: 0,0:03:59.41,0:04:02.70,Default,,0,0,0,,‫أنتم حفنة من الضعفاء،\N‫لكنّكم تظنّون أنفسكم أقوياء
Dialogue: 0,0:04:02.78,0:04:05.66,Default,,0,0,0,,‫لأنّكم تفوقوننا عددًا.
Dialogue: 0,0:04:05.91,0:04:10.79,Default,,0,0,0,,‫تظنّون أنّكم تملكون هذا الكوكب العفن.
Dialogue: 0,0:04:11.54,0:04:13.00,Default,,0,0,0,,‫حسنًا، طفح الكيل.
Dialogue: 0,0:04:13.09,0:04:15.59,Default,,0,0,0,,‫انتهى وقت اللعب.
Dialogue: 0,0:04:15.96,0:04:17.47,Default,,0,0,0,,‫سأبدأ بك!
Dialogue: 0,0:04:17.55,0:04:19.72,Default,,0,0,0,,‫ستموت أوّلًا.
Dialogue: 0,0:04:19.84,0:04:22.10,Default,,0,0,0,,‫وأنت، سأبقيك حيًّا!
Dialogue: 0,0:04:22.26,0:04:24.26,Default,,0,0,0,,‫سأفصلك عن تلك الأطراف المزعجة
Dialogue: 0,0:04:24.31,0:04:26.35,Default,,0,0,0,,‫لتصبح حقيبتي العمليّة لحمل راغو.
Dialogue: 0,0:04:26.52,0:04:29.94,Default,,0,0,0,,‫لكن أوّلًا، سأجعلك تفهم.
Dialogue: 0,0:04:30.14,0:04:33.36,Default,,0,0,0,,‫من السيّد، ومن الخادم...
Dialogue: 0,0:04:34.27,0:04:36.86,Default,,0,0,0,,‫ستفهم أخيرًا...
Dialogue: 0,0:04:39.32,0:04:41.86,Default,,0,0,0,,‫أنّ المونونوكي هم الأسياد!
Dialogue: 0,0:06:16.58,0:06:18.21,Default,,0,0,0,,‫أفصح عمّا لديك يا توكيدا.
Dialogue: 0,0:06:18.38,0:06:22.22,Default,,0,0,0,,‫ليس الأرقى ممّا رأيت، لكنّه متين رغم ذلك.
Dialogue: 0,0:06:22.30,0:06:24.76,Default,,0,0,0,,‫سيستغرق الأمر بعض الوقت، لكن...
Dialogue: 0,0:06:25.18,0:06:26.47,Default,,0,0,0,,‫عـ-عُذرًا...
Dialogue: 0,0:06:26.84,0:06:28.35,Default,,0,0,0,,‫نعم يا عزيزتي؟
Dialogue: 0,0:06:29.43,0:06:30.47,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:06:30.77,0:06:33.60,Default,,0,0,0,,‫لا بدّ من وجود طريقة للمساعدة!
Dialogue: 0,0:06:34.06,0:06:36.73,Default,,0,0,0,,‫أخشى أن يكون كلاهما...
Dialogue: 0,0:06:36.98,0:06:38.82,Default,,0,0,0,,‫في هذه الحالة، قد يكون\N‫الوقوف مكتوفي الأيدي...
Dialogue: 0,0:06:39.69,0:06:40.94,Default,,0,0,0,,‫لا تقولي المزيد.
Dialogue: 0,0:06:41.11,0:06:41.94,Default,,0,0,0,,‫الآن...
Dialogue: 0,0:06:41.98,0:06:45.41,Default,,0,0,0,,‫هلّا تغرسين هذا الوتد\N‫وفقًا لتعليماتي الدقيقة.
Dialogue: 0,0:06:45.57,0:06:46.41,Default,,0,0,0,,
Dialogue: 0,0:06:46.45,0:06:47.37,Default,,0,0,0,,‫نعم!
Dialogue: 0,0:06:47.91,0:06:50.45,Default,,0,0,0,,‫يسرّني أنّك أحضرت توكيدا معك.
Dialogue: 0,0:06:51.24,0:06:52.33,Default,,0,0,0,,‫أمهله خمس دقائق،
Dialogue: 0,0:06:52.37,0:06:54.79,Default,,0,0,0,,‫وسيبدو وكأنّ ذلك الحاجز لم يكن—
Dialogue: 0,0:06:56.17,0:06:57.54,Default,,0,0,0,,‫شيبا يا صديقي...
Dialogue: 0,0:06:57.92,0:06:59.96,Default,,0,0,0,,‫لا تستخدمنا كدعم احتياطيّ، أليس كذلك؟
Dialogue: 0,0:07:00.29,0:07:03.09,Default,,0,0,0,,‫يخبرني حدسي أنّك ظهرت فقط لأنّك علمت
Dialogue: 0,0:07:03.30,0:07:05.55,Default,,0,0,0,,‫أنّي سأكون هنا أيضًا.
Dialogue: 0,0:07:05.80,0:07:08.64,Default,,0,0,0,,‫إنّها المهمّة الأولى للمبتدئين.
Dialogue: 0,0:07:09.10,0:07:11.06,Default,,0,0,0,,‫أيّ قائد سأكون
Dialogue: 0,0:07:11.18,0:07:13.06,Default,,0,0,0,,‫إن لم أستعدّ لتدهور الأمور؟
Dialogue: 0,0:07:13.22,0:07:15.73,Default,,0,0,0,,‫بالنسبة لقائد يعلم أنّ\N‫"مبتدئيه" في مأزق حرج،
Dialogue: 0,0:07:15.77,0:07:17.73,Default,,0,0,0,,‫تبدو هادئًا للغاية.
Dialogue: 0,0:07:18.02,0:07:19.61,Default,,0,0,0,,‫أملك الثقة...
Dialogue: 0,0:07:20.11,0:07:22.57,Default,,0,0,0,,‫بهم وبك.
Dialogue: 0,0:07:22.82,0:07:24.28,Default,,0,0,0,,‫لا بدّ أن تكون لك الكلمة الأخيرة دائمًا.
Dialogue: 0,0:07:24.36,0:07:25.95,Default,,0,0,0,,‫أقول الحقيقة.
Dialogue: 0,0:07:26.03,0:07:27.53,Default,,0,0,0,,‫اعلم فقط...
Dialogue: 0,0:07:27.61,0:07:29.57,Default,,0,0,0,,‫أنّك ستتحمّل المسؤوليّة كاملة.
Dialogue: 0,0:07:29.87,0:07:31.08,Default,,0,0,0,,‫بالطبع.
Dialogue: 0,0:07:31.33,0:07:34.20,Default,,0,0,0,,‫وسأتحمّلها بكلّ سرور.
Dialogue: 0,0:08:09.57,0:08:10.95,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:08:11.32,0:08:12.95,Default,,0,0,0,,‫ما هذا الذي يحدث؟!
Dialogue: 0,0:08:13.33,0:08:14.87,Default,,0,0,0,,‫أهذا كلّ ما تملكه؟!
Dialogue: 0,0:08:15.75,0:08:17.83,Default,,0,0,0,,‫تملك كلّ طاقة راغو تلك...
Dialogue: 0,0:08:18.12,0:08:19.79,Default,,0,0,0,,‫وهذا كلّ شيء؟!
Dialogue: 0,0:08:20.88,0:08:22.17,Default,,0,0,0,,‫جيرو!
Dialogue: 0,0:08:23.67,0:08:25.00,Default,,0,0,0,,‫هذا محزن...
Dialogue: 0,0:08:25.42,0:08:27.80,Default,,0,0,0,,‫أشفق عليك حقًّا يا راغو!
Dialogue: 0,0:08:28.17,0:08:30.01,Default,,0,0,0,,‫يا له من هدر للطاقة...
Dialogue: 0,0:08:30.09,0:08:33.30,Default,,0,0,0,,‫كلّ هذا لأنّك عالق داخل\N‫كيس اللحم البشريّ هذا!
Dialogue: 0,0:08:33.60,0:08:34.93,Default,,0,0,0,,‫انتظر فقط...
Dialogue: 0,0:08:35.06,0:08:37.31,Default,,0,0,0,,‫سأنتزعك من هناك قريبًا بمـ—
Dialogue: 0,0:08:37.35,0:08:38.43,Default,,0,0,0,,‫اخرس!
Dialogue: 0,0:08:38.60,0:08:40.81,Default,,0,0,0,,‫أنت مختلّ ومجنون!
Dialogue: 0,0:08:41.69,0:08:44.27,Default,,0,0,0,,‫تريد استغلاله، وتريد رميي جانبًا...
Dialogue: 0,0:08:44.48,0:08:46.03,Default,,0,0,0,,‫أنا حقيبتك، وسلّة مهملاتك...
Dialogue: 0,0:08:46.40,0:08:48.53,Default,,0,0,0,,‫لسنا أدوات لتستغلّها.
Dialogue: 0,0:08:49.28,0:08:50.91,Default,,0,0,0,,‫لسنا ممتلكاتك!
Dialogue: 0,0:08:51.99,0:08:53.12,Default,,0,0,0,,‫البشر كذا...
Dialogue: 0,0:08:53.16,0:08:54.41,Default,,0,0,0,,‫المونونوكي كذا...
Dialogue: 0,0:08:54.83,0:08:55.83,Default,,0,0,0,,‫من يكترث لهذا؟
Dialogue: 0,0:08:56.91,0:09:00.33,Default,,0,0,0,,‫لا نحتاج إلى تصنيفاتك الغبيّة!
Dialogue: 0,0:09:01.08,0:09:03.46,Default,,0,0,0,,‫نحن من يقرّر هويّتنا أيّها الوغد!
Dialogue: 0,0:09:04.04,0:09:05.84,Default,,0,0,0,,‫أليس كذلك يا راغو؟
Dialogue: 0,0:09:06.67,0:09:07.59,Default,,0,0,0,,‫بئسًا!
Dialogue: 0,0:09:07.67,0:09:11.34,Default,,0,0,0,,‫لست ممّن يكفّون عن\N‫الثرثرة بأمور يجهلونها.
Dialogue: 0,0:09:11.80,0:09:13.05,Default,,0,0,0,,‫ومع ذلك، عليّ الاعتراف...
Dialogue: 0,0:09:13.14,0:09:16.35,Default,,0,0,0,,‫أصبت كبد الحقيقة هذه المرّة.
Dialogue: 0,0:09:17.06,0:09:20.35,Default,,0,0,0,,‫وهذا الحثالة يثير غضبي أكثر منك!
Dialogue: 0,0:09:20.43,0:09:22.73,Default,,0,0,0,,‫ضربة واحدة قاضية...
Dialogue: 0,0:09:24.77,0:09:26.57,Default,,0,0,0,,‫هذا كلّ ما سيتطلّبه الأمر!
Dialogue: 0,0:09:35.78,0:09:36.99,Italics,,0,0,0,,‫مذهل.
Dialogue: 0,0:09:37.91,0:09:40.08,Italics,,0,0,0,,‫طاقتهما مندمجة...
Dialogue: 0,0:09:45.13,0:09:47.75,Default,,0,0,0,,‫ما رأيك بهذا أيّها المتبجّح؟
Dialogue: 0,0:09:51.17,0:09:52.01,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:52.55,0:09:54.01,Default,,0,0,0,,‫أجل!
Dialogue: 0,0:09:54.05,0:09:55.72,Default,,0,0,0,,‫هذه هي، هذه هي!
Dialogue: 0,0:09:55.80,0:09:58.76,Default,,0,0,0,,‫هذا ما أتحدّث عنه!
Dialogue: 0,0:09:59.02,0:10:00.39,Default,,0,0,0,,‫يا له من فتى!
Dialogue: 0,0:10:00.52,0:10:01.77,Default,,0,0,0,,‫ينبغي أن أحصل عليه!
Dialogue: 0,0:10:01.98,0:10:03.89,Default,,0,0,0,,‫أرجوك، سلّمه إليّ فحسب!
Dialogue: 0,0:10:04.19,0:10:06.52,Default,,0,0,0,,‫أعطني راغو!
Dialogue: 0,0:10:08.52,0:10:09.61,Default,,0,0,0,,‫ما هذا؟
Dialogue: 0,0:10:10.57,0:10:12.11,Italics,,0,0,0,,‫اخترقوا الحاجز...
Dialogue: 0,0:10:12.78,0:10:15.11,Italics,,0,0,0,,‫لا مجال لمواجهة التعزيزات هنا.
Dialogue: 0,0:10:16.70,0:10:17.62,Default,,0,0,0,,‫سأنسحب!
Dialogue: 0,0:10:18.03,0:10:19.87,Default,,0,0,0,,‫ماذا؟ أتهرب الآن؟
Dialogue: 0,0:10:19.95,0:10:22.12,Default,,0,0,0,,‫لست أهرب، أنا عائد إلى دياري!
Dialogue: 0,0:10:22.16,0:10:23.12,Default,,0,0,0,,‫لا فرق!
Dialogue: 0,0:10:23.21,0:10:24.42,Default,,0,0,0,,‫انتبه لنفسك يا فتى!
Dialogue: 0,0:10:24.46,0:10:27.13,Default,,0,0,0,,‫يمكنني القضاء عليك متى شئت!
Dialogue: 0,0:10:27.38,0:10:29.71,Default,,0,0,0,,‫لكن إن قتلتك هنا الآن،
Dialogue: 0,0:10:29.75,0:10:32.38,Default,,0,0,0,,‫فلن أحصل على راغو.
Dialogue: 0,0:10:32.47,0:10:34.13,Default,,0,0,0,,‫ولن أسمح بحدوث ذلك.
Dialogue: 0,0:10:34.47,0:10:36.43,Default,,0,0,0,,‫لذا سأدعك تعيش لفترة أطول قليلًا.
Dialogue: 0,0:10:36.55,0:10:37.51,Default,,0,0,0,,‫لكن في المرّة القادمة،
Dialogue: 0,0:10:37.55,0:10:39.26,Default,,0,0,0,,‫تلك الأطراف، وذلك\N‫اللسان، وتلك العينان الغبيّتان
Dialogue: 0,0:10:39.31,0:10:40.77,Default,,0,0,0,,‫ستعود معي إلى الديار كهدايا تذكاريّة!
Dialogue: 0,0:10:41.22,0:10:43.48,Default,,0,0,0,,‫أُقسم لك، سيكون راغو ملكي.
Dialogue: 0,0:10:43.85,0:10:45.69,Default,,0,0,0,,‫انتظر فقط...
Dialogue: 0,0:10:47.73,0:10:48.90,Default,,0,0,0,,‫مهلًا، ما اسمك؟
Dialogue: 0,0:10:48.98,0:10:50.94,Default,,0,0,0,,‫ما هذا؟ أتريد المعرفة الآن؟
Dialogue: 0,0:10:51.32,0:10:52.23,Default,,0,0,0,,‫جيرو.
Dialogue: 0,0:10:52.57,0:10:53.74,Default,,0,0,0,,‫أزوما جيرو!
Dialogue: 0,0:10:53.99,0:10:55.57,Default,,0,0,0,,‫تذكّره أيّها الفاشل!
Dialogue: 0,0:10:55.99,0:10:57.24,Default,,0,0,0,,‫أزوما؟
Dialogue: 0,0:10:58.32,0:10:59.20,Default,,0,0,0,,‫هكذا إذًا!
Dialogue: 0,0:10:59.37,0:11:00.33,Default,,0,0,0,,‫أزوما...
Dialogue: 0,0:11:00.58,0:11:02.58,Default,,0,0,0,,‫كعائلة أزوما للجواسيس!
Dialogue: 0,0:11:04.12,0:11:05.46,Default,,0,0,0,,‫-ما المضحك؟\N‫-لا عجب في ذلك.
Dialogue: 0,0:11:06.12,0:11:08.96,Default,,0,0,0,,‫أنت ابن "ذلك" الرجل.
Dialogue: 0,0:11:09.29,0:11:10.17,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:11:10.21,0:11:12.09,Default,,0,0,0,,‫لا يُهمّ، لا شأن لي بهذا.
Dialogue: 0,0:11:12.38,0:11:13.42,Default,,0,0,0,,‫وداعًا الآن...
Dialogue: 0,0:11:13.46,0:11:15.09,Default,,0,0,0,,‫أزوما جيرو.
Dialogue: 0,0:11:15.22,0:11:16.59,Default,,0,0,0,,‫مهلًا...!
Dialogue: 0,0:11:19.80,0:11:21.26,Default,,0,0,0,,‫جيرو! ريجي!
Dialogue: 0,0:11:24.60,0:11:27.77,Default,,0,0,0,,‫حسنًا، المقرّ بانتظارنا...
Dialogue: 0,0:11:28.02,0:11:28.85,Default,,0,0,0,,‫عُلم.
Dialogue: 0,0:11:29.73,0:11:31.82,Default,,0,0,0,,‫سنتولّى الأمر من هنا.
Dialogue: 0,0:11:32.15,0:11:34.86,Default,,0,0,0,,‫إصابة عميلين، وفي مهمّة غير مصرّح بها.
Dialogue: 0,0:11:34.94,0:11:36.86,Default,,0,0,0,,‫وتضرّر إحدى المنشآت.
Dialogue: 0,0:11:37.45,0:11:39.62,Default,,0,0,0,,‫كما قلت، ستكون هناك عواقب لـ—
Dialogue: 0,0:11:39.66,0:11:40.87,Default,,0,0,0,,‫بلا شكّ.
Dialogue: 0,0:11:40.95,0:11:44.87,Default,,0,0,0,,‫سأتقبّل أيّ عقاب تفرضونه، لكن...
Dialogue: 0,0:11:45.20,0:11:48.00,Default,,0,0,0,,‫ألا تظنّون أنّ هذين الاثنين\N‫يستحقّان بعض الثناء؟
Dialogue: 0,0:11:48.29,0:11:49.25,Default,,0,0,0,,‫عفوًا؟
Dialogue: 0,0:11:49.46,0:11:52.09,Default,,0,0,0,,‫صمد هذان المبتدئان ببراعة،
Dialogue: 0,0:11:52.21,0:11:54.76,Default,,0,0,0,,‫وفي مواجهة مونونوكي بالغ القوّة.
Dialogue: 0,0:11:55.30,0:11:56.84,Default,,0,0,0,,‫وما المغزى من كلامك؟
Dialogue: 0,0:11:57.43,0:11:59.18,Default,,0,0,0,,‫فعلا ما كان متوقّعًا منهما فحسب.
Dialogue: 0,0:11:59.43,0:12:00.30,Default,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:12:00.34,0:12:02.51,Default,,0,0,0,,‫لا بدّ أن تكون الناقد دائمًا.
Dialogue: 0,0:12:05.22,0:12:08.64,Italics,,0,0,0,,‫حسنًا، نالا درجة النجاح بالنسبة لي.
Dialogue: 0,0:12:09.69,0:12:11.56,Default,,0,0,0,,‫ريجي، كيف حالك؟
Dialogue: 0,0:12:11.77,0:12:14.53,Default,,0,0,0,,‫ماذا؟ سأكون بخير.
Dialogue: 0,0:12:14.86,0:12:17.36,Default,,0,0,0,,‫لكن لولا هذا الزيّ، لربّما كنت...
Dialogue: 0,0:12:17.53,0:12:20.03,Default,,0,0,0,,‫كفاك، هذه مجرّد تهيّؤات!
Dialogue: 0,0:12:20.28,0:12:21.12,Italics,,0,0,0,,‫لا...
Dialogue: 0,0:12:21.16,0:12:23.03,Italics,,0,0,0,,‫أنا لا أتخيّل.
Dialogue: 0,0:12:23.70,0:12:25.66,Italics,,0,0,0,,‫كنت عاجزًا تمامًا.
Dialogue: 0,0:12:26.91,0:12:28.12,Italics,,0,0,0,,‫كنت ساذجًا!
Dialogue: 0,0:12:28.62,0:12:30.33,Italics,,0,0,0,,‫ينبغي أن أُصبح أقوى!
Dialogue: 0,0:12:31.54,0:12:33.71,Italics,,0,0,0,,‫لم أقدّم أيّ مساعدة تُذكر.
Dialogue: 0,0:12:34.17,0:12:37.17,Italics,,0,0,0,,‫لو كنت قويّةً بما يكفي لكسر ذلك الحاجز...
Dialogue: 0,0:12:38.01,0:12:40.47,Italics,,0,0,0,,‫أعلم أنّه لا طائل من\N‫التفكير في هذا الآن.
Dialogue: 0,0:12:41.09,0:12:42.18,Italics,,0,0,0,,‫ومع ذلك...
Dialogue: 0,0:12:42.47,0:12:44.10,Italics,,0,0,0,,‫تبًّا، هذا مريع.
Dialogue: 0,0:12:44.35,0:12:46.89,Flashback,,0,0,0,,‫أنت ابن "ذلك" الرجل.
Dialogue: 0,0:12:47.27,0:12:48.73,Italics,,0,0,0,,‫ما الذي قصده بـ"ذلك" الرجل؟
Dialogue: 0,0:12:49.35,0:12:50.85,Italics,,0,0,0,,‫والدي؟
Dialogue: 0,0:12:51.44,0:12:53.36,Italics,,0,0,0,,‫كان جدّي هو الأب الوحيد الذي عرفته.
Dialogue: 0,0:12:53.44,0:12:54.36,Italics,,0,0,0,,‫وناتشي والدتي.
Dialogue: 0,0:12:55.02,0:12:56.61,Italics,,0,0,0,,‫إنّهما عائلتي.
Dialogue: 0,0:12:57.53,0:12:59.36,Italics,,0,0,0,,‫لطالما كان الأمر كذلك.
Dialogue: 0,0:13:00.07,0:13:01.07,Italics,,0,0,0,,‫لكن...
Dialogue: 0,0:13:01.32,0:13:03.03,Italics,,0,0,0,,‫لِمَ الآن...؟
Dialogue: 0,0:13:04.07,0:13:06.37,Default,,0,0,0,,‫تبًا! لِمَ ينبغي أن تكون\N‫الأمور بهذه الصعوبة؟!
Dialogue: 0,0:13:07.08,0:13:09.00,Default,,0,0,0,,‫لا أفهم، ولا أهتمّ!
Dialogue: 0,0:13:09.12,0:13:10.62,Default,,0,0,0,,‫سأمضي قدمًا!
Dialogue: 0,0:13:10.79,0:13:12.04,Default,,0,0,0,,‫تمضي في ماذا؟
Dialogue: 0,0:13:12.08,0:13:13.42,Default,,0,0,0,,‫في أن أُصبح عميلًا!
Dialogue: 0,0:13:13.46,0:13:14.29,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:13:14.34,0:13:16.50,Default,,0,0,0,,‫الانضمام إلى فريق الشعلة\N‫السوداء، أو أيًّا كان اسمه!
Dialogue: 0,0:13:17.00,0:13:18.46,Default,,0,0,0,,‫عمّا تتحدّث؟
Dialogue: 0,0:13:18.55,0:13:20.01,Default,,0,0,0,,‫ألم يُحسم هذا الأمر مسبقًا؟
Dialogue: 0,0:13:20.09,0:13:21.01,Default,,0,0,0,,‫اخرس!
Dialogue: 0,0:13:21.05,0:13:23.05,Default,,0,0,0,,‫أنا أتحدّث عن المشاعر هنا، المشاعر!
Dialogue: 0,0:13:23.72,0:13:24.60,Default,,0,0,0,,‫صحيح.
Dialogue: 0,0:13:24.76,0:13:26.76,Default,,0,0,0,,‫الشعور بالانتماء إلى الفريق أمر مهمّ.
Dialogue: 0,0:13:27.22,0:13:30.02,Default,,0,0,0,,‫كلاكما أصبح جزءًا من\N‫الفريق لحظة انضمامكما.
Dialogue: 0,0:13:30.27,0:13:32.52,Default,,0,0,0,,‫وسيتعيّن عليكم جميعًا العمل معًا،
Dialogue: 0,0:13:32.65,0:13:35.27,Default,,0,0,0,,‫كفريق متّحد، نحو هدف واحد.
Dialogue: 0,0:13:35.65,0:13:36.52,Default,,0,0,0,,‫لكن...
Dialogue: 0,0:13:36.61,0:13:38.53,Default,,0,0,0,,‫كلّ فرد منكم مختلف عن الآخر،
Dialogue: 0,0:13:38.57,0:13:39.78,Default,,0,0,0,,‫وهذا أمر جيّد.
Dialogue: 0,0:13:40.32,0:13:43.32,Default,,0,0,0,,‫تملكون أفكاركم ومشاعركم الخاصّة.
Dialogue: 0,0:13:43.61,0:13:45.78,Default,,0,0,0,,‫تقبّلوا ذلك.
Dialogue: 0,0:13:46.16,0:13:50.79,Default,,0,0,0,,‫اجعلوه أساسكم. اجعلوه مصدر قوّتكم.
Dialogue: 0,0:13:51.21,0:13:52.92,Default,,0,0,0,,‫واعلموا أنّي سأكون سندًا لكم.
Dialogue: 0,0:13:53.50,0:13:55.17,Default,,0,0,0,,‫ستراودكم الشكوك، وستشعرون بالضياع،
Dialogue: 0,0:13:55.21,0:13:56.79,Default,,0,0,0,,‫لكن استمرّوا في التطلّع إلى الأمام.
Dialogue: 0,0:13:57.21,0:14:01.38,Default,,0,0,0,,‫فكلّ هذا جزء من النضوج.
Dialogue: 0,0:14:09.18,0:14:10.06,Default,,0,0,0,,‫عُذرًا...
Dialogue: 0,0:14:10.31,0:14:13.85,Default,,0,0,0,,‫كما توقّعت، كان لدى\N‫الرؤساء الكثير ليقولوه.
Dialogue: 0,0:14:14.14,0:14:15.31,Default,,0,0,0,,‫لكنّ اليوم يوم جديد.
Dialogue: 0,0:14:15.48,0:14:17.94,Default,,0,0,0,,‫اليوم نبدأ مهمّة جديدة.
Dialogue: 0,0:14:18.40,0:14:20.07,Default,,0,0,0,,‫هذا كلّه جيّد ورائع، لكن...
Dialogue: 0,0:14:20.40,0:14:21.53,Default,,0,0,0,,‫أهذا هو المكان؟
Dialogue: 0,0:14:21.74,0:14:23.32,Default,,0,0,0,,‫أجل، هذا هو المكان.
Dialogue: 0,0:14:24.07,0:14:26.41,Default,,0,0,0,,‫اليوم، سنقوم بتهيئة تقليديّة...
Dialogue: 0,0:14:26.53,0:14:28.20,Default,,0,0,0,,‫أعني تدريبًا.
Dialogue: 0,0:14:28.78,0:14:30.83,Default,,0,0,0,,‫ولهذا، أحضرت ضيفًا مميّزًا جـ—
Dialogue: 0,0:14:34.08,0:14:36.58,Default,,0,0,0,,‫دفعة جديدة من المبتدئين السذّج!
Dialogue: 0,0:14:45.97,0:14:47.72,Default,,0,0,0,,‫أ-أعتذر على التأخير!
Dialogue: 0,0:14:47.93,0:14:49.31,Default,,0,0,0,,‫من هذه؟
Dialogue: 0,0:14:50.14,0:14:52.89,Default,,0,0,0,,‫حسنًا، هذه فويو.
Dialogue: 0,0:14:53.43,0:14:55.39,Default,,0,0,0,,‫وكما خمّنتم على الأرجح،
Dialogue: 0,0:14:55.60,0:14:56.77,Default,,0,0,0,,‫إنّها مونونوكي.
Dialogue: 0,0:14:58.15,0:15:00.36,Default,,0,0,0,,‫الآن، إن كنتم تذكرون، ذكرت أنّ المكتب
Dialogue: 0,0:15:00.40,0:15:03.03,Default,,0,0,0,,‫يراقب المونونوكي ويقضي عليهم.
Dialogue: 0,0:15:03.32,0:15:05.57,Default,,0,0,0,,‫أمّا بالنسبة للأنواع الودودة،
Dialogue: 0,0:15:05.86,0:15:08.28,Default,,0,0,0,,‫فنتّبع معها نهجًا تعاونيًّا.
Dialogue: 0,0:15:08.74,0:15:10.03,Italics,,0,0,0,,‫يا إلهي...
Dialogue: 0,0:15:10.12,0:15:12.37,Italics,,0,0,0,,‫يحاول أن يبدو جادًّا.
Dialogue: 0,0:15:12.58,0:15:14.37,Italics,,0,0,0,,‫لكن انظروا إلى ذلك الوجه.
Dialogue: 0,0:15:15.62,0:15:16.58,Default,,0,0,0,,‫دعوني أُوضّح أمرًا!
Dialogue: 0,0:15:16.96,0:15:19.71,Default,,0,0,0,,‫أنا لا أنحني للبشر.
Dialogue: 0,0:15:19.88,0:15:22.42,Default,,0,0,0,,‫ووضعيّة فخذيّ ينبغي أن توضّح ذلك.
Dialogue: 0,0:15:22.71,0:15:23.96,Default,,0,0,0,,‫أرى ذلك.
Dialogue: 0,0:15:24.67,0:15:25.63,Default,,0,0,0,,
Dialogue: 0,0:15:25.80,0:15:27.59,Default,,0,0,0,,‫أنت راغو إذًا.
Dialogue: 0,0:15:27.64,0:15:28.47,Default,,0,0,0,,‫ماذا؟
Dialogue: 0,0:15:28.55,0:15:32.14,Default,,0,0,0,,‫أنت ظريف ومحبّب نوعًا ما.
Dialogue: 0,0:15:32.51,0:15:35.77,Default,,0,0,0,,‫ لشعرت بالإهانة لولا\N‫أنّكِ جنيّة ضئيلة الحجم!
Dialogue: 0,0:15:36.73,0:15:38.98,Default,,0,0,0,,‫هيّا، قُل هذا مجدّدًا أيّها المتشرّد القذر!
Dialogue: 0,0:15:39.02,0:15:41.02,Default,,0,0,0,,‫ماذا؟ أتريدين القتال أيّتها القزمة؟
Dialogue: 0,0:15:41.52,0:15:44.03,Default,,0,0,0,,‫هل نبدأ وحسب؟
Dialogue: 0,0:15:44.57,0:15:47.03,Default,,0,0,0,,‫حسنًا، الجميع في أماكنهم.
Dialogue: 0,0:15:47.24,0:15:50.87,Default,,0,0,0,,‫اليوم هو تدريبنا على قمع القوى الخارقة.
Dialogue: 0,0:15:51.20,0:15:52.53,Default,,0,0,0,,‫قوى ماذا؟
Dialogue: 0,0:15:52.62,0:15:55.70,Default,,0,0,0,,‫صدّقوا أو لا تصدّقوا، بعض\N‫المونونوكي قادرون على
Dialogue: 0,0:15:55.75,0:15:58.04,Default,,0,0,0,,‫إحداث التنويم المغناطيسيّ والهلوسة.
Dialogue: 0,0:15:58.37,0:16:00.21,Default,,0,0,0,,‫من الآمن التدرّب في بيئة خاضعة للسيطرة
Dialogue: 0,0:16:00.25,0:16:02.54,Default,,0,0,0,,‫قبل مواجهة الخطر الحقيقيّ في الخارج.
Dialogue: 0,0:16:02.80,0:16:05.92,Default,,0,0,0,,‫ولهذا أحضرناها إلى هنا للمساعدة.
Dialogue: 0,0:16:06.84,0:16:09.05,Default,,0,0,0,,‫أظهروا بعض الامتنان\N‫أيّها الهواة الجاحدون!
Dialogue: 0,0:16:09.39,0:16:11.14,Default,,0,0,0,,‫حسنًا، فلنبدأ.
Dialogue: 0,0:16:11.30,0:16:12.14,Default,,0,0,0,,‫عُلم.
Dialogue: 0,0:16:15.72,0:16:16.89,Default,,0,0,0,,‫عجبًا...
Dialogue: 0,0:16:16.98,0:16:18.06,Default,,0,0,0,,‫حسنًا...
Dialogue: 0,0:16:18.19,0:16:21.06,Default,,0,0,0,,‫استعدّوا الآن يا أطفالي البشر الصغار.
Dialogue: 0,0:16:21.52,0:16:22.56,Default,,0,0,0,,‫أنا قادمة!
Dialogue: 0,0:16:23.57,0:16:24.48,Default,,0,0,0,,‫لوتس...
Dialogue: 0,0:16:24.86,0:16:26.57,Default,,0,0,0,,‫الهذيان القرمزي!
Dialogue: 0,0:16:26.86,0:16:28.57,Default,,0,0,0,,‫الهدف بسيط.
Dialogue: 0,0:16:28.78,0:16:31.45,Default,,0,0,0,,‫افعلوا ما يلزم للتحرّر والعودة بسلام.
Dialogue: 0,0:16:32.03,0:16:33.91,Default,,0,0,0,,‫أتمنّى لكم التوفيق.
Dialogue: 0,0:16:36.12,0:16:37.91,Default,,0,0,0,,‫أتظنّ أنّهم سيكونون بخير؟
Dialogue: 0,0:16:38.00,0:16:40.92,Default,,0,0,0,,‫لم تخبرهم بأيّ شيء عن التعويذة.
Dialogue: 0,0:16:41.38,0:16:43.88,Default,,0,0,0,,‫كلّما كان التدريب واقعيًّا،
Dialogue: 0,0:16:43.92,0:16:46.17,Default,,0,0,0,,‫زادت فعاليّته.
Dialogue: 0,0:16:46.96,0:16:49.97,Default,,0,0,0,,‫علاوة على ذلك، هؤلاء الفتية أقوياء.
Dialogue: 0,0:16:50.47,0:16:52.51,Default,,0,0,0,,‫أنا واثق من أنّهم سيكونون بخير!
Dialogue: 0,0:16:56.72,0:16:58.18,Default,,0,0,0,,‫مثير للاهتمام.
Dialogue: 0,0:16:58.85,0:17:01.85,Default,,0,0,0,,‫إذًا تحبس التعويذة\N‫ضحيّتها في نوع من الوهم.
Dialogue: 0,0:17:03.06,0:17:05.69,Default,,0,0,0,,‫كيف سأخرج من هذا المكان...؟
Dialogue: 0,0:17:09.28,0:17:10.45,Default,,0,0,0,,‫لا يُصدّق.
Dialogue: 0,0:17:10.95,0:17:11.95,Default,,0,0,0,,‫هـ-هذا...
Dialogue: 0,0:17:18.16,0:17:19.20,Default,,0,0,0,,‫مستحيل...
Dialogue: 0,0:17:21.58,0:17:23.21,Default,,0,0,0,,‫أ-أخي!
Dialogue: 0,0:17:23.63,0:17:24.67,Italics,,0,0,0,,‫و...
Dialogue: 0,0:17:24.79,0:17:25.84,Italics,,0,0,0,,‫ذلك السيف!
Dialogue: 0,0:17:26.38,0:17:27.88,Italics,,0,0,0,,‫لا، هذا ليس حقيقيًّا!
Dialogue: 0,0:17:28.17,0:17:29.09,Italics,,0,0,0,,‫إنّها تعويذة!
Dialogue: 0,0:17:29.80,0:17:31.22,Italics,,0,0,0,,‫لا تنخدع بها...
Dialogue: 0,0:17:31.30,0:17:32.38,Italics,,0,0,0,,‫شينجي قد...
Dialogue: 0,0:17:32.47,0:17:34.51,Default,,0,0,0,,‫مرّ وقت طويل يا ريجي.
Dialogue: 0,0:17:35.05,0:17:36.72,Default,,0,0,0,,‫هل أصبحت أقوى؟
Dialogue: 0,0:17:40.48,0:17:41.64,Default,,0,0,0,,‫ما خطبك؟
Dialogue: 0,0:17:41.73,0:17:44.15,Default,,0,0,0,,‫لا بدّ أنّك تتساهل معي.
Dialogue: 0,0:17:44.69,0:17:47.15,Default,,0,0,0,,‫سيتطلّب قتلي أكثر من ذلك السيف.
Dialogue: 0,0:17:51.28,0:17:52.61,Default,,0,0,0,,‫تقريبًا!
Dialogue: 0,0:17:52.74,0:17:55.41,Flashback,,0,0,0,,‫أخفضي يدك قليلًا لتصلي إلى تلك الجذور.
Dialogue: 0,0:17:55.49,0:17:56.45,Flashback,,0,0,0,,‫هكذا؟
Dialogue: 0,0:17:56.53,0:17:58.66,Flashback,,0,0,0,,‫هذا ممتاز يا حلوتي!
Dialogue: 0,0:17:59.12,0:18:01.62,Flashback,,0,0,0,,‫هل ستصبحين عالمة نباتات عندما تكبرين؟
Dialogue: 0,0:18:01.79,0:18:02.79,Flashback,,0,0,0,,‫لا.
Dialogue: 0,0:18:02.92,0:18:07.17,Flashback,,0,0,0,,‫سأكبر وأُصبح جاسوسة مثلك ومثل أبي!
Dialogue: 0,0:18:07.50,0:18:11.05,Flashback,,0,0,0,,‫لكنّها قد تكون مهنة مخيفة حقًّا!
Dialogue: 0,0:18:11.76,0:18:14.05,Flashback,,0,0,0,,‫ألا تريدين مساعدة النباتات\N‫والزهور على النموّ؟
Dialogue: 0,0:18:14.26,0:18:15.51,Flashback,,0,0,0,,‫ لست خائفة!
Dialogue: 0,0:18:15.59,0:18:19.18,Flashback,,0,0,0,,‫أنا شجاعة، تمامًا مثل أمّي وأبي!
Dialogue: 0,0:18:20.77,0:18:23.52,Flashback,,0,0,0,,‫أُريد أن أفعل ما تفعلينه يا أمّي!
Dialogue: 0,0:18:23.73,0:18:25.27,Flashback,,0,0,0,,‫سنرى بشأن ذلك.
Dialogue: 0,0:18:25.98,0:18:27.02,Italics,,0,0,0,,‫لم أكن أعلم.
Dialogue: 0,0:18:27.90,0:18:29.40,Italics,,0,0,0,,‫ظننت...
Dialogue: 0,0:18:29.53,0:18:33.07,Italics,,0,0,0,,‫أنّ الأخيار ينتصرون دائمًا على الأشرار.
Dialogue: 0,0:18:34.36,0:18:36.32,Flashback,,0,0,0,,‫أعتذر عن المقاطعة يا سيّدتي.
Dialogue: 0,0:18:36.74,0:18:38.78,Flashback,,0,0,0,,‫تلقّينا إشعارًا بمهمّة عاجلة.
Dialogue: 0,0:18:39.45,0:18:40.66,Flashback,,0,0,0,,‫عُلم.
Dialogue: 0,0:18:40.74,0:18:41.83,Flashback,,0,0,0,,‫سآتي على الفور.
Dialogue: 0,0:18:42.16,0:18:43.71,Flashback,,0,0,0,,‫حان وقت العمل؟
Dialogue: 0,0:18:43.87,0:18:46.17,Flashback,,0,0,0,,‫نعم، آسفة يا إيتشيكا.
Dialogue: 0,0:18:46.50,0:18:48.59,Flashback,,0,0,0,,‫لا تقلقي، سأعود قريبًا!
Dialogue: 0,0:18:49.04,0:18:52.09,Flashback,,0,0,0,,‫أمّكِ ستتولّى الأمر!
Dialogue: 0,0:18:52.55,0:18:54.55,Flashback,,0,0,0,,‫كوني فتاة مطيعة، اتّفقنا؟
Dialogue: 0,0:18:54.68,0:18:55.59,Flashback,,0,0,0,,‫أجل!
Dialogue: 0,0:18:56.47,0:19:00.35,Italics,,0,0,0,,‫كان يومًا كأيّ يوم آخر.
Dialogue: 0,0:19:01.52,0:19:02.52,Italics,,0,0,0,,‫لكن...
Dialogue: 0,0:19:06.40,0:19:09.27,Italics,,0,0,0,,‫أسترجع الذكريات، ولا\N‫أرى من الجنازة سوى ضباب.
Dialogue: 0,0:19:10.02,0:19:13.19,Italics,,0,0,0,,‫استغرق الأمر بعض الوقت لأستوعب حقًّا...
Dialogue: 0,0:19:13.40,0:19:15.45,Italics,,0,0,0,,‫أنّها لن تعود أبدًا.
Dialogue: 0,0:19:17.28,0:19:19.41,Italics,,0,0,0,,‫وحينها بدأ كلّ شيء.
Dialogue: 0,0:19:19.58,0:19:21.45,Italics,,0,0,0,,‫بدأت أركض.
Dialogue: 0,0:19:21.79,0:19:24.41,Italics,,0,0,0,,‫لأُصبح أقوى. لأُصبح عميلة.
Dialogue: 0,0:19:24.58,0:19:26.08,Italics,,0,0,0,,‫كنت مهووسة...
Dialogue: 0,0:19:26.37,0:19:27.88,Italics,,0,0,0,,‫كلّما ركضت أبعد...
Dialogue: 0,0:19:27.96,0:19:30.00,Italics,,0,0,0,,‫كلّما أصبحت أسرع...
Dialogue: 0,0:19:30.09,0:19:33.51,Italics,,0,0,0,,‫ شعرت أنّي أقرب إلى أمّي.
Dialogue: 0,0:19:34.42,0:19:38.80,Italics,,0,0,0,,‫وأخيرًا، بمجرّد أن أصبحت\N‫عميلة رسميّة في المكتب...
Dialogue: 0,0:19:39.22,0:19:40.47,Default,,0,0,0,,‫السيّدة إيتشيكا...
Dialogue: 0,0:19:41.47,0:19:42.51,Default,,0,0,0,,‫نيشينا؟
Dialogue: 0,0:19:42.76,0:19:44.02,Default,,0,0,0,,‫أحسنتِ صنعًا حقًّا.
Dialogue: 0,0:19:44.39,0:19:47.52,Default,,0,0,0,,‫يودّ والدكِ أن ترافقيني.
Dialogue: 0,0:19:48.23,0:19:49.61,Default,,0,0,0,,‫أبي؟
Dialogue: 0,0:19:52.11,0:19:53.03,Default,,0,0,0,,‫إلى أين...؟
Dialogue: 0,0:19:53.32,0:19:56.03,Default,,0,0,0,,‫نحن أسفل إحدى منشآت\N‫الأبحاث التابعة للمكتب.
Dialogue: 0,0:20:02.12,0:20:04.29,Default,,0,0,0,,‫أ-أمّي...؟
Dialogue: 0,0:20:04.58,0:20:05.75,Default,,0,0,0,,‫هل هذه حقًّا؟
Dialogue: 0,0:20:05.79,0:20:06.79,Default,,0,0,0,,‫نعم.
Dialogue: 0,0:20:07.04,0:20:08.96,Default,,0,0,0,,‫أعتذر يا سيّدتي، إنّه ليس تمثالًا.
Dialogue: 0,0:20:09.00,0:20:10.25,Default,,0,0,0,,‫ولا هو مجسّم مزيّف.
Dialogue: 0,0:20:10.29,0:20:12.04,Default,,0,0,0,,‫أخشى أنّه...
Dialogue: 0,0:20:13.38,0:20:15.05,Default,,0,0,0,,‫طلب منّي والدكِ قراءة هذا.
Dialogue: 0,0:20:15.67,0:20:18.63,Default,,0,0,0,,‫"عزيزتي إيتشيكا، سامحيني\N‫لانتظاري حتّى الآن."
Dialogue: 0,0:20:19.18,0:20:21.35,Default,,0,0,0,,‫"كنت ملزمًا بالسريّة من قِبل المكتب."
Dialogue: 0,0:20:21.47,0:20:23.31,Default,,0,0,0,,‫"ولم يُسمح للمدنيّين بالمعرفة."
Dialogue: 0,0:20:23.72,0:20:25.43,Default,,0,0,0,,‫"قد يبدو الأمر مستحيلًا،
Dialogue: 0,0:20:25.81,0:20:28.31,Default,,0,0,0,,‫لكنّ والدتكِ في الواقع\N‫لا تزال على قيد الحياة."
Dialogue: 0,0:20:28.64,0:20:30.02,Default,,0,0,0,,‫"نفترض أنّها كانت في مهمّة
Dialogue: 0,0:20:30.06,0:20:32.81,Default,,0,0,0,,‫عندما حُبست داخل الحجر بتعويذة طيفيّة."
Dialogue: 0,0:20:33.19,0:20:36.32,Default,,0,0,0,,‫"والمونونوكي المسؤول\N‫عن هذا لا يزال طليقًا."
Dialogue: 0,0:20:36.74,0:20:38.20,Default,,0,0,0,,‫"طوال العقد الماضي،
Dialogue: 0,0:20:38.24,0:20:41.07,Default,,0,0,0,,‫جرّبنا تقريبًا كلّ الوسائل المتاحة،
Dialogue: 0,0:20:41.20,0:20:43.58,Default,,0,0,0,,‫لكنّ النجاح ظلّ بعيد المنال."
Dialogue: 0,0:20:43.78,0:20:47.08,Default,,0,0,0,,‫"لم أُرد إخباركِ بهذه الطريقة."
Dialogue: 0,0:20:47.50,0:20:50.37,Default,,0,0,0,,‫"أردت أن أكون بجانبكِ، ومن أجلك."
Dialogue: 0,0:20:50.92,0:20:53.59,Default,,0,0,0,,‫"لكن للأسف، وبقدر ما\N‫يؤلمني هذا، أنا عاجز عن ذلك."
Dialogue: 0,0:20:53.79,0:20:55.59,Default,,0,0,0,,‫"آمل أن تجدي في قلبكِ يومًا ما
Dialogue: 0,0:20:55.63,0:20:56.63,Default,,0,0,0,,‫مساحة لمسامحتي."
Dialogue: 0,0:20:59.22,0:21:00.34,Default,,0,0,0,,‫"ما تختارين التفكير فيه،
Dialogue: 0,0:21:00.38,0:21:01.84,Default,,0,0,0,,‫وما تختارين فعله،
Dialogue: 0,0:21:02.05,0:21:03.55,Default,,0,0,0,,‫هو قراركِ أنتِ وحدك...
Dialogue: 0,0:21:03.60,0:21:04.60,Default,,0,0,0,,‫إيتشيكا."
Dialogue: 0,0:21:08.27,0:21:09.48,Default,,0,0,0,,‫تماسكي...
Dialogue: 0,0:21:09.52,0:21:10.48,Default,,0,0,0,,‫يا أمّي.
Dialogue: 0,0:21:11.06,0:21:13.36,Default,,0,0,0,,‫أعدكِ بأنّي سأنقذكِ!
Dialogue: 0,0:21:13.65,0:21:15.11,Italics,,0,0,0,,‫هيّا يا إيتشيكا.
Dialogue: 0,0:21:16.90,0:21:19.40,Italics,,0,0,0,,‫أخبرتكِ أن تكوني فتاة مطيعة!
Dialogue: 0,0:21:20.15,0:21:23.49,Italics,,0,0,0,,‫أخبرتكِ أنّ مهنة الجاسوس مخيفة!
Dialogue: 0,0:21:23.91,0:21:25.74,Italics,,0,0,0,,‫أطالبكِ بالتوقّف فورًا!
Dialogue: 0,0:21:26.12,0:21:27.04,Italics,,0,0,0,,‫وإن لم تفعلي...
Dialogue: 0,0:21:27.08,0:21:28.50,Italics,,0,0,0,,‫فستنتهين...
Dialogue: 0,0:21:28.91,0:21:31.54,Italics,,0,0,0,,‫ستنتهين مثلي!
Dialogue: 0,0:21:38.26,0:21:41.01,Default,,0,0,0,,‫تبًّا! ما هذا المكان؟
Dialogue: 0,0:21:41.38,0:21:43.76,Default,,0,0,0,,‫نركض كالحمقى دون أن نلمح أيّ مخرج،
Dialogue: 0,0:21:43.80,0:21:45.01,Default,,0,0,0,,‫ولا حتّى جدارًا لعينًا!
Dialogue: 0,0:21:45.10,0:21:46.97,Default,,0,0,0,,‫بهذا المعدّل، ذلك الشيء سوف...
Dialogue: 0,0:21:47.01,0:21:47.85,Default,,0,0,0,,‫احترس!
Dialogue: 0,0:21:47.93,0:21:49.06,Default,,0,0,0,,‫عجبًا!
Dialogue: 0,0:21:49.31,0:21:52.19,Default,,0,0,0,,‫سحقًا! ما هذا الشيء؟
Dialogue: 0,0:21:52.56,0:21:54.94,Italics,,0,0,0,,‫نحن داخل وهم تلك القزمة المزعجة.
Dialogue: 0,0:21:55.02,0:21:56.90,Italics,,0,0,0,,‫يستحيل أن يكون هذا الشيء حقيقيًّا.
Dialogue: 0,0:21:57.32,0:22:00.03,Italics,,0,0,0,,‫لكن ينتابني شعور غريب...
Dialogue: 0,0:22:00.40,0:22:01.82,Italics,,0,0,0,,‫وكأنّي رأيته في مكـ—
Dialogue: 0,0:22:01.86,0:22:03.70,Default,,0,0,0,,‫هذا الهراء مزعج بحقّ!
Dialogue: 0,0:22:03.91,0:22:05.99,Default,,0,0,0,,‫لكن بما أنّي لا أرى أيّ باب سحريّ،
Dialogue: 0,0:22:06.12,0:22:07.45,Default,,0,0,0,,‫فلا خيار أمامنا.
Dialogue: 0,0:22:08.16,0:22:09.83,Default,,0,0,0,,‫أنا على أتمّ الاستعداد!
Dialogue: 0,0:22:10.37,0:22:11.91,Default,,0,0,0,,‫هيّا بنا يا راغو!
