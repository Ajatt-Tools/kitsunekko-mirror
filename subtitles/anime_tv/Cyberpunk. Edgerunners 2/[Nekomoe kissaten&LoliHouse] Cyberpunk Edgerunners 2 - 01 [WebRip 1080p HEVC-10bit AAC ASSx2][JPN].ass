Dialogue: 0,0:00:03.09,0:00:05.08,Dial-JP,,0,0,0,,おーい　ロマン　おーい
Dialogue: 0,0:00:05.58,0:00:06.26,Dial-JP,,0,0,0,,あれ
Dialogue: 0,0:00:06.26,0:00:08.92,Dial-JP,,0,0,0,,行っちゃったよ　聞こえなかったのかな
Dialogue: 0,0:00:08.92,0:00:11.00,Dial-JP,,0,0,0,,あいつ　カメラ撮ってる時はダメだよ
Dialogue: 0,0:00:11.26,0:00:11.94,Dial-JP,,0,0,0,,ダメ？
Dialogue: 0,0:00:12.19,0:00:14.24,Dial-JP,,0,0,0,,聞こえないんだ　のめり込んじゃって
Dialogue: 0,0:00:14.59,0:00:15.33,Dial-JP,,0,0,0,,何に
Dialogue: 0,0:00:15.56,0:00:16.28,Dial-JP,,0,0,0,,カメラ
Dialogue: 0,0:00:16.60,0:00:17.90,Dial-JP,,0,0,0,,なんでそんなもの
Dialogue: 0,0:00:18.36,0:00:19.55,Dial-JP,,0,0,0,,好きなんだって
Dialogue: 0,0:00:20.07,0:00:21.77,Dial-JP,,0,0,0,,BDとかに使うのかな
Dialogue: 0,0:00:22.36,0:00:24.09,Dial-JP,,0,0,0,,いや　映画が好きらしいよ
Dialogue: 0,0:00:24.90,0:00:25.56,Dial-JP,,0,0,0,,映画
Dialogue: 0,0:00:26.13,0:00:27.29,Dial-JP,,0,0,0,,映画って何
Dialogue: 0,0:00:29.19,0:00:33.94,Dial-JP,,0,0,0,,お前バカだな　暗い所でスクリーンで見るんだよ
Dialogue: 0,0:00:34.51,0:00:37.64,Dial-JP,,0,0,0,,偉そうに　お前は見たことあるのかよ
Dialogue: 0,0:00:38.17,0:00:40.06,Dial-JP,,0,0,0,,いや　ないけどさ
Dialogue: 0,0:02:39.05,0:02:41.71,Dial-JP,,0,0,0,,お前　ここの人間じゃないな
Dialogue: 0,0:02:54.23,0:02:56.71,Dial-JP,,0,0,0,,これで30秒の遅れだ　ミゲル
Dialogue: 0,0:02:57.14,0:02:58.28,Dial-JP,,0,0,0,,いいかげんにしろ
Dialogue: 0,0:02:59.17,0:03:00.77,Dial-JP,,0,0,0,,す　すまねえ　キング
Dialogue: 0,0:03:01.51,0:03:03.28,Dial-JP,,0,0,0,,死体なんて　ほっとけよ
Dialogue: 0,0:03:04.07,0:03:06.83,Dial-JP,,0,0,0,,ミゲル　お前は詰めが甘すぎる
Dialogue: 0,0:03:07.67,0:03:10.25,Dial-JP,,0,0,0,,なあ　エミリーには黙っててくんない
Dialogue: 0,0:03:13.92,0:03:16.73,Dial-JP,,0,0,0,,ゲッ　同じようなやつばっかりじゃねえか
Dialogue: 0,0:03:16.73,0:03:19.04,Dial-JP,,0,0,0,,焦るなミゲル　想定内だろ
Dialogue: 0,0:03:19.04,0:03:20.11,Dial-JP,,0,0,0,,どれだ
Dialogue: 0,0:03:20.11,0:03:21.89,Dial-JP,,0,0,0,,左手側　その段
Dialogue: 0,0:03:22.13,0:03:24.20,Dial-JP,,0,0,0,,右に２つ　そこだ
Dialogue: 0,0:03:29.17,0:03:30.08,Dial-JP,,0,0,0,,どう
Dialogue: 0,0:03:30.08,0:03:31.45,Dial-JP,,0,0,0,,本当に　これか
Dialogue: 0,0:03:31.45,0:03:32.63,Dial-JP,,0,0,0,,もっと近づけろ
Dialogue: 0,0:03:33.10,0:03:35.86,Dial-JP,,0,0,0,,ARCPRNXR05
Dialogue: 0,0:03:36.28,0:03:37.59,Dial-JP,,0,0,0,,間違いない　これだ
Dialogue: 0,0:03:37.83,0:03:38.29,Dial-JP,,0,0,0,,よし
Dialogue: 0,0:03:39.20,0:03:40.92,Dial-JP,,0,0,0,,何やってんの　あんたは
Dialogue: 0,0:03:40.92,0:03:41.59,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:03:41.59,0:03:42.93,Dial-JP,,0,0,0,,扱いには気をつけろ
Dialogue: 0,0:03:42.93,0:03:44.82,Dial-JP,,0,0,0,,生体チップの保管ケースだぞ
Dialogue: 0,0:03:44.82,0:03:45.65,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:03:46.13,0:03:48.01,Dial-JP,,0,0,0,,うるせえな　分かってるよ
Dialogue: 0,0:03:48.01,0:03:50.02,Dial-JP,,0,0,0,,さむっ　冷てえ
Dialogue: 0,0:03:50.68,0:03:51.62,Dial-JP,,0,0,0,,確保した
Dialogue: 0,0:03:52.52,0:03:54.18,Dial-JP,,0,0,0,,おい　確保したって
Dialogue: 0,0:03:55.61,0:03:56.47,Dial-JP,,0,0,0,,キング
Dialogue: 0,0:03:56.47,0:03:57.57,Dial-JP,,0,0,0,,聞いてんのか
Dialogue: 0,0:04:03.08,0:04:04.10,Dial-JP,,0,0,0,,何だ　ミゲル
Dialogue: 0,0:04:04.10,0:04:05.05,Dial-JP,,0,0,0,,確保したのか
Dialogue: 0,0:04:05.40,0:04:07.12,Dial-JP,,0,0,0,,いやいや　おいおいおい
Dialogue: 0,0:04:07.12,0:04:09.12,Dial-JP,,0,0,0,,確保してるじゃないか　行くぞ
Dialogue: 0,0:04:09.12,0:04:11.62,Dial-JP,,0,0,0,,まったく　どいつもこいつも
Dialogue: 0,0:04:12.47,0:04:13.36,Dial-JP,,0,0,0,,車は
Dialogue: 0,0:04:13.36,0:04:15.21,Dial-JP,,0,0,0,,出て　目の前のやつをハックした
Dialogue: 0,0:04:15.54,0:04:16.53,Dial-JP,,0,0,0,,ドライバーは
Dialogue: 0,0:04:16.53,0:04:19.51,Dial-JP,,0,0,0,,そりゃ別料　そちら方で都合つけ
Dialogue: 0,0:04:20.34,0:04:21.39,Dial-JP,,0,0,0,,ちょい待ち
Dialogue: 0,0:04:23.16,0:04:23.78,Dial-JP,,0,0,0,,どうした
Dialogue: 0,0:04:24.80,0:04:25.57,Dial-JP,,0,0,0,,おい　メシュガ
Dialogue: 0,0:04:25.57,0:04:26.80,Dial-JP,,0,0,0,,ヤバい　逃げろ
Dialogue: 0,0:04:28.50,0:04:29.33,Dial-JP,,0,0,0,,出口
Dialogue: 0,0:04:32.05,0:04:32.79,Dial-JP,,0,0,0,,キング
Dialogue: 0,0:04:32.79,0:04:33.49,Dial-JP,,0,0,0,,スキャン
Dialogue: 0,0:04:55.80,0:04:56.53,Dial-JP,,0,0,0,,ミゲル
Dialogue: 0,0:04:56.53,0:04:57.08,Dial-JP,,0,0,0,,チッ
Dialogue: 0,0:05:15.42,0:05:15.89,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:05:15.89,0:05:16.59,Dial-JP,,0,0,0,,お前たち…
Dialogue: 0,0:05:20.66,0:05:22.01,Dial-JP,,0,0,0,,ミゲル　車だ
Dialogue: 0,0:05:22.01,0:05:23.40,Dial-JP,,0,0,0,,分かってるよ
Dialogue: 0,0:05:24.90,0:05:27.02,Dial-JP,,0,0,0,,おい　なんか燃えてんぞ
Dialogue: 0,0:05:27.32,0:05:28.94,Dial-JP,,0,0,0,,あの辺　アラサカか
Dialogue: 0,0:05:30.06,0:05:31.02,Dial-JP,,0,0,0,,何でしょう
Dialogue: 0,0:05:31.02,0:05:33.04,Dial-JP,,0,0,0,,何か起ころうと　しているのでしょうか
Dialogue: 0,0:05:33.81,0:05:35.52,Dial-JP,,0,0,0,,いや　起きないか
Dialogue: 0,0:05:40.34,0:05:41.52,Dial-JP,,0,0,0,,しかし　僕は…
Dialogue: 0,0:05:42.60,0:05:43.10,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:05:43.10,0:05:44.21,Dial-JP,,0,0,0,,どこ見て歩い
Dialogue: 0,0:05:44.66,0:05:45.32,Dial-JP2,,0,0,0,,止まれ
Dialogue: 0,0:05:45.32,0:05:46.21,Dial-JP2,,0,0,0,,止まらんと
Dialogue: 0,0:05:44.66,0:05:46.54,Dial-JP,,0,0,0,,何だと　このクソガキ
Dialogue: 0,0:05:46.81,0:05:48.87,Dial-JP,,0,0,0,,ごごご　ごめんなさい
Dialogue: 0,0:06:00.17,0:06:00.84,Dial-JP,,0,0,0,,クソッ
Dialogue: 0,0:06:01.21,0:06:02.76,Dial-JP,,0,0,0,,何だってんだ　今日は
Dialogue: 0,0:06:03.84,0:06:05.22,Dial-JP,,0,0,0,,エミリー　無事か
Dialogue: 0,0:06:05.81,0:06:06.51,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:06:06.76,0:06:07.75,Dial-JP,,0,0,0,,何とか
Dialogue: 0,0:06:07.97,0:06:10.46,Dial-JP,,0,0,0,,キング　何やってんだよ　てめえ
Dialogue: 0,0:06:10.70,0:06:11.58,Dial-JP,,0,0,0,,ミゲル
Dialogue: 0,0:06:11.97,0:06:12.98,Dial-JP,,0,0,0,,ケースが
Dialogue: 0,0:06:12.98,0:06:15.11,Dial-JP,,0,0,0,,もうほっとけ　失敗だ
Dialogue: 0,0:06:16.11,0:06:16.61,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:06:16.61,0:06:17.23,Dial-JP,,0,0,0,,止まれ
Dialogue: 0,0:06:27.03,0:06:27.57,Dial-JP,,0,0,0,,アヴィ…
Dialogue: 0,0:06:31.38,0:06:37.33,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:06:46.99,0:06:48.89,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:07:08.28,0:07:10.75,Dial-JP,,0,0,0,,おい　エミリー　しっかりしろよ
Dialogue: 0,0:07:11.65,0:07:14.32,Dial-JP,,0,0,0,,早く　早く病院に行かねえと
Dialogue: 0,0:07:16.68,0:07:20.07,Dial-JP,,0,0,0,,もういい　お前だけで逃げろ　ミゲル
Dialogue: 0,0:07:20.07,0:07:21.31,Dial-JP,,0,0,0,,ふざけんなよ
Dialogue: 0,0:07:21.54,0:07:24.42,Dial-JP,,0,0,0,,クソッ　どうしちまったんだ　キングは
Dialogue: 0,0:07:24.42,0:07:25.88,Dial-JP,,0,0,0,,Cyberpsychoだ
Dialogue: 0,0:07:26.83,0:07:28.76,Dial-JP,,0,0,0,,一瞬だけ　目が合った
Dialogue: 0,0:07:29.66,0:07:30.58,Dial-JP,,0,0,0,,あの目は
Dialogue: 0,0:07:31.53,0:07:32.60,Dial-JP,,0,0,0,,サイコシス
Dialogue: 0,0:07:39.76,0:07:41.17,Dial-JP,,0,0,0,,要請に従い
Dialogue: 0,0:07:41.17,0:07:43.52,Dial-JP,,0,0,0,,Cyberpsycho化している\N目標を　無力化する
Dialogue: 0,0:07:44.06,0:07:46.30,Dial-JP,,0,0,0,,同時にトラウマチーム　契約状況を確認
Dialogue: 0,0:07:46.54,0:07:49.26,Dial-JP2,,0,0,0,,派遣要請　契約グレードによって…
Dialogue: 0,0:07:48.24,0:07:49.57,Dial-JP,,0,0,0,,ぐへ
Dialogue: 0,0:07:57.48,0:07:58.79,Dial-JP,,0,0,0,,ひでえな
Dialogue: 0,0:07:59.38,0:08:00.47,Dial-JP,,0,0,0,,ちーっす
Dialogue: 0,0:08:00.47,0:08:02.58,Dial-JP,,0,0,0,,お疲りゃしゃしゃっす
Dialogue: 0,0:08:02.58,0:08:03.23,Dial-JP,,0,0,0,,あれ
Dialogue: 0,0:08:03.23,0:08:04.54,Dial-JP,,0,0,0,,何見てるんすか
Dialogue: 0,0:08:04.86,0:08:06.34,Dial-JP,,0,0,0,,持ち込み動画
Dialogue: 0,0:08:06.34,0:08:07.34,Dial-JP,,0,0,0,,動画？
Dialogue: 0,0:08:07.64,0:08:09.38,Dial-JP,,0,0,0,,うちBDショップっすよね
Dialogue: 0,0:08:09.77,0:08:12.75,Dial-JP,,0,0,0,,こういった動画にも　多少ニーズはあるわけ
Dialogue: 0,0:08:13.70,0:08:16.01,Dial-JP,,0,0,0,,これ　昨日ニュースでやってたアラサカの
Dialogue: 0,0:08:16.01,0:08:16.79,Dial-JP,,0,0,0,,そっ
Dialogue: 0,0:08:16.79,0:08:19.00,Dial-JP,,0,0,0,,MaxTacのサイコ狩り
Dialogue: 0,0:08:19.00,0:08:20.17,Dial-JP,,0,0,0,,のはずが
Dialogue: 0,0:08:20.60,0:08:23.55,Dial-JP,,0,0,0,,ターゲットは　プラチナ持ちの特権階級
Dialogue: 0,0:08:23.55,0:08:26.12,Dial-JP,,0,0,0,,トラウマチームが　血相変えて　やって来て
Dialogue: 0,0:08:26.12,0:08:28.97,Dial-JP,,0,0,0,,哀れなのは　アラサカ　１人
Dialogue: 0,0:08:29.26,0:08:31.68,Dial-JP,,0,0,0,,なんか　アラサカも落ち目っすよね
Dialogue: 0,0:08:31.68,0:08:33.58,Dial-JP,,0,0,0,,襲撃ばっか　されてません
Dialogue: 0,0:08:34.06,0:08:36.15,Dial-JP,,0,0,0,,ねえ　これあんたが撮ったの
Dialogue: 0,0:08:36.15,0:08:36.82,Dial-JP,,0,0,0,,そう
Dialogue: 0,0:08:37.82,0:08:38.77,Dial-JP,,0,0,0,,すごいじゃん
Dialogue: 0,0:08:43.39,0:08:44.26,Dial-JP,,0,0,0,,トラウマ来た
Dialogue: 0,0:08:45.21,0:08:47.41,Dial-JP,,0,0,0,,こいつも　年の割に頑張ってたが
Dialogue: 0,0:08:47.41,0:08:49.06,Dial-JP,,0,0,0,,さすがに　おしまいか
Dialogue: 0,0:08:49.06,0:08:50.30,Dial-JP,,0,0,0,,有名なんすか
Dialogue: 0,0:08:50.30,0:08:51.92,Dial-JP,,0,0,0,,キングっていってな
Dialogue: 0,0:08:51.92,0:08:53.16,Dial-JP,,0,0,0,,キング？
Dialogue: 0,0:08:53.16,0:08:54.61,Dial-JP,,0,0,0,,へへッ　ダッサー
Dialogue: 0,0:08:54.61,0:08:57.19,Dial-JP,,0,0,0,,笑えるだろ　もっと笑えんのが本名
Dialogue: 0,0:08:57.19,0:08:58.42,Dial-JP,,0,0,0,,で　いくらで買う
Dialogue: 0,0:08:59.80,0:09:02.51,Dial-JP,,0,0,0,,うん　200？
Dialogue: 0,0:09:02.51,0:09:04.54,Dial-JP,,0,0,0,,やーっす　バカ安
Dialogue: 0,0:09:04.54,0:09:05.70,Dial-JP,,0,0,0,,やめた
Dialogue: 0,0:09:05.70,0:09:07.07,Dial-JP,,0,0,0,,テレビなら　もっと出すさ
Dialogue: 0,0:09:07.07,0:09:10.92,Dial-JP,,0,0,0,,まあ　Ｎ54なら100くらいは出すかもな
Dialogue: 0,0:09:12.29,0:09:14.24,Dial-JP,,0,0,0,,分かった　200で
Dialogue: 0,0:09:16.12,0:09:18.12,Dial-JP,,0,0,0,,なんか　大人げなーい
Dialogue: 0,0:09:18.98,0:09:19.35,Dial-JP,,0,0,0,,チッ
Dialogue: 0,0:09:19.35,0:09:21.27,Dial-JP,,0,0,0,,お前は早く仕事しろ
Dialogue: 0,0:09:21.27,0:09:23.29,Dial-JP,,0,0,0,,編集するBD素材　来てっから
Dialogue: 0,0:09:24.07,0:09:25.45,Dial-JP,,0,0,0,,へい
Dialogue: 0,0:09:26.81,0:09:28.72,Dial-JP,,0,0,0,,ん－じゃ　バイビーね
Dialogue: 0,0:09:29.69,0:09:30.74,Dial-JP,,0,0,0,,めんどくせえ
Dialogue: 0,0:09:38.52,0:09:39.88,Dial-JP,,0,0,0,,なあ　ロマン
Dialogue: 0,0:09:40.23,0:09:43.49,Dial-JP,,0,0,0,,稼ぎたいならBD　「ブレインダンス」だ
Dialogue: 0,0:09:44.14,0:09:48.07,Dial-JP,,0,0,0,,今のジェシー　BDの編集で\Nいくら稼いでるか　知ってるか
Dialogue: 0,0:09:48.07,0:09:49.20,Dial-JP,,0,0,0,,編集っていっても
Dialogue: 0,0:09:49.20,0:09:51.14,Dial-JP,,0,0,0,,BDの場合は　チューニングでしょ
Dialogue: 0,0:09:51.57,0:09:53.77,Dial-JP,,0,0,0,,映像の編集とは別物
Dialogue: 0,0:09:53.77,0:09:56.30,Dial-JP,,0,0,0,,追体験じゃん　面白くないよ
Dialogue: 0,0:09:56.56,0:09:59.07,Dial-JP,,0,0,0,,若いくせに　考えが古いんだよな
Dialogue: 0,0:09:59.58,0:10:01.90,Dial-JP,,0,0,0,,今　売れてるのはBD
Dialogue: 0,0:10:01.90,0:10:03.78,Dial-JP,,0,0,0,,お前の好きな映画じゃない
Dialogue: 0,0:10:04.28,0:10:06.40,Dial-JP,,0,0,0,,もう終わってんだよ　映画は
Dialogue: 0,0:10:08.08,0:10:10.11,Dial-JP,,0,0,0,,BDじゃ物語は描けないよ
Dialogue: 0,0:10:10.43,0:10:11.73,Dial-JP,,0,0,0,,物語
Dialogue: 0,0:10:11.98,0:10:13.24,Dial-JP,,0,0,0,,要るか　そんなもん
Dialogue: 0,0:10:13.78,0:10:15.45,Dial-JP,,0,0,0,,BDには垣根がない
Dialogue: 0,0:10:15.86,0:10:18.01,Dial-JP,,0,0,0,,あっちと　こっちを隔てる垣根が
Dialogue: 0,0:10:18.61,0:10:19.86,Dial-JP,,0,0,0,,すごい映画はさ
Dialogue: 0,0:10:20.19,0:10:21.74,Dial-JP,,0,0,0,,垣根を越えて　やって来るんだ
Dialogue: 0,0:10:22.07,0:10:23.30,Dial-JP,,0,0,0,,あるのに越えてくる
Dialogue: 0,0:10:23.63,0:10:25.22,Dial-JP,,0,0,0,,あるのに　なくなるんだ
Dialogue: 0,0:10:25.51,0:10:26.68,Dial-JP,,0,0,0,,「ない」じゃ　できない
Dialogue: 0,0:10:27.49,0:10:30.09,Dial-JP,,0,0,0,,そのためには　物語が要るんだ
Dialogue: 0,0:10:30.55,0:10:32.69,Dial-JP,,0,0,0,,そりゃ　大層なこって
Dialogue: 0,0:10:34.44,0:10:37.24,Dial-JP,,0,0,0,,BDが嫌なら　メイルストロームだ
Dialogue: 0,0:10:37.63,0:10:39.22,Dial-JP,,0,0,0,,メイルストローム
Dialogue: 0,0:10:39.49,0:10:40.73,Dial-JP,,0,0,0,,あいつらヤバいでしょ
Dialogue: 0,0:10:41.13,0:10:42.79,Dial-JP,,0,0,0,,カネは要るんだろ
Dialogue: 0,0:10:42.79,0:10:45.96,Dial-JP,,0,0,0,,あいつらがクロームを\Nインストールする動画は人気があるんだが
Dialogue: 0,0:10:45.96,0:10:47.61,Dial-JP,,0,0,0,,なかなか出回らねえ
Dialogue: 0,0:10:47.61,0:10:49.20,Dial-JP,,0,0,0,,ほとんどスナッフじゃんか
Dialogue: 0,0:10:49.20,0:10:50.55,Dial-JP,,0,0,0,,美学に反する
Dialogue: 0,0:10:50.77,0:10:51.98,Dial-JP,,0,0,0,,それに　どうやって撮れって
Dialogue: 0,0:10:51.98,0:10:53.94,Dial-JP,,0,0,0,,それを考えるんだろ
Dialogue: 0,0:10:53.94,0:10:56.74,Dial-JP,,0,0,0,,簡単には撮れねえから　価値があるんじゃねえか
Dialogue: 0,0:10:56.74,0:10:59.98,Dial-JP,,0,0,0,,その動画なら　高級カメラが\N買えるくらいは出してやる
Dialogue: 0,0:11:00.24,0:11:03.52,Dial-JP,,0,0,0,,そもそも普通には売ってないから\N困るってのもあるんだけど
Dialogue: 0,0:11:05.46,0:11:07.33,Dial-JP,,0,0,0,,35ミリ
Dialogue: 0,0:11:07.33,0:11:09.01,Dial-JP,,0,0,0,,俺は35ミリを持ってる
Dialogue: 0,0:11:11.06,0:11:12.80,Dial-JP,,0,0,0,,無論　フィルムもある
Dialogue: 0,0:11:12.80,0:11:15.40,Dial-JP,,0,0,0,,まあ　まともに動くかは分からんが
Dialogue: 0,0:11:15.93,0:11:17.59,Dial-JP,,0,0,0,,それを　お前にやってもいい
Dialogue: 0,0:11:18.10,0:11:19.90,Dial-JP,,0,0,0,,もしくはBDだ
Dialogue: 0,0:11:21.15,0:11:23.02,Dial-JP,,0,0,0,,メイルストロームね
Dialogue: 0,0:11:23.98,0:11:25.71,Dial-JP2,,0,0,0,,タリアさん　止まりなさい
Dialogue: 0,0:11:25.71,0:11:27.19,Dial-JP2,,0,0,0,,今日は絶対に逃がしませんよ
Dialogue: 0,0:11:27.19,0:11:28.75,Dial-JP2,,0,0,0,,コラ　タリアさん
Dialogue: 0,0:11:29.11,0:11:30.29,Dial-JP2,,0,0,0,,待ちなさい
Dialogue: 0,0:11:30.76,0:11:33.88,Dial-JP2,,0,0,0,,タリアさーん
Dialogue: 0,0:11:31.81,0:11:33.05,Dial-JP,,0,0,0,,またヤンさん
Dialogue: 0,0:11:33.05,0:11:34.55,Dial-JP,,0,0,0,,これで何度目だ
Dialogue: 0,0:11:35.05,0:11:36.86,Dial-JP,,0,0,0,,患者さん　目を覚ましました
Dialogue: 0,0:11:37.93,0:11:41.43,Dial-JP,,0,0,0,,50日　そんなに眠ってたのか
Dialogue: 0,0:11:41.86,0:11:45.47,Dial-JP,,0,0,0,,びっくりするよねえ　でも生きてるだけマシでしょ
Dialogue: 0,0:11:45.47,0:11:48.89,Dial-JP,,0,0,0,,プラチナじゃなかったら\NMaxTacに処理されてたよ
Dialogue: 0,0:11:48.89,0:11:50.81,Dial-JP,,0,0,0,,高いカネ払ってて　よかったねえ
Dialogue: 0,0:11:50.81,0:11:53.35,Dial-JP,,0,0,0,,処理　MaxTac？
Dialogue: 0,0:11:53.35,0:11:56.92,Dial-JP,,0,0,0,,そう　Cyberpsychosisに\N片足突っ込んじゃってたからね
Dialogue: 0,0:11:57.42,0:12:00.15,Dial-JP,,0,0,0,,Cyberpsycho　俺が？
Dialogue: 0,0:12:00.15,0:12:02.59,Dial-JP,,0,0,0,,言っちゃ悪いけど　クロームの盛りすぎ
Dialogue: 0,0:12:02.59,0:12:05.44,Dial-JP,,0,0,0,,人の体には　許される範囲ってのがあるの
Dialogue: 0,0:12:05.44,0:12:08.66,Dial-JP,,0,0,0,,それに加えて　ストレスとか\Nいろいろ重なっちゃったのかな
Dialogue: 0,0:12:09.04,0:12:11.37,Dial-JP,,0,0,0,,いや　絶好調だった
Dialogue: 0,0:12:11.74,0:12:13.54,Dial-JP,,0,0,0,,今まで俺はストレスなんて
Dialogue: 0,0:12:13.96,0:12:17.16,Dial-JP,,0,0,0,,自覚症状がないまま　発症することがある
Dialogue: 0,0:12:17.16,0:12:20.78,Dial-JP,,0,0,0,,何が要因か　まだ解明されてないことも多いんだ
Dialogue: 0,0:12:21.24,0:12:23.66,Dial-JP,,0,0,0,,でも　あんたの場合は分かりやすい
Dialogue: 0,0:12:23.66,0:12:26.19,Dial-JP,,0,0,0,,エッジを越えたんだ　それが事実さ
Dialogue: 0,0:12:26.86,0:12:28.74,Dial-JP,,0,0,0,,今は余計なもの全部切って
Dialogue: 0,0:12:28.74,0:12:31.17,Dial-JP,,0,0,0,,負荷の少ないIMPLANTに交換してある
Dialogue: 0,0:12:31.46,0:12:34.49,Dial-JP,,0,0,0,,とりあえず　頭が爆発する心配はしなくていい
Dialogue: 0,0:12:34.97,0:12:36.17,Dial-JP,,0,0,0,,僕が保証しよう
Dialogue: 0,0:12:37.23,0:12:38.26,Dial-JP,,0,0,0,,どのくらいだ？
Dialogue: 0,0:12:39.51,0:12:41.32,Dial-JP,,0,0,0,,どのくらい待てば使えるように
Dialogue: 0,0:12:41.32,0:12:44.02,Dial-JP,,0,0,0,,バカ言ってんじゃないよ　死にたいの
Dialogue: 0,0:12:44.02,0:12:46.37,Dial-JP,,0,0,0,,今後　一切IMPLANTはダメだからね
Dialogue: 0,0:12:46.78,0:12:47.62,Dial-JP,,0,0,0,,ウソだろ
Dialogue: 0,0:12:47.62,0:12:49.87,Dial-JP,,0,0,0,,再起動すれば　その瞬間…
Dialogue: 0,0:12:50.15,0:12:50.85,Dial-JP,,0,0,0,,ボンッ
Dialogue: 0,0:12:51.28,0:12:53.52,Dial-JP,,0,0,0,,しかも　もう守ってくれる保険はない
Dialogue: 0,0:12:53.97,0:12:56.40,Dial-JP,,0,0,0,,次にMaxTacが来たら　終わりだね
Dialogue: 0,0:12:57.51,0:12:58.76,Dial-JP,,0,0,0,,まあ　そういうこと
Dialogue: 0,0:12:59.58,0:13:02.45,Dial-JP,,0,0,0,,さて　最後に精算の話をしよう
Dialogue: 0,0:13:02.45,0:13:04.11,Dial-JP,,0,0,0,,稼いでおいてよかったね
Dialogue: 0,0:13:04.11,0:13:06.58,Dial-JP,,0,0,0,,こんな医療費普通なら払えないよ
Dialogue: 0,0:13:06.58,0:13:09.27,Dial-JP,,0,0,0,,不足分も差し押さえで　何とかなったから
Dialogue: 0,0:13:09.27,0:13:10.39,Dial-JP,,0,0,0,,ラッキー
Dialogue: 0,0:13:10.39,0:13:11.65,Dial-JP,,0,0,0,,ゴッド・ブレス・ユー
Dialogue: 0,0:13:13.25,0:13:13.75,Dial-JP,,0,0,0,,はあ？
Dialogue: 0,0:13:23.20,0:13:25.73,Dial-JP,,0,0,0,,キング　意識は戻ったのか
Dialogue: 0,0:13:25.73,0:13:26.75,Dial-JP,,0,0,0,,まあな
Dialogue: 0,0:13:26.75,0:13:28.88,Dial-JP,,0,0,0,,そうか　そりゃよかった
Dialogue: 0,0:13:28.88,0:13:31.17,Dial-JP,,0,0,0,,おい　今キングって言ったか
Dialogue: 0,0:13:31.17,0:13:34.04,Dial-JP,,0,0,0,,ミゲルもいるのか　アフターライフか？
Dialogue: 0,0:13:34.04,0:13:35.55,Dial-JP,,0,0,0,,おい　あいつか
Dialogue: 0,0:13:35.55,0:13:37.20,Dial-JP,,0,0,0,,悪い　またかけ直す
Dialogue: 0,0:13:41.24,0:13:43.13,Dial-JP,,0,0,0,,おい　ミゲル　やめろ
Dialogue: 0,0:13:44.03,0:13:44.94,Dial-JP,,0,0,0,,おい　よせ
Dialogue: 0,0:13:45.39,0:13:46.76,Dial-JP,,0,0,0,,やめろって　ミゲル
Dialogue: 0,0:13:51.34,0:13:53.98,Dial-JP,,0,0,0,,すいません　皆さん　お気になさらず
Dialogue: 0,0:13:55.17,0:13:57.02,Dial-JP,,0,0,0,,キング　大丈夫か
Dialogue: 0,0:13:58.12,0:13:58.84,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:14:02.66,0:14:03.98,Dial-JP,,0,0,0,,ナマっちまったか
Dialogue: 0,0:14:04.27,0:14:06.35,Dial-JP,,0,0,0,,ミゲルのパンチをもろに食らうなんて
Dialogue: 0,0:14:07.46,0:14:09.11,Dial-JP,,0,0,0,,リハビリが必要だな
Dialogue: 0,0:14:12.31,0:14:13.74,Dial-JP,,0,0,0,,もう大丈夫なのか
Dialogue: 0,0:14:14.84,0:14:15.99,Dial-JP,,0,0,0,,言いづらいんだが…
Dialogue: 0,0:14:15.99,0:14:17.72,Dial-JP,,0,0,0,,Cyberpsychosisか
Dialogue: 0,0:14:17.96,0:14:18.62,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:14:18.87,0:14:20.05,Dial-JP,,0,0,0,,今は何ともない
Dialogue: 0,0:14:20.66,0:14:22.75,Dial-JP,,0,0,0,,IMPLANTは全部止められたがな
Dialogue: 0,0:14:23.28,0:14:24.80,Dial-JP,,0,0,0,,動かすと死ぬらしい
Dialogue: 0,0:14:25.22,0:14:25.86,Dial-JP,,0,0,0,,マジか？
Dialogue: 0,0:14:26.48,0:14:27.95,Dial-JP,,0,0,0,,教えてくれ　メシュガ
Dialogue: 0,0:14:28.43,0:14:29.23,Dial-JP,,0,0,0,,俺はあの時…
Dialogue: 0,0:14:29.23,0:14:30.60,Dial-JP,,0,0,0,,死ねばよかったんだ
Dialogue: 0,0:14:31.73,0:14:32.56,Dial-JP,,0,0,0,,おい
Dialogue: 0,0:14:32.90,0:14:35.28,Dial-JP,,0,0,0,,あんたはあの時完全にイカれてた
Dialogue: 0,0:14:35.77,0:14:38.19,Dial-JP,,0,0,0,,あんたがちゃんとしてればエミリーは…
Dialogue: 0,0:14:39.44,0:14:40.22,Dial-JP,,0,0,0,,おい　ミゲル
Dialogue: 0,0:14:40.22,0:14:41.15,Dial-JP,,0,0,0,,触んな
Dialogue: 0,0:14:42.70,0:14:44.35,Dial-JP,,0,0,0,,ミゲル　俺は…
Dialogue: 0,0:14:45.09,0:14:47.00,Dial-JP,,0,0,0,,触んじゃねえっつったろ
Dialogue: 0,0:14:49.52,0:14:51.95,Dial-JP,,0,0,0,,おい　待てよミゲル　キングのせいじゃ
Dialogue: 0,0:14:51.95,0:14:52.70,Dial-JP,,0,0,0,,放せよ
Dialogue: 0,0:14:52.70,0:14:54.33,Dial-JP,,0,0,0,,ミゲル　教えてくれ
Dialogue: 0,0:14:54.88,0:14:56.76,Dial-JP,,0,0,0,,俺は何も覚えてないんだ
Dialogue: 0,0:14:57.38,0:15:00.09,Dial-JP,,0,0,0,,俺は　あの時　エミリーは…
Dialogue: 0,0:15:00.09,0:15:01.49,Dial-JP,,0,0,0,,あんたが殺した
Dialogue: 0,0:15:02.68,0:15:03.43,Dial-JP,,0,0,0,,俺が？
Dialogue: 0,0:15:03.97,0:15:05.13,Dial-JP,,0,0,0,,なんで…
Dialogue: 0,0:15:05.13,0:15:09.31,Dial-JP,,0,0,0,,なんでエミリーが死んで　あんたは生きてんだよ
Dialogue: 0,0:15:09.31,0:15:11.18,Dial-JP,,0,0,0,,あんたも死んでろよ
Dialogue: 0,0:15:11.18,0:15:13.97,Dial-JP,,0,0,0,,それでもCyberpunkかよ
Dialogue: 0,0:15:17.46,0:15:18.36,Dial-JP,,0,0,0,,メシュガ…
Dialogue: 0,0:15:18.84,0:15:20.41,Dial-JP,,0,0,0,,今日は帰ったほうがいい
Dialogue: 0,0:15:21.23,0:15:22.50,Dial-JP,,0,0,0,,また連絡する
Dialogue: 0,0:15:28.64,0:15:30.34,Dial-JP,,0,0,0,,おーい
Dialogue: 0,0:15:30.92,0:15:32.04,Dial-JP,,0,0,0,,キングさん
Dialogue: 0,0:15:37.48,0:15:40.71,Dial-JP,,0,0,0,,なあ　俺らのこと覚えてる
Dialogue: 0,0:15:42.18,0:15:45.10,Dial-JP,,0,0,0,,覚えてねえよなあ　そうだよなあ
Dialogue: 0,0:15:45.40,0:15:46.72,Dial-JP,,0,0,0,,「キング」だもんな
Dialogue: 0,0:15:47.97,0:15:49.34,Dial-JP,,0,0,0,,何だ　その目は
Dialogue: 0,0:15:52.09,0:15:54.56,Dial-JP,,0,0,0,,なあ　こいつの本名知ってるか
Dialogue: 0,0:15:54.98,0:15:56.31,Dial-JP,,0,0,0,,ウィーク・キングズリー
Dialogue: 0,0:15:56.88,0:15:59.31,Dial-JP,,0,0,0,,今は「ウィーク」のほうがお似合いだ
Dialogue: 0,0:15:59.86,0:16:01.29,Dial-JP,,0,0,0,,仲間殺しが
Dialogue: 0,0:16:01.29,0:16:03.87,Dial-JP,,0,0,0,,二度とこの辺に顔出すんじゃねえぞ
Dialogue: 0,0:16:17.22,0:16:20.06,Dial-JP,,0,0,0,,言われたビルまで来たけど　閉鎖されてるよ
Dialogue: 0,0:16:20.74,0:16:22.33,Dial-JP,,0,0,0,,本当にここで合ってる
Dialogue: 0,0:16:22.63,0:16:25.29,Dial-JP,,0,0,0,,大体その辺りのはずなんだがな
Dialogue: 0,0:16:25.29,0:16:26.54,Dial-JP,,0,0,0,,「大体」って…
Dialogue: 0,0:16:26.54,0:16:28.40,Dial-JP,,0,0,0,,まっ　その辺探してみな
Dialogue: 0,0:16:29.67,0:16:31.95,Dial-JP,,0,0,0,,適当すぎるだろ
Dialogue: 0,0:17:32.18,0:17:34.10,Dial-JP,,0,0,0,,誰　あんた
Dialogue: 0,0:17:39.40,0:17:40.50,Dial-JP,,0,0,0,,子供？
Dialogue: 0,0:17:41.47,0:17:44.02,Dial-JP,,0,0,0,,すみません　勝手に撮っちゃって…
Dialogue: 0,0:17:45.28,0:17:45.91,Dial-JP,,0,0,0,,イテッ
Dialogue: 0,0:17:47.43,0:17:50.56,Dial-JP,,0,0,0,,ごめんなさい　でも声かけたら危ないと思って
Dialogue: 0,0:17:51.21,0:17:52.01,Dial-JP,,0,0,0,,その…
Dialogue: 0,0:17:52.73,0:17:57.01,Dial-JP,,0,0,0,,実は　メイル　ストロームの…
Dialogue: 0,0:18:00.02,0:18:02.36,Dial-JP,,0,0,0,,あんた　ほとんど生身なの
Dialogue: 0,0:18:02.59,0:18:03.18,Dial-JP,,0,0,0,,え?
Dialogue: 0,0:18:03.18,0:18:03.90,Dial-JP,,0,0,0,,どうして
Dialogue: 0,0:18:04.33,0:18:08.63,Dial-JP,,0,0,0,,「どうして」って　あんま興味ないっていうか
Dialogue: 0,0:18:09.11,0:18:09.65,Dial-JP,,0,0,0,,イテッ
Dialogue: 0,0:18:10.93,0:18:13.58,Dial-JP,,0,0,0,,どうして　そんな体のままでいられるの
Dialogue: 0,0:18:15.69,0:18:16.66,Dial-JP,,0,0,0,,なに
Dialogue: 0,0:18:16.66,0:18:18.04,Dial-JP,,0,0,0,,渡ってみせてよ
Dialogue: 0,0:18:22.08,0:18:22.66,Dial-JP,,0,0,0,,あの…
Dialogue: 0,0:18:23.26,0:18:25.67,Dial-JP,,0,0,0,,ホント撮ってごめんなさい　謝るんで
Dialogue: 0,0:18:25.67,0:18:27.60,Dial-JP,,0,0,0,,今そういう話してないよ
Dialogue: 0,0:18:28.32,0:18:30.07,Dial-JP,,0,0,0,,私のを見たんだから
Dialogue: 0,0:18:30.07,0:18:31.90,Dial-JP,,0,0,0,,あんたが渡るのも見せて
Dialogue: 0,0:18:32.09,0:18:33.65,Dial-JP,,0,0,0,,いや　僕には無理
Dialogue: 0,0:18:33.97,0:18:34.72,Dial-JP,,0,0,0,,どうして
Dialogue: 0,0:18:34.72,0:18:36.79,Dial-JP,,0,0,0,,IMPLANTなしじゃ無理でしょ
Dialogue: 0,0:18:37.16,0:18:40.54,Dial-JP,,0,0,0,,IMPLANTなしでも\N生きていけるって言いたいんでしょ
Dialogue: 0,0:18:41.22,0:18:42.50,Dial-JP,,0,0,0,,じゃ　証明してよ
Dialogue: 0,0:18:50.27,0:18:52.49,Dial-JP,,0,0,0,,いたいた　タリア
Dialogue: 0,0:18:52.71,0:18:54.39,Dial-JP,,0,0,0,,スタビライザーの調子はどうだ
Dialogue: 0,0:18:54.65,0:18:56.44,Dial-JP,,0,0,0,,いいよ　問題ない
Dialogue: 0,0:18:56.44,0:18:57.72,Dial-JP,,0,0,0,,メイルストローム
Dialogue: 0,0:18:58.19,0:18:59.28,Dial-JP,,0,0,0,,何だ　そのガキ
Dialogue: 0,0:19:00.89,0:19:02.31,Dial-JP,,0,0,0,,生肉だ　こいつ
Dialogue: 0,0:19:02.31,0:19:04.25,Dial-JP,,0,0,0,,本当だ　全然改造してねえ
Dialogue: 0,0:19:04.52,0:19:06.80,Dial-JP,,0,0,0,,なんかあんたらに興味あるんだって
Dialogue: 0,0:19:08.42,0:19:10.47,Dial-JP,,0,0,0,,いや　そういうんじゃなく…
Dialogue: 0,0:19:10.47,0:19:13.42,Dial-JP,,0,0,0,,お前の気持ちはよく分かった
Dialogue: 0,0:19:13.42,0:19:14.70,Dial-JP,,0,0,0,,歓迎しよう
Dialogue: 0,0:19:15.31,0:19:16.22,Dial-JP,,0,0,0,,歓迎？
Dialogue: 0,0:19:17.65,0:19:19.25,Dial-JP,,0,0,0,,おい　暴れんな
Dialogue: 0,0:19:19.56,0:19:22.31,Dial-JP,,0,0,0,,かっこよくしてやるから安心しろ
Dialogue: 0,0:19:27.84,0:19:29.30,Dial-JP,,0,0,0,,またな　タリア
Dialogue: 0,0:19:31.60,0:19:34.07,Dial-JP,,0,0,0,,うるせえな　こいつ
Dialogue: 0,0:19:51.49,0:19:53.96,Dial-JP,,0,0,0,,いや　若いのにお目が高い
Dialogue: 0,0:19:53.96,0:19:56.47,Dial-JP,,0,0,0,,生身って恥ずかしいもんなあ
Dialogue: 0,0:19:57.91,0:20:00.08,Dial-JP,,0,0,0,,これ使ってみたかったんだよな
Dialogue: 0,0:20:00.57,0:20:01.89,Dial-JP,,0,0,0,,それ　いっちゃう
Dialogue: 0,0:20:02.86,0:20:04.64,Dial-JP,,0,0,0,,だから　うるせえって
Dialogue: 0,0:20:06.47,0:20:07.64,Dial-JP,,0,0,0,,そうだ
Dialogue: 0,0:20:07.64,0:20:09.65,Dial-JP,,0,0,0,,お前麻酔要るか
Dialogue: 0,0:20:10.57,0:20:11.28,Dial-JP,,0,0,0,,要らねえって
Dialogue: 0,0:20:11.60,0:20:12.73,Dial-JP,,0,0,0,,やるなあ
Dialogue: 0,0:20:13.52,0:20:14.27,Dial-JP,,0,0,0,,ガキ？
Dialogue: 0,0:20:25.81,0:20:27.87,Dial-JP,,0,0,0,,クソッ　予定が狂った
Dialogue: 0,0:20:29.08,0:20:30.43,Dial-JP,,0,0,0,,やっぱ　いねえ
Dialogue: 0,0:20:31.20,0:20:32.63,Dial-JP,,0,0,0,,おい　平気か
Dialogue: 0,0:20:41.09,0:20:42.31,Dial-JP,,0,0,0,,同業か
Dialogue: 0,0:20:47.02,0:20:49.31,Dial-JP,,0,0,0,,おい　てめえ　１人で逃げれんな
Dialogue: 0,0:20:49.31,0:20:50.43,Dial-JP,,0,0,0,,二度目はねえぞ
Dialogue: 0,0:20:59.67,0:21:02.61,Dial-JP,,0,0,0,,こいつ知ってるよな　ヘリオってやつだ
Dialogue: 0,0:21:02.61,0:21:04.15,Dial-JP,,0,0,0,,今どこにいるか答えろ
Dialogue: 0,0:21:05.58,0:21:07.01,Dial-JP,,0,0,0,,立場分かってんのか
Dialogue: 0,0:21:07.01,0:21:09.41,Dial-JP,,0,0,0,,ヘ…ヘリオなら　もう抜けた
Dialogue: 0,0:21:10.71,0:21:12.94,Dial-JP,,0,0,0,,どこにいるかって　聞いてんだよ
Dialogue: 0,0:21:15.49,0:21:17.90,Dial-JP,,0,0,0,,わ…分かった　これが住所だ
Dialogue: 0,0:21:19.97,0:21:20.47,Dial-JP,,0,0,0,,よし
Dialogue: 0,0:21:31.90,0:21:32.65,Dial-JP,,0,0,0,,カメラ
Dialogue: 0,0:21:35.34,0:21:36.98,Dial-JP,,0,0,0,,いや　サブで何とか
Dialogue: 0,0:21:39.11,0:21:40.24,Dial-JP,,0,0,0,,お兄さん
Dialogue: 0,0:21:42.18,0:21:44.66,Dial-JP,,0,0,0,,よかった　表から出てきたらどうしようかと
Dialogue: 0,0:21:44.66,0:21:47.03,Dial-JP,,0,0,0,,バカか　お前　俺がいなかったら
Dialogue: 0,0:21:47.03,0:21:50.41,Dial-JP,,0,0,0,,死ぬか　切り刻まれるか　犯されるかの　どれかだぞ
Dialogue: 0,0:21:51.64,0:21:53.08,Dial-JP,,0,0,0,,あ…ありがとうございました
Dialogue: 0,0:21:53.96,0:21:55.52,Dial-JP,,0,0,0,,あ…あの　お礼
Dialogue: 0,0:21:55.52,0:21:56.67,Dial-JP,,0,0,0,,お礼したくて
Dialogue: 0,0:21:57.23,0:21:58.19,Dial-JP,,0,0,0,,礼だあ？
Dialogue: 0,0:21:58.61,0:22:00.50,Dial-JP,,0,0,0,,いや　近くなんですよ　僕んち
Dialogue: 0,0:22:02.85,0:22:03.72,Dial-JP,,0,0,0,,おかわり
Dialogue: 0,0:22:04.75,0:22:06.44,Dial-JP,,0,0,0,,いや　もう…
Dialogue: 0,0:22:07.40,0:22:10.31,Dial-JP,,0,0,0,,飲んじゃいましたよ　うちにあるのぜんぶ
Dialogue: 0,0:22:12.02,0:22:12.95,Dial-JP,,0,0,0,,謝礼は？
Dialogue: 0,0:22:13.25,0:22:13.94,Dial-JP,,0,0,0,,その…
Dialogue: 0,0:22:15.12,0:22:16.66,Dial-JP,,0,0,0,,買ってきます
Dialogue: 0,0:22:30.73,0:22:32.82,Dial-JP,,0,0,0,,夜がまた来る
Dialogue: 0,0:22:34.46,0:22:36.96,Dial-JP,,0,0,0,,父さんに何て言おう
Dialogue: 0,0:22:39.06,0:22:41.72,Dial-JP,,0,0,0,,撮ってもしょうがないか　こんなの
Dialogue: 0,0:22:48.51,0:22:50.67,Dial-JP,,0,0,0,,あいつら　何なんじゃあ
Dialogue: 0,0:22:51.17,0:22:53.91,Dial-JP,,0,0,0,,おう　このままナメられてられるけえ
Dialogue: 0,0:22:53.91,0:22:54.66,Dial-JP,,0,0,0,,行くぞ
Dialogue: 0,0:22:54.66,0:22:58.35,Dial-JP2,,0,0,0,,あいつら　ポリのくせしてナメやがって
Dialogue: 0,0:22:57.69,0:22:58.66,Dial-JP,,0,0,0,,何見てんだ？
Dialogue: 0,0:23:01.34,0:23:03.93,Dial-JP,,0,0,0,,「バースト・パニック　ザ・ビッグクラッシュ」です
Dialogue: 0,0:23:05.87,0:23:06.71,Dial-JP,,0,0,0,,知らねえ
Dialogue: 0,0:23:08.07,0:23:09.09,Dial-JP2,,0,0,0,,おったぞ
Dialogue: 0,0:23:09.09,0:23:10.24,Dial-JP2,,0,0,0,,あいつらじゃ
Dialogue: 0,0:23:09.54,0:23:10.99,Dial-JP,,0,0,0,,そうだよね
Dialogue: 0,0:23:16.11,0:23:18.70,Dial-JP2,,0,0,0,,このドチンピラ　来てみい
Dialogue: 0,0:23:19.78,0:23:22.01,Dial-JP,,0,0,0,,バッドランズか　これ
Dialogue: 0,0:23:22.23,0:23:24.87,Dial-JP,,0,0,0,,うん　ノーマッドの映画だからね
Dialogue: 0,0:23:26.31,0:23:27.77,Dial-JP2,,0,0,0,,うるせえ
Dialogue: 0,0:23:28.28,0:23:30.24,Dial-JP2,,0,0,0,,臆病もんが　ワレーッ
Dialogue: 0,0:23:30.67,0:23:31.86,Dial-JP2,,0,0,0,,何じゃ　あいつは
Dialogue: 0,0:23:33.94,0:23:37.52,Dial-JP2,,0,0,0,,俺は　この辺でナンバーワンのポリだぞ
Dialogue: 0,0:23:37.93,0:23:39.77,Dial-JP2,,0,0,0,,クソがあ
Dialogue: 0,0:23:40.32,0:23:42.03,Dial-JP,,0,0,0,,「レキシントン」をくれ
Dialogue: 0,0:23:43.73,0:23:46.53,Dial-JP,,0,0,0,,俺がレキシントンなんてな
Dialogue: 0,0:23:46.98,0:23:49.51,Dial-JP,,0,0,0,,駆け出しの頃に戻ったみたいだ
Dialogue: 0,0:23:57.27,0:23:58.16,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:24:01.71,0:24:03.71,Dial-JP,,0,0,0,,最後に君に会いたかっ
Dialogue: 0,0:24:06.34,0:24:07.18,Dial-JP,,0,0,0,,アヴィダ？
Dialogue: 0,0:24:21.34,0:24:22.19,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:01:51.09,0:01:53.66,OP-EN,,0,0,0,,10:15 on a Saturday night
Dialogue: 0,0:01:55.48,0:01:59.61,OP-EN,,0,0,0,,And the tap drips under the strip light
Dialogue: 0,0:02:02.33,0:02:04.79,OP-EN,,0,0,0,,And I’m sitting in the kitchen sink
Dialogue: 0,0:02:07.99,0:02:09.15,OP-EN,,0,0,0,,And the tap drips
Dialogue: 0,0:02:09.15,0:02:10.53,OP-EN,,0,0,0,,Drip drip drip drip
Dialogue: 0,0:02:10.53,0:02:12.71,OP-EN,,0,0,0,,Drip drip drip drip drip drip…
Dialogue: 0,0:25:12.32,0:25:15.08,ED-JP,,0,0,0,,Didn’t mean to sound arrogant
Dialogue: 0,0:25:15.08,0:25:19.35,ED-JP,,0,0,0,,Suddenly, we don’t feel the same
Dialogue: 0,0:25:19.35,0:25:22.23,ED-JP,,0,0,0,,All I needed was to get it straight
Dialogue: 0,0:25:22.23,0:25:26.52,ED-JP,,0,0,0,,How I feel isn’t complicated
Dialogue: 0,0:25:26.52,0:25:29.41,ED-JP,,0,0,0,,Everything that I long to be
Dialogue: 0,0:25:29.41,0:25:33.69,ED-JP,,0,0,0,,You and me, there’s more than meets the eye
Dialogue: 0,0:25:33.69,0:25:36.17,ED-JP,,0,0,0,,Everything that I long to be
Dialogue: 0,0:25:36.78,0:25:40.27,ED-JP,,0,0,0,,As in you and
Dialogue: 0,0:25:40.27,0:25:47.37,ED-JP,,0,0,0,,I’m wandering on the city harbor
Dialogue: 0,0:25:47.37,0:25:54.62,ED-JP,,0,0,0,,Now possibly, I will see you in Watson
Dialogue: 0,0:25:54.62,0:25:57.31,ED-JP,,0,0,0,,Run away with me
Dialogue: 0,0:25:57.31,0:26:01.61,ED-JP,,0,0,0,,You’re my West Coast problem
Dialogue: 0,0:26:01.61,0:26:04.32,ED-JP,,0,0,0,,Now, finally
Dialogue: 0,0:26:04.32,0:26:08.98,ED-JP,,0,0,0,,We are goin’ home
Dialogue: 0,0:26:08.98,0:26:13.12,ED-JP,,0,0,0,,Once again, I lose it all
Dialogue: 0,0:26:13.12,0:26:15.86,ED-JP,,0,0,0,,Once again, I lose it
Dialogue: 0,0:26:15.86,0:26:19.42,ED-JP,,0,0,0,,Once again, I lose it
Dialogue: 0,0:26:19.42,0:26:24.57,ED-JP,,0,0,0,,Once again, I lose it all
Dialogue: 0,0:26:24.57,0:26:26.93,ED-JP,,0,0,0,,Begging for this love
Dialogue: 0,0:26:26.93,0:26:31.60,ED-JP,,0,0,0,,Once again, I lose it all
