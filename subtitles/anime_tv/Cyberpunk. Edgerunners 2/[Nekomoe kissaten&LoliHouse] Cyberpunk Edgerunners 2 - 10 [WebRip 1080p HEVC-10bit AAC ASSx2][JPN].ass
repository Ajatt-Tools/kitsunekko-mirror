Dialogue: 0,0:01:33.07,0:01:34.07,Dial-JP,,0,0,0,,クソッ
Dialogue: 0,0:01:34.07,0:01:35.16,Dial-JP,,0,0,0,,やめろ
Dialogue: 0,0:01:35.16,0:01:36.49,Dial-JP,,0,0,0,,やめるんだ　タリア
Dialogue: 0,0:01:36.98,0:01:38.33,Dial-JP,,0,0,0,,まだか　応援は
Dialogue: 0,0:01:38.33,0:01:39.21,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:01:40.57,0:01:42.15,Dial-JP,,0,0,0,,何やってんだよ　タリア
Dialogue: 0,0:01:42.62,0:01:44.48,Dial-JP,,0,0,0,,その人　タリアのお父さんだろ
Dialogue: 0,0:01:45.75,0:01:46.68,Dial-JP,,0,0,0,,あれ
Dialogue: 0,0:01:47.20,0:01:48.80,Dial-JP,,0,0,0,,今日は撮ってないんだ
Dialogue: 0,0:01:49.75,0:01:50.47,Dial-JP,,0,0,0,,タリア？
Dialogue: 0,0:01:50.98,0:01:52.73,Dial-JP,,0,0,0,,いや　待ってよ
Dialogue: 0,0:01:52.73,0:01:55.09,Dial-JP,,0,0,0,,こんなやつ　父さんのわけない
Dialogue: 0,0:01:54.43,0:01:55.56,Dial-JP2,,0,0,0,,タリア
Dialogue: 0,0:01:55.56,0:01:56.83,Dial-JP2,,0,0,0,,私は　お前の…
Dialogue: 0,0:01:56.40,0:01:57.22,Dial-JP,,0,0,0,,黙れよ
Dialogue: 0,0:02:00.48,0:02:02.37,Dial-JP,,0,0,0,,母さんを殺したんだ
Dialogue: 0,0:02:02.68,0:02:04.44,Dial-JP,,0,0,0,,あんなやつ　父さんじゃない
Dialogue: 0,0:02:08.35,0:02:11.24,Dial-JP,,0,0,0,,殺すって約束したからね
Dialogue: 0,0:02:27.05,0:02:27.89,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:02:27.89,0:02:29.25,Dial-JP,,0,0,0,,邪魔だ　このガキ
Dialogue: 0,0:02:29.58,0:02:30.89,Dial-JP,,0,0,0,,目標を捕捉した
Dialogue: 0,0:02:31.11,0:02:33.16,Dial-JP,,0,0,0,,いいな　手足だけを狙え
Dialogue: 0,0:02:33.16,0:02:34.10,Dial-JP,,0,0,0,,殺すんじゃないぞ
Dialogue: 0,0:02:44.25,0:02:45.77,Dial-JP,,0,0,0,,今のうちに早く確保しろ
Dialogue: 0,0:03:08.21,0:03:10.30,Dial-JP,,0,0,0,,おい　早く車を出せ
Dialogue: 0,0:03:10.30,0:03:11.88,Dial-JP,,0,0,0,,はあ　いや　しかし
Dialogue: 0,0:03:11.88,0:03:13.97,Dial-JP,,0,0,0,,あいつは　私を狙ってるんだ
Dialogue: 0,0:03:22.17,0:03:23.11,Dial-JP,,0,0,0,,{\fscx100\fscy100}応援を呼べ
Dialogue: 0,0:03:23.11,0:03:24.04,Dial-JP,,0,0,0,,現状を報告しろ
Dialogue: 0,0:03:24.87,0:03:27.18,Dial-JP,,0,0,0,,とにかく　早くここから離れてくれ
Dialogue: 0,0:03:27.40,0:03:28.48,Dial-JP,,0,0,0,,どこでもいい
Dialogue: 0,0:03:34.66,0:03:35.44,Dial-JP,,0,0,0,,お前
Dialogue: 0,0:03:37.27,0:03:38.17,Dial-JP,,0,0,0,,カプリか
Dialogue: 0,0:03:38.78,0:03:39.47,Dial-JP,,0,0,0,,Ｄ
Dialogue: 0,0:03:45.25,0:03:47.19,Dial-JP,,0,0,0,,あいつ　生きてたのか
Dialogue: 0,0:03:51.10,0:03:52.00,Dial-JP,,0,0,0,,うるさい
Dialogue: 0,0:03:57.12,0:04:00.01,Dial-JP,,0,0,0,,うるさい　うるさい　クソッ
Dialogue: 0,0:04:07.86,0:04:10.06,Dial-JP,,0,0,0,,Ｄ　Ｄ　ちょっと
Dialogue: 0,0:04:28.46,0:04:29.31,Dial-JP,,0,0,0,,イッテ
Dialogue: 0,0:04:29.31,0:04:31.46,Dial-JP,,0,0,0,,あんた　一体何やってんだ
Dialogue: 0,0:04:31.92,0:04:34.63,Dial-JP,,0,0,0,,イッテーな　やめろよオミ
Dialogue: 0,0:04:34.82,0:04:38.04,Dial-JP,,0,0,0,,ああ　お前　ロマン
Dialogue: 0,0:04:38.81,0:04:40.85,Dial-JP,,0,0,0,,お前　なんでここにいるんだ
Dialogue: 0,0:04:46.71,0:04:48.38,Dial-JP,,0,0,0,,ああそうか　思い出した
Dialogue: 0,0:04:48.92,0:04:50.37,Dial-JP,,0,0,0,,あいつ　お前の恋人か
Dialogue: 0,0:04:50.98,0:04:52.89,Dial-JP,,0,0,0,,恋人じゃないよ
Dialogue: 0,0:04:53.26,0:04:56.02,Dial-JP,,0,0,0,,なんで　あいつの中にまたカプリが入ってんだ
Dialogue: 0,0:04:56.16,0:04:57.36,Dial-JP2,,0,0,0,,私が入れた
Dialogue: 0,0:04:58.92,0:04:59.95,Dial-JP2,,0,0,0,,私だ
Dialogue: 0,0:04:56.31,0:04:57.97,Dial-JP,,0,0,0,,Ｄが挿したんじゃないの
Dialogue: 0,0:04:57.97,0:05:00.14,Dial-JP,,0,0,0,,俺がやるかよ
Dialogue: 0,0:05:00.14,0:05:02.04,Dial-JP,,0,0,0,,じゃあ　なんでタリアの中にカプリが
Dialogue: 0,0:05:02.34,0:05:03.50,Dial-JP,,0,0,0,,私だって
Dialogue: 0,0:05:03.50,0:05:05.13,Dial-JP,,0,0,0,,何だ このステレオ
Dialogue: 0,0:05:05.13,0:05:06.03,Dial-JP,,0,0,0,,おい 待て
Dialogue: 0,0:05:06.03,0:05:07.33,Dial-JP,,0,0,0,,話　聞けって
Dialogue: 0,0:05:07.78,0:05:09.29,Dial-JP,,0,0,0,,私がタリアに挿した
Dialogue: 0,0:05:09.56,0:05:11.25,Dial-JP,,0,0,0,,君も確保したかったが…
Dialogue: 0,0:05:11.82,0:05:13.65,Dial-JP,,0,0,0,,まさか　生きてるとはね
Dialogue: 0,0:05:14.55,0:05:15.59,Dial-JP,,0,0,0,,キョウコ
Dialogue: 0,0:05:16.79,0:05:17.71,Dial-JP,,0,0,0,,ロマン
Dialogue: 0,0:05:17.71,0:05:19.30,Dial-JP,,0,0,0,,やっぱり　そこにいたのか
Dialogue: 0,0:05:19.56,0:05:20.88,Dial-JP,,0,0,0,,キョウコが　入れたの
Dialogue: 0,0:05:20.88,0:05:21.31,Dial-JP,,0,0,0,,ちょ
Dialogue: 0,0:05:21.31,0:05:23.85,Dial-JP,,0,0,0,,お前　あんときの小さい女か
Dialogue: 0,0:05:24.36,0:05:25.45,Dial-JP,,0,0,0,,何が目的だ
Dialogue: 0,0:05:26.10,0:05:28.59,Dial-JP,,0,0,0,,残ってるんでしょ　君の中に
Dialogue: 0,0:05:28.84,0:05:29.48,Dial-JP,,0,0,0,,何を
Dialogue: 0,0:05:29.70,0:05:31.23,Dial-JP,,0,0,0,,それしだいなんだよ
Dialogue: 0,0:05:32.01,0:05:33.61,Dial-JP,,0,0,0,,君の中に残ってるの
Dialogue: 0,0:05:33.61,0:05:36.06,Dial-JP,,0,0,0,,彼女　カプリは
Dialogue: 0,0:05:37.93,0:05:39.89,Dial-JP,,0,0,0,,ああ　少しだけな
Dialogue: 0,0:05:40.28,0:05:41.76,Dial-JP,,0,0,0,,でも本当に少しだ
Dialogue: 0,0:05:42.07,0:05:43.06,Dial-JP,,0,0,0,,あんた
Dialogue: 0,0:05:43.06,0:05:45.13,Dial-JP,,0,0,0,,カプリコーンを使って　どうするつもり
Dialogue: 0,0:05:45.49,0:05:46.31,Dial-JP,,0,0,0,,使う？
Dialogue: 0,0:05:46.31,0:05:48.38,Dial-JP,,0,0,0,,そう　チップを手に入れて
Dialogue: 0,0:05:48.38,0:05:49.45,Dial-JP,,0,0,0,,使うかよ
Dialogue: 0,0:05:49.80,0:05:51.75,Dial-JP,,0,0,0,,俺はカプリに会いたいだけだ
Dialogue: 0,0:05:51.97,0:05:52.75,Dial-JP,,0,0,0,,はあ
Dialogue: 0,0:05:53.91,0:05:55.50,Dial-JP,,0,0,0,,そのあとなんて　知らねえ
Dialogue: 0,0:06:00.02,0:06:02.38,Dial-JP,,0,0,0,,いや　割とすごいねえ
Dialogue: 0,0:06:02.38,0:06:04.89,Dial-JP,,0,0,0,,事情抜きで話したかったかも
Dialogue: 0,0:06:06.73,0:06:09.34,Dial-JP,,0,0,0,,いいよ　君に協力しよう
Dialogue: 0,0:06:09.58,0:06:11.89,Dial-JP,,0,0,0,,もう次があるかなんて　分からないし
Dialogue: 0,0:06:13.77,0:06:15.72,Dial-JP,,0,0,0,,偉そうで気に入らねえ
Dialogue: 0,0:06:16.35,0:06:19.38,Dial-JP,,0,0,0,,だけど　俺だけじゃどうしようもないのも　事実だ
Dialogue: 0,0:06:19.38,0:06:20.49,Dial-JP,,0,0,0,,なんだ
Dialogue: 0,0:06:20.49,0:06:22.65,Dial-JP,,0,0,0,,思ったより　聞き分けいいじゃん
Dialogue: 0,0:06:25.96,0:06:27.86,Dial-JP,,0,0,0,,なんで お前も笑ってんだよ
Dialogue: 0,0:06:27.86,0:06:29.54,Dial-JP,,0,0,0,,いや　分かんないけど
Dialogue: 0,0:06:29.91,0:06:32.77,Dial-JP,,0,0,0,,あんた　とにかく本気なんだなって思って
Dialogue: 0,0:06:32.77,0:06:34.71,Dial-JP,,0,0,0,,どういう意味だよ　おい
Dialogue: 0,0:06:36.74,0:06:37.87,Dial-JP,,0,0,0,,お前なあ
Dialogue: 0,0:06:38.58,0:06:40.30,Dial-JP,,0,0,0,,ごめん　ほんとごめん
Dialogue: 0,0:06:42.32,0:06:43.30,Dial-JP,,0,0,0,,ねえ　Ｄ
Dialogue: 0,0:06:43.60,0:06:45.16,Dial-JP,,0,0,0,,もう復讐しないの
Dialogue: 0,0:06:47.14,0:06:47.89,Dial-JP,,0,0,0,,しねえよ
Dialogue: 0,0:07:04.38,0:07:06.00,Dial-JP,,0,0,0,,申し訳ありません
Dialogue: 0,0:07:06.00,0:07:09.07,Dial-JP,,0,0,0,,捕獲は　もう無理です　早く…
Dialogue: 0,0:07:10.67,0:07:11.33,Dial-JP,,0,0,0,,クソッ
Dialogue: 0,0:07:11.33,0:07:12.07,Dial-JP,,0,0,0,,やめろ
Dialogue: 0,0:07:12.07,0:07:13.02,Dial-JP,,0,0,0,,近づくな
Dialogue: 0,0:07:20.51,0:07:22.84,Dial-JP,,0,0,0,,やめろ　タリア
Dialogue: 0,0:07:29.56,0:07:30.58,Dial-JP,,0,0,0,,やめるんだ
Dialogue: 0,0:07:36.18,0:07:37.85,Dial-JP,,0,0,0,,君は殺しちゃいけない
Dialogue: 0,0:07:40.16,0:07:41.73,Dial-JP,,0,0,0,,そいつは　俺がやる
Dialogue: 0,0:07:41.93,0:07:43.59,Dial-JP,,0,0,0,,アヴィダの仇だ
Dialogue: 0,0:07:46.99,0:07:48.58,Dial-JP,,0,0,0,,クソッ　なんで
Dialogue: 0,0:07:51.69,0:07:53.38,Dial-JP,,0,0,0,,邪魔しないでよ
Dialogue: 0,0:08:02.71,0:08:04.05,Dial-JP,,0,0,0,,あいつを殺せ
Dialogue: 0,0:08:04.74,0:08:07.51,Dial-JP,,0,0,0,,しかし捕獲するようにと　命令されています
Dialogue: 0,0:08:07.75,0:08:09.36,Dial-JP,,0,0,0,,何だ　あのデカさは
Dialogue: 0,0:08:09.72,0:08:10.51,Dial-JP,,0,0,0,,聞いてないぞ
Dialogue: 0,0:08:10.51,0:08:12.26,Dial-JP,,0,0,0,,いいから殺せー
Dialogue: 0,0:08:18.42,0:08:19.48,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:08:23.17,0:08:24.08,Dial-JP,,0,0,0,,まだ
Dialogue: 0,0:08:25.96,0:08:27.77,Dial-JP,,0,0,0,,まだ　大丈夫だ
Dialogue: 0,0:08:31.97,0:08:33.12,Dial-JP,,0,0,0,,言っただろ
Dialogue: 0,0:08:33.94,0:08:35.49,Dial-JP,,0,0,0,,俺が止めるって
Dialogue: 0,0:08:37.00,0:08:37.98,Dial-JP,,0,0,0,,まだだ
Dialogue: 0,0:08:38.75,0:08:40.05,Dial-JP,,0,0,0,,まだ　間に合う
Dialogue: 0,0:08:52.59,0:08:53.58,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:09:33.04,0:09:34.60,Dial-JP,,0,0,0,,何やってんだよ
Dialogue: 0,0:09:35.43,0:09:37.33,Dial-JP,,0,0,0,,オミ　この先　右
Dialogue: 0,0:09:37.83,0:09:38.82,Dial-JP,,0,0,0,,場所　分かるの
Dialogue: 0,0:09:39.55,0:09:40.56,Dial-JP,,0,0,0,,何となくな
Dialogue: 0,0:09:42.85,0:09:43.98,Dial-JP,,0,0,0,,ダメだ
Dialogue: 0,0:09:43.98,0:09:46.40,Dial-JP,,0,0,0,,違う　私じゃない
Dialogue: 0,0:09:46.64,0:09:48.05,Dial-JP,,0,0,0,,なぜだ　タリア
Dialogue: 0,0:09:48.88,0:09:51.68,Dial-JP,,0,0,0,,確かに　捕獲は難しいかもしれんな
Dialogue: 0,0:09:51.68,0:09:52.99,Dial-JP,,0,0,0,,そうだな
Dialogue: 0,0:09:52.99,0:09:55.70,Dial-JP,,0,0,0,,他の企業に　気づかれる前に始末しよう
Dialogue: 0,0:09:56.09,0:09:57.56,Dial-JP,,0,0,0,,回収は　そのあとで
Dialogue: 0,0:09:57.56,0:09:58.96,Dial-JP,,0,0,0,,しかし　どうやる
Dialogue: 0,0:09:59.29,0:10:01.17,Dial-JP,,0,0,0,,てっとり早いのは爆撃だな
Dialogue: 0,0:10:01.53,0:10:03.05,Dial-JP,,0,0,0,,Night Cityでか
Dialogue: 0,0:10:07.69,0:10:10.70,Dial-JP,,0,0,0,,分かりました　では南に誘導します
Dialogue: 0,0:10:11.74,0:10:13.48,Dial-JP,,0,0,0,,クソッ　マズいな
Dialogue: 0,0:10:13.48,0:10:14.52,Dial-JP,,0,0,0,,爆撃
Dialogue: 0,0:10:14.74,0:10:17.30,Dial-JP,,0,0,0,,おい　一体どこに向かってるんだ？
Dialogue: 0,0:10:17.80,0:10:19.90,Dial-JP,,0,0,0,,南　バッドランズ
Dialogue: 0,0:10:21.60,0:10:22.79,Dial-JP,,0,0,0,,爆撃か
Dialogue: 0,0:10:36.82,0:10:37.79,Dial-JP,,0,0,0,,アヴィダ
Dialogue: 0,0:10:49.42,0:10:50.13,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:10:50.92,0:10:51.63,Dial-JP,,0,0,0,,このっ
Dialogue: 0,0:11:16.10,0:11:16.85,Dial-JP,,0,0,0,,キョウコ？
Dialogue: 0,0:11:17.41,0:11:18.38,Dial-JP,,0,0,0,,あいつは
Dialogue: 0,0:11:18.38,0:11:19.67,Dial-JP,,0,0,0,,今　どうなってんの
Dialogue: 0,0:11:19.88,0:11:21.01,Dial-JP,,0,0,0,,カンタオのやつら
Dialogue: 0,0:11:21.01,0:11:22.78,Dial-JP,,0,0,0,,カプリを　爆撃しようとしてる
Dialogue: 0,0:11:22.78,0:11:23.29,Dial-JP,,0,0,0,,え
Dialogue: 0,0:11:23.62,0:11:25.47,Dial-JP,,0,0,0,,タリアは　どうなるんだよ
Dialogue: 0,0:11:25.47,0:11:27.87,Dial-JP,,0,0,0,,落ち着け　まだ時間はある
Dialogue: 0,0:11:27.87,0:11:28.81,Dial-JP,,0,0,0,,あいつは
Dialogue: 0,0:11:28.81,0:11:29.60,Dial-JP,,0,0,0,,何
Dialogue: 0,0:11:29.60,0:11:30.59,Dial-JP,,0,0,0,,Ｄだよ
Dialogue: 0,0:11:30.59,0:11:31.71,Dial-JP,,0,0,0,,遅いよ
Dialogue: 0,0:11:31.71,0:11:32.96,Dial-JP,,0,0,0,,さっき出てった
Dialogue: 0,0:11:32.96,0:11:33.96,Dial-JP,,0,0,0,,はあ
Dialogue: 0,0:11:34.19,0:11:36.47,Dial-JP,,0,0,0,,待ってらんないって　出ていっちゃったよ
Dialogue: 0,0:11:37.78,0:11:38.47,Dial-JP,,0,0,0,,いいか　ロマン
Dialogue: 0,0:11:38.83,0:11:41.65,Dial-JP,,0,0,0,,私がそっちに着くまでに　Ｄを連れ戻せ
Dialogue: 0,0:11:41.65,0:11:42.95,Dial-JP,,0,0,0,,ちょっと待ってよ
Dialogue: 0,0:11:43.26,0:11:47.15,Dial-JP,,0,0,0,,今から　CPRN XW1を持っていく
Dialogue: 0,0:11:47.15,0:11:47.97,Dial-JP,,0,0,0,,何それ
Dialogue: 0,0:11:48.41,0:11:50.80,Dial-JP,,0,0,0,,デカいEMPと　思ってくれればいい
Dialogue: 0,0:11:50.80,0:11:52.27,Dial-JP,,0,0,0,,とにかく　起動すれば
Dialogue: 0,0:11:52.27,0:11:53.76,Dial-JP,,0,0,0,,半径２キロくらいの　電子機器は
Dialogue: 0,0:11:53.76,0:11:55.15,Dial-JP,,0,0,0,,全てダウンさせられる
Dialogue: 0,0:11:55.48,0:11:57.46,Dial-JP,,0,0,0,,これなら　カプリも貫通できる
Dialogue: 0,0:11:57.71,0:11:58.99,Dial-JP,,0,0,0,,これを発動する
Dialogue: 0,0:11:59.29,0:12:02.51,Dial-JP,,0,0,0,,その間　あんたたちは\Nカプリから離れている必要がある
Dialogue: 0,0:12:02.81,0:12:04.37,Dial-JP,,0,0,0,,私が　そっちに着くまでに
Dialogue: 0,0:12:04.37,0:12:07.75,Dial-JP,,0,0,0,,何とかＤに取り次いで　そこから離れろ　いいな
Dialogue: 0,0:12:14.22,0:12:16.02,Dial-JP,,0,0,0,,しっかりしろよ　カプリ
Dialogue: 0,0:12:16.34,0:12:17.86,Dial-JP,,0,0,0,,いるんだろ　そこに
Dialogue: 0,0:12:28.64,0:12:29.52,Dial-JP,,0,0,0,,クソッ
Dialogue: 0,0:12:30.05,0:12:31.38,Dial-JP,,0,0,0,,邪魔するな
Dialogue: 0,0:12:32.17,0:12:33.72,Dial-JP,,0,0,0,,どうしたんだ　一体
Dialogue: 0,0:12:33.72,0:12:35.79,Dial-JP,,0,0,0,,いつまで攻撃を続けている
Dialogue: 0,0:12:35.79,0:12:36.90,Dial-JP,,0,0,0,,タダじゃないんだぞ
Dialogue: 0,0:12:37.30,0:12:39.12,Dial-JP,,0,0,0,,通信が阻害されています
Dialogue: 0,0:12:39.31,0:12:41.39,Dial-JP,,0,0,0,,カプリコーンの影響と思われます
Dialogue: 0,0:12:44.18,0:12:47.21,Dial-JP,,0,0,0,,なぜ　なぜだ　タリア
Dialogue: 0,0:12:47.89,0:12:50.10,Dial-JP,,0,0,0,,あんなに　いい子だったじゃないか
Dialogue: 0,0:12:50.33,0:12:51.87,Dial-JP,,0,0,0,,なるはずだった
Dialogue: 0,0:12:52.20,0:12:56.55,Dial-JP,,0,0,0,,すばらしい存在に　私を助けてくれる
Dialogue: 0,0:12:57.08,0:12:58.40,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:12:59.19,0:13:00.90,Dial-JP,,0,0,0,,いい子だ　タリア
Dialogue: 0,0:13:04.61,0:13:06.06,Dial-JP,,0,0,0,,いい子だ
Dialogue: 0,0:13:06.06,0:13:06.81,Dial-JP,,0,0,0,,うるさい
Dialogue: 0,0:13:13.86,0:13:14.53,Dial-JP,,0,0,0,,何だ
Dialogue: 0,0:13:21.60,0:13:23.24,Dial-JP,,0,0,0,,ダメだ　つながらない
Dialogue: 0,0:13:23.24,0:13:24.88,Dial-JP,,0,0,0,,これ以上　近づけないの
Dialogue: 0,0:13:24.88,0:13:26.49,Dial-JP,,0,0,0,,無理だ　危険すぎる
Dialogue: 0,0:13:31.30,0:13:31.99,Dial-JP,,0,0,0,,キョウコ
Dialogue: 0,0:13:32.36,0:13:33.40,Dial-JP,,0,0,0,,いないじゃん
Dialogue: 0,0:13:33.40,0:13:34.14,Dial-JP,,0,0,0,,無理だよ
Dialogue: 0,0:13:34.14,0:13:35.00,Dial-JP,,0,0,0,,あれ見てよ
Dialogue: 0,0:13:36.28,0:13:38.13,Dial-JP,,0,0,0,,無事なんだろうな　あいつは
Dialogue: 0,0:13:39.58,0:13:41.02,Dial-JP,,0,0,0,,分かんないよ
Dialogue: 0,0:13:46.63,0:13:48.45,Dial-JP,,0,0,0,,らしくないじゃんか
Dialogue: 0,0:13:49.20,0:13:50.04,Dial-JP,,0,0,0,,カプリ
Dialogue: 0,0:13:55.46,0:13:56.78,Dial-JP,,0,0,0,,おい　どうする
Dialogue: 0,0:13:57.04,0:13:58.69,Dial-JP,,0,0,0,,これでは　もう隠蔽は無理だ
Dialogue: 0,0:13:58.69,0:13:59.94,Dial-JP,,0,0,0,,分かっている
Dialogue: 0,0:13:59.94,0:14:02.55,Dial-JP,,0,0,0,,そろそろミリテク　アラサカも感づくぞ
Dialogue: 0,0:14:03.07,0:14:04.66,Dial-JP,,0,0,0,,やむを得んか
Dialogue: 0,0:14:06.82,0:14:08.35,Dial-JP,,0,0,0,,キョウコ　どうしたの
Dialogue: 0,0:14:08.91,0:14:10.30,Dial-JP,,0,0,0,,今　発射しました
Dialogue: 0,0:14:10.60,0:14:12.04,Dial-JP,,0,0,0,,着弾まで　あと３分
Dialogue: 0,0:14:14.74,0:14:16.07,Dial-JP,,0,0,0,,マジいな
Dialogue: 0,0:14:16.07,0:14:19.23,Dial-JP,,0,0,0,,あいつら撃ちやがった　もう爆撃が来る
Dialogue: 0,0:14:19.96,0:14:22.46,Dial-JP,,0,0,0,,いいか　合図したらブレーキかけろ
Dialogue: 0,0:14:22.80,0:14:24.27,Dial-JP,,0,0,0,,ギリギリのところで
Dialogue: 0,0:14:24.27,0:14:25.80,Dial-JP,,0,0,0,,こいつを起動してやる
Dialogue: 0,0:14:25.98,0:14:26.88,Dial-JP,,0,0,0,,でも
Dialogue: 0,0:14:26.88,0:14:29.13,Dial-JP,,0,0,0,,Ｄは　あの中のどっかに必ずいる
Dialogue: 0,0:14:29.13,0:14:30.56,Dial-JP,,0,0,0,,あれが崩れたら
Dialogue: 0,0:14:30.56,0:14:32.88,Dial-JP,,0,0,0,,すぐ戻ってきて　Ｄを　たたき起こせ
Dialogue: 0,0:14:32.88,0:14:34.37,Dial-JP,,0,0,0,,そんなムチャな
Dialogue: 0,0:14:34.37,0:14:35.81,Dial-JP,,0,0,0,,それしかないだろ
Dialogue: 0,0:14:35.81,0:14:36.79,Dial-JP,,0,0,0,,ブレーキ
Dialogue: 0,0:14:37.02,0:14:39.00,Dial-JP,,0,0,0,,キョウコは　どうすんだよ
Dialogue: 0,0:14:44.67,0:14:46.24,Dial-JP,,0,0,0,,マジいな
Dialogue: 0,0:14:46.24,0:14:48.36,Dial-JP,,0,0,0,,マジのイチかバチかに　なっちまった
Dialogue: 0,0:14:48.64,0:14:51.50,Dial-JP,,0,0,0,,こんなはずじゃあ　なかったのにさ
Dialogue: 0,0:16:16.19,0:16:18.58,Dial-JP,,0,0,0,,ねえ　Ｄ　起きてよ
Dialogue: 0,0:16:23.42,0:16:24.87,Dial-JP,,0,0,0,,起きてよ　Ｄ
Dialogue: 0,0:16:26.20,0:16:27.22,Dial-JP,,0,0,0,,ロマン
Dialogue: 0,0:16:31.98,0:16:33.56,Dial-JP,,0,0,0,,いい子だ　タリア
Dialogue: 0,0:16:33.56,0:16:36.67,Dial-JP,,0,0,0,,また立てるようになったのか　すごいぞ
Dialogue: 0,0:16:37.02,0:16:39.25,Dial-JP,,0,0,0,,さあ　これに替えるんだ
Dialogue: 0,0:16:39.25,0:16:40.73,Dial-JP,,0,0,0,,我が社の製品だ
Dialogue: 0,0:16:41.71,0:16:43.00,Dial-JP,,0,0,0,,君のためだ
Dialogue: 0,0:16:43.84,0:16:46.51,Dial-JP,,0,0,0,,タリア　君の
Dialogue: 0,0:16:49.41,0:16:51.88,Dial-JP,,0,0,0,,らしくないぜ　カプリ
Dialogue: 0,0:16:53.74,0:16:55.15,Dial-JP,,0,0,0,,まるで　俺みたいだ
Dialogue: 0,0:16:56.64,0:16:58.12,Dial-JP,,0,0,0,,何だよ　お前
Dialogue: 0,0:16:59.44,0:17:00.84,Dial-JP,,0,0,0,,お前に用はねえ
Dialogue: 0,0:17:01.31,0:17:03.80,Dial-JP,,0,0,0,,こっちの質問に答えろよ
Dialogue: 0,0:17:06.43,0:17:08.49,Dial-JP,,0,0,0,,まあ　そうだよな
Dialogue: 0,0:17:16.82,0:17:18.30,Dial-JP,,0,0,0,,ずるだろ　それ
Dialogue: 0,0:17:23.75,0:17:25.07,Dial-JP,,0,0,0,,まあ　落ち着けって
Dialogue: 0,0:17:34.76,0:17:35.60,Dial-JP,,0,0,0,,俺はさあ
Dialogue: 0,0:17:36.38,0:17:37.92,Dial-JP,,0,0,0,,お前に会いにきたんだぜ
Dialogue: 0,0:17:38.20,0:17:38.89,Dial-JP,,0,0,0,,カプリ
Dialogue: 0,0:17:47.84,0:17:48.46,Dial-JP,,0,0,0,,Ｄ
Dialogue: 0,0:17:49.84,0:17:51.00,Dial-JP,,0,0,0,,おい　おい
Dialogue: 0,0:17:51.67,0:17:52.33,Dial-JP,,0,0,0,,カプリ
Dialogue: 0,0:17:53.51,0:17:55.14,Dial-JP,,0,0,0,,おい　カプリ
Dialogue: 0,0:18:00.71,0:18:02.64,Dial-JP,,0,0,0,,バカやってんじゃねえよ
Dialogue: 0,0:18:03.22,0:18:05.17,Dial-JP,,0,0,0,,あいつの感情に　のまれやがって
Dialogue: 0,0:18:07.89,0:18:10.52,Dial-JP,,0,0,0,,なんだ　君か　久しぶり
Dialogue: 0,0:18:10.96,0:18:11.90,Dial-JP,,0,0,0,,久しぶり
Dialogue: 0,0:18:17.13,0:18:20.07,Dial-JP,,0,0,0,,なに　次は君
Dialogue: 0,0:18:20.27,0:18:21.41,Dial-JP,,0,0,0,,今度はさ
Dialogue: 0,0:18:21.87,0:18:23.57,Dial-JP,,0,0,0,,あんなことには　ならねえから
Dialogue: 0,0:18:24.60,0:18:26.90,Dial-JP,,0,0,0,,楽しくやろうぜ　俺と
Dialogue: 0,0:18:28.09,0:18:28.78,Dial-JP,,0,0,0,,カプリ
Dialogue: 0,0:18:36.64,0:18:37.23,Dial-JP,,0,0,0,,Ｄ
Dialogue: 0,0:18:38.55,0:18:39.92,Dial-JP,,0,0,0,,ああ　ロマン
Dialogue: 0,0:18:40.83,0:18:42.06,Dial-JP,,0,0,0,,こいつ頼むわ
Dialogue: 0,0:18:42.21,0:18:43.03,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:18:44.59,0:18:46.21,Dial-JP,,0,0,0,,大丈夫かよ　お前
Dialogue: 0,0:18:46.51,0:18:48.17,Dial-JP,,0,0,0,,大丈…夫
Dialogue: 0,0:18:50.70,0:18:51.74,Dial-JP,,0,0,0,,しょっと
Dialogue: 0,0:18:55.42,0:18:56.59,Dial-JP,,0,0,0,,イッテテ
Dialogue: 0,0:18:57.90,0:18:59.08,Dial-JP,,0,0,0,,何だ　これ
Dialogue: 0,0:18:59.08,0:19:01.64,Dial-JP,,0,0,0,,いろいろとボロボロだったからね
Dialogue: 0,0:19:01.64,0:19:03.33,Dial-JP,,0,0,0,,補強だよ　補強
Dialogue: 0,0:19:03.79,0:19:05.16,Dial-JP,,0,0,0,,カッコわり
Dialogue: 0,0:19:05.16,0:19:06.33,Dial-JP,,0,0,0,,しゃーないでしょ
Dialogue: 0,0:19:06.72,0:19:08.57,Dial-JP,,0,0,0,,にしたって　もうちょいあんだろ
Dialogue: 0,0:19:08.84,0:19:10.93,Dial-JP,,0,0,0,,これあいつの腕じゃん　使えんの
Dialogue: 0,0:19:29.63,0:19:31.95,Dial-JP,,0,0,0,,ぼやぼやしてる暇はないよ
Dialogue: 0,0:19:32.53,0:19:35.55,Dial-JP,,0,0,0,,コーポのやつらが　また来る
Dialogue: 0,0:19:37.95,0:19:39.34,Dial-JP,,0,0,0,,お前　いたのか
Dialogue: 0,0:19:39.88,0:19:42.77,Dial-JP,,0,0,0,,次に来るのは　並の部隊じゃないよ
Dialogue: 0,0:19:43.41,0:19:47.69,Dial-JP,,0,0,0,,アラサカやミリテクも交ざって　あんたの取り合いさ
Dialogue: 0,0:19:48.89,0:19:49.82,Dial-JP,,0,0,0,,いいさ
Dialogue: 0,0:19:50.88,0:19:51.71,Dial-JP,,0,0,0,,見てくか
Dialogue: 0,0:19:58.58,0:19:59.61,Dial-JP,,0,0,0,,死んだ
Dialogue: 0,0:20:00.89,0:20:01.67,Dial-JP,,0,0,0,,さあな
Dialogue: 0,0:20:08.26,0:20:09.22,Dial-JP,,0,0,0,,ねえ　Ｄ
Dialogue: 0,0:20:09.75,0:20:11.39,Dial-JP,,0,0,0,,カプリには会えたの
Dialogue: 0,0:20:12.01,0:20:12.81,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:20:15.28,0:20:16.49,Dial-JP,,0,0,0,,これからさあ
Dialogue: 0,0:20:17.22,0:20:19.72,Dial-JP,,0,0,0,,クライマックスでしょ　Ｄの
Dialogue: 0,0:20:21.93,0:20:23.16,Dial-JP,,0,0,0,,僕も　ついてく
Dialogue: 0,0:20:24.27,0:20:26.42,Dial-JP,,0,0,0,,撮り逃せないよ　Ｄの…
Dialogue: 0,0:20:26.42,0:20:28.00,Dial-JP,,0,0,0,,あのなあ　ロマン
Dialogue: 0,0:20:28.00,0:20:30.24,Dial-JP,,0,0,0,,僕が撮らなきゃ誰が撮るのさ
Dialogue: 0,0:20:30.72,0:20:32.64,Dial-JP,,0,0,0,,俺が代わりに撮っててやるよ
Dialogue: 0,0:20:32.99,0:20:34.32,Dial-JP,,0,0,0,,見てたから分かるぜ
Dialogue: 0,0:20:35.18,0:20:36.95,Dial-JP,,0,0,0,,ほら　こうするんだろ
Dialogue: 0,0:20:42.71,0:20:43.73,Dial-JP,,0,0,0,,ダメだよ
Dialogue: 0,0:20:55.50,0:20:57.23,Dial-JP,,0,0,0,,死ぬつもりなんだろ
Dialogue: 0,0:20:57.48,0:20:58.75,Dial-JP,,0,0,0,,そうなんだろ
Dialogue: 0,0:20:59.48,0:21:02.41,Dial-JP,,0,0,0,,ロマン　クライマックスなんて　また来る
Dialogue: 0,0:21:03.25,0:21:04.30,Dial-JP,,0,0,0,,知るかよ
Dialogue: 0,0:21:05.16,0:21:06.93,Dial-JP,,0,0,0,,これは俺のクライマックスだ
Dialogue: 0,0:21:07.34,0:21:08.38,Dial-JP,,0,0,0,,お前のじゃない
Dialogue: 0,0:21:08.72,0:21:09.97,Dial-JP,,0,0,0,,知るかよ
Dialogue: 0,0:21:10.88,0:21:13.04,Dial-JP,,0,0,0,,お前のは　ここじゃない
Dialogue: 0,0:21:15.48,0:21:16.68,Dial-JP,,0,0,0,,知るかよ
Dialogue: 0,0:21:16.68,0:21:17.55,Dial-JP,,0,0,0,,僕も
Dialogue: 0,0:21:17.55,0:21:18.35,Dial-JP,,0,0,0,,ロマン
Dialogue: 0,0:21:23.53,0:21:24.39,Dial-JP,,0,0,0,,ごめんな
Dialogue: 0,0:21:35.60,0:21:36.81,Dial-JP,,0,0,0,,ロマンのこと頼む
Dialogue: 0,0:21:37.50,0:21:38.47,Dial-JP,,0,0,0,,その子もな
Dialogue: 0,0:21:40.95,0:21:41.73,Dial-JP,,0,0,0,,行くの
Dialogue: 0,0:21:42.57,0:21:43.13,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:21:45.13,0:21:46.00,Dial-JP,,0,0,0,,デイビッド
Dialogue: 0,0:21:47.68,0:21:48.54,Dial-JP,,0,0,0,,あんたさ
Dialogue: 0,0:21:49.54,0:21:50.78,Dial-JP,,0,0,0,,すげーバカ
Dialogue: 0,0:21:52.61,0:21:53.20,Dial-JP,,0,0,0,,ヘヘッ
Dialogue: 0,0:21:59.17,0:22:00.22,Dial-JP,,0,0,0,,なあ　カプリ
Dialogue: 0,0:22:02.11,0:22:05.55,Dial-JP,,0,0,0,,昔な　俺と同じ名前のやつがいたんだ
Dialogue: 0,0:22:06.06,0:22:06.74,Dial-JP,,0,0,0,,ほう
Dialogue: 0,0:22:07.23,0:22:08.91,Dial-JP,,0,0,0,,そいつには仲間がいてさ
Dialogue: 0,0:22:09.48,0:22:12.74,Dial-JP,,0,0,0,,そいつは仲間のために　犠牲になって死んでった
Dialogue: 0,0:22:13.65,0:22:15.18,Dial-JP,,0,0,0,,そういうふうに　見えたんだ
Dialogue: 0,0:22:17.02,0:22:18.78,Dial-JP,,0,0,0,,俺には　できなかったことだ
Dialogue: 0,0:22:20.16,0:22:23.05,Dial-JP,,0,0,0,,あいつ　どんな気持ちだったのかな
Dialogue: 0,0:22:24.19,0:22:26.55,Dial-JP,,0,0,0,,分かんね　なんで
Dialogue: 0,0:22:27.78,0:22:30.12,Dial-JP,,0,0,0,,なんで　そんな話したの　今
Dialogue: 0,0:22:31.07,0:22:31.79,Dial-JP,,0,0,0,,なんか
Dialogue: 0,0:22:32.64,0:22:34.66,Dial-JP,,0,0,0,,オミと話してたら思い出した
Dialogue: 0,0:22:35.52,0:22:36.37,Dial-JP,,0,0,0,,来たよ
Dialogue: 0,0:22:47.45,0:22:48.89,Dial-JP,,0,0,0,,ああ　カプリ
Dialogue: 0,0:22:49.59,0:22:50.56,Dial-JP,,0,0,0,,楽しもうぜ
Dialogue: 0,0:23:03.48,0:23:04.63,Dial-JP,,0,0,0,,んだよ
Dialogue: 0,0:23:05.83,0:23:06.64,Dial-JP,,0,0,0,,もう
Dialogue: 0,0:23:07.42,0:23:08.49,Dial-JP,,0,0,0,,終わりかよ
Dialogue: 0,0:23:19.09,0:23:20.16,Dial-JP,,0,0,0,,ねえ　あそこ
Dialogue: 0,0:23:20.44,0:23:21.49,Dial-JP,,0,0,0,,行けっかな
Dialogue: 0,0:23:25.48,0:23:26.44,Dial-JP,,0,0,0,,行けるさ
Dialogue: 0,0:23:28.66,0:23:30.68,Dial-JP,,0,0,0,,じゃあな　ロマン
Dialogue: 0,0:23:31.87,0:23:33.81,Dial-JP,,0,0,0,,そこで映像は終わってる
Dialogue: 0,0:23:36.83,0:23:38.19,Dial-JP,,0,0,0,,Ｄはバカだ
Dialogue: 0,0:23:40.82,0:23:44.71,Dial-JP,,0,0,0,,依然として　大規模停電の原因は不明のままです
Dialogue: 0,0:23:45.13,0:23:47.56,Dial-JP,,0,0,0,,また　その後の爆撃についても
Dialogue: 0,0:23:47.56,0:23:50.62,Dial-JP,,0,0,0,,謎の機械の塊を見た　という人もいますが
Dialogue: 0,0:23:50.62,0:23:53.33,Dial-JP,,0,0,0,,それを捉えた映像は　全て破損しており
Dialogue: 0,0:23:53.99,0:23:55.69,Dial-JP,,0,0,0,,Ｄは　どうなったと思う
Dialogue: 0,0:23:55.94,0:23:57.70,Dial-JP,,0,0,0,,生きてるわけないでしょ
Dialogue: 0,0:23:58.63,0:24:01.59,Dial-JP,,0,0,0,,あいつはさ　ああいうやつだったんだよ
Dialogue: 0,0:24:01.98,0:24:03.64,Dial-JP,,0,0,0,,何だ　撮ってるのか
Dialogue: 0,0:24:04.15,0:24:04.85,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:24:05.15,0:24:07.03,Dial-JP,,0,0,0,,あの時　タリアを受け止められたのは
Dialogue: 0,0:24:07.47,0:24:08.67,Dial-JP,,0,0,0,,奇跡だと思う
Dialogue: 0,0:24:09.49,0:24:11.31,Dial-JP,,0,0,0,,アヴィダが助けてくれたんだ
Dialogue: 0,0:24:11.83,0:24:12.54,Dial-JP,,0,0,0,,きっと
Dialogue: 0,0:24:13.84,0:24:14.91,Dial-JP,,0,0,0,,おい　おい　おい
Dialogue: 0,0:24:15.99,0:24:16.99,Dial-JP,,0,0,0,,あいつ
Dialogue: 0,0:24:17.23,0:24:18.14,Dial-JP,,0,0,0,,知ってるの
Dialogue: 0,0:24:20.53,0:24:22.90,Dial-JP,,0,0,0,,知り合いさ　昔の
Dialogue: 0,0:24:23.25,0:24:25.86,Dial-JP,,0,0,0,,やはり回復は一時的なもので
Dialogue: 0,0:24:26.29,0:24:27.65,Dial-JP,,0,0,0,,何とかなりませんか
Dialogue: 0,0:24:27.65,0:24:29.86,Dial-JP,,0,0,0,,まずはIMPLANTの抑制を
Dialogue: 0,0:24:30.20,0:24:31.67,Dial-JP,,0,0,0,,きれいなとこなんでしょ
Dialogue: 0,0:24:32.27,0:24:34.57,Dial-JP,,0,0,0,,まあ　ウィークはそう言ってるけどね
Dialogue: 0,0:24:34.90,0:24:36.62,Dial-JP,,0,0,0,,私は行ったことないから
Dialogue: 0,0:24:38.07,0:24:38.83,Dial-JP,,0,0,0,,なに
Dialogue: 0,0:24:41.67,0:24:44.63,Dial-JP,,0,0,0,,寂しい　私がいなくなっちゃうの
Dialogue: 0,0:24:45.25,0:24:46.09,Dial-JP,,0,0,0,,手伝うか
Dialogue: 0,0:24:46.09,0:24:47.51,Dial-JP,,0,0,0,,いや　平気
Dialogue: 0,0:24:48.24,0:24:50.01,Dial-JP,,0,0,0,,元気でね　ロマン
Dialogue: 0,0:24:50.28,0:24:52.05,Dial-JP,,0,0,0,,うん　タリアもね
Dialogue: 0,0:24:54.12,0:24:55.53,Dial-JP,,0,0,0,,着いたら連絡してよ
Dialogue: 0,0:24:55.90,0:24:58.47,Dial-JP,,0,0,0,,絶対行くからさ　タリアを撮りに
Dialogue: 0,0:24:58.90,0:25:01.57,Dial-JP,,0,0,0,,うん　楽しみにしてる
Dialogue: 0,0:25:08.81,0:25:10.52,Dial-JP,,0,0,0,,じゃあ　行くね
Dialogue: 0,0:25:11.17,0:25:12.73,Dial-JP,,0,0,0,,おい　いいのか
Dialogue: 0,0:25:12.97,0:25:13.53,Dial-JP,,0,0,0,,うん
Dialogue: 0,0:25:14.23,0:25:16.29,Dial-JP,,0,0,0,,また　会えるからさ
Dialogue: 0,0:25:17.95,0:25:18.74,Dial-JP,,0,0,0,,待って
Dialogue: 0,0:25:18.74,0:25:21.74,Dial-JP,,0,0,0,,タリア　僕
Dialogue: 0,0:25:21.74,0:25:24.53,Dial-JP,,0,0,0,,本当はタリアに　行ってほしくない
Dialogue: 0,0:25:25.92,0:25:26.88,Dial-JP,,0,0,0,,どこにも
Dialogue: 0,0:25:28.50,0:25:29.72,Dial-JP,,0,0,0,,行かないでよ
Dialogue: 0,0:25:30.22,0:25:32.31,Dial-JP,,0,0,0,,どこにも　タリア
Dialogue: 0,0:25:35.38,0:25:39.37,Dial-JP,,0,0,0,,ロマン　また会えるよ　私たち
Dialogue: 0,0:25:40.93,0:25:41.46,Dial-JP,,0,0,0,,うん
Dialogue: 0,0:25:42.01,0:25:46.10,Dial-JP,,0,0,0,,もう一度　会って　その時まで撮り続けてよ
Dialogue: 0,0:25:47.11,0:25:47.62,Dial-JP,,0,0,0,,うん
Dialogue: 0,0:25:48.24,0:25:50.86,Dial-JP,,0,0,0,,そんでさ　私に見せてよ
Dialogue: 0,0:25:51.54,0:25:53.02,Dial-JP,,0,0,0,,全部蹴散らして
Dialogue: 0,0:25:53.38,0:25:55.74,Dial-JP,,0,0,0,,こんなこと　どうでもよくなるような
Dialogue: 0,0:25:55.99,0:25:57.90,Dial-JP,,0,0,0,,撮れるかな　僕に
Dialogue: 0,0:25:57.90,0:25:59.01,Dial-JP,,0,0,0,,できるよ
Dialogue: 0,0:25:59.71,0:26:02.43,Dial-JP,,0,0,0,,あの頃の私も　きれいに撮ってたんだ
Dialogue: 0,0:26:03.12,0:26:04.17,Dial-JP,,0,0,0,,余裕だよ
Dialogue: 0,0:26:07.40,0:26:08.44,Dial-JP,,0,0,0,,タリアはさ
Dialogue: 0,0:26:09.34,0:26:11.85,Dial-JP,,0,0,0,,あの時も　きれいだったよ
Dialogue: 0,0:26:13.02,0:26:14.60,Dial-JP,,0,0,0,,うれしいこと言うじゃん
Dialogue: 0,0:26:20.27,0:26:21.69,Dial-JP,,0,0,0,,泣くなよ
Dialogue: 0,0:26:22.25,0:26:24.18,Dial-JP,,0,0,0,,私は　まだ生きるんだから
Dialogue: 0,0:26:24.61,0:26:26.20,Dial-JP,,0,0,0,,ああ　すまん
Dialogue: 0,0:26:28.26,0:26:29.26,Dial-JP,,0,0,0,,そうだよな
Dialogue: 0,0:26:30.17,0:26:31.15,Dial-JP,,0,0,0,,生きるぞ
Dialogue: 0,0:26:31.15,0:26:32.12,Dial-JP,,0,0,0,,タリア
Dialogue: 0,0:00:43.11,0:00:45.69,OP-EN,,0,0,0,,10:15 on a Saturday night
Dialogue: 0,0:00:47.49,0:00:51.95,OP-EN,,0,0,0,,And the tap drips under the strip light
Dialogue: 0,0:00:54.28,0:00:57.12,OP-EN,,0,0,0,,And I’m sitting in the kitchen sink
Dialogue: 0,0:01:00.08,0:01:01.17,OP-EN,,0,0,0,,And the tap drips
Dialogue: 0,0:01:01.17,0:01:02.54,OP-EN,,0,0,0,,Drip drip drip drip
Dialogue: 0,0:01:02.54,0:01:04.71,OP-EN,,0,0,0,,Drip drip drip drip drip drip…
