Dialogue: 0,0:00:13.22,0:00:15.43,Default,,0,0,0,,あかねさん ただいま
Dialogue: 0,0:00:16.09,0:00:18.56,Default,,0,0,0,,…と言いたいところだが
Dialogue: 0,0:00:18.64,0:00:19.26,Default,,0,0,0,,フッ
Dialogue: 0,0:00:19.77,0:00:22.94,Default,,0,0,0,,実は すぐに旅立たなくちゃ\Nならないんだ
Dialogue: 0,0:00:23.48,0:00:26.61,Default,,0,0,0,,聞かないでくれ　訳は言えん
Dialogue: 0,0:00:27.19,0:00:30.28,Default,,0,0,0,,ただ１つ これだけは言える
Dialogue: 0,0:00:31.24,0:00:35.41,Default,,0,0,0,,今度 会うとき 俺は\N完全な男に戻っている！
Dialogue: 0,0:00:35.99,0:00:38.53,Default,,0,0,0,,だから お… 俺と
Dialogue: 0,0:00:38.62,0:00:41.33,Default,,0,0,0,,つき つき つき…
Dialogue: 0,0:00:41.91,0:00:42.79,Default,,0,0,0,,んん…
Dialogue: 0,0:00:43.37,0:00:44.87,Default,,0,0,0,,あ～ 言えん！
Dialogue: 0,0:00:44.96,0:00:46.25,Default,,0,0,0,,付き合ってくれなんて⸺
Dialogue: 0,0:00:46.33,0:00:48.92,Default,,0,0,0,,恥ずかしくて言えーん！
Dialogue: 0,0:00:49.50,0:00:50.50,Default,,0,0,0,,こら！
Dialogue: 0,0:00:50.59,0:00:52.80,Default,,0,0,0,,待ちなさい このスケベジジイ！
Dialogue: 0,0:00:52.88,0:00:54.80,Default,,0,0,0,,眼福 眼福じゃ～い
Dialogue: 0,0:00:55.59,0:00:57.05,Default,,0,0,0,,{\an6}誰か 捕まえて！
Dialogue: 0,0:00:57.14,0:00:57.89,Default,,0,0,0,,ニョホホ～イ
Dialogue: 0,0:00:57.89,0:00:58.68,Default,,0,0,0,,ニョホホ～イ
Dialogue: 0,0:00:57.89,0:00:58.68,Default,,0,0,0,,{\an6}ぐっ！
Dialogue: 0,0:01:00.35,0:01:01.01,Default,,0,0,0,,{\an6}ぐあっ…
Dialogue: 0,0:01:01.10,0:01:03.98,Default,,0,0,0,,ナッハハハ\Nほい ほい ほい～
Dialogue: 0,0:01:04.06,0:01:07.31,Default,,0,0,0,,クソ～\Nなんて すばしっこいジジイなの
Dialogue: 0,0:01:07.40,0:01:09.82,Default,,0,0,0,,毎日毎日 学校に来て！
Dialogue: 0,0:01:09.90,0:01:11.11,Default,,0,0,0,,ちょっかい出されてから
Dialogue: 0,0:01:11.19,0:01:12.86,Default,,0,0,0,,追っかけてたんじゃダメよ
Dialogue: 0,0:01:12.94,0:01:15.07,Default,,0,0,0,,なんか考えがあるの？　あかね
Dialogue: 0,0:01:15.15,0:01:16.45,Default,,0,0,0,,-そうだ！\N-ん？
Dialogue: 0,0:01:16.53,0:01:17.61,Default,,0,0,0,,こういうの どう？
Dialogue: 0,0:01:17.70,0:01:20.45,Default,,0,0,0,,明日 体育の授業があるでしょ？
Dialogue: 0,0:01:20.53,0:01:21.87,Default,,0,0,0,,そこでね…
Dialogue: 0,0:01:21.95,0:01:22.54,Default,,0,0,0,,ん？
Dialogue: 0,0:01:22.62,0:01:24.50,Default,,0,0,0,,-ひっ…\N-良牙くん
Dialogue: 0,0:01:24.58,0:01:26.96,Default,,0,0,0,,何してんの？　こんなとこで
Dialogue: 0,0:01:27.04,0:01:27.92,Default,,0,0,0,,やあ
Dialogue: 0,0:02:58.97,0:03:01.93,Default,,0,0,0,,へえ 良牙くん\Nまた どこか行くの？
Dialogue: 0,0:03:03.51,0:03:07.02,Default,,0,0,0,,{\an6}ああ 今度は\Nまた いつ会えるか…
Dialogue: 0,0:03:07.10,0:03:08.73,Default,,0,0,0,,乱馬に会ってったら？
Dialogue: 0,0:03:08.81,0:03:10.23,Default,,0,0,0,,久しぶりでしょ？
Dialogue: 0,0:03:10.31,0:03:12.06,Default,,0,0,0,,乱馬の\Nツラなんか見たくない
Dialogue: 0,0:03:12.15,0:03:13.61,Default,,0,0,0,,そっか
Dialogue: 0,0:03:15.57,0:03:19.15,Default,,0,0,0,,でも 二人って\N本当は仲いいんでしょ？
Dialogue: 0,0:03:19.74,0:03:22.82,Default,,0,0,0,,ほら “ケンカするほど”って\N言うくらいだし
Dialogue: 0,0:03:24.03,0:03:25.70,Default,,0,0,0,,それよりな あかねさん
Dialogue: 0,0:03:25.78,0:03:26.66,Default,,0,0,0,,あっ…
Dialogue: 0,0:03:28.45,0:03:29.62,Default,,0,0,0,,ん？
Dialogue: 0,0:03:29.71,0:03:31.33,Default,,0,0,0,,あ…
Dialogue: 0,0:03:34.21,0:03:36.17,Default,,0,0,0,,その… なんだ…
Dialogue: 0,0:03:36.25,0:03:36.84,Default,,0,0,0,,うん
Dialogue: 0,0:03:36.92,0:03:39.80,Default,,0,0,0,,かっ 帰ってきたら 俺と…
Dialogue: 0,0:03:40.51,0:03:41.80,Default,,0,0,0,,なあに？
Dialogue: 0,0:03:41.88,0:03:44.80,Default,,0,0,0,,つっ つっ つっ…
Dialogue: 0,0:03:45.39,0:03:46.81,Default,,0,0,0,,つまらんもんだが！
Dialogue: 0,0:03:47.39,0:03:50.02,Default,,0,0,0,,わあ！　いつも お土産 ありがとう
Dialogue: 0,0:03:50.10,0:03:52.27,Default,,0,0,0,,良牙くんって ほんとに いい人ね
Dialogue: 0,0:03:52.35,0:03:54.77,Default,,0,0,0,,アハハ… アハハハ
Dialogue: 0,0:03:54.86,0:03:57.65,Default,,0,0,0,,じゃ 気をつけて\Nいってらっしゃ～い
Dialogue: 0,0:03:57.73,0:03:59.78,Default,,0,0,0,,アハハ… ハハ…
Dialogue: 0,0:04:00.36,0:04:02.78,Default,,0,0,0,,でえ～い ちくしょう～！
Dialogue: 0,0:04:02.86,0:04:03.99,Default,,0,0,0,,-良牙くん\N-うっ…
Dialogue: 0,0:04:04.07,0:04:04.91,Default,,0,0,0,,{\an6}あ… あかねさん？
Dialogue: 0,0:04:04.91,0:04:06.20,Default,,0,0,0,,{\an6}あ… あかねさん？
Dialogue: 0,0:04:04.91,0:04:06.20,Default,,0,0,0,,いってらっしゃいのキス\Nしてあげる
Dialogue: 0,0:04:06.20,0:04:07.95,Default,,0,0,0,,いってらっしゃいのキス\Nしてあげる
Dialogue: 0,0:04:08.03,0:04:08.91,Default,,0,0,0,,うっ…
Dialogue: 0,0:04:09.70,0:04:12.50,Default,,0,0,0,,でも… あかねさん
Dialogue: 0,0:04:12.58,0:04:13.87,Default,,0,0,0,,俺たち まだ
Dialogue: 0,0:04:13.96,0:04:16.33,Default,,0,0,0,,手だって ちゃんと\Nつないだこと…
Dialogue: 0,0:04:16.42,0:04:19.34,Default,,0,0,0,,まっ まだ 心の準備が…
Dialogue: 0,0:04:19.42,0:04:20.96,Default,,0,0,0,,じゃ やめた
Dialogue: 0,0:04:21.05,0:04:22.17,Default,,0,0,0,,キャハッ
Dialogue: 0,0:04:22.26,0:04:23.59,Default,,0,0,0,,ぐえっ
Dialogue: 0,0:04:25.18,0:04:26.93,Default,,0,0,0,,乱暴なヤツだな
Dialogue: 0,0:04:27.01,0:04:29.26,Default,,0,0,0,,久しぶりに会ったってのに
Dialogue: 0,0:04:29.35,0:04:30.60,Default,,0,0,0,,やかましい
Dialogue: 0,0:04:30.68,0:04:32.64,Default,,0,0,0,,人の心を おちょくりやがって
Dialogue: 0,0:04:33.69,0:04:35.77,Default,,0,0,0,,何 怒ってんだよ Ｐちゃん
Dialogue: 0,0:04:36.35,0:04:36.94,Default,,0,0,0,,フッ…
Dialogue: 0,0:04:39.86,0:04:42.03,Default,,0,0,0,,残念だがな 乱馬
Dialogue: 0,0:04:42.11,0:04:44.03,Default,,0,0,0,,もうすぐ Ｐちゃんとは\Nお別れなんだ
Dialogue: 0,0:04:44.03,0:04:45.07,Default,,0,0,0,,もうすぐ Ｐちゃんとは\Nお別れなんだ
Dialogue: 0,0:04:44.03,0:04:45.07,Default,,0,0,0,,{\an6}いってえ～
Dialogue: 0,0:04:45.66,0:04:46.24,Default,,0,0,0,,ん？
Dialogue: 0,0:04:46.99,0:04:49.62,Default,,0,0,0,,その訳は これだ！
Dialogue: 0,0:04:50.20,0:04:51.62,Default,,0,0,0,,なんだ？　この地図
Dialogue: 0,0:04:51.70,0:04:52.37,Default,,0,0,0,,でっ…
Dialogue: 0,0:04:52.45,0:04:54.21,Default,,0,0,0,,宝の地図か？
Dialogue: 0,0:04:54.29,0:04:56.08,Default,,0,0,0,,-バ… バカ　返せ！\N-ほっ ほっ ほっ
Dialogue: 0,0:04:56.17,0:04:58.00,Default,,0,0,0,,-この この… この！\N-うおおっ
Dialogue: 0,0:04:59.92,0:05:01.13,Default,,0,0,0,,-あっ\N-げっ！
Dialogue: 0,0:05:03.80,0:05:05.55,Default,,0,0,0,,マズい… ふん！
Dialogue: 0,0:05:06.59,0:05:09.60,Default,,0,0,0,,和風男溺泉が！
Dialogue: 0,0:05:09.68,0:05:10.64,Default,,0,0,0,,ん？　よっ！
Dialogue: 0,0:05:14.64,0:05:16.06,Default,,0,0,0,,-ぶきーっ！\N-ん？
Dialogue: 0,0:05:16.14,0:05:19.31,Default,,0,0,0,,わ… 和風男溺泉だと？
Dialogue: 0,0:05:19.40,0:05:20.27,Default,,0,0,0,,ぶき…
Dialogue: 0,0:05:22.23,0:05:23.78,Default,,0,0,0,,その昔
Dialogue: 0,0:05:23.86,0:05:29.66,Default,,0,0,0,,武蔵国では 人々が\Nキツネの悪さに困り果てていた
Dialogue: 0,0:05:29.74,0:05:33.41,Default,,0,0,0,,あるとき 中国から渡来した高僧が
Dialogue: 0,0:05:33.50,0:05:36.25,Default,,0,0,0,,持っていた杖で地面を突くと
Dialogue: 0,0:05:36.33,0:05:38.00,Default,,0,0,0,,泉が湧いた
Dialogue: 0,0:05:39.25,0:05:42.05,Default,,0,0,0,,この泉につかったキツネは
Dialogue: 0,0:05:42.13,0:05:47.09,Default,,0,0,0,,なんと みんな\N男の姿になってしまったのだ
Dialogue: 0,0:05:48.01,0:05:52.68,Default,,0,0,0,,おかげで悪さをするキツネは\N一匹もいなくなったが
Dialogue: 0,0:05:52.76,0:05:56.10,Default,,0,0,0,,人々は もっと迷惑したという
Dialogue: 0,0:05:57.94,0:06:00.19,Default,,0,0,0,,ま… 間違いねえ
Dialogue: 0,0:06:00.27,0:06:02.61,Default,,0,0,0,,そりゃ 男溺泉だ
Dialogue: 0,0:06:03.36,0:06:05.19,Default,,0,0,0,,男溺泉にさえ つかれば
Dialogue: 0,0:06:05.28,0:06:07.90,Default,,0,0,0,,この ふざけた体質とも おさらば
Dialogue: 0,0:06:07.99,0:06:09.87,Default,,0,0,0,,完全な男に戻れる
Dialogue: 0,0:06:10.53,0:06:11.12,Default,,0,0,0,,お？
Dialogue: 0,0:06:12.58,0:06:14.04,Default,,0,0,0,,というわけだ
Dialogue: 0,0:06:14.74,0:06:16.25,Default,,0,0,0,,俺は行くぜ
Dialogue: 0,0:06:16.33,0:06:17.29,Default,,0,0,0,,えっ？
Dialogue: 0,0:06:17.79,0:06:20.17,Default,,0,0,0,,待て待て 良牙！
Dialogue: 0,0:06:20.83,0:06:23.17,Default,,0,0,0,,協力する？　ふざけるな
Dialogue: 0,0:06:23.25,0:06:25.92,Default,,0,0,0,,いや 俺が\N連れてってやるっつってんだろ
Dialogue: 0,0:06:26.01,0:06:28.09,Default,,0,0,0,,余計なお世話だ
Dialogue: 0,0:06:28.17,0:06:30.30,Default,,0,0,0,,俺は地図を持ってるんだぜ
Dialogue: 0,0:06:30.39,0:06:32.97,Default,,0,0,0,,ブタに真珠だ この方向音痴
Dialogue: 0,0:06:33.05,0:06:33.64,Default,,0,0,0,,フッ
Dialogue: 0,0:06:34.22,0:06:37.89,Default,,0,0,0,,そのブタ呼ばわりとも\Nもうすぐ お別れだと思うと
Dialogue: 0,0:06:37.98,0:06:39.48,Default,,0,0,0,,さみしくなるぜ
Dialogue: 0,0:06:39.56,0:06:41.19,Default,,0,0,0,,ヌハハハハハ！
Dialogue: 0,0:06:41.27,0:06:43.32,Default,,0,0,0,,ヌハッ ヌハハハハッ
Dialogue: 0,0:06:43.40,0:06:46.61,Default,,0,0,0,,おーい\Nそっちは行き止まりだぞ
Dialogue: 0,0:06:46.69,0:06:48.28,Default,,0,0,0,,ぐう…
Dialogue: 0,0:06:48.36,0:06:51.24,Default,,0,0,0,,歩いていれば\Nいつか たどりつく！
Dialogue: 0,0:06:51.32,0:06:54.58,Default,,0,0,0,,和風男溺泉が\N俺を待っているからな
Dialogue: 0,0:06:54.66,0:06:55.20,Default,,0,0,0,,よっと
Dialogue: 0,0:06:55.79,0:06:58.12,Default,,0,0,0,,いいから ちょっと貸してみろって
Dialogue: 0,0:06:58.20,0:07:01.58,Default,,0,0,0,,フンッ とにかく俺は\N一人で男に戻る
Dialogue: 0,0:07:01.67,0:07:03.42,Default,,0,0,0,,あっ こっちか
Dialogue: 0,0:07:03.50,0:07:06.09,Default,,0,0,0,,バカが\Nいきなり間違ってんじゃねえか
Dialogue: 0,0:07:06.17,0:07:07.88,Default,,0,0,0,,き… 貴様
Dialogue: 0,0:07:07.96,0:07:08.84,Default,,0,0,0,,返せ！
Dialogue: 0,0:07:10.26,0:07:12.64,Default,,0,0,0,,{\an6}起立　礼！
Dialogue: 0,0:07:12.72,0:07:14.97,Default,,0,0,0,,次は いよいよ 体育よ
Dialogue: 0,0:07:15.06,0:07:17.85,Default,,0,0,0,,また あのスケベジジイ\Nちょっかい出しに来るわ
Dialogue: 0,0:07:17.93,0:07:19.02,Default,,0,0,0,,やあね
Dialogue: 0,0:07:20.06,0:07:23.65,Default,,0,0,0,,大丈夫\N絶対 そんなこと できないよ
Dialogue: 0,0:07:24.23,0:07:26.19,Default,,0,0,0,,あかね なんかしたの？
Dialogue: 0,0:07:26.27,0:07:27.90,Default,,0,0,0,,ちょっとね
Dialogue: 0,0:07:27.98,0:07:29.36,Default,,0,0,0,,ウフフッ
Dialogue: 0,0:07:31.20,0:07:32.74,Default,,0,0,0,,う～ん…
Dialogue: 0,0:07:33.37,0:07:36.41,Default,,0,0,0,,おい 乱馬\Nほんとに ここなんだろうな
Dialogue: 0,0:07:36.49,0:07:38.50,Default,,0,0,0,,高校の裏庭じゃねえか
Dialogue: 0,0:07:38.58,0:07:39.96,Default,,0,0,0,,間違いねえよ
Dialogue: 0,0:07:40.04,0:07:42.71,Default,,0,0,0,,地図によると\Nこの お稲荷さんが
Dialogue: 0,0:07:42.79,0:07:44.71,Default,,0,0,0,,重要な手がかりらしいが…
Dialogue: 0,0:07:44.71,0:07:45.46,Default,,0,0,0,,重要な手がかりらしいが…
Dialogue: 0,0:07:44.71,0:07:45.46,Default,,0,0,0,,{\an6}案内 ご苦労！
Dialogue: 0,0:07:45.46,0:07:46.92,Default,,0,0,0,,{\an6}案内 ご苦労！
Dialogue: 0,0:07:47.00,0:07:48.38,Default,,0,0,0,,カキーン
Dialogue: 0,0:07:49.09,0:07:52.34,Default,,0,0,0,,このキツネが指す方向へ\N100歩目の地点
Dialogue: 0,0:07:52.43,0:07:54.84,Default,,0,0,0,,そこが男溺泉だ
Dialogue: 0,0:07:54.93,0:07:56.43,Default,,0,0,0,,ヌハハハハハ！
Dialogue: 0,0:07:57.01,0:07:58.60,Default,,0,0,0,,野郎 待ちやがれ！
Dialogue: 0,0:07:59.47,0:08:01.06,Default,,0,0,0,,ついてくるな！
Dialogue: 0,0:08:01.56,0:08:02.98,Default,,0,0,0,,この卑怯者！
Dialogue: 0,0:08:03.06,0:08:05.15,Default,,0,0,0,,そんなに抜け駆けしたいかよ！
Dialogue: 0,0:08:05.81,0:08:08.02,Default,,0,0,0,,うるさい！\Nタダ乗りしやがって
Dialogue: 0,0:08:08.61,0:08:10.53,Default,,0,0,0,,案内してやっただろうが
Dialogue: 0,0:08:10.61,0:08:13.11,Default,,0,0,0,,84 85 86…
Dialogue: 0,0:08:13.20,0:08:14.49,Default,,0,0,0,,あの建物の下か！
Dialogue: 0,0:08:14.57,0:08:17.16,Default,,0,0,0,,92 93 94…
Dialogue: 0,0:08:18.12,0:08:19.12,Default,,0,0,0,,-うっ…\N-ぐへっ
Dialogue: 0,0:08:19.87,0:08:21.08,Default,,0,0,0,,なっ！
Dialogue: 0,0:08:21.16,0:08:22.16,Default,,0,0,0,,がっ…
Dialogue: 0,0:08:23.37,0:08:24.37,Default,,0,0,0,,ふっ！
Dialogue: 0,0:08:27.42,0:08:28.13,Default,,0,0,0,,うわっ…
Dialogue: 0,0:08:29.05,0:08:30.21,Default,,0,0,0,,ぐひい～！
Dialogue: 0,0:08:35.30,0:08:36.22,Default,,0,0,0,,フフフフッ
Dialogue: 0,0:08:39.51,0:08:41.64,Default,,0,0,0,,あら？\Nいないわ おじいさん
Dialogue: 0,0:08:41.73,0:08:42.81,Default,,0,0,0,,逃げられた！
Dialogue: 0,0:08:43.44,0:08:44.94,Default,,0,0,0,,ということは…
Dialogue: 0,0:08:45.44,0:08:47.02,Default,,0,0,0,,必ず また来る！
Dialogue: 0,0:08:47.11,0:08:49.15,Default,,0,0,0,,だったら 徹底抗戦ね
Dialogue: 0,0:08:49.23,0:08:50.78,Default,,0,0,0,,あかね 私も手伝う
Dialogue: 0,0:08:50.86,0:08:51.36,Default,,0,0,0,,98 99 100
Dialogue: 0,0:08:51.36,0:08:52.36,Default,,0,0,0,,98 99 100
Dialogue: 0,0:08:51.36,0:08:52.36,Default,,0,0,0,,{\an6}私も
Dialogue: 0,0:08:52.36,0:08:53.61,Default,,0,0,0,,98 99 100
Dialogue: 0,0:08:53.70,0:08:56.66,Default,,0,0,0,,じょ… 女子更衣室の下に…
Dialogue: 0,0:08:56.74,0:08:58.45,Default,,0,0,0,,男溺泉があるのか？
Dialogue: 0,0:08:58.53,0:09:00.29,Default,,0,0,0,,ま… 間違いねえ
Dialogue: 0,0:09:00.37,0:09:03.50,Default,,0,0,0,,クッソ～\Nどんな邪魔が入ろうと…
Dialogue: 0,0:09:04.21,0:09:07.17,Default,,0,0,0,,このまま\N引き下がるわけにはいかねえ！
Dialogue: 0,0:09:07.25,0:09:08.59,Default,,0,0,0,,ここは協力だ
Dialogue: 0,0:09:11.21,0:09:13.05,Default,,0,0,0,,みんな 覚悟はいいわね？
Dialogue: 0,0:09:13.13,0:09:16.13,Default,,0,0,0,,あたしたちの女子更衣室を\N死守するのよ
Dialogue: 0,0:09:16.22,0:09:18.05,Default,,0,0,0,,おお～！
Dialogue: 0,0:09:18.14,0:09:20.72,Default,,0,0,0,,{\an6}ワン･ツー ワン･ツー…
Dialogue: 0,0:09:18.14,0:09:20.72,Default,,0,0,0,,ワン･ツー ワン･ツー
Dialogue: 0,0:09:20.81,0:09:22.35,Default,,0,0,0,,{\an6}お師匠さま
Dialogue: 0,0:09:20.81,0:09:22.35,Default,,0,0,0,,ワン･ツー ワン･ツー
Dialogue: 0,0:09:22.35,0:09:22.43,Default,,0,0,0,,ワン･ツー ワン･ツー
Dialogue: 0,0:09:22.43,0:09:23.14,Default,,0,0,0,,ワン･ツー ワン･ツー
Dialogue: 0,0:09:22.43,0:09:23.14,Default,,0,0,0,,{\an6}今日は学校に\N遊びに行かんのですか？
Dialogue: 0,0:09:23.14,0:09:23.22,Default,,0,0,0,,{\an6}今日は学校に\N遊びに行かんのですか？
Dialogue: 0,0:09:23.22,0:09:25.27,Default,,0,0,0,,{\an6}今日は学校に\N遊びに行かんのですか？
Dialogue: 0,0:09:23.22,0:09:25.27,Default,,0,0,0,,ワン･ツー ワン･ツー
Dialogue: 0,0:09:25.35,0:09:27.60,Default,,0,0,0,,あ～ またあとでのう
Dialogue: 0,0:09:29.06,0:09:30.40,Default,,0,0,0,,準備よし
Dialogue: 0,0:09:30.48,0:09:32.98,Default,,0,0,0,,こうなりゃ 女装も やむなし
Dialogue: 0,0:09:33.07,0:09:34.99,Default,,0,0,0,,乱馬 貴様…
Dialogue: 0,0:09:35.07,0:09:37.66,Default,,0,0,0,,正面から\N女子更衣室に入るつもりか？
Dialogue: 0,0:09:37.74,0:09:38.95,Default,,0,0,0,,-当然\N-なっ…
Dialogue: 0,0:09:39.03,0:09:40.12,Default,,0,0,0,,許さーん！
Dialogue: 0,0:09:40.20,0:09:42.45,Default,,0,0,0,,あの中では\Nあかねさんが着替えを…
Dialogue: 0,0:09:42.54,0:09:43.62,Default,,0,0,0,,てめえ
Dialogue: 0,0:09:43.70,0:09:46.66,Default,,0,0,0,,いきなり 目的 忘れんなよ！
Dialogue: 0,0:09:46.75,0:09:48.46,Default,,0,0,0,,女子更衣室の下には\N男溺泉があるんだぞ
Dialogue: 0,0:09:48.46,0:09:50.13,Default,,0,0,0,,女子更衣室の下には\N男溺泉があるんだぞ
Dialogue: 0,0:09:48.46,0:09:50.13,Default,,0,0,0,,{\an6}ぶきーっ！　ぶきぶき
Dialogue: 0,0:09:53.13,0:09:56.01,Default,,0,0,0,,ねえ おじいさん\N本当に来るかしら？
Dialogue: 0,0:09:56.09,0:09:57.59,Default,,0,0,0,,来るわよ
Dialogue: 0,0:09:57.68,0:10:01.47,Default,,0,0,0,,今日という今日は 徹底的に\Nたたきのめしてやらなくちゃ
Dialogue: 0,0:10:02.06,0:10:04.02,Default,,0,0,0,,このままじゃ\Nおちおち着替えられないわ
Dialogue: 0,0:10:04.02,0:10:04.60,Default,,0,0,0,,このままじゃ\Nおちおち着替えられないわ
Dialogue: 0,0:10:04.02,0:10:04.60,Default,,0,0,0,,{\an6}いっけな～い
Dialogue: 0,0:10:04.60,0:10:04.68,Default,,0,0,0,,{\an6}いっけな～い
Dialogue: 0,0:10:04.68,0:10:05.39,Default,,0,0,0,,{\an6}いっけな～い
Dialogue: 0,0:10:04.68,0:10:05.39,Default,,0,0,0,,ねえ
Dialogue: 0,0:10:05.39,0:10:05.48,Default,,0,0,0,,ねえ
Dialogue: 0,0:10:05.48,0:10:05.98,Default,,0,0,0,,ねえ
Dialogue: 0,0:10:05.48,0:10:05.98,Default,,0,0,0,,{\an6}忘れ物しちゃった～
Dialogue: 0,0:10:05.98,0:10:07.19,Default,,0,0,0,,{\an6}忘れ物しちゃった～
Dialogue: 0,0:10:07.27,0:10:07.94,Default,,0,0,0,,あっ！
Dialogue: 0,0:10:08.02,0:10:09.06,Default,,0,0,0,,ぐっ…
Dialogue: 0,0:10:10.77,0:10:11.98,Default,,0,0,0,,バカね 合言葉 言ってから\N入る約束でしょ
Dialogue: 0,0:10:11.98,0:10:13.69,Default,,0,0,0,,バカね 合言葉 言ってから\N入る約束でしょ
Dialogue: 0,0:10:11.98,0:10:13.69,Default,,0,0,0,,{\an6}ってえ～
Dialogue: 0,0:10:13.69,0:10:14.73,Default,,0,0,0,,バカね 合言葉 言ってから\N入る約束でしょ
Dialogue: 0,0:10:15.32,0:10:17.86,Default,,0,0,0,,ご… ごめんなさい\Nうっかりしてたわ
Dialogue: 0,0:10:18.70,0:10:20.45,Default,,0,0,0,,さ～て 男溺泉
Dialogue: 0,0:10:20.53,0:10:22.03,Default,,0,0,0,,男溺泉っと…
Dialogue: 0,0:10:22.12,0:10:24.24,Default,,0,0,0,,乱馬！　何やってんのよ
Dialogue: 0,0:10:24.33,0:10:25.37,Default,,0,0,0,,しーっ
Dialogue: 0,0:10:25.45,0:10:28.33,Default,,0,0,0,,方向よし　距離はっと…
Dialogue: 0,0:10:28.83,0:10:29.33,Default,,0,0,0,,{\an6}う～ん 恐らく この辺り
Dialogue: 0,0:10:29.33,0:10:31.50,Default,,0,0,0,,{\an6}う～ん 恐らく この辺り
Dialogue: 0,0:10:29.33,0:10:31.50,Default,,0,0,0,,{\an4}ん？　どうしたの？
Dialogue: 0,0:10:31.58,0:10:32.17,Default,,0,0,0,,{\an6}あっ…
Dialogue: 0,0:10:32.75,0:10:34.05,Default,,0,0,0,,こんの恥知らずが！
Dialogue: 0,0:10:34.05,0:10:36.05,Default,,0,0,0,,こんの恥知らずが！
Dialogue: 0,0:10:34.05,0:10:36.05,Default,,0,0,0,,{\an6}ノー ノー ノー！
Dialogue: 0,0:10:36.13,0:10:37.05,Default,,0,0,0,,あかね！
Dialogue: 0,0:10:37.13,0:10:39.01,Default,,0,0,0,,乱暴 やめなさいよ
Dialogue: 0,0:10:37.13,0:10:39.01,Default,,0,0,0,,{\an4}どうどう\Nどうどうどう…
Dialogue: 0,0:10:39.01,0:10:39.09,Default,,0,0,0,,{\an4}どうどう\Nどうどうどう…
Dialogue: 0,0:10:39.09,0:10:40.26,Default,,0,0,0,,{\an4}どうどう\Nどうどうどう…
Dialogue: 0,0:10:39.09,0:10:40.26,Default,,0,0,0,,ちょっと 大丈夫？
Dialogue: 0,0:10:40.34,0:10:42.47,Default,,0,0,0,,ひ… ひどいわ あかねちゃん
Dialogue: 0,0:10:40.34,0:10:42.47,Default,,0,0,0,,{\an4}どうどう どうどう…
Dialogue: 0,0:10:42.55,0:10:44.01,Default,,0,0,0,,あ… あんたねえ
Dialogue: 0,0:10:44.60,0:10:46.89,Default,,0,0,0,,みんな 俺の正体に気づいてねえ
Dialogue: 0,0:10:47.43,0:10:49.23,Default,,0,0,0,,変装してきてよかったぜ
Dialogue: 0,0:10:49.31,0:10:50.90,Default,,0,0,0,,さっさと出てってよ！
Dialogue: 0,0:10:50.98,0:10:51.81,Default,,0,0,0,,何さ！
Dialogue: 0,0:10:51.90,0:10:53.98,Default,,0,0,0,,女の子が女子更衣室に入って\N何が…
Dialogue: 0,0:10:54.07,0:10:55.23,Default,,0,0,0,,うう～！
Dialogue: 0,0:10:55.32,0:10:57.94,Default,,0,0,0,,この場で\Nバラされたくなかったら…
Dialogue: 0,0:10:59.78,0:11:01.70,Default,,0,0,0,,出てって～！
Dialogue: 0,0:11:01.78,0:11:03.66,Default,,0,0,0,,凶暴女～！
Dialogue: 0,0:11:03.74,0:11:05.16,Default,,0,0,0,,何よ のぞき魔！
Dialogue: 0,0:11:05.24,0:11:07.25,Default,,0,0,0,,おっと！
Dialogue: 0,0:11:09.16,0:11:11.88,Default,,0,0,0,,けっ こんなカッコで\N男に戻るほど
Dialogue: 0,0:11:11.96,0:11:13.25,Default,,0,0,0,,ノロマじゃねえよ
Dialogue: 0,0:11:13.33,0:11:14.71,Default,,0,0,0,,ああっ
Dialogue: 0,0:11:15.92,0:11:17.09,Default,,0,0,0,,やだ！
Dialogue: 0,0:11:17.17,0:11:19.01,Default,,0,0,0,,隣のクラスの早乙女くんよ
Dialogue: 0,0:11:19.09,0:11:21.01,Default,,0,0,0,,-ハッ…\N-きゃあ ブルマ！
Dialogue: 0,0:11:21.09,0:11:22.26,Default,,0,0,0,,-なになに？\N-ひっ…
Dialogue: 0,0:11:22.34,0:11:24.01,Default,,0,0,0,,ひっ ひい… ひいい～
Dialogue: 0,0:11:24.10,0:11:26.51,Default,,0,0,0,,ちくしょう～！
Dialogue: 0,0:11:26.60,0:11:28.85,Default,,0,0,0,,-ハア ハア ハア…\N-フフフフッ
Dialogue: 0,0:11:28.93,0:11:30.19,Default,,0,0,0,,自業自得だ
Dialogue: 0,0:11:30.27,0:11:31.85,Default,,0,0,0,,てめえは…
Dialogue: 0,0:11:31.94,0:11:34.77,Default,,0,0,0,,何 落ち着いてやがんだ！
Dialogue: 0,0:11:34.86,0:11:37.23,Default,,0,0,0,,ぶきーっ！　ぶきき…
Dialogue: 0,0:11:37.32,0:11:41.91,Default,,0,0,0,,もう 男に戻るためなら\N手段は選ばねえ
Dialogue: 0,0:11:42.41,0:11:43.66,Default,,0,0,0,,-ぶきっ\N-いいか 良牙
Dialogue: 0,0:11:43.74,0:11:44.53,Default,,0,0,0,,ぶき？
Dialogue: 0,0:11:44.62,0:11:46.74,Default,,0,0,0,,服を盗んで 遠くへ逃げろ
Dialogue: 0,0:11:46.83,0:11:47.58,Default,,0,0,0,,ぶきっ！
Dialogue: 0,0:11:47.66,0:11:50.08,Default,,0,0,0,,あかねたちが\Nおめえを追っかけてる隙に
Dialogue: 0,0:11:50.16,0:11:52.50,Default,,0,0,0,,俺が男溺泉を掘り出す
Dialogue: 0,0:11:52.58,0:11:53.29,Default,,0,0,0,,いいな
Dialogue: 0,0:11:53.37,0:11:54.29,Default,,0,0,0,,ぶきぶき ぶきぶき！
Dialogue: 0,0:11:54.38,0:11:56.46,Default,,0,0,0,,四の五の抜かすな
Dialogue: 0,0:11:56.54,0:11:57.75,Default,,0,0,0,,{\an6}ぶきっ！　ぶき…
Dialogue: 0,0:11:57.84,0:11:58.42,Default,,0,0,0,,{\an6}ん？
Dialogue: 0,0:11:58.50,0:12:00.92,Default,,0,0,0,,きゃあ！　Ｐちゃんじゃない
Dialogue: 0,0:12:01.01,0:12:02.13,Default,,0,0,0,,かわいい～
Dialogue: 0,0:12:02.22,0:12:03.22,Default,,0,0,0,,Ｐちゃん？
Dialogue: 0,0:12:03.30,0:12:05.18,Default,,0,0,0,,-ぶきーっ！\N-アハハハッ
Dialogue: 0,0:12:07.26,0:12:09.64,Default,,0,0,0,,どこ行ってたのよ Ｐちゃん
Dialogue: 0,0:12:09.72,0:12:11.64,Default,,0,0,0,,ぶき～
Dialogue: 0,0:12:12.14,0:12:13.90,Default,,0,0,0,,ウフフフッ
Dialogue: 0,0:12:15.19,0:12:16.31,Default,,0,0,0,,ん？
Dialogue: 0,0:12:16.40,0:12:17.57,Default,,0,0,0,,ぶきっ！
Dialogue: 0,0:12:20.28,0:12:21.99,Default,,0,0,0,,ちょっと 鼻血よ
Dialogue: 0,0:12:22.07,0:12:22.90,Default,,0,0,0,,Ｐちゃん！
Dialogue: 0,0:12:33.71,0:12:35.96,Default,,0,0,0,,この野郎 起きろ！
Dialogue: 0,0:12:36.04,0:12:36.96,Default,,0,0,0,,ハッ…
Dialogue: 0,0:12:37.71,0:12:39.88,Default,,0,0,0,,-ぬうう～\N-ハ… ハハ…
Dialogue: 0,0:12:39.96,0:12:42.05,Default,,0,0,0,,お邪魔しました～
Dialogue: 0,0:12:42.80,0:12:43.97,Default,,0,0,0,,ぐっ…
Dialogue: 0,0:12:48.22,0:12:50.64,Default,,0,0,0,,生きててよかった…
Dialogue: 0,0:12:51.22,0:12:54.10,Default,,0,0,0,,ブタの体も いいもんだな
Dialogue: 0,0:12:54.19,0:12:56.81,Default,,0,0,0,,何 訳分かんねえこと言ってんだ！
Dialogue: 0,0:12:56.90,0:13:00.11,Default,,0,0,0,,目先の幸せと男溺泉と\Nどっちが大事だ
Dialogue: 0,0:13:00.19,0:13:02.61,Default,,0,0,0,,{\an6}目先の幸せ
Dialogue: 0,0:13:02.69,0:13:05.57,Default,,0,0,0,,乱馬のヤツ\N逃げ足 速いんだから
Dialogue: 0,0:13:06.28,0:13:08.57,Default,,0,0,0,,あれ？\N良牙くん 旅に出たんじゃ…
Dialogue: 0,0:13:08.66,0:13:09.41,Default,,0,0,0,,あっ…
Dialogue: 0,0:13:09.49,0:13:11.58,Default,,0,0,0,,-がぴょ～ん！\N-あ… あかねさん
Dialogue: 0,0:13:11.66,0:13:14.08,Default,,0,0,0,,さ… さっきは どうも
Dialogue: 0,0:13:14.71,0:13:15.67,Default,,0,0,0,,ん？
Dialogue: 0,0:13:16.17,0:13:18.75,Default,,0,0,0,,なに！　乱馬が のぞきを？
Dialogue: 0,0:13:18.84,0:13:22.55,Default,,0,0,0,,そうなのよ もう\N見損なったわ あいつ
Dialogue: 0,0:13:22.63,0:13:24.42,Default,,0,0,0,,俺に任せてくれ
Dialogue: 0,0:13:24.51,0:13:27.34,Default,,0,0,0,,同じ男として見過ごしにできん
Dialogue: 0,0:13:27.43,0:13:28.64,Default,,0,0,0,,ありがとう
Dialogue: 0,0:13:28.72,0:13:31.18,Default,,0,0,0,,良牙くんがいてくれると心強いな
Dialogue: 0,0:13:31.26,0:13:33.39,Default,,0,0,0,,あ… あかねさんの役に立つなら
Dialogue: 0,0:13:33.47,0:13:34.64,Default,,0,0,0,,俺は いつでも
Dialogue: 0,0:13:34.64,0:13:35.02,Default,,0,0,0,,俺は いつでも
Dialogue: 0,0:13:34.64,0:13:35.02,Default,,0,0,0,,{\an6}けっ！
Dialogue: 0,0:13:35.02,0:13:35.10,Default,,0,0,0,,{\an6}けっ！
Dialogue: 0,0:13:35.10,0:13:35.73,Default,,0,0,0,,{\an6}けっ！
Dialogue: 0,0:13:35.10,0:13:35.73,Default,,0,0,0,,-ありがとう\N-アハハッ
Dialogue: 0,0:13:35.73,0:13:36.44,Default,,0,0,0,,-ありがとう\N-アハハッ
Dialogue: 0,0:13:37.23,0:13:39.19,Default,,0,0,0,,くじけてたまるか
Dialogue: 0,0:13:39.69,0:13:40.65,Default,,0,0,0,,しめた！
Dialogue: 0,0:13:41.61,0:13:43.99,Default,,0,0,0,,誰も いない…
Dialogue: 0,0:13:44.94,0:13:46.82,Default,,0,0,0,,ん？　うわっ！
Dialogue: 0,0:13:49.20,0:13:51.03,Default,,0,0,0,,な… なんだ これは
Dialogue: 0,0:13:51.12,0:13:51.95,Default,,0,0,0,,ぐしゃ！
Dialogue: 0,0:13:52.04,0:13:53.58,Default,,0,0,0,,ハハハハハッ
Dialogue: 0,0:13:53.66,0:13:56.37,Default,,0,0,0,,捕まえたぞ この下着泥棒が！
Dialogue: 0,0:13:56.46,0:13:59.21,Default,,0,0,0,,りょ… 良牙 てめえ
Dialogue: 0,0:13:59.29,0:14:01.59,Default,,0,0,0,,男溺泉は どうしたんだよ！
Dialogue: 0,0:14:01.67,0:14:03.30,Default,,0,0,0,,あかねさんのためだ！
Dialogue: 0,0:14:03.38,0:14:06.30,Default,,0,0,0,,たたきのめしてくれる\Nこの女の敵！
Dialogue: 0,0:14:06.38,0:14:08.18,Default,,0,0,0,,こんの裏切り者！
Dialogue: 0,0:14:09.43,0:14:10.64,Default,,0,0,0,,ていっ
Dialogue: 0,0:14:12.14,0:14:12.81,Default,,0,0,0,,あっ…
Dialogue: 0,0:14:13.60,0:14:15.43,Default,,0,0,0,,これで当分 動けまい
Dialogue: 0,0:14:15.52,0:14:16.23,Default,,0,0,0,,ジジイ…
Dialogue: 0,0:14:16.31,0:14:17.85,Default,,0,0,0,,山じゃ 山じゃ
Dialogue: 0,0:14:17.94,0:14:19.65,Default,,0,0,0,,宝の山じゃ！　ワハッ
Dialogue: 0,0:14:19.73,0:14:21.69,Default,,0,0,0,,さあ 今のうちに
Dialogue: 0,0:14:21.77,0:14:23.02,Default,,0,0,0,,ま… 待て ジジイ
Dialogue: 0,0:14:23.11,0:14:25.07,Default,,0,0,0,,-こういうことだったの\N-ん？
Dialogue: 0,0:14:26.53,0:14:27.28,Default,,0,0,0,,ハッ…
Dialogue: 0,0:14:27.36,0:14:27.86,Default,,0,0,0,,おじいさんと\Nグルだったのね 乱馬
Dialogue: 0,0:14:27.86,0:14:29.70,Default,,0,0,0,,おじいさんと\Nグルだったのね 乱馬
Dialogue: 0,0:14:27.86,0:14:29.70,Default,,0,0,0,,{\an6}あ… ううっ…
Dialogue: 0,0:14:29.70,0:14:30.78,Default,,0,0,0,,おじいさんと\Nグルだったのね 乱馬
Dialogue: 0,0:14:33.08,0:14:34.24,Default,,0,0,0,,えっ…
Dialogue: 0,0:14:34.74,0:14:36.37,Default,,0,0,0,,えっ？　えっ？
Dialogue: 0,0:14:39.37,0:14:41.00,Default,,0,0,0,,よいか 乱馬
Dialogue: 0,0:14:41.08,0:14:43.59,Default,,0,0,0,,力を合わせて お宝を…
Dialogue: 0,0:14:43.67,0:14:46.26,Default,,0,0,0,,てめえと一緒に… するな！
Dialogue: 0,0:14:49.30,0:14:52.68,Default,,0,0,0,,乱馬 どこからでも\Nかかってきなさい
Dialogue: 0,0:14:53.89,0:14:55.97,Default,,0,0,0,,覚悟しろよ あかね
Dialogue: 0,0:14:56.06,0:14:58.48,Default,,0,0,0,,俺は どんな手を使っても
Dialogue: 0,0:14:58.56,0:15:01.35,Default,,0,0,0,,女子更衣室に潜入してやるぜ！
Dialogue: 0,0:15:01.44,0:15:03.02,Default,,0,0,0,,偉いぞ 乱馬
Dialogue: 0,0:15:03.11,0:15:05.15,Default,,0,0,0,,下着のために そこまで…
Dialogue: 0,0:15:05.23,0:15:07.11,Default,,0,0,0,,男溺泉のためだ！
Dialogue: 0,0:15:07.19,0:15:09.07,Default,,0,0,0,,-とにかくだ\N-ん？
Dialogue: 0,0:15:09.15,0:15:11.49,Default,,0,0,0,,女相手の小競り合いは…
Dialogue: 0,0:15:12.07,0:15:13.95,Default,,0,0,0,,よし！　気持ち悪い
Dialogue: 0,0:15:14.03,0:15:14.95,Default,,0,0,0,,げこっ
Dialogue: 0,0:15:15.03,0:15:16.20,Default,,0,0,0,,ん？
Dialogue: 0,0:15:16.29,0:15:17.87,Default,,0,0,0,,この手にかぎるぜ！
Dialogue: 0,0:15:17.95,0:15:19.58,Default,,0,0,0,,きゃあ～！
Dialogue: 0,0:15:20.42,0:15:22.13,Default,,0,0,0,,みんな 落ち着いて
Dialogue: 0,0:15:22.21,0:15:23.58,Default,,0,0,0,,全部 おもちゃよ！
Dialogue: 0,0:15:23.67,0:15:24.67,Default,,0,0,0,,きゃあ～！
Dialogue: 0,0:15:24.75,0:15:27.21,Default,,0,0,0,,ヘビよ～ カエルよ～
Dialogue: 0,0:15:27.30,0:15:29.17,Default,,0,0,0,,みんな 本物よ～！
Dialogue: 0,0:15:30.09,0:15:31.72,Default,,0,0,0,,-乱馬！\N-ひょい
Dialogue: 0,0:15:32.30,0:15:32.84,Default,,0,0,0,,てい！
Dialogue: 0,0:15:33.34,0:15:35.22,Default,,0,0,0,,-げこっ\N-ひいい…
Dialogue: 0,0:15:36.43,0:15:37.89,Default,,0,0,0,,げこげこ！
Dialogue: 0,0:15:37.97,0:15:39.10,Default,,0,0,0,,ハッ！
Dialogue: 0,0:15:39.18,0:15:41.69,Default,,0,0,0,,乱馬…
Dialogue: 0,0:15:48.53,0:15:49.07,Default,,0,0,0,,曲者！
Dialogue: 0,0:15:49.15,0:15:50.61,Default,,0,0,0,,きゃああ！
Dialogue: 0,0:15:50.70,0:15:52.91,Default,,0,0,0,,あ… ああ…
Dialogue: 0,0:15:52.99,0:15:54.32,Default,,0,0,0,,あっ…
Dialogue: 0,0:15:56.83,0:15:57.95,Default,,0,0,0,,あっ！
Dialogue: 0,0:15:58.04,0:16:00.75,Default,,0,0,0,,クソッ バレたか
Dialogue: 0,0:16:00.83,0:16:03.42,Default,,0,0,0,,完璧な変装だと思ったのに
Dialogue: 0,0:16:03.50,0:16:06.92,Default,,0,0,0,,す… すまん！\N乱馬かと思ったんだ
Dialogue: 0,0:16:07.00,0:16:07.63,Default,,0,0,0,,へ？
Dialogue: 0,0:16:07.71,0:16:09.88,Default,,0,0,0,,ひ… ひどいです
Dialogue: 0,0:16:09.96,0:16:12.22,Default,,0,0,0,,あたし 何もしてないのに
Dialogue: 0,0:16:12.30,0:16:14.47,Default,,0,0,0,,わ… 悪い
Dialogue: 0,0:16:14.55,0:16:16.10,Default,,0,0,0,,このとおり！
Dialogue: 0,0:16:17.72,0:16:18.60,Default,,0,0,0,,でも…
Dialogue: 0,0:16:20.02,0:16:20.85,Default,,0,0,0,,ん？
Dialogue: 0,0:16:22.48,0:16:23.02,Default,,0,0,0,,へっ？
Dialogue: 0,0:16:23.10,0:16:24.23,Default,,0,0,0,,-好き！\N-なっ…
Dialogue: 0,0:16:24.31,0:16:26.06,Default,,0,0,0,,ちょ… ちょっと
Dialogue: 0,0:16:26.15,0:16:28.40,Default,,0,0,0,,初めて会ったのに そんな…
Dialogue: 0,0:16:28.48,0:16:31.36,Default,,0,0,0,,眼鏡の女の子 嫌いですか～？
Dialogue: 0,0:16:31.44,0:16:33.61,Default,,0,0,0,,いっ いや あの…
Dialogue: 0,0:16:33.70,0:16:35.53,Default,,0,0,0,,俺には好きな人が
Dialogue: 0,0:16:35.62,0:16:37.07,Default,,0,0,0,,それでもいいの！
Dialogue: 0,0:16:37.16,0:16:38.41,Default,,0,0,0,,でっ でも…
Dialogue: 0,0:16:38.49,0:16:39.79,Default,,0,0,0,,そう？
Dialogue: 0,0:16:40.29,0:16:42.29,Default,,0,0,0,,眠ってもらうぜ
Dialogue: 0,0:16:42.37,0:16:44.08,Default,,0,0,0,,何やってんのよ！
Dialogue: 0,0:16:44.17,0:16:45.79,Default,,0,0,0,,-げっ！\N-あ… あかねさん
Dialogue: 0,0:16:45.88,0:16:48.09,Default,,0,0,0,,ご… 誤解だ あかねさん
Dialogue: 0,0:16:48.17,0:16:49.75,Default,,0,0,0,,俺は 決して やましいこ…
Dialogue: 0,0:16:49.84,0:16:50.92,Default,,0,0,0,,うお～い あかね！
Dialogue: 0,0:16:51.01,0:16:52.55,Default,,0,0,0,,おめえ どこまで邪魔すりゃ…
Dialogue: 0,0:16:52.63,0:16:53.76,Default,,0,0,0,,乱馬…
Dialogue: 0,0:16:53.84,0:16:57.22,Default,,0,0,0,,こんな恥ずかしいことしてまで\N下着が欲しいのね
Dialogue: 0,0:16:57.30,0:16:58.43,Default,,0,0,0,,バカ野郎
Dialogue: 0,0:16:58.51,0:17:00.56,Default,,0,0,0,,俺は 下着なんか…
Dialogue: 0,0:17:00.64,0:17:02.06,Default,,0,0,0,,欲しいんでしょ？
Dialogue: 0,0:17:02.14,0:17:02.68,Default,,0,0,0,,え？
Dialogue: 0,0:17:02.77,0:17:04.52,Default,,0,0,0,,全部 あげるわよ
Dialogue: 0,0:17:05.52,0:17:09.15,Default,,0,0,0,,どうせ これ\Nおとりで用意したものだから
Dialogue: 0,0:17:09.23,0:17:10.11,Default,,0,0,0,,あのなあ
Dialogue: 0,0:17:10.19,0:17:12.03,Default,,0,0,0,,{\an6}だから お願い
Dialogue: 0,0:17:12.53,0:17:16.45,Default,,0,0,0,,{\an6}もう これ以上\N犯罪行為を重ねないで
Dialogue: 0,0:17:16.95,0:17:18.82,Default,,0,0,0,,{\an6}乱馬は\Nそんなことしないって
Dialogue: 0,0:17:18.91,0:17:20.37,Default,,0,0,0,,{\an6}信じてたのに
Dialogue: 0,0:17:20.99,0:17:21.83,Default,,0,0,0,,{\an6}さよなら！
Dialogue: 0,0:17:21.91,0:17:23.33,Default,,0,0,0,,いや 待て～い
Dialogue: 0,0:17:23.41,0:17:25.54,Default,,0,0,0,,俺は 男溺泉を掘るために…
Dialogue: 0,0:17:27.67,0:17:29.21,Default,,0,0,0,,男溺泉？
Dialogue: 0,0:17:29.92,0:17:33.67,Default,,0,0,0,,この女子更衣室の床下に男溺泉が？
Dialogue: 0,0:17:34.26,0:17:36.26,Default,,0,0,0,,そうだったの 乱馬
Dialogue: 0,0:17:36.34,0:17:38.43,Default,,0,0,0,,これがウソをついてる目か？
Dialogue: 0,0:17:38.51,0:17:39.01,Default,,0,0,0,,{\an6}がぴょん
Dialogue: 0,0:17:39.01,0:17:39.85,Default,,0,0,0,,{\an6}がぴょん
Dialogue: 0,0:17:39.01,0:17:39.85,Default,,0,0,0,,つくなら\Nもっとマシなウソをつけ！
Dialogue: 0,0:17:39.85,0:17:41.18,Default,,0,0,0,,つくなら\Nもっとマシなウソをつけ！
Dialogue: 0,0:17:41.26,0:17:42.43,Default,,0,0,0,,あがっ…
Dialogue: 0,0:17:42.52,0:17:46.06,Default,,0,0,0,,さっきは\N見事な化けっぷりだったな 乱馬
Dialogue: 0,0:17:46.14,0:17:48.48,Default,,0,0,0,,フッ そうさ
Dialogue: 0,0:17:48.56,0:17:52.02,Default,,0,0,0,,俺は まっとうに女の子と\N付き合ったことがねえよ
Dialogue: 0,0:17:52.86,0:17:53.69,Default,,0,0,0,,ん？
Dialogue: 0,0:17:53.78,0:17:56.03,Default,,0,0,0,,ましてや 告白されたことなんか
Dialogue: 0,0:17:56.61,0:18:00.53,Default,,0,0,0,,生まれてこのかた 一度だって…
Dialogue: 0,0:18:00.62,0:18:02.20,Default,,0,0,0,,え？　聞いた？
Dialogue: 0,0:18:02.29,0:18:03.54,Default,,0,0,0,,かわいそ～
Dialogue: 0,0:18:05.25,0:18:06.50,Default,,0,0,0,,それが どうした
Dialogue: 0,0:18:07.58,0:18:10.46,Default,,0,0,0,,聞かせてもらおうか 乱馬
Dialogue: 0,0:18:10.54,0:18:13.46,Default,,0,0,0,,なんのために\Nあんな ふざけたまねをした！
Dialogue: 0,0:18:14.21,0:18:17.22,Default,,0,0,0,,決まってんだろ　男溺泉
Dialogue: 0,0:18:17.30,0:18:19.14,Default,,0,0,0,,それで 貴様は…
Dialogue: 0,0:18:21.47,0:18:23.60,Default,,0,0,0,,何度も 何度も
Dialogue: 0,0:18:23.68,0:18:27.31,Default,,0,0,0,,男の純情を\N踏みにじったというんだな！
Dialogue: 0,0:18:27.89,0:18:29.23,Default,,0,0,0,,やかましい！
Dialogue: 0,0:18:29.31,0:18:32.27,Default,,0,0,0,,大体 男溺泉の地図を\N持ってきたのは
Dialogue: 0,0:18:32.36,0:18:33.90,Default,,0,0,0,,おめえのほうじゃねえか！
Dialogue: 0,0:18:33.90,0:18:34.48,Default,,0,0,0,,おめえのほうじゃねえか！
Dialogue: 0,0:18:33.90,0:18:34.48,Default,,0,0,0,,{\an6}ぐおっ
Dialogue: 0,0:18:34.57,0:18:35.48,Default,,0,0,0,,え？
Dialogue: 0,0:18:35.57,0:18:36.90,Default,,0,0,0,,ぐっ…
Dialogue: 0,0:18:37.99,0:18:41.49,Default,,0,0,0,,良牙くん それ本当なの？
Dialogue: 0,0:18:41.57,0:18:44.74,Default,,0,0,0,,どうして あなたが\N男溺泉の地図なんか…
Dialogue: 0,0:18:44.83,0:18:45.41,Default,,0,0,0,,えっ…
Dialogue: 0,0:18:47.25,0:18:49.58,Default,,0,0,0,,ハッ！　良牙くん
Dialogue: 0,0:18:49.67,0:18:50.92,Default,,0,0,0,,あなた もしや…
Dialogue: 0,0:18:51.00,0:18:53.17,Default,,0,0,0,,ハッ… うう…
Dialogue: 0,0:18:53.67,0:18:54.67,Default,,0,0,0,,ううっ…
Dialogue: 0,0:18:59.38,0:19:01.14,Default,,0,0,0,,アハハハハッ
Dialogue: 0,0:19:01.22,0:19:03.14,Default,,0,0,0,,ウフフフフッ
Dialogue: 0,0:19:09.10,0:19:10.81,Default,,0,0,0,,バ… バレた
Dialogue: 0,0:19:10.90,0:19:13.81,Default,,0,0,0,,乱馬の体質を治そうとして…
Dialogue: 0,0:19:14.61,0:19:16.57,Default,,0,0,0,,なんて いい人なの！
Dialogue: 0,0:19:17.28,0:19:20.32,Default,,0,0,0,,あかねが鈍くてよかったなあ\NＰちゃん
Dialogue: 0,0:19:20.40,0:19:22.37,Default,,0,0,0,,くうう…
Dialogue: 0,0:19:22.45,0:19:24.41,Default,,0,0,0,,くっ！　うう…
Dialogue: 0,0:19:24.91,0:19:27.29,Default,,0,0,0,,くっ… だ… 誰が…
Dialogue: 0,0:19:28.00,0:19:30.62,Default,,0,0,0,,Ｐちゃんだ！
Dialogue: 0,0:19:32.58,0:19:34.04,Default,,0,0,0,,爆砕…
Dialogue: 0,0:19:34.13,0:19:36.92,Default,,0,0,0,,殴る所が違うだろ！
Dialogue: 0,0:19:37.00,0:19:40.22,Default,,0,0,0,,点穴！
Dialogue: 0,0:19:44.55,0:19:45.81,Default,,0,0,0,,うっ！
Dialogue: 0,0:19:55.69,0:19:58.11,Default,,0,0,0,,こっ この手応え…
Dialogue: 0,0:20:02.20,0:20:03.49,Default,,0,0,0,,あっ…
Dialogue: 0,0:20:03.57,0:20:05.16,Default,,0,0,0,,やった！
Dialogue: 0,0:20:16.71,0:20:20.97,Default,,0,0,0,,{\an6}男溺泉…\N本当に あったんだわ
Dialogue: 0,0:20:22.47,0:20:23.18,Default,,0,0,0,,おい
Dialogue: 0,0:20:24.47,0:20:28.68,Default,,0,0,0,,あれは ほんっとうに\N男溺泉の地図だったんだろうな
Dialogue: 0,0:20:28.76,0:20:30.06,Default,,0,0,0,,ぶきっ
Dialogue: 0,0:20:30.14,0:20:32.69,Default,,0,0,0,,じゃあ なんで 男に戻れねえんだ
Dialogue: 0,0:20:32.77,0:20:34.56,Default,,0,0,0,,なんとか言え このブタ！
Dialogue: 0,0:20:34.56,0:20:35.15,Default,,0,0,0,,なんとか言え このブタ！
Dialogue: 0,0:20:34.56,0:20:35.15,Default,,0,0,0,,{\an6}ぶきーっ！\Nぶきぶき ぶきぶき
Dialogue: 0,0:20:35.15,0:20:36.65,Default,,0,0,0,,{\an6}ぶきーっ！\Nぶきぶき ぶきぶき
Dialogue: 0,0:20:36.94,0:20:38.52,Default,,0,0,0,,あっ…
Dialogue: 0,0:20:39.90,0:20:41.03,Default,,0,0,0,,ん？
Dialogue: 0,0:20:42.99,0:20:45.32,Default,,0,0,0,,長い間 ご愛顧いただきました⸺
Dialogue: 0,0:20:45.41,0:20:47.03,Default,,0,0,0,,和風男溺泉は
Dialogue: 0,0:20:47.12,0:20:48.74,Default,,0,0,0,,閉店いたしました
Dialogue: 0,0:20:48.83,0:20:52.62,Default,,0,0,0,,以後は 中国呪泉郷 元祖男溺泉を
Dialogue: 0,0:20:52.71,0:20:54.25,Default,,0,0,0,,ご利用ください
Dialogue: 0,0:20:55.33,0:20:58.38,Default,,0,0,0,,あのな… 風呂屋じゃねえだろ
Dialogue: 0,0:20:58.88,0:21:02.72,Default,,0,0,0,,こら～！\N誰だ 水道管 壊したのは！
Dialogue: 0,0:21:02.80,0:21:04.43,Default,,0,0,0,,早乙女くんです
Dialogue: 0,0:21:08.60,0:21:10.77,Default,,0,0,0,,どうしたんです？　この下着
Dialogue: 0,0:21:10.85,0:21:12.18,Default,,0,0,0,,拾った
Dialogue: 0,0:21:13.52,0:21:14.81,Default,,0,0,0,,ぷう…
Dialogue: 0,0:21:15.39,0:21:17.44,Default,,0,0,0,,どうしたの？　Ｐちゃん
Dialogue: 0,0:21:17.52,0:21:18.98,Default,,0,0,0,,元気ないわね
Dialogue: 0,0:21:19.06,0:21:23.11,Default,,0,0,0,,おめえは やっぱり\Nこのまんまのほうが幸せだよ
Dialogue: 0,0:21:23.19,0:21:25.28,Default,,0,0,0,,ぷう…