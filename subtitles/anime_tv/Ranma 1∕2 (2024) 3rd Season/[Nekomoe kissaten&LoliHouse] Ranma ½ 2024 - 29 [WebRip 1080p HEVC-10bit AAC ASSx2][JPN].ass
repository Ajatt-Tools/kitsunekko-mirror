Dialogue: 0,0:00:14.15,0:00:15.90,Dial_JP,,0,0,0,,よし　始めよう
Dialogue: 0,0:00:20.36,0:00:23.97,Dial_JP,,0,0,0,,優しく現像液に浸して
Dialogue: 0,0:00:30.25,0:00:32.41,Dial_JP,,0,0,0,,うん　いいぞ
Dialogue: 0,0:00:35.69,0:00:38.30,Dial_JP,,0,0,0,,想像以上の仕上がりだ
Dialogue: 0,0:00:47.41,0:00:51.39,Dial_JP,,0,0,0,,これは僕が撮影した　あかねさんのネガフィルム
Dialogue: 0,0:00:52.33,0:00:54.20,Dial_JP,,0,0,0,,このネガさえあれば
Dialogue: 0,0:00:54.20,0:00:58.86,Dial_JP,,0,0,0,,いつでも　いくらでも　写真を焼き増しできるんだあ
Dialogue: 0,0:02:43.18,0:02:48.07,Dial_JP,,0,0,0,,ああ　せっかくクッキー焼いても　あげる彼　いないしな
Dialogue: 0,0:02:51.30,0:02:54.24,Dial_JP,,0,0,0,,せっかく焼いても乱馬さまには
Dialogue: 0,0:02:58.63,0:02:59.51,Dial_JP,,0,0,0,,先生
Dialogue: 0,0:03:00.13,0:03:02.07,Dial_JP,,0,0,0,,どうしました九能さん
Dialogue: 0,0:03:02.07,0:03:05.37,Dial_JP,,0,0,0,,私　急用を思い立ちましたので
Dialogue: 0,0:03:07.80,0:03:10.25,Dial_JP,,0,0,0,,早退させていただきます
Dialogue: 0,0:03:11.94,0:03:13.44,Dial_JP,,0,0,0,,黒バラ吹雪
Dialogue: 0,0:03:20.05,0:03:22.63,Dial_JP,,0,0,0,,九能小太刀　早退
Dialogue: 0,0:03:35.45,0:03:38.88,Dial_JP,,0,0,0,,待っていてくださいね　乱馬さま
Dialogue: 0,0:03:48.48,0:03:50.04,Dial_JP,,0,0,0,,あかねさん
Dialogue: 0,0:03:50.04,0:03:53.11,Dial_JP,,0,0,0,,お菓子を作ってる姿もステキだあ
Dialogue: 0,0:03:54.48,0:03:56.68,Dial_JP,,0,0,0,,なーに撮ってんだ　五寸釘
Dialogue: 0,0:03:56.68,0:04:00.44,Dial_JP,,0,0,0,,やぁ　早乙女君　君は何してるんだい
Dialogue: 0,0:04:06.59,0:04:09.31,Dial_JP,,0,0,0,,おめーは　また性懲りもなく
Dialogue: 0,0:04:09.31,0:04:11.95,Dial_JP,,0,0,0,,あかねばっか撮ってて　飽きねえのか
Dialogue: 0,0:04:13.09,0:04:15.27,Dial_JP,,0,0,0,,飽きるなんて　とんでもない
Dialogue: 0,0:04:15.27,0:04:16.77,Dial_JP,,0,0,0,,あかねさんは僕の
Dialogue: 0,0:04:16.77,0:04:18.26,Dial_JP,,0,0,0,,没収
Dialogue: 0,0:04:18.26,0:04:19.18,Dial_JP,,0,0,0,,何するんです
Dialogue: 0,0:04:20.28,0:04:23.15,Dial_JP,,0,0,0,,もう変なこと考えるなよなっ
Dialogue: 0,0:04:24.65,0:04:28.18,Dial_JP,,0,0,0,,ふん　僕を甘く見るなよ　早乙女
Dialogue: 0,0:04:28.18,0:04:31.03,Dial_JP,,0,0,0,,フィルムの予備なら　いっくらでもあるんだからなっ
Dialogue: 0,0:04:35.45,0:04:37.08,Dial_JP,,0,0,0,,上手に焼けた
Dialogue: 0,0:04:38.13,0:04:39.00,Dial_JP,,0,0,0,,クッキー
Dialogue: 0,0:04:39.00,0:04:40.56,Dial_JP,,0,0,0,,味見してやろうか
Dialogue: 0,0:04:40.56,0:04:42.00,Dial_JP,,0,0,0,,あげないよ～だ
Dialogue: 0,0:04:43.02,0:04:44.48,Dial_JP,,0,0,0,,女の幸せ
Dialogue: 0,0:04:47.45,0:04:52.69,Dial_JP,,0,0,0,,それは　愛する九能帯刀のために手料理を作ること
Dialogue: 0,0:04:53.77,0:04:55.14,Dial_JP,,0,0,0,,天道あかね
Dialogue: 0,0:04:55.93,0:04:57.64,Dial_JP,,0,0,0,,幸せにしてやる
Dialogue: 0,0:04:57.64,0:05:00.81,Dial_JP,,0,0,0,,どうして素直に　「くれ」って言えないんですか
Dialogue: 0,0:05:02.03,0:05:04.59,Dial_JP,,0,0,0,,やめとけよ　九能先輩
Dialogue: 0,0:05:04.59,0:05:06.78,Dial_JP,,0,0,0,,気が遠くなるほどマズいぞ
Dialogue: 0,0:05:07.61,0:05:12.53,Dial_JP,,0,0,0,,うまいかマズいか　食べてから文句　言いなさいよ
Dialogue: 0,0:05:20.01,0:05:20.98,Dial_JP,,0,0,0,,何これ
Dialogue: 0,0:05:20.98,0:05:23.75,Dial_JP,,0,0,0,,かわいいでしょ　動物クッキーよ
Dialogue: 0,0:05:23.75,0:05:26.07,Dial_JP,,0,0,0,,ど　動物
Dialogue: 0,0:05:26.63,0:05:27.38,Dial_JP,,0,0,0,,タコか
Dialogue: 0,0:05:28.73,0:05:30.89,Dial_JP,,0,0,0,,失礼ね　ペンギンよ
Dialogue: 0,0:05:32.25,0:05:33.97,Dial_JP,,0,0,0,,ほぉ　カニか
Dialogue: 0,0:05:33.97,0:05:35.39,Dial_JP,,0,0,0,,ライオンよ
Dialogue: 0,0:05:36.63,0:05:38.19,Dial_JP,,0,0,0,,分かった　ミジンコだ
Dialogue: 0,0:05:38.19,0:05:39.35,Dial_JP,,0,0,0,,ウサギよ
Dialogue: 0,0:05:39.81,0:05:41.69,Dial_JP,,0,0,0,,形を楽しんでないで
Dialogue: 0,0:05:41.69,0:05:45.28,Dial_JP,,0,0,0,,さっさと食わんか
Dialogue: 0,0:05:45.61,0:05:47.08,Dial_JP,,0,0,0,,ちょっと待て
Dialogue: 0,0:05:49.47,0:05:51.08,Dial_JP,,0,0,0,,決心が　つかねえ
Dialogue: 0,0:06:07.42,0:06:09.87,Dial_JP,,0,0,0,,怪しげなお菓子ですこと
Dialogue: 0,0:06:10.82,0:06:11.86,Dial_JP,,0,0,0,,あんたは
Dialogue: 0,0:06:13.66,0:06:16.54,Dial_JP,,0,0,0,,お久しぶりです　乱馬さま
Dialogue: 0,0:06:17.93,0:06:19.63,Dial_JP,,0,0,0,,黒バラの小太刀
Dialogue: 0,0:06:20.97,0:06:22.98,Dial_JP,,0,0,0,,わが　変態妹ではないか
Dialogue: 0,0:06:24.23,0:06:25.86,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:06:26.86,0:06:28.32,Dial_JP,,0,0,0,,これを
Dialogue: 0,0:06:36.86,0:06:38.33,Dial_JP,,0,0,0,,分かった　星だ
Dialogue: 0,0:06:38.33,0:06:39.66,Dial_JP,,0,0,0,,ヒトデです
Dialogue: 0,0:06:39.66,0:06:41.90,Dial_JP,,0,0,0,,私のクッキー　返してよ
Dialogue: 0,0:06:42.75,0:06:44.33,Dial_JP,,0,0,0,,このようなもの
Dialogue: 0,0:06:44.33,0:06:46.85,Dial_JP,,0,0,0,,乱馬さまのお口に合いませんわ
Dialogue: 0,0:06:48.31,0:06:49.55,Dial_JP,,0,0,0,,ちょっと
Dialogue: 0,0:06:53.08,0:06:54.34,Dial_JP,,0,0,0,,乱馬が悪いんだ
Dialogue: 0,0:06:54.84,0:06:56.60,Dial_JP,,0,0,0,,すぐ食べないから
Dialogue: 0,0:06:58.89,0:07:01.10,Dial_JP,,0,0,0,,あのな　何で俺が
Dialogue: 0,0:07:04.06,0:07:06.40,Dial_JP,,0,0,0,,一生懸命　作ったのに
Dialogue: 0,0:07:08.16,0:07:09.40,Dial_JP,,0,0,0,,バカ
Dialogue: 0,0:07:10.91,0:07:13.55,Dial_JP,,0,0,0,,ったく　俺のせいじゃねえだろ
Dialogue: 0,0:07:14.46,0:07:15.32,Dial_JP,,0,0,0,,いた
Dialogue: 0,0:07:17.01,0:07:18.28,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:07:18.28,0:07:21.04,Dial_JP,,0,0,0,,きっと追ってきてくださると　思っていました
Dialogue: 0,0:07:21.04,0:07:24.58,Dial_JP,,0,0,0,,おめーじゃなくって　クッキー　追ってきたんだよ
Dialogue: 0,0:07:26.02,0:07:27.54,Dial_JP,,0,0,0,,ウソばっかり
Dialogue: 0,0:07:27.54,0:07:29.62,Dial_JP,,0,0,0,,ホントだっつうの
Dialogue: 0,0:07:30.85,0:07:31.92,Dial_JP,,0,0,0,,お　乱馬
Dialogue: 0,0:07:32.88,0:07:34.09,Dial_JP,,0,0,0,,待て
Dialogue: 0,0:07:34.09,0:07:35.25,Dial_JP,,0,0,0,,逃げるな
Dialogue: 0,0:07:35.95,0:07:37.79,Dial_JP,,0,0,0,,明日も　遊ぼうな
Dialogue: 0,0:07:38.68,0:07:40.22,Dial_JP,,0,0,0,,二度と来るな
Dialogue: 0,0:07:45.69,0:07:46.74,Dial_JP,,0,0,0,,くそぉ
Dialogue: 0,0:07:48.82,0:07:51.07,Dial_JP,,0,0,0,,う　れ　し　い
Dialogue: 0,0:07:51.90,0:07:53.36,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:07:57.53,0:07:58.53,Dial_JP,,0,0,0,,乱馬
Dialogue: 0,0:08:00.46,0:08:01.80,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:08:02.76,0:08:04.92,Dial_JP,,0,0,0,,続きは　いずれまた
Dialogue: 0,0:08:08.07,0:08:10.45,Dial_JP,,0,0,0,,こ　怖かった
Dialogue: 0,0:08:12.25,0:08:13.21,Dial_JP,,0,0,0,,いたいた
Dialogue: 0,0:08:14.06,0:08:15.46,Dial_JP,,0,0,0,,私のクッキー
Dialogue: 0,0:08:17.49,0:08:18.40,Dial_JP,,0,0,0,,乱馬
Dialogue: 0,0:08:18.40,0:08:20.39,Dial_JP,,0,0,0,,小太刀のクッキー　もらうぜ
Dialogue: 0,0:08:23.19,0:08:24.18,Dial_JP,,0,0,0,,いける
Dialogue: 0,0:08:24.53,0:08:27.13,Dial_JP,,0,0,0,,さっ　私の食べてみて
Dialogue: 0,0:08:27.13,0:08:27.87,Dial_JP,,0,0,0,,いい
Dialogue: 0,0:08:27.87,0:08:29.02,Dial_JP,,0,0,0,,何でよ
Dialogue: 0,0:08:30.04,0:08:32.28,Dial_JP,,0,0,0,,食欲ねえんだよ
Dialogue: 0,0:08:32.99,0:08:34.66,Dial_JP,,0,0,0,,今のショックで
Dialogue: 0,0:08:39.13,0:08:40.99,Dial_JP,,0,0,0,,どれどれ　わしが
Dialogue: 0,0:08:49.29,0:08:52.10,Dial_JP,,0,0,0,,マズいよ　マズいよ　マズいよ
Dialogue: 0,0:08:52.99,0:08:53.84,Dial_JP,,0,0,0,,何よ
Dialogue: 0,0:08:53.84,0:08:54.88,Dial_JP,,0,0,0,,嫌みね
Dialogue: 0,0:08:59.26,0:09:02.10,Dial_JP,,0,0,0,,やはり眠り薬が仕込んであったか
Dialogue: 0,0:09:30.79,0:09:34.72,Dial_JP,,0,0,0,,もう　相変わらず　はた迷惑な妹さんですね
Dialogue: 0,0:09:34.72,0:09:37.70,Dial_JP,,0,0,0,,うむ　もはや　返す言葉もない
Dialogue: 0,0:09:38.39,0:09:42.42,Dial_JP,,0,0,0,,さっきの　誰にも見られてねえよな
Dialogue: 0,0:09:46.47,0:09:50.02,Dial_JP,,0,0,0,,早乙女の浮気現場を　隠し撮りしてしまった
Dialogue: 0,0:09:50.80,0:09:52.04,Dial_JP,,0,0,0,,どうしよう
Dialogue: 0,0:09:52.04,0:09:54.53,Dial_JP,,0,0,0,,そのフィルム下さい
Dialogue: 0,0:10:01.41,0:10:02.85,Dial_JP,,0,0,0,,乱馬のヤツ
Dialogue: 0,0:10:02.85,0:10:06.72,Dial_JP,,0,0,0,,最初からマズいって決め付けて　食べもしないなんて
Dialogue: 0,0:10:07.75,0:10:09.19,Dial_JP,,0,0,0,,乱馬のバカ
Dialogue: 0,0:10:21.09,0:10:23.55,Dial_JP,,0,0,0,,クッキーの　おいしい作り方
Dialogue: 0,0:10:24.09,0:10:28.19,Dial_JP,,0,0,0,,うん　かすみお姉ちゃん　教えてくれる
Dialogue: 0,0:10:28.19,0:10:31.56,Dial_JP,,0,0,0,,あら　料理を勉強する気になったのね
Dialogue: 0,0:10:32.24,0:10:34.52,Dial_JP,,0,0,0,,まあ　そんなとこ
Dialogue: 0,0:10:34.52,0:10:37.20,Dial_JP,,0,0,0,,でも　いきなり　どうしたの
Dialogue: 0,0:10:38.01,0:10:39.99,Dial_JP,,0,0,0,,もしかして乱馬君のため
Dialogue: 0,0:10:39.99,0:10:43.02,Dial_JP,,0,0,0,,そ…　そんなんじゃないもん
Dialogue: 0,0:10:44.26,0:10:49.47,Dial_JP,,0,0,0,,ただ　あいつに　「おいしい」って　一言　言わせたいだけで
Dialogue: 0,0:10:50.26,0:10:51.42,Dial_JP,,0,0,0,,とにかく
Dialogue: 0,0:10:51.42,0:10:53.25,Dial_JP,,0,0,0,,乱馬に負けたくないの
Dialogue: 0,0:10:55.04,0:10:56.11,Dial_JP,,0,0,0,,分かったわ
Dialogue: 0,0:10:59.63,0:11:03.80,Dial_JP,,0,0,0,,とびっきり　おいしいクッキーの　作り方　教えてあげるわね
Dialogue: 0,0:11:03.80,0:11:04.64,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:11:05.55,0:11:07.38,Dial_JP,,0,0,0,,お砂糖　200g
Dialogue: 0,0:11:08.61,0:11:10.81,Dial_JP,,0,0,0,,あかね　それ塩よ
Dialogue: 0,0:11:10.81,0:11:13.16,Dial_JP,,0,0,0,,バニラエッセンスを少々
Dialogue: 0,0:11:13.77,0:11:15.56,Dial_JP,,0,0,0,,あかね　それラー油よ
Dialogue: 0,0:11:41.84,0:11:43.22,Dial_JP,,0,0,0,,できた
Dialogue: 0,0:11:43.89,0:11:46.22,Dial_JP,,0,0,0,,うん　いい焼き色
Dialogue: 0,0:11:47.35,0:11:48.79,Dial_JP,,0,0,0,,頑張ったわね
Dialogue: 0,0:11:52.78,0:11:54.64,Dial_JP,,0,0,0,,乱馬　勝負
Dialogue: 0,0:11:54.64,0:11:57.10,Dial_JP,,0,0,0,,ありがたく　いただけ　乱馬
Dialogue: 0,0:11:58.36,0:11:59.45,Dial_JP,,0,0,0,,親父は？
Dialogue: 0,0:11:59.91,0:12:02.37,Dial_JP,,0,0,0,,わしは　今　満腹でな
Dialogue: 0,0:12:04.74,0:12:06.28,Dial_JP,,0,0,0,,黒バラマーク？
Dialogue: 0,0:12:06.73,0:12:07.79,Dial_JP,,0,0,0,,小太刀か
Dialogue: 0,0:12:08.46,0:12:11.44,Dial_JP,,0,0,0,,手料理を作って　お待ちしています
Dialogue: 0,0:12:11.44,0:12:13.60,Dial_JP,,0,0,0,,今すぐ　いらしてください
Dialogue: 0,0:12:13.60,0:12:15.46,Dial_JP,,0,0,0,,手料理？
Dialogue: 0,0:12:15.95,0:12:18.15,Dial_JP,,0,0,0,,ったく　しつこい女ね
Dialogue: 0,0:12:18.64,0:12:20.59,Dial_JP,,0,0,0,,人のこと言えねえだろ
Dialogue: 0,0:12:25.26,0:12:30.33,Dial_JP,,0,0,0,,追伸　あの時の２人の記念写真を同封します
Dialogue: 0,0:12:34.53,0:12:38.94,Dial_JP,,0,0,0,,うれしくて町じゅうに　ばらまきたい気分ですわ
Dialogue: 0,0:12:42.83,0:12:43.91,Dial_JP,,0,0,0,,ちょっと
Dialogue: 0,0:12:47.29,0:12:49.91,Dial_JP,,0,0,0,,卑怯者　食べないで逃げる気？
Dialogue: 0,0:12:50.38,0:12:51.95,Dial_JP,,0,0,0,,それどころじゃねえ
Dialogue: 0,0:12:52.50,0:12:53.33,Dial_JP,,0,0,0,,はあ？
Dialogue: 0,0:12:57.08,0:13:00.33,Dial_JP,,0,0,0,,ちくしょう　あんな写真　ばらまかれてたまるか
Dialogue: 0,0:13:01.34,0:13:03.42,Dial_JP,,0,0,0,,待ってろよ　小太刀
Dialogue: 0,0:13:12.14,0:13:15.30,Dial_JP,,0,0,0,,乱馬さま　早くいらして
Dialogue: 0,0:13:16.38,0:13:18.64,Dial_JP,,0,0,0,,こうして１人で待っていると…
Dialogue: 0,0:13:23.48,0:13:24.24,Dial_JP,,0,0,0,,小太刀
Dialogue: 0,0:13:25.28,0:13:26.54,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:13:33.21,0:13:35.79,Dial_JP,,0,0,0,,よみがえる　あの時の喜び
Dialogue: 0,0:13:36.30,0:13:40.42,Dial_JP,,0,0,0,,この幸せを　皆さんにも分けてあげましょう
Dialogue: 0,0:13:47.98,0:13:49.55,Dial_JP,,0,0,0,,そ　れ
Dialogue: 0,0:13:59.74,0:14:03.12,Dial_JP,,0,0,0,,乱馬さま　来てくれたんですね
Dialogue: 0,0:14:03.12,0:14:05.18,Dial_JP,,0,0,0,,お前が脅してきたんだろ
Dialogue: 0,0:14:05.18,0:14:07.12,Dial_JP,,0,0,0,,こんなもん焼き増ししやがって
Dialogue: 0,0:14:07.12,0:14:08.99,Dial_JP,,0,0,0,,証拠隠滅でい
Dialogue: 0,0:14:12.70,0:14:15.87,Dial_JP,,0,0,0,,まあ　写真お好きなんですね
Dialogue: 0,0:14:16.78,0:14:18.62,Dial_JP,,0,0,0,,まだまだ焼けてます
Dialogue: 0,0:14:18.62,0:14:20.41,Dial_JP,,0,0,0,,たっぷり召し上がれ
Dialogue: 0,0:14:20.41,0:14:21.67,Dial_JP,,0,0,0,,クソ
Dialogue: 0,0:14:22.23,0:14:24.84,Dial_JP,,0,0,0,,とても　こんなに食い切れるかよ
Dialogue: 0,0:14:25.26,0:14:26.92,Dial_JP,,0,0,0,,本を絶たなきゃ…
Dialogue: 0,0:14:28.43,0:14:28.92,Dial_JP,,0,0,0,,そうだ
Dialogue: 0,0:14:33.10,0:14:34.96,Dial_JP,,0,0,0,,この写真のネガが食いたい
Dialogue: 0,0:14:34.96,0:14:35.68,Dial_JP,,0,0,0,,まあ
Dialogue: 0,0:14:36.63,0:14:40.20,Dial_JP,,0,0,0,,俺のために作ってくれるかい　ネガ料理
Dialogue: 0,0:14:46.87,0:14:51.18,Dial_JP,,0,0,0,,はい　乱馬さまのためなら喜んで
Dialogue: 0,0:15:00.54,0:15:03.06,Dial_JP,,0,0,0,,さあ　乱馬さま　こちらへ
Dialogue: 0,0:15:04.58,0:15:06.25,Dial_JP,,0,0,0,,お邪魔しまーす
Dialogue: 0,0:15:09.87,0:15:12.10,Dial_JP,,0,0,0,,よお　九能先輩
Dialogue: 0,0:15:12.10,0:15:14.42,Dial_JP,,0,0,0,,わが家に何の用だ
Dialogue: 0,0:15:14.42,0:15:16.75,Dial_JP,,0,0,0,,私が招待したのです
Dialogue: 0,0:15:17.06,0:15:17.76,Dial_JP,,0,0,0,,ほお
Dialogue: 0,0:15:18.33,0:15:23.26,Dial_JP,,0,0,0,,ということは　天道あかねへの横恋慕を諦めたわけだ
Dialogue: 0,0:15:23.76,0:15:25.86,Dial_JP,,0,0,0,,誰が横恋慕しとるか
Dialogue: 0,0:15:28.10,0:15:32.92,Dial_JP,,0,0,0,,もはや　邪魔者は消えたあ
Dialogue: 0,0:15:35.35,0:15:37.04,Dial_JP,,0,0,0,,九能せんぱい
Dialogue: 0,0:15:37.04,0:15:38.13,Dial_JP,,0,0,0,,あかねくん
Dialogue: 0,0:15:39.88,0:15:41.15,Dial_JP,,0,0,0,,こいつ
Dialogue: 0,0:15:41.15,0:15:44.21,Dial_JP,,0,0,0,,やん　九能先輩のイジワル
Dialogue: 0,0:15:44.21,0:15:45.76,Dial_JP,,0,0,0,,こいつ
Dialogue: 0,0:15:47.35,0:15:48.67,Dial_JP,,0,0,0,,こいつ
Dialogue: 0,0:15:50.53,0:15:54.51,Dial_JP,,0,0,0,,お前らも頑張って　不幸せな家庭を築くのだぞ
Dialogue: 0,0:15:58.96,0:16:01.02,Dial_JP,,0,0,0,,ありがとう　お兄さま
Dialogue: 0,0:16:02.30,0:16:04.99,Dial_JP,,0,0,0,,あ　の　な
Dialogue: 0,0:16:04.99,0:16:07.97,Dial_JP,,0,0,0,,俺は小太刀の手料理を食いに来ただけだ
Dialogue: 0,0:16:07.97,0:16:10.65,Dial_JP,,0,0,0,,小太刀の手料理を食べにねえ
Dialogue: 0,0:16:11.98,0:16:15.11,Dial_JP,,0,0,0,,乱馬　弱みでも握られてんの？
Dialogue: 0,0:16:15.82,0:16:17.68,Dial_JP,,0,0,0,,あかねい　いつの間に
Dialogue: 0,0:16:18.24,0:16:20.15,Dial_JP,,0,0,0,,おお　天道あかね
Dialogue: 0,0:16:20.15,0:16:22.91,Dial_JP,,0,0,0,,早速交際を申し込みに来たな
Dialogue: 0,0:16:22.91,0:16:25.54,Dial_JP,,0,0,0,,誰が交際を申し込んどりますか
Dialogue: 0,0:16:28.50,0:16:31.91,Dial_JP,,0,0,0,,今頃　のこのこ現れても手遅れです
Dialogue: 0,0:16:31.91,0:16:32.88,Dial_JP,,0,0,0,,何よ
Dialogue: 0,0:16:32.88,0:16:36.93,Dial_JP,,0,0,0,,乱馬さまはもはや　私の手料理のとりこ
Dialogue: 0,0:16:38.84,0:16:39.74,Dial_JP,,0,0,0,,そ　れ
Dialogue: 0,0:16:39.74,0:16:40.22,Dial_JP,,0,0,0,,マズい
Dialogue: 0,0:16:45.48,0:16:46.81,Dial_JP,,0,0,0,,おいしいですか
Dialogue: 0,0:16:47.21,0:16:47.85,Dial_JP,,0,0,0,,うんうん…
Dialogue: 0,0:16:49.03,0:16:52.56,Dial_JP,,0,0,0,,乱馬のヤツ　絶対ゆすられてるんだ
Dialogue: 0,0:16:53.38,0:16:55.15,Dial_JP,,0,0,0,,さっさと帰れ　あかね
Dialogue: 0,0:16:55.51,0:16:57.51,Dial_JP,,0,0,0,,このまま帰るもんですか
Dialogue: 0,0:16:58.51,0:17:01.11,Dial_JP,,0,0,0,,九能先輩のお部屋　見たいな
Dialogue: 0,0:17:01.11,0:17:02.49,Dial_JP,,0,0,0,,僕の部屋を？
Dialogue: 0,0:17:03.11,0:17:04.83,Dial_JP,,0,0,0,,よし　見せてやろう
Dialogue: 0,0:17:06.14,0:17:07.29,Dial_JP,,0,0,0,,こ…こら
Dialogue: 0,0:17:07.91,0:17:09.14,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:17:09.14,0:17:11.63,Dial_JP,,0,0,0,,メインディッシュはこれからですわよ
Dialogue: 0,0:17:12.46,0:17:15.10,Dial_JP,,0,0,0,,私はキッチンで待っておりますので
Dialogue: 0,0:17:15.10,0:17:17.49,Dial_JP,,0,0,0,,材料を取ってきてくださいな
Dialogue: 0,0:17:21.54,0:17:23.89,Dial_JP,,0,0,0,,さあ　ここに座ってくれ
Dialogue: 0,0:17:25.58,0:17:26.64,Dial_JP,,0,0,0,,どうも…
Dialogue: 0,0:17:36.34,0:17:37.95,Dial_JP,,0,0,0,,それはもしや…
Dialogue: 0,0:17:37.95,0:17:39.07,Dial_JP,,0,0,0,,僕に？
Dialogue: 0,0:17:39.62,0:17:41.70,Dial_JP,,0,0,0,,いえ　違います
Dialogue: 0,0:17:42.11,0:17:44.07,Dial_JP,,0,0,0,,照れるな照れるな
Dialogue: 0,0:17:44.07,0:17:45.04,Dial_JP,,0,0,0,,それそれそれ…
Dialogue: 0,0:17:46.10,0:17:47.39,Dial_JP,,0,0,0,,違います
Dialogue: 0,0:17:48.82,0:17:51.33,Dial_JP,,0,0,0,,では　僕は紅茶でも入れてこよう
Dialogue: 0,0:17:52.67,0:17:55.52,Dial_JP,,0,0,0,,あかね君は　ここでゆっくりしていろ
Dialogue: 0,0:17:57.97,0:17:59.01,Dial_JP,,0,0,0,,ったく…
Dialogue: 0,0:17:59.91,0:18:03.98,Dial_JP,,0,0,0,,しかし　乱馬は一体何をゆすられてるのかしら
Dialogue: 0,0:18:05.68,0:18:09.40,Dial_JP,,0,0,0,,取りあえず　何かヒントがないか調べてみるか
Dialogue: 0,0:18:14.55,0:18:15.48,Dial_JP,,0,0,0,,材料？
Dialogue: 0,0:18:15.81,0:18:18.68,Dial_JP,,0,0,0,,はい　お望みのネガは…
Dialogue: 0,0:18:19.49,0:18:24.01,Dial_JP,,0,0,0,,池で飼っているミドリガメくんの首輪の中に\Nしまってありますので
Dialogue: 0,0:18:24.01,0:18:25.28,Dial_JP,,0,0,0,,ラッキー
Dialogue: 0,0:18:27.15,0:18:29.16,Dial_JP,,0,0,0,,ネガさえ手に入れば…
Dialogue: 0,0:18:30.06,0:18:31.17,Dial_JP,,0,0,0,,小太刀とは…
Dialogue: 0,0:18:31.78,0:18:33.17,Dial_JP,,0,0,0,,おさらばだぜ
Dialogue: 0,0:18:44.26,0:18:45.80,Dial_JP,,0,0,0,,ワニ？
Dialogue: 0,0:18:51.56,0:18:53.98,Dial_JP,,0,0,0,,ワニのミドリガメくんが暴れているぞ
Dialogue: 0,0:18:55.80,0:18:57.82,Dial_JP,,0,0,0,,乱馬さまなら勝てますわ
Dialogue: 0,0:19:02.11,0:19:05.78,Dial_JP,,0,0,0,,クソ　何をもってミドリガメと
Dialogue: 0,0:19:29.85,0:19:32.64,Dial_JP,,0,0,0,,この首輪の中に　ネガが…
Dialogue: 0,0:19:36.81,0:19:38.92,Dial_JP,,0,0,0,,取った
Dialogue: 0,0:19:43.63,0:19:44.99,Dial_JP,,0,0,0,,あっ　いけない
Dialogue: 0,0:19:45.52,0:19:49.74,Dial_JP,,0,0,0,,あの首輪は無理に外すと高圧電流が流れる仕組みでした
Dialogue: 0,0:19:52.98,0:19:54.04,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:19:57.97,0:19:59.25,Dial_JP,,0,0,0,,おさげの女
Dialogue: 0,0:20:01.68,0:20:03.71,Dial_JP,,0,0,0,,さては僕に会いに…
Dialogue: 0,0:20:03.71,0:20:04.88,Dial_JP,,0,0,0,,違えよ…
Dialogue: 0,0:20:05.41,0:20:07.31,Dial_JP,,0,0,0,,乱馬さまはいずこ？
Dialogue: 0,0:20:07.31,0:20:09.56,Dial_JP,,0,0,0,,乱馬さま
Dialogue: 0,0:20:20.73,0:20:21.40,Dial_JP,,0,0,0,,ネガ
Dialogue: 0,0:20:24.23,0:20:26.10,Dial_JP,,0,0,0,,気が付いたか　おさげの女
Dialogue: 0,0:20:27.28,0:20:30.67,Dial_JP,,0,0,0,,お前の手土産　ありがたく頂いてやったぞ
Dialogue: 0,0:20:34.07,0:20:35.49,Dial_JP,,0,0,0,,なかなかオシャレだ
Dialogue: 0,0:20:38.05,0:20:40.17,Dial_JP,,0,0,0,,この野郎…
Dialogue: 0,0:20:40.79,0:20:42.67,Dial_JP,,0,0,0,,返せー
Dialogue: 0,0:20:58.40,0:21:00.56,Dial_JP,,0,0,0,,しびれるような恋だ
Dialogue: 0,0:21:03.16,0:21:05.58,Dial_JP,,0,0,0,,クソー
Dialogue: 0,0:21:08.19,0:21:09.18,Dial_JP,,0,0,0,,ネガ
Dialogue: 0,0:21:18.20,0:21:19.06,Dial_JP,,0,0,0,,ブイッ
Dialogue: 0,0:01:22.93,0:01:25.60,OP_JP_EP25,,0,0,0,,{\3c&H018601&\4c&H018700&}1つ2つ3つ4つ
Dialogue: 0,0:01:25.60,0:01:28.56,OP_JP_EP25,,0,0,0,,{\3c&H242DFF&\4c&H242DFF&}誰でも持ってる No one knows us, too
Dialogue: 0,0:01:28.56,0:01:31.19,OP_JP_EP25,,0,0,0,,ちょっと求めすぎるくらい We can do
Dialogue: 0,0:01:34.03,0:01:36.74,OP_JP_EP25,,0,0,0,,{\3c&H9329D3&\4c&H9329D3&}目に映らないあれこれ
Dialogue: 0,0:01:36.74,0:01:39.28,OP_JP_EP25,,0,0,0,,{\3c&H980094&\4c&H980094&}嘘だって決めないで
Dialogue: 0,0:01:39.36,0:01:44.14,OP_JP_EP25,,0,0,0,,{\3c&H22A22F&\4c&H22A22F&}自分だけの意地を張って行こう
Dialogue: 0,0:01:44.79,0:01:50.18,OP_JP_EP25,,0,0,4,,{\3c&H171CCE&\4c&H171CCE&}自信がない訳じゃない
Dialogue: 0,0:01:50.18,0:01:55.50,OP_JP_EP25,,0,0,4,,{\3c&H971102&\4c&H971102&}確信できないことは隠したい
Dialogue: 0,0:01:55.50,0:02:00.43,OP_JP_EP25,,0,0,4,,でもできれば1mmの素直が欲しいんだ
Dialogue: 0,0:02:00.43,0:02:03.72,OP_JP_EP25,,0,0,0,,{\3c&HADA12C&\4c&HADA12C&}もどかしい
Dialogue: 0,0:02:03.72,0:02:05.68,OP_JP_EP25,,0,0,0,,{\3c&HADA12C&\4c&HADA12C&}想いは揺れる
Dialogue: 0,0:02:05.85,0:02:09.31,OP_JP_EP25,,0,0,0,,{\3c&H9F2424&\4c&H9F2424&}また夢を見れる
Dialogue: 0,0:02:09.31,0:02:12.72,OP_JP_EP25,,0,0,0,,{\3c&H9E2525&\4c&H9F2525&\t(1400,1400,\3c&H018601&\4c&H018700&)}思い込みは随一の武器だ
Dialogue: 0,0:02:12.72,0:02:15.11,OP_JP_EP25,,0,0,0,,{\fad(0,240)\3c&H018601&\4c&H018700&\t(2350,2350,\3c&H020E97&\4c&H020E97&)}一か八かの今を
Dialogue: 0,0:02:15.41,0:02:18.61,OP_JP_EP25,,0,0,1,,{\3c&H020E97&\4c&H020E97&\t(1700,1700,\3c&H970196&\4c&H970196&)}君の目にただ映っていたい
Dialogue: 0,0:02:18.61,0:02:21.16,OP_JP_EP25,,0,0,1,,{\3c&H970196&\4c&H970196&}映っていたい
Dialogue: 0,0:02:21.16,0:02:22.37,OP_JP_EP25,,0,0,0,,Again and Again
Dialogue: 0,0:02:22.37,0:02:24.52,OP_JP_EP25,,0,0,0,,その先で I want you
Dialogue: 0,0:21:20.96,0:21:23.88,ED_JP_EP25,,0,0,0,,くっついたりしないけど
Dialogue: 0,0:21:23.88,0:21:26.22,ED_JP_EP25,,0,0,0,,なんかあったかいような
Dialogue: 0,0:21:26.22,0:21:28.72,ED_JP_EP25,,0,0,0,,貼れる方じゃなくて
Dialogue: 0,0:21:28.72,0:21:31.01,ED_JP_EP25,,0,0,0,,貼れない方のカイロみたいな
Dialogue: 0,0:21:31.01,0:21:33.39,ED_JP_EP25,,0,0,0,,「物に例えないで！」って
Dialogue: 0,0:21:33.39,0:21:35.81,ED_JP_EP25,,0,0,0,,君は怒りそうだけど
Dialogue: 0,0:21:35.81,0:21:38.23,ED_JP_EP25,,0,0,0,,ほんとかわいくないんだよ
Dialogue: 0,0:21:38.23,0:21:40.65,ED_JP_EP25,,0,0,0,,ほんとあったかいんだよ
Dialogue: 0,0:21:50.86,0:21:52.95,ED_JP_EP25,,0,0,0,,誰かがブタになっても
Dialogue: 0,0:21:52.95,0:21:55.37,ED_JP_EP25,,0,0,0,,アヒルになっても猫になっても
Dialogue: 0,0:21:55.37,0:21:57.00,ED_JP_EP25,,0,0,0,,どうでもいいけど
Dialogue: 0,0:21:57.00,0:21:59.50,ED_JP_EP25,,0,0,0,,君の服がいつもと違ったら
Dialogue: 0,0:21:59.50,0:22:01.42,ED_JP_EP25,,0,0,0,,どうでもよくないよ
Dialogue: 0,0:22:01.42,0:22:04.46,ED_JP_EP25,,0,0,0,,「かわいいのは服装の話で
Dialogue: 0,0:22:04.46,0:22:06.21,ED_JP_EP25,,0,0,0,,君のことじゃないよ！」
Dialogue: 0,0:22:06.21,0:22:07.80,ED_JP_EP25,,0,0,0,,あー今日も変わらず
Dialogue: 0,0:22:07.80,0:22:09.97,ED_JP_EP25,,0,0,0,,じゃじゃ馬にさせちゃった
Dialogue: 0,0:22:09.97,0:22:15.18,ED_JP_EP25,,0,0,0,,素直になれないとこが
Dialogue: 0,0:22:15.18,0:22:21.69,ED_JP_EP25,,0,0,0,,似た者同士だったらいいのに
Dialogue: 0,0:22:24.27,0:22:26.90,ED_JP_EP25,,0,0,0,,一体どうしちゃったんだ
Dialogue: 0,0:22:26.90,0:22:29.15,ED_JP_EP25,,0,0,0,,君がずっと分かんない
Dialogue: 0,0:22:29.15,0:22:31.74,ED_JP_EP25,,0,0,0,,ラブソングなんかじゃ
Dialogue: 0,0:22:31.74,0:22:34.07,ED_JP_EP25,,0,0,0,,例えらんないこの感情は
Dialogue: 0,0:22:34.07,0:22:36.54,ED_JP_EP25,,0,0,0,,一体どうしちゃったら
Dialogue: 0,0:22:36.54,0:22:38.95,ED_JP_EP25,,0,0,0,,君は笑ってくれるんだ
Dialogue: 0,0:22:38.95,0:22:41.29,ED_JP_EP25,,0,0,0,,2文字なんかじゃ
Dialogue: 0,0:22:41.29,0:22:43.67,ED_JP_EP25,,0,0,0,,語れないこの関係は
Dialogue: 0,0:22:43.67,0:22:46.13,ED_JP_EP25,,0,0,0,,ほんとはちょっぴり
Dialogue: 0,0:22:46.13,0:22:48.59,ED_JP_EP25,,0,0,0,,いや、やっぱかわいくないや！
