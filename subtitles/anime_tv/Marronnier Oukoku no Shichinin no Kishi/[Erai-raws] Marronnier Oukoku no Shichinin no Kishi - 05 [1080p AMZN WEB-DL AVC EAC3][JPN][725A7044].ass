Dialogue: 0,0:00:10.88,0:00:13.22,Default,,0,0,0,,（ナレーション）\Nかつて大地は赤かった
Dialogue: 0,0:00:13.80,0:00:16.43,Default,,0,0,0,,赤銅色の太陽に\N照らされ
Dialogue: 0,0:00:16.51,0:00:19.72,Default,,0,0,0,,紅蓮ぐれんの炎が吹き上がる\Nその場所で
Dialogue: 0,0:00:19.81,0:00:22.10,Default,,0,0,0,,赤い血潮の人が\N生まれ
Dialogue: 0,0:00:22.18,0:00:23.73,Default,,0,0,0,,死んでいった
Dialogue: 0,0:00:26.81,0:00:29.15,s5,,0,0,0,,赤一色だった大地は
Dialogue: 0,0:00:29.23,0:00:31.74,s5,,0,0,0,,やがて別の色に染まった
Dialogue: 0,0:00:33.82,0:00:37.28,s5,,0,0,0,,夜が支配する北東の地は青く
Dialogue: 0,0:00:37.37,0:00:40.29,s5,,0,0,0,,動物たちの楽園は緑
Dialogue: 0,0:00:40.37,0:00:43.62,s5,,0,0,0,,黄 黒 紫…
Dialogue: 0,0:00:44.58,0:00:46.88,s5,,0,0,0,,さまざまな色に覆われた
Dialogue: 0,0:00:51.21,0:00:55.13,s5,,0,0,0,,赤 それは全ての命の源
Dialogue: 0,0:00:57.05,0:00:58.64,s5,,0,0,0,,だが今では
Dialogue: 0,0:00:58.72,0:01:02.39,s5,,0,0,0,,そのことを知る者は\Nほとんどいない
Dialogue: 0,0:01:06.06,0:01:10.07,s7,,0,0,0,,♪～
Dialogue: 0,0:02:31.94,0:02:35.94,s7,,0,0,0,,～♪
Dialogue: 0,0:02:41.62,0:02:44.37,s7,,0,0,0,,（エリー）べつに\N夜会なんか どうでもいい
Dialogue: 0,0:02:44.45,0:02:46.58,s7,,0,0,0,,ドレスなんて着たくないし
Dialogue: 0,0:02:46.66,0:02:49.00,s7,,0,0,0,,酒のつまみばっか食べてたら\N怒られるし
Dialogue: 0,0:02:50.83,0:02:53.46,s7,,0,0,0,,んなことより\Nヤバいことに巻き込まれて
Dialogue: 0,0:02:53.54,0:02:56.63,s7,,0,0,0,,斬ったり殴ったり期待してたのにさ
Dialogue: 0,0:02:56.71,0:03:01.18,s7,,0,0,0,,（侍女頭）うわあ～ 城代様\Nよく縁談 まとめてくださった
Dialogue: 0,0:03:01.89,0:03:03.39,s7,,0,0,0,,いいですか お嬢様
Dialogue: 0,0:03:04.01,0:03:05.97,s7,,0,0,0,,眠ねむくない様は お優しいから
Dialogue: 0,0:03:06.06,0:03:09.18,s7,,0,0,0,,ドレスがイヤとか\Nおっさんにニコニコするの無理とか
Dialogue: 0,0:03:09.27,0:03:12.19,s7,,0,0,0,,きっと そういうお気持ちを\Nくんでくださってるんです
Dialogue: 0,0:03:12.27,0:03:13.31,s7,,0,0,0,,でも それは
Dialogue: 0,0:03:13.40,0:03:18.11,s7,,0,0,0,,今後 眠くない様の奥方になる\Nお嬢様の大切なお仕事
Dialogue: 0,0:03:18.19,0:03:21.41,s7,,0,0,0,,いつまでも子供みたいなことを\N言っていてはダメです
Dialogue: 0,0:03:21.49,0:03:24.28,s7,,0,0,0,,（眠くない）エリー どうしよう
Dialogue: 0,0:03:27.33,0:03:28.70,s7,,0,0,0,,（侍女頭）それに ご結婚により
Dialogue: 0,0:03:28.79,0:03:32.88,s7,,0,0,0,,眠くない様は 国で２番目の\N大領主になられます
Dialogue: 0,0:03:32.96,0:03:37.30,s7,,0,0,0,,奥方の同伴しない夜会なんて\N浮気し放題ですよ
Dialogue: 0,0:03:37.88,0:03:41.76,s7,,0,0,0,,（ミカ）外交官様\Nおかわり どーれすか？　おかわり
Dialogue: 0,0:03:42.68,0:03:44.51,s7,,0,0,0,,（外交官）わらしは この子がいれば\Nなんも要らんのれす～
Dialogue: 0,0:03:44.51,0:03:46.18,s7,,0,0,0,,（外交官）わらしは この子がいれば\Nなんも要らんのれす～
Dialogue: 0,0:03:44.51,0:03:46.18,Default,,0,0,0,,（眠くない）これ\N程よくしょっぱくて
Dialogue: 0,0:03:46.18,0:03:46.26,s7,,0,0,0,,（外交官）わらしは この子がいれば\Nなんも要らんのれす～
Dialogue: 0,0:03:46.26,0:03:47.22,s7,,0,0,0,,（外交官）わらしは この子がいれば\Nなんも要らんのれす～
Dialogue: 0,0:03:46.26,0:03:47.22,Default,,0,0,0,,おいしいな
Dialogue: 0,0:03:47.97,0:03:50.43,s7,,0,0,0,,（眠くない）\Nエリーにも持っていって… ん？
Dialogue: 0,0:03:52.44,0:03:54.61,s7,,0,0,0,,早くハチミツ 食わせてくれよ！
Dialogue: 0,0:03:58.11,0:03:59.78,s7,,0,0,0,,（カステヘルミ）ねえ アンニ
Dialogue: 0,0:03:59.86,0:04:01.74,s7,,0,0,0,,もう帰りましょうよ
Dialogue: 0,0:04:02.40,0:04:03.57,s7,,0,0,0,,（アンニ）んーん
Dialogue: 0,0:04:03.66,0:04:06.83,s7,,0,0,0,,（カステヘルミ）もう長いこと\Nコロコロしてるじゃない
Dialogue: 0,0:04:07.41,0:04:10.04,s7,,0,0,0,,帰って ごはん食べましょうよ
Dialogue: 0,0:04:10.12,0:04:12.25,Default,,0,0,0,,何よ\N母様も みんなも
Dialogue: 0,0:04:12.33,0:04:14.63,Default,,0,0,0,,アンニを\N私に押しつけて
Dialogue: 0,0:04:14.71,0:04:17.71,Default,,0,0,0,,ほら 風邪ひくと\N私が怒られるから
Dialogue: 0,0:04:17.71,0:04:18.63,Default,,0,0,0,,ほら 風邪ひくと\N私が怒られるから
Dialogue: 0,0:04:17.71,0:04:18.63,Default,,0,0,0,,（アンニ）\Nぎゃ～！　イヤ～！
Dialogue: 0,0:04:18.63,0:04:19.59,Default,,0,0,0,,（アンニ）\Nぎゃ～！　イヤ～！
Dialogue: 0,0:04:19.67,0:04:23.13,s7,,0,0,0,,これじゃ いつまで経っても\N城に戻れない
Dialogue: 0,0:04:19.67,0:04:23.13,Default,,0,0,0,,ねーねは\Nあっち行って～！
Dialogue: 0,0:04:23.22,0:04:26.55,s7,,0,0,0,,（ヨアン）おい 姉君を困らせるな
Dialogue: 0,0:04:28.22,0:04:30.43,s7,,0,0,0,,２人して庭で凍えるつもりか？
Dialogue: 0,0:04:30.52,0:04:31.35,s7,,0,0,0,,（アンニ）アハッ
Dialogue: 0,0:04:31.43,0:04:34.10,s7,,0,0,0,,遊び足りないなら\N暖炉の前で遊ぶんだな
Dialogue: 0,0:04:35.10,0:04:37.56,s7,,0,0,0,,あなたは 騎士長様のお供の…
Dialogue: 0,0:04:37.65,0:04:40.03,s7,,0,0,0,,ヨアンネスです カステヘルミ殿
Dialogue: 0,0:04:40.11,0:04:43.03,s7,,0,0,0,,夜会には\N出席なさらなかったのですか？
Dialogue: 0,0:04:40.11,0:04:43.03,Default,,0,0,0,,（アンニ）ん～！\Nんっ！　んっ！
Dialogue: 0,0:04:44.28,0:04:46.70,s7,,0,0,0,,（ヨアン）\Nああいう宴も嫌いではないが
Dialogue: 0,0:04:46.78,0:04:47.99,s7,,0,0,0,,少し気晴らしに
Dialogue: 0,0:04:49.37,0:04:51.70,s7,,0,0,0,,ここの庭は美しいが
Dialogue: 0,0:04:51.79,0:04:53.16,s7,,0,0,0,,広すぎて
Dialogue: 0,0:04:53.25,0:04:56.17,s7,,0,0,0,,うっかりすると\N暗闇に取り残されてしまうな
Dialogue: 0,0:05:01.38,0:05:03.55,s7,,0,0,0,,兄上の娘が このぐらいでな
Dialogue: 0,0:05:04.05,0:05:05.80,s7,,0,0,0,,こうしておけば喜ぶんだ
Dialogue: 0,0:05:05.88,0:05:07.55,Default,,0,0,0,,（アンニ）\Nきゃー！　ハハハ…
Dialogue: 0,0:05:05.88,0:05:07.55,s7,,0,0,0,,言うこと聞かないと\N地の果ての怪物がやってくるぞ
Dialogue: 0,0:05:07.55,0:05:09.43,s7,,0,0,0,,言うこと聞かないと\N地の果ての怪物がやってくるぞ
Dialogue: 0,0:05:09.43,0:05:10.26,s7,,0,0,0,,言うこと聞かないと\N地の果ての怪物がやってくるぞ
Dialogue: 0,0:05:09.43,0:05:10.26,Default,,0,0,0,,（アンニ）\Nええ～ 怖～い
Dialogue: 0,0:05:10.26,0:05:11.77,Default,,0,0,0,,（アンニ）\Nええ～ 怖～い
Dialogue: 0,0:05:11.85,0:05:13.02,s7,,0,0,0,,（カステヘルミ）フフッ
Dialogue: 0,0:05:13.77,0:05:16.40,s7,,0,0,0,,マロニエ王国には怪物が出るの？
Dialogue: 0,0:05:16.48,0:05:17.48,s7,,0,0,0,,（ヨアン）いや
Dialogue: 0,0:05:17.56,0:05:20.77,s7,,0,0,0,,子供が なかなか家に帰らなかったり\N寝なかったりしたら
Dialogue: 0,0:05:20.86,0:05:22.82,s7,,0,0,0,,大人は そう言わないか？
Dialogue: 0,0:05:22.90,0:05:24.36,s7,,0,0,0,,（カステヘルミ）ああ それなら
Dialogue: 0,0:05:24.45,0:05:28.32,s7,,0,0,0,,この国では\N青い精霊に さらわれるぞって
Dialogue: 0,0:05:28.41,0:05:30.83,s7,,0,0,0,,でもホントは\Nそんなことしないけど
Dialogue: 0,0:05:30.91,0:05:35.00,s7,,0,0,0,,（風の音）
Dialogue: 0,0:05:36.29,0:05:38.25,s7,,0,0,0,,（ヨアン）ハシドイにノリウツギ
Dialogue: 0,0:05:38.33,0:05:39.96,s7,,0,0,0,,ルピナス ジギタリス
Dialogue: 0,0:05:41.46,0:05:43.92,s7,,0,0,0,,俺の国では 春から秋に咲く花が
Dialogue: 0,0:05:44.01,0:05:46.05,s7,,0,0,0,,一斉に咲くんだな
Dialogue: 0,0:05:47.30,0:05:49.51,s7,,0,0,0,,ここは 春が一番暖かく
Dialogue: 0,0:05:50.14,0:05:52.22,s7,,0,0,0,,夏と秋は短いからか…
Dialogue: 0,0:05:52.31,0:05:53.27,s7,,0,0,0,,（アンニ）ハハッ
Dialogue: 0,0:05:53.35,0:05:56.23,s7,,0,0,0,,（カステヘルミ）花の名前を\Nこんなに知ってるなんて
Dialogue: 0,0:05:56.31,0:06:00.27,s5,,0,0,0,,この国の兵士とは 全然違うのね
Dialogue: 0,0:06:01.27,0:06:04.19,s5,,0,0,0,,彼は 異国から来た王子様
Dialogue: 0,0:06:04.74,0:06:05.69,s7,,0,0,0,,（ヨアン）どうした？
Dialogue: 0,0:06:05.78,0:06:07.57,s7,,0,0,0,,（カステヘルミ）\Nいいえ なんでも！
Dialogue: 0,0:06:11.66,0:06:13.04,s7,,0,0,0,,（ノック）
Dialogue: 0,0:06:16.75,0:06:17.96,s7,,0,0,0,,（眠くない）もう寝てたかな？
Dialogue: 0,0:06:18.04,0:06:20.88,s7,,0,0,0,,いや\Nまだ そんな遅い時間じゃないし
Dialogue: 0,0:06:20.96,0:06:22.63,s7,,0,0,0,,（眠くない）\N侍女さんの熱は下がった？
Dialogue: 0,0:06:22.71,0:06:24.13,s7,,0,0,0,,ああ 落ち着いてる
Dialogue: 0,0:06:24.71,0:06:26.97,s7,,0,0,0,,（眠くない）\N肉は 消化に悪いかと思って
Dialogue: 0,0:06:27.05,0:06:29.59,s7,,0,0,0,,果物と 卵のお菓子を\Nもらってきたんだ
Dialogue: 0,0:06:29.68,0:06:32.05,s7,,0,0,0,,こっちは 朝食も遅いし
Dialogue: 0,0:06:32.14,0:06:34.31,s7,,0,0,0,,君も朝\Nおなかがすいてたら食べて
Dialogue: 0,0:06:35.35,0:06:37.06,s7,,0,0,0,,今日は まいったよ
Dialogue: 0,0:06:37.14,0:06:40.48,s7,,0,0,0,,外交官様と隊長さんが\N酒癖が悪くて…
Dialogue: 0,0:06:41.23,0:06:42.36,s7,,0,0,0,,エリー？
Dialogue: 0,0:06:42.44,0:06:43.69,s7,,0,0,0,,話があるなら…
Dialogue: 0,0:06:43.77,0:06:47.44,s7,,0,0,0,,いや 侍女がさ\N俺も夜会に行けって…
Dialogue: 0,0:06:47.53,0:06:50.20,s7,,0,0,0,,出なくていい 疲れるだけだ
Dialogue: 0,0:06:50.82,0:06:54.79,s7,,0,0,0,,で… でも いつまでも\Nそんなこと言ってらんないし
Dialogue: 0,0:06:54.87,0:06:56.75,s7,,0,0,0,,俺だって フワッとしたの着たり
Dialogue: 0,0:06:56.83,0:06:59.00,s7,,0,0,0,,おっさんに\N頭 下げたりできるんだけど
Dialogue: 0,0:06:59.08,0:07:02.42,s7,,0,0,0,,大体 君は\N社交場なんて好きじゃないだろう
Dialogue: 0,0:07:02.50,0:07:05.92,s7,,0,0,0,,僕が いつか城代になってからでも\Nいいじゃないか
Dialogue: 0,0:07:06.00,0:07:10.38,s7,,0,0,0,,いや… もう遅いし\Nこのことは また今度 話し合おう
Dialogue: 0,0:07:10.47,0:07:12.85,s7,,0,0,0,,おやすみ　風邪をひかないように
Dialogue: 0,0:07:14.43,0:07:17.85,s7,,0,0,0,,（エリー）なんだ あいつ…\N腹立つな
Dialogue: 0,0:07:17.93,0:07:18.77,s7,,0,0,0,,ハァ…
Dialogue: 0,0:07:18.85,0:07:21.81,s5,,0,0,0,,あんなヤツと\Nずっと一緒にいるなんて…
Dialogue: 0,0:07:22.90,0:07:24.31,s7,,0,0,0,,（侍女頭）ハァー
Dialogue: 0,0:07:30.82,0:07:34.24,s7,,0,0,0,,（エリー）昔から\Nたまにケンカをする
Dialogue: 0,0:07:35.33,0:07:39.33,s5,,0,0,0,,でも いつも 次の日に忘れてる
Dialogue: 0,0:07:53.09,0:07:54.51,s7,,0,0,0,,（精霊たち）女王様
Dialogue: 0,0:07:56.05,0:07:59.14,s7,,0,0,0,,（精霊１）眠くないを\Nもらってしまいましょうよ
Dialogue: 0,0:08:00.35,0:08:04.19,s7,,0,0,0,,（精霊２）マロニエの あの娘は\N婚約者ではないそうだし
Dialogue: 0,0:08:04.27,0:08:07.65,s5,,0,0,0,,もう１人の男も\N強い剣士ではないそうですわ
Dialogue: 0,0:08:09.03,0:08:12.24,s7,,0,0,0,,（精霊１）\N遠慮なく夜をもらいましょう
Dialogue: 0,0:08:13.86,0:08:15.87,s7,,0,0,0,,（精霊３）ヴァルプルガ様に頼んで
Dialogue: 0,0:08:15.95,0:08:20.83,s5,,0,0,0,,20年ぶりに 夜に教会へ\N戻ってきてもらいましょう
Dialogue: 0,0:08:20.91,0:08:22.33,s5,,0,0,0,,フフッ
Dialogue: 0,0:08:26.84,0:08:30.84,s7,,0,0,0,,（鐘の音）
Dialogue: 0,0:08:34.26,0:08:36.43,s7,,0,0,0,,（ヒュロッキン）また青い夢…
Dialogue: 0,0:08:37.47,0:08:39.93,s7,,0,0,0,,（侍女）\Nおはようございます 女王様
Dialogue: 0,0:08:41.73,0:08:45.77,s7,,0,0,0,,（ナレーション）\N夜の長い国に到着して ３日目の朝
Dialogue: 0,0:08:46.52,0:08:50.07,s5,,0,0,0,,眠くないの新たな一日が始まった
Dialogue: 0,0:08:51.86,0:08:54.53,s7,,0,0,0,,（侍女頭）\Nおはようございます 眠くない様
Dialogue: 0,0:08:54.61,0:08:57.12,s7,,0,0,0,,昨夜はありがとうございました
Dialogue: 0,0:08:57.20,0:08:59.74,s7,,0,0,0,,（眠くない）そんな\N礼には及びませんよ
Dialogue: 0,0:08:59.83,0:09:03.62,s7,,0,0,0,,さすが侍女頭さんだ\Nオンとオフで 全然違いますね
Dialogue: 0,0:09:03.71,0:09:07.00,s7,,0,0,0,,みっともない姿をお見せして\N申し訳ありませんでしたわ
Dialogue: 0,0:09:07.63,0:09:09.34,s7,,0,0,0,,もう お嬢様には会われました？
Dialogue: 0,0:09:09.42,0:09:10.25,s7,,0,0,0,,ん？
Dialogue: 0,0:09:10.34,0:09:12.42,s7,,0,0,0,,今日は 遠出もありませんし
Dialogue: 0,0:09:12.51,0:09:16.34,s7,,0,0,0,,私 張り切って\N娘らしい格好をさせてみましたの
Dialogue: 0,0:09:16.43,0:09:19.55,s7,,0,0,0,,（眠くない）そうなんですか\Nまだ会ってないな
Dialogue: 0,0:09:19.64,0:09:20.85,s7,,0,0,0,,もう外へ？
Dialogue: 0,0:09:20.93,0:09:23.31,s7,,0,0,0,,“クマいねえかな”と\Nおっしゃられていたので
Dialogue: 0,0:09:23.39,0:09:25.02,s7,,0,0,0,,たぶん森の方かと
Dialogue: 0,0:09:25.10,0:09:27.94,s7,,0,0,0,,（眠くない）そっか\N朝食のときには会えるかな
Dialogue: 0,0:09:28.02,0:09:29.15,s7,,0,0,0,,それじゃあ また
Dialogue: 0,0:09:29.23,0:09:30.82,s7,,0,0,0,,ええ 後ほど
Dialogue: 0,0:09:33.86,0:09:35.57,s7,,0,0,0,,（兵士１）お疲れさん お？\N（兵士２）お？
Dialogue: 0,0:09:33.86,0:09:35.57,Default,,0,0,0,,（走る足音）
Dialogue: 0,0:09:35.57,0:09:36.61,Default,,0,0,0,,（走る足音）
Dialogue: 0,0:09:36.61,0:09:37.45,Default,,0,0,0,,（走る足音）
Dialogue: 0,0:09:36.61,0:09:37.45,s7,,0,0,0,,（精霊たち）ん？
Dialogue: 0,0:09:37.95,0:09:39.07,s7,,0,0,0,,（眠くない）んっ！
Dialogue: 0,0:09:44.71,0:09:48.21,s5,,0,0,0,,彼女は慎重だから\Nちゃんと道なりに進むはず
Dialogue: 0,0:09:48.79,0:09:51.55,s7,,0,0,0,,（エリー）眠くない\Nクワガタ こっちこっち！
Dialogue: 0,0:09:54.88,0:09:56.30,s7,,0,0,0,,（乳母）あんたって子は
Dialogue: 0,0:09:56.38,0:09:59.55,s7,,0,0,0,,また修道院 抜け出して\N森で遊んでたって？
Dialogue: 0,0:10:00.30,0:10:02.51,s7,,0,0,0,,裁縫のひとつもできなくて
Dialogue: 0,0:10:02.60,0:10:05.39,s7,,0,0,0,,嫁のもらい手が\Nあるとでも思ってんのかい？
Dialogue: 0,0:10:05.48,0:10:06.81,s7,,0,0,0,,（眠くない）また怒られてる
Dialogue: 0,0:10:07.69,0:10:08.81,Default,,0,0,0,,エリー…
Dialogue: 0,0:10:07.69,0:10:08.81,s7,,0,0,0,,（エリー）城代になりたいヤツなんて\Nいくらでもいるから
Dialogue: 0,0:10:08.81,0:10:10.23,s7,,0,0,0,,（エリー）城代になりたいヤツなんて\Nいくらでもいるから
Dialogue: 0,0:10:10.31,0:10:12.98,s7,,0,0,0,,もらい手の心配とか要らねえし
Dialogue: 0,0:10:13.07,0:10:16.19,s7,,0,0,0,,どうせ来年か 再来年には\N結婚しなきゃいけないんだし
Dialogue: 0,0:10:16.28,0:10:18.03,s7,,0,0,0,,いいじゃん ちょっとぐらい
Dialogue: 0,0:10:24.62,0:10:28.46,s7,,0,0,0,,ハァ ハァ…
Dialogue: 0,0:10:38.88,0:10:40.80,s7,,0,0,0,,お… おはよう
Dialogue: 0,0:10:40.89,0:10:43.51,s7,,0,0,0,,何してんの？　こんなとこで\N散歩？
Dialogue: 0,0:10:44.26,0:10:45.14,s7,,0,0,0,,おはよう
Dialogue: 0,0:10:45.22,0:10:47.35,s7,,0,0,0,,そうだね 散歩かな
Dialogue: 0,0:10:47.43,0:10:49.48,s7,,0,0,0,,温泉 僕も入っていいかな？
Dialogue: 0,0:10:49.56,0:10:51.48,s7,,0,0,0,,（エリー）え… いいんじゃね
Dialogue: 0,0:10:55.78,0:10:57.44,s7,,0,0,0,,温かいね
Dialogue: 0,0:10:59.28,0:11:00.57,s7,,0,0,0,,（エリー）あ… あのさ
Dialogue: 0,0:11:01.11,0:11:03.45,s7,,0,0,0,,やっぱ変？　似合わない？
Dialogue: 0,0:11:03.99,0:11:05.54,s7,,0,0,0,,侍女も着せたがるし
Dialogue: 0,0:11:05.62,0:11:08.16,s7,,0,0,0,,外交官様も\Nおとなしくしろって言うからさ
Dialogue: 0,0:11:09.25,0:11:12.67,s5,,0,0,0,,なんで今 一番 会いたくないヤツに\N会っちゃうんだろう
Dialogue: 0,0:11:12.75,0:11:15.42,Default,,0,0,0,,でも これじゃ\Nすぐに動けねえし
Dialogue: 0,0:11:12.75,0:11:15.42,Default,,0,0,0,,（水音）
Dialogue: 0,0:11:15.42,0:11:15.50,Default,,0,0,0,,（水音）
Dialogue: 0,0:11:15.50,0:11:16.80,Default,,0,0,0,,（水音）
Dialogue: 0,0:11:15.50,0:11:16.80,Default,,0,0,0,,なんかあったときに…
Dialogue: 0,0:11:16.88,0:11:18.30,s7,,0,0,0,,似合ってる
Dialogue: 0,0:11:18.88,0:11:20.05,s7,,0,0,0,,すごく
Dialogue: 0,0:11:20.13,0:11:21.22,s7,,0,0,0,,え…
Dialogue: 0,0:11:23.60,0:11:24.43,s7,,0,0,0,,あっ… あ！
Dialogue: 0,0:11:33.23,0:11:35.65,s7,,0,0,0,,（エリー）何？　今の
Dialogue: 0,0:11:35.73,0:11:36.98,s7,,0,0,0,,何って…
Dialogue: 0,0:11:37.73,0:11:39.61,s7,,0,0,0,,つまり その… これは
Dialogue: 0,0:11:41.32,0:11:44.28,s7,,0,0,0,,僕が一番に言わなきゃと思って
Dialogue: 0,0:11:51.00,0:11:52.42,s7,,0,0,0,,（エリー）ん…
Dialogue: 0,0:11:53.42,0:11:55.96,s7,,0,0,0,,君は 最近 そうやって
Dialogue: 0,0:11:56.04,0:11:58.34,s7,,0,0,0,,急に機嫌が悪くなるんだ
Dialogue: 0,0:11:59.46,0:12:01.09,s7,,0,0,0,,僕が悪いのなら
Dialogue: 0,0:12:01.17,0:12:03.84,s7,,0,0,0,,いつもみたいに\Nはっきり言ってくれればいいのに
Dialogue: 0,0:12:04.80,0:12:07.06,s7,,0,0,0,,これから もしイヤになっても
Dialogue: 0,0:12:07.14,0:12:08.81,s7,,0,0,0,,ずっと一緒にいるんだし
Dialogue: 0,0:12:10.10,0:12:11.60,s7,,0,0,0,,（エリー）んっ！\N（眠くない）なっ…
Dialogue: 0,0:12:11.69,0:12:13.19,s7,,0,0,0,,足が砕けるじゃないか！
Dialogue: 0,0:12:13.27,0:12:15.19,s7,,0,0,0,,今 イヤって言った！
Dialogue: 0,0:12:16.15,0:12:18.90,s7,,0,0,0,,水面も蹴るなよ ぬれたじゃないか
Dialogue: 0,0:12:19.73,0:12:23.11,s7,,0,0,0,,（エリー）足 踏むなよ！\N結局イヤなんじゃん
Dialogue: 0,0:12:23.20,0:12:24.16,s7,,0,0,0,,また蹴るだろ
Dialogue: 0,0:12:24.24,0:12:26.58,s7,,0,0,0,,イヤとは言ってないだろ\N“もし”って前に付けた
Dialogue: 0,0:12:27.16,0:12:30.29,s7,,0,0,0,,君こそ 僕の質問に答えてないし
Dialogue: 0,0:12:32.25,0:12:33.46,s7,,0,0,0,,（エリー）帰ったら…
Dialogue: 0,0:12:34.58,0:12:37.21,s7,,0,0,0,,国に帰ったら答える
Dialogue: 0,0:12:38.04,0:12:39.67,s7,,0,0,0,,（眠くない）うん そうしよう
Dialogue: 0,0:12:40.55,0:12:44.26,s7,,0,0,0,,僕も 帰ったら\N君とゆっくり話がしたい
Dialogue: 0,0:12:46.97,0:12:49.35,s7,,0,0,0,,（精霊３）ずっと一緒にいるって…
Dialogue: 0,0:12:49.43,0:12:51.14,s7,,0,0,0,,帰ったらって…？
Dialogue: 0,0:12:51.68,0:12:54.02,s7,,0,0,0,,（精霊１）あの娘は婚約者？
Dialogue: 0,0:12:54.10,0:12:56.31,s7,,0,0,0,,（精霊２）本物の婚約者だったの？
Dialogue: 0,0:12:59.90,0:13:01.03,s7,,0,0,0,,お嬢様…
Dialogue: 0,0:13:01.11,0:13:05.03,s7,,0,0,0,,（エリー）眠くないが\N温泉で俺の足 踏んだから…
Dialogue: 0,0:13:06.24,0:13:07.24,s7,,0,0,0,,ごめんなさい
Dialogue: 0,0:13:07.91,0:13:10.41,s7,,0,0,0,,いつもの服 着てもらいますからね
Dialogue: 0,0:13:10.49,0:13:11.91,s7,,0,0,0,,髪 乾かして
Dialogue: 0,0:13:12.00,0:13:13.21,s7,,0,0,0,,（エリー）はーい
Dialogue: 0,0:13:16.42,0:13:17.79,s7,,0,0,0,,（エリー）帰ったら
Dialogue: 0,0:13:18.96,0:13:21.00,s5,,0,0,0,,やることいっぱいあったよな…
Dialogue: 0,0:13:25.26,0:13:28.39,s5,,0,0,0,,報告書 出して\N衣装合わせして
Dialogue: 0,0:13:29.01,0:13:30.72,s5,,0,0,0,,それで そのあと…
Dialogue: 0,0:13:33.52,0:13:36.90,s5,,0,0,0,,帰ったら きっと話せると思う
Dialogue: 0,0:13:37.52,0:13:41.44,s7,,0,0,0,,君は 最近 そうやって\N急に機嫌が悪くなるんだ
Dialogue: 0,0:13:42.36,0:13:44.95,s7,,0,0,0,,（エリー）\N気持ちを持て余したりせずに
Dialogue: 0,0:13:45.61,0:13:48.16,s5,,0,0,0,,あなたでよかったと思っていると
Dialogue: 0,0:13:52.04,0:13:55.33,s7,,0,0,0,,（ナレーション）\N夜の長い国のヒュロッキン
Dialogue: 0,0:13:55.41,0:13:59.92,s5,,0,0,0,,氷の女王と呼ばれる彼女の\N朝の ひとコマ
Dialogue: 0,0:14:00.00,0:14:01.88,s7,,0,0,0,,（侍女１）今日のご予定ですが
Dialogue: 0,0:14:01.96,0:14:04.84,s7,,0,0,0,,生き物の国からの商人がご挨拶に
Dialogue: 0,0:14:04.92,0:14:09.55,s7,,0,0,0,,それから 大聖堂にて\N祭りの挨拶の打ち合わせを
Dialogue: 0,0:14:10.14,0:14:13.31,s7,,0,0,0,,昼食は 北のモミの森の領主様と
Dialogue: 0,0:14:13.39,0:14:16.73,s7,,0,0,0,,森に対する税のことで\N話があるそうです
Dialogue: 0,0:14:16.81,0:14:19.35,s7,,0,0,0,,そのあと 楽団と祭りの打ち合わせ
Dialogue: 0,0:14:19.44,0:14:23.02,s7,,0,0,0,,出店の最終確認の書類が\N上がってまいりまして
Dialogue: 0,0:14:23.11,0:14:24.90,s7,,0,0,0,,劇団長の挨拶…
Dialogue: 0,0:14:24.99,0:14:26.03,s7,,0,0,0,,ん？
Dialogue: 0,0:14:26.95,0:14:31.83,s7,,0,0,0,,女王様 本日 王配様が\Nご気分が とてもよろしいようで
Dialogue: 0,0:14:31.91,0:14:33.79,s7,,0,0,0,,朝食をご一緒にと
Dialogue: 0,0:14:34.70,0:14:37.54,s7,,0,0,0,,それでは そのように準備を
Dialogue: 0,0:14:39.04,0:14:41.67,s7,,0,0,0,,（侍女２）女王様…\N（侍女３）今 お取り替えを
Dialogue: 0,0:14:43.25,0:14:45.21,s7,,0,0,0,,そうだ！　商人様たちから
Dialogue: 0,0:14:45.30,0:14:47.63,s7,,0,0,0,,新しいアクセサリーでも\N買ってみては？
Dialogue: 0,0:14:47.72,0:14:50.55,s7,,0,0,0,,10歳若く見える髪形でいきますね
Dialogue: 0,0:14:50.64,0:14:53.18,s7,,0,0,0,,そんな…\N張り切ってるみたいではないか
Dialogue: 0,0:14:53.26,0:14:56.85,s7,,0,0,0,,お食事をご一緒なんて\N２週間ぶりではないですか
Dialogue: 0,0:14:56.93,0:14:58.64,s7,,0,0,0,,（侍女２）ここ３日ほど
Dialogue: 0,0:14:58.73,0:15:02.40,s5,,0,0,0,,目覚めがよくて\N夜も よく眠れてるとのことですよ
Dialogue: 0,0:15:02.48,0:15:04.73,s7,,0,0,0,,前よりも食欲もあるとか
Dialogue: 0,0:15:10.41,0:15:12.07,s7,,0,0,0,,（眠くない）やあ\N（エリー）お… おう
Dialogue: 0,0:15:12.16,0:15:13.78,s7,,0,0,0,,おはよう 騎士長
Dialogue: 0,0:15:13.87,0:15:16.58,s7,,0,0,0,,（外交官）やあやあ\Nお待たせしましたね
Dialogue: 0,0:15:19.16,0:15:21.71,s7,,0,0,0,,（精霊３）女王様は\N今日 王配様と朝食
Dialogue: 0,0:15:21.79,0:15:22.92,s7,,0,0,0,,えっ どうして？
Dialogue: 0,0:15:23.00,0:15:24.59,s7,,0,0,0,,そんなの困るじゃない
Dialogue: 0,0:15:24.67,0:15:26.34,s7,,0,0,0,,何が困るのかしら？
Dialogue: 0,0:15:26.42,0:15:29.76,s7,,0,0,0,,あなたたち 何かよくないことを\N考えてるでしょ
Dialogue: 0,0:15:29.84,0:15:31.13,s7,,0,0,0,,どうしたの？
Dialogue: 0,0:15:31.22,0:15:33.72,s7,,0,0,0,,いいえ 私たちはそんな…
Dialogue: 0,0:15:33.80,0:15:34.64,s7,,0,0,0,,（カステヘルミ）んっ！
Dialogue: 0,0:15:36.18,0:15:38.31,Default,,0,0,0,,ねーね 早く！
Dialogue: 0,0:15:38.85,0:15:41.02,s7,,0,0,0,,あっ… もう
Dialogue: 0,0:15:41.10,0:15:43.36,s7,,0,0,0,,（眠くない）王立天文台？
Dialogue: 0,0:15:43.44,0:15:47.07,s7,,0,0,0,,ええ この国は どこよりも\N天文学が進んでいて
Dialogue: 0,0:15:47.15,0:15:50.11,s7,,0,0,0,,町の外れに\N大きな施設があるんです
Dialogue: 0,0:15:50.82,0:15:54.28,s7,,0,0,0,,今後は マロニエ王国とも共同で\N研究を進めたく
Dialogue: 0,0:15:54.37,0:15:58.58,s7,,0,0,0,,蔵書も見てもらいたいとのことで\N行ってみようかと思うのですが
Dialogue: 0,0:15:58.66,0:16:00.16,s7,,0,0,0,,皆さん どうですか？
Dialogue: 0,0:16:00.25,0:16:02.92,s7,,0,0,0,,蔵書？　書物か…
Dialogue: 0,0:16:03.00,0:16:05.59,s7,,0,0,0,,珍しいですね 天文学の本は
Dialogue: 0,0:16:05.67,0:16:08.88,s7,,0,0,0,,（ヨアン）すまん 俺は今日\N先約を入れてしまってるんだ
Dialogue: 0,0:16:10.26,0:16:14.30,s7,,0,0,0,,午後の水時計の点検で\N中に入れてもらえることになってな
Dialogue: 0,0:16:14.80,0:16:17.76,s5,,0,0,0,,昨日の夜会で\N偶然 担当者と知り合って
Dialogue: 0,0:16:18.43,0:16:21.06,s7,,0,0,0,,それから午前中は畑の見学だ
Dialogue: 0,0:16:21.14,0:16:24.56,s7,,0,0,0,,この国は うちの西の領と\N似たような感じで
Dialogue: 0,0:16:24.65,0:16:27.44,s7,,0,0,0,,土地は荒れているが\N鍛冶の技術は進んでいて
Dialogue: 0,0:16:27.52,0:16:29.15,s7,,0,0,0,,開墾がうまくいっている
Dialogue: 0,0:16:29.23,0:16:30.61,s7,,0,0,0,,ヨアン おはよう
Dialogue: 0,0:16:30.69,0:16:31.70,s7,,0,0,0,,ああ おはよう
Dialogue: 0,0:16:31.78,0:16:32.70,Default,,0,0,0,,（ビルギッタ）\Nアンニ
Dialogue: 0,0:16:32.78,0:16:34.61,Default,,0,0,0,,今日は あそこで\N食べましょう
Dialogue: 0,0:16:34.70,0:16:36.16,Default,,0,0,0,,じゃあ また
Dialogue: 0,0:16:37.58,0:16:39.66,s7,,0,0,0,,いや 昨夜 少し話したもので
Dialogue: 0,0:16:39.74,0:16:43.87,s7,,0,0,0,,（外交官）王族と親睦を深めるのも\N立派な任務ですからね
Dialogue: 0,0:16:44.92,0:16:46.58,Default,,0,0,0,,天文台にも行きたいが
Dialogue: 0,0:16:46.67,0:16:49.13,Default,,0,0,0,,いろいろ学べるときに\N学んでおかねばな
Dialogue: 0,0:16:49.67,0:16:52.09,Default,,0,0,0,,自由な時間なんて\N限られているだろう
Dialogue: 0,0:16:52.17,0:16:55.84,s7,,0,0,0,,ヨアン君は 真面目ですね\Nよいことです
Dialogue: 0,0:16:55.93,0:16:59.06,s7,,0,0,0,,（ヨアン）うちは 中央みたいに\N恵まれてないのでね
Dialogue: 0,0:17:00.01,0:17:02.10,s7,,0,0,0,,（エリー）自由な時間か…
Dialogue: 0,0:17:04.19,0:17:05.48,s7,,0,0,0,,外交官様
Dialogue: 0,0:17:05.56,0:17:08.73,s7,,0,0,0,,ちなみにさ\Nこの国で一番強いヤツって誰？
Dialogue: 0,0:17:08.82,0:17:09.77,s7,,0,0,0,,（眠くない）エリー…
Dialogue: 0,0:17:09.86,0:17:11.74,s7,,0,0,0,,（ミカ）たぶん僕ですよ
Dialogue: 0,0:17:11.82,0:17:14.53,s7,,0,0,0,,一応 軍隊の隊長なんで
Dialogue: 0,0:17:14.61,0:17:17.24,s7,,0,0,0,,エレオノーラ嬢は\N強い男が お好みで？
Dialogue: 0,0:17:17.78,0:17:19.99,s7,,0,0,0,,べつに\Nそういうわけじゃねえけど…
Dialogue: 0,0:17:20.08,0:17:20.91,s7,,0,0,0,,よし！
Dialogue: 0,0:17:20.99,0:17:23.66,s7,,0,0,0,,そろそろ\N天文台に行く準備をしようか
Dialogue: 0,0:17:23.75,0:17:26.12,s7,,0,0,0,,（エリー）まだ食い終わってねえよ
Dialogue: 0,0:17:30.59,0:17:31.55,s7,,0,0,0,,（エリー）ん？
Dialogue: 0,0:17:32.34,0:17:34.26,s7,,0,0,0,,どうしたの？　この青い着物
Dialogue: 0,0:17:34.84,0:17:38.34,s7,,0,0,0,,先ほど お城の方が\N届けてくださったんですよ
Dialogue: 0,0:17:38.43,0:17:40.68,s7,,0,0,0,,お嬢様が\Nびしょびしょで帰ってきてたの―
Dialogue: 0,0:17:40.76,0:17:41.97,s7,,0,0,0,,見てたんじゃないですか？
Dialogue: 0,0:17:42.06,0:17:43.77,Default,,0,0,0,,ふーん
Dialogue: 0,0:17:43.85,0:17:47.19,Default,,0,0,0,,これさ 布と花が\N全く同じ青なんだね
Dialogue: 0,0:17:47.27,0:17:51.19,s7,,0,0,0,,（侍女頭）きっと その花が\N一番よく取れる染料なんですよ
Dialogue: 0,0:17:51.27,0:17:54.86,s7,,0,0,0,,青い服の方が多いし\N国旗も青ですし
Dialogue: 0,0:17:54.94,0:17:56.11,s7,,0,0,0,,（エリー）ああ 確かに
Dialogue: 0,0:17:56.20,0:17:59.91,s7,,0,0,0,,我が国は皆\N夕日色の着物じゃないですか
Dialogue: 0,0:17:59.99,0:18:01.20,s7,,0,0,0,,この国にはない―
Dialogue: 0,0:18:01.28,0:18:03.24,s5,,0,0,0,,空と大地の色ですわ
Dialogue: 0,0:18:03.75,0:18:06.66,s7,,0,0,0,,この赤っぽい色\N土で染めてんだっけ？
Dialogue: 0,0:18:06.75,0:18:10.00,s7,,0,0,0,,ええ\N土なら いくらでもあるでしょ
Dialogue: 0,0:18:10.08,0:18:11.42,s7,,0,0,0,,そうだよね
Dialogue: 0,0:18:11.50,0:18:13.88,s7,,0,0,0,,昔 町の染め物屋さんで\N見た気がする
Dialogue: 0,0:18:13.96,0:18:16.76,s7,,0,0,0,,（侍女頭）あっ でも\Nその青いお着物 着るなら
Dialogue: 0,0:18:16.84,0:18:18.18,s7,,0,0,0,,着付けしますよ
Dialogue: 0,0:18:18.26,0:18:20.72,s7,,0,0,0,,手触りがよくて\N花の刺しゅうもあって
Dialogue: 0,0:18:20.80,0:18:22.01,s7,,0,0,0,,かわいいやつなんです
Dialogue: 0,0:18:22.10,0:18:22.93,s7,,0,0,0,,え…
Dialogue: 0,0:18:23.97,0:18:25.14,s7,,0,0,0,,似合ってる
Dialogue: 0,0:18:25.23,0:18:26.18,s7,,0,0,0,,（エリー）イヤだ 着ない！
Dialogue: 0,0:18:26.27,0:18:28.56,s7,,0,0,0,,（侍女頭）ドアは蹴らない！\N（エリー）いってきます！
Dialogue: 0,0:18:29.19,0:18:31.52,s7,,0,0,0,,（エリー）絶対 もう着なーい！
Dialogue: 0,0:18:31.61,0:18:33.07,s7,,0,0,0,,（精霊２）えっ？\N（精霊１）着てないじゃん！
Dialogue: 0,0:18:33.15,0:18:35.82,s7,,0,0,0,,せっかく\N女中に持っていかせたのに
Dialogue: 0,0:18:35.90,0:18:37.78,s7,,0,0,0,,好みじゃなかったのかしら？
Dialogue: 0,0:18:37.86,0:18:41.87,s7,,0,0,0,,（精霊２）とにかく あの娘を\Nイブまでに なんとかしなければ
Dialogue: 0,0:18:41.95,0:18:44.74,s7,,0,0,0,,（精霊３）兵士に命じて\N森にでも捨ててこさせる？
Dialogue: 0,0:18:44.83,0:18:45.91,s7,,0,0,0,,（精霊１）それは ちょっと…\N悪い子じゃないし
Dialogue: 0,0:18:45.91,0:18:48.04,s7,,0,0,0,,（精霊１）それは ちょっと…\N悪い子じゃないし
Dialogue: 0,0:18:45.91,0:18:48.04,Default,,0,0,0,,（眠くない）あの…\Nなんの話を？
Dialogue: 0,0:18:48.12,0:18:48.96,Default,,0,0,0,,（精霊たち）\Nぎゃー！
Dialogue: 0,0:18:49.54,0:18:52.17,s7,,0,0,0,,（精霊２）なんでもないですー！\N（精霊１）失礼しました！
Dialogue: 0,0:19:05.01,0:19:06.60,s7,,0,0,0,,（眠くない）隊長さん\N（ミカ）ん？
Dialogue: 0,0:19:06.68,0:19:09.85,s7,,0,0,0,,この城に仕えてる\N少し古い感じの服の子たちって
Dialogue: 0,0:19:09.94,0:19:10.77,s7,,0,0,0,,何者ですか？
Dialogue: 0,0:19:11.48,0:19:14.98,s7,,0,0,0,,三角の耳当てで\Nよくウロウロしてるんですが
Dialogue: 0,0:19:15.07,0:19:18.28,s7,,0,0,0,,耳当て？　そんな子いました？
Dialogue: 0,0:19:18.36,0:19:20.91,s7,,0,0,0,,あとで他の者に聞いてみますね
Dialogue: 0,0:19:21.49,0:19:23.87,s7,,0,0,0,,眠くない 何？　どうしたの？
Dialogue: 0,0:19:23.95,0:19:27.41,s7,,0,0,0,,（精霊２）あの娘を\Nイブまでに なんとかしなければ
Dialogue: 0,0:19:28.58,0:19:29.79,s7,,0,0,0,,ああ いや…
Dialogue: 0,0:19:31.00,0:19:34.50,s5,,0,0,0,,イブって たぶん\Nヴァルプルガ･イブのことだ
Dialogue: 0,0:19:34.59,0:19:37.71,s5,,0,0,0,,僕ではなく\Nエリーのことなのが気になるが
Dialogue: 0,0:19:38.46,0:19:41.01,s7,,0,0,0,,（ノック）\N（ミカ）馬車 出してください
Dialogue: 0,0:19:41.09,0:19:43.43,s7,,0,0,0,,（眠くない）\Nみんな 普通の子みたいだったけど
Dialogue: 0,0:19:44.51,0:19:46.22,s5,,0,0,0,,何かあるのか？
Dialogue: 0,0:19:48.35,0:19:50.44,s7,,0,0,0,,（ナレーション）\Nここは 女王の配偶者
Dialogue: 0,0:19:50.52,0:19:53.86,s5,,0,0,0,,すなわち 王配 ロロの部屋
Dialogue: 0,0:19:54.44,0:19:57.69,s7,,0,0,0,,（ヒュロッキン）祭りは\N最初の予定どおりに行います
Dialogue: 0,0:19:59.32,0:20:03.07,s7,,0,0,0,,その… 今朝は お話しできて\Nホントによかったわ
Dialogue: 0,0:20:03.74,0:20:07.45,s7,,0,0,0,,大聖堂での祭りの挨拶の\N打ち合わせの前に
Dialogue: 0,0:20:07.54,0:20:10.33,s7,,0,0,0,,少し大司教様とお時間を
Dialogue: 0,0:20:21.88,0:20:24.05,s7,,0,0,0,,いい？　大司教様と女王が
Dialogue: 0,0:20:24.14,0:20:27.35,s7,,0,0,0,,なんの話をするか\N聞いてもらいたいの
Dialogue: 0,0:20:27.43,0:20:30.18,s7,,0,0,0,,そう これは どの建物にもある―
Dialogue: 0,0:20:30.27,0:20:33.56,s7,,0,0,0,,あなたたち暖炉にしか\N頼めないから お願い
Dialogue: 0,0:20:34.10,0:20:35.69,s7,,0,0,0,,え？　私？
Dialogue: 0,0:20:35.77,0:20:37.86,s7,,0,0,0,,今日は 丘には行かないわ
Dialogue: 0,0:20:38.36,0:20:41.03,s7,,0,0,0,,青い花の子たち\N騎士長様を返さないよう
Dialogue: 0,0:20:41.11,0:20:42.74,s7,,0,0,0,,女王を誘導してるでしょ？
Dialogue: 0,0:20:43.49,0:20:46.70,Default,,0,0,0,,ダメよ そんなの\N戦争になってしまうわ
Dialogue: 0,0:20:49.49,0:20:52.37,s7,,0,0,0,,ホントに どうしちゃったのかしら\Nあの子たち
Dialogue: 0,0:20:52.46,0:20:54.92,s7,,0,0,0,,決して悪い子じゃないのに…
Dialogue: 0,0:20:55.96,0:20:58.63,s7,,0,0,0,,（眠くない）\Nなんだか丘まで青く見えるな
Dialogue: 0,0:20:59.55,0:21:01.80,s7,,0,0,0,,（エリー）\Nあれ お姫様たちじゃね？
Dialogue: 0,0:21:01.88,0:21:05.01,s7,,0,0,0,,（外交官）おお 隊長君の奥方だ
Dialogue: 0,0:21:05.09,0:21:07.55,s7,,0,0,0,,（ミカ）\Nああ 花輪を作ってるんです
Dialogue: 0,0:21:07.64,0:21:10.22,s7,,0,0,0,,祭りの間 家を青く飾るんですよ
Dialogue: 0,0:21:10.97,0:21:12.02,s7,,0,0,0,,（エリー）何か言ってるよ
Dialogue: 0,0:21:12.10,0:21:13.18,s7,,0,0,0,,（ミカ）止めてくれ
Dialogue: 0,0:21:14.52,0:21:17.90,s7,,0,0,0,,ビルギッタ お疲れさまです！\Nどうかされましたか？
Dialogue: 0,0:21:18.56,0:21:20.86,s7,,0,0,0,,いらっしゃいませんか？\Nエレオノーラさん
Dialogue: 0,0:21:20.94,0:21:23.28,s7,,0,0,0,,おじさんたちと一緒では\Nつまらないでしょ
Dialogue: 0,0:21:23.36,0:21:25.28,s7,,0,0,0,,おじ… さん
Dialogue: 0,0:21:25.36,0:21:27.87,s7,,0,0,0,,そうだな\N本 読むの つらいし
Dialogue: 0,0:21:28.49,0:21:29.33,s7,,0,0,0,,（眠くない）エリー！
Dialogue: 0,0:21:32.08,0:21:34.00,s7,,0,0,0,,その… 気をつけて
Dialogue: 0,0:21:37.25,0:21:40.63,s7,,0,0,0,,（農民１）この国は\N１年のうち７か月が冬で
Dialogue: 0,0:21:40.71,0:21:42.13,s7,,0,0,0,,ずーっと真っ暗だ
Dialogue: 0,0:21:42.92,0:21:45.01,s7,,0,0,0,,雪が溶けた今時分には
Dialogue: 0,0:21:45.09,0:21:48.89,s7,,0,0,0,,畑は 霜で押し出された石や岩で\Nいっぱいでな
Dialogue: 0,0:21:48.97,0:21:51.85,s7,,0,0,0,,毎年 毎年 最初の仕事が石拾いだ
Dialogue: 0,0:21:51.93,0:21:54.48,s7,,0,0,0,,（農民２）道も長いこと\Nぬかるみだらけで
Dialogue: 0,0:21:54.56,0:21:56.31,s7,,0,0,0,,歩けたもんじゃねえし
Dialogue: 0,0:21:56.39,0:21:58.60,s7,,0,0,0,,（ヨアン）それでも\Nずっと住んでるということは
Dialogue: 0,0:21:58.69,0:21:59.77,s7,,0,0,0,,いい場所なんだろ
Dialogue: 0,0:21:59.86,0:22:02.07,s7,,0,0,0,,（農民２）おっ\N兄ちゃん 分かってんな
Dialogue: 0,0:22:08.61,0:22:09.45,s7,,0,0,0,,あ…
Dialogue: 0,0:22:10.41,0:22:12.29,s5,,0,0,0,,すごい青…
Dialogue: 0,0:22:14.33,0:22:16.37,s7,,0,0,0,,この青い花で作るんですよ
Dialogue: 0,0:22:16.46,0:22:18.96,s7,,0,0,0,,（エリー）へえ\N小さい子でも上手だね
Dialogue: 0,0:22:19.75,0:22:22.80,s7,,0,0,0,,（ビルギッタ）子供は\Nご褒美に卵がもらえるんです
Dialogue: 0,0:22:23.84,0:22:25.88,s7,,0,0,0,,（精霊２）\Nちょうどいいところに来たわね
Dialogue: 0,0:22:25.97,0:22:30.26,s7,,0,0,0,,（精霊１）夜と マロニエ王国へ\N帰る約束をした娘
Dialogue: 0,0:22:31.01,0:22:32.22,s7,,0,0,0,,この花は
Dialogue: 0,0:22:32.31,0:22:36.23,s7,,0,0,0,,ここに夜の長い国ができる前から\N咲いているんですよ
Dialogue: 0,0:22:36.31,0:22:39.56,s7,,0,0,0,,ここをずっと守っている\N古代種なんです
Dialogue: 0,0:22:39.65,0:22:43.23,s7,,0,0,0,,夜には どうしても\Nここに残ってもらわないと
Dialogue: 0,0:22:43.32,0:22:45.19,s7,,0,0,0,,祭りまで もう時間がない
Dialogue: 0,0:22:45.82,0:22:48.65,s7,,0,0,0,,（精霊２）さあ 青い衣の娘たち
Dialogue: 0,0:22:48.74,0:22:53.37,s7,,0,0,0,,あの異国の娘に\Nその青の花飾りをかけるのよ
Dialogue: 0,0:22:53.45,0:22:55.16,s7,,0,0,0,,えっ くれるの？
Dialogue: 0,0:22:55.24,0:22:56.33,s7,,0,0,0,,ありがと
Dialogue: 0,0:22:56.41,0:22:59.79,s7,,0,0,0,,（精霊２）青をまとわせて\N従わせるのです
Dialogue: 0,0:23:02.71,0:23:04.71,s7,,0,0,0,,異国の娘よ
Dialogue: 0,0:23:04.80,0:23:06.42,s7,,0,0,0,,お前は今から
Dialogue: 0,0:23:06.51,0:23:09.43,s7,,0,0,0,,１人で この地を去るのです
Dialogue: 0,0:23:16.47,0:23:20.48,s7,,0,0,0,,♪～
Dialogue: 0,0:24:41.93,0:24:45.94,s7,,0,0,0,,～♪
Dialogue: 0,0:24:47.27,0:24:51.74,s7,,0,0,0,,（大司教）これは千載一遇の\Nチャンスだと思うのですが
Dialogue: 0,0:24:51.82,0:24:55.78,s7,,0,0,0,,（城代）君が ここから\N見えてほしかった隣の国は
Dialogue: 0,0:24:55.87,0:24:58.45,s5,,0,0,0,,どの国だったのかね