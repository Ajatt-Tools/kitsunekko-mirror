Dialogue: 0,0:00:07.67,0:00:09.63,Default,,0,0,0,,（ナレーション）ある年のこと
Dialogue: 0,0:00:09.71,0:00:11.30,s4,,0,0,0,,一つの国では
Dialogue: 0,0:00:11.38,0:00:14.80,s4,,0,0,0,,灼熱しゃくねつの炎のごとく太陽が照りつけ
Dialogue: 0,0:00:15.34,0:00:17.18,s4,,0,0,0,,別の国では
Dialogue: 0,0:00:17.26,0:00:20.81,s4,,0,0,0,,激しい雨が長く降り続いた
Dialogue: 0,0:00:20.89,0:00:24.19,s4,,0,0,0,,大地は荒れ 作物は実らず
Dialogue: 0,0:00:24.27,0:00:28.19,s4,,0,0,0,,動物たちは困り果て\N人々の心も すさんだ
Dialogue: 0,0:00:28.27,0:00:29.78,Default,,0,0,0,,（剣と剣がぶつかる音）
Dialogue: 0,0:00:29.86,0:00:33.61,Default,,0,0,0,,（ナレーション）\Nそして 均衡は破れた
Dialogue: 0,0:00:34.16,0:00:36.32,s4,,0,0,0,,剣と剣が ぶつかり合い
Dialogue: 0,0:00:36.41,0:00:38.58,s4,,0,0,0,,人と人とは憎み合う
Dialogue: 0,0:00:44.21,0:00:46.29,s4,,0,0,0,,力による支配
Dialogue: 0,0:00:46.38,0:00:48.42,s4,,0,0,0,,理性なき争い
Dialogue: 0,0:00:50.09,0:00:51.63,s4,,0,0,0,,だが彼は
Dialogue: 0,0:00:52.17,0:00:55.51,s4,,0,0,0,,それを本当に\N望んでいたのだろうか
Dialogue: 0,0:01:06.06,0:01:10.07,Default,,0,0,0,,♪～
Dialogue: 0,0:02:31.94,0:02:35.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:48.91,0:02:51.83,Default,,0,0,0,,（眠ねむくない）あ…
Dialogue: 0,0:02:53.88,0:02:56.63,Default,,0,0,0,,（エリー）眠くない\N父様の所に行くんだろ？
Dialogue: 0,0:02:56.71,0:02:58.05,Default,,0,0,0,,急ごうよ
Dialogue: 0,0:03:00.89,0:03:01.72,Default,,0,0,0,,なんだ これ！
Dialogue: 0,0:03:01.80,0:03:03.26,Default,,0,0,0,,（アナマリー）\Nどうかしたんですか？
Dialogue: 0,0:03:03.35,0:03:04.72,Default,,0,0,0,,あっ アナマリー
Dialogue: 0,0:03:04.81,0:03:07.56,Default,,0,0,0,,俺たち 今 戻ったんだけどさ\Nこの部屋のみんな…
Dialogue: 0,0:03:07.64,0:03:10.14,Default,,0,0,0,,（アナマリー）ええー！\N城代様は どちらに？
Dialogue: 0,0:03:10.23,0:03:12.02,Default,,0,0,0,,早く知らせないと！
Dialogue: 0,0:03:12.10,0:03:13.90,Default,,0,0,0,,（エリー）呼んでくるよ\N行こう 眠くない
Dialogue: 0,0:03:13.98,0:03:15.57,Default,,0,0,0,,（眠くない）あ… うん
Dialogue: 0,0:03:19.65,0:03:20.57,Default,,0,0,0,,（眠くない）僕は今
Dialogue: 0,0:03:20.65,0:03:24.03,s4,,0,0,0,,もしかして\Nうたた寝をしていたのか？
Dialogue: 0,0:03:25.62,0:03:29.50,Default,,0,0,0,,（ナレーション）ふだんは\N眠くならない眠くないだが
Dialogue: 0,0:03:29.58,0:03:32.00,s4,,0,0,0,,この日は 少し変だった
Dialogue: 0,0:03:33.75,0:03:37.76,Default,,0,0,0,,（鐘の音）
Dialogue: 0,0:03:40.84,0:03:43.34,Default,,0,0,0,,（ナレーション）七人の騎士の兄弟
Dialogue: 0,0:03:40.84,0:03:43.34,Default,,0,0,0,,（ハラペコのあくび）
Dialogue: 0,0:03:43.43,0:03:46.51,s4,,0,0,0,,彼らの一日が始まろうとしている
Dialogue: 0,0:03:46.60,0:03:49.27,Default,,0,0,0,,（剣自慢つるぎじまん）んっ んっ…
Dialogue: 0,0:03:49.89,0:03:52.48,Default,,0,0,0,,（ハラペコ）起きて 寒がりや\N時間だよ
Dialogue: 0,0:03:53.19,0:03:56.07,Default,,0,0,0,,頭のとこで寝てくれる\N猫ちゃんがいてよかったね
Dialogue: 0,0:03:56.15,0:03:56.98,Default,,0,0,0,,（寒さむがりや）うーん
Dialogue: 0,0:04:05.03,0:04:07.70,Default,,0,0,0,,おはようございます ブルーノ様
Dialogue: 0,0:04:09.87,0:04:11.58,Default,,0,0,0,,（眠くない）みんな おはよう
Dialogue: 0,0:04:11.66,0:04:13.92,Default,,0,0,0,,（博愛はくあい）眠くない\N読書は進んだかい？
Dialogue: 0,0:04:14.00,0:04:16.25,Default,,0,0,0,,うん ゆうべは２冊読めたよ
Dialogue: 0,0:04:16.34,0:04:17.92,Default,,0,0,0,,（剣自慢）んっ！
Dialogue: 0,0:04:18.00,0:04:19.84,Default,,0,0,0,,よーし ひと汗かいたぜ！
Dialogue: 0,0:04:19.92,0:04:21.80,Default,,0,0,0,,（獣使けものつかい）おはよう モジャ
Dialogue: 0,0:04:21.88,0:04:24.30,Default,,0,0,0,,（暑あつがりや）ハァ～ もう朝かよ
Dialogue: 0,0:04:24.39,0:04:27.26,Default,,0,0,0,,寒がりや 早く準備して
Dialogue: 0,0:04:27.35,0:04:28.51,Default,,0,0,0,,（寒がりや）分かってる
Dialogue: 0,0:04:31.35,0:04:34.73,Default,,0,0,0,,（風が吹き込む音）
Dialogue: 0,0:04:34.81,0:04:37.56,Default,,0,0,0,,（寒がりや）\Nさすがに５階は 風強いな
Dialogue: 0,0:04:37.65,0:04:39.36,Default,,0,0,0,,急いで急いで！
Dialogue: 0,0:04:39.44,0:04:41.94,Default,,0,0,0,,今日 俺らは倉庫だっけ？
Dialogue: 0,0:04:43.78,0:04:45.74,Default,,0,0,0,,（暑がりや）うあ～ いい風だ
Dialogue: 0,0:04:45.82,0:04:48.99,Default,,0,0,0,,（獣使い）暑がりや\N急がないと また怒られるぞ
Dialogue: 0,0:04:49.08,0:04:50.08,Default,,0,0,0,,（暑がりや）あ～あ…
Dialogue: 0,0:04:52.79,0:04:55.42,Default,,0,0,0,,（助手１）昨日のニシン\N酸っぱすぎだってよ
Dialogue: 0,0:04:56.08,0:04:58.29,Default,,0,0,0,,（助手２）小麦粉 カラなんだけど
Dialogue: 0,0:04:58.38,0:05:01.34,Default,,0,0,0,,（助手３）誰か\Nオレガノ 積んできてくれ
Dialogue: 0,0:05:03.55,0:05:05.09,Default,,0,0,0,,（おなかが鳴る音）\N（ハラペコ）あっ
Dialogue: 0,0:05:05.18,0:05:08.43,Default,,0,0,0,,パン食べていい？\Nそろそろ 僕 ヤバいんだけど
Dialogue: 0,0:05:08.51,0:05:11.72,Default,,0,0,0,,（助手２）ああ\N昨日の残りから食ってくれ
Dialogue: 0,0:05:12.56,0:05:14.64,Default,,0,0,0,,（コレットの父）\N今日は 客人が多いから
Dialogue: 0,0:05:14.73,0:05:17.02,Default,,0,0,0,,早めに\N配膳室に運ばなきゃいかんぞ
Dialogue: 0,0:05:17.10,0:05:18.61,Default,,0,0,0,,（助手たち）へーい！
Dialogue: 0,0:05:19.40,0:05:20.94,Default,,0,0,0,,（寒がりや）客人…
Dialogue: 0,0:05:23.57,0:05:26.53,s4,,0,0,0,,辺境伯様は\N来られてるんだろうか…
Dialogue: 0,0:05:26.61,0:05:27.45,Default,,0,0,0,,（コレット）寒がりや
Dialogue: 0,0:05:27.53,0:05:30.12,Default,,0,0,0,,ボサッとすんなよ\N火 ついてるぞ
Dialogue: 0,0:05:30.20,0:05:31.41,Default,,0,0,0,,（寒がりや）えっ
Dialogue: 0,0:05:31.49,0:05:32.79,Default,,0,0,0,,わあーっ
Dialogue: 0,0:05:35.50,0:05:37.33,Default,,0,0,0,,ありがとう コレット
Dialogue: 0,0:05:37.42,0:05:39.84,Default,,0,0,0,,道理で足元が気持ちいいと…
Dialogue: 0,0:05:39.92,0:05:42.05,Default,,0,0,0,,（コレット）\Nそのテカテカしたやつか
Dialogue: 0,0:05:42.13,0:05:45.26,Default,,0,0,0,,貴族の息子にもらった\N首巻きってのは
Dialogue: 0,0:05:45.84,0:05:49.18,Default,,0,0,0,,一番上の兄貴\Nゆうべ ここで泣いてたぜ
Dialogue: 0,0:05:49.26,0:05:53.18,Default,,0,0,0,,田舎貴族のおもちゃにされるために\Nお前を育てたんじゃないってな
Dialogue: 0,0:05:53.27,0:05:55.77,Default,,0,0,0,,（寒がりや）待って！\Nどうして そんな話になってんの？
Dialogue: 0,0:05:55.85,0:05:57.31,Default,,0,0,0,,（コレットの父）おい 寒がり
Dialogue: 0,0:05:57.98,0:05:59.56,Default,,0,0,0,,お貴族様なんてな
Dialogue: 0,0:05:59.65,0:06:02.52,Default,,0,0,0,,自分の領地 守るためなら\N国王でも裏切る連中だ
Dialogue: 0,0:06:02.61,0:06:03.78,Default,,0,0,0,,（助手３）そうだそうだ
Dialogue: 0,0:06:03.86,0:06:05.86,Default,,0,0,0,,あいつら めっちゃ ごはん残すし
Dialogue: 0,0:06:05.94,0:06:07.91,Default,,0,0,0,,おめえ 国王家の騎士だろ？
Dialogue: 0,0:06:07.99,0:06:10.37,Default,,0,0,0,,誰にでも\Nヘラヘラしてんじゃねえぞ
Dialogue: 0,0:06:10.45,0:06:11.28,Default,,0,0,0,,うん…
Dialogue: 0,0:06:12.24,0:06:13.29,Default,,0,0,0,,（コレットの父）\Nここは もういいから
Dialogue: 0,0:06:13.37,0:06:14.45,Default,,0,0,0,,ちょっと鍛えてこい
Dialogue: 0,0:06:14.54,0:06:16.00,Default,,0,0,0,,（寒がりや）分かった　そうする
Dialogue: 0,0:06:18.71,0:06:19.92,Default,,0,0,0,,（ハラペコ）ん？
Dialogue: 0,0:06:20.54,0:06:21.84,Default,,0,0,0,,とは言っても
Dialogue: 0,0:06:21.92,0:06:26.97,Default,,0,0,0,,こう平和だと 僕らの仕事って\N王の領地のお世話くらいだもんね
Dialogue: 0,0:06:27.05,0:06:29.22,Default,,0,0,0,,あとは お客さんの相手とか…
Dialogue: 0,0:06:29.97,0:06:33.68,s4,,0,0,0,,まあ このまま出番がなければ\N一番いいんだけど
Dialogue: 0,0:06:37.23,0:06:38.52,Default,,0,0,0,,（寒がりやのため息）
Dialogue: 0,0:06:39.48,0:06:43.19,Default,,0,0,0,,（博愛）君は もともとヘタだけど\N今日は とりわけひどいね
Dialogue: 0,0:06:43.27,0:06:45.48,Default,,0,0,0,,何か動揺でもしてるのかな？
Dialogue: 0,0:06:45.57,0:06:47.74,Default,,0,0,0,,（寒がりや）いや べつにそんな…
Dialogue: 0,0:06:48.90,0:06:53.53,Default,,0,0,0,,恋愛のことなら ラブ様こと\Nこの博愛に相談してごらんよ
Dialogue: 0,0:06:54.16,0:06:58.75,Default,,0,0,0,,博愛は いろいろと範囲広すぎて\N参考にならないんだよね
Dialogue: 0,0:06:58.83,0:06:59.83,Default,,0,0,0,,ん？
Dialogue: 0,0:06:59.92,0:07:02.17,Default,,0,0,0,,あー ごめん\Nちょっと 頭 冷やす
Dialogue: 0,0:07:02.25,0:07:04.96,Default,,0,0,0,,えっ 寒がりや君！\N僕は 君の力に…
Dialogue: 0,0:07:05.05,0:07:07.63,Default,,0,0,0,,（少年１）城代 全然 開かないよ
Dialogue: 0,0:07:07.71,0:07:10.09,Default,,0,0,0,,（城代）力の入れ方ですよ
Dialogue: 0,0:07:10.18,0:07:13.18,Default,,0,0,0,,子供用の弓ですから\N硬くはないはず
Dialogue: 0,0:07:13.26,0:07:16.89,Default,,0,0,0,,それくらい引けないと\N立派な騎士にはなれません
Dialogue: 0,0:07:16.97,0:07:20.44,Default,,0,0,0,,背筋を伸ばして\N腕をスッと後ろに引くといいよ
Dialogue: 0,0:07:20.52,0:07:21.60,Default,,0,0,0,,（少年２）あっ 博愛
Dialogue: 0,0:07:21.69,0:07:25.57,Default,,0,0,0,,（少年１）あのね 俺\Nこのお城の騎士になりたいんだ
Dialogue: 0,0:07:25.65,0:07:26.65,Default,,0,0,0,,（少年２）僕も！
Dialogue: 0,0:07:26.73,0:07:29.57,Default,,0,0,0,,（博愛）うんうん\N僕を見習うといいよ
Dialogue: 0,0:07:29.65,0:07:31.61,Default,,0,0,0,,（寒がりや）そうだよな…
Dialogue: 0,0:07:31.70,0:07:33.32,s4,,0,0,0,,俺は この城の騎士で
Dialogue: 0,0:07:33.41,0:07:36.29,s4,,0,0,0,,有事の際には\N一番に前線に出なきゃ
Dialogue: 0,0:07:37.54,0:07:40.50,s4,,0,0,0,,いつでも\N何かの役に立てたらいいのに…
Dialogue: 0,0:07:41.37,0:07:43.29,s4,,0,0,0,,ブルーノ様も辺境伯だから
Dialogue: 0,0:07:43.38,0:07:46.71,s4,,0,0,0,,領地が最初の防衛地に\Nなるかもしれないし…
Dialogue: 0,0:07:46.80,0:07:48.80,s4,,0,0,0,,もう会うこともないかもだし
Dialogue: 0,0:07:48.88,0:07:51.05,s4,,0,0,0,,このまま いい思い出に…
Dialogue: 0,0:07:51.13,0:07:52.68,Default,,0,0,0,,（ブリュンヒルデ）寒がりや君\N（寒がりや）ん？
Dialogue: 0,0:07:53.43,0:07:55.64,Default,,0,0,0,,（ブリュンヒルデ）\N相変わらず寒そうだな
Dialogue: 0,0:07:55.72,0:07:57.89,Default,,0,0,0,,毛皮の上着でも\Nあった方がいいか？
Dialogue: 0,0:08:02.39,0:08:04.15,Default,,0,0,0,,（寒がりや）あっ いえ！
Dialogue: 0,0:08:04.23,0:08:06.82,Default,,0,0,0,,貴族の方に\Nあまりいいものを頂くと
Dialogue: 0,0:08:06.90,0:08:09.36,Default,,0,0,0,,兄弟が性的な心配するんで！
Dialogue: 0,0:08:09.44,0:08:11.28,Default,,0,0,0,,（ブリュンヒルデ）\N地下牢ちかろうに入れるぞ…！
Dialogue: 0,0:08:11.36,0:08:12.53,Default,,0,0,0,,あ…
Dialogue: 0,0:08:13.32,0:08:15.20,Default,,0,0,0,,ちょうどよかった
Dialogue: 0,0:08:15.74,0:08:16.95,Default,,0,0,0,,上に来てくれ
Dialogue: 0,0:08:18.20,0:08:19.91,Default,,0,0,0,,（寒がりや）\Nえ… なんですか？　これ
Dialogue: 0,0:08:20.00,0:08:21.58,Default,,0,0,0,,ヌートリア？
Dialogue: 0,0:08:21.66,0:08:22.71,Default,,0,0,0,,（ブリュンヒルデ）ここの地下牢は
Dialogue: 0,0:08:22.79,0:08:25.63,Default,,0,0,0,,地獄より不衛生らしいぞ\N寒がりや君
Dialogue: 0,0:08:25.71,0:08:26.63,Default,,0,0,0,,（寒がりや）うう…
Dialogue: 0,0:08:26.71,0:08:28.21,Default,,0,0,0,,ペットのリスちゃんだ
Dialogue: 0,0:08:28.92,0:08:32.26,Default,,0,0,0,,散歩に連れて出たら\N力尽きて寝てしまってな
Dialogue: 0,0:08:32.34,0:08:34.43,Default,,0,0,0,,木に登る練習をさせたいから
Dialogue: 0,0:08:34.51,0:08:36.97,Default,,0,0,0,,森まで運ぶのを\N手伝ってくれないか？
Dialogue: 0,0:08:38.06,0:08:39.35,Default,,0,0,0,,（コレット）兄貴が泣いてたぜ
Dialogue: 0,0:08:39.43,0:08:41.73,Default,,0,0,0,,ヘラヘラしてんじゃねえぞ
Dialogue: 0,0:08:43.60,0:08:45.73,Default,,0,0,0,,（アナマリー）\N姫様～！
Dialogue: 0,0:08:45.81,0:08:46.69,Default,,0,0,0,,お花の刺しゅうでも\Nしませんか～？
Dialogue: 0,0:08:46.69,0:08:48.11,Default,,0,0,0,,お花の刺しゅうでも\Nしませんか～？
Dialogue: 0,0:08:46.69,0:08:48.11,Default,,0,0,0,,（ブリュンヒルデ）\Nすまん 邪魔したな！
Dialogue: 0,0:08:48.11,0:08:48.19,Default,,0,0,0,,お花の刺しゅうでも\Nしませんか～？
Dialogue: 0,0:08:48.19,0:08:49.07,Default,,0,0,0,,お花の刺しゅうでも\Nしませんか～？
Dialogue: 0,0:08:48.19,0:08:49.07,Default,,0,0,0,,私は 迅速に\Nここを去らねばならん
Dialogue: 0,0:08:49.07,0:08:49.15,Default,,0,0,0,,私は 迅速に\Nここを去らねばならん
Dialogue: 0,0:08:49.15,0:08:50.32,Default,,0,0,0,,私は 迅速に\Nここを去らねばならん
Dialogue: 0,0:08:49.15,0:08:50.32,Default,,0,0,0,,お部屋に飾れば
Dialogue: 0,0:08:50.40,0:08:51.65,Default,,0,0,0,,起きろ 肉の塊！
Dialogue: 0,0:08:50.40,0:08:51.65,Default,,0,0,0,,華やかに\Nなりますわよ～！
Dialogue: 0,0:08:51.65,0:08:51.74,Default,,0,0,0,,華やかに\Nなりますわよ～！
Dialogue: 0,0:08:51.74,0:08:52.57,Default,,0,0,0,,華やかに\Nなりますわよ～！
Dialogue: 0,0:08:51.74,0:08:52.57,Default,,0,0,0,,（寒がりや）ん？
Dialogue: 0,0:08:52.65,0:08:53.28,Default,,0,0,0,,（寒がりや）あ！
Dialogue: 0,0:08:53.28,0:08:53.78,Default,,0,0,0,,（寒がりや）あ！
Dialogue: 0,0:08:53.28,0:08:53.78,Default,,0,0,0,,姫様～\Nもうどこです～？
Dialogue: 0,0:08:53.78,0:08:53.86,Default,,0,0,0,,姫様～\Nもうどこです～？
Dialogue: 0,0:08:53.86,0:08:56.24,Default,,0,0,0,,姫様～\Nもうどこです～？
Dialogue: 0,0:08:53.86,0:08:56.24,Default,,0,0,0,,ブルーノ様 お急ぎなら
Dialogue: 0,0:08:56.24,0:08:56.32,Default,,0,0,0,,姫様～\Nもうどこです～？
Dialogue: 0,0:08:56.32,0:08:57.74,Default,,0,0,0,,姫様～\Nもうどこです～？
Dialogue: 0,0:08:56.32,0:08:57.74,Default,,0,0,0,,森は キツネが\N出るかもしれないから
Dialogue: 0,0:08:57.74,0:08:57.82,Default,,0,0,0,,森は キツネが\N出るかもしれないから
Dialogue: 0,0:08:57.82,0:08:58.24,Default,,0,0,0,,森は キツネが\N出るかもしれないから
Dialogue: 0,0:08:57.82,0:08:58.24,Default,,0,0,0,,姫様～？　姫様～！
Dialogue: 0,0:08:58.24,0:08:58.33,Default,,0,0,0,,姫様～？　姫様～！
Dialogue: 0,0:08:58.33,0:09:00.16,Default,,0,0,0,,姫様～？　姫様～！
Dialogue: 0,0:08:58.33,0:09:00.16,Default,,0,0,0,,アッパーガーデンに行きましょう
Dialogue: 0,0:09:00.16,0:09:00.95,Default,,0,0,0,,姫様～？　姫様～！
Dialogue: 0,0:09:01.04,0:09:02.75,Default,,0,0,0,,寒がりや？
Dialogue: 0,0:09:01.04,0:09:02.75,Default,,0,0,0,,どこですか？\Nもう！
Dialogue: 0,0:09:02.75,0:09:03.41,Default,,0,0,0,,どこですか？\Nもう！
Dialogue: 0,0:09:06.79,0:09:08.84,Default,,0,0,0,,獣使いがいたらいいんだけど
Dialogue: 0,0:09:08.92,0:09:10.84,Default,,0,0,0,,今日は倉庫だしな…
Dialogue: 0,0:09:10.92,0:09:13.26,Default,,0,0,0,,（少年１）こう？\N（博愛）そう
Dialogue: 0,0:09:13.34,0:09:14.17,Default,,0,0,0,,（博愛）ん？
Dialogue: 0,0:09:25.48,0:09:27.56,Default,,0,0,0,,（寒がりや）\N他人が抱っこしても起きないって
Dialogue: 0,0:09:28.15,0:09:30.27,Default,,0,0,0,,動物としては おかしいですよ
Dialogue: 0,0:09:30.86,0:09:34.36,Default,,0,0,0,,（ブリュンヒルデ）リスちゃんは\N細かいことは気にしない性格なんだ
Dialogue: 0,0:09:34.90,0:09:35.74,Default,,0,0,0,,が…
Dialogue: 0,0:09:36.49,0:09:38.49,Default,,0,0,0,,さて どうしたものか
Dialogue: 0,0:09:38.57,0:09:39.41,Default,,0,0,0,,ん？
Dialogue: 0,0:09:39.49,0:09:40.33,Default,,0,0,0,,（寒がりや）ん？
Dialogue: 0,0:09:41.29,0:09:44.04,Default,,0,0,0,,（ブリュンヒルデ）寒がりや君\N舟は よく乗るのか？
Dialogue: 0,0:09:44.66,0:09:47.04,Default,,0,0,0,,カワマスを取るのに たまに
Dialogue: 0,0:09:47.12,0:09:51.46,Default,,0,0,0,,舟というのは 前日に新調しても\N沈んだりするものなのか？
Dialogue: 0,0:09:51.55,0:09:52.38,Default,,0,0,0,,え？
Dialogue: 0,0:09:52.46,0:09:56.72,Default,,0,0,0,,いや 先日 見合いで乗ったとき\N急に浸水してな
Dialogue: 0,0:09:57.47,0:09:59.93,Default,,0,0,0,,こういったことが\N１回や２回じゃないんだ
Dialogue: 0,0:10:00.01,0:10:02.26,Default,,0,0,0,,（寒がりや）お… お…\Nお見合いしてるんですか？
Dialogue: 0,0:10:03.31,0:10:05.77,Default,,0,0,0,,してたら悪いかね？
Dialogue: 0,0:10:05.85,0:10:08.44,Default,,0,0,0,,おかげさまで連戦連敗中だ！
Dialogue: 0,0:10:08.52,0:10:11.90,Default,,0,0,0,,地下牢は 冬でも火気厳禁だぞ
Dialogue: 0,0:10:11.98,0:10:14.36,Default,,0,0,0,,連敗って なんで？
Dialogue: 0,0:10:14.44,0:10:15.61,Default,,0,0,0,,（ブリュンヒルデ）\Nそれだけじゃない
Dialogue: 0,0:10:16.24,0:10:17.57,Default,,0,0,0,,火事に雷
Dialogue: 0,0:10:17.65,0:10:20.82,Default,,0,0,0,,出向いた先の養魚地で\N魚が全部 死んだり
Dialogue: 0,0:10:20.91,0:10:23.29,Default,,0,0,0,,急に馬が暴れたり
Dialogue: 0,0:10:23.37,0:10:26.91,Default,,0,0,0,,ろくなことが起こらないから\Nきっと呪われてるんだ
Dialogue: 0,0:10:27.00,0:10:28.50,Default,,0,0,0,,（寒がりや）それって もしかして
Dialogue: 0,0:10:28.58,0:10:32.00,s4,,0,0,0,,誰かがブルーノ様に\Nお見合いさせたくないだけなのでは
Dialogue: 0,0:10:32.59,0:10:35.46,s4,,0,0,0,,例えば\Nブルーノ様を好きな女の子がいて
Dialogue: 0,0:10:35.55,0:10:39.18,s4,,0,0,0,,その子が 何がしかのアクションを\N起こしているとしよう
Dialogue: 0,0:10:39.26,0:10:41.89,s4,,0,0,0,,お見合いのたびにってことは…
Dialogue: 0,0:10:41.97,0:10:44.35,s4,,0,0,0,,いつも近くにいる人物かも
Dialogue: 0,0:10:44.43,0:10:46.73,Default,,0,0,0,,なんだ\N言いたいことでもあるのか？
Dialogue: 0,0:10:48.52,0:10:49.94,Default,,0,0,0,,（寒がりや）うーん…
Dialogue: 0,0:10:50.02,0:10:52.90,Default,,0,0,0,,誰かがブルーノ様に\N呪いをかけていたとしても
Dialogue: 0,0:10:52.98,0:10:55.36,Default,,0,0,0,,俺なら 舟が燃えても大丈夫だし
Dialogue: 0,0:10:55.44,0:10:57.57,Default,,0,0,0,,今 一緒に乗ってみようかと\N思ったけど
Dialogue: 0,0:10:57.65,0:10:59.91,Default,,0,0,0,,べつに 今日\Nブルーノ様 お見合いじゃないし
Dialogue: 0,0:10:59.99,0:11:04.24,Default,,0,0,0,,男同士で舟に乗っても\N食料の調達にしか見えないし…
Dialogue: 0,0:11:04.33,0:11:06.54,Default,,0,0,0,,お役に立てなくてすみません
Dialogue: 0,0:11:06.62,0:11:08.87,Default,,0,0,0,,（ブリュンヒルデ）\Nいや 悪くないアイデアだ
Dialogue: 0,0:11:08.96,0:11:11.21,Default,,0,0,0,,試してみる価値はあるぞ
Dialogue: 0,0:11:13.46,0:11:15.80,Default,,0,0,0,,なるべく楽しそうにしててくれ
Dialogue: 0,0:11:15.88,0:11:18.30,Default,,0,0,0,,何もなければ気休めになる
Dialogue: 0,0:11:20.34,0:11:23.93,Default,,0,0,0,,（舟をこぐ音）
Dialogue: 0,0:11:34.11,0:11:36.27,Default,,0,0,0,,（ブリュンヒルデ）\N大きいカワマスだな
Dialogue: 0,0:11:36.36,0:11:38.65,Default,,0,0,0,,この城の夕げに 魚は出ないのか？
Dialogue: 0,0:11:38.74,0:11:40.65,Default,,0,0,0,,料理長に言っときますよ
Dialogue: 0,0:11:40.74,0:11:43.12,Default,,0,0,0,,煮物と香草焼き\Nどっちがいいですか？
Dialogue: 0,0:11:43.20,0:11:46.66,Default,,0,0,0,,あっ ブルーノ様は まだ\Nこちらに ご滞在なんですか？
Dialogue: 0,0:11:46.74,0:11:48.75,Default,,0,0,0,,あ… ああ
Dialogue: 0,0:11:48.83,0:11:50.41,Default,,0,0,0,,ちょいちょい来ているんだ
Dialogue: 0,0:11:50.50,0:11:52.87,Default,,0,0,0,,そっか　よかった
Dialogue: 0,0:11:55.17,0:11:58.71,Default,,0,0,0,,あからさますぎるぞ 寒がりや君
Dialogue: 0,0:11:58.80,0:11:59.71,Default,,0,0,0,,（寒がりや）ん？
Dialogue: 0,0:11:59.80,0:12:01.51,Default,,0,0,0,,ああ… ホントに俺
Dialogue: 0,0:12:01.59,0:12:05.55,Default,,0,0,0,,もう会えなかったら寂しいなって\Nずっと思ってて
Dialogue: 0,0:12:14.02,0:12:16.44,Default,,0,0,0,,（風の音）
Dialogue: 0,0:12:17.77,0:12:18.61,Default,,0,0,0,,（くしゃみ）
Dialogue: 0,0:12:18.69,0:12:21.07,Default,,0,0,0,,うう…
Dialogue: 0,0:12:26.16,0:12:26.99,Default,,0,0,0,,（ハラペコ）ねえ～
Dialogue: 0,0:12:27.08,0:12:28.03,Default,,0,0,0,,（強風の音）
Dialogue: 0,0:12:28.03,0:12:29.45,Default,,0,0,0,,（強風の音）
Dialogue: 0,0:12:28.03,0:12:29.45,Default,,0,0,0,,あっ や～ん\N風 強～い
Dialogue: 0,0:12:29.45,0:12:29.54,Default,,0,0,0,,あっ や～ん\N風 強～い
Dialogue: 0,0:12:29.54,0:12:32.41,Default,,0,0,0,,あっ や～ん\N風 強～い
Dialogue: 0,0:12:29.54,0:12:32.41,Default,,0,0,0,,（暑がりや）ああ～ ハハッ
Dialogue: 0,0:12:32.50,0:12:36.63,Default,,0,0,0,,（ハラペコ）お庭の木がね\Nなんだかザワザワしてるよ
Dialogue: 0,0:12:38.59,0:12:39.42,Default,,0,0,0,,（獣使い）そうか
Dialogue: 0,0:12:40.34,0:12:42.51,Default,,0,0,0,,こっちは特に情報なし
Dialogue: 0,0:12:42.59,0:12:44.22,Default,,0,0,0,,暑がりやは？
Dialogue: 0,0:12:44.30,0:12:47.22,Default,,0,0,0,,（暑がりや）この風\N俺は むしろ気持ちいいんだが
Dialogue: 0,0:12:48.56,0:12:51.31,Default,,0,0,0,,アッパーガーデンに\N寒がりやがいるな…
Dialogue: 0,0:12:52.64,0:12:55.77,Default,,0,0,0,,寒がりやのとこから\N風が出てるみたいだ
Dialogue: 0,0:12:55.85,0:12:59.98,Default,,0,0,0,,あいつ なんか変なもんに\N絡まれてんのか？
Dialogue: 0,0:13:08.74,0:13:11.29,Default,,0,0,0,,（寒がりや）\Nこんなに天気がいいのに…
Dialogue: 0,0:13:12.00,0:13:13.87,Default,,0,0,0,,（震えて歯が鳴る音）
Dialogue: 0,0:13:13.96,0:13:17.08,Default,,0,0,0,,（寒がりや）年の瀬並みに寒いって\Nどういうこと？
Dialogue: 0,0:13:17.79,0:13:19.50,Default,,0,0,0,,（ブリュンヒルデ）\Nどうした？　寒がりや君
Dialogue: 0,0:13:19.59,0:13:21.05,Default,,0,0,0,,大丈夫か？
Dialogue: 0,0:13:21.76,0:13:25.01,Default,,0,0,0,,（寒がりや）ブルーノ様は\N大丈夫みたいだけど…
Dialogue: 0,0:13:25.09,0:13:29.47,s4,,0,0,0,,ああ… 俺 寒いとホントに…
Dialogue: 0,0:13:30.18,0:13:32.52,Default,,0,0,0,,（バリバラ）\Nお前たちの大義を言ってみろ
Dialogue: 0,0:13:34.64,0:13:35.48,Default,,0,0,0,,（寒がりや）いつか
Dialogue: 0,0:13:37.06,0:13:38.48,s4,,0,0,0,,かっこよく
Dialogue: 0,0:13:39.15,0:13:41.98,s4,,0,0,0,,お姫様を助けること
Dialogue: 0,0:13:42.78,0:13:45.32,s4,,0,0,0,,でも こんなことじゃ…
Dialogue: 0,0:13:47.78,0:13:50.12,s4,,0,0,0,,いつか助けるなんて
Dialogue: 0,0:13:52.08,0:13:54.12,s4,,0,0,0,,できないんじゃないか？
Dialogue: 0,0:14:03.80,0:14:05.34,Default,,0,0,0,,（寒がりや）暖かい…
Dialogue: 0,0:14:08.22,0:14:10.39,Default,,0,0,0,,もう大丈夫です
Dialogue: 0,0:14:10.47,0:14:14.06,Default,,0,0,0,,髪の色が変わったぞ 寒がりや君
Dialogue: 0,0:14:14.14,0:14:16.98,Default,,0,0,0,,（寒がりや）俺 体感温度で\N髪の色が変わるんです
Dialogue: 0,0:14:17.64,0:14:18.94,Default,,0,0,0,,そうだったっけ？
Dialogue: 0,0:14:20.40,0:14:21.65,Default,,0,0,0,,そうなんです
Dialogue: 0,0:14:21.73,0:14:24.86,Default,,0,0,0,,あっ… ああ すみません
Dialogue: 0,0:14:25.78,0:14:28.57,Default,,0,0,0,,気休めはよくないので\Nはっきり言います
Dialogue: 0,0:14:29.36,0:14:33.74,Default,,0,0,0,,誰かがブルーノ様と他人の関わりを\N邪魔しているのは確かです
Dialogue: 0,0:14:33.83,0:14:34.79,Default,,0,0,0,,お見合いの件は
Dialogue: 0,0:14:34.87,0:14:38.00,Default,,0,0,0,,毎回 妨害されていた可能性が\Nあります
Dialogue: 0,0:14:38.58,0:14:41.46,Default,,0,0,0,,でも それは\N意図的に起こしてることだから
Dialogue: 0,0:14:41.54,0:14:43.96,Default,,0,0,0,,絶対 解決できます
Dialogue: 0,0:14:44.59,0:14:46.01,Default,,0,0,0,,解決します
Dialogue: 0,0:14:55.27,0:14:57.31,Default,,0,0,0,,（寒がりや）ああは言ったけど
Dialogue: 0,0:14:57.39,0:15:01.27,s4,,0,0,0,,解決したら\Nブルーノ様 結婚しちゃうんだな…
Dialogue: 0,0:15:02.36,0:15:06.28,s4,,0,0,0,,いや 俺は べつに\Nなんにも期待してないけど
Dialogue: 0,0:15:07.57,0:15:12.16,s4,,0,0,0,,誰かに尽くすことは美しいって\N城代が…
Dialogue: 0,0:15:12.24,0:15:14.16,Default,,0,0,0,,（剣自慢）おい 寒がりや！\N（寒がりや）ん？
Dialogue: 0,0:15:14.24,0:15:16.75,Default,,0,0,0,,（剣自慢）なんだ？　それ\Nビーバーの親戚か？
Dialogue: 0,0:15:16.83,0:15:18.25,Default,,0,0,0,,（寒がりや）あ… これは…
Dialogue: 0,0:15:19.12,0:15:21.17,Default,,0,0,0,,私のペットのリスちゃんだ
Dialogue: 0,0:15:21.25,0:15:23.46,Default,,0,0,0,,（剣自慢）は？　リス？\Nあんた バカじゃねえの？
Dialogue: 0,0:15:24.09,0:15:25.88,Default,,0,0,0,,こんなになるまで食わせてよ
Dialogue: 0,0:15:25.96,0:15:27.92,Default,,0,0,0,,これだから貴族のお坊ちゃんはよ
Dialogue: 0,0:15:28.01,0:15:31.55,Default,,0,0,0,,生まれて初めてバカと言われたぞ\N寒がりや君
Dialogue: 0,0:15:31.64,0:15:33.76,Default,,0,0,0,,（寒がりや）剣自慢は\N誰にでも こうなんです
Dialogue: 0,0:15:33.85,0:15:34.89,Default,,0,0,0,,でも 悪いヤツじゃ…
Dialogue: 0,0:15:34.97,0:15:37.56,Default,,0,0,0,,（剣自慢）いいか？\N今日から餌やるときに
Dialogue: 0,0:15:37.64,0:15:39.43,Default,,0,0,0,,あっちこっち投げて歩かせろ
Dialogue: 0,0:15:39.52,0:15:42.60,Default,,0,0,0,,急激な運動は\N足 痛めて動けなくなるからな
Dialogue: 0,0:15:43.48,0:15:45.57,Default,,0,0,0,,まずは 今の重量を確かめよう
Dialogue: 0,0:15:45.65,0:15:48.15,Default,,0,0,0,,倉庫の秤はかりが使えるな
Dialogue: 0,0:15:50.61,0:15:52.95,Default,,0,0,0,,ついてこいよ 早く！
Dialogue: 0,0:15:54.24,0:15:56.74,Default,,0,0,0,,（城代）\N何を見てるんだい？　眠くない
Dialogue: 0,0:15:57.29,0:16:00.96,Default,,0,0,0,,いくら君でも\Nそこから落ちたら死ぬよ
Dialogue: 0,0:16:01.04,0:16:04.17,Default,,0,0,0,,あー いや\N弟たちの声がしたから
Dialogue: 0,0:16:04.25,0:16:05.71,Default,,0,0,0,,ああ そう
Dialogue: 0,0:16:05.79,0:16:09.09,Default,,0,0,0,,ハァー\N子供の相手は楽しいけど
Dialogue: 0,0:16:09.17,0:16:12.47,Default,,0,0,0,,荘園しょうえん管理の帳簿付けは\N面倒くさいよ
Dialogue: 0,0:16:12.55,0:16:14.93,Default,,0,0,0,,君の留守の間は 誰に任せよう…
Dialogue: 0,0:16:15.01,0:16:19.27,Default,,0,0,0,,先祖代々の仕事とはいえ\N本当に忙しいですよね
Dialogue: 0,0:16:20.02,0:16:22.98,Default,,0,0,0,,君の補佐役だが エレオノーラと
Dialogue: 0,0:16:23.06,0:16:26.23,Default,,0,0,0,,西の領主のご子息である\Nヨアンに決まったよ
Dialogue: 0,0:16:26.31,0:16:27.65,Default,,0,0,0,,エリーが？
Dialogue: 0,0:16:27.73,0:16:29.44,Default,,0,0,0,,あ… 結婚の件は？
Dialogue: 0,0:16:30.15,0:16:31.99,Default,,0,0,0,,まだ伝えてないが
Dialogue: 0,0:16:32.07,0:16:36.03,Default,,0,0,0,,君が 夜の長い国へ\N出発するまでには必ず
Dialogue: 0,0:16:37.03,0:16:39.66,Default,,0,0,0,,夜の長い国は とても静かで
Dialogue: 0,0:16:39.74,0:16:44.46,Default,,0,0,0,,夜に月の光で虹ができるような\N美しい所だよ
Dialogue: 0,0:16:44.96,0:16:48.63,Default,,0,0,0,,君たち兄弟が これから訪れる国々
Dialogue: 0,0:16:48.71,0:16:51.72,Default,,0,0,0,,そこが暮らしやすい\N生きやすいのであれば
Dialogue: 0,0:16:51.80,0:16:53.55,Default,,0,0,0,,みんな そのまま とどまってもいい
Dialogue: 0,0:16:53.63,0:16:56.51,Default,,0,0,0,,バリバラは そう思っているようだ
Dialogue: 0,0:16:56.59,0:16:58.01,Default,,0,0,0,,いえ 僕は…
Dialogue: 0,0:16:58.10,0:17:01.77,Default,,0,0,0,,君も弟たちも\Nもう そんなに弱くないんだから
Dialogue: 0,0:17:01.85,0:17:04.44,Default,,0,0,0,,好きに生きていきなさいよ
Dialogue: 0,0:17:14.70,0:17:16.16,Default,,0,0,0,,（剣自慢）\N１週間後に軽くなってるか
Dialogue: 0,0:17:16.24,0:17:17.74,Default,,0,0,0,,チェック入れるからな
Dialogue: 0,0:17:17.82,0:17:18.99,Default,,0,0,0,,サボるんじゃねえぞ
Dialogue: 0,0:17:19.08,0:17:21.16,Default,,0,0,0,,（コレット）何やってんだ？
Dialogue: 0,0:17:21.24,0:17:24.46,s4,,0,0,0,,あいつらと あんまり\N関わりたくないんだよな
Dialogue: 0,0:17:24.54,0:17:27.38,Default,,0,0,0,,（ブリュンヒルデ）んっ んん…
Dialogue: 0,0:17:31.63,0:17:32.84,Default,,0,0,0,,（コレット）おっ 何してんの？
Dialogue: 0,0:17:32.92,0:17:35.43,Default,,0,0,0,,（ハラペコ）あ… 薪まき集めしてたら
Dialogue: 0,0:17:35.51,0:17:37.05,Default,,0,0,0,,トゲが刺さっちゃったみたい
Dialogue: 0,0:17:37.14,0:17:38.93,Default,,0,0,0,,（コレット）えっ マジかよ！
Dialogue: 0,0:17:39.01,0:17:40.85,Default,,0,0,0,,（ジャスティス）\N鍛え方が足りねえんだよ
Dialogue: 0,0:17:40.93,0:17:41.77,Default,,0,0,0,,（ハラペコ）ジャスティス…
Dialogue: 0,0:17:41.85,0:17:43.18,Default,,0,0,0,,（ジャスティス）ハラペコ
Dialogue: 0,0:17:43.27,0:17:45.39,Default,,0,0,0,,お前 昨日の稽古中も\Nサボってたじゃねえか
Dialogue: 0,0:17:46.14,0:17:48.35,Default,,0,0,0,,今から俺が鍛えてやるよ
Dialogue: 0,0:17:49.19,0:17:50.27,Default,,0,0,0,,どこ行くんだよ
Dialogue: 0,0:17:50.36,0:17:51.19,Default,,0,0,0,,うぐっ…
Dialogue: 0,0:17:51.27,0:17:54.15,Default,,0,0,0,,痛い やめてよ！
Dialogue: 0,0:17:54.24,0:17:57.49,Default,,0,0,0,,（ゾーイ）宰相様の甥おいっ子である\Nジャスティス様を無視するなんて
Dialogue: 0,0:17:57.57,0:17:59.03,Default,,0,0,0,,失礼ですよ
Dialogue: 0,0:17:59.12,0:18:01.70,Default,,0,0,0,,お前 騎士だろ\Nもっと騎士らしくしろよ
Dialogue: 0,0:18:01.79,0:18:05.16,Default,,0,0,0,,離してよ！\N僕のキレイな髪が傷むだろ！
Dialogue: 0,0:18:05.25,0:18:07.37,Default,,0,0,0,,（ゾーイ）坊ちゃん\Nハラペコ 喜んでますよ
Dialogue: 0,0:18:07.46,0:18:09.54,Default,,0,0,0,,喜んでなんかいないよ！
Dialogue: 0,0:18:09.63,0:18:11.00,Default,,0,0,0,,（暑がりや）何やってんだ！
Dialogue: 0,0:18:11.09,0:18:12.50,Default,,0,0,0,,ハラペコ 今だ！
Dialogue: 0,0:18:13.05,0:18:13.88,Default,,0,0,0,,（ジャスティス）おい！
Dialogue: 0,0:18:14.46,0:18:18.26,Default,,0,0,0,,（暑がりや）んっ！\N話があるなら俺が聞いてやる
Dialogue: 0,0:18:18.34,0:18:19.34,Default,,0,0,0,,（ジャスティス）チッ
Dialogue: 0,0:18:19.43,0:18:20.76,Default,,0,0,0,,（ハラペコ）ハァ ハァ…
Dialogue: 0,0:18:20.85,0:18:22.93,Default,,0,0,0,,（コレット）指 消毒してやるよ
Dialogue: 0,0:18:23.01,0:18:23.89,Default,,0,0,0,,上 行こうぜ
Dialogue: 0,0:18:23.97,0:18:26.81,Default,,0,0,0,,（ハラペコ）うん　あっ あとね
Dialogue: 0,0:18:26.89,0:18:29.23,Default,,0,0,0,,僕 もうすぐ おなかすいちゃうかも
Dialogue: 0,0:18:29.31,0:18:31.19,Default,,0,0,0,,（コレット）えっ ヤベえじゃん！
Dialogue: 0,0:18:31.27,0:18:33.86,Default,,0,0,0,,夕食まで待てねえ… よな
Dialogue: 0,0:18:33.94,0:18:34.98,Default,,0,0,0,,しかたねえな
Dialogue: 0,0:18:35.53,0:18:37.03,Default,,0,0,0,,残りもんで 野バラのソースと
Dialogue: 0,0:18:37.11,0:18:39.95,Default,,0,0,0,,クランベリー添え\N鹿肉ステーキ作ってやるよ
Dialogue: 0,0:18:40.03,0:18:40.95,Default,,0,0,0,,（ハラペコ）やった！
Dialogue: 0,0:18:41.66,0:18:46.00,Default,,0,0,0,,（コレット）ホント\Nお前ら兄弟の相手すんの疲れるわ
Dialogue: 0,0:18:46.08,0:18:46.91,Default,,0,0,0,,（暑がりや）ふんっ ふんっ
Dialogue: 0,0:18:53.38,0:18:55.38,Default,,0,0,0,,（ナレーション）出発の日は近づき
Dialogue: 0,0:18:56.01,0:18:59.22,s4,,0,0,0,,眠くないの旅の準備も進んでいた
Dialogue: 0,0:18:59.88,0:19:04.56,Default,,0,0,0,,（乳母）いいか 眠くない\N夜の長い国は とにかく寒いんだ
Dialogue: 0,0:19:04.64,0:19:05.85,Default,,0,0,0,,（眠くない）分かってる
Dialogue: 0,0:19:05.93,0:19:08.77,Default,,0,0,0,,国境ギリギリまでは\N行ったことがあるんだ
Dialogue: 0,0:19:09.35,0:19:12.69,Default,,0,0,0,,（乳母）わしゃ\N町より遠くへ行った経験はないが
Dialogue: 0,0:19:12.77,0:19:16.19,Default,,0,0,0,,あそこが国境どころの\N寒さじゃないのは知ってるよ
Dialogue: 0,0:19:16.28,0:19:20.57,Default,,0,0,0,,城代の昔の毛皮のマントを\N出しとくから 持っておいき
Dialogue: 0,0:19:20.66,0:19:23.45,Default,,0,0,0,,ありがとう\Nいろいろ助かるよ 乳母様
Dialogue: 0,0:19:23.53,0:19:25.70,Default,,0,0,0,,服の次は食べ物だよ
Dialogue: 0,0:19:25.79,0:19:29.71,Default,,0,0,0,,あんな寒い国\N冷たいお茶しかないに決まってる
Dialogue: 0,0:19:29.79,0:19:30.87,Default,,0,0,0,,そりゃ 言いすぎ
Dialogue: 0,0:19:30.96,0:19:32.46,Default,,0,0,0,,（領主）まったく…
Dialogue: 0,0:19:32.54,0:19:35.84,Default,,0,0,0,,王は いつまで あの女将軍を\Nのさばらせておくつもりだ
Dialogue: 0,0:19:35.92,0:19:37.21,Default,,0,0,0,,我が国には
Dialogue: 0,0:19:37.30,0:19:40.68,Default,,0,0,0,,代々の将軍家というものが\Nいくつもあるというのに
Dialogue: 0,0:19:40.76,0:19:45.43,Default,,0,0,0,,（ヨアンの父）だがバリバラには\N先の恐慌での功績がある
Dialogue: 0,0:19:45.51,0:19:49.31,Default,,0,0,0,,その上 元武力の国の\N英傑とあっては
Dialogue: 0,0:19:49.39,0:19:53.90,Default,,0,0,0,,上に添えておくだけで 北の国々に\Nにらみも利きますからな
Dialogue: 0,0:19:53.98,0:19:57.48,Default,,0,0,0,,（領主）それはそうだが\N今度は 城代の一人娘に
Dialogue: 0,0:19:57.57,0:20:00.90,Default,,0,0,0,,あの化け物息子の１人を\N婿入りさせるらしいではないか
Dialogue: 0,0:20:00.99,0:20:02.20,Default,,0,0,0,,（ヨアンの父）なんと！
Dialogue: 0,0:20:02.28,0:20:05.37,Default,,0,0,0,,では 城代の領地が\Nいずれ あの女のものに？
Dialogue: 0,0:20:05.45,0:20:09.16,Default,,0,0,0,,（眠くない）よかった\Nこれは弟たちの話じゃない
Dialogue: 0,0:20:09.79,0:20:10.83,s4,,0,0,0,,僕のことだ
Dialogue: 0,0:20:10.91,0:20:13.08,Default,,0,0,0,,西の領の領主じゃな
Dialogue: 0,0:20:13.17,0:20:15.67,Default,,0,0,0,,一発 食らわせてくるから\N待っときな！
Dialogue: 0,0:20:15.75,0:20:17.50,Default,,0,0,0,,大丈夫だよ
Dialogue: 0,0:20:17.59,0:20:19.71,Default,,0,0,0,,ちょっと持っててくれないかな
Dialogue: 0,0:20:19.80,0:20:21.01,Default,,0,0,0,,（乳母）あっ んん…
Dialogue: 0,0:20:21.63,0:20:24.09,Default,,0,0,0,,挨拶をしておかないとね
Dialogue: 0,0:20:24.18,0:20:27.06,Default,,0,0,0,,これはこれは 領主様方
Dialogue: 0,0:20:27.14,0:20:30.22,Default,,0,0,0,,さすがに\Nお耳が早くていらっしゃる
Dialogue: 0,0:20:31.23,0:20:33.23,Default,,0,0,0,,ヨアンのお父上でしたか
Dialogue: 0,0:20:33.31,0:20:35.27,Default,,0,0,0,,今度の旅では お世話になります
Dialogue: 0,0:20:35.36,0:20:37.77,Default,,0,0,0,,（領主）あ… アッハハハ…
Dialogue: 0,0:20:37.86,0:20:39.69,Default,,0,0,0,,バリバラ殿のご長男
Dialogue: 0,0:20:39.78,0:20:42.28,Default,,0,0,0,,うまくやられましたな\N次期城代とは
Dialogue: 0,0:20:42.36,0:20:45.16,Default,,0,0,0,,まだまだ先の話ですよ
Dialogue: 0,0:20:45.24,0:20:46.78,Default,,0,0,0,,でも数十年後には
Dialogue: 0,0:20:46.87,0:20:49.62,Default,,0,0,0,,王の不在時の代理と\N国の領地の管理は
Dialogue: 0,0:20:49.70,0:20:51.75,Default,,0,0,0,,全て僕の仕事になりますので
Dialogue: 0,0:20:52.54,0:20:55.21,Default,,0,0,0,,ご協力よろしくお願いいたします
Dialogue: 0,0:20:56.13,0:20:57.79,Default,,0,0,0,,ところで西の方では
Dialogue: 0,0:20:57.88,0:21:02.67,Default,,0,0,0,,ここ数年 余剰穀物を売る闇市場が\N増えてきているそうですね
Dialogue: 0,0:21:03.59,0:21:08.18,Default,,0,0,0,,あなた方の息子の代の経済発展を\N楽しみにしてますよ
Dialogue: 0,0:21:08.26,0:21:10.43,Default,,0,0,0,,闇市とは人聞きの悪い！
Dialogue: 0,0:21:10.52,0:21:12.64,Default,,0,0,0,,（ヨアンの父）\Nどこで そのような話を？
Dialogue: 0,0:21:15.06,0:21:17.36,Default,,0,0,0,,（眠くない）\N大丈夫　うまくやれてる
Dialogue: 0,0:21:18.69,0:21:20.57,s4,,0,0,0,,もう子供じゃないから
Dialogue: 0,0:21:21.36,0:21:23.19,s4,,0,0,0,,あんなことにはならないから…
Dialogue: 0,0:21:24.24,0:21:26.28,s4,,0,0,0,,僕が しっかりしなきゃ
Dialogue: 0,0:21:26.36,0:21:28.70,s4,,0,0,0,,誰が弟たちを守るんだ
Dialogue: 0,0:21:29.45,0:21:32.75,Default,,0,0,0,,（乳母）眠くない！\N（眠くない）あっ 乳母様 荷物を
Dialogue: 0,0:21:32.83,0:21:34.37,Default,,0,0,0,,（乳母）荷物じゃないわい
Dialogue: 0,0:21:34.46,0:21:37.58,Default,,0,0,0,,お前 ホントに あのエレオノーラを\N嫁にするのかい？
Dialogue: 0,0:21:37.67,0:21:41.05,Default,,0,0,0,,城代に無理やり\N押しつけられたんだろ？
Dialogue: 0,0:21:41.13,0:21:43.13,Default,,0,0,0,,（眠くない）ん？　そうだけど…
Dialogue: 0,0:21:43.21,0:21:46.05,Default,,0,0,0,,でも弟たちと仲いいし 何より―
Dialogue: 0,0:21:46.76,0:21:49.26,Default,,0,0,0,,あの剣自慢が\Nまともに話せる女性は
Dialogue: 0,0:21:49.35,0:21:50.76,Default,,0,0,0,,彼女しか\Nいないだろ？
Dialogue: 0,0:21:50.85,0:21:51.76,Default,,0,0,0,,（乳母）はあ～？
Dialogue: 0,0:21:51.76,0:21:53.10,Default,,0,0,0,,（乳母）はあ～？
Dialogue: 0,0:21:51.76,0:21:53.10,Default,,0,0,0,,（眠くない）エリーも前に\Nべつに誰でもいいって言ってたし
Dialogue: 0,0:21:53.10,0:21:54.60,Default,,0,0,0,,（眠くない）エリーも前に\Nべつに誰でもいいって言ってたし
Dialogue: 0,0:21:54.68,0:21:57.81,Default,,0,0,0,,長男の僕が\N早く片づいとかないとね
Dialogue: 0,0:21:57.90,0:21:59.40,Default,,0,0,0,,（乳母）\Nお前 そんな理由で
Dialogue: 0,0:21:59.48,0:22:02.48,Default,,0,0,0,,１５００年続く\N城代家に入るのかい？
Dialogue: 0,0:22:02.57,0:22:06.70,Default,,0,0,0,,自分の選択に責任を持つんだよ
Dialogue: 0,0:22:07.32,0:22:10.37,Default,,0,0,0,,（眠くない）\Nさあ 出発準備の続きだ
Dialogue: 0,0:22:10.45,0:22:13.49,Default,,0,0,0,,（乳母）はいはい\Nわしゃ もう知らんからね
Dialogue: 0,0:22:13.58,0:22:15.08,Default,,0,0,0,,（眠くない）ママと城代は
Dialogue: 0,0:22:15.16,0:22:17.79,s4,,0,0,0,,僕が 夜の長い国に\Nとどまってもいいと言う
Dialogue: 0,0:22:19.88,0:22:25.55,s4,,0,0,0,,でも 僕はエリーと一緒になって\Nいつか城代になる
Dialogue: 0,0:22:26.51,0:22:29.26,s4,,0,0,0,,そうすれば\N心配は要らないだろ
Dialogue: 0,0:22:29.34,0:22:30.14,Default,,0,0,0,,（歓声）
Dialogue: 0,0:22:30.14,0:22:31.97,Default,,0,0,0,,（歓声）
Dialogue: 0,0:22:30.14,0:22:31.97,s4,,0,0,0,,僕はもう大丈夫
Dialogue: 0,0:22:31.97,0:22:32.64,Default,,0,0,0,,（歓声）
Dialogue: 0,0:22:32.64,0:22:33.47,Default,,0,0,0,,（歓声）
Dialogue: 0,0:22:32.64,0:22:33.47,Default,,0,0,0,,ん？
Dialogue: 0,0:22:34.35,0:22:36.43,s4,,0,0,0,,やけに盛り上がってるけど…
Dialogue: 0,0:22:36.52,0:22:37.81,Default,,0,0,0,,（アナマリー）あら？
Dialogue: 0,0:22:37.89,0:22:40.81,Default,,0,0,0,,眠くない様も\Nいらっしゃったのですか？
Dialogue: 0,0:22:40.90,0:22:42.61,Default,,0,0,0,,（眠くない）やあ アナマリー様
Dialogue: 0,0:22:43.36,0:22:44.53,Default,,0,0,0,,ん！
Dialogue: 0,0:22:45.49,0:22:48.70,s4,,0,0,0,,1.5メートルの距離に\Nブリュンヒルデ様
Dialogue: 0,0:22:48.78,0:22:50.16,s4,,0,0,0,,新記録
Dialogue: 0,0:22:50.24,0:22:51.91,s4,,0,0,0,,日記に書き留めておかねば
Dialogue: 0,0:22:52.87,0:22:54.87,Default,,0,0,0,,（アナマリー）\N毎月恒例の勝ち抜き戦
Dialogue: 0,0:22:54.95,0:22:57.04,Default,,0,0,0,,もう準決勝ですわよ
Dialogue: 0,0:22:57.12,0:22:59.12,Default,,0,0,0,,（眠くない）ああ 今日でしたね
Dialogue: 0,0:22:59.96,0:23:02.96,Default,,0,0,0,,久しぶりに\N僕も出ればよかったな
Dialogue: 0,0:23:03.04,0:23:04.46,Default,,0,0,0,,ほら
Dialogue: 0,0:23:07.84,0:23:09.88,Default,,0,0,0,,一番の目玉のカード
Dialogue: 0,0:23:10.64,0:23:13.76,Default,,0,0,0,,エレオノーラと剣自慢ですわ
Dialogue: 0,0:23:16.47,0:23:20.48,Default,,0,0,0,,♪～
Dialogue: 0,0:24:41.93,0:24:45.94,Default,,0,0,0,,～♪
Dialogue: 0,0:24:47.02,0:24:49.65,Default,,0,0,0,,（眠くない）僕も そろそろ\N君に勝てる気がするんだけど
Dialogue: 0,0:24:50.86,0:24:54.36,Default,,0,0,0,,（エリー）心が\Nざわつかなかった あのころから
Dialogue: 0,0:24:54.45,0:24:58.49,s4,,0,0,0,,どんどん離れていくみたいだ