564
00:41:30,454 --> 00:41:41,465
♬～

565
00:41:41,465 --> 00:41:53,977
(パトカーのサイレン)

566
00:41:53,977 --> 00:41:55,477
ハァ…｡

567
00:41:56,980 --> 00:41:58,480
うっ…｡

568
00:41:59,983 --> 00:42:03,987
ハァ… ハァ…｡

569
00:42:03,987 --> 00:42:25,008
♬～

570
00:42:25,008 --> 00:42:28,512
((こういうの
デートっていうんですよね))

571
00:42:28,512 --> 00:42:30,514
((え？))

572
00:42:30,514 --> 00:42:35,514
((散歩して パンケーキ食べて
いい景色 見るの))

573
00:42:38,021 --> 00:42:39,521
((そうですね))

574
00:42:41,024 --> 00:42:45,028
((何か久しぶりです こういうの))

575
00:42:45,028 --> 00:42:49,528
((いつも周りは おじいちゃんと
おばあちゃんばかりだから))

576
00:42:57,040 --> 00:43:00,544
((どうして
介護士になったんですか？))

577
00:43:00,544 --> 00:43:02,546
((ん～…))

578
00:43:02,546 --> 00:43:07,551
((介護士じゃなくても
よかったのかもしれません))

579
00:43:07,551 --> 00:43:11,989
((とにかく 誰かのために
なりたかったんです))

580
00:43:11,989 --> 00:43:13,991
((そうしたら➡

581
00:43:13,991 --> 00:43:17,491
自分が生まれてきた意味を
実感できるような気がして))

582
00:43:24,001 --> 00:43:26,001
((分かります))

583
00:43:27,504 --> 00:43:30,007
((そういう気持ちを➡

584
00:43:30,007 --> 00:43:32,509
正義って呼ぶんだと思います))

585
00:43:32,509 --> 00:43:35,512
((正義？ ちょっと
大げさじゃないですか？))

586
00:43:35,512 --> 00:43:38,015
((ハハ… ですかね))

587
00:43:38,015 --> 00:43:42,019
((いや でも俺の中にもあります))

588
00:43:42,019 --> 00:43:45,019
((誰かを助けたいって気持ちが
ずっと))

589
00:43:47,524 --> 00:43:51,028
((やっぱりカムパネルラだ
津倉さんは))

590
00:43:51,028 --> 00:43:53,030
((え？))

591
00:43:53,030 --> 00:43:55,532
((いいと思います ステキです))

592
00:43:55,532 --> 00:43:58,032
((アハハ… いえ))

593
00:43:59,536 --> 00:44:03,036
((私もカムパネルラに
なりたいなぁ))

594
00:44:04,541 --> 00:44:09,041
((この世界が変えられるなら
なりたい))

595
00:44:18,489 --> 00:44:20,489
((あの…))

596
00:44:23,994 --> 00:44:26,997
((付き合ってくれませんか？))

597
00:44:26,997 --> 00:44:31,001
((え… え？ 急に？))

598
00:44:31,001 --> 00:44:33,003
((そんな流れありました？))

599
00:44:33,003 --> 00:44:36,006
((あ… いや すみません
あの でも その…➡

600
00:44:36,006 --> 00:44:40,511
やっぱり
ステキだなって思ったから➡

601
00:44:40,511 --> 00:44:43,011
そう 思いました))

602
00:44:44,515 --> 00:44:47,017
((好きだなって))

603
00:44:47,017 --> 00:44:58,529
♬～

604
00:44:58,529 --> 00:45:01,529
((私で いいんですか？))

605
00:45:05,035 --> 00:45:07,037
((すみません))

606
00:45:07,037 --> 00:45:10,474
((幸せになるのが 不安で))

607
00:45:10,474 --> 00:45:17,481
♬～

608
00:45:17,481 --> 00:45:19,483
((食べませんか？))

609
00:45:19,483 --> 00:45:22,986
((え？ あぁ… はい))
((私 好きなんです))

610
00:45:22,986 --> 00:45:29,493
♬～

611
00:45:29,493 --> 00:45:32,996
((私も好きです))

612
00:45:32,996 --> 00:45:35,499
((津倉さんのこと))

613
00:45:35,499 --> 00:45:54,017
♬～

614
00:45:54,017 --> 00:45:59,017
♬～

